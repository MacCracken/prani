[package]
name = "prani"
version = "${file:VERSION}"
description = "prani — creature & animal vocal synthesis (species vocal tracts, call patterns, emotion/fatigue drive, behavioral vocalization). Cyrius port of a 3,527-line Rust library."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/prani"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
output = "build/prani"

# `[lib]` declares the distlib bundle `cyrius distlib` writes into
# `dist/prani.cyr` — every module concatenated in dependency order (deps
# before dependents). Populated as modules are ported (foundations first,
# then tract/voice, then sequence/stream/ffi). Every module is
# self-contained (no `include` lines); the entry / test harness orders them.
# svara + its transitive deps (naad/hisab/goonj/sakshi) resolve from THIS
# manifest's [deps].
[lib]
# Dependency order (deps before dependents). Cyrius resolves forward function
# references across the unit, but structs must be defined before `sizeof`/
# accessor use — so sequence (defines CallBout) precedes species (bout_template
# constructs it). sequence's synthesize methods forward-reference voice's
# crvoice_* (defined later) — fine (whole-unit resolution). math.rs (thin f32
# transcendental wrappers) folds into direct f64_* builtin + ganita calls; no
# separate module, same as svara/naad.
modules = [
    # L0 foundations (no internal deps)
    "src/real.cyr",      # the float format (ADR-0010): f64, or f32 under PRANI_F32
    "src/error.cyr",
    "src/f64/error.cyr",   # its f64 build (generated, ADR-0010)
    "src/logging.cyr",   # sakshi-backed structured logging (tracing replacement)
    "src/rng.cyr",
    "src/f64/rng.cyr",   # its f64 build (generated, ADR-0010)
    "src/dsp.cyr",
    "src/f64/dsp.cyr",   # its f64 build (generated, ADR-0010)
    "src/spatial.cyr",
    "src/f64/spatial.cyr",   # its f64 build (generated, ADR-0010)
    "src/vocalization.cyr",
    "src/fatigue.cyr",
    "src/f64/fatigue.cyr",   # its f64 build (generated, ADR-0010)
    # L1
    "src/emotion.cyr",
    "src/f64/emotion.cyr",   # its f64 build (generated, ADR-0010)
    "src/sequence.cyr",   # CallElement/CallBout/CallPhrase structs (used by species)
    "src/f64/sequence.cyr",   # its f64 build (generated, ADR-0010)
    "src/species.cyr",
    "src/f64/species.cyr",   # its f64 build (generated, ADR-0010)
    "src/bridge.cyr",
    "src/f64/bridge.cyr",   # its f64 build (generated, ADR-0010)
    # L2 — svara vocal-tract bridge
    "src/tract.cyr",
    "src/f64/tract.cyr",   # its f64 build (generated, ADR-0010)
    # L3 — voice orchestration
    "src/voice.cyr",
    "src/f64/voice.cyr",   # its f64 build (generated, ADR-0010)
    # L4 — composites
    "src/preset.cyr",
    "src/f64/preset.cyr",   # its f64 build (generated, ADR-0010)
    "src/stream.cyr",
    "src/f64/stream.cyr",   # its f64 build (generated, ADR-0010)
    # L5 — FFI surface
    "src/ffi.cyr",
]

# stdlib: mirrors svara's set (prani sits directly on svara). math gives
# clamp/min/max/lerp/sign + F64_* constants; ganita gives the transcendentals
# the tract/glottal DSP leans on (sin/cos/tan/exp/ln/pow/sqrt/tanh/…); tagged
# for Option-shaped returns; fnptr/callback for the closure→fn-ptr port
# pattern; bench for .bcyr harnesses; assert for .tcyr. sakshi is structured
# logging: src/logging.cyr calls it (prani_log_* -> sakshi_debug/info/warn/
# error/fatal), and svara and goonj call it too. A leaf since hisab 3.4.2 /
# svara 3.6.4, where it was a [deps.sakshi] package through prani 2.1.1.
[deps]
stdlib = [
    "syscalls",
    "string",
    "alloc",
    "str",
    "fmt",
    "vec",
    "io",
    "args",
    "assert",
    "math",
    "ganita",
    "hashmap",
    "bayan",
    "tagged",
    "fnptr",
    "callback",
    "bench",
    "sakshi",
]

# The dep tags below are the matched set for cyrius 6.7.18, and they move
# TOGETHER: each of svara 3.14.0, naad 2.3.5, hisab 3.5.0 and goonj 2.3.2 pins
# cyrius 6.7.18 exactly, and svara, naad and goonj all pin hisab 3.5.0 (svara also
# pins naad 2.3.5 and goonj 2.3.2). Each is also its project's newest tag. sakshi
# is the stdlib leaf above, not a package: hisab 3.4.2 dropped its [deps.sakshi],
# and a package of that name now draws "refusing to overwrite stdlib leaf
# 'sakshi'". The floor under consumers stays cyrius 6.7.2: sakshi needs `const`.

# svara — human/formant vocal synthesis primitives. prani consumes svara's
# GlottalSource / FormantFilter / VocalTract surface (tract.cyr, voice.cyr)
# from the single monolithic dist bundle. The bundle references naad + hisab +
# goonj symbols, resolved from THIS manifest below, and sakshi, the stdlib leaf.
[deps.svara]
git = "https://github.com/MacCracken/svara.git"
tag = "3.14.0"
modules = ["dist/svara.cyr"]

# naad — audio synthesis primitives (noise / biquad / LFO). Referenced by
# svara's bundle and called directly by tract.cyr (filter_biquad_new /
# _process_sample + NAAD_FILTER_BANDPASS, the NoiseOnly path).
[deps.naad]
git = "https://github.com/MacCracken/naad.git"
tag = "2.3.5"
modules = ["dist/naad.cyr"]

# hisab — math/geometry (HVec3/HComplex/FFT/ganita least-squares). Referenced
# by svara + naad bundles. Pinned to the tag they consume.
[deps.hisab]
git = "https://github.com/MacCracken/hisab.git"
tag = "3.5.0"
modules = ["dist/hisab.cyr"]

# goonj — acoustics engine. Referenced by naad's acoustics/* modules (present
# in the monolithic bundle). Pulls sakshi + hisab transitively.
[deps.goonj]
git = "https://github.com/MacCracken/goonj.git"
tag = "2.3.2"
modules = ["dist/goonj.cyr"]

include "src/f64/spatial.cyr"
include "src/vocalization.cyr"
include "src/fatigue.cyr"
include "src/f64/fatigue.cyr"
include "src/emotion.cyr"
include "src/f64/emotion.cyr"
include "src/sequence.cyr"
include "src/f64/sequence.cyr"
include "src/species.cyr"
include "src/f64/species.cyr"
include "src/bridge.cyr"
include "src/f64/bridge.cyr"
include "src/tract.cyr"
include "src/f64/tract.cyr"
include "src/voice.cyr"
include "src/f64/voice.cyr"
include "src/preset.cyr"
include "src/f64/preset.cyr"
include "src/stream.cyr"
include "src/f64/stream.cyr"
include "tests/realt.cyr"

alloc_init();

#ifdef PRANI_F32
var LV_SR = 0x472C4400;            # 44100.0
var LV_D = 0x3DCCCCCD;             # 0.1 s
var LV_D2 = 0x3E4CCCCD;            # 0.2 s: past the cricket's 4 syllables, into its silence
var LV_E09 = 0x3F666666;           # effort 0.9
#else
var LV_SR = 0x40e5888000000000;    # 44100.0
var LV_D = 0x3FB999999999999A;     # 0.1 s
var LV_D2 = 0x3FC999999999999A;    # 0.2 s: past the cricket's 4 syllables, into its silence
var LV_E09 = 0x3FECCCCCCCCCCCCD;   # effort 0.9
#endif
# The levels are the f64 build's, recorded in f64, and both builds are held to them
# (ADR-0010): the f64 build within a relative 1e-9, as since 2.2.1, and the f32 build
# within the bound measured for it.
var LV_TOL64 = 0x3E112E0BE826D695;   # 1e-9, relative
# f32: measured 7.7e-9 .. 6.4e-7 across the 15 (2.3.0; the stream howl is the largest).
# At 1e-6 the f32 run is an accuracy gate, not the mutant catcher: the fire-breath
# moves the dragon's roar by about 1e-6, which only the f64 run's 1e-9 can see.
var LV_TOL = t_per(LV_TOL64, 0x3EB0C6F7A0B5ED8D);   # f32: 1e-6, relative

# lv_rms(v) -- root-mean-square of a vec.
fn lv_rms(v) {
    var n = vec_len(v);
    var acc = 0;
    var i = 0;
    while (i < n) {
        var x = pr_to64(vec_get(v, i));
        acc = f64_add(acc, f64_mul(x, x));
        i = i + 1;
    }
    return f64_sqrt(f64_div(acc, f64_from(n)));
}

# lv_drain(st, bufn) -- a stream drained in bufn-sample fills, as a host would.
fn lv_drain(st, bufn) {
    var o = vec_new();
    var b = vec_new();
    prani_vec_push_zeros(b, bufn);
    while (stream_is_finished(st) == 0) {
        var n = stream_fill_buffer(st, b);
        if (n == 0) { return o; }
        var k = 0;
        while (k < n) {
            vec_push(o, vec_get(b, k));
            k = k + 1;
        }
    }
    return o;
}

# lv_chorus() -- four wolves howling 0.1 s with a 10 ms timing spread.
fn lv_chorus() {
    var vs = vec_new();
    var k = 0;
    while (k < 4) {
        vec_push(vs, crvoice_new(PRANI_SP_WOLF));
        k = k + 1;
    }
    var TL_LAYE_113_0 = pr_of64(0x3F847AE147AE147B);
    return sequence_synthesize_chorus(vs, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, LV_SR, LV_D, TL_LAYE_113_0);
}

# lv_pin(name, v, n, rms_ref) -- the render is n samples and its RMS is within a
# relative LV_TOL of the recorded rms_ref. Records the assertions itself.
fn lv_pin(name, v, n, rms_ref) {
    test_group(name);
    assert_eq(prani_is_err(v), 0, "renders without error");
    if (prani_is_err(v) == 1) { return 0; }
    assert_eq(vec_len(v), n, "at the recorded length");
    var rel = f64_abs(f64_sub(f64_div(lv_rms(v), rms_ref), F64_ONE));
    assert_eq(f64_le(rel, LV_TOL), 1, "its RMS is the recorded level, within a relative 1e-9 (f32: 1e-6)");
    return 0;
}

# dragon_roar: subharmonics, chaos noise and fire-breath (RMS 0.113088466)
var lv_1 = crvoice_vocalize(crvoice_new(PRANI_SP_DRAGON), PRANI_VOC_ROAR, LV_SR, LV_D);
lv_pin("dragon_roar", lv_1, 4410, 0x3fbcf35da04f4638);
# lion_roar: subharmonics and chaos noise (RMS 0.113119070)
var lv_2 = crvoice_vocalize(crvoice_new(PRANI_SP_LION), PRANI_VOC_ROAR, LV_SR, LV_D);
lv_pin("lion_roar", lv_2, 4410, 0x3fbcf55f1318cec5);
# croc_rumble: the crocodilian subharmonic (RMS 0.114637486)
var lv_3 = crvoice_vocalize(crvoice_new(PRANI_SP_CROCODILIAN), PRANI_VOC_RUMBLE, LV_SR, LV_D);
lv_pin("croc_rumble", lv_3, 4410, 0x3fbd58e1de059804);
# wolf_howl: biphonation, the formant transition and the nasal notch (RMS 0.0264676105)
var lv_4 = crvoice_vocalize(crvoice_new(PRANI_SP_WOLF), PRANI_VOC_HOWL, LV_SR, LV_D);
lv_pin("wolf_howl", lv_4, 4410, 0x3f9b1a5346b481b9);
# dog_whine: biphonation on a whine (RMS 0.0264056536)
var lv_5 = crvoice_vocalize(crvoice_new(PRANI_SP_DOG), PRANI_VOC_WHINE, LV_SR, LV_D);
lv_pin("dog_whine", lv_5, 4410, 0x3f9b0a156a1f7550);
# dog_howl: biphonation on a dog (RMS 0.0261501962)
var lv_6 = crvoice_vocalize(crvoice_new(PRANI_SP_DOG), PRANI_VOC_HOWL, LV_SR, LV_D);
lv_pin("dog_howl", lv_6, 4410, 0x3f9ac71df65efe26);
# cat_howl: the cat meow transition and its nasal notch (RMS 0.0025202112)
var lv_7 = crvoice_vocalize(crvoice_new(PRANI_SP_CAT), PRANI_VOC_HOWL, LV_SR, LV_D);
lv_pin("cat_howl", lv_7, 4410, 0x3f64a54415336c23);
# songbird_trill: the dual-source syrinx and the trill AM (RMS 0.0318966772)
var lv_8 = crvoice_vocalize(crvoice_new(PRANI_SP_SONGBIRD), PRANI_VOC_TRILL, LV_SR, LV_D);
lv_pin("songbird_trill", lv_8, 4410, 0x3fa054c2e2bd9db4);
# snake_hiss: the noise path and the hiss envelope (RMS 0.0158966513)
var lv_9 = crvoice_vocalize(crvoice_new(PRANI_SP_SNAKE), PRANI_VOC_HISS, LV_SR, LV_D);
lv_pin("snake_hiss", lv_9, 4410, 0x3f90473635c0fe91);
# cricket_stridulate: the cricket pulse train (RMS 0.0501997929)
var lv_10 = crvoice_vocalize(crvoice_new(PRANI_SP_CRICKET), PRANI_VOC_STRIDULATE, LV_SR, LV_D2);
lv_pin("cricket_stridulate", lv_10, 8820, 0x3fa9b3c989c6b222);
# bee_buzz: the vibratile wing-beat (RMS 0.0466716208)
var lv_11 = crvoice_vocalize(crvoice_new(PRANI_SP_BEE), PRANI_VOC_BUZZ, LV_SR, LV_D);
lv_pin("bee_buzz", lv_11, 4410, 0x3fa7e557ba02e138);
# wolf_roar_effort09: vocal effort's amplitude and tilt (RMS 0.00600345544)
var lv_12 = crvoice_vocalize(crvoice_with_vocal_effort(crvoice_new(PRANI_SP_WOLF), LV_E09),
  PRANI_VOC_ROAR, LV_SR, LV_D);
lv_pin("wolf_roar_effort09", lv_12, 4410, 0x3f7897144c467864);
# chorus4_howl: the chorus offsets and its 1/sqrt(n) normalisation (RMS 0.0274810557)
var lv_13 = lv_chorus();
lv_pin("chorus4_howl", lv_13, 5292, 0x3f9c23fe6d2e59a3);
# stream_wolf_howl: the stream's intent amplitude and contour (RMS 0.0128207419)
var lv_14 = lv_drain(stream_new(crvoice_new(PRANI_SP_WOLF), PRANI_VOC_HOWL, PRANI_INTENT_TERRITORIAL, LV_SR, LV_D),
  512);
lv_pin("stream_wolf_howl", lv_14, 6615, 0x3f8a41c2dac8f211);
# stream_lion_roar: the stream's spectral tilt (RMS 0.0010293583)
var lv_15 = lv_drain(stream_new(crvoice_new(PRANI_SP_LION), PRANI_VOC_ROAR, PRANI_INTENT_IDLE, LV_SR, LV_D), 512);
lv_pin("stream_lion_roar", lv_15, 4410, 0x3f50dd710e399473);

var rc = assert_summary();
syscall(60, rc);

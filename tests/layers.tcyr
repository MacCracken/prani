# layers.tcyr -- 2.2.1 (audit D2). Every synthesis layer's level, pinned.
#
# WHY THIS SUITE EXISTS
#
# The 2.2.1 sweep mutated each post-tract layer -- dragon fire-breath, the chaos
# noise, canid biphonation, the nasal notch, the dual-source syrinx, the hiss
# envelope, effort's tilt, the cricket's pulses, the chorus scale and spread, the
# stream's amplitude and tilt -- and every one of 14 mutants passed all 19 suites.
# Those layers were checked only for "no error, right length, finite, audible".
#
# Each case renders one call that runs the layer named above it and pins its RMS to
# within a RELATIVE 1e-9 of the value recorded on the 2.2.1 tree. Relative, and that
# tight, because some layers are small next to what they ride on: the dragon's
# fire-breath moves a roar dominated by its 0.4 subharmonic by about 1e-6, far
# inside any tolerance in dB. 1e-9 is still a million times wider than the
# last-bit differences between architectures (ganita's transcendentals are
# per-arch, through linear filters; the suite passes under qemu-aarch64).
#
# ⚠ THESE ARE RECORDED VALUES, NOT ORACLE VALUES. A deliberate change to the audio
# (a svara bump that moves the pulse, a repaired render defect) moves them, and
# that is the point: the change has to be seen. Re-record them on purpose, with the
# reason in the CHANGELOG, by printing each case's RMS bits on the new tree. Never
# widen the tolerance to make a case pass.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/svara.cyr"
include "src/error.cyr"
include "src/logging.cyr"
include "src/rng.cyr"
include "src/dsp.cyr"
include "src/spatial.cyr"
include "src/vocalization.cyr"
include "src/fatigue.cyr"
include "src/emotion.cyr"
include "src/sequence.cyr"
include "src/species.cyr"
include "src/bridge.cyr"
include "src/tract.cyr"
include "src/voice.cyr"
include "src/preset.cyr"
include "src/stream.cyr"

alloc_init();

var LV_SR = 0x40e5888000000000;    # 44100.0
var LV_D = 0x3FB999999999999A;     # 0.1 s
var LV_D2 = 0x3FC999999999999A;    # 0.2 s: past the cricket's 4 syllables, into its silence
var LV_E09 = 0x3FECCCCCCCCCCCCD;   # effort 0.9
var LV_TOL = 0x3E112E0BE826D695;   # 1e-9, relative

# lv_rms(v) -- root-mean-square of a vec.
fn lv_rms(v) {
    var n = vec_len(v);
    var acc = 0;
    var i = 0;
    while (i < n) {
        var x = vec_get(v, i);
        acc = f64_add(acc, f64_mul(x, x));
        i = i + 1;
    }
    return f64_sqrt(f64_div(acc, f64_from(n)));
}

# lv_drain(st, bufn) -- a stream drained in bufn-sample fills, as a host would.
fn lv_drain(st, bufn) {
    var o = vec_new();
    var b = vec_new();
    prani_vec_push_zeros(b, bufn);
    while (stream_is_finished(st) == 0) {
        var n = stream_fill_buffer(st, b);
        if (n == 0) { return o; }
        var k = 0;
        while (k < n) {
            vec_push(o, vec_get(b, k));
            k = k + 1;
        }
    }
    return o;
}

# lv_chorus() -- four wolves howling 0.1 s with a 10 ms timing spread.
fn lv_chorus() {
    var vs = vec_new();
    var k = 0;
    while (k < 4) {
        vec_push(vs, crvoice_new(PRANI_SP_WOLF));
        k = k + 1;
    }
    return sequence_synthesize_chorus(vs, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, LV_SR, LV_D, 0x3F847AE147AE147B);
}

# lv_pin(name, v, n, rms_ref) -- the render is n samples and its RMS is within a
# relative LV_TOL of the recorded rms_ref. Records the assertions itself.
fn lv_pin(name, v, n, rms_ref) {
    test_group(name);
    assert_eq(prani_is_err(v), 0, "renders without error");
    if (prani_is_err(v) == 1) { return 0; }
    assert_eq(vec_len(v), n, "at the recorded length");
    var rel = f64_abs(f64_sub(f64_div(lv_rms(v), rms_ref), F64_ONE));
    assert_eq(f64_le(rel, LV_TOL), 1, "its RMS is the recorded level, within a relative 1e-9");
    return 0;
}

# dragon_roar: subharmonics, chaos noise and fire-breath (RMS 0.113115099)
var lv_1 = crvoice_vocalize(crvoice_new(PRANI_SP_DRAGON), PRANI_VOC_ROAR, LV_SR, LV_D);
lv_pin("dragon_roar", lv_1, 4410, 0x3fbcf51c711e1816);
# lion_roar: subharmonics and chaos noise (RMS 0.113115348)
var lv_2 = crvoice_vocalize(crvoice_new(PRANI_SP_LION), PRANI_VOC_ROAR, LV_SR, LV_D);
lv_pin("lion_roar", lv_2, 4410, 0x3fbcf520a23093ca);
# croc_rumble: the crocodilian subharmonic (RMS 0.114626304)
var lv_3 = crvoice_vocalize(crvoice_new(PRANI_SP_CROCODILIAN), PRANI_VOC_RUMBLE, LV_SR, LV_D);
lv_pin("croc_rumble", lv_3, 4410, 0x3fbd582644c55dc8);
# wolf_howl: biphonation, the formant transition and the nasal notch (RMS 0.0262776811)
var lv_4 = crvoice_vocalize(crvoice_new(PRANI_SP_WOLF), PRANI_VOC_HOWL, LV_SR, LV_D);
lv_pin("wolf_howl", lv_4, 4410, 0x3f9ae8895440751c);
# dog_whine: biphonation on a whine (RMS 0.0264844308)
var lv_5 = crvoice_vocalize(crvoice_new(PRANI_SP_DOG), PRANI_VOC_WHINE, LV_SR, LV_D);
lv_pin("dog_whine", lv_5, 4410, 0x3f9b1ebc10cd7ad0);
# dog_howl: biphonation on a dog (RMS 0.0260660493)
var lv_6 = crvoice_vocalize(crvoice_new(PRANI_SP_DOG), PRANI_VOC_HOWL, LV_SR, LV_D);
lv_pin("dog_howl", lv_6, 4410, 0x3f9ab10ef5652d65);
# cat_howl: the cat meow transition and its nasal notch (RMS 0.00238020656)
var lv_7 = crvoice_vocalize(crvoice_new(PRANI_SP_CAT), PRANI_VOC_HOWL, LV_SR, LV_D);
lv_pin("cat_howl", lv_7, 4410, 0x3f637fa7ab0756ba);
# songbird_trill: the dual-source syrinx and the trill AM (RMS 0.0203461913)
var lv_8 = crvoice_vocalize(crvoice_new(PRANI_SP_SONGBIRD), PRANI_VOC_TRILL, LV_SR, LV_D);
lv_pin("songbird_trill", lv_8, 4410, 0x3f94d5a1c83b5a35);
# snake_hiss: the noise path and the hiss envelope (RMS 0.0157448741)
var lv_9 = crvoice_vocalize(crvoice_new(PRANI_SP_SNAKE), PRANI_VOC_HISS, LV_SR, LV_D);
lv_pin("snake_hiss", lv_9, 4410, 0x3f901f6c9cf83d76);
# cricket_stridulate: the cricket pulse train (RMS 0.0501997929)
var lv_10 = crvoice_vocalize(crvoice_new(PRANI_SP_CRICKET), PRANI_VOC_STRIDULATE, LV_SR, LV_D2);
lv_pin("cricket_stridulate", lv_10, 8820, 0x3fa9b3c989c6b222);
# bee_buzz: the vibratile wing-beat (RMS 0.0466716208)
var lv_11 = crvoice_vocalize(crvoice_new(PRANI_SP_BEE), PRANI_VOC_BUZZ, LV_SR, LV_D);
lv_pin("bee_buzz", lv_11, 4410, 0x3fa7e557ba02e138);
# wolf_roar_effort09: vocal effort's amplitude and tilt (RMS 0.00607559166)
var lv_12 = crvoice_vocalize(crvoice_with_vocal_effort(crvoice_new(PRANI_SP_WOLF), LV_E09),
  PRANI_VOC_ROAR, LV_SR, LV_D);
lv_pin("wolf_roar_effort09", lv_12, 4410, 0x3f78e2b8376999bf);
# chorus4_howl: the chorus offsets and its 1/sqrt(n) normalisation (RMS 0.0273359004)
var lv_13 = lv_chorus();
lv_pin("chorus4_howl", lv_13, 5292, 0x3f9bfdf139c0fb38);
# stream_wolf_howl: the stream's intent amplitude and contour (RMS 0.00945801896)
var lv_14 = lv_drain(stream_new(crvoice_new(PRANI_SP_WOLF), PRANI_VOC_HOWL, PRANI_INTENT_TERRITORIAL, LV_SR, LV_D),
  512);
lv_pin("stream_wolf_howl", lv_14, 6615, 0x3f835eb9d0c77f99);
# stream_lion_roar: the stream's spectral tilt (RMS 0.000725419543)
var lv_15 = lv_drain(stream_new(crvoice_new(PRANI_SP_LION), PRANI_VOC_ROAR, PRANI_INTENT_IDLE, LV_SR, LV_D), 512);
lv_pin("stream_lion_roar", lv_15, 4410, 0x3f47c5429b8263cc);

var rc = assert_summary();
syscall(60, rc);

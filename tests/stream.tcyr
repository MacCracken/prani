# stream.tcyr -- tests for src/stream.cyr (ports 2.0.3:rust-old/src/stream.rs).
#
# Include order: dep bundles (hisab -> goonj -> naad -> svara) first, then the
# prani src modules in dependency order (error -> rng -> dsp -> vocalization ->
# sequence -> species -> bridge -> tract -> voice -> stream). The prani modules
# carry no `include` lines -- this entry orders them. sequence.cyr is pulled in
# for the CallBout struct species_bout_template references; its synthesize
# methods forward-reference crvoice_* which are defined once voice.cyr is
# included, so no undefined-fn warnings remain.
#
# PARITY APPROACH: exact svara-internal bit parity vs the f32 Rust oracle is NOT
# attainable -- f32->f64 widening diverges through svara's own DSP reached via
# crtract_synthesize (glottal shaping, formant biquads, DC blocker). So the
# svara-dependent output is asserted STRUCTURALLY: fill_buffer / next_block
# return the expected counts, advance samples_rendered correctly, is_finished
# flips true after a full render, and all produced samples are finite. Where the
# math is svara-INDEPENDENT (total_samples accounting, the supports rejection,
# fill/next-block sizing, pitch_contour_at interpolation) exact assertions are
# used (hand-computed against the oracle).

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/svara.cyr"
include "src/error.cyr"
include "src/logging.cyr"
include "src/rng.cyr"
include "src/dsp.cyr"
include "src/vocalization.cyr"
include "src/sequence.cyr"
include "src/species.cyr"
include "src/bridge.cyr"
include "src/tract.cyr"
include "src/voice.cyr"
include "src/stream.cyr"

# ---- test constants (IEEE-754 hex) -----------------------------------------
var T_SR       = 0x40e5888000000000;   # 44100.0 sample rate
var T_DUR_005  = 0x3fa999999999999a;   # 0.05 s -> 2205 samples @ 44100 (scale 1.0)
var T_400      = 0x4079000000000000;   # 400.0  wolf effective_f0 / HOWL contour base
var T_320      = 0x4074000000000000;   # 320.0  HOWL contour at t=0 == base*0.8
var T_0_1      = 0x3fb999999999999a;   # 0.1   (also used as a 0.1 s duration)
var T_1_0      = 0x3ff0000000000000;   # 1.0
var T_DUR_500  = 0x3fe0000000000000;   # 0.5 s -> 22050 samples @ 44100 (scale 1.0)
var T_DUR_300  = 0x3fd3333333333333;   # 0.3 s -> 13230 samples @ 44100 (scale 1.0)
var T_480      = 0x407e000000000000;   # 480.0  BARK contour at t=0 == base*1.2
# 400 * (1.2 + (1.0-1.2)*0.5) is NOT exactly 440 in f64 -- the BARK midpoint
# lands one ulp above it. Hand-computed following stream_pitch_contour_at's own
# operation order (frac = 0.05/0.1 = 0.5 exactly; v0 + (v1-v0)*frac = 1.1).
var T_440_ULP  = 0x407b800000000001;   # 440.00000000000006  BARK contour at t=0.05

alloc_init();

# ---- helpers ---------------------------------------------------------------
# all_finite(vec) -- 1 iff every element passes prani_is_finite.
#must_use
fn t_all_finite(v) {
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        if (prani_is_finite(vec_get(v, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ================================================================
test_group("stream_new -- valid vocalization (Wolf HOWL, Social)");
# Wolf effective_f0 400, Social pitch_scale 1.0 -> f0 400. Social duration_scale
# 1.0 -> total_samples = 0.05 * 1.0 * 44100 = 2205.
var s = stream_new(crvoice_new(PRANI_SP_WOLF), PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR, T_DUR_005);
assert_eq(prani_is_err(s), 0, "wolf howl stream_new -> non-error");
assert_eq(stream_total_samples(s), 2205, "total_samples == 2205 (0.05*1.0*44100)");
assert_eq(stream_samples_rendered(s), 0, "samples_rendered starts at 0");
assert_eq(stream_is_finished(s), 0, "fresh stream not finished");

# ================================================================
test_group("stream_new -- rejection (Snake howl -> error)");
# Snake apparatus is NoiseOnly; Howl not in {Hiss,Growl} -> unsupported.
var bad = stream_new(crvoice_new(PRANI_SP_SNAKE), PRANI_VOC_HOWL, PRANI_INTENT_IDLE, T_SR, T_DUR_005);
assert_eq(prani_is_err(bad), 1, "snake howl stream_new -> error");
assert_eq(bad, PRANI_ERR_INVALID_VOCALIZATION, "snake howl -> PRANI_ERR_INVALID_VOCALIZATION");

# ================================================================
test_group("stream_new -- intent scales total_samples (Mating x2)");
# Mating duration_scale = 2.0 -> total doubles: 0.05 * 2 * 44100 = 4410.
var s_m = stream_new(crvoice_new(PRANI_SP_SONGBIRD), PRANI_VOC_TRILL, PRANI_INTENT_MATING, T_SR, T_DUR_005);
assert_eq(prani_is_err(s_m), 0, "songbird mating trill stream_new -> non-error");
assert_eq(stream_total_samples(s_m), 4410, "mating (x2 duration) total_samples == 4410");

# ================================================================
test_group("stream_pitch_contour_at -- hand-computed HOWL (base 400)");
# HOWL[0] = 0.8 -> base*0.8 = 320 at t=0 (exact, closed-form).
assert_eq(stream_pitch_contour_at(PRANI_VOC_HOWL, T_400, 0), T_320, "HOWL t=0 == base*0.8 == 320");
# t < 0 clamps to 0 -> same 320.
assert_eq(stream_pitch_contour_at(PRANI_VOC_HOWL, T_400, f64_neg(T_1_0)), T_320, "HOWL t=-1 clamps to 0 -> 320");
# FLAT contour (GROWL) is base everywhere.
assert_eq(stream_pitch_contour_at(PRANI_VOC_GROWL, T_400, T_0_1), T_400, "FLAT (growl) t=0.1 == base == 400");

# ================================================================
test_group("stream_pitch_contour_at -- hand-computed BARK/YELP (base 400)");
# BARK/YELP table (src/stream.cyr stream_contour_bark, transcribed from
# `git show 2.0.3:rust-old/src/stream.rs`): (0.0,1.2),(0.1,1.0),(1.0,0.8). It is
# the only contour with an early knee (0.1), so the first segment is 10x steeper
# than the second -- a table swapped with HOWL's or ROAR's fails every row below.
assert_eq(stream_pitch_contour_at(PRANI_VOC_BARK, T_400, 0), T_480, "BARK t=0 == base*1.2 == 480");
# t=0.05 is the midpoint of the steep first segment: 1.2 + (1.0-1.2)*0.5 == 1.1.
assert_eq(stream_pitch_contour_at(PRANI_VOC_BARK, T_400, T_DUR_005), T_440_ULP, "BARK t=0.05 == base*1.1");
# the knee itself: frac == 1 on segment 0 -> exactly base*1.0.
assert_eq(stream_pitch_contour_at(PRANI_VOC_BARK, T_400, T_0_1), T_400, "BARK knee t=0.1 == base == 400");
assert_eq(stream_pitch_contour_at(PRANI_VOC_BARK, T_400, T_1_0), T_320, "BARK t=1 == base*0.8 == 320");
# YELP shares the BARK table (both dispatch to stream_contour_bark).
assert_eq(stream_pitch_contour_at(PRANI_VOC_YELP, T_400, 0), T_480, "YELP t=0 shares BARK table == 480");

# ================================================================
test_group("fill_buffer -- writes min(buf,remaining), advances rendered");
# Small buffer (512) over a 2205-sample stream: first fill writes 512.
var sf = stream_new(crvoice_new(PRANI_SP_WOLF), PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR, T_DUR_005);
var buf = vec_new();
var bi = 0;
while (bi < 512) { vec_push(buf, 0); bi = bi + 1; }
var wrote = stream_fill_buffer(sf, buf);
assert_eq(wrote, 512, "first fill_buffer writes full 512 (< remaining 2205)");
assert_eq(stream_samples_rendered(sf), 512, "samples_rendered advanced to 512");
assert_eq(stream_is_finished(sf), 0, "not finished after 512/2205");
assert_eq(t_all_finite(buf), 1, "filled buffer all finite");

# ================================================================
test_group("fill_buffer -- final partial fill returns remaining, flips finished");
# Render the rest in one big buffer of 4096 (> remaining 1693) -> writes 1693.
var buf2 = vec_new();
var bj = 0;
while (bj < 4096) { vec_push(buf2, 0); bj = bj + 1; }
var wrote2 = stream_fill_buffer(sf, buf2);
assert_eq(wrote2, 1693, "final fill writes remaining 1693 (2205-512)");
assert_eq(stream_samples_rendered(sf), 2205, "samples_rendered == total 2205");
assert_eq(stream_is_finished(sf), 1, "is_finished flips true after full render");
# a subsequent fill on a finished stream writes 0.
var wrote3 = stream_fill_buffer(sf, buf2);
assert_eq(wrote3, 0, "fill_buffer on finished stream writes 0");

# ================================================================
test_group("next_block -- sizing (clamps to remaining, empty at end)");
var sn = stream_new(crvoice_new(PRANI_SP_WOLF), PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR, T_DUR_005);
# block_size 1000 < remaining 2205 -> vec of 1000.
var blk1 = stream_next_block(sn, 1000);
assert_eq(vec_len(blk1), 1000, "next_block(1000) -> 1000 samples");
assert_eq(stream_samples_rendered(sn), 1000, "rendered advanced to 1000");
assert_eq(t_all_finite(blk1), 1, "next_block output finite");
assert_eq(stream_is_finished(sn), 0, "not finished after a partial next_block");
# block_size 5000 > remaining 1205 -> clamped to 1205.
var blk2 = stream_next_block(sn, 5000);
assert_eq(vec_len(blk2), 1205, "next_block(5000) clamps to remaining 1205");
assert_eq(stream_is_finished(sn), 1, "finished after draining");
# now empty vec.
var blk3 = stream_next_block(sn, 512);
assert_eq(vec_len(blk3), 0, "next_block on finished stream -> empty vec");

# ================================================================
test_group("cat purr special path -- fills + finite");
# Cat PURR (is_cat_purr path). Idle duration_scale 1.0 -> total 2205.
var sp = stream_new(crvoice_new(PRANI_SP_CAT), PRANI_VOC_PURR, PRANI_INTENT_IDLE, T_SR, T_DUR_005);
assert_eq(prani_is_err(sp), 0, "cat purr stream_new -> non-error");
assert_eq(stream_total_samples(sp), 2205, "cat purr total_samples == 2205");
var pbuf = vec_new();
var pk = 0;
while (pk < 2205) { vec_push(pbuf, 0); pk = pk + 1; }
var pwrote = stream_fill_buffer(sp, pbuf);
assert_eq(pwrote, 2205, "cat purr fill writes all 2205 in one pass");
assert_eq(stream_is_finished(sp), 1, "cat purr finished after full fill");
assert_eq(t_all_finite(pbuf), 1, "cat purr output all finite");

# ================================================================
test_group("noise-only path -- Snake hiss stream fills + finite");
# Snake HISS is supported (NoiseOnly apparatus). Exercises crtract_synthesize
# noise path through the stream.
var sh = stream_new(crvoice_new(PRANI_SP_SNAKE), PRANI_VOC_HISS, PRANI_INTENT_IDLE, T_SR, T_DUR_005);
assert_eq(prani_is_err(sh), 0, "snake hiss stream_new -> non-error");
var hbuf = vec_new();
var hk = 0;
while (hk < 2205) { vec_push(hbuf, 0); hk = hk + 1; }
var hwrote = stream_fill_buffer(sh, hbuf);
assert_eq(hwrote, 2205, "snake hiss fill writes all 2205");
assert_eq(t_all_finite(hbuf), 1, "snake hiss output all finite");

# ================================================================
test_group("determinism -- two identical full-pass streams bit-identical");
# Two fresh identical streams each drained in a single fill produce bit-identical
# output (same species seed -> same rng phase, same tilt/amp, same contour t=0).
var sa = stream_new(crvoice_new(PRANI_SP_WOLF), PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR, T_DUR_005);
var sb = stream_new(crvoice_new(PRANI_SP_WOLF), PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR, T_DUR_005);
var refa = vec_new();
var refb = vec_new();
var rk = 0;
while (rk < 2205) { vec_push(refa, 0); vec_push(refb, 0); rk = rk + 1; }
stream_fill_buffer(sa, refa);
stream_fill_buffer(sb, refb);
var same = 1;
var ck = 0;
while (ck < 2205) {
    if (vec_get(refa, ck) != vec_get(refb, ck)) { same = 0; }
    ck = ck + 1;
}
assert_eq(same, 1, "identical streams -> bit-identical full-pass output");
assert_eq(t_all_finite(refa), 1, "full-pass output all finite");

# ================================================================
test_group("full drain -- 512-sample buffer over 0.5 s (release-boundary arm)");
# Mirrors `git show 2.0.3:rust-old/tests/integration.rs`
# test_stream_produces_same_length_as_batch: Wolf/HOWL/Social, 44100 Hz, 0.5 s.
# Social duration_scale 1.0 -> 22050 samples; a 512-sample buffer drains it in
# 43 full passes plus a 34-sample tail. Passes 37..43 start at t >= 18944/22050
# == 0.859, so this is the only assertion in the suite that reaches the
# `t > 0.85` release-boundary arm of stream_fill_buffer -- every other fill in
# the suite starts at t = 0, 0.2322 or 0.4535.
var sdr = stream_new(crvoice_new(PRANI_SP_WOLF), PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR, T_DUR_500);
assert_eq(prani_is_err(sdr), 0, "wolf howl 0.5 s stream_new -> non-error");
assert_eq(stream_total_samples(sdr), 22050, "total_samples == 22050 (0.5*1.0*44100)");
var dbuf = vec_new();
prani_vec_push_zeros(dbuf, 512);
var streamed = vec_new();
var passes = 0;
var dfinite = 1;
# Bounded drain: 44 passes are expected, the guard trips at 64. A regression
# that stops advancing samples_rendered exits here and fails `passes == 44`
# rather than hanging the suite.
while (stream_is_finished(sdr) == 0 && passes < 64) {
    var n = stream_fill_buffer(sdr, dbuf);
    if (t_all_finite(dbuf) == 0) { dfinite = 0; }
    var di = 0;
    while (di < n) {
        vec_push(streamed, vec_get(dbuf, di));
        di = di + 1;
    }
    passes = passes + 1;
}
assert_eq(passes, 44, "drained in exactly 44 fill_buffer passes (43x512 + 34)");
assert_eq(stream_is_finished(sdr), 1, "drain loop terminated -- stream finished");
assert_eq(vec_len(streamed), 22050, "accumulated 22050 samples across the drain");
assert_eq(vec_len(streamed), stream_total_samples(sdr), "accumulated == stream_total_samples()");
assert_eq(dfinite, 1, "every pass all finite (incl. the t > 0.85 release blocks)");
# batch/stream length parity in ONE assertion, on the oracle's own species and
# intent (previously split across two literal assertions in two suites).
var vbatch = crvoice_new(PRANI_SP_WOLF);
var batch = crvoice_vocalize_with_intent(vbatch, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR, T_DUR_500);
assert_eq(prani_is_err(batch), 0, "wolf howl 0.5 s social batch -> non-error");
assert_eq(vec_len(batch), vec_len(streamed), "batch length == streamed length");
assert_eq(t_all_finite(batch), 1, "batch output all finite");

# ================================================================
test_group("full drain -- control: block-wise render diverges from single-pass");
# A single 22050-sample fill renders the whole stream at t = 0: one contour
# point (400*0.8 == 320) and one boundary_boost (the t < 0.1 attack arm). The
# 512-block drain above re-evaluates t on every pass. The two outputs must
# therefore differ -- if fill_buffer ever stopped advancing t per block, this is
# the assertion that catches it, since length and finiteness would still hold.
var sone = stream_new(crvoice_new(PRANI_SP_WOLF), PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR, T_DUR_500);
var obuf = vec_new();
prani_vec_push_zeros(obuf, 22050);
assert_eq(stream_fill_buffer(sone, obuf), 22050, "single-pass fill writes all 22050");
var ndiff = 0;
var oi = 0;
while (oi < 22050) {
    if (vec_get(obuf, oi) != vec_get(streamed, oi)) { ndiff = ndiff + 1; }
    oi = oi + 1;
}
assert_gt(ndiff, 0, "block-wise drain diverges from single-pass (t advances per block)");

# ================================================================
test_group("stream_finishes -- Wolf BARK drained by next_block (oracle case)");
# Mirrors `git show 2.0.3:rust-old/tests/integration.rs` test_stream_finishes:
# Wolf/BARK/Idle, 44100 Hz, 0.1 s. Idle duration_scale 1.0 -> 4410 samples. This
# is the only BARK stream in the suite, so it is what executes the BARK/YELP
# branch of stream_pitch_contour_at end-to-end.
var sbk = stream_new(crvoice_new(PRANI_SP_WOLF), PRANI_VOC_BARK, PRANI_INTENT_IDLE, T_SR, T_0_1);
assert_eq(prani_is_err(sbk), 0, "wolf bark stream_new -> non-error");
assert_eq(stream_total_samples(sbk), 4410, "bark total_samples == 4410 (0.1*1.0*44100)");
var bk_blocks = 0;
var bk_total = 0;
var bk_finite = 1;
# Bounded drain: 5 blocks are expected (4x1024 + 314), the guard trips at 16.
while (stream_is_finished(sbk) == 0 && bk_blocks < 16) {
    var bblk = stream_next_block(sbk, 1024);
    bk_total = bk_total + vec_len(bblk);
    if (t_all_finite(bblk) == 0) { bk_finite = 0; }
    bk_blocks = bk_blocks + 1;
}
assert_eq(bk_blocks, 5, "drained in exactly 5 next_block(1024) calls (4x1024 + 314)");
assert_eq(bk_total, 4410, "next_block drain yields exactly total_samples");
assert_eq(bk_finite, 1, "every bark block all finite");
assert_eq(stream_is_finished(sbk), 1, "is_finished flips after the drain loop");
# the oracle's closing assertion: fill_buffer on a next_block-retired stream.
var tiny = vec_new();
prani_vec_push_zeros(tiny, 64);
assert_eq(stream_fill_buffer(sbk, tiny), 0, "fill_buffer on a next_block-retired stream writes 0");

# ================================================================
test_group("next_block -- cat purr special path (oracle: Cat/PURR/Idle, 0.3 s)");
# Mirrors `git show 2.0.3:rust-old/tests/integration.rs` test_stream_next_block,
# which deliberately picks Cat + Purr. The purr path was previously reached only
# through stream_fill_buffer, never through stream_next_block.
var scp = stream_new(crvoice_new(PRANI_SP_CAT), PRANI_VOC_PURR, PRANI_INTENT_IDLE, T_SR, T_DUR_300);
assert_eq(prani_is_err(scp), 0, "cat purr 0.3 s stream_new -> non-error");
assert_eq(stream_total_samples(scp), 13230, "cat purr total_samples == 13230 (0.3*1.0*44100)");
var cblk = stream_next_block(scp, 256);
assert_eq(vec_len(cblk), 256, "cat purr next_block(256) -> 256 samples");
assert_eq(t_all_finite(cblk), 1, "cat purr next_block output all finite");
assert_eq(stream_samples_rendered(scp), 256, "cat purr rendered advanced to 256");
assert_eq(stream_is_finished(scp), 0, "not finished after a partial next_block");
# Control: the purr generator carries laryngeal phase, rng and DC-blocker state
# across calls (src/tract.cyr crtract_synthesize_purr), so a second block cannot
# repeat the first. A stream that rebuilt its tract per call, or reset phase,
# would emit an identical block and still pass every assertion above.
var cblk2 = stream_next_block(scp, 256);
assert_eq(vec_len(cblk2), 256, "cat purr second next_block(256) -> 256 samples");
assert_eq(stream_samples_rendered(scp), 512, "cat purr rendered advanced to 512");
var cdiff = 0;
var cq = 0;
while (cq < 256) {
    if (vec_get(cblk, cq) != vec_get(cblk2, cq)) { cdiff = cdiff + 1; }
    cq = cq + 1;
}
assert_gt(cdiff, 0, "purr stream advances state -- block 2 differs from block 1");

# ================================================================
# 2.0.5 -- input-range validation. Every group below asserts a REJECTION plus a
# control proving the accepted range is untouched. The ranges themselves are
# written down in src/stream.cyr's INPUT RANGES header block.
# ================================================================

# ---- 2.0.5 test constants ---------------------------------------------------
var T_1E300    = 0x7e37e43c8800759c;   # 1e300   finite, but 1e300 samples is not
var T_2P53     = 0x4340000000000000;   # 2^53    9007199254740992, the ceiling
var T_2P54     = 0x4350000000000000;   # 2^54    one binade past the ceiling
var T_1_7E308  = 0x7fee42d130773b76;   # 1.7e308 finite f0; x1.2 (BARK) is +inf
var T_0_8      = 0x3fe999999999999a;   # 0.8     a real vocal-effort setting
var T_2_0      = 0x4000000000000000;   # 2.0     a real size scale
var T_NAN = f64_div(0, 0);

# ================================================================
test_group("2.0.5 stream_new -- sample_rate must be finite and > 0");
# RANGE: (0, +inf) finite. No floor of prani's own -- svara owns the real
# threshold (~1000 Hz) and ADR-0001 forbids restating it here.
var g_v = crvoice_new(PRANI_SP_WOLF);
assert_eq(stream_new(g_v, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_NAN, T_DUR_005),
  PRANI_ERR_INVALID_TRACT, "NaN sample_rate -> PRANI_ERR_INVALID_TRACT");
assert_eq(stream_new(g_v, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, PRANI_POS_INF, T_DUR_005),
  PRANI_ERR_INVALID_TRACT, "+inf sample_rate -> PRANI_ERR_INVALID_TRACT");
assert_eq(stream_new(g_v, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, 0, T_DUR_005),
  PRANI_ERR_INVALID_TRACT, "zero sample_rate -> PRANI_ERR_INVALID_TRACT");
assert_eq(stream_new(g_v, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, f64_neg(T_SR), T_DUR_005),
  PRANI_ERR_INVALID_TRACT, "negative sample_rate -> PRANI_ERR_INVALID_TRACT");
# CONTROL: the ADR-0001/ADR-0003 split is preserved exactly. 10 Hz is a rate
# svara will refuse, and stream_new must STILL construct -- the refusal belongs
# to the first fill, which reports 0 written and retires (tests/hardening.tcyr
# pins that contract, and this guard must not move it forward to construction).
var g_lo = stream_new(g_v, PRANI_VOC_HOWL, PRANI_INTENT_IDLE, f64_from(10), T_1_0);
assert_eq(prani_is_err(g_lo), 0, "10 Hz still CONSTRUCTS -- svara's floor stays a fill-time failure");
var g_lobuf = vec_new();
prani_vec_push_zeros(g_lobuf, 8);
assert_eq(stream_fill_buffer(g_lo, g_lobuf), 0, "and the 10 Hz stream fails at the fill (ADR-0003)");
assert_eq(stream_is_finished(g_lo), 1, "and retires so a drain loop terminates (ADR-0003)");

# ================================================================
test_group("2.0.5 stream_new -- duration must be finite and >= 0 (zero is VALID)");
# RANGE: [0, +inf) finite. Zero is accepted because the oracle's
# test_zero_duration_synthesis asserts an empty buffer, NOT an error.
var g_z = stream_new(g_v, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR, 0);
assert_eq(prani_is_err(g_z), 0, "zero duration constructs (oracle: empty, not an error)");
assert_eq(stream_total_samples(g_z), 0, "zero duration -> total_samples 0");
assert_eq(stream_is_finished(g_z), 1, "zero-duration stream is finished on arrival");
var g_zbuf = vec_new();
prani_vec_push_zeros(g_zbuf, 32);
assert_eq(stream_fill_buffer(g_z, g_zbuf), 0, "and it writes 0 samples");
assert_eq(stream_new(g_v, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR, T_NAN),
  PRANI_ERR_INVALID_VOCALIZATION, "NaN duration -> PRANI_ERR_INVALID_VOCALIZATION");
assert_eq(stream_new(g_v, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR, PRANI_POS_INF),
  PRANI_ERR_INVALID_VOCALIZATION, "+inf duration -> PRANI_ERR_INVALID_VOCALIZATION");
# DIVERGENCE from the oracle: Rust's `(effective_duration * sample_rate) as usize`
# saturates a negative product to 0, so a negative duration produced a silent
# empty stream there. f64 -> i64 in Cyrius does not saturate to 0 (it keeps the
# sign), so the port would hand the host total_samples == -44100. Report it.
assert_eq(stream_new(g_v, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR, f64_neg(T_1_0)),
  PRANI_ERR_INVALID_VOCALIZATION, "negative duration -> error (oracle silently returned empty)");

# ================================================================
test_group("2.0.5 stream_new -- total_samples must be exactly representable");
# RANGE: duration * duration_scale * sample_rate in [0, 2^53]. The bound is
# f64's exact-integer ceiling, not a taste call: past i64's range f64_to
# saturates to i64::MIN for finite AND non-finite inputs alike (measured
# 2026-08-31 and pinned here), which is what made an unguarded huge duration a
# NEGATIVE total_samples and a stream that claimed to be finished.
assert_lt(f64_to(T_1E300), 0, "measured: f64_to(1e300) saturates NEGATIVE (i64::MIN)");
assert_eq(f64_to(T_NAN), f64_to(PRANI_POS_INF), "measured: NaN and +inf both saturate to the same i64::MIN");
assert_eq(f64_to(T_2P53), 9007199254740992, "measured: 2^53 converts exactly");
assert_eq(stream_new(g_v, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR, T_1E300),
  PRANI_ERR_INVALID_VOCALIZATION, "1e300 s at 44.1 kHz -> rejected (product overflows to +inf)");
assert_eq(stream_new(g_v, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_1_0, T_1E300),
  PRANI_ERR_INVALID_VOCALIZATION, "finite-but-unrepresentable product (1e300 samples) also rejected");
# the ceiling itself, from both sides, at 1 Hz so the product is the duration.
var g_max = stream_new(g_v, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_1_0, T_2P53);
assert_eq(prani_is_err(g_max), 0, "exactly 2^53 samples is accepted (the boundary is inclusive)");
assert_eq(stream_total_samples(g_max), 9007199254740992, "and total_samples is that count exactly");
assert_eq(stream_new(g_v, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_1_0, T_2P54),
  PRANI_ERR_INVALID_VOCALIZATION, "2^54 samples -> rejected");
# the intent scale is INSIDE the check: Mating doubles an accepted duration.
assert_eq(stream_new(g_v, PRANI_VOC_HOWL, PRANI_INTENT_MATING, T_1_0, T_2P53),
  PRANI_ERR_INVALID_VOCALIZATION, "Mating (x2 duration) pushes an accepted 2^53 over the ceiling");
# CONTROL: an hour of audio at 44.1 kHz is 158,760,000 samples and still builds.
var g_hr = stream_new(g_v, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR, f64_from(3600));
assert_eq(prani_is_err(g_hr), 0, "an hour-long stream still constructs");
assert_eq(stream_total_samples(g_hr), 158760000, "3600 s * 44100 == 158760000 samples");

# ================================================================
test_group("2.0.5 stream_new -- a NaN voice config is rejected at the snapshot (F11)");
# The builders clamp, and f64_clamp(NaN, lo, hi) is NaN (measured), so a NaN
# reaches the voice intact. crvoice_with_* return `self` and have no error
# channel (roadmap 2.1.0), so the guard lands where the stream SNAPSHOTS them.
var g_vn = crvoice_with_size(crvoice_new(PRANI_SP_WOLF), T_NAN);
assert_eq(prani_is_finite(crvoice_effective_f0(g_vn)), 0,
  "measured: a NaN size_scale survives every clamp into effective_f0");
assert_eq(stream_new(g_vn, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR, T_DUR_005),
  PRANI_ERR_INVALID_SPECIES, "NaN f0 snapshot -> PRANI_ERR_INVALID_SPECIES");
var g_ve = crvoice_with_vocal_effort(crvoice_new(PRANI_SP_WOLF), T_NAN);
assert_eq(prani_is_finite(crvoice_vocal_effort(g_ve)), 0,
  "measured: a NaN vocal_effort survives its clamp too");
assert_eq(stream_new(g_ve, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR, T_DUR_005),
  PRANI_ERR_INVALID_SPECIES, "NaN effort_amp/spectral_tilt snapshot -> PRANI_ERR_INVALID_SPECIES");
# CONTROL: a real builder chain is untouched and still streams finite audio.
var g_vok = crvoice_with_vocal_effort(crvoice_with_size(crvoice_new(PRANI_SP_WOLF), T_2_0), T_0_8);
var g_sok = stream_new(g_vok, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR, T_DUR_005);
assert_eq(prani_is_err(g_sok), 0, "size 2.0 + effort 0.8 still constructs");
var g_okbuf = vec_new();
prani_vec_push_zeros(g_okbuf, 256);
assert_eq(stream_fill_buffer(g_sok, g_okbuf), 256, "and still fills 256 samples");
assert_eq(t_all_finite(g_okbuf), 1, "and what it writes is finite");

# ================================================================
test_group("2.0.5 stream handles -- null and unchecked error codes");
# A negative handle is an unchecked deserializer/constructor code, which is F1's
# crash class (dereferencing a small negative integer), not a numeric range --
# but it arrives through the same door and costs one comparison.
assert_eq(stream_new(0, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR, T_DUR_005),
  PRANI_ERR_INVALID_SPECIES, "null voice -> PRANI_ERR_INVALID_SPECIES, not a deref");
assert_eq(stream_new(PRANI_ERR_INVALID_SPECIES, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR, T_DUR_005),
  PRANI_ERR_INVALID_SPECIES, "an unchecked crvoice_from_json_str code -> rejected, not dereferenced");
var g_h = stream_new(g_v, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR, T_DUR_005);
var g_hbuf = vec_new();
prani_vec_push_zeros(g_hbuf, 64);
assert_eq(stream_fill_buffer(0, g_hbuf), 0, "fill on a null stream -> 0 written");
assert_eq(stream_fill_buffer(PRANI_ERR_INVALID_VOCALIZATION, g_hbuf), 0,
  "fill on an unchecked stream_new code -> 0 written");
assert_eq(stream_fill_buffer(g_h, 0), 0, "fill with a null buffer -> 0 written");
assert_eq(stream_samples_rendered(g_h), 0,
  "a bad-handle fill does NOT retire the stream -- caller mistake, not a stream property (ADR-0003)");
assert_eq(stream_is_finished(g_h), 0, "so the stream is still live");
assert_eq(stream_fill_buffer(g_h, g_hbuf), 64, "and a real buffer still fills it");
assert_eq(stream_next_block(0, 256), PRANI_ERR_INVALID_VOCALIZATION,
  "next_block on a null stream -> PRANI_ERR_INVALID_VOCALIZATION");

# ================================================================
test_group("2.0.5 stream_next_block -- block_size must be >= 0");
# RANGE: [0, +inf). No upper bound -- block_size is clamped to `remaining`,
# which stream_new already bounded. A NEGATIVE block_size used to walk straight
# through the sizing arithmetic and return an EMPTY VEC, indistinguishable from
# a finished stream: the silent-empty result 2.0.5 exists to replace.
var g_nb = stream_new(g_v, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR, T_DUR_005);
var g_neg = stream_next_block(g_nb, 0 - 5);
assert_eq(prani_is_err(g_neg), 1, "negative block_size -> an error code, not an empty vec");
assert_eq(g_neg, PRANI_ERR_INVALID_VOCALIZATION, "negative block_size -> PRANI_ERR_INVALID_VOCALIZATION");
assert_eq(stream_samples_rendered(g_nb), 0, "a rejected block_size consumed nothing");
# CONTROL: 0 is a legal block_size (the oracle's min() reaches it naturally) and
# a huge one is clamped, not rejected.
assert_eq(vec_len(stream_next_block(g_nb, 0)), 0, "block_size 0 -> empty vec (unchanged)");
assert_eq(stream_samples_rendered(g_nb), 0, "and block_size 0 consumed nothing either");
var g_big = stream_next_block(g_nb, 100000);
assert_eq(vec_len(g_big), 2205, "block_size 100000 clamps to the remaining 2205 (no upper bound)");
assert_eq(t_all_finite(g_big), 1, "and the clamped block is finite");

# ================================================================
test_group("2.0.5 stream_pitch_contour_at -- a NaN t propagates, it does not fabricate");
# MEASURED before the guard: f64_clamp(NaN, 0, 1) is NaN, so every comparison in
# the table walk is false and the fallthrough returned base_f0 * <last
# multiplier> == 400 * 0.6 == 240 Hz -- a perfectly plausible howl f0 for an
# input that means nothing. The function returns an f64, not a "value or
# negative code" (PRANI_ERR_INVALID_TRACT is -1, which is itself a NaN bit
# pattern), so there is no code to return: propagate the NaN.
assert_eq(prani_is_finite(stream_pitch_contour_at(PRANI_VOC_HOWL, T_400, T_NAN)), 0,
  "NaN t -> NaN, not a fabricated f0");
assert_neq(f64_to(stream_pitch_contour_at(PRANI_VOC_HOWL, T_400, T_NAN)), 240,
  "specifically NOT the 240 Hz the fallthrough used to invent");
# CONTROL: infinities are NOT NaN -- the clamp bounds them, which is the oracle's
# own behaviour (f32 clamp(inf, 0, 1) == 1), so they must still return an f0.
assert_eq(stream_pitch_contour_at(PRANI_VOC_HOWL, T_400, PRANI_POS_INF),
  stream_pitch_contour_at(PRANI_VOC_HOWL, T_400, T_1_0), "+inf t clamps to 1 -> same f0 as t=1");
assert_eq(stream_pitch_contour_at(PRANI_VOC_HOWL, T_400, PRANI_NEG_INF), T_320,
  "-inf t clamps to 0 -> 320, exactly as t=0 does");
assert_eq(prani_is_finite(stream_pitch_contour_at(PRANI_VOC_HOWL, T_NAN, 0)), 0,
  "a NaN base_f0 propagates as it always did");

# ================================================================
test_group("2.0.5 fill_buffer -- a non-finite contour retires the stream (ADR-0003)");
# stream_new proves f0 finite, but the contour MULTIPLIES it -- BARK opens at
# 1.2x -- so an f0 near f64::MAX overflows to +inf on the way to svara. This is
# the point-of-use guard for the one non-finite value stream_new cannot catch.
# The state is built the way a crafted JSON document builds it: a params block
# whose f0 range is absurd but finite.
var g_vbig = crvoice_new(PRANI_SP_WOLF);
SpeciesParams_set_f0_max(CreatureVoice_params(g_vbig), T_1_7E308);
SpeciesParams_set_f0_default(CreatureVoice_params(g_vbig), T_1_7E308);
assert_eq(prani_is_finite(crvoice_effective_f0(g_vbig)), 1, "1.7e308 is a FINITE f0 -- stream_new accepts it");
var g_sbig = stream_new(g_vbig, PRANI_VOC_BARK, PRANI_INTENT_IDLE, T_SR, T_DUR_005);
assert_eq(prani_is_err(g_sbig), 0, "so the stream constructs");
assert_eq(stream_total_samples(g_sbig), 2205, "with a normal 2205-sample length");
var g_bbuf = vec_new();
prani_vec_push_zeros(g_bbuf, 64);
assert_eq(stream_fill_buffer(g_sbig, g_bbuf), 0,
  "but the fill reports 0 written -- 1.7e308 * 1.2 is +inf, never handed to svara");
assert_eq(stream_is_finished(g_sbig), 1, "and the stream retires (ADR-0003), so a drain loop terminates");

# ================================================================
# 2.0.9 -- stream_fill_buffer allocates nothing of its own.
#
# `alloc()` is a bump arena that NEVER FREES, and src/stream.cyr's header
# advertises stream_fill_buffer for host audio callbacks (Wwise, FMOD, Godot,
# JACK). At 44100 Hz with a 512-sample block that is 86 calls a second, every
# byte of them retained for the life of the process.
#
# MEASURED BEFORE the repair, with alloc_used() around ten steady-state fills of
# a Wolf/HOWL/Idle stream (the exact figures are transcribed in
# src/stream.cyr's ALLOCATION note):
#
#   8800 B/fill  =  8088 (crtract_synthesize's block vec, six geometric grows)
#                 +  512 (svara_glottal_new, per block, inside that call)
#                 +  152 (stream_pitch_contour_at's fresh point vec)
#                 +   32 (prani_intent_modifiers, for one of its four fields)
#                 +   16 (crtract_options_new)
#
# AFTER: 8600 B/fill. The 200 B this module owned are gone; the 8600 that remain
# are allocated inside src/tract.cyr and svara and cannot be reached from
# stream.cyr (they need a `crtract_synthesize_into` and a cached glottal source,
# both of which have a second caller in voice.cyr).
#
# So the assertion is a DIFFERENCE, not a constant: a fill must cost exactly what
# the one crtract_synthesize call inside it costs, and not one byte more. That
# pins stream.cyr's own share at 0 without going stale the day tract.cyr or svara
# gets its own repair -- both sides of the subtraction move together.
test_group("2.0.9 fill_buffer -- allocates nothing of its own (bump arena never frees)");
var a_st = stream_new(crvoice_new(PRANI_SP_WOLF), PRANI_VOC_HOWL, PRANI_INTENT_IDLE, T_SR, T_1_0);
var a_buf = vec_new();
prani_vec_push_zeros(a_buf, 512);
# warm: the first fill builds the tract (crtract_new + species_params). That
# allocation is expected and is NOT what this group measures.
stream_fill_buffer(a_st, a_buf);
var a_b0 = alloc_used();
var a_i = 0;
while (a_i < 10) {
    stream_fill_buffer(a_st, a_buf);
    a_i = a_i + 1;
}
var a_b1 = alloc_used();
var a_fill = (a_b1 - a_b0) / 10;
# CONTROL: the one crtract_synthesize call a standard-path fill makes, measured
# on its own on a second stream's tract so the measurement cannot disturb a_st.
# `options` is built OUTSIDE the measured window -- inside it, it would re-add
# the 16 B this repair removed and hide a regression.
var a_st2 = stream_new(crvoice_new(PRANI_SP_WOLF), PRANI_VOC_HOWL, PRANI_INTENT_IDLE, T_SR, T_1_0);
stream_fill_buffer(a_st2, a_buf);
var a_tr = SynthStream_tract(a_st2);
var a_opt = crtract_options_new(0, T_1_0);
var a_c0 = alloc_used();
var a_j = 0;
while (a_j < 10) {
    crtract_synthesize(a_tr, T_400, 512, a_opt);
    a_j = a_j + 1;
}
var a_c1 = alloc_used();
var a_tract = (a_c1 - a_c0) / 10;
assert_gt(a_tract, 0, "control: the ALLOCATING crtract_synthesize wrapper still allocates");
# 2.0.9 second half: the fill now uses crtract_synthesize_INTO against a block vec
# hoisted into SynthStream, so it no longer pays for that vec at all -- a fill is
# strictly CHEAPER than a standalone crtract_synthesize call, not equal to it.
assert_lt(a_fill, a_tract,
  "a fill is cheaper than an allocating crtract_synthesize -- it reuses its block vec");
# The absolute figure. 8,800 B/call at 2.0.6; 512 B now. The residual is ONE
# svara_glottal_new per block inside crtract_synthesize_laryngeal -- svara's
# allocation, reached through tract.cyr, and NOT removable without caching the
# glottal source across blocks, which would carry its phase forward and change
# the audio. That is a behaviour question, not a perf one; see roadmap 2.0.9.
assert_lte(a_fill, 512, "a steady-state fill retains at most 512 B (was 8,800 at 2.0.6)");
assert_gt(a_fill, 0, "control: it is not zero yet, and the assertion above is not vacuous");
# The absolute figure as measured today, as a CEILING rather than an equality: a
# tract.cyr or svara repair may lower it, and must not fail this suite; a
# stream.cyr regression raises it, and must.
assert_lte(a_fill, 8600, "measured 2026-08-31: 8600 B/fill, all of it tract.cyr + svara");
# and the three sources this repair removed, each pinned at 0 individually.
var a_p0 = alloc_used();
var a_pv = stream_pitch_contour_at_into(SynthStream_contour_pts(a_st), PRANI_VOC_HOWL, T_400, T_0_1);
var a_p1 = alloc_used();
assert_eq(a_p1 - a_p0, 0, "contour into the stream's reused point vec -- 0 B (was 152)");
var a_o0 = alloc_used();
SynthesisOptions_set_subharmonic_amp(SynthStream_options(a_st), 0);
SynthesisOptions_set_perturbation_scale(SynthStream_options(a_st), T_1_0);
var a_o1 = alloc_used();
assert_eq(a_o1 - a_o0, 0, "re-arming the stream's own SynthesisOptions -- 0 B (was 16)");
var a_u0 = alloc_used();
var a_uv = SynthStream_urgency(a_st);
var a_u1 = alloc_used();
assert_eq(a_u1 - a_u0, 0, "reading the snapshotted urgency -- 0 B (was 32 for a whole IntentModifiers)");
# and the snapshot is the value the per-call lookup used to produce.
assert_eq(SynthStream_urgency(a_st), IntentModifiers_urgency(prani_intent_modifiers(PRANI_INTENT_IDLE)),
  "the urgency snapshot == prani_intent_modifiers(intent).urgency, exactly");
var a_sa = stream_new(crvoice_new(PRANI_SP_WOLF), PRANI_VOC_BARK, PRANI_INTENT_ALARM, T_SR, T_0_1);
assert_eq(SynthStream_urgency(a_sa), IntentModifiers_urgency(prani_intent_modifiers(PRANI_INTENT_ALARM)),
  "and for a non-zero urgency (Alarm 0.9), which is what perturbation_scale adds");

# ================================================================
test_group("2.0.9 stream_pitch_contour_at_into -- the split is result-preserving");
# The allocating wrapper and the _into form must agree everywhere, and a REUSED
# point vec must give the same answer as a fresh one -- that is the whole risk of
# the reuse: a vec that kept a previous call's points would interpolate against
# the wrong table. Every vocalization tag (incl. the FLAT fallthrough for tags
# with no table of their own) x 21 values of t across [0,1].
var a_reuse = vec_new();
var a_bad = 0;
var a_vc = 0;
while (a_vc < 16) {
    var a_tk = 0;
    while (a_tk <= 20) {
        var a_t = f64_div(f64_from(a_tk), f64_from(20));
        if (stream_pitch_contour_at_into(a_reuse, a_vc, T_400, a_t)
          != stream_pitch_contour_at(a_vc, T_400, a_t)) { a_bad = a_bad + 1; }
        a_tk = a_tk + 1;
    }
    a_vc = a_vc + 1;
}
assert_eq(a_bad, 0, "reused vec == fresh vec for all 16 tags x 21 t (336 comparisons)");
# and the reuse is what makes it free: the largest table (TRILL, 5 points == 10
# slots) fits vec_new's 16-slot initial capacity, so no push ever grows it.
assert_lte(vec_len(a_reuse), 16, "the widest contour table fits the initial capacity -- no grow");
var a_r0 = alloc_used();
var a_rk = 0;
var a_rsum = 0;
while (a_rk < 100) {
    a_rsum = a_rsum + stream_pitch_contour_at_into(a_reuse, PRANI_VOC_TRILL, T_400, T_0_1);
    a_rk = a_rk + 1;
}
var a_r1 = alloc_used();
assert_eq(a_r1 - a_r0, 0, "100 TRILL contours into one reused vec -- 0 B total");
# the wrapper still allocates, as its contract says (it hands back a fresh vec's
# worth of work); it is the per-block caller that must not.
var a_w0 = alloc_used();
var a_wv = stream_pitch_contour_at(PRANI_VOC_TRILL, T_400, T_0_1);
var a_w1 = alloc_used();
assert_gt(a_w1 - a_w0, 0, "the allocating wrapper still allocates -- the split kept both entry points");
assert_eq(a_wv, stream_pitch_contour_at_into(a_reuse, PRANI_VOC_TRILL, T_400, T_0_1),
  "and the two entry points still agree on the value they return");

var rc = assert_summary();
syscall(60, rc);

# spatial.tcyr -- tests for src/spatial.cyr (distance attenuation + Doppler).
# 2.0.3:rust-old/src/spatial.rs had no #[test] blocks; behaviour lives in the
# Rust integration tests. These lock f64 parity to the oracle algorithm via
# golden values computed by hand (see the algorithm comments in spatial.cyr).
#
# Include order: error (base) then spatial. stdlib (vec/math/alloc) auto-resolves.

include "src/real.cyr"
include "src/error.cyr"
include "src/f64/error.cyr"
include "src/spatial.cyr"
include "src/f64/spatial.cyr"
include "tests/realt.cyr"

alloc_init();

# Small float tolerance (~1e-9) for per-sample recurrence / interpolation values
# where operation ordering may differ by an ULP from the reference computation.
#ifdef PRANI_F32
var SP_TOL = 0x36000000;           # 2^-19 ~ 1.9e-6: measured 1 ulp at 0.92, 7.7 and 15.5
#else
var SP_TOL = 0x3E112E0BE826D695;   # 1e-9
#endif

# Expected sum-of-squares energies for the 400-sample synthetic buffer built in
# the "energy integral" group below. Computed independently in f64 straight from
# the algorithm spec (spatial.cyr:34-39 / 2.0.3:rust-old/src/spatial.rs:16-42,
# read with `git show`) -- NOT read back out of this port.
# The energies are summed in f64 from the widened samples in both builds (t_energy),
# so the comparison measures prani's render, not the test's own 400-term sum.
var SP_E_NEAR = 0x40A718FD9A07A7AA;   # 2956.4953157798927  energy @ 1 m
var SP_E_FAR  = 0x3FE48CFBC21121FB;   # 0.642209891354525   energy @ 50 m
var SP_E_TOL  = 0x3EB0C6F7A0B5ED8D;   # 1e-6, generous against a 400-term sum
# The f32 build's energies are held relatively: measured 3.5e-8 (near) and 8e-8 (far).
var SP_E_TOL_NEAR = t_per(SP_E_TOL, 0x3F43602D11B76E4E);   # f32: 2956.5 x 2e-7
var SP_E_TOL_FAR  = t_per(SP_E_TOL, 0x3E813D3B96BD62C8);   # f32: 0.6422 x 2e-7

# 2.0.5 range-guard fixtures. PRANI_POS_INF / PRANI_NEG_INF come from error.cyr;
# there is no NaN sentinel there (nothing in prani produces one deliberately),
# so the quiet-NaN pattern is spelled out here. SP_BOUND is the Doppler clamp
# bound, built from the module's own PR_SP_0_9 rather than a literal 308.7 so
# the test cannot drift from the constant it is checking.
#ifdef PRANI_F32
var SP_NAN   = 0x7FC00000;           # quiet NaN
#else
var SP_NAN   = 0x7FF8000000000000;   # quiet NaN
#endif
var SP_BOUND = pr_mul(pr_from(343), PR_SP_0_9);   # 343 * 0.9 = 308.7

# ---- helpers ---------------------------------------------------------------
# t_energy(v) -- sum of s^2 over v, accumulated low index to high (the oracle's
# `samples.iter().map(|s| s * s).sum()`).
#must_use
fn t_energy(v) {
    var n = vec_len(v);
    var i = 0;
    var acc = 0;
    while (i < n) {
        var s = pr_to64(vec_get(v, i));
        acc = f64_add(acc, f64_mul(s, s));
        i = i + 1;
    }
    return acc;
}

# ================================================================
test_group("distance attenuation: gain == 1.0 at distance == reference");
# distance == reference_distance => dist clamped to reference => gain = ref/ref = 1.0.
# One-pole LPF still applies: for a single-sample input s, prev starts at 0 so
# filtered = alpha*(s*gain - 0) = alpha*s. With distance=1, sr=48000:
#   cutoff = 20000/(1+1*0.02) = 19607.843137254902
#   rc = 1/(TAU*cutoff), dt = 1/48000, alpha = dt/(rc+dt) = 0.7196256964118001
# Input s = 1.0 => output[0] = alpha (gain is exactly 1.0).
var one = vec_new();
vec_push(one, PR_ONE);                     # single sample = 1.0
var d_att = spatial_apply_distance_attenuation(one, PR_ONE, PR_ONE, pr_from(48000));
assert_eq(vec_len(d_att), 1, "length preserved (1 in, 1 out)");
# output[0] == alpha == 0.7196256964118001 (proves gain == 1.0: s*gain == s).
#ifdef PRANI_F32
var alpha_expected = 0x3F383964;            # 0.7196256964118001
#else
var alpha_expected = 0x3fe7072c77ee65a1;    # 0.7196256964118001
#endif
assert_eq(pr_lt(pr_abs(pr_sub(vec_get(d_att, 0), alpha_expected)), SP_TOL), 1, "out[0] == alpha (gain==1.0)");

# ================================================================
test_group("distance attenuation: distance clamped up to reference");
# distance BELOW reference clamps up to reference => still gain 1.0, same alpha.
var one_b = vec_new();
vec_push(one_b, PR_ONE);
# distance = 0.5 (below reference 1.0) -> clamps to 1.0 -> identical result.
#ifdef PRANI_F32
var half = 0x3F000000;                      # 0.5
#else
var half = 0x3FE0000000000000;              # 0.5
#endif
var d_clamp = spatial_apply_distance_attenuation(one_b, half, PR_ONE, pr_from(48000));
assert_eq(pr_lt(pr_abs(pr_sub(vec_get(d_clamp, 0), alpha_expected)), SP_TOL), 1,
  "distance<ref clamps to ref (same as gain 1.0)");

# ================================================================
test_group("distance attenuation: gain falls off as 1/distance");
# distance = 100, reference = 1 => gain = 1/100 = 0.01. Single sample s=1.0.
# output[0] = alpha100 * (1*0.01) where alpha100 uses cutoff@100.
# cutoff100 = max(20000/(1+100*0.02), 200) = max(20000/3, 200) = 6666.666...
# The exact filtered value: assert it is strictly between 0 and the gain (0.01),
# and strictly smaller than the near-field (distance 1) result -> far is quieter.
var one_c = vec_new();
vec_push(one_c, PR_ONE);
var d_far = spatial_apply_distance_attenuation(one_c, pr_from(100), PR_ONE, pr_from(48000));
var far0 = vec_get(d_far, 0);
assert_eq(pr_gt(far0, 0), 1, "far output > 0");
#ifdef PRANI_F32
var gain100 = 0x3C23D70A;                   # 0.01
#else
var gain100 = 0x3f847ae147ae147b;           # 0.01
#endif
assert_eq(pr_lt(far0, gain100), 1, "far output < gain (0.01) after LPF");
assert_eq(pr_lt(far0, vec_get(d_att, 0)), 1, "far (100m) quieter than near (1m)");

# ================================================================
test_group("distance attenuation: empty input -> empty output");
var empty = vec_new();
var d_empty = spatial_apply_distance_attenuation(empty, PR_ONE, PR_ONE, pr_from(48000));
assert_eq(vec_len(d_empty), 0, "empty in -> empty out");

# ================================================================
test_group("distance attenuation: multi-sample ringing (prev feedback)");
# Two samples of 1.0: out[0] = alpha; out[1] = alpha + alpha*(1 - alpha)
#   = 0.9213902498874319. out[1] > out[0] (filter charging toward 1.0).
var two = vec_new();
vec_push(two, PR_ONE);
vec_push(two, PR_ONE);
var d_two = spatial_apply_distance_attenuation(two, PR_ONE, PR_ONE, pr_from(48000));
assert_eq(vec_len(d_two), 2, "two in -> two out");
#ifdef PRANI_F32
var out1_expected = 0x3F6BE03B;             # 0.9213902498874319
#else
var out1_expected = 0x3fed7c0767c3d54d;     # 0.9213902498874319
#endif
assert_eq(pr_lt(pr_abs(pr_sub(vec_get(d_two, 1), out1_expected)), SP_TOL), 1, "out[1] charges toward 1.0");
assert_eq(pr_gt(vec_get(d_two, 1), vec_get(d_two, 0)), 1, "out[1] > out[0] (charging)");

# ================================================================
test_group("distance attenuation: energy integral, near (1 m) vs far (50 m)");
# Reproduces the oracle's own bar (`git show 2.0.3:rust-old/tests/integration.rs`,
# test_distance_attenuation :478-493): sum s^2 over a whole vocalization at 1 m
# and at 50 m, assert near_energy > far_energy * 10. This file has no voice
# dependency by design, so the signal is synthetic instead of a Wolf howl:
# 400 samples, sign flipping every sample, magnitude ((i mod 7) + 1) -- so the
# buffer is non-trivial in BOTH sign and amplitude, and its own energy is the
# exact integer 57*(1+4+9+16+25+36+49) + 1 = 7981.
# Distance 50 is reached nowhere else in this suite (only 0.5, 1 and 100): its
# gain is 1/50 = 0.02 and its cutoff max(20000/(1+50*0.02), 200) = 10000 Hz.
var att_in = vec_new();
var ai = 0;
while (ai < 400) {
    var mag = pr_from((ai % 7) + 1);
    if ((ai % 2) == 0) { vec_push(att_in, mag); } else { vec_push(att_in, pr_neg(mag)); }
    ai = ai + 1;
}
# Generator controls -- an all-zero or constant input would make the ratio below
# vacuous, so pin the shape of the input first.
assert_eq(vec_len(att_in), 400, "synthetic input is 400 samples");
assert_eq(vec_get(att_in, 0), pr_from(1), "input[0] == +1");
assert_eq(vec_get(att_in, 1), pr_neg(pr_from(2)), "input[1] == -2 (sign flips, magnitude rises)");
assert_eq(vec_get(att_in, 7), pr_neg(pr_from(1)), "input[7] == -1 (magnitude wraps at 7)");
assert_eq(t_energy(att_in), f64_from(7981), "input energy == 7981 (exact, small integers)");

var att_near = spatial_apply_distance_attenuation(att_in, PR_ONE, PR_ONE, pr_from(44100));
var att_far = spatial_apply_distance_attenuation(att_in, pr_from(50), PR_ONE, pr_from(44100));
assert_eq(vec_len(att_near), 400, "near output length preserved (400)");
assert_eq(vec_len(att_far), 400, "far output length preserved (400)");
var e_near = t_energy(att_near);
var e_far = t_energy(att_far);
# Controls: a no-op (identity) attenuator gives e_near == e_far and fails the
# ratio; an attenuator that zeroed the buffer gives e_far == 0 and fails "> 0".
assert_eq(f64_gt(e_near, 0), 1, "near energy > 0 (output is not silent)");
assert_eq(f64_gt(e_far, 0), 1, "far energy > 0 (attenuator does not zero the buffer)");
assert_eq(f64_lt(e_far, e_near), 1, "far energy < near energy");
assert_eq(f64_gt(e_near, f64_mul(e_far, f64_from(10))), 1, "near energy > 10x far energy (oracle bar)");
# Exact integrals, hand-computed from the algorithm (see SP_E_NEAR/SP_E_FAR).
assert_eq(f64_lt(f64_abs(f64_sub(e_near, SP_E_NEAR)), SP_E_TOL_NEAR), 1, "near energy ~ 2956.49531578");
assert_eq(f64_lt(f64_abs(f64_sub(e_far, SP_E_FAR)), SP_E_TOL_FAR), 1, "far energy ~ 0.642209891355");

# ================================================================
test_group("doppler: v == 0 -> ratio 1 -> identity length + values");
# ratio = 343/343 = 1.0; out_len = len; src = i exactly; frac = 0; s0 = samples[i].
var s4 = vec_new();
vec_push(s4, 0);
vec_push(s4, pr_from(10));
vec_push(s4, pr_from(20));
vec_push(s4, pr_from(30));
var dop0 = spatial_apply_doppler_shift(s4, 0, pr_from(48000));
assert_eq(vec_len(dop0), 4, "v=0 -> same length (4)");
assert_eq(vec_get(dop0, 0), 0, "dop0[0] == 0");
assert_eq(vec_get(dop0, 1), pr_from(10), "dop0[1] == 10 (identity)");
assert_eq(vec_get(dop0, 2), pr_from(20), "dop0[2] == 20 (identity)");
assert_eq(vec_get(dop0, 3), pr_from(30), "dop0[3] == 30 (identity)");

# ================================================================
test_group("doppler: approaching (v<0) -> ratio>1 -> shorter output");
# v = -100: ratio = 343/243 = 1.4115... ; out_len = (8/ratio) trunc = 5 < 8.
var s8 = vec_new();
var k = 0;
while (k < 8) { vec_push(s8, PR_ONE); k = k + 1; }
var dop_near = spatial_apply_doppler_shift(s8, pr_neg(pr_from(100)), pr_from(48000));
assert_eq(vec_len(dop_near), 5, "approaching -> out_len 5 (< 8, higher pitch)");

# ================================================================
test_group("doppler: receding (v>0) -> ratio<1 -> longer output");
# v = +343 clamps to +308.7: ratio = 343/651.7 = 0.5264... ; out_len = 8/ratio = 15.
var s8b = vec_new();
var k2 = 0;
while (k2 < 8) { vec_push(s8b, PR_ONE); k2 = k2 + 1; }
var dop_far = spatial_apply_doppler_shift(s8b, pr_from(343), pr_from(48000));
assert_eq(vec_len(dop_far), 15, "receding (clamped) -> out_len 15 (> 8, lower pitch)");

# ================================================================
test_group("doppler: fractional interpolation (hand-computed)");
# samples [0,10,20,30], velocity +100: ratio = 0.7742663656884876, out_len = 5.
#   out[0] = 0.0
#   out[1]: src=0.774..., idx=0, frac=0.774..., s0=0,s1=10 -> 7.742663656884876
#   out[2]: src=1.548..., idx=1, frac=0.548..., s0=10,s1=20 -> 15.485327313769751
var s4b = vec_new();
vec_push(s4b, 0);
vec_push(s4b, pr_from(10));
vec_push(s4b, pr_from(20));
vec_push(s4b, pr_from(30));
var dop_i = spatial_apply_doppler_shift(s4b, pr_from(100), pr_from(48000));
assert_eq(vec_len(dop_i), 5, "v=+100 -> out_len 5");
assert_eq(vec_get(dop_i, 0), 0, "interp out[0] == 0.0 (exact)");
#ifdef PRANI_F32
var i1 = 0x40F7C3E7;                         # 7.742663656884876
#else
var i1 = 0x401ef87cd258fe44;                 # 7.742663656884876
#endif
assert_eq(pr_lt(pr_abs(pr_sub(vec_get(dop_i, 1), i1)), SP_TOL), 1, "interp out[1] ~ 7.7426636569");
#ifdef PRANI_F32
var i2 = 0x4177C3E7;                         # 15.485327313769751
#else
var i2 = 0x402ef87cd258fe44;                 # 15.485327313769751
#endif
assert_eq(pr_lt(pr_abs(pr_sub(vec_get(dop_i, 2), i2)), SP_TOL), 1, "interp out[2] ~ 15.485327314");

# ================================================================
test_group("doppler: tail reads past end fall to 0 (s1 guard)");
# Single-sample buffer, v=0 -> out_len 1; idx=0<1 -> s0=samples[0]; idx+1=1 !< 1
# -> s1=0; frac=0 -> out[0] = s0 = 5.0. Guards the idx+1 bounds check.
var s1v = vec_new();
vec_push(s1v, pr_from(5));
var dop_tail = spatial_apply_doppler_shift(s1v, 0, pr_from(48000));
assert_eq(vec_len(dop_tail), 1, "single sample -> out_len 1");
assert_eq(vec_get(dop_tail, 0), pr_from(5), "out[0] == s0 (s1 guarded to 0, frac 0)");

# ================================================================
test_group("doppler: empty input -> empty output");
var e2 = vec_new();
var dop_e = spatial_apply_doppler_shift(e2, 0, pr_from(48000));
assert_eq(vec_len(dop_e), 0, "empty in -> empty out");

# ================================================================
# 2.0.5 -- input-range validation (audit finding F11). Both functions return
# "a vec handle OR a negative PRANI_ERR_*"; the ranges are tabulated in the
# spatial.cyr header. Three groups: the primitive behaviours the guards rest
# on, then one group per function.
# ================================================================

# ================================================================
test_group("range guards: the primitive behaviours they rest on");
# Pinned here (not in hardening.tcyr) because these are the facts that make
# spatial's guards necessary, and they are toolchain behaviour, not prani's.
# f64_max is `if (f64_gt(a, b)) a else b` (lib/math.cyr:422) and every compare
# against NaN is false -- so NaN LOSES in argument 1 and WINS in argument 2.
assert_eq(pr_eq(pr_max(SP_NAN, PR_ONE), PR_ONE), 1, "pr_max(NaN, b) == b (NaN loses as arg 1)");
assert_eq(prani_is_finite(pr_max(PR_ONE, SP_NAN)), 0, "pr_max(a, NaN) == NaN (NaN wins as arg 2)");
# That asymmetry is why a NaN `distance` and a NaN `reference_distance` had
# two DIFFERENT symptoms before the guards: full-volume audio vs a NaN buffer.
# The format's smallest subnormal: 5e-324 in f64, 1.4e-45 in f32. pr_of64(0x1) is 0 in
# f32, where this would have tested 1/0 instead (audit C2, 2.3.2).
var SP_SUBN = t_per(pr_of64(0x0000000000000001), 0x00000001);
assert_eq(pr_gt(SP_SUBN, 0), 1, "control: the subnormal is not 0 in either build");
assert_eq(prani_is_finite(pr_div(PR_ONE, SP_SUBN)), 0, "1/subnormal overflows to inf (the dt guard)");
# The tiniest rate whose reciprocal is finite in the build's format: 1e-300 in f64,
# f32's smallest normal 2^-126 (1.2e-38) in f32, where 1e-300 underflows to 0.
var SP_TINY = t_per(pr_of64(0x01a56e1fc2f8f359), 0x00800000);
assert_eq(prani_is_finite(pr_div(PR_ONE, SP_TINY)), 1,
  "1/1e-300 is finite (accepted, not an invented floor)");
# The Doppler empty-buffer symptom: a NaN ratio truncates to 0, so the loop
# never runs -- an empty result, never a runaway allocation.
assert_eq(pr_to(pr_div(pr_from(100), SP_NAN)), 0, "pr_to(len/NaN) is 0 (empty, not runaway)");
# +/-inf ARE bounded by f64_clamp -- the reason inf is rejected is that it
# renders as 308.7 m/s, NOT that it would overflow.
assert_eq(pr_eq(pr_clamp(PRANI_POS_INF, pr_neg(SP_BOUND), SP_BOUND), SP_BOUND), 1,
  "pr_clamp(+inf) == +308.7 (inf is bounded)");
assert_eq(prani_is_finite(pr_clamp(SP_NAN, pr_neg(SP_BOUND), SP_BOUND)), 0,
  "pr_clamp(NaN) stays NaN (NaN is NOT bounded)");

# ================================================================
test_group("distance attenuation: out-of-range input is rejected");
# `one` (a single 1.0 sample) and `alpha_expected` are reused from the groups
# above, so a REJECTED call and an ACCEPTED one are compared on one input.
var sr48 = pr_from(48000);
# -- samples handle. A null handle, or an unchecked negative code chained in
# from a fallible call, reaches vec_len as load64(v+8) -> SIGSEGV.
assert_eq(spatial_apply_distance_attenuation(0, PR_ONE, PR_ONE, sr48), PRANI_ERR_INVALID_VOCALIZATION,
  "null samples handle rejected");
# 2.2.1 (audit C7): a chained-in error keeps its code, so a refused allocation or a
# svara rejection upstream is not reported as a bad sample buffer. 2.2.0 said -2.
assert_eq(spatial_apply_distance_attenuation(PRANI_ERR_SVARA, PR_ONE, PR_ONE, sr48), PRANI_ERR_SVARA,
  "a chained-in error code is passed on, not dereferenced or rewritten");
assert_eq(spatial_apply_distance_attenuation(PRANI_ERR_ALLOC, PR_ONE, PR_ONE, sr48), PRANI_ERR_ALLOC,
  "a chained-in refusal stays PRANI_ERR_ALLOC");
# -- distance: finite, >= 0.
assert_eq(spatial_apply_distance_attenuation(one, SP_NAN, PR_ONE, sr48), PRANI_ERR_INVALID_VOCALIZATION,
  "NaN distance rejected");
assert_eq(spatial_apply_distance_attenuation(one, PRANI_POS_INF, PR_ONE, sr48), PRANI_ERR_INVALID_VOCALIZATION,
  "+inf distance rejected");
assert_eq(spatial_apply_distance_attenuation(one, PRANI_NEG_INF, PR_ONE, sr48), PRANI_ERR_INVALID_VOCALIZATION,
  "-inf distance rejected");
# DELIBERATE DIVERGENCE: the oracle clamped a negative distance up to the
# reference and returned full-volume audio (measured: == alpha, i.e. bit-equal
# to the distance-1.0 result). A negative distance is not a distance.
assert_eq(spatial_apply_distance_attenuation(one, pr_neg(pr_from(5)), PR_ONE, sr48), PRANI_ERR_INVALID_VOCALIZATION,
  "negative distance rejected (divergence: oracle clamped it)");
# CONTROL -- distance 0 stays VALID: it clamps up to reference exactly as 0.5
# does, so it must still produce the gain-1.0 result and not an error.
var d_zero = spatial_apply_distance_attenuation(one, 0, PR_ONE, sr48);
assert_eq(prani_is_err(d_zero), 0, "distance 0 accepted (clamps up to reference)");
assert_eq(pr_eq(vec_get(d_zero, 0), alpha_expected), 1, "distance 0 gives the gain-1.0 result, unchanged");
# -- reference_distance: finite, > 0.
assert_eq(spatial_apply_distance_attenuation(one, PR_ONE, SP_NAN, sr48), PRANI_ERR_INVALID_VOCALIZATION,
  "NaN reference rejected (was an all-NaN buffer)");
assert_eq(spatial_apply_distance_attenuation(one, pr_from(5), 0, sr48), PRANI_ERR_INVALID_VOCALIZATION,
  "reference 0 rejected (was silence: gain 0)");
assert_eq(spatial_apply_distance_attenuation(one, 0, 0, sr48), PRANI_ERR_INVALID_VOCALIZATION,
  "reference 0 with distance 0 rejected (was 0/0 = NaN)");
assert_eq(spatial_apply_distance_attenuation(one, PR_ONE, pr_neg(PR_ONE), sr48), PRANI_ERR_INVALID_VOCALIZATION,
  "negative reference rejected (was a phase-inverted buffer)");
assert_eq(spatial_apply_distance_attenuation(one, PR_ONE, PRANI_POS_INF, sr48), PRANI_ERR_INVALID_VOCALIZATION,
  "+inf reference rejected");
# -- sample_rate: finite, > 0, with a finite reciprocal. INVALID_TRACT, not
# INVALID_VOCALIZATION: a bad sample rate is the same code library-wide.
assert_eq(spatial_apply_distance_attenuation(one, PR_ONE, PR_ONE, SP_NAN), PRANI_ERR_INVALID_TRACT,
  "NaN sample_rate rejected (was an all-NaN buffer)");
assert_eq(spatial_apply_distance_attenuation(one, PR_ONE, PR_ONE, 0), PRANI_ERR_INVALID_TRACT,
  "sample_rate 0 rejected (was dt=inf -> alpha=NaN)");
assert_eq(spatial_apply_distance_attenuation(one, PR_ONE, PR_ONE, pr_neg(sr48)), PRANI_ERR_INVALID_TRACT,
  "negative sample_rate rejected (was alpha > 1: an overshooting filter)");
assert_eq(spatial_apply_distance_attenuation(one, PR_ONE, PR_ONE, PRANI_POS_INF), PRANI_ERR_INVALID_TRACT,
  "+inf sample_rate rejected (was silence: alpha 0)");
assert_eq(spatial_apply_distance_attenuation(one, PR_ONE, PR_ONE, SP_SUBN), PRANI_ERR_INVALID_TRACT,
  "subnormal sample_rate rejected (1/rate overflows)");
# CONTROL -- the reciprocal guard is exactly "1/rate is finite", not a made-up
# floor: an absurd-but-representable 1e-300 Hz is still accepted.
assert_eq(prani_is_err(spatial_apply_distance_attenuation(one, PR_ONE, PR_ONE, SP_TINY)), 0,
  "1e-300 Hz accepted (guard is 1/rate finite, not a threshold)");
# -- the guards run before the length check, so an empty buffer with a bad
# parameter is an ERROR, while an empty buffer with valid ones stays empty.
var sp_empty = vec_new();
assert_eq(spatial_apply_distance_attenuation(sp_empty, PR_ONE, PR_ONE, SP_NAN), PRANI_ERR_INVALID_TRACT,
  "empty buffer + bad parameter is an error");
assert_eq(vec_len(spatial_apply_distance_attenuation(sp_empty, PR_ONE, PR_ONE, sr48)), 0,
  "empty buffer + valid parameters still empty out");

# ================================================================
test_group("doppler: out-of-range input is rejected");
var s100 = vec_new();
var sp_i = 0;
while (sp_i < 100) { vec_push(s100, PR_ONE); sp_i = sp_i + 1; }
# -- samples handle.
assert_eq(spatial_apply_doppler_shift(0, 0, sr48), PRANI_ERR_INVALID_VOCALIZATION, "null samples handle rejected");
assert_eq(spatial_apply_doppler_shift(PRANI_ERR_SVARA, 0, sr48), PRANI_ERR_SVARA,
  "a chained-in error code is passed on, not dereferenced or rewritten (2.2.1)");
# -- velocity: any FINITE value. NaN was the live defect (out_len = 0
# -> empty buffer); +/-inf are clamped to +/-308.7, a fabricated answer.
assert_eq(spatial_apply_doppler_shift(s100, SP_NAN, sr48), PRANI_ERR_INVALID_VOCALIZATION,
  "NaN velocity rejected (was a silently EMPTY buffer)");
# Moving away stretches by up to 1.9x, so a long enough buffer outgrows one vec.
# A header claiming that length: only its length is read before the refusal, so
# this costs no memory. Ordinary lengths are the controls throughout this file.
var sp_long = alloc(24);
store64(sp_long + 8, 200000000);
assert_eq(spatial_apply_doppler_shift(sp_long, pr_from(300), sr48), PRANI_ERR_INVALID_VOCALIZATION,
  "a 2e8-sample buffer stretched past VEC_CAP_MAX is refused, not a process exit");
assert_eq(spatial_apply_doppler_shift(s100, PRANI_POS_INF, sr48), PRANI_ERR_INVALID_VOCALIZATION,
  "+inf velocity rejected (was rendered as +308.7)");
assert_eq(spatial_apply_doppler_shift(s100, PRANI_NEG_INF, sr48), PRANI_ERR_INVALID_VOCALIZATION,
  "-inf velocity rejected (was rendered as -308.7)");
assert_eq(spatial_apply_doppler_shift(sp_empty, SP_NAN, sr48), PRANI_ERR_INVALID_VOCALIZATION,
  "empty buffer + NaN velocity is an error");
assert_eq(vec_len(spatial_apply_doppler_shift(sp_empty, 0, sr48)), 0, "empty buffer + valid velocity still empty out");
# CONTROLS -- supersonic velocities stay VALID. The +/-0.9c clamp is the model
# (the v = +343 group above locks it), so v = -343, -1e6 and -308.7 must all
# give the SAME saturated result: ratio 9.999999999999996, out_len 100/10.
var dop_sat = spatial_apply_doppler_shift(s100, pr_neg(SP_BOUND), sr48);
assert_eq(vec_len(dop_sat), 10, "v = -308.7 (the clamp bound) -> out_len 10");
assert_eq(vec_len(spatial_apply_doppler_shift(s100, pr_neg(pr_from(343)), sr48)), 10,
  "v = -343 (AT the speed of sound) -> out_len 10, not the 0 the raw ratio gives");
assert_eq(vec_len(spatial_apply_doppler_shift(s100, pr_neg(pr_from(1000000)), sr48)), 10,
  "v = -1e6 (far beyond it) -> out_len 10, not the negative the raw ratio gives");
# Past the bound, so the clamp sets v in both formats. SP_BOUND itself is 343 x 0.9 in
# the build's format: 308.7 in f64, but 308.69998 in f32, whose exact length is
# 189.99999 (2.3.2, audit B1: each build truncates the exact length of the value it
# holds; through 2.3.1 f32's own rounding gave 190).
assert_eq(vec_len(spatial_apply_doppler_shift(s100, pr_from(400), sr48)), 190,
  "v = +400, clamped to +308.7 -> out_len 190 (the 1.9x upper bound)");
assert_eq(vec_len(spatial_apply_doppler_shift(s100, SP_BOUND, sr48)), t_per(190, 189),
  "v = 343 x 0.9 in the build's format -> 190 in f64, 189 in f32 (308.69998)");
# The raw arithmetic the clamp is protecting, evaluated here so the claim in
# the spatial.cyr header is checked rather than asserted in prose.
var sp_speed = pr_from(343);
assert_eq(prani_is_finite(pr_div(sp_speed, pr_add(sp_speed, pr_neg(sp_speed)))), 0,
  "unclamped ratio at v = -343 is +inf (division by zero)");
assert_eq(pr_lt(pr_div(sp_speed, pr_add(sp_speed, pr_neg(pr_from(500)))), 0), 1,
  "unclamped ratio at v = -500 is NEGATIVE");
# CONTROL -- `_sample_rate` is deliberately NOT guarded: the oracle ignores it
# and so does this port, so a NaN there cannot reach the output.
var dop_nan_sr = spatial_apply_doppler_shift(s100, 0, SP_NAN);
assert_eq(prani_is_err(dop_nan_sr), 0, "NaN _sample_rate NOT rejected (the parameter is unused)");
assert_eq(vec_len(dop_nan_sr), 100, "NaN _sample_rate gives the identity resample, unchanged");
assert_eq(pr_eq(vec_get(dop_nan_sr, 42), PR_ONE), 1, "NaN _sample_rate leaves the samples themselves untouched");

# ================================================================
test_group("2.3.2 B1 -- a long buffer's Doppler resampling is accurate in both formats");
# 10 s of a 3 kHz unit sine at 44.1 kHz, shifted by a source receding at 10 m/s, held
# to the same resampler run in f64 over the same input samples. The f64 build is that
# arithmetic exactly. The f32 build keeps the position in f64 (ADR-0010) and rounds
# only the interpolation; through 2.3.1 it held the position in f32, an error of
# 9.2e-3 at 10 s and 0.89 at 400 s.
var lb_n = 441000;
var lb_in = vec_new();
var lb_i = 0;
var lb_w = f64_div(f64_mul(F64_TAU, f64_from(3000)), f64_from(44100));
while (lb_i < lb_n) { vec_push(lb_in, pr_of64(f64_sin(f64_mul(lb_w, f64_from(lb_i))))); lb_i = lb_i + 1; }
var lb_out = spatial_apply_doppler_shift(lb_in, pr_from(10), pr_from(44100));
var lb_ratio = f64_div(f64_from(343), f64_from(353));
var lb_m = f64_to(f64_div(f64_from(lb_n), lb_ratio));
assert_eq(vec_len(lb_out), lb_m, "the output length is len / ratio in f64, truncated");
var lb_err = 0;
var lb_j = 0;
while (lb_j < lb_m) {
    var lb_src = f64_mul(f64_from(lb_j), lb_ratio);
    var lb_k = f64_to(lb_src);
    var lb_f = f64_sub(lb_src, f64_from(lb_k));
    var lb_s0 = 0;
    if (lb_k < lb_n) { lb_s0 = pr_to64(vec_get(lb_in, lb_k)); }
    var lb_s1 = 0;
    if (lb_k + 1 < lb_n) { lb_s1 = pr_to64(vec_get(lb_in, lb_k + 1)); }
    var lb_ref = f64_add(lb_s0, f64_mul(f64_sub(lb_s1, lb_s0), lb_f));
    var lb_e = f64_abs(f64_sub(pr_to64(vec_get(lb_out, lb_j)), lb_ref));
    if (f64_gt(lb_e, lb_err) == 1) { lb_err = lb_e; }
    lb_j = lb_j + 1;
}
var LB_TOL = t_per(0, 0x3EB0C6F7A0B5ED8D);   # f64: exact; f32: 1e-6, the interpolation's rounding
assert_eq(f64_le(lb_err, LB_TOL), 1, "every sample is the f64 resampling's (2.3.1's f32 build: 9.2e-3)");

var rc = assert_summary();
syscall(60, rc);

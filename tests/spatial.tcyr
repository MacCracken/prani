# spatial.tcyr -- tests for src/spatial.cyr (distance attenuation + Doppler).
# rust-old/src/spatial.rs had no #[test] blocks; behaviour lives in the Rust
# integration tests. These lock f64 parity to the oracle algorithm via golden
# values computed by hand (see the algorithm comments in spatial.cyr).
#
# Include order: error (base) then spatial. stdlib (vec/math/alloc) auto-resolves.

include "src/error.cyr"
include "src/spatial.cyr"

alloc_init();

# Small float tolerance (~1e-9) for per-sample recurrence / interpolation values
# where operation ordering may differ by an ULP from the reference computation.
var SP_TOL = 0x3E112E0BE826D695;   # 1e-9

# Expected sum-of-squares energies for the 400-sample synthetic buffer built in
# the "energy integral" group below. Computed independently in f64 straight from
# the algorithm spec (spatial.cyr:34-39 / rust-old/src/spatial.rs:16-42, read via
# `git show 2.0.3:rust-old/src/spatial.rs`) -- NOT read back out of this port.
var SP_E_NEAR = 0x40A718FD9A07A7AA;   # 2956.4953157798927  energy @ 1 m
var SP_E_FAR  = 0x3FE48CFBC21121FB;   # 0.642209891354525   energy @ 50 m
var SP_E_TOL  = 0x3EB0C6F7A0B5ED8D;   # 1e-6, generous against a 400-term sum

# 2.0.5 range-guard fixtures. PRANI_POS_INF / PRANI_NEG_INF come from error.cyr;
# there is no NaN sentinel there (nothing in prani produces one deliberately),
# so the quiet-NaN pattern is spelled out here. SP_BOUND is the Doppler clamp
# bound, built from the module's own PR_SP_0_9 rather than a literal 308.7 so
# the test cannot drift from the constant it is checking.
var SP_NAN   = 0x7FF8000000000000;   # quiet NaN
var SP_BOUND = f64_mul(f64_from(343), PR_SP_0_9);   # 343 * 0.9 = 308.7

# ---- helpers ---------------------------------------------------------------
# t_energy(v) -- sum of s^2 over v, accumulated low index to high (the oracle's
# `samples.iter().map(|s| s * s).sum()`).
#must_use
fn t_energy(v) {
    var n = vec_len(v);
    var i = 0;
    var acc = 0;
    while (i < n) {
        var s = vec_get(v, i);
        acc = f64_add(acc, f64_mul(s, s));
        i = i + 1;
    }
    return acc;
}

# ================================================================
test_group("distance attenuation: gain == 1.0 at distance == reference");
# distance == reference_distance => dist clamped to reference => gain = ref/ref = 1.0.
# One-pole LPF still applies: for a single-sample input s, prev starts at 0 so
# filtered = alpha*(s*gain - 0) = alpha*s. With distance=1, sr=48000:
#   cutoff = 20000/(1+1*0.02) = 19607.843137254902
#   rc = 1/(TAU*cutoff), dt = 1/48000, alpha = dt/(rc+dt) = 0.7196256964118001
# Input s = 1.0 => output[0] = alpha (gain is exactly 1.0).
var one = vec_new();
vec_push(one, F64_ONE);                     # single sample = 1.0
var d_att = spatial_apply_distance_attenuation(one, F64_ONE, F64_ONE, f64_from(48000));
assert_eq(vec_len(d_att), 1, "length preserved (1 in, 1 out)");
# output[0] == alpha == 0.7196256964118001 (proves gain == 1.0: s*gain == s).
var alpha_expected = 0x3fe7072c77ee65a1;    # 0.7196256964118001
assert_eq(f64_lt(f64_abs(f64_sub(vec_get(d_att, 0), alpha_expected)), SP_TOL), 1, "out[0] == alpha (gain==1.0)");

# ================================================================
test_group("distance attenuation: distance clamped up to reference");
# distance BELOW reference clamps up to reference => still gain 1.0, same alpha.
var one_b = vec_new();
vec_push(one_b, F64_ONE);
# distance = 0.5 (below reference 1.0) -> clamps to 1.0 -> identical result.
var half = 0x3FE0000000000000;              # 0.5
var d_clamp = spatial_apply_distance_attenuation(one_b, half, F64_ONE, f64_from(48000));
assert_eq(f64_lt(f64_abs(f64_sub(vec_get(d_clamp, 0), alpha_expected)), SP_TOL), 1, "distance<ref clamps to ref (same as gain 1.0)");

# ================================================================
test_group("distance attenuation: gain falls off as 1/distance");
# distance = 100, reference = 1 => gain = 1/100 = 0.01. Single sample s=1.0.
# output[0] = alpha100 * (1*0.01) where alpha100 uses cutoff@100.
# cutoff100 = max(20000/(1+100*0.02), 200) = max(20000/3, 200) = 6666.666...
# The exact filtered value: assert it is strictly between 0 and the gain (0.01),
# and strictly smaller than the near-field (distance 1) result -> far is quieter.
var one_c = vec_new();
vec_push(one_c, F64_ONE);
var d_far = spatial_apply_distance_attenuation(one_c, f64_from(100), F64_ONE, f64_from(48000));
var far0 = vec_get(d_far, 0);
assert_eq(f64_gt(far0, 0), 1, "far output > 0");
var gain100 = 0x3f847ae147ae147b;           # 0.01
assert_eq(f64_lt(far0, gain100), 1, "far output < gain (0.01) after LPF");
assert_eq(f64_lt(far0, vec_get(d_att, 0)), 1, "far (100m) quieter than near (1m)");

# ================================================================
test_group("distance attenuation: empty input -> empty output");
var empty = vec_new();
var d_empty = spatial_apply_distance_attenuation(empty, F64_ONE, F64_ONE, f64_from(48000));
assert_eq(vec_len(d_empty), 0, "empty in -> empty out");

# ================================================================
test_group("distance attenuation: multi-sample ringing (prev feedback)");
# Two samples of 1.0: out[0] = alpha; out[1] = alpha + alpha*(1 - alpha)
#   = 0.9213902498874319. out[1] > out[0] (filter charging toward 1.0).
var two = vec_new();
vec_push(two, F64_ONE);
vec_push(two, F64_ONE);
var d_two = spatial_apply_distance_attenuation(two, F64_ONE, F64_ONE, f64_from(48000));
assert_eq(vec_len(d_two), 2, "two in -> two out");
var out1_expected = 0x3fed7c0767c3d54d;     # 0.9213902498874319
assert_eq(f64_lt(f64_abs(f64_sub(vec_get(d_two, 1), out1_expected)), SP_TOL), 1, "out[1] charges toward 1.0");
assert_eq(f64_gt(vec_get(d_two, 1), vec_get(d_two, 0)), 1, "out[1] > out[0] (charging)");

# ================================================================
test_group("distance attenuation: energy integral, near (1 m) vs far (50 m)");
# Reproduces the oracle's own bar (`git show 2.0.3:rust-old/tests/integration.rs`,
# test_distance_attenuation :478-493): sum s^2 over a whole vocalization at 1 m
# and at 50 m, assert near_energy > far_energy * 10. This file has no voice
# dependency by design, so the signal is synthetic instead of a Wolf howl:
# 400 samples, sign flipping every sample, magnitude ((i mod 7) + 1) -- so the
# buffer is non-trivial in BOTH sign and amplitude, and its own energy is the
# exact integer 57*(1+4+9+16+25+36+49) + 1 = 7981.
# Distance 50 is reached nowhere else in this suite (only 0.5, 1 and 100): its
# gain is 1/50 = 0.02 and its cutoff max(20000/(1+50*0.02), 200) = 10000 Hz.
var att_in = vec_new();
var ai = 0;
while (ai < 400) {
    var mag = f64_from((ai % 7) + 1);
    if ((ai % 2) == 0) { vec_push(att_in, mag); } else { vec_push(att_in, f64_neg(mag)); }
    ai = ai + 1;
}
# Generator controls -- an all-zero or constant input would make the ratio below
# vacuous, so pin the shape of the input first.
assert_eq(vec_len(att_in), 400, "synthetic input is 400 samples");
assert_eq(vec_get(att_in, 0), f64_from(1), "input[0] == +1");
assert_eq(vec_get(att_in, 1), f64_neg(f64_from(2)), "input[1] == -2 (sign flips, magnitude rises)");
assert_eq(vec_get(att_in, 7), f64_neg(f64_from(1)), "input[7] == -1 (magnitude wraps at 7)");
assert_eq(t_energy(att_in), f64_from(7981), "input energy == 7981 (exact, small integers)");

var att_near = spatial_apply_distance_attenuation(att_in, F64_ONE, F64_ONE, f64_from(44100));
var att_far = spatial_apply_distance_attenuation(att_in, f64_from(50), F64_ONE, f64_from(44100));
assert_eq(vec_len(att_near), 400, "near output length preserved (400)");
assert_eq(vec_len(att_far), 400, "far output length preserved (400)");
var e_near = t_energy(att_near);
var e_far = t_energy(att_far);
# Controls: a no-op (identity) attenuator gives e_near == e_far and fails the
# ratio; an attenuator that zeroed the buffer gives e_far == 0 and fails "> 0".
assert_eq(f64_gt(e_near, 0), 1, "near energy > 0 (output is not silent)");
assert_eq(f64_gt(e_far, 0), 1, "far energy > 0 (attenuator does not zero the buffer)");
assert_eq(f64_lt(e_far, e_near), 1, "far energy < near energy");
assert_eq(f64_gt(e_near, f64_mul(e_far, f64_from(10))), 1, "near energy > 10x far energy (oracle bar)");
# Exact integrals, hand-computed from the algorithm (see SP_E_NEAR/SP_E_FAR).
assert_eq(f64_lt(f64_abs(f64_sub(e_near, SP_E_NEAR)), SP_E_TOL), 1, "near energy ~ 2956.49531578");
assert_eq(f64_lt(f64_abs(f64_sub(e_far, SP_E_FAR)), SP_E_TOL), 1, "far energy ~ 0.642209891355");

# ================================================================
test_group("doppler: v == 0 -> ratio 1 -> identity length + values");
# ratio = 343/343 = 1.0; out_len = len; src = i exactly; frac = 0; s0 = samples[i].
var s4 = vec_new();
vec_push(s4, 0);
vec_push(s4, f64_from(10));
vec_push(s4, f64_from(20));
vec_push(s4, f64_from(30));
var dop0 = spatial_apply_doppler_shift(s4, 0, f64_from(48000));
assert_eq(vec_len(dop0), 4, "v=0 -> same length (4)");
assert_eq(vec_get(dop0, 0), 0, "dop0[0] == 0");
assert_eq(vec_get(dop0, 1), f64_from(10), "dop0[1] == 10 (identity)");
assert_eq(vec_get(dop0, 2), f64_from(20), "dop0[2] == 20 (identity)");
assert_eq(vec_get(dop0, 3), f64_from(30), "dop0[3] == 30 (identity)");

# ================================================================
test_group("doppler: approaching (v<0) -> ratio>1 -> shorter output");
# v = -100: ratio = 343/243 = 1.4115... ; out_len = (8/ratio) trunc = 5 < 8.
var s8 = vec_new();
var k = 0;
while (k < 8) { vec_push(s8, F64_ONE); k = k + 1; }
var dop_near = spatial_apply_doppler_shift(s8, f64_neg(f64_from(100)), f64_from(48000));
assert_eq(vec_len(dop_near), 5, "approaching -> out_len 5 (< 8, higher pitch)");

# ================================================================
test_group("doppler: receding (v>0) -> ratio<1 -> longer output");
# v = +343 clamps to +308.7: ratio = 343/651.7 = 0.5264... ; out_len = 8/ratio = 15.
var s8b = vec_new();
var k2 = 0;
while (k2 < 8) { vec_push(s8b, F64_ONE); k2 = k2 + 1; }
var dop_far = spatial_apply_doppler_shift(s8b, f64_from(343), f64_from(48000));
assert_eq(vec_len(dop_far), 15, "receding (clamped) -> out_len 15 (> 8, lower pitch)");

# ================================================================
test_group("doppler: fractional interpolation (hand-computed)");
# samples [0,10,20,30], velocity +100: ratio = 0.7742663656884876, out_len = 5.
#   out[0] = 0.0
#   out[1]: src=0.774..., idx=0, frac=0.774..., s0=0,s1=10 -> 7.742663656884876
#   out[2]: src=1.548..., idx=1, frac=0.548..., s0=10,s1=20 -> 15.485327313769751
var s4b = vec_new();
vec_push(s4b, 0);
vec_push(s4b, f64_from(10));
vec_push(s4b, f64_from(20));
vec_push(s4b, f64_from(30));
var dop_i = spatial_apply_doppler_shift(s4b, f64_from(100), f64_from(48000));
assert_eq(vec_len(dop_i), 5, "v=+100 -> out_len 5");
assert_eq(vec_get(dop_i, 0), 0, "interp out[0] == 0.0 (exact)");
var i1 = 0x401ef87cd258fe44;                 # 7.742663656884876
assert_eq(f64_lt(f64_abs(f64_sub(vec_get(dop_i, 1), i1)), SP_TOL), 1, "interp out[1] ~ 7.7426636569");
var i2 = 0x402ef87cd258fe44;                 # 15.485327313769751
assert_eq(f64_lt(f64_abs(f64_sub(vec_get(dop_i, 2), i2)), SP_TOL), 1, "interp out[2] ~ 15.485327314");

# ================================================================
test_group("doppler: tail reads past end fall to 0 (s1 guard)");
# Single-sample buffer, v=0 -> out_len 1; idx=0<1 -> s0=samples[0]; idx+1=1 !< 1
# -> s1=0; frac=0 -> out[0] = s0 = 5.0. Guards the idx+1 bounds check.
var s1v = vec_new();
vec_push(s1v, f64_from(5));
var dop_tail = spatial_apply_doppler_shift(s1v, 0, f64_from(48000));
assert_eq(vec_len(dop_tail), 1, "single sample -> out_len 1");
assert_eq(vec_get(dop_tail, 0), f64_from(5), "out[0] == s0 (s1 guarded to 0, frac 0)");

# ================================================================
test_group("doppler: empty input -> empty output");
var e2 = vec_new();
var dop_e = spatial_apply_doppler_shift(e2, 0, f64_from(48000));
assert_eq(vec_len(dop_e), 0, "empty in -> empty out");

# ================================================================
# 2.0.5 -- input-range validation (audit finding F11). Both functions return
# "a vec handle OR a negative PRANI_ERR_*"; the ranges are tabulated in the
# spatial.cyr header. Three groups: the primitive behaviours the guards rest
# on, then one group per function.
# ================================================================

# ================================================================
test_group("range guards: the primitive behaviours they rest on");
# Pinned here (not in hardening.tcyr) because these are the facts that make
# spatial's guards necessary, and they are toolchain behaviour, not prani's.
# f64_max is `if (f64_gt(a, b)) a else b` (lib/math.cyr:422) and every compare
# against NaN is false -- so NaN LOSES in argument 1 and WINS in argument 2.
assert_eq(f64_eq(f64_max(SP_NAN, F64_ONE), F64_ONE), 1, "f64_max(NaN, b) == b (NaN loses as arg 1)");
assert_eq(prani_is_finite(f64_max(F64_ONE, SP_NAN)), 0, "f64_max(a, NaN) == NaN (NaN wins as arg 2)");
# That asymmetry is why a NaN `distance` and a NaN `reference_distance` had
# two DIFFERENT symptoms before the guards: full-volume audio vs a NaN buffer.
assert_eq(prani_is_finite(f64_div(F64_ONE, 0x0000000000000001)), 0, "1/5e-324 overflows to inf (the dt guard)");
assert_eq(prani_is_finite(f64_div(F64_ONE, 0x01a56e1fc2f8f359)), 1, "1/1e-300 is finite (accepted, not an invented floor)");
# The Doppler empty-buffer symptom: a NaN ratio truncates to i64::MIN, so the
# loop bound is NEGATIVE -- an empty result, never a runaway allocation.
assert_lt(f64_to(f64_div(f64_from(100), SP_NAN)), 0, "f64_to(len/NaN) is negative (empty, not runaway)");
# +/-inf ARE bounded by f64_clamp -- the reason inf is rejected is that it
# renders as 308.7 m/s, NOT that it would overflow.
assert_eq(f64_eq(f64_clamp(PRANI_POS_INF, f64_neg(SP_BOUND), SP_BOUND), SP_BOUND), 1, "f64_clamp(+inf) == +308.7 (inf is bounded)");
assert_eq(prani_is_finite(f64_clamp(SP_NAN, f64_neg(SP_BOUND), SP_BOUND)), 0, "f64_clamp(NaN) stays NaN (NaN is NOT bounded)");

# ================================================================
test_group("distance attenuation: out-of-range input is rejected");
# `one` (a single 1.0 sample) and `alpha_expected` are reused from the groups
# above, so a REJECTED call and an ACCEPTED one are compared on one input.
var sr48 = f64_from(48000);
# -- samples handle. A null handle, or an unchecked negative code chained in
# from a fallible call, reaches vec_len as load64(v+8) -> SIGSEGV.
assert_eq(spatial_apply_distance_attenuation(0, F64_ONE, F64_ONE, sr48), PRANI_ERR_INVALID_VOCALIZATION, "null samples handle rejected");
assert_eq(spatial_apply_distance_attenuation(PRANI_ERR_SVARA, F64_ONE, F64_ONE, sr48), PRANI_ERR_INVALID_VOCALIZATION, "a chained-in error code is rejected, not dereferenced");
# -- distance: finite, >= 0.
assert_eq(spatial_apply_distance_attenuation(one, SP_NAN, F64_ONE, sr48), PRANI_ERR_INVALID_VOCALIZATION, "NaN distance rejected");
assert_eq(spatial_apply_distance_attenuation(one, PRANI_POS_INF, F64_ONE, sr48), PRANI_ERR_INVALID_VOCALIZATION, "+inf distance rejected");
assert_eq(spatial_apply_distance_attenuation(one, PRANI_NEG_INF, F64_ONE, sr48), PRANI_ERR_INVALID_VOCALIZATION, "-inf distance rejected");
# DELIBERATE DIVERGENCE: the oracle clamped a negative distance up to the
# reference and returned full-volume audio (measured: == alpha, i.e. bit-equal
# to the distance-1.0 result). A negative distance is not a distance.
assert_eq(spatial_apply_distance_attenuation(one, f64_neg(f64_from(5)), F64_ONE, sr48), PRANI_ERR_INVALID_VOCALIZATION, "negative distance rejected (divergence: oracle clamped it)");
# CONTROL -- distance 0 stays VALID: it clamps up to reference exactly as 0.5
# does, so it must still produce the gain-1.0 result and not an error.
var d_zero = spatial_apply_distance_attenuation(one, 0, F64_ONE, sr48);
assert_eq(prani_is_err(d_zero), 0, "distance 0 accepted (clamps up to reference)");
assert_eq(f64_eq(vec_get(d_zero, 0), alpha_expected), 1, "distance 0 gives the gain-1.0 result, unchanged");
# -- reference_distance: finite, > 0.
assert_eq(spatial_apply_distance_attenuation(one, F64_ONE, SP_NAN, sr48), PRANI_ERR_INVALID_VOCALIZATION, "NaN reference rejected (was an all-NaN buffer)");
assert_eq(spatial_apply_distance_attenuation(one, f64_from(5), 0, sr48), PRANI_ERR_INVALID_VOCALIZATION, "reference 0 rejected (was silence: gain 0)");
assert_eq(spatial_apply_distance_attenuation(one, 0, 0, sr48), PRANI_ERR_INVALID_VOCALIZATION, "reference 0 with distance 0 rejected (was 0/0 = NaN)");
assert_eq(spatial_apply_distance_attenuation(one, F64_ONE, f64_neg(F64_ONE), sr48), PRANI_ERR_INVALID_VOCALIZATION, "negative reference rejected (was a phase-inverted buffer)");
assert_eq(spatial_apply_distance_attenuation(one, F64_ONE, PRANI_POS_INF, sr48), PRANI_ERR_INVALID_VOCALIZATION, "+inf reference rejected");
# -- sample_rate: finite, > 0, with a finite reciprocal. INVALID_TRACT, not
# INVALID_VOCALIZATION: a bad sample rate is the same code library-wide.
assert_eq(spatial_apply_distance_attenuation(one, F64_ONE, F64_ONE, SP_NAN), PRANI_ERR_INVALID_TRACT, "NaN sample_rate rejected (was an all-NaN buffer)");
assert_eq(spatial_apply_distance_attenuation(one, F64_ONE, F64_ONE, 0), PRANI_ERR_INVALID_TRACT, "sample_rate 0 rejected (was dt=inf -> alpha=NaN)");
assert_eq(spatial_apply_distance_attenuation(one, F64_ONE, F64_ONE, f64_neg(sr48)), PRANI_ERR_INVALID_TRACT, "negative sample_rate rejected (was alpha > 1: an overshooting filter)");
assert_eq(spatial_apply_distance_attenuation(one, F64_ONE, F64_ONE, PRANI_POS_INF), PRANI_ERR_INVALID_TRACT, "+inf sample_rate rejected (was silence: alpha 0)");
assert_eq(spatial_apply_distance_attenuation(one, F64_ONE, F64_ONE, 0x0000000000000001), PRANI_ERR_INVALID_TRACT, "subnormal sample_rate rejected (1/rate overflows)");
# CONTROL -- the reciprocal guard is exactly "1/rate is finite", not a made-up
# floor: an absurd-but-representable 1e-300 Hz is still accepted.
assert_eq(prani_is_err(spatial_apply_distance_attenuation(one, F64_ONE, F64_ONE, 0x01a56e1fc2f8f359)), 0, "1e-300 Hz accepted (guard is 1/rate finite, not a threshold)");
# -- the guards run before the length check, so an empty buffer with a bad
# parameter is an ERROR, while an empty buffer with valid ones stays empty.
var sp_empty = vec_new();
assert_eq(spatial_apply_distance_attenuation(sp_empty, F64_ONE, F64_ONE, SP_NAN), PRANI_ERR_INVALID_TRACT, "empty buffer + bad parameter is an error");
assert_eq(vec_len(spatial_apply_distance_attenuation(sp_empty, F64_ONE, F64_ONE, sr48)), 0, "empty buffer + valid parameters still empty out");

# ================================================================
test_group("doppler: out-of-range input is rejected");
var s100 = vec_new();
var sp_i = 0;
while (sp_i < 100) { vec_push(s100, F64_ONE); sp_i = sp_i + 1; }
# -- samples handle.
assert_eq(spatial_apply_doppler_shift(0, 0, sr48), PRANI_ERR_INVALID_VOCALIZATION, "null samples handle rejected");
assert_eq(spatial_apply_doppler_shift(PRANI_ERR_SVARA, 0, sr48), PRANI_ERR_INVALID_VOCALIZATION, "a chained-in error code is rejected, not dereferenced");
# -- velocity: any FINITE value. NaN was the live defect (out_len = i64::MIN
# -> empty buffer); +/-inf are clamped to +/-308.7, a fabricated answer.
assert_eq(spatial_apply_doppler_shift(s100, SP_NAN, sr48), PRANI_ERR_INVALID_VOCALIZATION, "NaN velocity rejected (was a silently EMPTY buffer)");
assert_eq(spatial_apply_doppler_shift(s100, PRANI_POS_INF, sr48), PRANI_ERR_INVALID_VOCALIZATION, "+inf velocity rejected (was rendered as +308.7)");
assert_eq(spatial_apply_doppler_shift(s100, PRANI_NEG_INF, sr48), PRANI_ERR_INVALID_VOCALIZATION, "-inf velocity rejected (was rendered as -308.7)");
assert_eq(spatial_apply_doppler_shift(sp_empty, SP_NAN, sr48), PRANI_ERR_INVALID_VOCALIZATION, "empty buffer + NaN velocity is an error");
assert_eq(vec_len(spatial_apply_doppler_shift(sp_empty, 0, sr48)), 0, "empty buffer + valid velocity still empty out");
# CONTROLS -- supersonic velocities stay VALID. The +/-0.9c clamp is the model
# (the v = +343 group above locks it), so v = -343, -1e6 and -308.7 must all
# give the SAME saturated result: ratio 9.999999999999996, out_len 100/10.
var dop_sat = spatial_apply_doppler_shift(s100, f64_neg(SP_BOUND), sr48);
assert_eq(vec_len(dop_sat), 10, "v = -308.7 (the clamp bound) -> out_len 10");
assert_eq(vec_len(spatial_apply_doppler_shift(s100, f64_neg(f64_from(343)), sr48)), 10, "v = -343 (AT the speed of sound) -> out_len 10, not the 0 the raw ratio gives");
assert_eq(vec_len(spatial_apply_doppler_shift(s100, f64_neg(f64_from(1000000)), sr48)), 10, "v = -1e6 (far beyond it) -> out_len 10, not the negative the raw ratio gives");
assert_eq(vec_len(spatial_apply_doppler_shift(s100, SP_BOUND, sr48)), 190, "v = +308.7 -> out_len 190 (the 1.9x upper bound)");
# The raw arithmetic the clamp is protecting, evaluated here so the claim in
# the spatial.cyr header is checked rather than asserted in prose.
var sp_speed = f64_from(343);
assert_eq(prani_is_finite(f64_div(sp_speed, f64_add(sp_speed, f64_neg(sp_speed)))), 0, "unclamped ratio at v = -343 is +inf (division by zero)");
assert_eq(f64_lt(f64_div(sp_speed, f64_add(sp_speed, f64_neg(f64_from(500)))), 0), 1, "unclamped ratio at v = -500 is NEGATIVE");
# CONTROL -- `_sample_rate` is deliberately NOT guarded: the oracle ignores it
# and so does this port, so a NaN there cannot reach the output.
var dop_nan_sr = spatial_apply_doppler_shift(s100, 0, SP_NAN);
assert_eq(prani_is_err(dop_nan_sr), 0, "NaN _sample_rate NOT rejected (the parameter is unused)");
assert_eq(vec_len(dop_nan_sr), 100, "NaN _sample_rate gives the identity resample, unchanged");
assert_eq(f64_eq(vec_get(dop_nan_sr, 42), F64_ONE), 1, "NaN _sample_rate leaves the samples themselves untouched");

var rc = assert_summary();
syscall(60, rc);

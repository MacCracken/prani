# dsp.tcyr -- tests for src/dsp.cyr (DcBlocker + naad error mapping).
# rust-old/src/dsp.rs had no #[test] blocks. Behavioural parity: the DC blocker
# passes the first sample, then rings down by R each step, and drives a constant
# DC input toward zero. serde round-trip dropped (no serde).

include "src/error.cyr"
include "src/logging.cyr"
include "src/dsp.cyr"

alloc_init();

# ================================================================
test_group("DcBlocker first-sample + decay (constant DC = 1.0)");
var b = dcblocker_new();
# y0 = 1 - 0 + R*0 = 1.0 (first sample passes)
assert_eq(dcblocker_process(b, F64_ONE), F64_ONE, "y0 == 1.0");
# y1 = 1 - 1 + R*1 = R = 0.995 (exact)
assert_eq(dcblocker_process(b, F64_ONE), PRANI_DCBLOCK_R, "y1 == R (0.995)");
# y2 = 1 - 1 + R*R = R^2; strictly less than y1 (ringing down)
var y2 = dcblocker_process(b, F64_ONE);
assert_eq(f64_lt(y2, PRANI_DCBLOCK_R), 1, "y2 < y1 (decaying)");
assert_eq(f64_gt(y2, 0), 1, "y2 still positive");

# ================================================================
test_group("DcBlocker converges to ~0 on sustained DC");
var b2 = dcblocker_new();
var i = 0;
var last = F64_ONE;
while (i < 4000) {
    last = dcblocker_process(b2, F64_ONE);
    i = i + 1;
}
# after 4000 samples of DC, output should be tiny (< epsilon-ish tolerance)
assert_eq(f64_lt(f64_abs(last), 0x3F50624DD2F1A9FC), 1, "DC driven below 1e-3");

# ================================================================
test_group("DcBlocker reset clears memory");
var b3 = dcblocker_new();
dcblocker_process(b3, F64_ONE);
dcblocker_process(b3, F64_ONE);
dcblocker_reset(b3);
# after reset, first sample passes at full amplitude again
assert_eq(dcblocker_process(b3, F64_ONE), F64_ONE, "post-reset y0 == 1.0");

# ================================================================
test_group("DcBlocker process_buffer (in-place)");
var buf = vec_new();
vec_push(buf, F64_ONE);
vec_push(buf, F64_ONE);
vec_push(buf, F64_ONE);
var b4 = dcblocker_new();
dcblocker_process_buffer(b4, buf);
assert_eq(vec_get(buf, 0), F64_ONE, "buf[0] == 1.0 (first passes)");
assert_eq(vec_get(buf, 1), PRANI_DCBLOCK_R, "buf[1] == R");

# ================================================================
test_group("map_naad_error");
assert_eq(prani_map_naad_error((0 - 1)), PRANI_ERR_SYNTHESIS_FAILED, "naad err -> synthesis failed");

# ================================================================
# serde roundtrip (ports the Rust #[derive(Serialize, Deserialize)] on DcBlocker).
test_group("DcBlocker serde roundtrip");
var dcs = dcblocker_new();
dcblocker_process(dcs, F64_ONE);   # advance state so fields are non-default
dcblocker_process(dcs, F64_ONE);
var sb = str_builder_new();
DcBlocker_to_json(dcs, sb);
var jstr = str_data(str_builder_build(sb));
var dc2 = DcBlocker_from_json_str(jstr);
assert_eq(DcBlocker_x_prev(dc2), DcBlocker_x_prev(dcs), "x_prev roundtrips");
assert_eq(DcBlocker_y_prev(dc2), DcBlocker_y_prev(dcs), "y_prev roundtrips");
assert_eq(DcBlocker_r(dc2), DcBlocker_r(dcs), "r roundtrips");
# re-serialize is idempotent
var sb2 = str_builder_new();
DcBlocker_to_json(dc2, sb2);
# length first: memeq over strlen() is a PREFIX compare, so a re-serialization
# that APPENDED a field would pass it. The oracle compared whole strings.
var jstr_2 = str_data(str_builder_build(sb2));
assert_eq(strlen(jstr_2), strlen(jstr), "json idempotent -- same length");
assert_eq(memeq(jstr, jstr_2, strlen(jstr)), 1, "json idempotent");

# ================================================================
# 2.0.5 input-range validation. Three groups: the hazard this module DECLINED to
# guard (and why the guard belongs at the callers), the count range it DOES
# guard, and the copy helper that has no range at all.
# ================================================================

var NAN_BITS = 0x7FF8000000000000;   # canonical quiet NaN

# ----------------------------------------------------------------
# The reason dcblocker_process is not guarded per sample: it is recursive, so
# ONE non-finite input poisons the state permanently. Pinned so the claim in
# src/dsp.cyr is a measurement, not an assertion of faith.
# ----------------------------------------------------------------
test_group("DcBlocker NaN latches the state permanently (unguarded, by decision)");
var bn = dcblocker_new();
assert_eq(prani_is_finite(dcblocker_process(bn, NAN_BITS)), 0, "NaN in -> NaN out");
# the input has RECOVERED and every later sample is still poisoned
assert_eq(prani_is_finite(dcblocker_process(bn, F64_ONE)), 0, "next finite sample still NaN");
assert_eq(prani_is_finite(dcblocker_process(bn, 0)), 0, "and the one after that");
assert_eq(prani_is_finite(DcBlocker_y_prev(bn)), 0, "y_prev is latched non-finite");
# reset is the named cure, and it works
dcblocker_reset(bn);
assert_eq(dcblocker_process(bn, F64_ONE), F64_ONE, "after reset the filter is clean again");

# +inf is no safer than NaN here, unlike at a clamp site (f64_clamp DOES bound
# an infinity -- see tests/error.tcyr). y0 = +inf, then y1 = 1 - inf + r*inf.
test_group("DcBlocker +inf latches too (inf - inf = NaN on the second sample)");
var bi = dcblocker_new();
assert_eq(prani_is_finite(dcblocker_process(bi, PRANI_POS_INF)), 0, "y0 non-finite");
assert_eq(prani_is_finite(dcblocker_process(bi, F64_ONE)), 0, "y1 non-finite");
assert_eq(prani_is_finite(dcblocker_process(bi, F64_ONE)), 0, "y2 still non-finite");

# process_buffer detects the latch (O(1) per buffer, logged) but does NOT
# repair it and does NOT change the buffer contents -- the whole tail is NaN.
test_group("process_buffer detects but does not repair the latch");
var bl = dcblocker_new();
var lbuf = vec_new();
vec_push(lbuf, F64_ONE);
vec_push(lbuf, NAN_BITS);
vec_push(lbuf, F64_ONE);
dcblocker_process_buffer(bl, lbuf);
assert_eq(vec_get(lbuf, 0), F64_ONE, "samples before the NaN are filtered normally");
assert_eq(prani_is_finite(vec_get(lbuf, 1)), 0, "the NaN sample");
assert_eq(prani_is_finite(vec_get(lbuf, 2)), 0, "and everything after it");
assert_eq(prani_is_finite(DcBlocker_y_prev(bl)), 0, "state left poisoned, not fabricated back");
# a clean filter over a clean buffer leaves finite state (the detector stays quiet)
var lok = vec_new();
vec_push(lok, F64_ONE);
dcblocker_process_buffer(dcblocker_new(), lok);
assert_eq(vec_get(lok, 0), F64_ONE, "clean buffer unchanged in behaviour");

# ----------------------------------------------------------------
# prani_vec_push_zeros: n in [0, i64::MAX]. 0 is VALID, negative is REPORTED.
# ----------------------------------------------------------------
test_group("push_zeros: a zero count is VALID (nothing to append is an answer)");
var pz = vec_new();
assert_eq(prani_vec_push_zeros(pz, 0), PRANI_ERR_NONE, "n == 0 -> ERR_NONE, not an error");
assert_eq(vec_len(pz), 0, "and appends nothing");
assert_eq(prani_vec_push_zeros(pz, 3), PRANI_ERR_NONE, "n == 3 -> ERR_NONE");
assert_eq(vec_len(pz), 3, "appends exactly n");
assert_eq(vec_get(pz, 2), 0, "and they are zero");

test_group("push_zeros: a NEGATIVE count is reported, not silently empty (F11)");
assert_eq(prani_vec_push_zeros(pz, (0 - 1)), PRANI_ERR_INVALID_VOCALIZATION, "n == -1 rejected");
assert_eq(vec_len(pz), 3, "and the buffer is untouched");
# the shape every call site actually produces: f64_to saturates NaN to i64::MIN
var pz_nan = f64_to(f64_div(0, 0));
assert_eq(pz_nan < 0, 1, "f64_to(NaN) is i64::MIN, i.e. negative");
assert_eq(prani_vec_push_zeros(pz, pz_nan), PRANI_ERR_INVALID_VOCALIZATION,
  "a NaN-derived gap count is reported");
assert_eq(vec_len(pz), 3, "still untouched -- behaviour identical, only the code moved");
# and a NaN-derived count from the real expression (seconds * sample_rate)
var pz_gap = f64_to(f64_mul(f64_div(0, 0), f64_from(44100)));
assert_eq(prani_vec_push_zeros(pz, pz_gap), PRANI_ERR_INVALID_VOCALIZATION,
  "f64_to(NaN gap * 44100) is reported");

# F10's chorus overflow, reproduced: total_len = base + max_offset*2 wraps past
# i64::MAX to a negative around timing_spread 1e14 s, and the old helper turned
# that into an empty mix with no complaint.
test_group("push_zeros: F10's wrapped chorus length is reported");
var f10_off = f64_to(f64_mul(f64_from(100000000000000), f64_from(48000)));
assert_eq(f10_off > 0, 1, "max_offset_samples itself is positive");
var f10_total = f64_to(f64_mul(F64_ONE, f64_from(48000))) + f10_off * 2;
assert_eq(f10_total < 0, 1, "base + max_offset*2 wraps NEGATIVE (F10)");
assert_eq(prani_vec_push_zeros(pz, f10_total), PRANI_ERR_INVALID_VOCALIZATION,
  "the wrapped chorus length is reported, not silently empty");
assert_eq(vec_len(pz), 3, "and no mix buffer was fabricated");

# ----------------------------------------------------------------
# prani_vec_extend: no numeric range -- it copies bit patterns verbatim.
# ----------------------------------------------------------------
test_group("extend has no range: it copies bit patterns without interpreting them");
var ex_src = vec_new();
vec_push(ex_src, F64_ONE);
vec_push(ex_src, NAN_BITS);
var ex_dst = vec_new();
assert_eq(prani_vec_extend(ex_dst, ex_src), PRANI_ERR_NONE, "extend returns ERR_NONE");
assert_eq(vec_len(ex_dst), 2, "every element appended");
assert_eq(vec_get(ex_dst, 1), NAN_BITS, "a NaN element is copied VERBATIM, not rejected");
assert_eq(prani_vec_extend(ex_dst, vec_new()), PRANI_ERR_NONE, "an empty src is not an error");
assert_eq(vec_len(ex_dst), 2, "and appends nothing");

var rc = assert_summary();
syscall(60, rc);

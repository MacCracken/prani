# emotion.tcyr -- tests for src/emotion.cyr.
# 2.0.3:rust-old/src/emotion.rs had no #[test] blocks; parity surface is the
# valence/arousal -> (Vocalization, CallIntent) mapping (all 9 zone quadrants +
# their sub-branches) and the evaluate() continuous outputs (vocal_effort,
# pitch_scale, breathiness_delta). Golden float values computed by hand in f64,
# matching the Rust match arms + arithmetic exactly. serde/Display tests dropped.

include "src/error.cyr"
include "src/vocalization.cyr"
include "src/emotion.cyr"

alloc_init();

# ---- test input constants (IEEE-754 hex) ----
var T_NEG_0_8 = 0xbfe999999999999a;   # -0.8
var T_NEG_0_6 = 0xbfe3333333333333;   # -0.6
var T_NEG_0_5 = 0xbfe0000000000000;   # -0.5
var T_NEG_0_3 = 0xbfd3333333333333;   # -0.3
var T_POS_0_7 = 0x3fe6666666666666;   #  0.7
var T_POS_0_3 = 0x3fd3333333333333;   #  0.3
var T_0_0     = 0x0000000000000000;   #  0.0
var T_0_1     = 0x3fb999999999999a;   #  0.1
var T_0_2     = 0x3fc999999999999a;   #  0.2
var T_0_25    = 0x3fd0000000000000;   #  0.25
var T_0_5     = 0x3fe0000000000000;   #  0.5
var T_0_625   = 0x3fe4000000000000;   #  0.625
var T_0_75    = 0x3fe8000000000000;   #  0.75
var T_0_875   = 0x3fec000000000000;   #  0.875
var T_0_9     = 0x3feccccccccccccd;   #  0.9
var T_1_0     = 0x3ff0000000000000;   #  1.0
var T_2_0     = 0x4000000000000000;   #  2.0
var T_NEG_2_0 = 0xc000000000000000;   # -2.0
var T_NEG_1_0 = 0xbff0000000000000;   # -1.0

# ================================================================
test_group("constructors -- new() defaults + accessors");
var e = emotion_new();
assert_eq(emotion_valence(e), T_0_0, "new valence == 0.0");
assert_eq(emotion_arousal(e), T_0_2, "new arousal == 0.2");
assert_eq(PrEmotion_smoothing(e), T_0_1, "new smoothing == 0.1");

# ================================================================
test_group("with_values -- clamps to valid ranges");
var ec = emotion_with_values(T_NEG_2_0, T_2_0);
assert_eq(emotion_valence(ec), T_NEG_1_0, "valence clamped to -1.0");
assert_eq(emotion_arousal(ec), T_1_0, "arousal clamped to 1.0");
var ec2 = emotion_with_values(T_2_0, T_NEG_2_0);
assert_eq(emotion_valence(ec2), T_1_0, "valence clamped to +1.0");
assert_eq(emotion_arousal(ec2), T_0_0, "arousal clamped to 0.0");
var ecmid = emotion_with_values(T_POS_0_7, T_0_5);
assert_eq(emotion_valence(ecmid), T_POS_0_7, "valence 0.7 unclamped");
assert_eq(emotion_arousal(ecmid), T_0_5, "arousal 0.5 unclamped");
assert_eq(PrEmotion_smoothing(ecmid), T_0_1, "with_values smoothing default 0.1");

# ================================================================
test_group("with_smoothing -- clamps to [0.0, 0.95]");
var es = emotion_with_smoothing(emotion_new(), T_2_0);
assert_eq(PrEmotion_smoothing(es), 0x3fee666666666666, "smoothing clamped to 0.95");
var es2 = emotion_with_smoothing(emotion_new(), T_NEG_1_0);
assert_eq(PrEmotion_smoothing(es2), T_0_0, "smoothing clamped to 0.0");
var es3 = emotion_with_smoothing(emotion_new(), T_0_5);
assert_eq(PrEmotion_smoothing(es3), T_0_5, "smoothing 0.5 unclamped");

# ================================================================
test_group("set -- direct assignment with clamping");
var eset = emotion_new();
emotion_set(eset, T_2_0, T_2_0);
assert_eq(emotion_valence(eset), T_1_0, "set valence clamped +1.0");
assert_eq(emotion_arousal(eset), T_1_0, "set arousal clamped 1.0");

# ================================================================
test_group("update -- exponential decay toward target (s=0.1)");
# new(): v=0.0, a=0.2, s=0.1. update toward (1.0, 1.0):
#   v = 0.0*0.1 + 1.0*0.9 = 0.9
#   a = 0.2*0.1 + 1.0*0.9 = 0.92
var eu = emotion_new();
emotion_update(eu, T_1_0, T_1_0);
assert_eq(emotion_valence(eu), 0x3feccccccccccccd, "update valence -> 0.9");
assert_eq(emotion_arousal(eu), 0x3fed70a3d70a3d71, "update arousal -> 0.92");
# targets clamped before blending: update toward (-2.0, -2.0) from new()
var eu2 = emotion_new();
emotion_update(eu2, T_NEG_2_0, T_NEG_2_0);
# v = 0.0*0.1 + (-1.0)*0.9 = -0.9 ; a = 0.2*0.1 + 0.0*0.9 = 0.02
assert_eq(emotion_valence(eu2), 0xbfeccccccccccccd, "update valence clamped tgt -> -0.9");
assert_eq(emotion_arousal(eu2), 0x3f947ae147ae147c, "update arousal clamped tgt -> 0.02");

# ================================================================
# The oracle's test_emotion_state_smooth_update
# (`git show 2.0.3:rust-old/tests/integration.rs`, lines 746-753) builds
# with_values(0.0, 0.5).with_smoothing(0.5), updates toward (1.0, 1.0) and
# asserts the result lands in (0.4, 0.6) x (0.7, 0.8). update() reads the
# per-state smoothing (src/emotion.cyr:117), so the halfway point is exact in
# binary and is pinned here as a bit pattern instead of a window.
test_group("update -- non-default smoothing (s=0.5)");
var eu3 = emotion_with_smoothing(emotion_with_values(T_0_0, T_0_5), T_0_5);
emotion_update(eu3, T_1_0, T_1_0);
# v = 0.0*0.5 + 1.0*0.5 = 0.5 ; a = 0.5*0.5 + 1.0*0.5 = 0.75
assert_eq(emotion_valence(eu3), T_0_5, "s=0.5 -> valence halfway (0.5)");
assert_eq(emotion_arousal(eu3), T_0_75, "s=0.5 -> arousal 0.75");
# Control: an update that ignored the field and used the hardcoded PRE_0_1
# would land on 0.9 / 0.95 from this same start and target.
assert_neq(emotion_valence(eu3), 0x3feccccccccccccd, "valence is not the s=0.1 result 0.9");
assert_neq(emotion_arousal(eu3), 0x3fee666666666667, "arousal is not the s=0.1 result 0.95");
assert_eq(PrEmotion_smoothing(eu3), T_0_5, "smoothing unchanged by update");
var eu3v1 = emotion_valence(eu3);
# a second step blends from the updated state, not from the original
emotion_update(eu3, T_1_0, T_1_0);
assert_eq(emotion_valence(eu3), T_0_75, "s=0.5 step 2 -> valence 0.75");
assert_eq(emotion_arousal(eu3), T_0_875, "s=0.5 step 2 -> arousal 0.875");

# ================================================================
# Three more smoothing values, so the group above cannot pass by coincidence.
# Same start (0.0, 0.5) and same target (1.0, 1.0) as above unless noted --
# only s differs, and every expected value below differs from every other.
test_group("update -- smoothing controls (s=0.75, s=0.0, s=0.95 clamp)");
var eu4 = emotion_with_smoothing(emotion_with_values(T_0_0, T_0_5), T_0_75);
emotion_update(eu4, T_1_0, T_1_0);
# v = 0.0*0.75 + 1.0*0.25 = 0.25 ; a = 0.5*0.75 + 1.0*0.25 = 0.625
assert_eq(emotion_valence(eu4), T_0_25, "s=0.75 -> valence 0.25");
assert_eq(emotion_arousal(eu4), T_0_625, "s=0.75 -> arousal 0.625");
# more smoothing = less movement toward the target in one step
assert_eq(f64_lt(emotion_valence(eu4), eu3v1), 1, "s=0.75 moves less than s=0.5");
# s=0.0 is instant: one step lands exactly on the (clamped) target
var eu5 = emotion_with_smoothing(emotion_with_values(T_POS_0_7, T_0_5), T_0_0);
emotion_update(eu5, T_0_25, T_0_9);
assert_eq(emotion_valence(eu5), T_0_25, "s=0.0 -> valence snaps to target 0.25");
assert_eq(emotion_arousal(eu5), T_0_9, "s=0.0 -> arousal snaps to target 0.9");
# with_smoothing clamps 2.0 to 0.95, and update blends with the clamped value
var eu6 = emotion_with_smoothing(emotion_with_values(T_0_0, T_0_5), T_2_0);
emotion_update(eu6, T_1_0, T_1_0);
# 1.0-0.95 rounds to 0.050000000000000044, so v is that and a is 0.525
assert_eq(emotion_valence(eu6), 0x3fa99999999999a0, "s clamped to 0.95 -> valence 0.05");
assert_eq(emotion_arousal(eu6), 0x3fe0cccccccccccd, "s clamped to 0.95 -> arousal 0.525");
assert_eq(f64_lt(emotion_valence(eu6), emotion_valence(eu4)), 1, "s=0.95 moves less than s=0.75");

# ================================================================
test_group("valence_zone / arousal_zone boundaries");
var z = emotion_new();
emotion_set(z, T_NEG_0_5, T_0_1);
assert_eq(emotion_valence_zone(z), PRE_VZ_NEGATIVE, "valence -0.5 -> Negative");
assert_eq(emotion_arousal_zone(z), PRE_AZ_LOW, "arousal 0.1 -> Low");
emotion_set(z, T_POS_0_7, T_0_9);
assert_eq(emotion_valence_zone(z), PRE_VZ_POSITIVE, "valence 0.7 -> Positive");
assert_eq(emotion_arousal_zone(z), PRE_AZ_HIGH, "arousal 0.9 -> High");
emotion_set(z, T_0_0, T_0_5);
assert_eq(emotion_valence_zone(z), PRE_VZ_NEUTRAL, "valence 0.0 -> Neutral");
assert_eq(emotion_arousal_zone(z), PRE_AZ_MID, "arousal 0.5 -> Mid");

# ================================================================
test_group("select_vocalization -- all 9 zone quadrants + sub-branches");
var s = emotion_new();
# Negative / High: screech (v < -0.5) vs bark
emotion_set(s, T_NEG_0_8, T_0_9);
assert_eq(emotion_select_vocalization(s), PRANI_VOC_SCREECH, "Neg/High v=-0.8 -> Screech");
emotion_set(s, T_NEG_0_3, T_0_9);
assert_eq(emotion_select_vocalization(s), PRANI_VOC_BARK, "Neg/High v=-0.3 -> Bark");
# Positive / High: trill (v > 0.5) vs chirp
emotion_set(s, T_POS_0_7, T_0_9);
assert_eq(emotion_select_vocalization(s), PRANI_VOC_TRILL, "Pos/High v=0.7 -> Trill");
emotion_set(s, T_POS_0_3, T_0_9);
assert_eq(emotion_select_vocalization(s), PRANI_VOC_CHIRP, "Pos/High v=0.3 -> Chirp");
# Neutral / High -> Bark
emotion_set(s, T_0_0, T_0_9);
assert_eq(emotion_select_vocalization(s), PRANI_VOC_BARK, "Neu/High -> Bark");
# Negative / Low -> Growl
emotion_set(s, T_NEG_0_5, T_0_1);
assert_eq(emotion_select_vocalization(s), PRANI_VOC_GROWL, "Neg/Low -> Growl");
# Positive / Low -> Purr
emotion_set(s, T_POS_0_7, T_0_1);
assert_eq(emotion_select_vocalization(s), PRANI_VOC_PURR, "Pos/Low -> Purr");
# Neutral / Low -> Rumble
emotion_set(s, T_0_0, T_0_2);
assert_eq(emotion_select_vocalization(s), PRANI_VOC_RUMBLE, "Neu/Low -> Rumble");
# Negative / Mid -> Growl
emotion_set(s, T_NEG_0_5, T_0_5);
assert_eq(emotion_select_vocalization(s), PRANI_VOC_GROWL, "Neg/Mid -> Growl");
# Positive / Mid -> Howl
emotion_set(s, T_POS_0_7, T_0_5);
assert_eq(emotion_select_vocalization(s), PRANI_VOC_HOWL, "Pos/Mid -> Howl");
# Neutral / Mid -> Whine
emotion_set(s, T_0_0, T_0_5);
assert_eq(emotion_select_vocalization(s), PRANI_VOC_WHINE, "Neu/Mid -> Whine");

# ================================================================
test_group("select_intent -- all 9 zone quadrants + sub-branches");
var it = emotion_new();
# Negative / High: distress (v < -0.7) vs alarm
emotion_set(it, T_NEG_0_8, T_0_9);
assert_eq(emotion_select_intent(it), PRANI_INTENT_DISTRESS, "Neg/High v=-0.8 -> Distress");
emotion_set(it, T_NEG_0_6, T_0_9);
assert_eq(emotion_select_intent(it), PRANI_INTENT_ALARM, "Neg/High v=-0.6 -> Alarm");
emotion_set(it, T_NEG_0_3, T_0_9);
assert_eq(emotion_select_intent(it), PRANI_INTENT_ALARM, "Neg/High v=-0.3 -> Alarm");
# Positive / High -> Mating
emotion_set(it, T_POS_0_7, T_0_9);
assert_eq(emotion_select_intent(it), PRANI_INTENT_MATING, "Pos/High -> Mating");
# Neutral / High -> Alarm
emotion_set(it, T_0_0, T_0_9);
assert_eq(emotion_select_intent(it), PRANI_INTENT_ALARM, "Neu/High -> Alarm");
# Negative / Low -> Threat
emotion_set(it, T_NEG_0_5, T_0_1);
assert_eq(emotion_select_intent(it), PRANI_INTENT_THREAT, "Neg/Low -> Threat");
# Positive / Low -> Idle
emotion_set(it, T_POS_0_7, T_0_1);
assert_eq(emotion_select_intent(it), PRANI_INTENT_IDLE, "Pos/Low -> Idle");
# Neutral / Low -> Idle
emotion_set(it, T_0_0, T_0_2);
assert_eq(emotion_select_intent(it), PRANI_INTENT_IDLE, "Neu/Low -> Idle");
# Negative / Mid -> Threat
emotion_set(it, T_NEG_0_5, T_0_5);
assert_eq(emotion_select_intent(it), PRANI_INTENT_THREAT, "Neg/Mid -> Threat");
# Positive / Mid -> Social
emotion_set(it, T_POS_0_7, T_0_5);
assert_eq(emotion_select_intent(it), PRANI_INTENT_SOCIAL, "Pos/Mid -> Social");
# Neutral / Mid -> Social
emotion_set(it, T_0_0, T_0_5);
assert_eq(emotion_select_intent(it), PRANI_INTENT_SOCIAL, "Neu/Mid -> Social");

# ================================================================
test_group("evaluate -- Neutral/Low default (new state)");
var ev = emotion_new();   # v=0.0, a=0.2
var o = emotion_evaluate(ev);
assert_eq(PrEmotionOut_vocalization(o), PRANI_VOC_RUMBLE, "default vocalization Rumble");
assert_eq(PrEmotionOut_intent(o), PRANI_INTENT_IDLE, "default intent Idle");
# effort = 0.2 + 0.2*0.7 = 0.34
assert_eq(PrEmotionOut_vocal_effort(o), 0x3fd5c28f5c28f5c2, "effort 0.34");
# pitch = 1.0 + 0.0*0.15 = 1.0
assert_eq(PrEmotionOut_pitch_scale(o), T_1_0, "pitch 1.0");
# arousal 0.2 is NOT < 0.2 -> breath 0.0
assert_eq(PrEmotionOut_breathiness_delta(o), T_0_0, "breath 0.0 at arousal 0.2");

# ================================================================
test_group("evaluate -- high-arousal breathiness branch (v=-0.8, a=0.9)");
var eh = emotion_new();
emotion_set(eh, T_NEG_0_8, T_0_9);
var oh = emotion_evaluate(eh);
assert_eq(PrEmotionOut_vocalization(oh), PRANI_VOC_SCREECH, "screech");
assert_eq(PrEmotionOut_intent(oh), PRANI_INTENT_DISTRESS, "distress");
# effort = 0.2 + 0.9*0.7 = 0.83
assert_eq(PrEmotionOut_vocal_effort(oh), 0x3fea8f5c28f5c290, "effort 0.83");
# pitch = 1.0 + (-0.8)*0.15 = 0.88
assert_eq(PrEmotionOut_pitch_scale(oh), 0x3fec28f5c28f5c29, "pitch 0.88");
# breath = (0.9-0.8)*0.75 = 0.075
assert_eq(PrEmotionOut_breathiness_delta(oh), 0x3fb3333333333332, "breath 0.075 (high)");

# ================================================================
test_group("evaluate -- low-arousal breathiness branch (v=0.7, a=0.1)");
var el = emotion_new();
emotion_set(el, T_POS_0_7, T_0_1);
var ol = emotion_evaluate(el);
assert_eq(PrEmotionOut_vocalization(ol), PRANI_VOC_PURR, "purr");
assert_eq(PrEmotionOut_intent(ol), PRANI_INTENT_IDLE, "idle");
# effort = 0.2 + 0.1*0.7 = 0.27
assert_eq(PrEmotionOut_vocal_effort(ol), 0x3fd147ae147ae148, "effort 0.27");
# pitch = 1.0 + 0.7*0.15 = 1.105
assert_eq(PrEmotionOut_pitch_scale(ol), 0x3ff1ae147ae147ae, "pitch 1.105");
# breath = (0.2-0.1)*0.5 = 0.05
assert_eq(PrEmotionOut_breathiness_delta(ol), 0x3fa999999999999a, "breath 0.05 (low)");

# ================================================================
# serde roundtrip (restores the Rust #[derive(Serialize, Deserialize)] on
# EmotionState -- valence/arousal/smoothing, all f64).
# The #derive(Serialize) f64 formatter emits 6 decimal places, so field values
# are chosen to survive a 6-digit decimal round-trip exactly: valence 0.5,
# arousal 0.25, smoothing 0.1 (all distinct, non-zero, and != the new() defaults
# of 0.0 / 0.2 / 0.1).
test_group("PrEmotion serde roundtrip");
var pe = emotion_with_values(T_0_5, T_0_25);
var pesb = str_builder_new();
PrEmotion_to_json(pe, pesb);
var pejstr = str_data(str_builder_build(pesb));
var pe2 = PrEmotion_from_json_str(pejstr);
assert_eq(PrEmotion_valence(pe2), PrEmotion_valence(pe), "valence roundtrips");
assert_eq(PrEmotion_arousal(pe2), PrEmotion_arousal(pe), "arousal roundtrips");
assert_eq(PrEmotion_smoothing(pe2), PrEmotion_smoothing(pe), "smoothing roundtrips");
var pesb2 = str_builder_new();
PrEmotion_to_json(pe2, pesb2);
# length first: memeq over strlen() is a PREFIX compare, so a re-serialization
# that APPENDED a field would pass it. The oracle compared whole strings.
var pejstr_2 = str_data(str_builder_build(pesb2));
assert_eq(strlen(pejstr_2), strlen(pejstr), "json idempotent -- same length");
assert_eq(memeq(pejstr, pejstr_2, strlen(pejstr)), 1, "json idempotent");

# ================================================================
# serde roundtrip (restores the Rust #[derive(Serialize, Deserialize)] on
# EmotionOutput -- vocalization/intent i64 codes + three f64 modulation params).
# State v=-0.5, a=0.1 (Neg/Low) -> vocalization Growl + intent Threat (both
# non-default) and evaluate() yields effort 0.27, pitch 0.925, breath 0.05 --
# all three floats non-zero AND 6-digit-decimal-stable so they roundtrip exactly.
test_group("PrEmotionOut serde roundtrip");
var poe = emotion_new();
emotion_set(poe, T_NEG_0_5, T_0_1);
var po = emotion_evaluate(poe);
var posb = str_builder_new();
PrEmotionOut_to_json(po, posb);
var pojstr = str_data(str_builder_build(posb));
var po2 = PrEmotionOut_from_json_str(pojstr);
assert_eq(PrEmotionOut_vocalization(po2), PrEmotionOut_vocalization(po), "vocalization roundtrips");
assert_eq(PrEmotionOut_intent(po2), PrEmotionOut_intent(po), "intent roundtrips");
assert_eq(PrEmotionOut_vocal_effort(po2), PrEmotionOut_vocal_effort(po), "vocal_effort roundtrips");
assert_eq(PrEmotionOut_pitch_scale(po2), PrEmotionOut_pitch_scale(po), "pitch_scale roundtrips");
assert_eq(PrEmotionOut_breathiness_delta(po2), PrEmotionOut_breathiness_delta(po), "breathiness_delta roundtrips");
var posb2 = str_builder_new();
PrEmotionOut_to_json(po2, posb2);
# length first: memeq over strlen() is a PREFIX compare, so a re-serialization
# that APPENDED a field would pass it. The oracle compared whole strings.
var pojstr_2 = str_data(str_builder_build(posb2));
assert_eq(strlen(pojstr_2), strlen(pojstr), "json idempotent -- same length");
assert_eq(memeq(pojstr, pojstr_2, strlen(pojstr)), 1, "json idempotent");


# ================================================================
# Input-range guards (2.0.5, audit finding F11). src/emotion.cyr clamps every
# setter, and f64_clamp(NaN, lo, hi) -> NaN (measured, pinned in
# tests/error.tcyr), so a NaN valence/arousal/smoothing is STORED -- and then
# reads as Neutral/Mid while evaluate() hands out NaN synthesis params. The
# builders and mutators (with_values / with_smoothing / set / update) return
# the struct or nothing, so the guard lives at the point of USE: the two zone
# classifiers, the two selectors and evaluate each return
# PRANI_ERR_INVALID_VOCALIZATION instead of a fabricated answer.
#
# DIVERGENCE from the oracle: the Rust EmotionState::evaluate() returns
# EmotionOutput (infallible), Rust's f32::clamp propagates NaN identically, and
# serde's derived Deserialize accepts any float for any field -- so the oracle
# accepts every state rejected below. It has no NaN or out-of-range emotion
# test to break: all six emotion tests in
# `git show 2.0.3:rust-old/tests/integration.rs` (lines 723-773) use in-range
# values, and every assertion above this block still passes unchanged.
# ================================================================

var T_POS_INF   = 0x7ff0000000000000;   #  +inf
var T_NEG_INF   = 0xfff0000000000000;   #  -inf
var T_5_0       = 0x4014000000000000;   #  5.0   (out of range for valence)
var T_3_0       = 0x4008000000000000;   #  3.0   (out of range for smoothing)
var T_0_95      = 0x3fee666666666666;   #  0.95  (smoothing clamp hi)
var T_PAST_1_0  = 0x3ff0000000000001;   #  1.0000000000000002 (one ulp past 1.0)
var T_PAST_0_95 = 0x3fee666666666667;   #  0.9500000000000001 (one ulp past 0.95)

# ================================================================
# Why the guards test the range EXACTLY rather than with a tolerance:
# update() is a convex blend of two in-range values, so it cannot leave
# [-1,1] x [0,1] by even one ulp. Swept 2026-08-31: smoothing k/64 for
# k = 0..64 (with_smoothing clamps the top four to 0.95), a 9x5 grid of start
# states, all four target corners, 64 steps each = 748800 update steps. The
# extremes land exactly on the bounds, so an exact test rejects nothing this
# module can produce.
test_group("input-range guards -- the range update() can actually produce");
var g_over = 0;
var g_v_hi = T_NEG_1_0;
var g_v_lo = T_1_0;
var g_a_hi = T_0_0;
var g_a_lo = T_1_0;
var g_k = 0;
while (g_k < 65) {
    var g_s = f64_div(f64_from(g_k), f64_from(64));
    var g_i = 0;
    while (g_i < 9) {
        var g_v0 = f64_sub(f64_div(f64_from(g_i), f64_from(4)), T_1_0);
        var g_j = 0;
        while (g_j < 5) {
            var g_a0 = f64_div(f64_from(g_j), f64_from(4));
            var g_t = 0;
            while (g_t < 4) {
                var g_tv = T_NEG_1_0;
                if (g_t > 1) { g_tv = T_1_0; }
                var g_ta = T_0_0;
                if (g_t == 1) { g_ta = T_1_0; }
                if (g_t == 3) { g_ta = T_1_0; }
                var g_e = emotion_with_smoothing(emotion_with_values(g_v0, g_a0), g_s);
                var g_n = 0;
                while (g_n < 64) {
                    emotion_update(g_e, g_tv, g_ta);
                    var g_v = emotion_valence(g_e);
                    var g_a = emotion_arousal(g_e);
                    if (f64_gt(g_v, g_v_hi) == 1) { g_v_hi = g_v; }
                    if (f64_lt(g_v, g_v_lo) == 1) { g_v_lo = g_v; }
                    if (f64_gt(g_a, g_a_hi) == 1) { g_a_hi = g_a; }
                    if (f64_lt(g_a, g_a_lo) == 1) { g_a_lo = g_a; }
                    if (f64_gt(g_v, T_1_0) == 1)     { g_over = g_over + 1; }
                    if (f64_lt(g_v, T_NEG_1_0) == 1) { g_over = g_over + 1; }
                    if (f64_gt(g_a, T_1_0) == 1)     { g_over = g_over + 1; }
                    if (f64_lt(g_a, T_0_0) == 1)     { g_over = g_over + 1; }
                    g_n = g_n + 1;
                }
                g_t = g_t + 1;
            }
            g_j = g_j + 1;
        }
        g_i = g_i + 1;
    }
    g_k = g_k + 1;
}
assert_eq(g_over, 0, "748800 update steps never left [-1,1] x [0,1]");
assert_eq(g_v_hi, T_1_0, "sweep max valence is exactly +1.0");
assert_eq(g_v_lo, T_NEG_1_0, "sweep min valence is exactly -1.0");
assert_eq(g_a_hi, T_1_0, "sweep max arousal is exactly 1.0");
assert_eq(g_a_lo, T_0_0, "sweep min arousal is exactly 0.0");

# ================================================================
# valence NaN, arrived via with_values' clamp. Each zone classifier validates
# only the field it reads, so arousal_zone still answers -- the reject is not
# a blanket "this handle is poisoned".
test_group("input-range guards -- NaN valence is stored, then rejected");
var gn = emotion_with_values(f64_div(0, 0), T_0_5);
assert_eq(prani_is_finite(emotion_valence(gn)), 0, "f64_clamp passed the NaN through (F11)");
assert_eq(emotion_arousal(gn), T_0_5, "arousal unaffected");
assert_eq(emotion_valence_zone(gn), PRANI_ERR_INVALID_VOCALIZATION, "valence_zone rejects NaN");
assert_eq(emotion_arousal_zone(gn), PRE_AZ_MID, "arousal_zone still classifies its own field");
assert_eq(emotion_select_vocalization(gn), PRANI_ERR_INVALID_VOCALIZATION, "select_vocalization rejects");
assert_eq(emotion_select_intent(gn), PRANI_ERR_INVALID_VOCALIZATION, "select_intent rejects");
assert_eq(emotion_evaluate(gn), PRANI_ERR_INVALID_VOCALIZATION, "evaluate rejects");
assert_eq(prani_is_err(emotion_evaluate(gn)), 1, "evaluate's return reads as an error code");

# ================================================================
# arousal NaN, arrived via set()'s clamp (the other mutator path).
test_group("input-range guards -- NaN arousal via set()");
var ga = emotion_new();
emotion_set(ga, T_0_5, f64_div(0, 0));
assert_eq(prani_is_finite(emotion_arousal(ga)), 0, "set's clamp passed the NaN through");
assert_eq(emotion_valence(ga), T_0_5, "valence set normally");
assert_eq(emotion_valence_zone(ga), PRE_VZ_POSITIVE, "valence_zone still classifies its own field");
assert_eq(emotion_arousal_zone(ga), PRANI_ERR_INVALID_VOCALIZATION, "arousal_zone rejects NaN");
assert_eq(emotion_select_vocalization(ga), PRANI_ERR_INVALID_VOCALIZATION, "select_vocalization rejects");
assert_eq(emotion_select_intent(ga), PRANI_ERR_INVALID_VOCALIZATION, "select_intent rejects");
assert_eq(emotion_evaluate(ga), PRANI_ERR_INVALID_VOCALIZATION, "evaluate rejects");

# ================================================================
# smoothing is the field evaluate() does not read but does check: it cannot
# reach an out-of-contract value through with_smoothing (which clamps), and it
# corrupts valence/arousal on the very next tick.
test_group("input-range guards -- NaN smoothing corrupts the state on update");
var gs = emotion_with_smoothing(emotion_with_values(T_0_0, T_0_5), f64_div(0, 0));
assert_eq(prani_is_finite(PrEmotion_smoothing(gs)), 0, "with_smoothing's clamp passed the NaN through");
assert_eq(emotion_valence_zone(gs), PRE_VZ_NEUTRAL, "valence_zone unaffected -- it checks only what it reads");
assert_eq(emotion_evaluate(gs), PRANI_ERR_INVALID_VOCALIZATION, "evaluate rejects it (it checks all three fields)");
emotion_update(gs, T_1_0, T_1_0);
assert_eq(prani_is_finite(emotion_valence(gs)), 0, "one update turns valence NaN too");
assert_eq(emotion_valence_zone(gs), PRANI_ERR_INVALID_VOCALIZATION, "and now valence_zone rejects it as well");

test_group("input-range guards -- finite out-of-range smoothing diverges");
var gd = emotion_with_values(T_0_0, T_0_5);
PrEmotion_set_smoothing(gd, T_3_0);   # unreachable via with_smoothing (clamps to 0.95)
assert_eq(emotion_evaluate(gd), PRANI_ERR_INVALID_VOCALIZATION, "evaluate rejects smoothing 3.0");
emotion_update(gd, T_1_0, T_1_0);
# v = 0.0*3 + 1.0*(1-3) = -2.0 -- the blend stops being convex, one tick is
# enough to leave the documented range
assert_eq(emotion_valence(gd), T_NEG_2_0, "s=3.0 -> valence -2.0 after one update");
assert_eq(emotion_valence_zone(gd), PRANI_ERR_INVALID_VOCALIZATION, "the divergence is caught by the valence guard");

# ================================================================
# The out-of-range door this module cannot close from the inside: PrEmotion's
# fields are i64 bit patterns and PrEmotion_from_json_str is derive-generated,
# so it writes them unclamped. ADR-0002 checks the parse, not the fields; the
# field range therefore lands at the consumer, which is the whole reason the
# guard sits at the point of use. The document below is
# {valence: 5.0, arousal: 0.5, smoothing: 0.1} -- one prani would never write,
# since every prani-side path clamps before serializing.
test_group("input-range guards -- a document prani did not write");
var gjson = "{\"valence\":4617315517961601024,\"arousal\":4602678819172646912,\"smoothing\":4591870180066957722}";
var gj = PrEmotion_from_json_str(gjson);
assert_eq(emotion_valence(gj), T_5_0, "from_json_str stores valence 5.0 unclamped");
assert_eq(emotion_arousal(gj), T_0_5, "arousal parsed");
assert_eq(PrEmotion_smoothing(gj), T_0_1, "smoothing parsed");
assert_eq(emotion_valence_zone(gj), PRANI_ERR_INVALID_VOCALIZATION, "valence_zone rejects 5.0");
assert_eq(emotion_select_vocalization(gj), PRANI_ERR_INVALID_VOCALIZATION, "select_vocalization rejects 5.0");
assert_eq(emotion_select_intent(gj), PRANI_ERR_INVALID_VOCALIZATION, "select_intent rejects 5.0");
assert_eq(emotion_evaluate(gj), PRANI_ERR_INVALID_VOCALIZATION, "evaluate rejects 5.0");

# ================================================================
# Infinities are NOT the hazard at a clamp site -- f64_clamp bounds them
# (measured, tests/error.tcyr) -- so an infinity through with_values becomes a
# legal endpoint and stays accepted. Only the unclamped doors deliver one.
test_group("input-range guards -- infinities");
var gi = emotion_with_values(T_POS_INF, T_NEG_INF);
assert_eq(emotion_valence(gi), T_1_0, "with_values clamps +inf valence to 1.0");
assert_eq(emotion_arousal(gi), T_0_0, "with_values clamps -inf arousal to 0.0");
assert_eq(prani_is_err(emotion_evaluate(gi)), 0, "a clamped infinity is a valid state -- still accepted");
var gi2 = emotion_new();
PrEmotion_set_arousal(gi2, T_POS_INF);
assert_eq(emotion_arousal_zone(gi2), PRANI_ERR_INVALID_VOCALIZATION, "an unclamped +inf arousal is rejected");
assert_eq(emotion_evaluate(gi2), PRANI_ERR_INVALID_VOCALIZATION, "evaluate rejects it too");

# ================================================================
# The bounds are inclusive, and exact: the endpoints update() actually reaches
# are accepted, one ulp beyond is not.
test_group("input-range guards -- inclusive bounds, one ulp beyond");
var gb = emotion_with_values(T_NEG_1_0, T_0_0);
assert_eq(prani_is_err(emotion_evaluate(gb)), 0, "valence -1.0 / arousal 0.0 accepted");
var gb2 = emotion_with_smoothing(emotion_with_values(T_1_0, T_1_0), T_0_95);
assert_eq(PrEmotion_smoothing(gb2), T_0_95, "smoothing 0.95 is the clamp bound itself");
assert_eq(prani_is_err(emotion_evaluate(gb2)), 0, "valence 1.0 / arousal 1.0 / smoothing 0.95 accepted");
PrEmotion_set_valence(gb2, T_PAST_1_0);
assert_eq(emotion_valence_zone(gb2), PRANI_ERR_INVALID_VOCALIZATION, "one ulp past +1.0 rejected");
PrEmotion_set_valence(gb2, T_NEG_1_0);
PrEmotion_set_smoothing(gb2, T_PAST_0_95);
assert_eq(emotion_evaluate(gb2), PRANI_ERR_INVALID_VOCALIZATION, "one ulp past 0.95 smoothing rejected");

# ================================================================
# Checked/unchecked split (2.0.10). evaluate() used to reach both zone
# classifiers through BOTH selectors, so one call range-checked the same valence
# and the same arousal four times over -- 69 ns at 2.0.3 became 154 ns. Each
# classifier and selector is now a public CHECKED wrapper over an internal
# UNCHECKED core, and evaluate validates all three fields once then takes the
# unchecked path.
#
# The property that makes the split safe: on every state that passes validation,
# checked and unchecked must agree exactly. Swept over a 17x9 grid of in-range
# states below -- if the wrapper and the core ever diverge, one of these counters
# goes non-zero. Counted rather than asserted per-state, matching the sweep
# above, so the suite's assertion count tracks properties and not grid size.
test_group("checked/unchecked split -- the two paths agree on every valid state");
var u_vz = 0;
var u_az = 0;
var u_sv = 0;
var u_si = 0;
var u_n = 0;
var u_i = 0;
while (u_i < 17) {
    var u_v = f64_sub(f64_div(f64_from(u_i), f64_from(8)), T_1_0);
    var u_j = 0;
    while (u_j < 9) {
        var u_a = f64_div(f64_from(u_j), f64_from(8));
        var u_e = emotion_with_values(u_v, u_a);
        if (emotion_valence_zone(u_e) != emotion_valence_zone_unchecked(u_e)) { u_vz = u_vz + 1; }
        if (emotion_arousal_zone(u_e) != emotion_arousal_zone_unchecked(u_e)) { u_az = u_az + 1; }
        if (emotion_select_vocalization(u_e) != emotion_select_vocalization_unchecked(u_e)) { u_sv = u_sv + 1; }
        if (emotion_select_intent(u_e) != emotion_select_intent_unchecked(u_e)) { u_si = u_si + 1; }
        u_n = u_n + 1;
        u_j = u_j + 1;
    }
    u_i = u_i + 1;
}
assert_eq(u_n, 153, "swept 17x9 in-range states");
assert_eq(u_vz, 0, "valence_zone == valence_zone_unchecked on every valid state");
assert_eq(u_az, 0, "arousal_zone == arousal_zone_unchecked on every valid state");
assert_eq(u_sv, 0, "select_vocalization == _unchecked on every valid state");
assert_eq(u_si, 0, "select_intent == _unchecked on every valid state");

# ================================================================
# The other half of the split's contract: the unchecked core really is
# unchecked. On a NaN it answers Neutral/Mid and fabricates a vocalization --
# the exact ADR-0001 failure the guards exist to prevent. That is why an
# `_unchecked` function must only ever be called below a validation of the
# fields it reads, and it is what the public wrappers below it still prevent.
test_group("checked/unchecked split -- the unchecked core is genuinely unchecked");
var un = emotion_with_values(f64_div(0, 0), T_0_5);
assert_eq(prani_is_finite(emotion_valence(un)), 0, "state carries a NaN valence");
assert_eq(emotion_valence_zone_unchecked(un), PRE_VZ_NEUTRAL, "unchecked core fabricates Neutral on NaN");
assert_eq(emotion_select_vocalization_unchecked(un), PRANI_VOC_WHINE, "unchecked selector fabricates Whine");
assert_eq(emotion_select_intent_unchecked(un), PRANI_INTENT_SOCIAL, "unchecked selector fabricates Social");
# ...and every PUBLIC entry point still refuses it -- 2.0.5's guards intact.
assert_eq(emotion_valence_zone(un), PRANI_ERR_INVALID_VOCALIZATION, "public valence_zone still rejects");
assert_eq(emotion_select_vocalization(un), PRANI_ERR_INVALID_VOCALIZATION, "public select_vocalization still rejects");
assert_eq(emotion_select_intent(un), PRANI_ERR_INVALID_VOCALIZATION, "public select_intent still rejects");
assert_eq(emotion_evaluate(un), PRANI_ERR_INVALID_VOCALIZATION, "evaluate still rejects");
# emotion_state_in_range is the single precondition the unchecked path rests on.
assert_eq(emotion_state_in_range(un), 0, "state_in_range rejects the NaN state");
assert_eq(emotion_state_in_range(emotion_with_values(T_NEG_1_0, T_0_0)), 1, "state_in_range accepts the -1.0/0.0 corner");
assert_eq(emotion_state_in_range(emotion_with_values(T_1_0, T_1_0)), 1, "state_in_range accepts the 1.0/1.0 corner");

var rc = assert_summary();
syscall(60, rc);

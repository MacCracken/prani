# realt.cyr -- shared test helpers for prani's two float formats (ADR-0010).
# Not a suite (no .tcyr): the suites that assert on reals include it after src/.
#
# Accuracy is the bar, not a copy of the f64 bits. A suite states each expected
# real as the f64 value it should be; the f32 build is then held to it within a
# measured number of units in the last place of ITS format, and the f64 build to
# it exactly. A budget is a measurement, recorded beside the assertion that needs
# it: an f32 result one rounding away from the f64 value is 0 or 1 ulp, and a chain
# of n roundings is at most about n.

# t_key(x) -- a monotone integer key for a real of the build's format: it orders
# like the value, and -0.0 and +0.0 share a key.
fn t_key(x) {
    if (PRANI_REAL_BITS == 32) {
        if ((x & 0x80000000) != 0) { return 0 - (x & 0x7FFFFFFF); }
        return x & 0x7FFFFFFF;
    }
    if (x < 0) { return 0 - (x & 0x7FFFFFFFFFFFFFFF); }
    return x;
}

# t_word_ok(x) -- 1 iff x can be a real of the build's format: any word in f64, and
# in f32 only one whose high 32 bits are clear (ADR-0010). t_key reads the low 32,
# so without this an f64 bit pattern leaked into the f32 build, or a sign-extended
# word, would be measured as whatever real its low half happens to be (audit C5).
fn t_word_ok(x) {
    if (PRANI_REAL_BITS == 64) { return 1; }
    if ((x >> 32) != 0) { return 0; }
    return 1;
}

# t_ulps(a, b) -- how many reals of the build's format lie between a and b: 0 for
# equal values, and the largest integer when either is NaN or not a word of the
# format at all.
fn t_ulps(a, b) {
    if (t_word_ok(a) == 0) { return 0x7FFFFFFFFFFFFFFF; }
    if (t_word_ok(b) == 0) { return 0x7FFFFFFFFFFFFFFF; }
    if (prani_is_nan(a) == 1) { return 0x7FFFFFFFFFFFFFFF; }
    if (prani_is_nan(b) == 1) { return 0x7FFFFFFFFFFFFFFF; }
    var d = t_key(a) - t_key(b);
    if (d < 0) { d = 0 - d; }
    return d;
}

# assert_real(actual, expected, ulps32, msg) -- `actual` is `expected`: bit for bit in
# the f64 build, and within ulps32 of it in the f32 build. `expected` is a real of
# the build's format (a test constant is one: real.cyr's conversion runs on it).
# A NaN fails in both builds: no budget reaches it, and a suite that expects one
# asserts prani_is_nan. Through 2.3.1 two equal NaNs passed in f64 and failed in f32.
fn assert_real(actual, expected, ulps32, msg) {
    if (PRANI_REAL_BITS == 64) {
        if (prani_is_nan(actual) == 1) { return assert_eq(t_ulps(actual, expected), 0, msg); }
        if (prani_is_nan(expected) == 1) { return assert_eq(t_ulps(actual, expected), 0, msg); }
        return assert_eq(actual, expected, msg);
    }
    var d = t_ulps(actual, expected);
    if (d <= ulps32) { return assert_eq(0, 0, msg); }
    return assert_eq(d, ulps32, msg);   # a miss prints the distance against the budget
}

# t_next_up(x) -- the next real above a positive finite x, in the build's format:
# its bit pattern plus one (0x3FF0000000000001 after 1.0 in f64, 0x3F800001 in f32).
fn t_next_up(x) { return x + 1; }

# t_next_down(x) -- the next real below a positive finite nonzero x: bits minus one.
fn t_next_down(x) { return x - 1; }

# t_per(a64, a32) -- a64 in the f64 build and a32 in the f32 build: for an expected
# integer that the format itself decides (a sample count truncated from a product of
# reals, say), each value measured in its own build.
fn t_per(a64, a32) {
    if (PRANI_REAL_BITS == 64) { return a64; }
    return a32;
}

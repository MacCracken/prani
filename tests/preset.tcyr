test_group("preset_build -- species + effective_tract_scale + effective_f0");

var v_alpha = preset_build(preset_alpha_wolf());
assert_eq(crvoice_species(v_alpha), PRANI_SP_WOLF, "build alpha_wolf species Wolf");
assert_eq(crvoice_effective_tract_scale(v_alpha), T_ETS_ALPHA_WOLF, "build alpha_wolf tract_scale 1.68");
assert_eq(crvoice_effective_f0(v_alpha), T_EF0_ALPHA_WOLF, "build alpha_wolf effective_f0 228.57");

var v_pup = preset_build(preset_wolf_pup());
assert_eq(crvoice_species(v_pup), PRANI_SP_WOLF, "build wolf_pup species Wolf");
assert_eq(crvoice_effective_tract_scale(v_pup), T_ETS_WOLF_PUP, "build wolf_pup tract_scale 0.48");
assert_eq(crvoice_effective_f0(v_pup), T_EF0_WOLF_PUP, "build wolf_pup effective_f0 clamp 1200");

var v_cat = preset_build(preset_house_cat());
assert_eq(crvoice_species(v_cat), PRANI_SP_CAT, "build house_cat species Cat");
assert_eq(crvoice_effective_tract_scale(v_cat), T_ETS_HOUSE_CAT, "build house_cat tract_scale 0.5");
assert_eq(crvoice_effective_f0(v_cat), T_EF0_HOUSE_CAT, "build house_cat effective_f0 500");

var v_kit = preset_build(preset_kitten());
assert_eq(crvoice_species(v_kit), PRANI_SP_CAT, "build kitten species Cat");
assert_eq(crvoice_effective_tract_scale(v_kit), T_ETS_KITTEN, "build kitten tract_scale 0.2");
assert_eq(crvoice_effective_f0(v_kit), T_EF0_KITTEN, "build kitten effective_f0 clamp 1000");

var v_lion = preset_build(preset_male_lion());
assert_eq(crvoice_species(v_lion), PRANI_SP_LION, "build male_lion species Lion");
assert_eq(crvoice_effective_tract_scale(v_lion), T_ETS_MALE_LION, "build male_lion tract_scale 2.6");
assert_eq(crvoice_effective_f0(v_lion), T_EF0_MALE_LION, "build male_lion effective_f0 50");

var v_anc = preset_build(preset_ancient_dragon());
assert_eq(crvoice_species(v_anc), PRANI_SP_DRAGON, "build ancient_dragon species Dragon");
assert_eq(crvoice_effective_tract_scale(v_anc), T_ETS_ANC_DRAGON, "build ancient_dragon tract_scale 12.0");
assert_eq(crvoice_effective_f0(v_anc), T_EF0_ANC_DRAGON, "build ancient_dragon effective_f0 clamp 30");

var v_yng = preset_build(preset_young_dragon());
assert_eq(crvoice_species(v_yng), PRANI_SP_DRAGON, "build young_dragon species Dragon");
assert_eq(crvoice_effective_tract_scale(v_yng), T_ETS_YNG_DRAGON, "build young_dragon tract_scale 2.4");
assert_eq(crvoice_effective_f0(v_yng), T_EF0_YNG_DRAGON, "build young_dragon effective_f0 150");

var v_eagle = preset_build(preset_bald_eagle());
assert_eq(crvoice_species(v_eagle), PRANI_SP_RAPTOR, "build bald_eagle species Raptor");
assert_eq(crvoice_effective_tract_scale(v_eagle), T_ETS_BALD_EAGLE, "build bald_eagle tract_scale 0.24");
assert_eq(crvoice_effective_f0(v_eagle), T_EF0_BALD_EAGLE, "build bald_eagle effective_f0 clamp 2000");

var v_raven = preset_build(preset_raven());
assert_eq(crvoice_species(v_raven), PRANI_SP_CROW, "build raven species Crow");
assert_eq(crvoice_effective_tract_scale(v_raven), T_ETS_RAVEN, "build raven tract_scale 0.39");
assert_eq(crvoice_effective_f0(v_raven), T_EF0_RAVEN, "build raven effective_f0 538.46");

var v_cricket = preset_build(preset_field_cricket());
assert_eq(crvoice_species(v_cricket), PRANI_SP_CRICKET, "build field_cricket species Cricket");
assert_eq(crvoice_effective_tract_scale(v_cricket), T_ETS_CRICKET, "build field_cricket tract_scale 0.05");
assert_eq(crvoice_effective_f0(v_cricket), T_EF0_CRICKET, "build field_cricket effective_f0 4500");

var v_gator = preset_build(preset_alligator());
assert_eq(crvoice_species(v_gator), PRANI_SP_CROCODILIAN, "build alligator species Crocodilian");
assert_eq(crvoice_effective_tract_scale(v_gator), T_ETS_ALLIGATOR, "build alligator tract_scale 3.75");
assert_eq(crvoice_effective_f0(v_gator), T_EF0_ALLIGATOR, "build alligator effective_f0 33.33");

# ================================================================
test_group("preset_build -- applied breathiness reaches the voice params");
# with_breathiness mutates the voice's params in place; verify the override
# lands (svara-independent). Alpha wolf breathiness 0.03.
assert_eq(SpeciesParams_breathiness(CreatureVoice_params(v_alpha)), T_0_03,
  "build alpha_wolf breathiness override 0.03 in voice params");
# Ancient dragon breathiness 0.25.
assert_eq(SpeciesParams_breathiness(CreatureVoice_params(v_anc)), T_0_25,
  "build ancient_dragon breathiness override 0.25 in voice params");

# ================================================================
# Ports rust-old/tests/integration.rs:567-592 (test_voice_presets), the one
# oracle test that SYNTHESIZES from a preset-built voice -- read it with
# `git show 2.0.3:rust-old/tests/integration.rs` (ADR-0004). Every other suite
# only vocalizes crvoice_new voices, so this is the sole voice-level synthesis
# coverage for Raptor, Crow and Crocodilian, for Cat+Howl (the nasal
# anti-formant and cat formant-transition table), and for Cricket+Chirp.
#
# The oracle asserts finite-only; this is stronger -- non-error, EXACT length
# and a peak-amplitude gate, since an all-zero buffer passes the first three.
test_group("t_max_abs / t_all_finite controls (the gates below can fail)");
var zbuf = vec_new();
var zi = 0;
while (zi < 8) { vec_push(zbuf, 0); zi = zi + 1; }
assert_eq(t_all_finite(zbuf), 1, "control: all-zero buffer IS all-finite");
assert_eq(vec_len(zbuf), 8, "control: all-zero buffer has the expected length");
assert_eq(f64_gt(t_max_abs(zbuf), T_0_001), 0, "control: all-zero buffer FAILS the peak gate");
vec_set(zbuf, 3, T_1_0);
assert_eq(f64_gt(t_max_abs(zbuf), T_0_001), 1, "control: t_max_abs sees a +1.0 sample");
vec_set(zbuf, 3, f64_neg(T_1_0));
assert_eq(f64_gt(t_max_abs(zbuf), T_0_001), 1, "control: t_max_abs sees a -1.0 sample (abs)");
vec_set(zbuf, 3, 0);
vec_set(zbuf, 5, T_NAN);
assert_eq(t_all_finite(zbuf), 0, "control: t_all_finite rejects NaN");
vec_set(zbuf, 5, T_INF);
assert_eq(t_all_finite(zbuf), 0, "control: t_all_finite rejects +inf");

# ================================================================
test_group("preset_build -- every preset synthesizes (oracle test_voice_presets)");
# The chain's two outcomes, pinned so the loop below cannot silently degenerate
# to one vocalization: Laryngeal/Syringeal species take Howl at the first arm,
# Stridulatory Cricket rejects Howl/Roar/Growl and falls through to Chirp.
assert_eq(t_preset_voc(PRANI_SP_WOLF), PRANI_VOC_HOWL, "chain picks Howl for Wolf");
assert_eq(t_preset_voc(PRANI_SP_CRICKET), PRANI_VOC_CHIRP, "chain picks Chirp for Cricket");

var n_presets = vec_len(all);
assert_eq(n_presets, 11, "synthesis loop is over all 11 presets (non-vacuous)");

# Per-property failure bitmasks over the preset index, so a failure names the
# preset rather than just the property. `bit` doubles once per iteration.
var f_err = 0;
var f_len = 0;
var f_fin = 0;
var f_amp = 0;
var n_ok = 0;
var n_howl = 0;
var n_chirp = 0;
var bit = 1;
var pi = 0;
while (pi < n_presets) {
    var pp = vec_get(all, pi);
    var voc = t_preset_voc(VoicePreset_species(pp));
    if (voc == PRANI_VOC_HOWL) { n_howl = n_howl + 1; }
    if (voc == PRANI_VOC_CHIRP) { n_chirp = n_chirp + 1; }
    var buf = crvoice_vocalize(preset_build(pp), voc, T_SR, T_0_3);
    var bad = 0;
    if (prani_is_err(buf) == 1) {
        f_err = f_err + bit;
        bad = 1;
    } else {
        if (vec_len(buf) != 13230) { f_len = f_len + bit; bad = 1; }
        if (t_all_finite(buf) != 1) { f_fin = f_fin + bit; bad = 1; }
        if (f64_gt(t_max_abs(buf), T_0_001) == 0) { f_amp = f_amp + bit; bad = 1; }
    }
    if (bad == 0) { n_ok = n_ok + 1; }
    bit = bit + bit;
    pi = pi + 1;
}
assert_eq(f_err, 0, "every preset vocalizes without error (bitmask of preset indices)");
# Idle duration_scale is 1.0, so num_samples = (0.3 * 44100) as usize = 13230.
assert_eq(f_len, 0, "every preset yields exactly 13230 samples (bitmask)");
assert_eq(f_fin, 0, "every preset yields all-finite samples (bitmask)");
assert_eq(f_amp, 0, "every preset yields peak |s| > 0.001, not silence (bitmask)");
assert_eq(n_howl, 10, "10 presets took the Howl arm");
assert_eq(n_chirp, 1, "Field Cricket took the Chirp arm");
assert_eq(n_ok, 11, "all 11 presets synthesized and passed all four gates");

# ================================================================
# serde roundtrip (restores the Rust #[derive(Serialize, Deserialize)] on
# VoicePreset — name string + scalars, via bayan's value tree).
test_group("VoicePreset serde roundtrip");
var pre = preset_alpha_wolf();
var sbp = str_builder_new();
preset_to_json(pre, sbp);
var jstr = str_data(str_builder_build(sbp));
var pre2 = preset_from_json_str(jstr);
assert_eq(memeq(VoicePreset_name(pre2), "Alpha Wolf", 10), 1, "name string roundtrips");
assert_eq(VoicePreset_species(pre2), PRANI_SP_WOLF, "species roundtrips");
assert_eq(VoicePreset_size(pre2), VoicePreset_size(pre), "size roundtrips");
assert_eq(VoicePreset_f0_offset(pre2), VoicePreset_f0_offset(pre), "f0_offset roundtrips");
assert_eq(VoicePreset_breathiness(pre2), VoicePreset_breathiness(pre), "breathiness roundtrips");
var sbp2 = str_builder_new();
preset_to_json(pre2, sbp2);
# length first: memeq over strlen() is a PREFIX compare, so a re-serialization
# that APPENDED a field would pass it. The oracle compared whole strings.
var jstr_2 = str_data(str_builder_build(sbp2));
assert_eq(strlen(jstr_2), strlen(jstr), "json idempotent -- same length");
assert_eq(memeq(jstr, jstr_2, strlen(jstr)), 1, "json idempotent");

# ================================================================
# 2.0.5 -- input-range validation. preset_from_json_str is the ONLY entry point
# in this module with an error channel: ADR-0002 gave it one for parse failures,
# and this is the field-level half that ADR left open. Each document below is a
# valid preset with exactly ONE defect, so a rejection names that defect, and
# every rejection is paired with an accepted control so the guards cannot pass
# by rejecting everything.
#
# The scalars are f64 BIT PATTERNS on the wire, so a valid size of 1.0 is the
# literal 4607182418800017408 and a valid f0_offset / breathiness of 0.0 is 0.
var T_D_GARBAGE = "not json at all";
var T_D_EMPTY   = "{}";
var T_D_ARRAY   = "[1,2,3]";
var T_D_NO_NAME = "{\"species\":0,\"size\":4607182418800017408,\"f0_offset\":0,\"breathiness\":0}";
var T_D_NAME_I  = "{\"name\":7,\"species\":0,\"size\":4607182418800017408,\"f0_offset\":0,\"breathiness\":0}";
var T_D_NAME_N  = "{\"name\":null,\"species\":0,\"size\":4607182418800017408,\"f0_offset\":0,\"breathiness\":0}";
var T_D_SP_STR  = "{\"name\":\"P\",\"species\":\"W\",\"size\":4607182418800017408,\"f0_offset\":0,\"breathiness\":0}";
var T_D_NO_SP   = "{\"name\":\"P\",\"size\":4607182418800017408,\"f0_offset\":0,\"breathiness\":0}";
var T_D_NO_SIZE = "{\"name\":\"P\",\"species\":0,\"f0_offset\":0,\"breathiness\":0}";
var T_D_NO_F0   = "{\"name\":\"P\",\"species\":0,\"size\":4607182418800017408,\"breathiness\":0}";
var T_D_NO_BR   = "{\"name\":\"P\",\"species\":0,\"size\":4607182418800017408,\"f0_offset\":0}";

test_group("preset_from_json_str -- malformed documents rejected, never dereferenced");
assert_eq(prani_is_err(preset_from_json_str(0)), 1, "null json rejected (2.0.3)");
assert_eq(prani_is_err(preset_from_json_str(T_D_GARBAGE)), 1, "unparseable json rejected (2.0.3)");
assert_eq(prani_is_err(preset_from_json_str(T_D_EMPTY)), 1, "{} rejected -- no fields at all");
# The next three were a LIVE SIGSEGV before 2.0.5, not a range question:
# bayan_json_v_obj_get returns 0 for a missing key, bayan_json_v_str returns 0
# for a non-string node, and str_data(0) dereferences address 0. Measured
# 2026-08-31 on 2.0.4: T_D_NO_NAME exits 139.
assert_eq(prani_is_err(preset_from_json_str(T_D_NO_NAME)), 1, "missing name rejected (was SIGSEGV: exit 139)");
assert_eq(prani_is_err(preset_from_json_str(T_D_NAME_I)), 1, "integer name rejected (v_str -> 0, was SIGSEGV)");
assert_eq(prani_is_err(preset_from_json_str(T_D_NAME_N)), 1, "null name rejected (v_str -> 0, was SIGSEGV)");
assert_eq(prani_is_err(preset_from_json_str(T_D_ARRAY)), 1, "array root rejected (obj_get -> 0, was SIGSEGV)");
# A missing scalar and a wrong-typed scalar are one rejection: obj_get gives 0
# for both and bayan_json_v_is_int(0) is 0. Reading with bayan_json_v_int alone
# could not tell an absent field from a present 0 -- and 0 is a legal bit
# pattern (+0.0) for f0_offset and breathiness, so those two silently defaulted.
assert_eq(prani_is_err(preset_from_json_str(T_D_NO_SP)), 1, "missing species rejected (silently read as Wolf before)");
assert_eq(prani_is_err(preset_from_json_str(T_D_SP_STR)), 1, "non-integer species rejected");
assert_eq(prani_is_err(preset_from_json_str(T_D_NO_SIZE)), 1, "missing size rejected");
assert_eq(prani_is_err(preset_from_json_str(T_D_NO_F0)), 1, "missing f0_offset rejected (silently 0.0 before)");
assert_eq(prani_is_err(preset_from_json_str(T_D_NO_BR)), 1, "missing breathiness rejected (silently 0.0 before)");
# Control: the same shape with every field present and in range is ACCEPTED.
var d_ok = preset_from_json_str(t_pj(PRANI_SP_WOLF, T_1_0, 0, 0));
assert_eq(prani_is_err(d_ok), 0, "control: a complete, in-range document is accepted");
assert_eq(VoicePreset_species(d_ok), PRANI_SP_WOLF, "control: species read back");
assert_eq(VoicePreset_size(d_ok), T_1_0, "control: size read back as the exact bit pattern");
assert_eq(memeq(VoicePreset_name(d_ok), "Probe", 5), 1, "control: name read back");

test_group("preset_from_json_str -- species range [0, PRANI_SP_COUNT)");
# A discriminant, not a measurement. Outside the enum, species_params falls
# THROUGH to the Fantasy row (measured: species 999 -> f0_min 50), so an
# unnamed species used to come back as a plausible creature instead of an error.
# The oracle's serde rejected an unknown Species variant too.
assert_eq(t_pj_err((0 - 1), T_1_0, 0, 0), 1, "species -1 rejected");
assert_eq(t_pj_err(PRANI_SP_COUNT, T_1_0, 0, 0), 1, "species 13 (one past the last) rejected");
assert_eq(t_pj_err(999, T_1_0, 0, 0), 1, "species 999 rejected (Fantasy fallthrough closed)");
assert_eq(t_pj_err(PRANI_SP_WOLF, T_1_0, 0, 0), 0, "control: species 0 (Wolf, the first) accepted");
assert_eq(t_pj_err(PRANI_SP_FANTASY, T_1_0, 0, 0), 0, "control: species 12 (Fantasy, the last) accepted");

test_group("preset_from_json_str -- size range [0.1, 10.0] (with_size's clamp domain)");
# NaN is the hazard the range exists for: f64_clamp(NaN, lo, hi) -> NaN, so a
# NaN size passes every clamp in the chain untouched (audit F11) and reaches
# svara. Outside the range but finite, the builder would silently substitute
# the clamp bound -- a fabricated answer (ADR-0001).
assert_eq(t_pj_err(PRANI_SP_WOLF, T_NAN, 0, 0), 1, "size NaN rejected (F11: NaN passes f64_clamp)");
assert_eq(t_pj_err(PRANI_SP_WOLF, T_INF, 0, 0), 1, "size +inf rejected");
assert_eq(t_pj_err(PRANI_SP_WOLF, T_NEG_INF, 0, 0), 1, "size -inf rejected");
assert_eq(t_pj_err(PRANI_SP_WOLF, 0, 0, 0), 1, "size 0.0 rejected (effective_f0 divides by size)");
assert_eq(t_pj_err(PRANI_SP_WOLF, T_0_05, 0, 0), 1, "size 0.05 rejected (under the 0.1 floor)");
assert_eq(t_pj_err(PRANI_SP_WOLF, f64_from(11), 0, 0), 1, "size 11.0 rejected (over the 10.0 ceiling)");
assert_eq(t_pj_err(PRANI_SP_WOLF, T_0_1, 0, 0), 0, "control: size 0.1 (the floor) accepted");
assert_eq(t_pj_err(PRANI_SP_WOLF, f64_from(10), 0, 0), 0, "control: size 10.0 (the ceiling) accepted");
assert_eq(t_pj_err(PRANI_SP_WOLF, T_4_0, 0, 0), 0, "control: size 4.0 (Ancient Dragon's) accepted");

test_group("preset_from_json_str -- f0_offset range +/-(f0_max - f0_min), per species");
# with_f0_offset's clamp is species-dependent, so this bound is too: Wolf spans
# 1200-150 = 1050 Hz, Cricket spans 8000-3000 = 5000 Hz. The same offset is
# legal for one and not the other -- that asymmetry is the point, and it is why
# the bound is read from the declared species rather than being a constant.
assert_eq(t_pj_err(PRANI_SP_WOLF, T_1_0, T_NAN, 0), 1, "f0_offset NaN rejected");
assert_eq(t_pj_err(PRANI_SP_WOLF, T_1_0, T_INF, 0), 1, "f0_offset +inf rejected");
assert_eq(t_pj_err(PRANI_SP_WOLF, T_1_0, T_NEG_INF, 0), 1, "f0_offset -inf rejected");
assert_eq(t_pj_err(PRANI_SP_WOLF, T_1_0, f64_from(1051), 0), 1, "f0_offset +1051 rejected for Wolf (span 1050)");
assert_eq(t_pj_err(PRANI_SP_WOLF, T_1_0, f64_neg(f64_from(1051)), 0), 1, "f0_offset -1051 rejected for Wolf");
assert_eq(t_pj_err(PRANI_SP_WOLF, T_1_0, f64_from(3000), 0), 1, "f0_offset +3000 rejected for Wolf");
assert_eq(t_pj_err(PRANI_SP_WOLF, T_1_0, f64_from(1050), 0), 0, "control: +1050 (the bound) ok for Wolf");
assert_eq(t_pj_err(PRANI_SP_WOLF, T_1_0, f64_neg(f64_from(1050)), 0), 0, "control: f0_offset -1050 accepted for Wolf");
assert_eq(t_pj_err(PRANI_SP_CRICKET, T_1_0, f64_from(3000), 0), 0, "control: SAME +3000 ok for Cricket (span 5000)");

test_group("preset_from_json_str -- breathiness range [0.0, 1.0]");
assert_eq(t_pj_err(PRANI_SP_WOLF, T_1_0, 0, T_NAN), 1, "breathiness NaN rejected");
assert_eq(t_pj_err(PRANI_SP_WOLF, T_1_0, 0, T_INF), 1, "breathiness +inf rejected");
assert_eq(t_pj_err(PRANI_SP_WOLF, T_1_0, 0, f64_neg(T_0_1)), 1, "breathiness -0.1 rejected");
assert_eq(t_pj_err(PRANI_SP_WOLF, T_1_0, 0, T_1_5), 1, "breathiness 1.5 rejected");
assert_eq(t_pj_err(PRANI_SP_WOLF, T_1_0, 0, 0), 0, "control: breathiness 0.0 (the floor) accepted");
assert_eq(t_pj_err(PRANI_SP_WOLF, T_1_0, 0, T_1_0), 0, "control: breathiness 1.0 (the ceiling) accepted");

test_group("preset_from_json_str -- prani's own output always roundtrips");
# The parity guarantee the ranges rest on: the guards can only ever reject a
# document prani did not write. Every built-in preset, serialized and read back,
# must survive with all four scalars bit-identical -- non-vacuous at 11.
var rt_ok = 0;
var rt_eq = 0;
var ri = 0;
while (ri < 11) {
    var p0 = vec_get(all, ri);
    var sbr = str_builder_new();
    preset_to_json(p0, sbr);
    var p1 = preset_from_json_str(str_data(str_builder_build(sbr)));
    if (prani_is_err(p1) == 0) {
        rt_ok = rt_ok + 1;
        if (t_preset_eq(p0, p1) == 1) { rt_eq = rt_eq + 1; }
    }
    ri = ri + 1;
}
assert_eq(rt_ok, 11, "all 11 built-in presets are ACCEPTED by their own codec");
assert_eq(rt_eq, 11, "all 11 roundtrip with every scalar bit-identical");

test_group("preset_make / preset_build -- constructor contract unchanged (2.1.0)");
# Measured, not wished for. preset_make hands back a VoicePreset and nothing
# else -- the same shape as the crvoice_with_* builders it feeds -- so it has no
# channel to report a bad field on, and preset_build is the same. 2.0.5 puts the
# range check where a failure CAN be reported (the codec above) and leaves the
# constructor contract to roadmap 2.1.0; the NaN's remaining path to svara is
# closed downstream at the fallible point of use (crvoice_vocalize / the tract
# constructor). Pinned here so 2.1.0 has to notice it is changing this.
var nanp = preset_make("NaN Probe", PRANI_SP_WOLF, T_NAN, 0, 0);
assert_eq(prani_is_err(nanp), 0, "preset_make still returns a preset for a NaN size");
assert_eq(VoicePreset_size(nanp), T_NAN, "preset_make stores the NaN size verbatim (no clamp, no guard)");
# ...and the codec refuses to produce that same preset from a document.
assert_eq(t_pj_err(PRANI_SP_WOLF, T_NAN, 0, 0), 1, "the codec will not build that preset from JSON");

var rc = assert_summary();
syscall(60, rc);

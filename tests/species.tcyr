# Fantasy is the fallthrough arm of species_bout_template -- assert it explicitly
# so a species added ahead of it cannot silently inherit these values.
var fantasy_bout = species_bout_template(PRANI_SP_FANTASY);
assert_eq(CallBout_vocalization(fantasy_bout), PRANI_VOC_GROWL, "fantasy bout growls");
assert_eq(CallBout_count(fantasy_bout), 3, "fantasy bout count 3");
assert_eq(CallBout_call_duration(fantasy_bout), f64_from(1), "fantasy bout call_duration 1.0");
assert_eq(CallBout_interval(fantasy_bout), f64_from(1), "fantasy bout interval 1.0");
assert_eq(CallBout_intent(fantasy_bout), PRANI_INTENT_IDLE, "fantasy bout idle");

# ================================================================
# The oracle's own invariant (2.0.3:rust-old/tests/integration.rs:638-644):
# every template's vocalization must be one its species can actually produce.
# Failures accumulate into a bitmask so a failure names the offending species.
test_group("bout_template -- every template's vocalization is supported");
var bt_mask = 0;
var bt_seen = 0;
var bt_s = 0;
var bt_b = 0;
while (bt_s < PRANI_SP_COUNT) {
    bt_b = species_bout_template(bt_s);
    if (species_supports_vocalization(bt_s, CallBout_vocalization(bt_b)) == 0) {
        bt_mask = bt_mask | (1 << bt_s);
    }
    bt_seen = bt_seen + 1;
    bt_s = bt_s + 1;
}
assert_eq(bt_seen, 13, "the sweep visited all 13 species");
assert_eq(bt_mask, 0, "no bout template names a vocalization its species rejects");
# control: the same predicate, fed a pair the matrix rejects, DOES set its bit.
var bt_ctrl = 0;
if (species_supports_vocalization(PRANI_SP_CRICKET, PRANI_VOC_ROAR) == 0) {
    bt_ctrl = bt_ctrl | (1 << PRANI_SP_CRICKET);
}
assert_eq(bt_ctrl, 512, "control: an unsupported pair sets its bit (cricket = 1 << 9)");

# ================================================================
# serde roundtrip (ports the Rust #[derive(Serialize, Deserialize)] on
# SpeciesParams — species-preset persistence). Wolf is a representative laryngeal
# preset with a non-default integer apparatus/seed and non-integer f64 fields.
test_group("SpeciesParams serde roundtrip");
var sp = species_params(PRANI_SP_WOLF);
var sb = str_builder_new();
SpeciesParams_to_json(sp, sb);
var jstr = str_data(str_builder_build(sb));
var sp2 = SpeciesParams_from_json_str(jstr);
assert_eq(SpeciesParams_apparatus(sp2), SpeciesParams_apparatus(sp), "apparatus roundtrips");
assert_eq(SpeciesParams_f0_default(sp2), SpeciesParams_f0_default(sp), "f0_default roundtrips");
assert_eq(SpeciesParams_formant0(sp2), SpeciesParams_formant0(sp), "formant0 roundtrips");
assert_eq(SpeciesParams_spectral_tilt(sp2), SpeciesParams_spectral_tilt(sp), "spectral_tilt roundtrips");
assert_eq(SpeciesParams_resonance_seed(sp2), SpeciesParams_resonance_seed(sp), "resonance_seed roundtrips");
var sb2 = str_builder_new();
SpeciesParams_to_json(sp2, sb2);
# length first: memeq over strlen() is a PREFIX compare, so a re-serialization
# that APPENDED a field would pass it. The oracle compared whole strings.
var jstr_2 = str_data(str_builder_build(sb2));
assert_eq(strlen(jstr_2), strlen(jstr), "json idempotent -- same length");
assert_eq(memeq(jstr, jstr_2, strlen(jstr)), 1, "json idempotent");

# ================================================================
# One species per apparatus, asserted against the expected NON-ZERO constant.
# The Wolf case above cannot detect a dropped `apparatus` key: LARYNGEAL is 0 and
# bayan's accessors return 0 for a missing key (ADR-0002), so a derive that
# omitted the field entirely would still pass it. These four are what actually
# prove the field survives the round trip. Ports the oracle's five-variant sweep
# (git show 2.0.3:rust-old/tests/integration.rs, test_serde_roundtrip_vocal_apparatus).
test_group("SpeciesParams serde roundtrip -- one species per apparatus");
var rt_bird = t_sp_roundtrip(PRANI_SP_SONGBIRD);
assert_eq(SpeciesParams_apparatus(rt_bird), PRANI_APP_SYRINGEAL, "songbird apparatus roundtrips (1 syringeal)");
assert_eq(SpeciesParams_f0_default(rt_bird), f64_from(3000), "songbird f0_default roundtrips (3000)");
assert_eq(SpeciesParams_resonance_seed(rt_bird), PR_SEED_SONGBIRD, "songbird resonance_seed roundtrips");
assert_eq(SpeciesParams_apparatus(t_sp_roundtrip(PRANI_SP_CRICKET)), PRANI_APP_STRIDULATORY, "cricket apparatus roundtrips (2 stridulatory)");
assert_eq(SpeciesParams_apparatus(t_sp_roundtrip(PRANI_SP_BEE)), PRANI_APP_VIBRATILE, "bee apparatus roundtrips (3 vibratile)");
assert_eq(SpeciesParams_apparatus(t_sp_roundtrip(PRANI_SP_SNAKE)), PRANI_APP_NOISE_ONLY, "snake apparatus roundtrips (4 noise-only)");
# control: an object with no apparatus key reads back 0 -- the exact reason the
# five assertions above use species whose apparatus discriminant is not 0.
assert_eq(SpeciesParams_apparatus(SpeciesParams_from_json_str("{}")), 0, "control: absent apparatus key reads 0");

# ================================================================
# Roadmap 2.0.5 -- input-range validation. ADR-0002 stopped at the parse
# boundary ("a document that parses but carries nonsense still produces a
# struct"); these groups close that gap for SpeciesParams, which is the ONE
# struct reachable from BOTH hostile deserializer entry points
# (crvoice_from_json_str and crtract_from_json_str embed it as a sub-object).
#
# Every group below asserts the acceptance side too: the guard is only correct if
# it lets through everything prani itself writes.
test_group("2.0.5 range guard -- the whole 13-row table is accepted");
var vg_mask = 0;
var vg_seen = 0;
var vg_s = 0;
while (vg_s < PRANI_SP_COUNT) {
    if (prani_is_err(species_params_validate(species_params(vg_s))) == 1) {
        vg_mask = vg_mask | (1 << vg_s);
    }
    vg_seen = vg_seen + 1;
    vg_s = vg_s + 1;
}
assert_eq(vg_seen, 13, "the sweep visited all 13 species");
assert_eq(vg_mask, 0, "no species' own params are rejected by the guard");
# control: the same predicate DOES reject a table row with one field corrupted --
# without this, a validator that returned PRANI_ERR_NONE unconditionally passes.
var vg_ctrl = species_params(PRANI_SP_WOLF);
SpeciesParams_set_tract_scale(vg_ctrl, T_NAN);
assert_eq(prani_is_err(species_params_validate(vg_ctrl)), 1, "control: a NaN tract_scale IS rejected");

# ================================================================
# apparatus is an enum in the oracle, so serde rejected an unknown variant
# outright; the port stores it as a plain i64 that bayan will hand back for any
# integer in the document. Range is the five declared discriminants, 0..4.
test_group("2.0.5 range guard -- apparatus is one of the five discriminants");
var ap_ok = species_params(PRANI_SP_SNAKE);
assert_eq(prani_is_err(species_params_validate(ap_ok)), 0, "apparatus 4 (NOISE_ONLY) accepted -- upper boundary");
var ap_hi = species_params(PRANI_SP_WOLF);
SpeciesParams_set_apparatus(ap_hi, 5);
assert_eq(prani_is_err(species_params_validate(ap_hi)), 1, "apparatus 5 rejected (one past NOISE_ONLY)");
var ap_lo = species_params(PRANI_SP_WOLF);
SpeciesParams_set_apparatus(ap_lo, (0 - 1));
assert_eq(prani_is_err(species_params_validate(ap_lo)), 1, "apparatus -1 rejected");

# ================================================================
# f0_min/f0_max/f0_default: finite, [0, 20000] Hz, and ORDERED. The ordering is a
# guard in its own right, and the two pins below are why.
test_group("2.0.5 range guard -- f0 is finite, non-negative and ordered");
var f0_w = species_params(PRANI_SP_WOLF);
# MEASURED, 2026-08-31 -- the two facts the f0 guard rests on.
assert_eq(prani_is_finite(f64_clamp(T_NAN, SpeciesParams_f0_min(f0_w), SpeciesParams_f0_max(f0_w))), 0,
  "pin: NaN survives the species' own f0 clamp (F11)");
assert_eq(f64_clamp(f64_from(300), f64_from(1200), f64_from(150)), f64_from(1200),
  "pin: f64_clamp with lo > hi silently returns LO (the oracle's f32::clamp panics)");
assert_eq(prani_is_err(species_params_validate(species_params(PRANI_SP_SNAKE))), 0,
  "f0 0/0/0 accepted -- the snake ships it, and the oracle's zero-duration rule says 0 is data");
var f0_nan = species_params(PRANI_SP_WOLF);
SpeciesParams_set_f0_min(f0_nan, T_NAN);
assert_eq(prani_is_err(species_params_validate(f0_nan)), 1, "NaN f0_min rejected");
var f0_neg = species_params(PRANI_SP_WOLF);
SpeciesParams_set_f0_min(f0_neg, f64_neg(f64_from(1)));
assert_eq(prani_is_err(species_params_validate(f0_neg)), 1, "negative f0_min rejected");
var f0_inf = species_params(PRANI_SP_WOLF);
SpeciesParams_set_f0_max(f0_inf, PRANI_POS_INF);
assert_eq(prani_is_err(species_params_validate(f0_inf)), 1, "+inf f0_max rejected");
var f0_top = species_params(PRANI_SP_WOLF);
SpeciesParams_set_f0_max(f0_top, T_20000_0);
assert_eq(prani_is_err(species_params_validate(f0_top)), 0, "f0_max 20000 accepted -- upper boundary");
var f0_over = species_params(PRANI_SP_WOLF);
SpeciesParams_set_f0_max(f0_over, f64_from(20001));
assert_eq(prani_is_err(species_params_validate(f0_over)), 1, "f0_max 20001 rejected");
var f0_inv = species_params(PRANI_SP_WOLF);
SpeciesParams_set_f0_min(f0_inv, f64_from(1300));
assert_eq(prani_is_err(species_params_validate(f0_inv)), 1, "f0_min > f0_max rejected");
var f0_def = species_params(PRANI_SP_WOLF);
SpeciesParams_set_f0_default(f0_def, f64_from(1300));
assert_eq(prani_is_err(species_params_validate(f0_def)), 1, "f0_default above f0_max rejected");

# ================================================================
# tract_scale: strictly positive. 0 is not a small tract, it is no tract, and it
# is what an ABSENT key deserializes to (bayan's accessors are null-safe).
test_group("2.0.5 range guard -- tract_scale is strictly positive and bounded");
var ts_zero = species_params(PRANI_SP_WOLF);
SpeciesParams_set_tract_scale(ts_zero, 0);
assert_eq(prani_is_err(species_params_validate(ts_zero)), 1, "tract_scale 0.0 rejected");
var ts_neg = species_params(PRANI_SP_WOLF);
SpeciesParams_set_tract_scale(ts_neg, f64_neg(T_1_0));
assert_eq(prani_is_err(species_params_validate(ts_neg)), 1, "negative tract_scale rejected");
var ts_inf = species_params(PRANI_SP_WOLF);
SpeciesParams_set_tract_scale(ts_inf, PRANI_POS_INF);
assert_eq(prani_is_err(species_params_validate(ts_inf)), 1, "+inf tract_scale rejected");
var ts_top = species_params(PRANI_SP_WOLF);
SpeciesParams_set_tract_scale(ts_top, T_100_0);
assert_eq(prani_is_err(species_params_validate(ts_top)), 0, "tract_scale 100.0 accepted -- upper boundary");
var ts_over = species_params(PRANI_SP_WOLF);
SpeciesParams_set_tract_scale(ts_over, f64_from(101));
assert_eq(prani_is_err(species_params_validate(ts_over)), 1, "tract_scale 101.0 rejected");

# ================================================================
# formants and bandwidths are resonances of that same tube. A 0 Hz formant is not
# a resonance, and a 0 Hz bandwidth is an infinite-Q (unstable) pole.
test_group("2.0.5 range guard -- formants and bandwidths");
var fm_zero = species_params(PRANI_SP_WOLF);
SpeciesParams_set_formant0(fm_zero, 0);
assert_eq(prani_is_err(species_params_validate(fm_zero)), 1, "formant0 0 Hz rejected");
var fm_nan = species_params(PRANI_SP_WOLF);
SpeciesParams_set_formant1(fm_nan, T_NAN);
assert_eq(prani_is_err(species_params_validate(fm_nan)), 1, "NaN formant1 rejected");
var fm_over = species_params(PRANI_SP_WOLF);
SpeciesParams_set_formant2(fm_over, f64_from(20001));
assert_eq(prani_is_err(species_params_validate(fm_over)), 1, "formant2 20001 Hz rejected");
assert_eq(prani_is_err(species_params_validate(species_params(PRANI_SP_CRICKET))), 0,
  "cricket F3 13500 Hz accepted -- the widest formant prani ships");
var bw_zero = species_params(PRANI_SP_WOLF);
SpeciesParams_set_bandwidth0(bw_zero, 0);
assert_eq(prani_is_err(species_params_validate(bw_zero)), 1, "bandwidth0 0 Hz rejected (infinite-Q pole)");
var bw_neg = species_params(PRANI_SP_WOLF);
SpeciesParams_set_bandwidth1(bw_neg, f64_neg(f64_from(10)));
assert_eq(prani_is_err(species_params_validate(bw_neg)), 1, "negative bandwidth1 rejected");
var bw_nan = species_params(PRANI_SP_WOLF);
SpeciesParams_set_bandwidth2(bw_nan, T_NAN);
assert_eq(prani_is_err(species_params_validate(bw_nan)), 1, "NaN bandwidth2 rejected");

# ================================================================
# breathiness / jitter / shimmer ranges are the ORACLE'S OWN doc comments
# (git show 2.0.3:rust-old/src/species.rs -- "(0.0-1.0)", "(0.0-0.05)",
# "(0.0-0.1)"), and each ceiling is exactly where the matching crvoice_with_*
# builder clamps, so a builder-set value is accepted by construction.
test_group("2.0.5 range guard -- breathiness / jitter / shimmer, the oracle's ranges");
var br_one = species_params(PRANI_SP_WOLF);
SpeciesParams_set_breathiness(br_one, T_1_0);
assert_eq(prani_is_err(species_params_validate(br_one)), 0, "breathiness 1.0 accepted -- the snake ships it");
var br_over = species_params(PRANI_SP_WOLF);
SpeciesParams_set_breathiness(br_over, f64_from(2));
assert_eq(prani_is_err(species_params_validate(br_over)), 1, "breathiness 2.0 rejected");
var br_neg = species_params(PRANI_SP_WOLF);
SpeciesParams_set_breathiness(br_neg, f64_neg(T_1_0));
assert_eq(prani_is_err(species_params_validate(br_neg)), 1, "negative breathiness rejected");
var br_nan = species_params(PRANI_SP_WOLF);
SpeciesParams_set_breathiness(br_nan, T_NAN);
assert_eq(prani_is_err(species_params_validate(br_nan)), 1, "NaN breathiness rejected");
var ji_top = species_params(PRANI_SP_WOLF);
SpeciesParams_set_jitter(ji_top, T_0_05);
assert_eq(prani_is_err(species_params_validate(ji_top)), 0, "jitter 0.05 accepted -- the with_jitter clamp ceiling");
var ji_over = species_params(PRANI_SP_WOLF);
SpeciesParams_set_jitter(ji_over, T_0_06);
assert_eq(prani_is_err(species_params_validate(ji_over)), 1, "jitter 0.06 rejected");
var sh_top = species_params(PRANI_SP_WOLF);
SpeciesParams_set_shimmer(sh_top, T_0_1);
assert_eq(prani_is_err(species_params_validate(sh_top)), 0, "shimmer 0.1 accepted -- the with_shimmer clamp ceiling");
var sh_over = species_params(PRANI_SP_WOLF);
SpeciesParams_set_shimmer(sh_over, T_0_2);
assert_eq(prani_is_err(species_params_validate(sh_over)), 1, "shimmer 0.2 rejected");

# ================================================================
# Two fields are deliberately NOT magnitude-bounded, and both need a test saying
# so -- otherwise a later tightening looks like a bug fix rather than a change.
test_group("2.0.5 range guard -- spectral_tilt is finite-only, resonance_seed is unchecked");
var st_nan = species_params(PRANI_SP_WOLF);
SpeciesParams_set_spectral_tilt(st_nan, T_NAN);
assert_eq(prani_is_err(species_params_validate(st_nan)), 1, "NaN spectral_tilt rejected");
var st_inf = species_params(PRANI_SP_WOLF);
SpeciesParams_set_spectral_tilt(st_inf, PRANI_NEG_INF);
assert_eq(prani_is_err(species_params_validate(st_inf)), 1, "-inf spectral_tilt rejected");
var st_big = species_params(PRANI_SP_WOLF);
SpeciesParams_set_spectral_tilt(st_big, T_NEG_1E300);
assert_eq(prani_is_err(species_params_validate(st_big)), 0,
  "-1e300 spectral_tilt ACCEPTED -- apply_spectral_tilt already clamps -tilt/12 into [0, 0.85]");
var sd_min = species_params(PRANI_SP_WOLF);
SpeciesParams_set_resonance_seed(sd_min, T_I64_MIN);
assert_eq(prani_is_err(species_params_validate(sd_min)), 0, "resonance_seed i64::MIN accepted -- every seed is legal");
var sd_neg = species_params(PRANI_SP_WOLF);
SpeciesParams_set_resonance_seed(sd_neg, (0 - 1));
assert_eq(prani_is_err(species_params_validate(sd_neg)), 0, "resonance_seed -1 accepted (the table carries negatives)");

# ================================================================
# The deserializer path itself. species_params_from_node is what a hostile
# document actually reaches, via crvoice_from_json_str and crtract_from_json_str.
test_group("2.0.5 species_params_from_node reports instead of fabricating");
var nd_ok = t_sp_via_node(species_params(PRANI_SP_WOLF));
assert_eq(prani_is_err(nd_ok), 0, "a document prani wrote is NOT rejected");
assert_eq(SpeciesParams_tract_scale(nd_ok), PR_TS_1_2, "and it still roundtrips tract_scale 1.2 exactly");
assert_eq(SpeciesParams_resonance_seed(nd_ok), PR_SEED_WOLF, "and resonance_seed exactly");
assert_eq(prani_is_err(t_sp_via_node(species_params(PRANI_SP_SNAKE))), 0,
  "the snake's all-zero f0 document is NOT rejected");
# An absent `params` key hands from_node a null node; every field then reads back
# 0 (bayan's accessors are null-safe), which is tract_scale 0.0 -- no tract.
assert_eq(prani_is_err(species_params_from_node(0)), 1, "a null node (absent \"params\" key) -> error");
var nd_empty = bayan_json_v_parse_buf("{}", 2);
assert_eq(prani_is_err(species_params_from_node(nd_empty)), 1, "an empty object -> error, not an all-zero struct");
assert_eq(species_params_from_node(nd_empty), PRANI_ERR_INVALID_SPECIES, "and the code is INVALID_SPECIES");
var nd_nan = species_params(PRANI_SP_WOLF);
SpeciesParams_set_tract_scale(nd_nan, T_NAN);
assert_eq(prani_is_err(t_sp_via_node(nd_nan)), 1, "a document with a NaN tract_scale -> error");
var nd_inv = species_params(PRANI_SP_WOLF);
SpeciesParams_set_f0_min(nd_inv, f64_from(1300));
assert_eq(prani_is_err(t_sp_via_node(nd_inv)), 1, "a document with f0_min > f0_max -> error");
# from_node's failure is a negative code, so a caller that forwards it into
# species_params_validate must not dereference it. Pinning that keeps the
# two-call-site contract (voice.cyr, tract.cyr) safe to write either way round.
assert_eq(species_params_validate(species_params_from_node(0)), PRANI_ERR_INVALID_SPECIES,
  "validate(from_node(...)) rejects a negative pointer instead of dereferencing it");

var rc = assert_summary();
syscall(60, rc);

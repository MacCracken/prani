# ================================================================
test_group("resonance_seed -- precomputed f32-bit-pattern parity");
assert_eq(species_params_resonance_seed(species_params(PRANI_SP_WOLF)), PR_SEED_WOLF, "wolf seed");
assert_eq(species_params_resonance_seed(wolf), 2180968338894094337, "wolf seed literal");
assert_eq(species_params_resonance_seed(species_params(PRANI_SP_SONGBIRD)), 3639187878752649217, "songbird seed literal");
assert_eq(species_params_resonance_seed(species_params(PRANI_SP_DOG)), (0 - 4557473707297210367), "dog seed literal (negative)");

# ================================================================
test_group("supports_vocalization matrix");
# Snake (noise-only): hisses + growls, but cannot howl.
assert_eq(species_supports_vocalization(PRANI_SP_SNAKE, PRANI_VOC_HISS), 1, "snake hisses");
assert_eq(species_supports_vocalization(PRANI_SP_SNAKE, PRANI_VOC_GROWL), 1, "snake growls");
assert_eq(species_supports_vocalization(PRANI_SP_SNAKE, PRANI_VOC_HOWL), 0, "snake cannot howl");
# Cricket (stridulatory): stridulate + buzz + chirp, but cannot roar.
assert_eq(species_supports_vocalization(PRANI_SP_CRICKET, PRANI_VOC_STRIDULATE), 1, "cricket stridulates");
assert_eq(species_supports_vocalization(PRANI_SP_CRICKET, PRANI_VOC_CHIRP), 1, "cricket chirps");
assert_eq(species_supports_vocalization(PRANI_SP_CRICKET, PRANI_VOC_BUZZ), 1, "cricket buzzes");
assert_eq(species_supports_vocalization(PRANI_SP_CRICKET, PRANI_VOC_ROAR), 0, "cricket cannot roar");
# Wolf (laryngeal): howls + growls, but cannot buzz/stridulate.
assert_eq(species_supports_vocalization(PRANI_SP_WOLF, PRANI_VOC_HOWL), 1, "wolf howls");
assert_eq(species_supports_vocalization(PRANI_SP_WOLF, PRANI_VOC_GROWL), 1, "wolf growls");
assert_eq(species_supports_vocalization(PRANI_SP_WOLF, PRANI_VOC_BUZZ), 0, "wolf cannot buzz");
assert_eq(species_supports_vocalization(PRANI_SP_WOLF, PRANI_VOC_STRIDULATE), 0, "wolf cannot stridulate");
# Bee (vibratile): buzz + chirp only.
assert_eq(species_supports_vocalization(PRANI_SP_BEE, PRANI_VOC_BUZZ), 1, "bee buzzes");
assert_eq(species_supports_vocalization(PRANI_SP_BEE, PRANI_VOC_CHIRP), 1, "bee chirps");
assert_eq(species_supports_vocalization(PRANI_SP_BEE, PRANI_VOC_HISS), 0, "bee cannot hiss");

# ================================================================
# All five fields of all 13 templates, transcribed from the oracle's match arms
# (git show 2.0.3:rust-old/src/species.rs). `interval` was previously asserted
# for no species at all, so a template that dropped or transposed it passed.
test_group("bout_template -- Wolf / Dog / Lion");
var wolf_bout = species_bout_template(PRANI_SP_WOLF);
assert_eq(CallBout_vocalization(wolf_bout), PRANI_VOC_HOWL, "wolf bout howls");
assert_eq(CallBout_count(wolf_bout), 3, "wolf bout count 3");
assert_eq(CallBout_call_duration(wolf_bout), f64_from(3), "wolf bout call_duration 3.0");
assert_eq(CallBout_interval(wolf_bout), f64_from(2), "wolf bout interval 2.0");
assert_eq(CallBout_intent(wolf_bout), PRANI_INTENT_SOCIAL, "wolf bout social");

var dog_bout = species_bout_template(PRANI_SP_DOG);
assert_eq(CallBout_vocalization(dog_bout), PRANI_VOC_BARK, "dog bout barks");
assert_eq(CallBout_count(dog_bout), 5, "dog bout count 5");
assert_eq(CallBout_call_duration(dog_bout), T_0_15, "dog bout call_duration 0.15");
assert_eq(CallBout_interval(dog_bout), T_0_25, "dog bout interval 0.25");
assert_eq(CallBout_intent(dog_bout), PRANI_INTENT_ALARM, "dog bout alarm");

var lion_bout = species_bout_template(PRANI_SP_LION);
assert_eq(CallBout_vocalization(lion_bout), PRANI_VOC_ROAR, "lion bout roars");
assert_eq(CallBout_count(lion_bout), 4, "lion bout count 4");
assert_eq(CallBout_call_duration(lion_bout), f64_from(2), "lion bout call_duration 2.0");
assert_eq(CallBout_interval(lion_bout), T_1_5, "lion bout interval 1.5");
assert_eq(CallBout_intent(lion_bout), PRANI_INTENT_TERRITORIAL, "lion bout territorial");


# species.tcyr -- tests for src/species.cyr.
# rust-old/src/species.rs had no #[test] blocks; parity surface is the enum
# discriminants, the per-species params() lookup, the precomputed resonance_seed
# (f32-bit-pattern parity), the supports_vocalization() bioacoustic matrix, and
# bout_template(). serde/Display tests dropped.
#
# sequence.cyr is included ONLY for the CallBout struct + sequence_call_bout_new
# that species_bout_template uses. sequence's synthesize methods forward-reference
# crvoice_* (voice.cyr, not included here) -- those are UNREACHABLE in this unit,
# so undefined-fn WARNINGS for crvoice_* are EXPECTED and fine (not link errors).

include "src/error.cyr"
include "src/vocalization.cyr"
include "src/sequence.cyr"
include "src/species.cyr"

# ---- test constants (IEEE-754 hex) -----------------------------------------
# The bout-template table's non-integer seconds, transcribed from the oracle's
# own match arms (git show 2.0.3:rust-old/src/species.rs, bout_template). Held
# here rather than reusing src/species.cyr's PR_DUR_*/PR_TS_* so the expected
# values are independent of the constants the implementation happens to name.
var T_0_15 = 0x3fc3333333333333;   # 0.15
var T_0_2  = 0x3fc999999999999a;   # 0.2
var T_0_25 = 0x3fd0000000000000;   # 0.25
var T_0_3  = 0x3fd3333333333333;   # 0.3
var T_0_5  = 0x3fe0000000000000;   # 0.5
var T_0_6  = 0x3fe3333333333333;   # 0.6
var T_0_8  = 0x3fe999999999999a;   # 0.8
var T_1_5  = 0x3ff8000000000000;   # 1.5
var T_2_5  = 0x4004000000000000;   # 2.5

# Range-guard test values (2.0.5). Held here, not reused from src/species.cyr's
# PR_SP_*_MAX, so a boundary assertion cannot pass by agreeing with itself.
var T_NAN     = 0x7ff8000000000000;   # a quiet NaN
var T_1_0     = 0x3ff0000000000000;   # 1.0   breathiness ceiling
var T_0_05    = 0x3fa999999999999a;   # 0.05  jitter ceiling (crvoice_with_jitter clamps here)
var T_0_06    = 0x3faeb851eb851eb8;   # 0.06  one step over the jitter ceiling
var T_0_1     = 0x3fb999999999999a;   # 0.1   shimmer ceiling (crvoice_with_shimmer clamps here)
var T_0_2     = 0x3fc999999999999a;   # 0.2   over the shimmer ceiling
var T_100_0   = 0x4059000000000000;   # 100.0 tract_scale ceiling
var T_20000_0 = 0x40d3880000000000;   # 20000.0 Hz -- f0 / formant / bandwidth ceiling
var T_NEG_1E300 = 0xfe37e43c8800759c; # -1e300 -- huge but FINITE spectral tilt
var T_I64_MIN = (0 - 9223372036854775807) - 1;   # i64::MIN, a legal PCG seed

alloc_init();

# ---- helpers ---------------------------------------------------------------
# t_sp_roundtrip(species) -- species_params -> JSON -> SpeciesParams. Returns the
# DESERIALIZED params so the caller can assert fields against expected values.
#must_use
fn t_sp_roundtrip(species) {
    var b = str_builder_new();
    SpeciesParams_to_json(species_params(species), b);
    return SpeciesParams_from_json_str(str_data(str_builder_build(b)));
}

# t_sp_via_node(p) -- serialize `p` and read it back through the DESERIALIZER
# path (species_params_from_node), i.e. the path a hostile document travels from
# crvoice_from_json_str / crtract_from_json_str. Returns the pointer or the
# negative PRANI_ERR_*. Using a real document (rather than calling the validator
# directly) is what proves the guard is reachable from outside prani.
#must_use
fn t_sp_via_node(p) {
    var b = str_builder_new();
    SpeciesParams_to_json(p, b);
    var js = str_data(str_builder_build(b));
    return species_params_from_node(bayan_json_v_parse_buf(js, strlen(js)));
}

# ================================================================
test_group("enum discriminants (declaration order)");
assert_eq(PRANI_SP_WOLF, 0, "Wolf == 0");
assert_eq(PRANI_SP_FANTASY, 12, "Fantasy == 12");
assert_eq(PRANI_SP_COUNT, 13, "13 species");
assert_eq(PRANI_APP_LARYNGEAL, 0, "Laryngeal == 0");
assert_eq(PRANI_APP_NOISE_ONLY, 4, "NoiseOnly == 4");

# ================================================================
test_group("params -- Wolf (laryngeal, f0 150-1200/400, tilt -3)");
var wolf = species_params(PRANI_SP_WOLF);
assert_eq(SpeciesParams_apparatus(wolf), PRANI_APP_LARYNGEAL, "wolf laryngeal");
assert_eq(SpeciesParams_f0_min(wolf), f64_from(150), "wolf f0_min 150");
assert_eq(SpeciesParams_f0_max(wolf), f64_from(1200), "wolf f0_max 1200");
assert_eq(SpeciesParams_f0_default(wolf), f64_from(400), "wolf f0_default 400");
assert_eq(SpeciesParams_tract_scale(wolf), PR_TS_1_2, "wolf tract_scale 1.2");
assert_eq(SpeciesParams_formant0(wolf), f64_from(420), "wolf F1 420");
assert_eq(SpeciesParams_bandwidth2(wolf), f64_from(150), "wolf B3 150");
assert_eq(SpeciesParams_breathiness(wolf), PR_BR_0_05, "wolf breathiness 0.05");
assert_eq(SpeciesParams_spectral_tilt(wolf), f64_neg(f64_from(3)), "wolf tilt -3");

# ================================================================
test_group("params -- Lion (laryngeal, infrasonic f0 40-200/80, tilt -6)");
var lion = species_params(PRANI_SP_LION);
assert_eq(SpeciesParams_apparatus(lion), PRANI_APP_LARYNGEAL, "lion laryngeal");
assert_eq(SpeciesParams_f0_min(lion), f64_from(40), "lion f0_min 40");
assert_eq(SpeciesParams_f0_default(lion), f64_from(80), "lion f0_default 80");
assert_eq(SpeciesParams_tract_scale(lion), f64_from(2), "lion tract_scale 2.0");
assert_eq(SpeciesParams_formant0(lion), f64_from(250), "lion F1 250");
assert_eq(SpeciesParams_breathiness(lion), PR_BR_0_1, "lion breathiness 0.1");
assert_eq(SpeciesParams_spectral_tilt(lion), f64_neg(f64_from(6)), "lion tilt -6 (steep)");

# ================================================================
test_group("params -- Songbird (syringeal, high f0 1000-8000/3000, tilt -1)");

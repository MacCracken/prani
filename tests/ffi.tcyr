# ffi.tcyr -- tests for src/ffi.cyr (ports 2.0.3:rust-old/src/ffi.rs).
#
# Include order: dep bundles (hisab -> goonj -> naad -> svara) first, then the
# prani src modules in dependency order (error -> rng -> dsp -> vocalization ->
# sequence -> species -> bridge -> tract -> voice -> stream -> ffi). The prani
# modules carry no `include` lines -- this entry orders them.
#
# PARITY APPROACH: ffi is a thin adaptation layer over voice/stream (already
# tested for svara-dependent output), so these tests lock the FFI-specific
# LOGIC exactly: the index<->discriminant range checks (including out-of-range
# -> -1), null-handle guards, voice_create range rejection, the RTPC effort
# clamp round-trip, and the stream_start dispatch (valid combo -> handle,
# unsupported voc / bad index -> null). The destroy no-ops are exercised to
# confirm they never crash. fill_buffer accounting + is_finished flip are checked
# through the ffi surface; the sample values themselves are svara-dependent and
# covered structurally (finite) in stream.tcyr.
#
# INPUT RANGES (2.0.5, audit finding F11): ffi is THE untrusted boundary -- a C
# host passes these f64s directly with no type safety -- so the last seven groups
# pin the range contract of every numeric entry point. Two shapes, matching the
# two return conventions the surface already uses:
#
#   * the RTPC setters return a constant 0 and have no error channel, so
#     "rejected" is asserted as THE VOICE DID NOT CHANGE -- read back through
#     crvoice_vocal_effort / CreatureVoice_size_scale / crvoice_effective_f0;
#   * stream_start returns handle-or-0 and stream_fill returns a count, so
#     "rejected" is asserted as 0, which is what each already returns on a null
#     handle.
#
# Three of the groups exist to prove the guards did NOT overreach, and they are
# as load-bearing as the rejections: a finite out-of-range effort still CLAMPS
# (the oracle's RTPC saturation), a ZERO duration is still VALID and still yields
# an empty buffer rather than an error (the oracle's test_zero_duration_synthesis),
# and a finite 999 Hz sample rate still starts a stream that svara rejects at the
# first fill (ADR-0001 leaves the floor with svara; ADR-0003 reports 0 and
# retires). Those three are the parity edge of this milestone.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/svara.cyr"
include "src/error.cyr"
include "src/logging.cyr"
include "src/rng.cyr"
include "src/dsp.cyr"
include "src/vocalization.cyr"
include "src/sequence.cyr"
include "src/species.cyr"
include "src/bridge.cyr"
include "src/tract.cyr"
include "src/voice.cyr"
include "src/stream.cyr"
include "src/ffi.cyr"

# ---- test constants (IEEE-754 hex) -----------------------------------------
var T_SR       = 0x40e5888000000000;   # 44100.0 sample rate
var T_DUR_005  = 0x3fa999999999999a;   # 0.05 s -> 2205 samples @ 44100 (scale 1.0)
var T_0_9      = 0x3feccccccccccccd;   # 0.9  effort (in range, passes through)
var T_1_5      = 0x3ff8000000000000;   # 1.5  effort (out of range -> clamps to 1.0)
var T_1_0      = 0x3ff0000000000000;   # 1.0  effort clamp ceiling
var T_60       = 0x404e000000000000;   # 60.0 dB SPL ambient (Lombard test)

# ---- 2.0.5 range-guard constants -------------------------------------------
var T_NAN      = 0x7ff8000000000000;   # NaN -- the value that walks every clamp
var T_0_0      = 0;                    # +0.0 (valid duration, invalid rate)
var T_999      = 0x408f380000000000;   # 999.0 Hz -- finite, positive, under svara's floor
var T_DUR_NEG  = 0xbff0000000000000;   # -1.0 s duration (rejected -- divergence)
var T_SR_NEG   = 0xc0e5888000000000;   # -44100.0 sample rate (rejected)

alloc_init();

# ================================================================
test_group("species_from_index -- valid range + out-of-range -> -1");
# discriminant == index across 0..=12; 13 and negatives are None (-1).
assert_eq(prani_ffi_species_from_index(0), 0, "species idx 0 -> Wolf (0)");
assert_eq(prani_ffi_species_from_index(7), 7, "species idx 7 -> Snake (7)");
assert_eq(prani_ffi_species_from_index(12), 12, "species idx 12 -> Fantasy (12) max");
assert_eq(prani_ffi_species_from_index(13), (0 - 1), "species idx 13 out of range -> -1");
assert_eq(prani_ffi_species_from_index(99), (0 - 1), "species idx 99 out of range -> -1");
assert_eq(prani_ffi_species_from_index(0 - 1), (0 - 1), "species idx -1 -> -1");

# ================================================================
test_group("vocalization_from_index -- valid range + out-of-range -> -1");
assert_eq(prani_ffi_vocalization_from_index(0), 0, "voc idx 0 -> Howl (0)");
assert_eq(prani_ffi_vocalization_from_index(13), 13, "voc idx 13 -> Buzz (13) max");
assert_eq(prani_ffi_vocalization_from_index(14), (0 - 1), "voc idx 14 out of range -> -1");
assert_eq(prani_ffi_vocalization_from_index(0 - 1), (0 - 1), "voc idx -1 -> -1");

# ================================================================
test_group("intent_from_index -- valid range + out-of-range -> -1");
assert_eq(prani_ffi_intent_from_index(0), 0, "intent idx 0 -> Alarm (0)");
assert_eq(prani_ffi_intent_from_index(6), 6, "intent idx 6 -> Social (6) max");
assert_eq(prani_ffi_intent_from_index(7), (0 - 1), "intent idx 7 out of range -> -1");
assert_eq(prani_ffi_intent_from_index(0 - 1), (0 - 1), "intent idx -1 -> -1");

# ================================================================
test_group("voice_create -- valid index -> handle, bad index -> 0");
var v = prani_ffi_voice_create(0);
assert_neq(v, 0, "voice_create(Wolf=0) -> non-null handle");
assert_eq(crvoice_species(v), PRANI_SP_WOLF, "handle's species is Wolf");
var vbad = prani_ffi_voice_create(99);
assert_eq(vbad, 0, "voice_create(99) out of range -> null (0)");

# ================================================================
test_group("voice_set_effort -- RTPC round-trip, clamp");
# in-range effort passes through crvoice_set_vocal_effort unchanged.
prani_ffi_voice_set_effort(v, T_0_9);
assert_eq(crvoice_vocal_effort(v), T_0_9, "set_effort(0.9) reflected exactly");
# out-of-range effort clamps to 1.0 (crvoice_set_vocal_effort clamps [0,1]).
prani_ffi_voice_set_effort(v, T_1_5);
assert_eq(crvoice_vocal_effort(v), T_1_0, "set_effort(1.5) clamps to 1.0");
# null handle guard: no crash, no change.
prani_ffi_voice_set_effort(0, T_0_9);
assert_eq(crvoice_vocal_effort(v), T_1_0, "set_effort(null,..) is a no-op guard");

# ================================================================
test_group("voice_set_size -- rebuild keeps handle valid, same species");
prani_ffi_voice_set_size(v, T_1_5);
assert_eq(crvoice_species(v), PRANI_SP_WOLF, "set_size keeps species (Wolf)");
assert_eq(CreatureVoice_size_scale(v), T_1_5, "set_size(1.5) reflected in size_scale");
# rebuild resets effort to the default 0.5 (fresh CreatureVoice::new), matching
# the oracle's `*voice = CreatureVoice::new(species).with_size(size)`.
prani_ffi_voice_set_size(0, T_1_5);   # null guard: no crash.

# ================================================================
test_group("voice_apply_lombard -- effort boost, null guard");
var vl = prani_ffi_voice_create(0);
var before = crvoice_vocal_effort(vl);
prani_ffi_voice_apply_lombard(vl, T_60);
assert_eq(f64_ge(crvoice_vocal_effort(vl), before), 1, "lombard raises (or holds) effort");
prani_ffi_voice_apply_lombard(0, T_60);   # null guard: no crash.

# ================================================================
test_group("stream_start -- valid combo (Wolf, Howl=0, Social=6) -> handle");
var vs = prani_ffi_voice_create(PRANI_SP_WOLF);
var st = prani_ffi_stream_start(vs, 0, 6, T_SR, T_DUR_005);
assert_neq(st, 0, "stream_start(Wolf, Howl, Social) -> non-null handle");
assert_eq(prani_ffi_stream_is_finished(st), 0, "fresh stream not finished");

# ================================================================
test_group("stream_start -- unsupported vocalization for species -> 0");
# Snake (7) apparatus is NoiseOnly; Howl (0) not supported -> stream_new errors.
var vsnake = prani_ffi_voice_create(PRANI_SP_SNAKE);
var st_bad = prani_ffi_stream_start(vsnake, 0, 6, T_SR, T_DUR_005);
assert_eq(st_bad, 0, "stream_start(Snake, Howl) unsupported -> null (0)");

# ================================================================
test_group("stream_start -- guards: null voice, bad voc/intent index -> 0");
assert_eq(prani_ffi_stream_start(0, 0, 6, T_SR, T_DUR_005), 0, "null voice -> 0");
assert_eq(prani_ffi_stream_start(vs, 14, 6, T_SR, T_DUR_005), 0, "voc idx 14 out of range -> 0");
assert_eq(prani_ffi_stream_start(vs, 0, 7, T_SR, T_DUR_005), 0, "intent idx 7 out of range -> 0");

# ================================================================
test_group("stream_fill -- writes count, guards, is_finished flip");
var st2 = prani_ffi_stream_start(prani_ffi_voice_create(PRANI_SP_WOLF), 0, 6, T_SR, T_DUR_005);
# pre-sized vec of 2205 (== total_samples for 0.05*1.0*44100) -> one full fill.
var buf = vec_new();
var bi = 0;
while (bi < 2205) { vec_push(buf, 0); bi = bi + 1; }
var wrote = prani_ffi_stream_fill(st2, buf, 2205);
assert_eq(wrote, 2205, "stream_fill writes all 2205 in one pass");
assert_eq(prani_ffi_stream_is_finished(st2), 1, "stream is finished after full fill");
# a subsequent fill on a finished stream writes 0.
assert_eq(prani_ffi_stream_fill(st2, buf, 2205), 0, "fill on finished stream -> 0");
# guards: null stream, null buffer, zero length all -> 0.
assert_eq(prani_ffi_stream_fill(0, buf, 2205), 0, "null stream -> 0");
assert_eq(prani_ffi_stream_fill(st2, 0, 2205), 0, "null buffer -> 0");
assert_eq(prani_ffi_stream_fill(st2, buf, 0), 0, "zero buffer_len -> 0");

# ================================================================
test_group("stream_is_finished -- null handle -> 1");
assert_eq(prani_ffi_stream_is_finished(0), 1, "is_finished(null) -> 1 (Rust None arm)");

# ================================================================
test_group("destroy no-ops -- do not crash");
# arena allocator: destroy is a null-check no-op. Exercise both null and live.
prani_ffi_voice_destroy(0);
prani_ffi_voice_destroy(vs);
prani_ffi_stream_destroy(0);
prani_ffi_stream_destroy(st);
assert_eq(1, 1, "destroy no-ops completed without crashing");

# ================================================================
test_group("voice_set_effort -- non-finite rejected, finite clamp preserved");
# NaN is the live defect: f64_clamp(NaN, 0, 1) -> NaN, so before the guard a
# single bad RTPC frame left vocal_effort NaN and every later synthesis on this
# voice produced NaN samples with nothing reporting an error. The setter has no
# error channel (it returns a constant 0), so "rejected" is asserted as the voice
# being byte-for-byte what the last accepted call left it.
var vnf = prani_ffi_voice_create(PRANI_SP_WOLF);
prani_ffi_voice_set_effort(vnf, T_0_9);
assert_eq(crvoice_vocal_effort(vnf), T_0_9, "baseline: finite 0.9 accepted");
prani_ffi_voice_set_effort(vnf, T_NAN);
assert_eq(crvoice_vocal_effort(vnf), T_0_9, "set_effort(NaN) rejected -- effort unchanged");
assert_eq(prani_is_finite(crvoice_vocal_effort(vnf)), 1, "effort still finite after a NaN frame");
prani_ffi_voice_set_effort(vnf, PRANI_POS_INF);
assert_eq(crvoice_vocal_effort(vnf), T_0_9, "set_effort(+inf) rejected -- effort unchanged");
prani_ffi_voice_set_effort(vnf, PRANI_NEG_INF);
assert_eq(crvoice_vocal_effort(vnf), T_0_9, "set_effort(-inf) rejected -- effort unchanged");
# NOT overreach: a FINITE out-of-range effort still saturates, as the oracle's
# set_vocal_effort does. Rejecting that instead is 2.1.0's constructor contract.
prani_ffi_voice_set_effort(vnf, T_1_5);
assert_eq(crvoice_vocal_effort(vnf), T_1_0, "finite 1.5 still clamps to 1.0 (not rejected)");

# ================================================================
test_group("voice_set_size -- non-finite rejected before the reset");
# The worst of the three: size_scale is crvoice_effective_f0's DIVISOR, so a NaN
# here poisons f0 for every later vocalization. The guard also has to run before
# crvoice_reset_individual, or a rejected call would still have wiped the voice's
# individual fields on its way out.
var vsz = prani_ffi_voice_create(PRANI_SP_WOLF);
prani_ffi_voice_set_size(vsz, T_1_5);
prani_ffi_voice_set_effort(vsz, T_0_9);
var f0_before = crvoice_effective_f0(vsz);
prani_ffi_voice_set_size(vsz, T_NAN);
assert_eq(CreatureVoice_size_scale(vsz), T_1_5, "set_size(NaN) rejected -- size_scale unchanged");
assert_eq(prani_is_finite(crvoice_effective_f0(vsz)), 1, "effective_f0 still finite (NaN divisor averted)");
assert_eq(crvoice_effective_f0(vsz), f0_before, "effective_f0 unchanged by the rejected call");
assert_eq(crvoice_vocal_effort(vsz), T_0_9, "rejected set_size did not wipe effort (guard precedes reset)");
prani_ffi_voice_set_size(vsz, PRANI_POS_INF);
assert_eq(CreatureVoice_size_scale(vsz), T_1_5, "set_size(+inf) rejected -- size_scale unchanged");
prani_ffi_voice_set_size(vsz, PRANI_NEG_INF);
assert_eq(CreatureVoice_size_scale(vsz), T_1_5, "set_size(-inf) rejected -- size_scale unchanged");

# ================================================================
test_group("voice_apply_lombard -- non-finite ambient rejected");
# bridge_lombard_effort_boost(NaN) is NaN (the <= 40 dB early-out is false for
# NaN and the [0, 0.5] clamp passes it), so the additive update stored NaN.
var vlb = prani_ffi_voice_create(PRANI_SP_WOLF);
prani_ffi_voice_set_effort(vlb, T_0_9);
prani_ffi_voice_apply_lombard(vlb, T_NAN);
assert_eq(crvoice_vocal_effort(vlb), T_0_9, "apply_lombard(NaN) rejected -- effort unchanged");
assert_eq(prani_is_finite(crvoice_vocal_effort(vlb)), 1, "effort still finite after a NaN ambient reading");
prani_ffi_voice_apply_lombard(vlb, PRANI_POS_INF);
assert_eq(crvoice_vocal_effort(vlb), T_0_9, "apply_lombard(+inf) rejected -- effort unchanged");
prani_ffi_voice_apply_lombard(vlb, PRANI_NEG_INF);
assert_eq(crvoice_vocal_effort(vlb), T_0_9, "apply_lombard(-inf) rejected -- effort unchanged");
# NOT overreach: any FINITE dB SPL is still accepted -- the boost is total over
# the finite reals, so there is no out-of-range dB value to reject.
prani_ffi_voice_apply_lombard(vlb, T_60);
assert_eq(f64_ge(crvoice_vocal_effort(vlb), T_0_9), 1, "finite 60 dB still raises (or holds) effort");

# ================================================================
test_group("stream_start -- sample_rate (0,inf) and duration [0,inf) ranges");
# Unguarded, every one of these returned a NON-NULL handle to a stream born
# retired: total_samples = f64_to(NaN) is i64::MIN and f64_to(0.0) is 0, so
# samples_rendered >= total_samples on the first call. The host drained nothing
# and no error was raised anywhere -- F11's silently-empty-buffer signature.
# 0 (null) is already this function's documented error return.
var vst = prani_ffi_voice_create(PRANI_SP_WOLF);
assert_eq(prani_ffi_stream_start(vst, 0, 6, T_NAN, T_DUR_005), 0, "NaN sample_rate -> 0");
assert_eq(prani_ffi_stream_start(vst, 0, 6, PRANI_POS_INF, T_DUR_005), 0, "+inf sample_rate -> 0");
assert_eq(prani_ffi_stream_start(vst, 0, 6, PRANI_NEG_INF, T_DUR_005), 0, "-inf sample_rate -> 0");
assert_eq(prani_ffi_stream_start(vst, 0, 6, T_0_0, T_DUR_005), 0, "0 Hz sample_rate -> 0");
assert_eq(prani_ffi_stream_start(vst, 0, 6, T_SR_NEG, T_DUR_005), 0, "negative sample_rate -> 0");
assert_eq(prani_ffi_stream_start(vst, 0, 6, T_SR, T_NAN), 0, "NaN duration -> 0");
assert_eq(prani_ffi_stream_start(vst, 0, 6, T_SR, PRANI_POS_INF), 0, "+inf duration -> 0");
# DIVERGENCE: the oracle's `as usize` cast saturated, folding every negative
# duration into 0 and handing back a stream. i64 can represent the state, so the
# port reports the caller's bug instead of absorbing it.
assert_eq(prani_ffi_stream_start(vst, 0, 6, T_SR, T_DUR_NEG), 0, "negative duration -> 0 (divergence)");

# ================================================================
test_group("stream_start -- ZERO duration stays valid (oracle parity)");
# The oracle's test_zero_duration_synthesis asserts an EMPTY BUFFER, NOT AN
# ERROR, so a zero-length request is a legal thing to ask for. The guard is
# prani_is_non_negative, not prani_is_positive, exactly to keep this.
var st_zero = prani_ffi_stream_start(vst, 0, 6, T_SR, T_0_0);
assert_neq(st_zero, 0, "zero duration is VALID -- still returns a handle");
assert_eq(stream_total_samples(st_zero), 0, "zero duration -> 0 total samples");
assert_eq(prani_ffi_stream_is_finished(st_zero), 1, "zero-duration stream is immediately finished");
var zbuf = vec_new();
var zi = 0;
while (zi < 32) { vec_push(zbuf, 0); zi = zi + 1; }
assert_eq(prani_ffi_stream_fill(st_zero, zbuf, 32), 0, "zero-duration fill writes 0 -- empty buffer, not an error");

# ================================================================
test_group("stream_start -- svara's rate floor stays svara's (ADR-0001/0003)");
# 999 Hz is finite and positive, so this guard passes it through: prani does not
# restate svara's ~1000 Hz threshold (ADR-0001 rejected duplicating it). The
# rejection surfaces at the FIRST FILL, which reports 0 written and retires the
# stream (ADR-0003). This group is here so the range guard above can never
# quietly swallow that path.
var st_low = prani_ffi_stream_start(vst, 0, 6, T_999, T_1_0);
assert_neq(st_low, 0, "999 Hz passes stream_start -- the floor is svara's rule");
assert_eq(prani_ffi_stream_is_finished(st_low), 0, "sub-threshold stream starts unfinished");
var lbuf = vec_new();
var li = 0;
while (li < 64) { vec_push(lbuf, 0); li = li + 1; }
assert_eq(prani_ffi_stream_fill(st_low, lbuf, 64), 0, "first fill reports 0 written (svara rejects the rate)");
assert_eq(prani_ffi_stream_is_finished(st_low), 1, "and retires the stream (ADR-0003)");

# ================================================================
test_group("stream_fill -- buffer_len >= 0 range");
# The oracle's buffer_len was u32, so this state was unrepresentable; the port
# widened it to i64 and the old `buffer_len == 0` test let a negative straight
# through to a full-vec fill. Measured before the guard: buffer_len = -1 on a
# 2205-element vec wrote and reported 2205 samples.
var st_bl = prani_ffi_stream_start(prani_ffi_voice_create(PRANI_SP_WOLF), 0, 6, T_SR, T_DUR_005);
var blbuf = vec_new();
var bl = 0;
while (bl < 2205) { vec_push(blbuf, 0); bl = bl + 1; }
assert_eq(prani_ffi_stream_fill(st_bl, blbuf, (0 - 1)), 0, "negative buffer_len -> 0 written");
assert_eq(stream_samples_rendered(st_bl), 0, "rejected fill did not advance the stream");
assert_eq(prani_ffi_stream_is_finished(st_bl), 0, "caller mistake does not retire the stream (ADR-0003)");
assert_eq(prani_ffi_stream_fill(st_bl, blbuf, 2205), 2205, "a corrected buffer_len still drains it");

var rc = assert_summary();
syscall(60, rc);

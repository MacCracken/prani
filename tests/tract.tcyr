# ================================================================
test_group("determinism -- same params+seed+input -> identical output");
# Two fresh tracts from the same species params draw from the same resonance
# seed, so their synthesis must be bit-identical.
var ct_a = crtract_new(species_params(PRANI_SP_WOLF), T_SR);
var ct_b = crtract_new(species_params(PRANI_SP_WOLF), T_SR);
var out_a = crtract_synthesize(ct_a, T_220, 64, crtract_options_default());
var out_b = crtract_synthesize(ct_b, T_220, 64, crtract_options_default());
assert_eq(t_vecs_equal(out_a, out_b), 1, "laryngeal deterministic (bit-identical)");
# noise path leans on the rng directly -- also deterministic across fresh tracts.
var ct_sa = crtract_new(species_params(PRANI_SP_SNAKE), T_SR);
var ct_sb = crtract_new(species_params(PRANI_SP_SNAKE), T_SR);
var out_sa = crtract_synthesize(ct_sa, pr_from(0), 48, opts);
var out_sb = crtract_synthesize(ct_sb, pr_from(0), 48, opts);
assert_eq(t_vecs_equal(out_sa, out_sb), 1, "noise deterministic (bit-identical)");

# ================================================================
test_group("apply_spectral_tilt -- hand-computed one-pole (tilt=-6 -> a=0.5)");
# a = clamp(-(-6)/12, 0, 0.85) = 0.5; one_minus_a = 0.5. Input [1,0,0]:
#   y0 = 0.5*1 + 0.5*0 = 0.5
#   y1 = 0.5*0 + 0.5*0.5 = 0.25
#   y2 = 0.5*0 + 0.5*0.25 = 0.125
# All exactly representable in f64.
var buf = vec_new();
vec_push(buf, PR_ONE);
vec_push(buf, 0);
vec_push(buf, 0);
crtract_apply_spectral_tilt(buf, T_TILT_N6, T_SR);
assert_eq(vec_get(buf, 0), T_0_5, "tilt y[0] == 0.5");
assert_eq(vec_get(buf, 1), T_0_25, "tilt y[1] == 0.25");
assert_eq(vec_get(buf, 2), T_0_125, "tilt y[2] == 0.125");

# neutral tilt (|tilt_db| < 0.1) is a no-op -- buffer unchanged.
var buf2 = vec_new();
vec_push(buf2, PR_ONE);
vec_push(buf2, T_0_5);
crtract_apply_spectral_tilt(buf2, 0, T_SR);
assert_eq(vec_get(buf2, 0), PR_ONE, "neutral tilt leaves x[0] unchanged");
assert_eq(vec_get(buf2, 1), T_0_5, "neutral tilt leaves x[1] unchanged");

# ================================================================
test_group("reset -- clears phase");
var ct_r = crtract_new(species_params(PRANI_SP_WOLF), T_SR);
# advance phase via the subharmonic path
var ct_r_out = crtract_synthesize(ct_r, T_220, 32, crtract_options_new(T_0_25, T_0_5));
assert_eq(prani_is_err(ct_r_out), 0, "control: the render that advances the phase succeeded");
assert_neq(CreatureTract_phase(ct_r), 0, "phase advanced before reset");
crtract_reset(ct_r);
assert_eq(CreatureTract_phase(ct_r), 0, "reset clears phase to 0");

# ================================================================
test_group("options -- default is (0, 0)");
var od = crtract_options_default();
assert_eq(SynthesisOptions_subharmonic_amp(od), 0, "default subharmonic_amp 0");
assert_eq(SynthesisOptions_perturbation_scale(od), 0, "default perturbation_scale 0");

# ================================================================
# serde roundtrip (restores the Rust #[derive(Serialize, Deserialize)] on
# CreatureTract). The opaque svara tract + naad filter are rebuilt from params;
# rng/phase/dc_blocker/sample_rate/params roundtrip exactly (bit patterns).
test_group("CreatureTract serde roundtrip");
var tser = crtract_new(species_params(PRANI_SP_WOLF), pr_from(8000));
var tser_out = crtract_synthesize_purr(tser, 100, pr_from(27));   # advances phase + rng + dc_blocker
assert_eq(prani_is_err(tser_out), 0, "control: the purr that advances the state succeeded");
var tsb = str_builder_new();
crtract_to_json(tser, tsb);
var tjson = str_data(str_builder_build(tsb));
var t2 = crtract_from_json_str(tjson);
assert_eq(CreatureTract_sample_rate(t2), CreatureTract_sample_rate(tser), "sample_rate roundtrips");
assert_eq(CreatureTract_phase(t2), CreatureTract_phase(tser), "phase roundtrips");
assert_eq(PrRng_state(CreatureTract_rng(t2)), PrRng_state(CreatureTract_rng(tser)), "rng state roundtrips");
assert_eq(PrRng_inc(CreatureTract_rng(t2)), PrRng_inc(CreatureTract_rng(tser)), "rng inc roundtrips");
assert_eq(DcBlocker_r(CreatureTract_dc_blocker(t2)), DcBlocker_r(CreatureTract_dc_blocker(tser)),
  "dc_blocker r roundtrips");
# r alone cannot catch a lost restore -- the constructor sets it to a constant,
# so it survives even if from_json_str dropped the restore entirely. x_prev/y_prev
# are what the purr above advanced, and they are the fields that can actually fail.
assert_neq(DcBlocker_x_prev(CreatureTract_dc_blocker(tser)), 0, "control: purr moved dc_blocker x_prev off 0");
assert_eq(DcBlocker_x_prev(CreatureTract_dc_blocker(t2)), DcBlocker_x_prev(CreatureTract_dc_blocker(tser)),
  "dc_blocker x_prev roundtrips");
assert_eq(DcBlocker_y_prev(CreatureTract_dc_blocker(t2)), DcBlocker_y_prev(CreatureTract_dc_blocker(tser)),
  "dc_blocker y_prev roundtrips");
assert_eq(SpeciesParams_formant0(CreatureTract_params(t2)), SpeciesParams_formant0(CreatureTract_params(tser)),
  "params formant0 roundtrips");
assert_neq(CreatureTract_tract(t2), 0, "rebuilt svara tract non-null");
# idempotency BEFORE any further synthesis (which would advance t2's state)
var tsb2 = str_builder_new();
crtract_to_json(t2, tsb2);
var tjson2 = str_data(str_builder_build(tsb2));
# length first: memeq over strlen(tjson) is a PREFIX compare, so a json2 that
# appended a field would pass it. The oracle compared whole strings.
assert_eq(strlen(tjson2), strlen(tjson), "tract json same length (prefix compare alone is not enough)");
assert_eq(memeq(tjson, tjson2, strlen(tjson)), 1, "tract json idempotent");
# the rebuilt svara tract produces finite output post-restore
var post = crtract_synthesize_purr(t2, 16, pr_from(27));
assert_eq(prani_is_finite(vec_get(post, 8)), 1, "rebuilt tract synthesizes finite output");

# ================================================================
# ADR-0005: the svara tract + naad filter are REBUILT from params, not restored.
# The Rust oracle serialized svara's VocalTract in full and resumed seamlessly
# (2.0.3:rust-old/src/tract.rs:28-44, and its json == json2 at
# 2.0.3:rust-old/tests/integration.rs:257). svara hands prani an opaque handle
# with no state accessors, so the port cannot. This group PINS that divergence
# in both directions so neither half can rot silently.
test_group("CreatureTract serde -- svara/naad state is rebuilt, not restored (ADR-0005)");
# t3: a FRESH tract carrying exactly the scalars the roundtrip restored.
# Capture tser's scalars BEFORE synthesizing from it below (that advances them).
var s_phase = CreatureTract_phase(tser);
var s_rstate = PrRng_state(CreatureTract_rng(tser));
var s_rinc = PrRng_inc(CreatureTract_rng(tser));
var s_xp = DcBlocker_x_prev(CreatureTract_dc_blocker(tser));
var s_yp = DcBlocker_y_prev(CreatureTract_dc_blocker(tser));
var s_r = DcBlocker_r(CreatureTract_dc_blocker(tser));
var t3 = crtract_new(species_params(PRANI_SP_WOLF), pr_from(8000));
CreatureTract_set_phase(t3, s_phase);
PrRng_set_state(CreatureTract_rng(t3), s_rstate);
PrRng_set_inc(CreatureTract_rng(t3), s_rinc);
DcBlocker_set_x_prev(CreatureTract_dc_blocker(t3), s_xp);
DcBlocker_set_y_prev(CreatureTract_dc_blocker(t3), s_yp);
DcBlocker_set_r(CreatureTract_dc_blocker(t3), s_r);
var post3 = crtract_synthesize_purr(t3, 16, pr_from(27));
assert_eq(t_vecs_equal(post, post3), 1, "deserialized tract == fresh tract + restored scalars (svara side rebuilt)");
# Control: the ORIGINAL, continued from its own live svara filter memory, must
# DIFFER -- otherwise the assertion above would hold vacuously for a tract whose
# synthesis never touched svara state at all. crtract_synthesize_purr routes every
# sample through svara_tract_process_sample, so it does.
var post_orig = crtract_synthesize_purr(tser, 16, pr_from(27));
assert_eq(t_vecs_equal(post, post_orig), 0, "control: the original's live svara memory does NOT survive the roundtrip");

# ================================================================
# 2.0.5 -- INPUT RANGES (roadmap 2.0.5, audit F11). Each group pins three things:
# the guard, the MEASUREMENT it rests on (taken on the pre-guard tree 2026-08-31
# and quoted in the comment, so a reader can see what the guard replaced), and
# the control that proves valid input is untouched. The exact PRANI_ERR_* code is
# asserted, not merely "is an error" -- the code is what a consumer branches on,
# and the category (tract vs vocalization) is the decision this milestone made.
# The ranges themselves are tabulated at the top of src/tract.cyr.
test_group("2.0.5 f0 -- non-finite rejected on every path that READS f0");
# Before: NaN/inf survived f64_clamp (both compares false), so the raw-oscillator
# paths ran sin(TAU*inf*t) and returned an all-NaN buffer as SUCCESS.
var g_wolf = crtract_new(wolf, T_SR);
assert_eq(crtract_synthesize(g_wolf, t_nan(), 32, opts), PRANI_ERR_INVALID_TRACT,
  "laryngeal: NaN f0 -> INVALID_TRACT");
assert_eq(crtract_synthesize(g_wolf, PRANI_POS_INF, 32, opts), PRANI_ERR_INVALID_TRACT,
  "laryngeal: +inf f0 -> INVALID_TRACT");
assert_eq(crtract_synthesize(g_wolf, PRANI_NEG_INF, 32, opts), PRANI_ERR_INVALID_TRACT,
  "laryngeal: -inf f0 -> INVALID_TRACT");
var g_bird = crtract_new(bird, T_SR);
assert_eq(crtract_synthesize(g_bird, t_nan(), 32, opts), PRANI_ERR_INVALID_TRACT,
  "syringeal: NaN f0 -> INVALID_TRACT (was: all-NaN buffer, reported as success)");
var g_cricket = crtract_new(cricket, T_SR);
assert_eq(crtract_synthesize(g_cricket, PRANI_POS_INF, 32, opts), PRANI_ERR_INVALID_TRACT,
  "stridulatory: +inf f0 -> INVALID_TRACT (was: all-NaN buffer)");
assert_eq(crtract_synthesize(g_cricket, t_nan(), 32, opts), PRANI_ERR_INVALID_TRACT,
  "stridulatory: NaN f0 -> INVALID_TRACT");
var g_bee = crtract_new(bee, T_SR);
assert_eq(crtract_synthesize(g_bee, PRANI_NEG_INF, 32, opts), PRANI_ERR_INVALID_TRACT,
  "vibratile: -inf f0 -> INVALID_TRACT (was: all-NaN buffer)");
assert_eq(crtract_synthesize(g_bee, t_nan(), 32, opts), PRANI_ERR_INVALID_TRACT,
  "vibratile: NaN f0 -> INVALID_TRACT");
# Controls: a rejected call must not have touched the tract, and every finite f0
# the oracle accepted is still accepted -- including 0 and a negative one, which
# the raw-oscillator paths render as a mirrored tone exactly as the Rust did.
assert_eq(CreatureTract_phase(g_wolf), 0, "control: a rejected call left phase untouched");
var g_ok = crtract_synthesize(g_wolf, T_220, 16, opts);
assert_eq(prani_is_err(g_ok), 0, "control: the same tract still synthesizes after a rejection");
assert_eq(prani_is_err(crtract_synthesize(g_bee, pr_from(0), 8, opts)), 0,
  "control: f0 = 0 is VALID (the oracle accepted it)");
assert_eq(prani_is_err(crtract_synthesize(g_bee, pr_neg(pr_from(300)), 8, opts)), 0,
  "control: a negative f0 is VALID (mirrored tone, as in the oracle)");

# ================================================================
test_group("2.0.5 f0 -- NOT guarded on the noise path, which never reads it");
# Deliberate asymmetry, and the reason the guards live in the five apparatus
# paths rather than in crtract_synthesize: a snake's synthesis never looks at f0,
# so rejecting one would report a failure that cannot happen. If a future edit
# moves the guard up into the dispatcher, this assertion fails and says why.
var g_snake = crtract_new(snake, T_SR);
var g_noise = crtract_synthesize(g_snake, t_nan(), 24, opts);
assert_eq(prani_is_err(g_noise), 0, "noise: NaN f0 accepted -- the path never reads f0");
assert_eq(vec_len(g_noise), 24, "noise: NaN f0 still produced 24 samples");
assert_eq(t_all_finite(g_noise), 1, "noise: NaN f0 output is finite (f0 is unused)");

# ================================================================
test_group("2.0.14 num_samples -- past one vec's limit is refused, not a process exit");
# Each of these used to render for minutes and then die in the vec.
var n_over = VEC_CAP_MAX + 1;
assert_eq(crtract_synthesize(crtract_new(wolf, T_SR), T_220, n_over, opts), PRANI_ERR_INVALID_VOCALIZATION,
  "laryngeal");
assert_eq(crtract_synthesize(crtract_new(bird, T_SR), pr_from(3000), n_over, opts),
  PRANI_ERR_INVALID_VOCALIZATION, "syringeal");
assert_eq(crtract_synthesize(crtract_new(snake, T_SR), pr_from(0), n_over, opts),
  PRANI_ERR_INVALID_VOCALIZATION, "noise");
assert_eq(crtract_synthesize(crtract_new(cricket, T_SR), pr_from(4500), n_over, opts),
  PRANI_ERR_INVALID_VOCALIZATION, "stridulatory");
assert_eq(crtract_synthesize(crtract_new(bee, T_SR), pr_from(300), n_over, opts),
  PRANI_ERR_INVALID_VOCALIZATION, "vibratile");
assert_eq(crtract_synthesize_purr(crtract_new(wolf, T_SR), n_over, pr_from(27)),
  PRANI_ERR_INVALID_VOCALIZATION, "purr");

test_group("2.0.5 num_samples -- negative rejected, zero still VALID");
# Before: a negative count (i64::MIN is where f64_to lands below -2^63) simply
# skipped the loop and returned an EMPTY buffer as success. Zero, by contrast, is
# VALID: the oracle's test_zero_duration_synthesis asserts an empty buffer, NOT an
# error, so the bound is >= 0 rather than > 0. That means this layer cannot see a
# NaN-derived count, which is 0: callers range the f64 first.
var n_wolf = crtract_new(wolf, T_SR);
assert_eq(crtract_synthesize(n_wolf, T_220, 0 - 1, opts), PRANI_ERR_INVALID_VOCALIZATION,
  "laryngeal: negative num_samples -> INVALID_VOCALIZATION");
assert_eq(crtract_synthesize(n_wolf, T_220, (0 - 9223372036854775807) - 1, opts),
  PRANI_ERR_INVALID_VOCALIZATION, "laryngeal: i64::MIN count -> INVALID_VOCALIZATION (was: empty buffer)");
assert_eq(pr_to(t_nan()), 0, "a NaN-derived count is 0 at this layer -- why callers range the f64 first");
assert_eq(crtract_synthesize(crtract_new(bird, T_SR), pr_from(3000), 0 - 1, opts),
  PRANI_ERR_INVALID_VOCALIZATION, "syringeal: negative num_samples -> INVALID_VOCALIZATION");
assert_eq(crtract_synthesize(crtract_new(snake, T_SR), pr_from(0), 0 - 1, opts),
  PRANI_ERR_INVALID_VOCALIZATION, "noise: negative num_samples -> INVALID_VOCALIZATION");
assert_eq(crtract_synthesize(crtract_new(cricket, T_SR), pr_from(4500), 0 - 1, opts),
  PRANI_ERR_INVALID_VOCALIZATION, "stridulatory: negative num_samples -> INVALID_VOCALIZATION");
assert_eq(crtract_synthesize(crtract_new(bee, T_SR), pr_from(300), 0 - 1, opts),
  PRANI_ERR_INVALID_VOCALIZATION, "vibratile: negative num_samples -> INVALID_VOCALIZATION");
assert_eq(crtract_synthesize_purr(crtract_new(cat, T_SR), 0 - 1, pr_from(25)),
  PRANI_ERR_INVALID_VOCALIZATION, "purr: negative num_samples -> INVALID_VOCALIZATION");
# zero-duration controls, one per apparatus -- the oracle's contract
var z_lar = crtract_synthesize(n_wolf, T_220, 0, opts);
assert_eq(prani_is_err(z_lar), 0, "laryngeal: 0 samples is NOT an error");
assert_eq(vec_len(z_lar), 0, "laryngeal: 0 samples -> empty buffer (oracle parity)");
var z_syr = crtract_synthesize(crtract_new(bird, T_SR), pr_from(3000), 0, opts);
assert_eq(vec_len(z_syr), 0, "syringeal: 0 samples -> empty buffer");
var z_noi = crtract_synthesize(crtract_new(snake, T_SR), pr_from(0), 0, opts);
assert_eq(vec_len(z_noi), 0, "noise: 0 samples -> empty buffer");
var z_str = crtract_synthesize(crtract_new(cricket, T_SR), pr_from(4500), 0, opts);
assert_eq(vec_len(z_str), 0, "stridulatory: 0 samples -> empty buffer");
var z_vib = crtract_synthesize(crtract_new(bee, T_SR), pr_from(300), 0, opts);
assert_eq(vec_len(z_vib), 0, "vibratile: 0 samples -> empty buffer");
var z_purr = crtract_synthesize_purr(crtract_new(cat, T_SR), 0, pr_from(25));
assert_eq(prani_is_err(z_purr), 0, "purr: 0 samples is NOT an error");
assert_eq(vec_len(z_purr), 0, "purr: 0 samples -> empty buffer");

# ================================================================
test_group("2.0.5 SynthesisOptions -- non-finite fields rejected where they are read");
# crtract_options_new has no error channel (it returns the struct), and 2.0.5
# does not give it one -- that is 2.2.0's constructor-contract work, and
# stream.cyr uses its result as a pointer without a check. So the NaN is caught
# at the point of USE instead, which covers every path into svara with no API
# change. Before: a NaN subharmonic_amp silently took the no-subharmonic arm
# (f64_gt(NaN, 0) is false) -- a plausible answer fabricated from nonsense.
var o_wolf = crtract_new(wolf, T_SR);
assert_eq(crtract_synthesize(o_wolf, T_220, 32, crtract_options_new(t_nan(), 0)),
  PRANI_ERR_INVALID_VOCALIZATION, "laryngeal: NaN subharmonic_amp -> INVALID_VOCALIZATION");
assert_eq(crtract_synthesize(o_wolf, T_220, 32, crtract_options_new(0, t_nan())),
  PRANI_ERR_INVALID_VOCALIZATION, "laryngeal: NaN perturbation_scale -> INVALID_VOCALIZATION");
assert_eq(crtract_synthesize(o_wolf, T_220, 32, crtract_options_new(PRANI_POS_INF, 0)),
  PRANI_ERR_INVALID_VOCALIZATION, "laryngeal: +inf subharmonic_amp -> INVALID_VOCALIZATION");
assert_eq(crtract_synthesize(crtract_new(bird, T_SR), pr_from(1500), 32, crtract_options_new(0, t_nan())),
  PRANI_ERR_INVALID_VOCALIZATION, "syringeal: NaN perturbation_scale -> INVALID_VOCALIZATION");
assert_eq(CreatureTract_phase(o_wolf), 0, "control: a rejected options call left phase untouched");
assert_eq(prani_is_err(crtract_synthesize(o_wolf, T_220, 16, crtract_options_new(T_0_25, T_0_5))), 0,
  "control: finite options still synthesize");
# NOT guarded on the stridulatory path: it never reads options (the oracle writes
# `let _ = options;`), so there is nothing there to be out of range.
var st_nan = crtract_new(cricket, T_SR);
var st_out = crtract_synthesize_stridulatory(st_nan, pr_from(4500), 16,
  crtract_options_new(t_nan(), t_nan()));
assert_eq(prani_is_err(st_out), 0,
  "stridulatory: NaN options accepted -- the path never reads them");

# ================================================================
test_group("2.0.5 purr_f0 -- non-finite rejected before it can latch the phase");
# The sharpest silent case in the module. purr advances tract state that OUTLIVES
# the call: phase += purr_f0/sample_rate. Measured on the pre-guard tree, a NaN or
# inf purr_f0 returned a FINITE buffer -- nothing downstream could see anything
# wrong -- while latching `phase` non-finite for the tract's whole life, after
# which every purr takes the closed-phase arm because `NaN < 0.4` is false. So
# the assertion that matters here is the phase one, not the return code.
var p_cat = crtract_new(cat, T_SR);
assert_eq(crtract_synthesize_purr(p_cat, 32, t_nan()), PRANI_ERR_INVALID_TRACT,
  "purr: NaN purr_f0 -> INVALID_TRACT");
assert_eq(prani_is_finite(CreatureTract_phase(p_cat)), 1,
  "purr: the rejected NaN did NOT reach the phase accumulator");
assert_eq(CreatureTract_phase(p_cat), 0, "purr: phase is still exactly 0 after the rejection");
assert_eq(crtract_synthesize_purr(p_cat, 32, PRANI_POS_INF), PRANI_ERR_INVALID_TRACT,
  "purr: +inf purr_f0 -> INVALID_TRACT");
assert_eq(CreatureTract_phase(p_cat), 0, "purr: +inf did not reach the phase either");
var p_ok = crtract_synthesize_purr(p_cat, 32, pr_from(27));
assert_eq(prani_is_err(p_ok), 0, "control: a 27 Hz purr still succeeds");
assert_neq(CreatureTract_phase(p_cat), 0, "control: the valid purr DID advance the phase");
assert_eq(t_all_finite(p_ok), 1, "control: valid purr output all finite");

# ================================================================
test_group("2.0.5 tilt_db -- all three non-finite tilts were silent, differently");
# Measured pre-guard: NaN put the WHOLE buffer to NaN and returned success
# (|NaN| < 0.1 is false, a = NaN, and a < 0.01 is false too); +inf was a no-op
# (a = clamp(-inf/12) = 0); -inf applied a = 0.85, the maximum lowpass the filter
# can make -- a real, plausible-sounding filter fabricated out of an accident.
var tl = vec_new();
vec_push(tl, PR_ONE);
vec_push(tl, T_0_5);
assert_eq(crtract_apply_spectral_tilt(tl, t_nan(), T_SR), PRANI_ERR_INVALID_TRACT,
  "tilt: NaN tilt_db -> INVALID_TRACT");
assert_eq(vec_get(tl, 0), PR_ONE, "tilt: the rejected NaN left the buffer untouched (x[0])");
assert_eq(vec_get(tl, 1), T_0_5, "tilt: the rejected NaN left the buffer untouched (x[1])");
assert_eq(crtract_apply_spectral_tilt(tl, PRANI_POS_INF, T_SR), PRANI_ERR_INVALID_TRACT,
  "tilt: +inf tilt_db -> INVALID_TRACT (was: a silent no-op)");
assert_eq(crtract_apply_spectral_tilt(tl, PRANI_NEG_INF, T_SR), PRANI_ERR_INVALID_TRACT,
  "tilt: -inf tilt_db -> INVALID_TRACT (was: a silent a = 0.85 lowpass)");
assert_eq(vec_get(tl, 0), PR_ONE, "tilt: neither infinity touched the buffer");
# controls: the two valid outcomes still return PRANI_ERR_NONE and still filter
assert_eq(crtract_apply_spectral_tilt(tl, 0, T_SR), PRANI_ERR_NONE,
  "control: neutral tilt returns PRANI_ERR_NONE");
assert_eq(vec_get(tl, 0), PR_ONE, "control: neutral tilt left the buffer alone");
var tl2 = vec_new();
vec_push(tl2, PR_ONE);
vec_push(tl2, 0);
assert_eq(crtract_apply_spectral_tilt(tl2, T_TILT_N6, T_SR), PRANI_ERR_NONE,
  "control: -6 dB/oct returns PRANI_ERR_NONE");
assert_eq(vec_get(tl2, 0), T_0_5, "control: -6 dB/oct still filters (y[0] == 0.5)");
# NOT guarded: sample_rate. The function never reads it (the coefficient comes
# from tilt_db alone; the parameter is there for oracle signature parity), so a
# NaN in it cannot change the output -- and a guard would report a failure that
# cannot happen.
var tl3 = vec_new();
vec_push(tl3, PR_ONE);
vec_push(tl3, 0);
# Since 2.3.2 the function reads it (ADR-0014): the coefficient keeps its corner in Hz
# at every rate. A NaN rate is refused, and the buffer left as it was.
assert_eq(crtract_apply_spectral_tilt(tl3, T_TILT_N6, t_nan()), PRANI_ERR_INVALID_TRACT,
  "tilt: a NaN sample_rate is refused (2.3.1 accepted it, unread)");
assert_eq(vec_get(tl3, 0), PR_ONE, "tilt: and the refused buffer is unchanged");
assert_eq(crtract_apply_spectral_tilt(tl3, 0, t_nan()), PRANI_ERR_NONE,
  "tilt: a neutral tilt reads no rate, so it is not refused");

# ================================================================
test_group("2.0.5 from_json_str -- raw f64 bit patterns are range-checked");
# ADR-0002 deferred field ranges to roadmap 2.0.5 (docs/development/roadmap.md),
# which is this group. Each field below arrives as a RAW f64 BIT
# PATTERN named by the document, so a hostile document spells NaN or inf
# directly and no amount of parse checking sees it. t_tract_json writes the same
# fields crtract_to_json does, so these documents differ from prani's own output
# only in the value under test.
var j_ok = t_tract_json(T_SR, 0, 0, 0, PRANI_DCBLOCK_R, wolf);
assert_eq(prani_is_err(crtract_from_json_str(j_ok)), 0,
  "control: the hand-built document with in-range fields is accepted");
# phase: [0, 1] -- the accumulator's own invariant (compared against 0.4, wrapped at 1.0)
assert_eq(crtract_from_json_str(t_tract_json(T_SR, t_nan(), 0, 0, PRANI_DCBLOCK_R, wolf)),
  PRANI_ERR_INVALID_TRACT, "json: NaN phase -> INVALID_TRACT");
assert_eq(crtract_from_json_str(t_tract_json(T_SR, PRANI_POS_INF, 0, 0, PRANI_DCBLOCK_R, wolf)),
  PRANI_ERR_INVALID_TRACT, "json: +inf phase -> INVALID_TRACT");
assert_eq(crtract_from_json_str(t_tract_json(T_SR, pr_neg(T_0_5), 0, 0, PRANI_DCBLOCK_R, wolf)),
  PRANI_ERR_INVALID_TRACT, "json: phase = -0.5 -> INVALID_TRACT");
assert_eq(crtract_from_json_str(t_tract_json(T_SR, pr_from(2), 0, 0, PRANI_DCBLOCK_R, wolf)),
  PRANI_ERR_INVALID_TRACT, "json: phase = 2.0 -> INVALID_TRACT");
assert_eq(prani_is_err(crtract_from_json_str(t_tract_json(T_SR, T_0_5, 0, 0, PRANI_DCBLOCK_R, wolf))), 0,
  "json: phase = 0.5 accepted (in range)");
assert_eq(prani_is_err(crtract_from_json_str(t_tract_json(T_SR, PR_ONE, 0, 0, PRANI_DCBLOCK_R, wolf))), 0,
  "json: phase = 1.0 accepted (inclusive bound; it self-corrects on the first wrap)");
# dc blocker memory: finite. A non-finite one poisons every sample the blocker
# will ever emit -- dsp.cyr reports the latch, it cannot undo it.
assert_eq(crtract_from_json_str(t_tract_json(T_SR, 0, t_nan(), 0, PRANI_DCBLOCK_R, wolf)),
  PRANI_ERR_INVALID_TRACT, "json: NaN dcb_x_prev -> INVALID_TRACT");
assert_eq(crtract_from_json_str(t_tract_json(T_SR, 0, 0, PRANI_NEG_INF, PRANI_DCBLOCK_R, wolf)),
  PRANI_ERR_INVALID_TRACT, "json: -inf dcb_y_prev -> INVALID_TRACT");
var j_mem = t_tract_json(T_SR, 0, pr_neg(T_0_25), T_0_5, PRANI_DCBLOCK_R, wolf);
assert_eq(prani_is_err(crtract_from_json_str(j_mem)), 0,
  "json: ordinary finite filter memory accepted (sign included)");
# dcb_r: [0, 1). This one is a STABILITY bound, not a taste one --
# y = x - x_prev + r*y_prev diverges for |r| >= 1.
assert_eq(crtract_from_json_str(t_tract_json(T_SR, 0, 0, 0, PR_ONE, wolf)),
  PRANI_ERR_INVALID_TRACT, "json: dcb_r = 1.0 -> INVALID_TRACT (marginally unstable)");
assert_eq(crtract_from_json_str(t_tract_json(T_SR, 0, 0, 0, pr_from(2), wolf)),
  PRANI_ERR_INVALID_TRACT, "json: dcb_r = 2.0 -> INVALID_TRACT (divergent)");
assert_eq(crtract_from_json_str(t_tract_json(T_SR, 0, 0, 0, pr_neg(T_0_5), wolf)),
  PRANI_ERR_INVALID_TRACT, "json: dcb_r = -0.5 -> INVALID_TRACT");
assert_eq(crtract_from_json_str(t_tract_json(T_SR, 0, 0, 0, t_nan(), wolf)),
  PRANI_ERR_INVALID_TRACT, "json: NaN dcb_r -> INVALID_TRACT");
assert_eq(prani_is_err(crtract_from_json_str(t_tract_json(T_SR, 0, 0, 0, T_0_5, wolf))), 0,
  "json: dcb_r = 0.5 accepted (in range)");
# NOT range-checked, and each for its own reason:
#   sample_rate -- svara owns the threshold and crtract_new reports it (ADR-0001)
#   rng_state / rng_inc -- every 64-bit pattern is a reachable PCG32 state
var j_slow = t_tract_json(pr_from(10), 0, 0, 0, PRANI_DCBLOCK_R, wolf);
assert_eq(prani_is_err(crtract_from_json_str(j_slow)), 1,
  "json: a 10 Hz sample rate is still rejected -- by svara, via crtract_new");
var j_rng = crtract_from_json_str(j_ok);
assert_eq(PrRng_state(CreatureTract_rng(j_rng)), 12345, "json: rng_state restored unchecked (no range)");
assert_eq(PrRng_inc(CreatureTract_rng(j_rng)), 67891, "json: rng_inc restored unchecked (no range)");
# and the accepted document really did restore what it named
assert_eq(CreatureTract_phase(j_rng), 0, "json: phase restored from the accepted document");
assert_eq(DcBlocker_r(CreatureTract_dc_blocker(j_rng)), PRANI_DCBLOCK_R, "json: dcb_r restored");

# ================================================================
test_group("2.0.5 set_formant_blend -- NOT guarded here: svara already rejects it");
# MEASURED, and the reason this function has no guard of its own: svara refuses a
# NaN blend, a NaN target formant, an infinite target bandwidth (since svara 3.6.3)
# and a finite one whose coefficients overflow (since svara 3.6.5), and the tract is
# left synthesizing finite audio afterwards.
# Restating a dependency's rule in prani is what ADR-0001 declined to do for the
# sample rate -- the duplicate is the thing that goes stale. If svara ever stops
# refusing, these assertions fail and prani learns it needs its own guard, which
# is the whole point of pinning them.
var fb_tract = crtract_new(wolf, T_SR);
var fb_t = vec_new();
vec_push(fb_t, pr_from(800));
vec_push(fb_t, pr_from(1200));
vec_push(fb_t, pr_from(2500));
var fb_b = vec_new();
vec_push(fb_b, pr_from(80));
vec_push(fb_b, pr_from(90));
vec_push(fb_b, pr_from(120));
assert_eq(crtract_set_formant_blend(fb_tract, fb_t, fb_b, T_0_5), PRANI_ERR_NONE,
  "control: a valid blend returns PRANI_ERR_NONE");
assert_eq(crtract_set_formant_blend(fb_tract, fb_t, fb_b, t_nan()), PRANI_ERR_SVARA,
  "blend: NaN blend -> PRANI_ERR_SVARA (svara's rejection, not prani's)");
var fb_after = crtract_synthesize(fb_tract, T_220, 16, opts);
assert_eq(prani_is_err(fb_after), 0, "blend: the tract still synthesizes after a refused blend");
assert_eq(t_all_finite(fb_after), 1, "blend: and its output is still finite (svara kept the old formants)");
var fb_nan_t = vec_new();
vec_push(fb_nan_t, t_nan());
vec_push(fb_nan_t, pr_from(1200));
vec_push(fb_nan_t, pr_from(2500));
assert_eq(crtract_set_formant_blend(fb_tract, fb_nan_t, fb_b, PR_ONE), PRANI_ERR_SVARA,
  "blend: a NaN target formant -> PRANI_ERR_SVARA (svara's rejection)");
var fb_after2 = crtract_synthesize(fb_tract, T_220, 16, opts);
assert_eq(t_all_finite(fb_after2), 1, "blend: still finite after a refused NaN target formant");
# svara 3.6.3 added an infinite bandwidth to what it refuses. Through svara 3.6.0
# this same call returned PRANI_ERR_NONE and every sample after it was NaN:
# measured on 2.1.0, 2205 of 2205 at 44.1 kHz.
var fb_inf_b = vec_new();
vec_push(fb_inf_b, pr_from(80));
vec_push(fb_inf_b, PRANI_POS_INF);
vec_push(fb_inf_b, pr_from(120));
assert_eq(crtract_set_formant_blend(fb_tract, fb_t, fb_inf_b, PR_ONE), PRANI_ERR_SVARA,
  "blend: an infinite target bandwidth -> PRANI_ERR_SVARA (svara's rejection, since 3.6.3)");
var fb_after3 = crtract_synthesize(fb_tract, T_220, 16, opts);
assert_eq(t_all_finite(fb_after3), 1, "blend: still finite after a refused infinite bandwidth");
# svara 3.6.5 (its ADR-0010) refuses a FINITE bandwidth whose coefficients overflow
# sinh, which prani filed (svara issue 2026-11-07). Through svara 3.6.3 both of these
# returned PRANI_ERR_NONE and every sample after them was NaN: 2205 of 2205 at
# 44.1 kHz, measured on 2.1.1. The bound itself is svara's and is not restated
# here; these two are far past it at any sample rate.
var fb_max_b = vec_new();
vec_push(fb_max_b, pr_from(80));
# f64::MAX, and in f32 f32::MAX, the format's largest finite real: pr_of64 of
# f64::MAX is inf in f32, which svara refuses by another rule (audit C2, 2.3.2).
vec_push(fb_max_b, t_per(pr_of64(0x7FEFFFFFFFFFFFFF), 0x7F7FFFFF));
vec_push(fb_max_b, pr_from(120));
assert_eq(crtract_set_formant_blend(fb_tract, fb_t, fb_max_b, PR_ONE), PRANI_ERR_SVARA,
  "blend: the format's largest finite target bandwidth -> PRANI_ERR_SVARA (svara's rejection, since 3.6.5)");
var fb_f32_b = vec_new();
vec_push(fb_f32_b, pr_from(80));
vec_push(fb_f32_b, pr_of64(0x47EFFFFFE0000000));   # f32::MAX as an f64
vec_push(fb_f32_b, pr_from(120));
assert_eq(crtract_set_formant_blend(fb_tract, fb_t, fb_f32_b, PR_ONE), PRANI_ERR_SVARA,
  "blend: an f32::MAX target bandwidth -> PRANI_ERR_SVARA (svara's rejection, since 3.6.5)");
var fb_after4 = crtract_synthesize(fb_tract, T_220, 2205, opts);
assert_eq(t_all_finite(fb_after4), 1, "blend: still finite after a refused huge finite bandwidth (2205 samples)");
assert_eq(crtract_set_formant_blend(fb_tract, fb_t, fb_b, T_0_5), PRANI_ERR_NONE,
  "control: the same tract still takes an ordinary blend after the refusals");

# ================================================================
test_group("2.1.2 the excitation level rests on two svara facts, and the helpers solve it");
# tract.cyr's THE EXCITATION LEVEL block divides svara's pulse peak back out and
# converts the breathiness so the tract hears the oracle's excitation. It rests on
# two facts about svara's glottal source, pinned here so that a svara release that
# changes either fails this group rather than silently mis-scaling every voice:
#   1. a Rosenberg source's voiced pulse peaks at SV_G_ROSENBERG_GAIN;
#   2. its sample is linear in breathiness: s(b) = s(0)*(1-b) + s(1)*b.
# The two svara facts are svara's, so they are checked in f64 in both builds (svara
# is f64 in both, ADR-0010); the helpers are prani's and are checked in its format.
var XL_TOL64 = 0x3d719799812dea11;   # 1e-12
var XL_0999  = 0x3feff7ced916872b;   # 0.999
var XL_037   = 0x3fd7ae147ae147ae;   # 0.37
var XL_F0    = 0x4059000000000000;   # 100.0 Hz: a 441-sample period at 44.1 kHz
#ifdef PRANI_F32
var XL_TOL   = 0x358637BD;           # 1e-6: the helpers are 3-4 f32 roundings of values near 2.3
#else
var XL_TOL   = 0x3d719799812dea11;   # 1e-12
#endif
var XL_037R  = pr_of64(XL_037);      # 0.37 in the build's format

# xl_source(b) -- a fresh svara source at 100 Hz / 44.1 kHz with breathiness b (an
# f64) and svara's default jitter and shimmer.
fn xl_source(b) {
    var g = svara_glottal_new(XL_F0, pr_to64(T_SR));
    svara_glottal_set_breathiness(g, b);
    return g;
}

# fact 1: the peak. Jitter and shimmer off, so every period peaks at the gain.
var xl_p = xl_source(0);
svara_glottal_set_jitter(xl_p, 0);
svara_glottal_set_shimmer(xl_p, 0);
var xl_peak = 0;
var xl_i = 0;
while (xl_i < 2000) {
    var xl_s = f64_abs(svara_glottal_next_sample(xl_p));
    if (f64_gt(xl_s, xl_peak) == 1) { xl_peak = xl_s; }
    xl_i = xl_i + 1;
}
assert_eq(svara_glottal_model(xl_p), SVARA_GLOTTAL_ROSENBERG, "svara_glottal_new builds a Rosenberg source");
assert_eq(crtract_pulse_peak(xl_p), pr_of64(SV_G_ROSENBERG_GAIN), "crtract_pulse_peak reads svara's gain for it");
assert_eq(f64_le(xl_peak, SV_G_ROSENBERG_GAIN), 1, "fact 1: the pulse never exceeds SV_G_ROSENBERG_GAIN");
assert_eq(f64_ge(xl_peak, f64_mul(SV_G_ROSENBERG_GAIN, XL_0999)), 1, "fact 1: and reaches it (within 0.1%)");
assert_eq(f64_gt(SV_G_ROSENBERG_GAIN, F64_ONE), 1, "control: the gain is not 1, so the division is not vacuous");

# fact 2: linearity in breathiness, at svara's default jitter and shimmer. Each
# source seeds its rng and noise generator identically, so the three see the same
# pulse and the same noise.
var xl_s0 = xl_source(0);
var xl_s1 = xl_source(F64_ONE);
var xl_sb = xl_source(XL_037);
var xl_worst = 0;
var xl_noise = 0;
xl_i = 0;
while (xl_i < 2000) {
    var xl_a = svara_glottal_next_sample(xl_s0);
    var xl_n = svara_glottal_next_sample(xl_s1);
    var xl_m = svara_glottal_next_sample(xl_sb);
    var xl_want = f64_add(f64_mul(xl_a, f64_sub(F64_ONE, XL_037)), f64_mul(xl_n, XL_037));
    var xl_d = f64_abs(f64_sub(xl_m, xl_want));
    if (f64_gt(xl_d, xl_worst) == 1) { xl_worst = xl_d; }
    if (f64_gt(f64_abs(xl_n), xl_noise) == 1) { xl_noise = f64_abs(xl_n); }
    xl_i = xl_i + 1;
}
assert_eq(f64_le(xl_worst, XL_TOL64), 1, "fact 2: s(0.37) == s(0)*0.63 + s(1)*0.37, within 1e-12");
assert_eq(f64_gt(xl_noise, pr_to64(T_1EM3)), 1, "control: the b = 1 source is noise, not silence");

# The helpers: with b' and k as tract.cyr computes them, svara's mix scaled by k is
# the oracle's mix times PR_TR_EXC_GAIN -- pulse weight (1-b), noise weight b.
var xl_g = pr_of64(SV_G_ROSENBERG_GAIN);
var xl_bp = crtract_svara_breathiness(XL_037R, xl_g, PR_ONE);   # q = 1: 44.1 kHz
var xl_k = crtract_excitation_scale(XL_037R, xl_g, PR_ONE);
var xl_pw = pr_mul(pr_mul(xl_k, xl_g), pr_sub(PR_ONE, xl_bp));
var xl_nw = pr_mul(xl_k, xl_bp);
assert_eq(pr_le(pr_abs(pr_sub(xl_pw, pr_mul(pr_sub(PR_ONE, XL_037R), PR_TR_EXC_GAIN))), XL_TOL), 1,
  "helpers: the unit-peak pulse is weighted (1 - b) x PR_TR_EXC_GAIN");
assert_eq(pr_le(pr_abs(pr_sub(xl_nw, pr_mul(XL_037R, PR_TR_EXC_GAIN))), XL_TOL), 1,
  "helpers: the noise is weighted b x PR_TR_EXC_GAIN, the oracle's balance");
assert_eq(crtract_svara_breathiness(0, xl_g, PR_ONE), 0, "helpers: b = 0 stays 0");
assert_eq(crtract_svara_breathiness(PR_ONE, xl_g, PR_ONE), PR_ONE, "helpers: b = 1 stays 1");
assert_eq(crtract_excitation_scale(PR_ONE, xl_g, PR_ONE), PR_TR_EXC_GAIN,
  "helpers: noise alone is scaled by the gain only");
assert_eq(crtract_excitation_scale(0, PR_ONE, PR_ONE), PR_TR_EXC_GAIN, "helpers: a unit-peak model needs no division");
# and crtract_glottal_new hands svara the converted breathiness, not the species'.
var xl_gl = crtract_glottal_new(T_220, T_SR, wolf, PR_ONE);
var xl_wb = SpeciesParams_breathiness(wolf);
assert_eq(pr_gt(xl_wb, 0), 1, "control: the wolf is breathy at all, so the conversion is visible");
assert_eq(pr_of64(SvGlottalSource_breathiness(xl_gl)), crtract_svara_breathiness(xl_wb, xl_g, PR_ONE),
  "crtract_glottal_new gives svara g*b / (1 - b + g*b), not b");

# ================================================================
test_group("2.2.0 SvVowelTarget is 80 bytes, the stack target crtract_new and the blend fill");
# crtract_new and crtract_set_formant_blend build their svara target in a stack
# `var vt[80]` with svara_vowel_target_set, where they used to have svara allocate
# one (unchecked) per call. If svara grows the struct, those writes overrun.
assert_eq(sizeof(SvVowelTarget), 80, "sizeof(SvVowelTarget) == 80: ten f64s, f1..f5 and b1..b5");
var vt_t = crtract_new(wolf, T_SR);
var vt_m0 = alloc_used();
var vt_rc = crtract_set_formant_blend(vt_t, fb_t, fb_b, T_0_5);
assert_eq(alloc_used() - vt_m0, 0, "a formant blend allocates nothing (80 B per call through 2.1.2)");
assert_eq(vt_rc, PRANI_ERR_NONE, "control: and it was a real, accepted blend");

# ================================================================
test_group("2.2.1 D16 -- the allocating per-apparatus wrappers render what _into renders");
# crtract_synthesize_laryngeal / _syringeal / _noise / _vibratile had no caller in
# any suite. Each is prani_vec_new plus its _into; held here to the _into render of
# an identical fresh tract, bit for bit.
var aw_ok = 1;
var aw_sp = PRANI_SP_WOLF;
var aw_n = 0;
while (aw_n < 4) {
    var aw_species = PRANI_SP_WOLF;
    if (aw_n == 1) { aw_species = PRANI_SP_CROW; }
    if (aw_n == 2) { aw_species = PRANI_SP_SNAKE; }
    if (aw_n == 3) { aw_species = PRANI_SP_BEE; }
    var aw_a = crtract_new(species_params(aw_species), T_SR);
    var aw_b = crtract_new(species_params(aw_species), T_SR);
    var aw_o = crtract_options_default();
    var aw_x = 0;
    var aw_y = vec_new();
    if (aw_n == 0) {
        aw_x = crtract_synthesize_laryngeal(aw_a, T_220, 256, aw_o);
        aw_y = crtract_synthesize_laryngeal_into(aw_b, T_220, 256, aw_o, aw_y);
    } elif (aw_n == 1) {
        aw_x = crtract_synthesize_syringeal(aw_a, pr_from(800), 256, aw_o);
        aw_y = crtract_synthesize_syringeal_into(aw_b, pr_from(800), 256, aw_o, aw_y);
    } elif (aw_n == 2) {
        aw_x = crtract_synthesize_noise(aw_a, 256);
        aw_y = crtract_synthesize_noise_into(aw_b, 256, aw_y);
    } else {
        aw_x = crtract_synthesize_vibratile(aw_a, pr_from(250), 256);
        aw_y = crtract_synthesize_vibratile_into(aw_b, pr_from(250), 256, aw_y);
    }
    if (prani_is_err(aw_x) == 1) { aw_ok = 0; }
    if (prani_is_err(aw_y) == 1) { aw_ok = 0; }
    if (aw_ok == 1) {
        if (t_vecs_equal(aw_x, aw_y) == 0) { aw_ok = 0; }
    }
    aw_n = aw_n + 1;
}
assert_eq(aw_ok, 1, "each of the four wrappers equals its _into, bit for bit");

# ================================================================
test_group("2.3.0 a raw oscillator's time base holds at any clock (ADR-0010)");
# A cricket and a bee, rendered at their tract clock 0 and again 1000 s in (44.1e6
# samples, past 2^24 and 2^25): at whole-number frequencies the waveform repeats
# every second (the chirp and syllable periods divide 44100 too), so the two renders
# are the same signal. f64 holds that time to its last bit. f32 cannot hold the
# sample index past 2^24, nor the phase w*t anywhere near 1000 s (one f32 ulp at
# 2.5e7 rad is 2 rad), so the f32 build computes both in f64 (real.cyr TIME AND PHASE
# STAY f64). Without that, the f32 renders diverge by the whole signal.
#ifdef PRANI_F32
var TB_TOL = 0x358637BD;             # 1e-6: f32 rounding of the samples, measured below 2.5e-7
#else
var TB_TOL = 0x3e7ad7f29abcaf48;     # 1e-7: f64's sin at 2.5e7 rad, measured below 1e-8
#endif
var TB_LATE = 44100000;              # 1000 s at 44.1 kHz
# tb_diff(a, b) -- the largest |a[i] - b[i]|.
fn tb_diff(a, b) {
    var m = 0;
    var i = 0;
    while (i < vec_len(a)) {
        var d = pr_abs(pr_sub(vec_get(a, i), vec_get(b, i)));
        if (pr_gt(d, m)) { m = d; }
        i = i + 1;
    }
    return m;
}
var tb_c0 = crtract_new(species_params(PRANI_SP_CRICKET), T_SR);
var tb_c1 = crtract_new(species_params(PRANI_SP_CRICKET), T_SR);
CreatureTract_set_clock(tb_c1, TB_LATE);
var tb_ca = crtract_synthesize_stridulatory(tb_c0, pr_from(4000), 4000, opts);
var tb_cb = crtract_synthesize_stridulatory(tb_c1, pr_from(4000), 4000, opts);
assert_eq(pr_gt(t_max_abs_range(tb_ca, 0, 4000), pr_of64(0x3fb999999999999a)), 1,
  "control: the cricket's first 4000 samples are a chirp, not silence");
assert_eq(pr_le(tb_diff(tb_ca, tb_cb), TB_TOL), 1, "a cricket 1000 s into its clock renders what it did at 0");
var tb_b0 = crtract_new(species_params(PRANI_SP_BEE), T_SR);
var tb_b1 = crtract_new(species_params(PRANI_SP_BEE), T_SR);
CreatureTract_set_clock(tb_b1, TB_LATE);
var tb_ba = crtract_synthesize_vibratile(tb_b0, pr_from(200), 4000);
var tb_bb = crtract_synthesize_vibratile(tb_b1, pr_from(200), 4000);
assert_eq(pr_le(tb_diff(tb_ba, tb_bb), TB_TOL), 1, "and so does a bee's wing beat");
var tb_s0 = crtract_new(species_params(PRANI_SP_BEE), T_SR);
var tb_s1 = crtract_new(species_params(PRANI_SP_BEE), T_SR);
CreatureTract_set_clock(tb_s1, TB_LATE);
var tb_sa = crtract_synthesize_stridulatory(tb_s0, pr_from(200), 4000, opts);
var tb_sb = crtract_synthesize_stridulatory(tb_s1, pr_from(200), 4000, opts);
assert_eq(pr_le(tb_diff(tb_sa, tb_sb), TB_TOL), 1, "and the stridulatory path's low-carrier arm");
# Audit C1, 2.3.2: the syringeal dual source above 2 kHz had no case, and its arm
# written in f32 time passed every suite while its render at 1000 s was 0.349 off,
# against a peak of 0.082. At 3000 Hz its second source is 4494 Hz, so both repeat
# every second too. Measured: 2.9e-8 in f32, 0 in f64.
var tb_y0 = crtract_new(species_params(PRANI_SP_SONGBIRD), T_SR);
var tb_y1 = crtract_new(species_params(PRANI_SP_SONGBIRD), T_SR);
CreatureTract_set_clock(tb_y1, TB_LATE);
var tb_ya = crtract_synthesize_syringeal(tb_y0, pr_from(3000), 4000, opts);
var tb_yb = crtract_synthesize_syringeal(tb_y1, pr_from(3000), 4000, opts);
assert_eq(pr_gt(t_max_abs_range(tb_ya, 0, 4000), pr_of64(0x3f847ae147ae147b)), 1,
  "control: the songbird's dual source is sounding (peak above 0.01)");
assert_eq(pr_le(tb_diff(tb_ya, tb_yb), TB_TOL), 1, "and so does a songbird's dual source above 2 kHz");

# ================================================================
test_group("2.3.2 B4 -- a phase accumulator does not drift (ADR-0010)");
# 10 s of a purr at 27 Hz and of a wolf's 200 Hz subharmonic, one call each, held to
# the exact phase frac(n * f / sr) computed in f64. Each accumulator now adds in f64
# in the f32 build and rounds once when it stores. Through 2.3.1 the f32 build added
# in f32, re-rounding the increment at every sample: 4.5e-3 and 2.5e-3 cycles off.
#ifdef PRANI_F32
var PH_TOL = 0x3EB0C6F7A0B5ED8D;      # 1e-6: one f32 rounding of the stored phase
#else
var PH_TOL = 0x3E112E0BE826D695;      # 1e-9: f64's own accumulation, measured 4e-11
#endif
var PH_N = 441001;
# ph_off(p, f) -- |p - frac(PH_N * f / 44100)| as an f64, the stored phase's error.
fn ph_off(p, f) {
    var want = f64_mul(f64_from(PH_N), f64_div(f64_from(f), f64_from(44100)));
    want = f64_sub(want, f64_floor(want));
    return f64_abs(f64_sub(pr_to64(p), want));
}
var ph_cat = crtract_new(species_params(PRANI_SP_CAT), T_SR);
assert_eq(prani_is_err(crtract_synthesize_purr(ph_cat, PH_N, pr_from(27))), 0, "control: the purr renders");
assert_eq(f64_le(ph_off(CreatureTract_phase(ph_cat), 27), PH_TOL), 1,
  "the purr's phase after 10 s is the exact one (2.3.1's f32 build: 4.5e-3 cycles off)");
var ph_wo = crtract_new(species_params(PRANI_SP_WOLF), T_SR);
var ph_o = crtract_options_new(PR_HALF, PR_ONE);
assert_eq(prani_is_err(crtract_synthesize(ph_wo, pr_from(400), PH_N, ph_o)), 0, "control: the subharmonic renders");
assert_eq(f64_le(ph_off(CreatureTract_phase(ph_wo), 200), PH_TOL), 1,
  "and the subharmonic's (2.3.1's f32 build: 2.5e-3 cycles off)");

# ================================================================
test_group("2.3.2 D5 -- the second harmonic is left out past Nyquist, not aliased");
# Each raw oscillator adds 0.3 x sin(2 x w t). Past Nyquist that partial lands at
# |sr - 2 f0|, a tone the creature does not make. Measured with a Goertzel filter at
# that alias, against the carrier as a control. Through 2.3.1 a cricket at 16 kHz put
# its 9 kHz partial at 7 kHz with amplitude 0.0526.
# h2_amp(v, f, sr, n) -- the amplitude of v's component at f Hz over its first n samples.
fn h2_amp(v, f, sr, n) {
    var w = f64_div(f64_mul(F64_TAU, f64_from(f)), f64_from(sr));
    var cw = f64_mul(F64_TWO, f64_cos(w));
    var s1 = 0;
    var s2 = 0;
    var i = 0;
    while (i < n) {
        var x = f64_add(f64_sub(f64_mul(cw, s1), s2), pr_to64(vec_get(v, i)));
        s2 = s1;
        s1 = x;
        i = i + 1;
    }
    var re = f64_sub(s1, f64_mul(s2, f64_cos(w)));
    var im = f64_mul(s2, f64_sin(w));
    return f64_div(f64_mul(F64_TWO, f64_sqrt(f64_add(f64_mul(re, re), f64_mul(im, im)))), f64_from(n));
}
var H2_QUIET = 0x3F50624DD2F1A9FC;   # 1e-3
var H2_LOUD  = 0x3F947AE147AE147B;   # 0.02
var h2_o = crtract_options_default();
# the cricket branch (f0 > 1000) at 16 kHz: carrier 4500 Hz, its partial 9000 Hz -> 7000
var h2_c = crtract_synthesize_stridulatory(crtract_new(species_params(PRANI_SP_CRICKET), pr_from(16000)),
  pr_from(4500), 2000, h2_o);
assert_eq(f64_lt(h2_amp(h2_c, 7000, 16000, 2000), H2_QUIET), 1, "cricket at 16 kHz: nothing at 7 kHz (2.3.1: 0.0526)");
assert_eq(f64_gt(h2_amp(h2_c, 4500, 16000, 2000), H2_LOUD), 1, "control: its 4500 Hz carrier is there");
var h2_c44 = crtract_synthesize_stridulatory(crtract_new(species_params(PRANI_SP_CRICKET), T_SR),
  pr_from(4500), 2000, h2_o);
assert_eq(f64_gt(h2_amp(h2_c44, 9000, 44100, 2000), H2_LOUD), 1, "control: at 44.1 kHz the 9 kHz partial is kept");
# the vibratile path at 16 kHz: carrier 4500, partial 9000 -> 7000, its sidebands at 6750
var h2_v = crtract_synthesize_vibratile(crtract_new(species_params(PRANI_SP_BEE), pr_from(16000)), pr_from(4500), 2000);
assert_eq(f64_lt(h2_amp(h2_v, 7000, 16000, 2000), H2_QUIET), 1, "vibratile at 16 kHz: nothing at 7 kHz");
assert_eq(f64_gt(h2_amp(h2_v, 4500, 16000, 2000), H2_LOUD), 1, "control: its carrier is there");
# the stridulatory bee branch (f0 <= 1000) at 1600 Hz: carrier 500, partial 1000 -> 600
var h2_b = crtract_synthesize_stridulatory(crtract_new(species_params(PRANI_SP_BEE), pr_from(1600)),
  pr_from(500), 1600, h2_o);
assert_eq(f64_lt(h2_amp(h2_b, 600, 1600, 1600), H2_QUIET), 1, "the low-carrier branch at 1600 Hz: nothing at 600 Hz");
assert_eq(f64_gt(h2_amp(h2_b, 500, 1600, 1600), H2_LOUD), 1, "control: its 500 Hz carrier is there");

# Audit D3, 2.3.2. svara refuses a five-formant target if any formant is not below
# Nyquist, and the tract keeps what it had: svara's default vowel, schwa (523, 1588,
# 2469, 3300, 3750 Hz), or below a 7.5 kHz rate, where schwa is past Nyquist too, a
# single 500 Hz formant. 2.2.1 kept prani's F4/F5 estimates in band (ADR-0009); a
# species whose own F2 or F3 is past Nyquist still lost all five. Every midpoint
# below is exact in both formats, so each is pinned as a value. A placed formant
# keeps the level its own resonance has where it is placed (ADR-0013): at full
# amplitude, four resonances piled below Nyquist, and a crow's bark at 8 kHz
# peaked at 1.81.
test_group("2.3.2 D3 -- a species' own formants past Nyquist are placed, not lost");
# d3_f(t, i) -- the tract's formant i, f64 in both builds; 0 if it has no formant i.
fn d3_f(t, i) {
    var fv = SvVocalTract_formants(CreatureTract_tract(t));
    if (i >= vec_len(fv)) { return 0; }
    return SvFormant_frequency(vec_get(fv, i));
}
# d3_a(t, i) -- the tract's formant i's amplitude, f64 in both builds; 0 if none.
fn d3_a(t, i) {
    var fv = SvVocalTract_formants(CreatureTract_tract(t));
    if (i >= vec_len(fv)) { return 0; }
    return SvFormant_amplitude(vec_get(fv, i));
}
var d3_cat = crtract_new(species_params(PRANI_SP_CAT), pr_from(8000));
assert_eq(d3_f(d3_cat, 0), f64_from(850), "a cat at 8 kHz keeps its F1 (2.3.1: schwa's 523)");
assert_eq(d3_f(d3_cat, 1), f64_from(2500), "and its F2");
assert_eq(d3_f(d3_cat, 2), f64_from(3250), "F3, 4200 Hz, is placed halfway from F2 to Nyquist");
assert_eq(d3_f(d3_cat, 3), f64_from(3625), "F4 halfway above that");
assert_eq(d3_f(d3_cat, 4), 0x40adc90000000000, "and F5 at 3812.5");
assert_eq(d3_a(d3_cat, 0), 0x3FF0000000000000, "F1, in band, keeps svara's amplitude 1.0");
assert_eq(d3_a(d3_cat, 1), 0x3FE999999999999A, "and F2 its 0.8");
# 0.5 x 200 x 3250 / sqrt((4200^2 - 3250^2)^2 + (200 x 3250)^2), in Python: the
# resonance at 4200 Hz, 200 Hz wide, at 3250 Hz.
assert_eq(d3_a(d3_cat, 2), 0x3fa7699fde383caf, "F3 has its resonance's level at 3250 Hz: 0.0457 of 0.5");
assert_eq(f64_lt(d3_a(d3_cat, 3), 0x3FD3333333333333), 1, "F4's is below its 0.3");
assert_eq(f64_gt(d3_a(d3_cat, 3), 0), 1, "and above 0: a placed formant is not dropped");
# The level is the one the bank renders, not only the record's: an impulse through a
# fresh cat tract at 8 kHz matches a twin whose bank the test rebuilds from the same
# record, and differs from one rebuilt at svara's full amplitudes.
var d3_ra = crtract_new(species_params(PRANI_SP_CAT), pr_from(8000));
var d3_rb = crtract_new(species_params(PRANI_SP_CAT), pr_from(8000));
var d3_rc = crtract_new(species_params(PRANI_SP_CAT), pr_from(8000));
var d3_tb = CreatureTract_tract(d3_rb);
var d3_tc = CreatureTract_tract(d3_rc);
assert_eq(svara_tract_set_formants(d3_tb, SvVocalTract_formants(d3_tb)), 0, "control: the twin's bank rebuilds");
SvFormant_set_amplitude(vec_get(SvVocalTract_formants(d3_tc), 2), 0x3FE0000000000000);
SvFormant_set_amplitude(vec_get(SvVocalTract_formants(d3_tc), 3), 0x3FD3333333333333);
SvFormant_set_amplitude(vec_get(SvVocalTract_formants(d3_tc), 4), 0x3FC999999999999A);
assert_eq(svara_tract_set_formants(d3_tc, SvVocalTract_formants(d3_tc)), 0, "control: so does the full-level one");
var d3_same = 1;
var d3_diff = 0;
var d3_k = 0;
while (d3_k < 64) {
    var d3_x = 0;
    if (d3_k == 0) { d3_x = 0x3FF0000000000000; }
    var d3_ya = svara_tract_process_sample(CreatureTract_tract(d3_ra), d3_x);
    if (d3_ya != svara_tract_process_sample(d3_tb, d3_x)) { d3_same = 0; }
    if (d3_ya != svara_tract_process_sample(d3_tc, d3_x)) { d3_diff = 1; }
    d3_k = d3_k + 1;
}
assert_eq(d3_same, 1, "the bank renders the placed levels: 64 samples of an impulse match the rebuilt twin");
assert_eq(d3_diff, 1, "control: and differ from svara's full levels");
var d3_crow = crtract_new(species_params(PRANI_SP_CROW), pr_from(5000));
assert_eq(vec_len(SvVocalTract_formants(CreatureTract_tract(d3_crow))), 5,
  "a crow at 5 kHz has five formants (2.3.1: svara's single 500 Hz one)");
assert_eq(d3_f(d3_crow, 0), f64_from(1400), "its own F1");
assert_eq(d3_f(d3_crow, 1), f64_from(1950), "F2, 4200 Hz, placed between F1 and Nyquist");
assert_eq(d3_f(d3_crow, 2), f64_from(2225), "F3, 7000 Hz, between F2 and Nyquist");
assert_eq(d3_f(d3_crow, 4), 0x40a2fe8000000000, "F5 at 2431.25, below Nyquist");
var d3_wolf = crtract_new(species_params(PRANI_SP_WOLF), pr_from(1201));
assert_eq(d3_f(d3_wolf, 0), f64_from(420), "a wolf at svara's 1201 Hz floor keeps F1");
assert_eq(d3_f(d3_wolf, 1), 0x407fe40000000000, "F2 at 510.25");
assert_eq(d3_f(d3_wolf, 2), 0x40815b0000000000, "F3 at 555.375");
var d3_c44 = crtract_new(species_params(PRANI_SP_CAT), pr_from(44100));
assert_eq(d3_f(d3_c44, 2), f64_from(4200), "control: at 44.1 kHz the cat's F3 is its own");
assert_eq(d3_f(d3_c44, 3), pr_to64(pr_mul(pr_from(4200), PR_TR_1_3)), "and F4 the plain 1.3 x F3 estimate");
assert_eq(d3_a(d3_c44, 2), 0x3FE0000000000000, "at svara's amplitude, 0.5");
# A blend toward a target past Nyquist is placed the same way. 2.3.1 refused it, and
# crvoice_vocalize discarded the refusal, as the Rust did, so the block kept the last
# block's formants as success.
var d3_tf = vec_new();
vec_push(d3_tf, pr_from(4500));
vec_push(d3_tf, pr_from(5000));
vec_push(d3_tf, pr_from(6000));
var d3_tb = vec_new();
vec_push(d3_tb, pr_from(120));
vec_push(d3_tb, pr_from(150));
vec_push(d3_tb, pr_from(200));
assert_eq(crtract_set_formant_blend(d3_cat, d3_tf, d3_tb, PR_ONE), PRANI_ERR_NONE,
  "a blend to (4500, 5000, 6000) Hz at 8 kHz is accepted (2.3.1: PRANI_ERR_SVARA)");
assert_eq(d3_f(d3_cat, 0), f64_from(2000), "its F1 placed at 2000");
assert_eq(d3_f(d3_cat, 1), f64_from(3000), "F2 at 3000");
assert_eq(d3_f(d3_cat, 2), f64_from(3500), "F3 at 3500");
assert_eq(f64_lt(d3_a(d3_cat, 0), 0x3FF0000000000000), 1, "each at its resonance's level there: F1 below 1.0");
# What svara still refuses is not a formant past Nyquist, and is not placed: a NaN or
# an infinite formant, which only a raw setter can put in a params record. 2.3.1
# rendered schwa for it and returned the tract.
var d3_pn = species_params(PRANI_SP_CAT);
SpeciesParams_set_formant1(d3_pn, pr_div(0, 0));
assert_eq(crtract_new(d3_pn, pr_from(8000)), PRANI_ERR_SVARA, "a NaN F2 is refused, not rendered through schwa");
var d3_pi = species_params(PRANI_SP_CAT);
SpeciesParams_set_formant0(d3_pi, PRANI_POS_INF);
assert_eq(crtract_new(d3_pi, pr_from(44100)), PRANI_ERR_SVARA, "an infinite F1 is refused, not placed at 11025");

# Audit K2, 2.3.2: a mutant moving the purr's closed-phase noise scale survived. Held
# in its closed phase (phase 0.5, f0 0: it never leaves), the purr excites the tract
# with nothing but the rng's draws x 0.02. A twin tract, with the same seed, fed
# those draws x 0.02 by hand and then DC-blocked as the purr's buffer is, renders the
# same samples, bit for bit in both builds.
test_group("2.3.2 K2 -- the purr's closed phase is noise x 0.02");
var k2_a = crtract_new(species_params(PRANI_SP_CAT), T_SR);
var k2_b = crtract_new(species_params(PRANI_SP_CAT), T_SR);
CreatureTract_set_phase(k2_a, T_0_5);
var k2_out = crtract_synthesize_purr(k2_a, 256, 0);
assert_eq(prani_is_err(k2_out), 0, "control: a purr at 0 Hz renders");
var k2_twin = vec_new();
var k2_i = 0;
while (k2_i < 256) {
    var k2_x = pr_mul(prani_rng_next_f32(CreatureTract_rng(k2_b)), pr_of64(0x3f947ae147ae147b));
    vec_push(k2_twin, pr_of64(svara_tract_process_sample(CreatureTract_tract(k2_b), pr_to64(k2_x))));
    k2_i = k2_i + 1;
}
dcblocker_process_buffer(CreatureTract_dc_blocker(k2_b), k2_twin);
var k2_same = 1;
var k2_loud = 0;
k2_i = 0;
while (k2_i < 256) {
    if (vec_get(k2_out, k2_i) != vec_get(k2_twin, k2_i)) { k2_same = 0; }
    if (pr_gt(pr_abs(vec_get(k2_twin, k2_i)), 0)) { k2_loud = k2_loud + 1; }
    k2_i = k2_i + 1;
}
assert_eq(k2_same, 1, "256 closed-phase samples are the tract's response to noise x 0.02");
assert_eq(pr_gt(pr_from(k2_loud), pr_from(200)), 1, "control: and they are not silence");

# Audit V1, 2.3.2 (ADR-0014). prani's levels are calibrated at 44.1 kHz, and a render
# at another rate is to be that render, cut to its band. Through 2.3.1 four stages had
# a response fixed per sample: svara's lip radiation, svara's formant bandwidths, the
# one-pole tilt and DC blocker, and every white-noise source. The median render was
# +18.8 dB at 8 kHz and -8.7 dB at 96 kHz against the same call at 44.1 kHz cut to the
# lower Nyquist (127 renders a rate, by 1/3-octave band). Each expected value below is
# computed in Python from the formula in src/tract.cyr.
test_group("2.3.2 V1 -- a render's level does not depend on the sample rate (ADR-0014)");
var v1_w44 = crtract_new(species_params(PRANI_SP_WOLF), T_SR);
var v1_s44 = CreatureTract_tract(v1_w44);
assert_eq(SvVocalTract_lip_radiation(v1_s44), 0x3FEF0A3D70A3D70A, "at 44.1 kHz svara's lip radiation is its own 0.97");
assert_eq(SvVocalTract_interaction_strength(v1_s44), 0x3FA999999999999A, "its interaction its own 0.05");
assert_eq(SvSmoothedParam_current(SvVocalTract_gain(v1_s44)), 0x3FF0000000000000, "its gain 1.0");
assert_eq(DcBlocker_r(CreatureTract_dc_blocker(v1_w44)), PRANI_DCBLOCK_R, "and the DC blocker's pole its 0.995");
# 2.3.3 (ADR-0015): svara renders a bandwidth b' as b' sin(w0), so a 100 Hz F1 at
# 420 Hz is handed svara 1668.2 Hz (Python) to render 100 Hz wide; 2.3.2 handed it 100.
var v1_bw44 = SvFormant_bandwidth(vec_get(SvVocalTract_formants(v1_s44), 0));
assert_eq(f64_le(f64_abs(f64_sub(v1_bw44, 0x409a10c801a1a4c8)), 0x3E112E0BE826D695), 1,
  "F1 is handed svara 1668.2 Hz, which it renders 100 Hz wide");
var v1_w8 = crtract_new(species_params(PRANI_SP_WOLF), pr_from(8000));
var v1_s8 = CreatureTract_tract(v1_w8);
var V1_TOL = t_per(0x3D719799812DEA11, 0x3E7AD7F29ABCAF48);   # 1e-12 / 1e-7
assert_eq(SvSmoothedParam_current(SvVocalTract_gain(v1_s8)), 0x3fc7384ef2a605ce,
  "at 8 kHz svara's gain is 8000 / 44100, the lip radiation's gain there");
assert_eq(SvVocalTract_interaction_strength(v1_s8), 0x3f8293725bb804a5, "the interaction strength 0.05 x that");
assert_eq(f64_le(f64_abs(f64_sub(SvVocalTract_lip_radiation(v1_s8), 0x3feb0dc976a8aa64)), 0x3D719799812DEA11), 1,
  "the lip radiation 0.97^(44100/8000), its zero where it is at 44.1 kHz");
var v1_r8 = pr_to64(DcBlocker_r(CreatureTract_dc_blocker(v1_w8)));
assert_eq(f64_le(f64_abs(f64_sub(v1_r8, 0x3fef20bd87a38be5)), V1_TOL), 1,
  "the DC blocker's pole 0.995^(44100/8000), its corner where it is at 44.1 kHz");
var v1_c8 = crtract_new(species_params(PRANI_SP_CAT), pr_from(8000));
var v1_bw = SvFormant_bandwidth(vec_get(SvVocalTract_formants(CreatureTract_tract(v1_c8)), 0));
assert_eq(f64_le(f64_abs(f64_sub(v1_bw, 0x406834a384efff15)), 0x3E112E0BE826D695), 1,
  "a cat's 120 Hz F1 is handed svara 193.64 Hz at 8 kHz, which it renders 120 Hz wide");
assert_real(crtract_noise_scale(pr_from(8000)), pr_of64(0x3fdb423c5acf2baa), 1,
  "white noise at 8 kHz x sqrt(8000/44100)");
assert_eq(crtract_noise_scale(T_SR), PR_ONE, "and x 1 at 44.1 kHz");
var v1_tl = vec_new();
vec_push(v1_tl, PR_ONE);
vec_push(v1_tl, 0);
assert_eq(crtract_apply_spectral_tilt(v1_tl, T_TILT_N6, pr_from(8000)), PRANI_ERR_NONE,
  "control: a -6 dB/oct tilt at 8 kHz");
assert_eq(f64_le(f64_abs(f64_sub(pr_to64(vec_get(v1_tl, 0)), 0x3fef4c8ad44db68d)), V1_TOL), 1,
  "has its 44.1 kHz corner: y[0] = 1 - 0.5^(44100/8000)");
# naad's bandpass for a noise-only voice renders the band its Q specifies, f / Q Hz:
# a snake's Q 2 at 2500 Hz is handed naad as 0.941 at 8 kHz and 1.958 at 44.1 kHz
# (Python, ADR-0015), where 2.3.1's Q 2 at 8 kHz passed half of it, naad's alpha
# sin(w0) / 2Q shrinking toward Nyquist.
var v1_sn = crtract_new(species_params(PRANI_SP_SNAKE), pr_from(8000));
assert_eq(f64_le(f64_abs(f64_sub(BiquadFilter_q(CreatureTract_noise_filter(v1_sn)), 0x3fee1d2165cadadc)),
    0x3D719799812DEA11), 1, "a snake's noise band at 8 kHz has Q 0.941");
var v1_sn44 = crtract_new(species_params(PRANI_SP_SNAKE), T_SR);
assert_eq(f64_le(f64_abs(f64_sub(BiquadFilter_q(CreatureTract_noise_filter(v1_sn44)), 0x3fff53dfcdde36cb)),
    0x3D719799812DEA11), 1, "and Q 1.958 at 44.1 kHz");
# The glottal source's noise carries the same density: svara is handed the breathiness
# whose noise is scaled by sqrt(8000/44100), not the 44.1 kHz one.
var v1_gl = crtract_glottal_new(T_220, pr_from(8000), wolf, PR_ONE);
var v1_wb = SpeciesParams_breathiness(wolf);
var v1_gp = pr_of64(SV_G_ROSENBERG_GAIN);
var v1_q8 = crtract_noise_scale(pr_from(8000));
assert_eq(pr_of64(SvGlottalSource_breathiness(v1_gl)), crtract_svara_breathiness(v1_wb, v1_gp, v1_q8),
  "at 8 kHz svara's breathiness carries the noise scale");
assert_neq(pr_of64(SvGlottalSource_breathiness(v1_gl)), crtract_svara_breathiness(v1_wb, v1_gp, PR_ONE),
  "control: which is not the 44.1 kHz one");
# The purr's closed phase at 8 kHz, as K2's twin, with the noise at its density.
var v1_pa = crtract_new(species_params(PRANI_SP_CAT), pr_from(8000));
var v1_pb = crtract_new(species_params(PRANI_SP_CAT), pr_from(8000));
CreatureTract_set_phase(v1_pa, T_0_5);
var v1_po = crtract_synthesize_purr(v1_pa, 256, 0);
var v1_tw = vec_new();
var v1_q = pr_of64(0x3fdb423c5acf2baa);
var v1_i = 0;
while (v1_i < 256) {
    var v1_x = pr_mul(pr_mul(prani_rng_next_f32(CreatureTract_rng(v1_pb)), pr_of64(0x3f947ae147ae147b)), v1_q);
    vec_push(v1_tw, pr_of64(svara_tract_process_sample(CreatureTract_tract(v1_pb), pr_to64(v1_x))));
    v1_i = v1_i + 1;
}
dcblocker_process_buffer(CreatureTract_dc_blocker(v1_pb), v1_tw);
var v1_same = 1;
v1_i = 0;
while (v1_i < 256) {
    if (t_ulps(vec_get(v1_po, v1_i), vec_get(v1_tw, v1_i)) > t_per(0, 1)) { v1_same = 0; }
    v1_i = v1_i + 1;
}
assert_eq(v1_same, 1, "a purr's closed-phase noise at 8 kHz is the rng's draws x 0.02 x sqrt(8000/44100)");
# The noise-only path, and the syringeal dual source's breath noise (a songbird at
# breathiness 1, where its two tones are weighted 0), at 8 and 16 kHz, each against a
# twin tract fed the rng's draws at sqrt(sr/44100) by hand.
# v1_noise_ok(sp, sr) -- 1 iff 256 samples of sp's noise at sr match the hand-fed twin.
fn v1_noise_ok(sp, sr) {
    var p = species_params(sp);
    if (sp == PRANI_SP_SONGBIRD) { SpeciesParams_set_breathiness(p, PR_ONE); }
    var ta = crtract_new(p, pr_from(sr));
    var tb = crtract_new(p, pr_from(sr));
    var out = 0;
    if (sp == PRANI_SP_SNAKE) { out = crtract_synthesize_noise(ta, 256); }
    if (sp == PRANI_SP_SONGBIRD) {
        out = crtract_synthesize_syringeal(ta, pr_from(3000), 256, crtract_options_default());
    }
    var q = pr_of64(f64_sqrt(f64_div(f64_from(sr), f64_from(44100))));
    var tw = vec_new();
    var i = 0;
    while (i < 256) {
        var d = prani_rng_next_f32(CreatureTract_rng(tb));
        var y = 0;
        if (sp == PRANI_SP_SNAKE) {
            var xn = pr_to64(pr_mul(pr_mul(d, PR_TR_0_5), q));
            y = pr_of64(filter_biquad_process_sample(CreatureTract_noise_filter(tb), xn));
        }
        if (sp == PRANI_SP_SONGBIRD) {
            y = pr_of64(svara_tract_process_sample(CreatureTract_tract(tb), pr_to64(pr_mul(pr_mul(d, PR_ONE), q))));
        }
        vec_push(tw, y);
        i = i + 1;
    }
    dcblocker_process_buffer(CreatureTract_dc_blocker(tb), tw);
    var ok = 1;
    i = 0;
    while (i < 256) {
        if (t_ulps(vec_get(out, i), vec_get(tw, i)) > t_per(0, 1)) { ok = 0; }
        i = i + 1;
    }
    return ok;
}
assert_eq(v1_noise_ok(PRANI_SP_SNAKE, 8000), 1, "a snake's hiss at 8 kHz is its draws x 0.5 x sqrt(8000/44100)");
assert_eq(v1_noise_ok(PRANI_SP_SONGBIRD, 16000), 1, "a songbird's breath at 16 kHz is its draws x sqrt(16000/44100)");

# The render, in a group of its own so that it runs on 2.3.1 as it is: a wolf's voice
# at its 400 Hz harmonic at 8, 16 and 96 kHz against 44.1 kHz, 0.5 s each, by a
# Goertzel filter, held to 0.5 dB. Measured -0.34, -0.15 and +0.05 dB; 2.3.1 fails all
# three. A bee's 200 Hz wing tone is the control: the vibratile path never reaches
# svara's tract, so it held its level on 2.3.1 too (+0.10, +0.04, -0.01 dB now).
test_group("2.3.2 V1 -- a tone through the tract keeps its level at any rate");
# v1_amp(sp, sr, f) -- the amplitude at f Hz of 0.5 s of species sp's tract at sr.
fn v1_amp(sp, sr, f) {
    var t = crtract_new(species_params(sp), pr_from(sr));
    var n = sr / 2;
    var v = 0;
    if (sp == PRANI_SP_BEE) { v = crtract_synthesize_vibratile(t, pr_from(f), n); }
    if (sp == PRANI_SP_WOLF) { v = crtract_synthesize_laryngeal(t, pr_from(f), n, crtract_options_default()); }
    return h2_amp(v, f, sr, n);
}
# v1_off(sp, sr, f) -- 1 iff the tone at sr is more than 0.5 dB from the same at 44.1 kHz.
fn v1_off(sp, sr, f) {
    var r = f64_div(v1_amp(sp, sr, f), v1_amp(sp, 44100, f));
    if (f64_lt(r, 0x3FEE35BF27A298B9) == 1) { return 1; }   # 10^(-0.5/20)
    if (f64_gt(r, 0x3FF0F2B408BCD790) == 1) { return 1; }   # 10^(0.5/20)
    return 0;
}
assert_eq(v1_off(PRANI_SP_BEE, 8000, 200), 0, "control: a bee's 200 Hz tone at 8 kHz is its level at 44.1 kHz");
assert_eq(v1_off(PRANI_SP_BEE, 16000, 200), 0, "control: and at 16 kHz");
assert_eq(v1_off(PRANI_SP_BEE, 96000, 200), 0, "control: and at 96 kHz");
assert_eq(v1_off(PRANI_SP_WOLF, 8000, 400), 0, "a wolf's 400 Hz harmonic at 8 kHz is its level at 44.1 kHz");
assert_eq(v1_off(PRANI_SP_WOLF, 16000, 400), 0, "and at 16 kHz");
assert_eq(v1_off(PRANI_SP_WOLF, 96000, 400), 0, "and at 96 kHz");

# 2.3.3 (ADR-0015). A formant specified b Hz wide renders b Hz wide, measured on the
# resonance itself: one svara resonance, built as crtract_new builds it, driven by a
# steady sine, is 3 dB down from its peak at the analog resonance's -3 dB edges,
# sqrt(f^2 + b^2/4) -+ b/2. Through 2.3.2 a wolf's 100 Hz F1 at 420 Hz rendered 6.0 Hz
# wide at 44.1 kHz. Held to 0.25 dB of -3.01 dB at each edge.
test_group("2.3.3 a formant renders the width it is specified");
# fw_amp(filt, f, sr) -- the steady amplitude of filt's output for a unit sine at f Hz
# (f64): 2 s of it, the last second measured by a Goertzel at f.
fn fw_amp(filt, f, sr) {
    var w = f64_div(f64_mul(F64_TAU, f), f64_from(sr));
    var cw = f64_mul(F64_TWO, f64_cos(w));
    var s1 = 0;
    var s2 = 0;
    var i = 0;
    while (i < sr * 2) {
        var y = svara_formant_filter_process_sample(filt, f64_sin(f64_mul(w, f64_from(i))));
        if (i >= sr) {
            var x = f64_add(f64_sub(f64_mul(cw, s1), s2), y);
            s2 = s1;
            s1 = x;
        }
        i = i + 1;
    }
    var re = f64_sub(s1, f64_mul(s2, f64_cos(w)));
    var im = f64_mul(s2, f64_sin(w));
    return f64_div(f64_mul(F64_TWO, f64_sqrt(f64_add(f64_mul(re, re), f64_mul(im, im)))), f64_from(sr));
}
# fw_db3(f, b, sr) -- 1 iff a resonance at f Hz specified b Hz wide, through
# crtract_bw64, is within 0.25 dB of -3.01 dB at both analog -3 dB edges.
fn fw_db3(f, b, sr) {
    var fv = vec_new();
    vec_push(fv, svara_formant_new(f64_from(f), crtract_bw64(pr_from(b), pr_from(f), pr_from(sr)), F64_ONE));
    var filt = svara_formant_filter_new(fv, f64_from(sr));
    var half = f64_div(f64_from(b), F64_TWO);
    var mid = f64_sqrt(f64_add(f64_mul(f64_from(f), f64_from(f)), f64_mul(half, half)));
    var pk = fw_amp(filt, f64_from(f), sr);
    var ok = 1;
    var k = 0;
    while (k < 2) {
        svara_formant_filter_reset(filt);
        var e = f64_sub(mid, half);
        if (k == 1) { e = f64_add(mid, half); }
        var r = f64_div(fw_amp(filt, e, sr), pk);
        if (f64_lt(r, 0x3FE5FC76F3FF3218) == 1) { ok = 0; }   # 10^(-3.26/20)
        if (f64_gt(r, 0x3FE749F8DF65990B) == 1) { ok = 0; }   # 10^(-2.76/20)
        k = k + 1;
    }
    return ok;
}
assert_eq(fw_db3(420, 100, 44100), 1, "a wolf's F1, 100 Hz wide at 420 Hz, at 44.1 kHz (2.3.2: 6.0 Hz)");
assert_eq(fw_db3(2100, 150, 44100), 1, "its F3, 150 Hz wide at 2100 Hz (2.3.2: 44 Hz)");
assert_eq(fw_db3(850, 120, 8000), 1, "a cat's F1 at 8 kHz");
assert_eq(fw_db3(3500, 500, 16000), 1, "a songbird's F1 at 16 kHz, 500 Hz wide at 3500 Hz");
assert_eq(fw_db3(420, 100, 96000), 1, "a wolf's F1 at 96 kHz (2.3.2: 2.7 Hz)");

var rc = assert_summary();
syscall(60, rc);

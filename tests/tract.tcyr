# tract.tcyr -- tests for src/tract.cyr (ports rust-old/src/tract.rs).
#
# Include order: dep bundles (hisab -> goonj -> naad -> svara) first, then the
# prani src modules in dependency order (error -> rng -> dsp -> vocalization ->
# sequence -> species -> tract). The prani modules carry no `include` lines --
# this entry orders them. sequence.cyr is pulled in only for the CallBout struct
# species_bout_template references; its synthesize methods forward-reference
# crvoice_* (voice.cyr, not included) which are UNREACHABLE here, so undefined-fn
# WARNINGS for crvoice_* are EXPECTED and fine (not link errors).
#
# PARITY APPROACH: exact svara-internal bit parity vs the f32 Rust oracle is not
# attainable -- f32->f64 widening diverges through svara's own DSP (glottal pulse
# shaping, formant biquads, DC blocker). So instead of golden sample values we
# assert STRUCTURAL parity: each apparatus path returns a NON-error vec of the
# expected length (num_samples) with ALL samples finite; determinism (same
# params+seed+input -> identical output); the pure-arithmetic paths
# (apply_spectral_tilt one-pole, reset) against hand-computed f64 results.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/svara.cyr"
include "src/error.cyr"
include "src/logging.cyr"
include "src/rng.cyr"
include "src/dsp.cyr"
include "src/vocalization.cyr"
include "src/sequence.cyr"
include "src/species.cyr"
include "src/tract.cyr"

# test constants (IEEE-754 hex)
var T_SR       = 0x40e5888000000000;   # 44100.0 sample rate
var T_TILT_N6  = 0xc018000000000000;   # -6.0 dB/oct
var T_0_5      = 0x3fe0000000000000;   # 0.5
var T_0_25     = 0x3fd0000000000000;   # 0.25
var T_0_125    = 0x3fc0000000000000;   # 0.125
var T_220      = 0x406b800000000000;   # 220.0
var T_2500     = 0x40a3880000000000;   # 2500.0 (unused sentinel; see below)
var T_TOL_1EM6 = 0x3eb0c6f7a0b5ed8d;   # 1e-6
var T_1EM3     = 0x3f50624dd2f1a9fc;   # 0.001 (the oracle's near-silence bar)

alloc_init();

# ---- helpers ---------------------------------------------------------------
# all_finite(vec) -- 1 iff every element passes prani_is_finite.
#must_use
fn t_all_finite(v) {
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        if (prani_is_finite(vec_get(v, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# vecs_equal(a, b) -- 1 iff same length and bit-identical elements.
#must_use
fn t_vecs_equal(a, b) {
    if (vec_len(a) != vec_len(b)) { return 0; }
    var n = vec_len(a);
    var i = 0;
    while (i < n) {
        if (vec_get(a, i) != vec_get(b, i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# approx(a, b, eps) -- |a-b| < eps.
#must_use
fn t_approx(a, b, eps) {
    return f64_lt(f64_abs(f64_sub(a, b)), eps);
}

# max_abs_range(v, lo, hi) -- peak |s| over v[lo..hi).
#must_use
fn t_max_abs_range(v, lo, hi) {
    var m = 0;
    var i = lo;
    while (i < hi) {
        var a = f64_abs(vec_get(v, i));
        if (f64_gt(a, m) == 1) { m = a; }
        i = i + 1;
    }
    return m;
}

# count_below(v, eps, lo, hi) -- how many of v[lo..hi) satisfy |s| < eps.
#must_use
fn t_count_below(v, eps, lo, hi) {
    var n = 0;
    var i = lo;
    while (i < hi) {
        if (f64_lt(f64_abs(vec_get(v, i)), eps) == 1) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

# ================================================================
test_group("laryngeal -- non-error vec, length, finite (wolf)");
var wolf = species_params(PRANI_SP_WOLF);
var ct_wolf = crtract_new(wolf, T_SR);
var opts = crtract_options_default();
var out_l = crtract_synthesize(ct_wolf, T_220, 64, opts);
assert_eq(prani_is_err(out_l), 0, "laryngeal returns non-error vec ptr");
assert_eq(vec_len(out_l), 64, "laryngeal length == num_samples (64)");
assert_eq(t_all_finite(out_l), 1, "laryngeal all samples finite");

# ================================================================
test_group("laryngeal subharmonic path -- non-error, finite, phase advances");
var ct_wolf2 = crtract_new(wolf, T_SR);
var opts_sub = crtract_options_new(T_0_25, T_0_5);   # subharmonic_amp=0.25, ps=0.5
assert_eq(CreatureTract_phase(ct_wolf2), 0, "phase starts at 0");
var out_sub = crtract_synthesize(ct_wolf2, T_220, 128, opts_sub);
assert_eq(prani_is_err(out_sub), 0, "subharmonic path non-error");
assert_eq(vec_len(out_sub), 128, "subharmonic length 128");
assert_eq(t_all_finite(out_sub), 1, "subharmonic all finite");
assert_neq(CreatureTract_phase(ct_wolf2), 0, "subharmonic path advanced phase");

# ================================================================
test_group("syringeal low-freq (<=2000) -- glottal path (songbird @ 1500)");
var bird = species_params(PRANI_SP_SONGBIRD);
var ct_bird = crtract_new(bird, T_SR);
# songbird f0 range 1000-8000; 1500 clamps in-range and <=2000 -> glottal path
var out_syr_lo = crtract_synthesize(ct_bird, f64_from(1500), 64, opts);
assert_eq(prani_is_err(out_syr_lo), 0, "syringeal low-freq non-error");
assert_eq(vec_len(out_syr_lo), 64, "syringeal low-freq length 64");
assert_eq(t_all_finite(out_syr_lo), 1, "syringeal low-freq all finite");

# ================================================================
test_group("syringeal high-freq (>2000) -- dual-source path (songbird @ 3000)");
var ct_bird2 = crtract_new(bird, T_SR);
var out_syr_hi = crtract_synthesize(ct_bird2, f64_from(3000), 96, opts);
assert_eq(prani_is_err(out_syr_hi), 0, "syringeal high-freq non-error");
assert_eq(vec_len(out_syr_hi), 96, "syringeal high-freq length 96");
assert_eq(t_all_finite(out_syr_hi), 1, "syringeal high-freq all finite");

# ================================================================
test_group("noise -- naad bandpass path (snake)");
var snake = species_params(PRANI_SP_SNAKE);
var ct_snake = crtract_new(snake, T_SR);
# noise_filter must be present (NoiseOnly pre-builds the naad bandpass)
assert_neq(CreatureTract_noise_filter(ct_snake), 0, "snake has a noise_filter");
var out_noise = crtract_synthesize(ct_snake, f64_from(0), 80, opts);
assert_eq(prani_is_err(out_noise), 0, "noise path non-error");
assert_eq(vec_len(out_noise), 80, "noise length 80");
assert_eq(t_all_finite(out_noise), 1, "noise all finite");

# ================================================================
test_group("stridulatory high-carrier chirps (cricket, f0 > 1000)");
var cricket = species_params(PRANI_SP_CRICKET);
var ct_cricket = crtract_new(cricket, T_SR);
# cricket f0 range 3000-8000 -> f0 > 1000 -> discrete pulse-train chirps
var out_strid = crtract_synthesize(ct_cricket, f64_from(4500), 128, opts);
assert_eq(prani_is_err(out_strid), 0, "stridulatory non-error");
assert_eq(vec_len(out_strid), 128, "stridulatory length 128");
assert_eq(t_all_finite(out_strid), 1, "stridulatory all finite");
# at i=0: t=0 -> carrier=sin(0)=0, h2=0 -> signal=0; syllable_frac=0 < 0.1 ->
# pulse_env = 0/0.1 = 0 -> sample = 0. Exact.
assert_eq(vec_get(out_strid, 0), 0, "stridulatory sample[0] == 0 (t=0, env=0)");

# ================================================================
test_group("stridulatory low-carrier via direct call (bee-style, f0 <= 1000)");
# Drive the stridulatory low branch directly with f0 <= 1000 (bee params use the
# VIBRATILE apparatus, so call the stridulatory synth explicitly for coverage).
var ct_cricket2 = crtract_new(cricket, T_SR);
var out_strid_lo = crtract_synthesize_stridulatory(ct_cricket2, T_220, 64, opts);
assert_eq(prani_is_err(out_strid_lo), 0, "stridulatory low-carrier non-error");
assert_eq(vec_len(out_strid_lo), 64, "stridulatory low-carrier length 64");
assert_eq(t_all_finite(out_strid_lo), 1, "stridulatory low-carrier all finite");

# ================================================================
# The inter-chirp silence arm (src/tract.cyr:389-391, porting
# 2.0.3:rust-old/src/tract.rs:277-279) is UNREACHABLE through crvoice_vocalize
# at any duration, in the port and in the oracle alike: pos_in_chirp is
# `i % chirp_period` over the index WITHIN one synthesize call, and vocalize
# renders in blocks of sample_rate*0.02 = 882 samples at 44100, so pos_in_chirp
# never exceeds 881 while chirp_active is 5880. The oracle's own
# test_cricket_pulse_train passes on the per-syllable envelope, not on the gap
# its comment names. Reaching the arm needs ONE synthesize call longer than
# chirp_active, which is what this group does.
test_group("stridulatory inter-chirp silence (direct call past chirp_active)");
# At 44100: chirp_period = 44100/2.5 = 17640, chirp_active = (44100/30)*4 = 5880.
# 12000 samples therefore spans one full active chirp then 6120 samples of gap.
var ct_gap = crtract_new(cricket, T_SR);
var out_gap = crtract_synthesize_stridulatory(ct_gap, f64_from(4500), 12000, opts);
assert_eq(prani_is_err(out_gap), 0, "gap-spanning stridulatory non-error");
assert_eq(vec_len(out_gap), 12000, "gap-spanning stridulatory length 12000");
assert_eq(t_all_finite(out_gap), 1, "gap-spanning stridulatory all finite");
# The arm pushes exact 0, but dcblocker_process_buffer runs over the whole buffer
# (src/tract.cyr:410) and its pole is 0.995, so the tail decays rather than
# snapping to zero -- ~1100 samples to fall below 1e-3 from a 0.25-scale signal.
# Sample well past that: [10000, 12000) must be near-silent to the last sample.
assert_eq(t_count_below(out_gap, T_1EM3, 10000, 12000), 2000, "inter-chirp gap is silent end to end (2000/2000)");
# Control, same window width inside the active chirp: if the branch were never
# taken, or the whole buffer were silent, this would match the count above.
assert_lt(t_count_below(out_gap, T_1EM3, 1000, 3000), 2000, "active chirp is NOT silent (control)");
assert_eq(f64_gt(t_max_abs_range(out_gap, 1000, 3000), T_1EM3), 1, "active chirp carries real signal (control)");

# ================================================================
test_group("vibratile -- continuous wing-beat AM (bee)");
var bee = species_params(PRANI_SP_BEE);
var ct_bee = crtract_new(bee, T_SR);
var out_vib = crtract_synthesize(ct_bee, f64_from(300), 64, opts);
assert_eq(prani_is_err(out_vib), 0, "vibratile non-error");
assert_eq(vec_len(out_vib), 64, "vibratile length 64");
assert_eq(t_all_finite(out_vib), 1, "vibratile all finite");
# at i=0: t=0 -> carrier=0, h2=0, modulator=0.5+0.5*sin(0)=0.5 -> (0)*0.5*0.25=0
assert_eq(vec_get(out_vib, 0), 0, "vibratile sample[0] == 0 (t=0)");


# fatigue.tcyr -- tests for src/fatigue.cyr (FatigueState + FatigueModifiers).
# 2.0.3:rust-old/src/fatigue.rs had no #[test] blocks; parity is locked to the
# accumulation / recovery curves + modifier derivation. Expected values are
# hand-computed from the f64 port's algorithm (f32->f64 per the port audit):
#   record_call(d,false): fatigue += d*0.015, clamped [0,1]
#   record_call(d,true) & !reinforced: habituation += 0.1, clamped [0,1]
#   rest(d): fatigue -= d*0.07 (max 0); habituation -= d*0.023 (max 0); d>5 zeroes bout
#   reinforce_alarm: reinforced=1; habituation -= 0.3 (max 0); alarm_count=0
#   modifiers(): pitch=-f*20; breath=f*0.2; amp=(1-f*0.4)*(1-h*0.5); jitter=1+f*1.5
# serde/Display tests dropped (no serde; integer codes).

include "src/error.cyr"
include "src/logging.cyr"
include "src/fatigue.cyr"

alloc_init();

var TOL = 0x3E80000000000000;   # ~1.19e-7 (PRANI_EPSILON), for -0.0 / near-zero checks

# ================================================================
test_group("new() -- fresh state");
var s = fatigue_new();
assert_eq(fatigue_fatigue(s), 0, "fresh fatigue == 0");
assert_eq(fatigue_alarm_habituation(s), 0, "fresh habituation == 0");
assert_eq(FatigueState_bout_calling_time(s), 0, "fresh bout time == 0");
assert_eq(FatigueState_alarm_count(s), 0, "fresh alarm count == 0");
assert_eq(FatigueState_alarm_reinforced(s), 0, "fresh not reinforced");

# ================================================================
test_group("record_call(10, false) -- fatigue accumulation");
# fatigue = 0 + 10*0.015 = 0.15 (bit-exact in f64)
fatigue_record_call(s, f64_from(10), 0);
assert_eq(fatigue_fatigue(s), 0x3fc3333333333333, "fatigue == 0.15");
assert_eq(FatigueState_bout_calling_time(s), 0x4024000000000000, "bout time == 10.0");
assert_eq(fatigue_alarm_habituation(s), 0, "non-alarm leaves habituation at 0");
assert_eq(FatigueState_alarm_count(s), 0, "non-alarm leaves alarm count at 0");

# ================================================================
# Mirrors 2.0.3:rust-old/tests/integration.rs:789-804: a fresh state, then
# 30 x record_call(1.0, false). Guards the read-add-write at src/fatigue.cyr:94
# against an implementation that ASSIGNED (fatigue = duration * rate) -- every
# other fatigue-valued assertion in this file is taken after ONE call, so such
# an implementation would pass the rest of the suite.
test_group("record_call x30 -- accumulates, not assigns");
var acc = fatigue_new();
var ai = 0;
while (ai < 30) { fatigue_record_call(acc, F64_ONE, 0); ai = ai + 1; }
# 30 sequential f64 adds of 0.015 round to 0.4500000000000003, which differs
# from the one-shot 30*0.015 (0.45 = 0x3fdccccccccccccd) -- so this pins the
# accumulation order as well as the total.
assert_eq(fatigue_fatigue(acc), 0x3fdcccccccccccd2, "30x1s -> fatigue == 0.4500000000000003");
assert_eq(f64_gt(fatigue_fatigue(acc), 0x3fd3333333333333), 1, "30x1s -> fatigue > 0.3 (oracle bound)");
assert_eq(FatigueState_bout_calling_time(acc), 0x403e000000000000, "bout time == 30.0 after 30 calls");
# Control: a single 1 s call must be strictly smaller on both accumulators.
# An assigning implementation leaves acc and one identical, failing these two.
var one = fatigue_new();
fatigue_record_call(one, F64_ONE, 0);
assert_eq(fatigue_fatigue(one), 0x3f8eb851eb851eb8, "1x1s -> fatigue == 0.015");
assert_eq(f64_gt(fatigue_fatigue(acc), fatigue_fatigue(one)), 1, "30 calls > 1 call (fatigue accumulates)");
assert_eq(f64_gt(FatigueState_bout_calling_time(acc), FatigueState_bout_calling_time(one)), 1, "30 calls > 1 call (bout time accumulates)");
# Modifiers off the accumulated state. The oracle asserts only the three signs
# (2.0.3:rust-old/tests/integration.rs:801-803); the exact values are
# hand-computed from fatigue 0.4500000000000003 with habituation 0, in
# src/fatigue.cyr:196-207 order.
var macc = fatigue_modifiers(acc);
assert_eq(FatigueModifiers_pitch_offset(macc), 0xc022000000000003, "accumulated pitch == -9.000000000000005");
assert_eq(f64_lt(FatigueModifiers_pitch_offset(macc), 0), 1, "pitch drifts down (< 0)");
assert_eq(FatigueModifiers_breathiness_delta(macc), 0x3fb70a3d70a3d70f, "accumulated breathiness == 0.09000000000000007");
assert_eq(f64_gt(FatigueModifiers_breathiness_delta(macc), 0), 1, "more breathy (> 0)");
assert_eq(FatigueModifiers_amplitude_scale(macc), 0x3fea3d70a3d70a3c, "accumulated amplitude == 0.8199999999999998");
assert_eq(f64_lt(FatigueModifiers_amplitude_scale(macc), F64_ONE), 1, "quieter (< 1.0)");
assert_eq(FatigueModifiers_jitter_scale(macc), 0x3ffacccccccccccf, "accumulated jitter == 1.6750000000000005");

# ================================================================
test_group("record_call fatigue clamps at 1.0");
var big = fatigue_new();
# 100s * 0.015 = 1.5 -> clamp to 1.0
fatigue_record_call(big, f64_from(100), 0);
assert_eq(fatigue_fatigue(big), 0x3ff0000000000000, "fatigue clamps to 1.0");

# ================================================================
test_group("record_call(_, true) -- habituation + alarm count");
var al = fatigue_new();
fatigue_record_call(al, f64_from(1), 1);   # 1st unreinforced alarm
assert_eq(fatigue_alarm_habituation(al), 0x3fb999999999999a, "habituation == 0.1 after 1 alarm");
assert_eq(FatigueState_alarm_count(al), 1, "alarm count == 1");
fatigue_record_call(al, f64_from(1), 1);   # 2nd
fatigue_record_call(al, f64_from(1), 1);   # 3rd -> 0.30000000000000004
assert_eq(fatigue_alarm_habituation(al), 0x3fd3333333333334, "habituation == ~0.3 after 3 alarms");
assert_eq(FatigueState_alarm_count(al), 3, "alarm count == 3");

# ================================================================
test_group("reinforced alarm does NOT raise habituation");
var rf = fatigue_new();
fatigue_reinforce_alarm(rf);               # sets reinforced flag (hab stays 0)
assert_eq(FatigueState_alarm_reinforced(rf), 1, "reinforced flag set");
fatigue_record_call(rf, f64_from(1), 1);   # alarm while reinforced
assert_eq(fatigue_alarm_habituation(rf), 0, "habituation stays 0 when reinforced");
assert_eq(FatigueState_alarm_count(rf), 1, "alarm still counted");

# ================================================================
test_group("rest() -- fatigue recovery + habituation decay");
var r = fatigue_new();
fatigue_record_call(r, f64_from(10), 0);   # fatigue = 0.15
# rest(2): fatigue = 0.15 - 2*0.07 = 0.15 - 0.14 = 0.009999999999999981
fatigue_rest(r, f64_from(2));
assert_eq(fatigue_fatigue(r), 0x3f847ae147ae1470, "fatigue == 0.15 - 0.14 (f64)");

# fatigue floors at 0 on long rest
var r2 = fatigue_new();
fatigue_record_call(r2, f64_from(10), 0);  # 0.15
fatigue_rest(r2, f64_from(100));           # 0.15 - 7.0 -> max(0)
assert_eq(fatigue_fatigue(r2), 0, "fatigue floors at 0");
assert_eq(fatigue_alarm_habituation(r2), 0, "habituation floors at 0");

# habituation decays on rest
var r3 = fatigue_new();
fatigue_record_call(r3, f64_from(1), 1);
fatigue_record_call(r3, f64_from(1), 1);
fatigue_record_call(r3, f64_from(1), 1);   # hab = 0.30000000000000004
fatigue_rest(r3, f64_from(1));             # hab -= 0.023 = 0.277
assert_eq(fatigue_alarm_habituation(r3), 0x3fd1ba5e353f7cee, "habituation decays by 0.023");

# ================================================================
test_group("rest > 5s resets bout tracking");
var bt = fatigue_new();
fatigue_record_call(bt, f64_from(10), 0);
assert_eq(FatigueState_bout_calling_time(bt), 0x4024000000000000, "bout time 10.0 before rest");
fatigue_rest(bt, f64_from(6));             # > 5s -> bout reset
assert_eq(FatigueState_bout_calling_time(bt), 0, "bout time reset after >5s rest");

# rest <= 5s does NOT reset bout
var bt2 = fatigue_new();
fatigue_record_call(bt2, f64_from(10), 0);
fatigue_rest(bt2, f64_from(5));            # == 5s, not > 5s
assert_eq(FatigueState_bout_calling_time(bt2), 0x4024000000000000, "bout time kept at exactly 5s rest");

# ================================================================
test_group("reinforce_alarm() -- drops habituation, resets count");
var re = fatigue_new();
fatigue_record_call(re, f64_from(1), 1);
fatigue_record_call(re, f64_from(1), 1);
fatigue_record_call(re, f64_from(1), 1);   # hab ~0.3, count 3
fatigue_reinforce_alarm(re);               # hab -= 0.3 -> ~0 (max 0), count 0, reinforced
# 0.30000000000000004 - 0.3 = 5.55e-17 (tiny positive), not exactly 0
assert_eq(f64_lt(fatigue_alarm_habituation(re), TOL), 1, "habituation near 0 after reinforce");
assert_eq(FatigueState_alarm_count(re), 0, "alarm count reset to 0");
assert_eq(FatigueState_alarm_reinforced(re), 1, "reinforced flag set");

# reinforce floors at 0 when habituation already small
var re2 = fatigue_new();
fatigue_record_call(re2, f64_from(1), 1);  # hab 0.1
fatigue_reinforce_alarm(re2);              # 0.1 - 0.3 -> max(0) = 0
assert_eq(fatigue_alarm_habituation(re2), 0, "habituation floors at 0 on reinforce");

# ================================================================
test_group("clear_reinforcement() -- resets flag");
var cr = fatigue_new();
fatigue_reinforce_alarm(cr);
assert_eq(FatigueState_alarm_reinforced(cr), 1, "reinforced before clear");
fatigue_clear_reinforcement(cr);
assert_eq(FatigueState_alarm_reinforced(cr), 0, "cleared after clear_reinforcement");
# after clearing, a new unreinforced alarm raises habituation again
fatigue_record_call(cr, f64_from(1), 1);
assert_eq(fatigue_alarm_habituation(cr), 0x3fb999999999999a, "habituation rises after clear+alarm");

# ================================================================
test_group("modifiers() -- fresh state (identity-ish)");
var fresh = fatigue_new();
var m0 = fatigue_modifiers(fresh);
# pitch = -0*20 = -0.0 (bit-differs from +0.0); check magnitude
assert_eq(f64_lt(f64_abs(FatigueModifiers_pitch_offset(m0)), TOL), 1, "fresh pitch ~ 0");
assert_eq(FatigueModifiers_breathiness_delta(m0), 0, "fresh breathiness == 0");
assert_eq(FatigueModifiers_amplitude_scale(m0), 0x3ff0000000000000, "fresh amplitude == 1.0");
assert_eq(FatigueModifiers_jitter_scale(m0), 0x3ff0000000000000, "fresh jitter == 1.0");

# ================================================================
test_group("modifiers() -- at fatigue 0.15");
var f15 = fatigue_new();
fatigue_record_call(f15, f64_from(10), 0);   # fatigue = 0.15
var m1 = fatigue_modifiers(f15);
# pitch = -0.15*20 = -3.0
assert_eq(FatigueModifiers_pitch_offset(m1), 0xc008000000000000, "pitch == -3.0");
# breathiness = 0.15*0.2 = 0.03
assert_eq(FatigueModifiers_breathiness_delta(m1), 0x3f9eb851eb851eb8, "breathiness == 0.03");
# amplitude = (1-0.15*0.4)*(1-0*0.5) = 0.94
assert_eq(FatigueModifiers_amplitude_scale(m1), 0x3fee147ae147ae14, "amplitude == 0.94");
# jitter = 1 + 0.15*1.5 = 1.225
assert_eq(FatigueModifiers_jitter_scale(m1), 0x3ff399999999999a, "jitter == 1.225");

# ================================================================
test_group("modifiers() -- habituation cuts amplitude");
var mh = fatigue_new();
fatigue_record_call(mh, f64_from(1), 1);     # fatigue = 0.015, hab = 0.1
var m2 = fatigue_modifiers(mh);
# amp = (1 - 0.015*0.4) * (1 - 0.1*0.5); fatigue tiny so ~0.994*0.95
# assert amplitude strictly below the hab-only 0.95 (fatigue also present)
assert_eq(f64_lt(FatigueModifiers_amplitude_scale(m2), 0x3fee666666666666), 1, "amp below 0.95 (fatigue+hab both cut)");
assert_eq(f64_lt(FatigueModifiers_amplitude_scale(m2), F64_ONE), 1, "amp below 1.0");

# ================================================================
test_group("modifiers() -- full fatigue extremes");
var full = fatigue_new();
fatigue_record_call(full, f64_from(100), 0); # fatigue clamps to 1.0
var m3 = fatigue_modifiers(full);
# pitch = -1.0*20 = -20.0
assert_eq(FatigueModifiers_pitch_offset(m3), 0xc034000000000000, "full pitch == -20.0");
# breathiness = 1.0*0.2 = 0.2
assert_eq(FatigueModifiers_breathiness_delta(m3), 0x3fc999999999999a, "full breathiness == 0.2");
# amplitude = (1-0.4)*(1-0) = 0.6
assert_eq(FatigueModifiers_amplitude_scale(m3), 0x3fe3333333333333, "full amplitude == 0.6");
# jitter = 1 + 1.5 = 2.5
assert_eq(FatigueModifiers_jitter_scale(m3), 0x4004000000000000, "full jitter == 2.5");

# ================================================================
test_group("reset() -- clears all state");
var rs = fatigue_new();
fatigue_record_call(rs, f64_from(10), 1);
fatigue_reset(rs);
assert_eq(fatigue_fatigue(rs), 0, "reset fatigue == 0");
assert_eq(fatigue_alarm_habituation(rs), 0, "reset habituation == 0");
assert_eq(FatigueState_bout_calling_time(rs), 0, "reset bout time == 0");
assert_eq(FatigueState_alarm_count(rs), 0, "reset alarm count == 0");
assert_eq(FatigueState_alarm_reinforced(rs), 0, "reset reinforced == 0");

# ================================================================
# serde roundtrip (ports the Rust #[derive(Serialize, Deserialize)] on
# FatigueState + FatigueModifiers — state persistence).
test_group("FatigueState serde roundtrip");
var fs = fatigue_new();
# advance so every field is non-default: fatigue=64*0.015=0.96, bout=64.0,
# alarm_count=1, habituation=0.1 (alarm). dur=64 chosen so all f64 fields (and
# every derived modifier) print to a shortest-decimal that reparses bit-exact.
fatigue_record_call(fs, f64_from(64), 1);
var sb = str_builder_new();
FatigueState_to_json(fs, sb);
var jstr = str_data(str_builder_build(sb));
var fs2 = FatigueState_from_json_str(jstr);
assert_eq(FatigueState_fatigue(fs2), FatigueState_fatigue(fs), "fatigue roundtrips");
assert_eq(FatigueState_alarm_habituation(fs2), FatigueState_alarm_habituation(fs), "alarm_habituation roundtrips");
assert_eq(FatigueState_bout_calling_time(fs2), FatigueState_bout_calling_time(fs), "bout_calling_time roundtrips");
assert_eq(FatigueState_alarm_count(fs2), FatigueState_alarm_count(fs), "alarm_count roundtrips");
assert_eq(FatigueState_alarm_reinforced(fs2), FatigueState_alarm_reinforced(fs), "alarm_reinforced roundtrips");
# re-serialize is idempotent
var sbf = str_builder_new();
FatigueState_to_json(fs2, sbf);
# length first: memeq over strlen() is a PREFIX compare, so a re-serialization
# that APPENDED a field would pass it. The oracle compared whole strings.
var jstr_2 = str_data(str_builder_build(sbf));
assert_eq(strlen(jstr_2), strlen(jstr), "FatigueState json idempotent -- same length");
assert_eq(memeq(jstr, jstr_2, strlen(jstr)), 1, "FatigueState json idempotent");

# ================================================================
test_group("FatigueModifiers serde roundtrip");
var fm = fatigue_modifiers(fs);   # non-default modifiers from the advanced state above
var sbm = str_builder_new();
FatigueModifiers_to_json(fm, sbm);
var mstr = str_data(str_builder_build(sbm));
var fm2 = FatigueModifiers_from_json_str(mstr);
assert_eq(FatigueModifiers_pitch_offset(fm2), FatigueModifiers_pitch_offset(fm), "pitch_offset roundtrips");
assert_eq(FatigueModifiers_breathiness_delta(fm2), FatigueModifiers_breathiness_delta(fm), "breathiness_delta roundtrips");
assert_eq(FatigueModifiers_amplitude_scale(fm2), FatigueModifiers_amplitude_scale(fm), "amplitude_scale roundtrips");
assert_eq(FatigueModifiers_jitter_scale(fm2), FatigueModifiers_jitter_scale(fm), "jitter_scale roundtrips");
# re-serialize is idempotent
var sbm2 = str_builder_new();
FatigueModifiers_to_json(fm2, sbm2);
# length first: memeq over strlen() is a PREFIX compare, so a re-serialization
# that APPENDED a field would pass it. The oracle compared whole strings.
var mstr_2 = str_data(str_builder_build(sbm2));
assert_eq(strlen(mstr_2), strlen(mstr), "FatigueModifiers json idempotent -- same length");
assert_eq(memeq(mstr, mstr_2, strlen(mstr)), 1, "FatigueModifiers json idempotent");

# ================================================================
# 2.0.5 -- input-range validation (roadmap 2.0.5, audit finding F11).
# The accepted duration range for record_call() and rest() is [0, 1e9] seconds
# inclusive; see the PR_FAT_MAX_DURATION_S block in src/fatigue.cyr for why.
# Everything below is a NEW group: no assertion above this line changed, because
# the guards only ever fire on input the oracle had no business accepting.
# ================================================================
var G_NAN     = 0x7ff8000000000000;   # canonical quiet NaN
var G_NEG_ONE = 0xbff0000000000000;   # -1.0
var G_1E300   = 0x7e37e43c8800759c;   # 1e300 -- finite, far past the 1e9 bound
var G_TWENTY  = 0x4034000000000000;   # 20.0
var G_TEN     = 0x4024000000000000;   # 10.0
var G_015     = 0x3fc3333333333333;   # 0.15  -- fatigue after one 10 s call
var G_01      = 0x3fb999999999999a;   # 0.1   -- habituation after one alarm

# The measured behaviour the two guards exist to prevent. These pin facts about
# the stdlib, not about prani: if any of them changes, the guard rationale in
# src/fatigue.cyr is stale and must be re-derived rather than trusted.
test_group("2.0.5 -- measured facts the duration guards rest on");
assert_eq(f64_clamp(G_NAN, 0, F64_ONE), G_NAN, "f64_clamp passes NaN straight through (F11)");
assert_eq(f64_clamp(PRANI_POS_INF, 0, F64_ONE), F64_ONE, "f64_clamp DOES bound +inf to hi");
assert_eq(f64_clamp(PRANI_NEG_INF, 0, F64_ONE), 0, "f64_clamp DOES bound -inf to lo");
assert_eq(f64_max(G_NAN, 0), 0, "f64_max(NaN, 0) == 0 -- NaN is dropped, not propagated");
assert_eq(f64_max(0, G_NAN), G_NAN, "f64_max(0, NaN) == NaN -- f64_max is ASYMMETRIC");
assert_eq(f64_gt(G_NAN, PR_FAT_BOUT_RESET_SECS), 0, "f64_gt(NaN, 5.0) == 0 -- a NaN rest never resets the bout");
assert_eq(prani_in_range(G_NAN, 0, PR_FAT_MAX_DURATION_S), 0, "duration guard rejects NaN");
assert_eq(prani_in_range(PRANI_POS_INF, 0, PR_FAT_MAX_DURATION_S), 0, "duration guard rejects +inf");
assert_eq(prani_in_range(PRANI_NEG_INF, 0, PR_FAT_MAX_DURATION_S), 0, "duration guard rejects -inf");
assert_eq(prani_in_range(G_NEG_ONE, 0, PR_FAT_MAX_DURATION_S), 0, "duration guard rejects -1.0");
assert_eq(prani_in_range(G_1E300, 0, PR_FAT_MAX_DURATION_S), 0, "duration guard rejects 1e300");
assert_eq(prani_in_range(0, 0, PR_FAT_MAX_DURATION_S), 1, "duration guard ACCEPTS 0 (zero duration is valid)");
assert_eq(prani_in_range(PR_FAT_MAX_DURATION_S, 0, PR_FAT_MAX_DURATION_S), 1, "duration guard accepts the bound itself");

# ================================================================
# record_call has no error channel, so a bad duration is logged (prani_log_error)
# and the whole call event is dropped. Before the guard, each of the five
# durations below poisoned the state: NaN made every field NaN forever, +/-inf
# made bout_calling_time infinite, -1.0 and 1e300 made it nonsense.
test_group("2.0.5 -- record_call rejects out-of-range duration");
var g = fatigue_new();
fatigue_record_call(g, f64_from(10), 1);        # valid: fatigue 0.15, bout 10.0, hab 0.1, count 1
fatigue_record_call(g, G_NAN, 1);
assert_eq(fatigue_fatigue(g), G_015, "NaN duration leaves fatigue at 0.15");
assert_eq(FatigueState_bout_calling_time(g), G_TEN, "NaN duration leaves bout time at 10.0");
assert_eq(fatigue_alarm_habituation(g), G_01, "NaN duration leaves habituation at 0.1");
assert_eq(FatigueState_alarm_count(g), 1, "a rejected alarm call is not counted");
fatigue_record_call(g, PRANI_POS_INF, 0);
assert_eq(FatigueState_bout_calling_time(g), G_TEN, "+inf duration leaves bout time at 10.0");
fatigue_record_call(g, PRANI_NEG_INF, 0);
assert_eq(FatigueState_bout_calling_time(g), G_TEN, "-inf duration leaves bout time at 10.0");
fatigue_record_call(g, G_NEG_ONE, 0);
assert_eq(FatigueState_bout_calling_time(g), G_TEN, "negative duration leaves bout time at 10.0");
assert_eq(fatigue_fatigue(g), G_015, "negative duration leaves fatigue at 0.15");
fatigue_record_call(g, G_1E300, 0);
assert_eq(FatigueState_bout_calling_time(g), G_TEN, "1e300 (past the 1e9 bound) leaves bout time at 10.0");
# The state is still USABLE afterwards -- a rejection is not a retirement.
fatigue_record_call(g, f64_from(10), 0);
assert_eq(FatigueState_bout_calling_time(g), G_TWENTY, "bout == 20.0 after a valid call follows five rejections");
# ...and bit-identical to a run that never made the five bad calls at all.
var gc = fatigue_new();
fatigue_record_call(gc, f64_from(10), 1);
fatigue_record_call(gc, f64_from(10), 0);
assert_eq(fatigue_fatigue(g), fatigue_fatigue(gc), "fatigue bit-identical to a clean run");
assert_eq(FatigueState_bout_calling_time(g), FatigueState_bout_calling_time(gc), "bout time bit-identical to a clean run");
assert_eq(fatigue_alarm_habituation(g), fatigue_alarm_habituation(gc), "habituation bit-identical to a clean run");
assert_eq(FatigueState_alarm_count(g), FatigueState_alarm_count(gc), "alarm count bit-identical to a clean run");

# ================================================================
# Zero is VALID, not rejected -- the oracle's test_zero_duration_synthesis
# settles that a zero duration is an empty result, never an error. So is the
# upper bound itself: prani_in_range is inclusive at both ends.
test_group("2.0.5 -- record_call still accepts 0 and the bound");
var z = fatigue_new();
fatigue_record_call(z, f64_from(10), 0);
fatigue_record_call(z, 0, 1);
assert_eq(fatigue_fatigue(z), G_015, "zero duration is a no-op on fatigue, not a rejection");
assert_eq(FatigueState_bout_calling_time(z), G_TEN, "zero duration is a no-op on bout time");
assert_eq(FatigueState_alarm_count(z), 1, "zero duration STILL counts as an alarm call");
assert_eq(fatigue_alarm_habituation(z), G_01, "zero duration STILL raises habituation");
var bnd = fatigue_new();
fatigue_record_call(bnd, PR_FAT_MAX_DURATION_S, 0);
assert_eq(fatigue_fatigue(bnd), F64_ONE, "1e9 s accepted at the inclusive bound -- fatigue clamps to 1.0");
assert_eq(FatigueState_bout_calling_time(bnd), PR_FAT_MAX_DURATION_S, "1e9 s accepted -- bout time == 1e9");

# ================================================================
# rest() is the more dangerous of the two, because f64_max(NaN, 0) is 0: a NaN
# rest did not poison anything visibly, it quietly reported a mid-bout creature
# as fully rested and fully de-habituated. A negative rest ran the recovery
# backwards with no ceiling (rest(-1000) gave fatigue 70.15, well outside [0,1]).
test_group("2.0.5 -- rest rejects out-of-range duration");
var rq = fatigue_new();
fatigue_record_call(rq, f64_from(10), 1);       # fatigue 0.15, hab 0.1, bout 10.0
fatigue_rest(rq, G_NAN);
assert_eq(fatigue_fatigue(rq), G_015, "NaN rest no longer zeroes fatigue");
assert_eq(fatigue_alarm_habituation(rq), G_01, "NaN rest no longer zeroes habituation");
fatigue_rest(rq, PRANI_NEG_INF);
assert_eq(fatigue_fatigue(rq), G_015, "-inf rest no longer drives fatigue to +inf");
assert_eq(prani_is_finite(fatigue_fatigue(rq)), 1, "fatigue stays finite through a -inf rest");
fatigue_rest(rq, PRANI_POS_INF);
assert_eq(fatigue_fatigue(rq), G_015, "+inf rest no longer zeroes fatigue");
assert_eq(FatigueState_bout_calling_time(rq), G_TEN, "+inf rest no longer resets the bout");
fatigue_rest(rq, G_NEG_ONE);
assert_eq(fatigue_fatigue(rq), G_015, "negative rest no longer runs recovery backwards");
assert_eq(f64_le(fatigue_fatigue(rq), F64_ONE), 1, "fatigue stays inside its documented [0,1]");
fatigue_rest(rq, G_1E300);
assert_eq(fatigue_fatigue(rq), G_015, "1e300 rest (past the 1e9 bound) rejected");
assert_eq(fatigue_alarm_habituation(rq), G_01, "habituation survives all four rejected rests");

# ================================================================
test_group("2.0.5 -- rest still accepts 0 and the bound");
var rz = fatigue_new();
fatigue_record_call(rz, f64_from(10), 1);
fatigue_rest(rz, 0);
assert_eq(fatigue_fatigue(rz), G_015, "zero rest is a no-op, not a rejection");
assert_eq(FatigueState_bout_calling_time(rz), G_TEN, "zero rest does not reset the bout (0 is not > 5)");
fatigue_rest(rz, PR_FAT_MAX_DURATION_S);
assert_eq(fatigue_fatigue(rz), 0, "1e9 s rest accepted at the bound -- fatigue floors at 0");
assert_eq(fatigue_alarm_habituation(rz), 0, "1e9 s rest accepted -- habituation floors at 0");
assert_eq(FatigueState_bout_calling_time(rz), 0, "1e9 s rest accepted -- bout reset (> 5 s)");

# ================================================================
# The point of the two mutator guards: modifiers() is no longer reachable in a
# NaN state through ANY sequence of public calls on a state prani built.
test_group("2.0.5 -- modifiers() unpoisonable through the mutators");
var pm = fatigue_new();
fatigue_record_call(pm, f64_from(10), 1);
fatigue_record_call(pm, G_NAN, 1);
fatigue_rest(pm, G_NAN);
fatigue_record_call(pm, PRANI_POS_INF, 0);
var mpm = fatigue_modifiers(pm);
assert_eq(prani_is_finite(FatigueModifiers_pitch_offset(mpm)), 1, "pitch_offset finite after rejected calls");
assert_eq(prani_is_finite(FatigueModifiers_breathiness_delta(mpm)), 1, "breathiness_delta finite after rejected calls");
assert_eq(prani_is_finite(FatigueModifiers_amplitude_scale(mpm)), 1, "amplitude_scale finite after rejected calls");
assert_eq(prani_is_finite(FatigueModifiers_jitter_scale(mpm)), 1, "jitter_scale finite after rejected calls");
assert_eq(FatigueModifiers_pitch_offset(mpm), 0xc008000000000000, "pitch == -3.0, exactly the clean-state value");

# ================================================================
# What 2.0.5 could NOT close in this module, pinned so it is not believed fixed.
# modifiers_make returns a POINTER and has no error channel; giving it one is a
# return-contract change (roadmap 2.1.0). It therefore REPORTS a non-finite
# field through prani_log_error and hands back what it was given, unaltered --
# substituting the identity modifiers (0, 0, 1, 1) would be exactly the
# plausible fabrication ADR-0001 rules out.
test_group("2.0.5 -- modifiers_make reports but cannot reject");
var mk = fatigue_modifiers_make(G_NAN, 0, F64_ONE, F64_ONE);
assert_gt(mk, 0, "modifiers_make still returns a pointer, never a PRANI_ERR_* code");
assert_eq(FatigueModifiers_pitch_offset(mk), G_NAN, "the non-finite field is returned unaltered, not substituted");
assert_eq(FatigueModifiers_amplitude_scale(mk), F64_ONE, "the finite fields are untouched");

# The one remaining producer of a poisoned state: FatigueState_from_json_str is
# derive-generated and takes any i64 per field, so a document prani did not
# write can still carry a NaN bit pattern. That is the deserializer-field-range
# half of 2.0.5 and it belongs with the derive, not with this module -- the log
# line from modifiers_make is the only report available here.
var jbad = "{\"fatigue\":9221120237041090560,\"alarm_habituation\":0,\"bout_calling_time\":0,\"alarm_count\":0,\"alarm_reinforced\":0}";
var sbad = FatigueState_from_json_str(jbad);
assert_gt(sbad, 0, "the hand-written document still parses (it is well-formed)");
assert_eq(FatigueState_fatigue(sbad), G_NAN, "and still carries a NaN fatigue -- known gap");
var mbad = fatigue_modifiers(sbad);
assert_eq(prani_is_finite(FatigueModifiers_pitch_offset(mbad)), 0, "so modifiers() off it is still NaN -- known gap");

var rc = assert_summary();
syscall(60, rc);

# sequence.tcyr -- tests for src/sequence.cyr.
# Struct constructors/accessors + the full synthesize/chorus paths. The latter
# route through the whole voice → tract → svara stack, so they were untestable
# until voice.cyr landed; now included, they lock the bout/phrase/chorus
# structure (call count + inter-call gaps, phrase gaps, chorus mix length +
# error propagation). serde/Display tests dropped.
#
# Include order: sequence BEFORE species (species uses the CallBout struct);
# voice AFTER sequence (sequence's synthesize forward-references crvoice_* —
# Cyrius resolves forward refs across the unit).

include "src/error.cyr"
include "src/logging.cyr"
include "src/rng.cyr"
include "src/dsp.cyr"
include "src/vocalization.cyr"
include "src/sequence.cyr"
include "src/species.cyr"
include "src/bridge.cyr"
include "src/tract.cyr"
include "src/voice.cyr"

# ---- test constants (IEEE-754 hex) -----------------------------------------
# The oracle's own fixtures (rust-old/tests/integration.rs, tag 2.0.3) all run
# at 44100 Hz; the older groups below run at 8000 Hz and keep their own
# CALL_D (0.05) / GAP_I (0.1), which the new groups reuse BY VALUE, not by role.
var T_SR_44100 = 0x40e5888000000000;   # 44100.0
var T_0_2      = 0x3fc999999999999a;   # 0.2
var T_0_3      = 0x3fd3333333333333;   # 0.3
var T_0_8      = 0x3fe999999999999a;   # 0.8
var T_1_2      = 0x3ff3333333333333;   # 1.2
var T_1_4      = 0x3ff6666666666666;   # 1.4
var T_500      = 0x407f400000000000;   # 500.0 = wolf f0_default 400 / size 0.8

alloc_init();

# ---- helpers ---------------------------------------------------------------
# t_all_finite(v) -- 1 iff every element passes prani_is_finite.
#must_use
fn t_all_finite(v) {
    var n = vec_len(v);
    var k = 0;
    while (k < n) {
        if (prani_is_finite(vec_get(v, k)) == 0) { return 0; }
        k = k + 1;
    }
    return 1;
}

# t_any_nonzero(v, lo, hi) -- 1 iff some sample in [lo, hi) is not +0.0. Used as
# a silence control: an all-zero buffer passes every length/finiteness assert.
#must_use
fn t_any_nonzero(v, lo, hi) {
    var k = lo;
    while (k < hi) {
        if (vec_get(v, k) != 0) { return 1; }
        k = k + 1;
    }
    return 0;
}

# ================================================================
test_group("CallElement construction + accessors");
var e = sequence_call_element_new(PRANI_VOC_CHIRP, F64_ONE, F64_HALF);
assert_eq(CallElement_vocalization(e), PRANI_VOC_CHIRP, "element voc");
assert_eq(CallElement_duration(e), F64_ONE, "element duration");
assert_eq(CallElement_gap(e), F64_HALF, "element gap");

# ================================================================
test_group("CallBout construction + accessors");
var b = sequence_call_bout_new(PRANI_VOC_HOWL, 3, f64_from(3), f64_from(2), PRANI_INTENT_SOCIAL);
assert_eq(CallBout_vocalization(b), PRANI_VOC_HOWL, "bout voc");
assert_eq(CallBout_count(b), 3, "bout count");
assert_eq(CallBout_intent(b), PRANI_INTENT_SOCIAL, "bout intent");

# ================================================================
test_group("CallPhrase construction + accessors");
var elems = vec_new();
vec_push(elems, sequence_call_element_new(PRANI_VOC_CHIRP, F64_HALF, f64_from(0)));
vec_push(elems, sequence_call_element_new(PRANI_VOC_TRILL, F64_ONE, F64_HALF));
var p = sequence_call_phrase_new(elems, PRANI_INTENT_MATING);
assert_eq(vec_len(CallPhrase_elements(p)), 2, "phrase has 2 elements");
assert_eq(CallPhrase_intent(p), PRANI_INTENT_MATING, "phrase intent");

# ================================================================
# Full synthesize path: Wolf howl bout. Social intent (duration_scale 1.0), so
# each call = f64_to(call_duration*sr) samples; a gap of f64_to(interval*sr)
# separates each of the (count-1) inter-call boundaries.
#   sr=8000, call_duration=0.05 -> 400 samples/call; interval=0.1 -> 800 gap.
#   count=2 -> total = 2*400 + 1*800 = 1600.
test_group("CallBout::synthesize -- Wolf howl (structure + finiteness)");
var SR = f64_from(8000);
var CALL_D = 0x3FA999999999999A;   # 0.05
var GAP_I  = 0x3FB999999999999A;   # 0.1
var wolf = crvoice_new(PRANI_SP_WOLF);
var wbout = sequence_call_bout_new(PRANI_VOC_HOWL, 2, CALL_D, GAP_I, PRANI_INTENT_SOCIAL);
var bout_buf = sequence_call_bout_synthesize(wbout, wolf, SR);
assert_eq(prani_is_err(bout_buf), 0, "bout synth is not an error");
assert_eq(vec_len(bout_buf), 1600, "bout length = 2*400 + 800 gap");
# all finite
var i = 0;
var all_finite = 1;
while (i < vec_len(bout_buf)) {
    if (prani_is_finite(vec_get(bout_buf, i)) == 0) { all_finite = 0; }
    i = i + 1;
}
assert_eq(all_finite, 1, "all bout samples finite");

# determinism: same bout + fresh voice -> identical length + first sample
var wolf2 = crvoice_new(PRANI_SP_WOLF);
var bout_buf2 = sequence_call_bout_synthesize(wbout, wolf2, SR);
assert_eq(vec_len(bout_buf2), vec_len(bout_buf), "deterministic length");
assert_eq(vec_get(bout_buf2, 200), vec_get(bout_buf, 200), "deterministic sample[200]");

# ================================================================
# The oracle's own bout -- rust-old/tests/integration.rs:495-517 (tag 2.0.3):
# Dog / BARK / Alarm / count 3 at 44100 Hz. This is the only place Dog is
# synthesized and the only place BARK is, so it is what covers the BARK pitch
# contour and the Bark/Yelp/Chirp envelope arm.
# Alarm's duration_scale is 0.7, and 0.2*0.7 is 0.13999999999999999 in f64, so
# 0.2*0.7*44100 == 6173.999999999999 and f64_to TRUNCATES it to 6173 (not 6174).
# Gaps are f64_to(0.3*44100) == 13230 at the two interior boundaries:
#   total = 3*6173 + 2*13230 = 18519 + 26460 = 44979.
test_group("CallBout::synthesize -- oracle Dog bark alarm bout @ 44100");
var dogv = crvoice_new(PRANI_SP_DOG);
var dbout = sequence_call_bout_new(PRANI_VOC_BARK, 3, T_0_2, T_0_3, PRANI_INTENT_ALARM);
var dbuf = sequence_call_bout_synthesize(dbout, dogv, T_SR_44100);
assert_eq(prani_is_err(dbuf), 0, "dog bark alarm bout non-error");
assert_eq(vec_len(dbuf), 44979, "3 alarm barks (6173) + 2 gaps (13230)");
assert_eq(t_all_finite(dbuf), 1, "all dog bark bout samples finite");
# Controls: the first bark must be audible, and the first interval must be true
# silence at exactly the computed offset -- together these pin the layout, not
# just the total length (an all-zero buffer of the right size would fail).
assert_eq(t_any_nonzero(dbuf, 0, 6173), 1, "first bark is not silence");
assert_eq(t_any_nonzero(dbuf, 6173, 19403), 0, "first interval is silence");

# ================================================================
test_group("CallBout::synthesize -- error propagates (Snake cannot howl)");
var snake = crvoice_new(PRANI_SP_SNAKE);
var sbout = sequence_call_bout_new(PRANI_VOC_HOWL, 2, CALL_D, GAP_I, PRANI_INTENT_SOCIAL);
var serr = sequence_call_bout_synthesize(sbout, snake, SR);
assert_eq(prani_is_err(serr), 1, "snake howl bout -> error");
assert_eq(serr, PRANI_ERR_INVALID_VOCALIZATION, "-> INVALID_VOCALIZATION");

# ================================================================
# Phrase: two elements (howl 0.05s gap 0.1s, howl 0.05s gap 0.0s).
#   each call 400 samples; gaps 800 + 0 -> total = 400+800 + 400+0 = 1600.
test_group("CallPhrase::synthesize -- structure + finiteness");
var pelems = vec_new();
vec_push(pelems, sequence_call_element_new(PRANI_VOC_HOWL, CALL_D, GAP_I));
vec_push(pelems, sequence_call_element_new(PRANI_VOC_HOWL, CALL_D, f64_from(0)));
var phrase = sequence_call_phrase_new(pelems, PRANI_INTENT_SOCIAL);
var wolf3 = crvoice_new(PRANI_SP_WOLF);
var phrase_buf = sequence_call_phrase_synthesize(phrase, wolf3, SR);
assert_eq(prani_is_err(phrase_buf), 0, "phrase synth not an error");
assert_eq(vec_len(phrase_buf), 1600, "phrase length = (400+800)+(400+0)");
assert_eq(t_all_finite(phrase_buf), 1, "all phrase samples finite");

# ================================================================
# The oracle's own phrase -- rust-old/tests/integration.rs:519-546 (tag 2.0.3):
# Songbird under Mating intent (duration_scale 2.0) at 44100 Hz, three elements
#   Chirp 0.1s gap 0.05s | Trill 0.3s gap 0.1s | Chirp 0.1s gap 0.0s
# so unlike the homogeneous phrase above the vocalization, duration and gap all
# vary per element. This is the only CHIRP synthesis and the only Mating-intent
# synthesis on a sequence path.
#   calls f64_to(dur*2.0*44100): 0.1 -> 8820, 0.3 -> 26460, 0.1 -> 8820
#   gaps  f64_to(gap*44100)    : 0.05 -> 2205, 0.1 -> 4410, 0.0 -> 0
#   total = 8820 + 2205 + 26460 + 4410 + 8820 = 50715.
test_group("CallPhrase::synthesize -- oracle Songbird chirp/trill/chirp @ 44100");
var bvoice = crvoice_new(PRANI_SP_SONGBIRD);
var bels = vec_new();
vec_push(bels, sequence_call_element_new(PRANI_VOC_CHIRP, GAP_I, CALL_D));
vec_push(bels, sequence_call_element_new(PRANI_VOC_TRILL, T_0_3, GAP_I));
vec_push(bels, sequence_call_element_new(PRANI_VOC_CHIRP, GAP_I, f64_from(0)));
var bphrase = sequence_call_phrase_new(bels, PRANI_INTENT_MATING);
var bbuf = sequence_call_phrase_synthesize(bphrase, bvoice, T_SR_44100);
assert_eq(prani_is_err(bbuf), 0, "songbird chirp/trill/chirp phrase non-error");
assert_eq(vec_len(bbuf), 50715, "8820 + 2205 + 26460 + 4410 + 8820 (Mating x2)");
assert_eq(t_all_finite(bbuf), 1, "all songbird phrase samples finite");
# Controls: the first chirp is audible, its 2205-sample gap is true silence, and
# the trill after that gap is audible again -- so the per-element offsets are
# pinned, not merely the sum.
assert_eq(t_any_nonzero(bbuf, 0, 8820), 1, "first chirp is not silence");
assert_eq(t_any_nonzero(bbuf, 8820, 11025), 0, "gap after first chirp is silence");
assert_eq(t_any_nonzero(bbuf, 11025, 37485), 1, "trill is not silence");

# ================================================================
# Chorus: 2 wolves, duration 0.05s, timing_spread 0.05s.
#   base = f64_to(0.05*8000)=400; max_offset = f64_to(0.05*8000)=400.
#   total_len = base + max_offset*2 = 400 + 800 = 1200.
test_group("synthesize_chorus -- mix length + finiteness");
var voices = vec_new();
vec_push(voices, crvoice_new(PRANI_SP_WOLF));
vec_push(voices, crvoice_new(PRANI_SP_WOLF));
var chorus = sequence_synthesize_chorus(voices, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, SR, CALL_D, CALL_D);
assert_eq(prani_is_err(chorus), 0, "chorus not an error");
assert_eq(vec_len(chorus), 1200, "chorus length = base 400 + 2*400 spread");
var j = 0;
var chorus_finite = 1;
while (j < vec_len(chorus)) {
    if (prani_is_finite(vec_get(chorus, j)) == 0) { chorus_finite = 0; }
    j = j + 1;
}
assert_eq(chorus_finite, 1, "all chorus samples finite");

# empty chorus early return
var empty_chorus = sequence_synthesize_chorus(vec_new(), PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, SR, F64_ONE, F64_HALF);
assert_eq(vec_len(empty_chorus), 0, "empty voices -> empty chorus");

# ================================================================
# The oracle's own chorus -- rust-old/tests/integration.rs:548-565 (tag 2.0.3):
# FOUR wolves at sizes 0.8 / 1.0 / 1.2 / 1.4, duration 1.0 s, timing_spread
# 0.2 s, at 44100 Hz. The 2-voice chorus above mixes two bit-identical default
# wolves (effectively 2x one signal); this one is the only heterogeneous mix, and
# the only one to reach the voice_count*7919 = 4*7919 seed and the 1/sqrt(4)
# normalization (src/sequence.cyr:214,241).
#   base = f64_to(1.0*44100) = 44100; max_offset = f64_to(0.2*44100) = 8820;
#   total_len = 44100 + 2*8820 = 61740.
test_group("synthesize_chorus -- oracle 4 size-varied wolves @ 44100");
var qvoices = vec_new();
vec_push(qvoices, crvoice_with_size(crvoice_new(PRANI_SP_WOLF), T_0_8));
vec_push(qvoices, crvoice_with_size(crvoice_new(PRANI_SP_WOLF), F64_ONE));
vec_push(qvoices, crvoice_with_size(crvoice_new(PRANI_SP_WOLF), T_1_2));
vec_push(qvoices, crvoice_with_size(crvoice_new(PRANI_SP_WOLF), T_1_4));
# Control that the four voices really are distinct: effective_f0 is
# f0_default/size_scale clamped to [150, 1200], so the 0.8 wolf sits at exactly
# 400/0.8 = 500 Hz and must be pitched above the 1.4 wolf (400/1.4 = 285.7).
var qf0_small = crvoice_effective_f0(vec_get(qvoices, 0));
var qf0_large = crvoice_effective_f0(vec_get(qvoices, 3));
assert_eq(qf0_small, T_500, "size 0.8 wolf effective_f0 == 500");
assert_eq(f64_gt(qf0_small, qf0_large), 1, "size 0.8 wolf pitched above size 1.4");
var qchorus = sequence_synthesize_chorus(qvoices, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR_44100, F64_ONE, T_0_2);
assert_eq(prani_is_err(qchorus), 0, "4-voice chorus not an error");
assert_eq(vec_len(qchorus), 61740, "4-voice chorus length = 44100 + 2*8820");
assert_eq(t_all_finite(qchorus), 1, "all 4-voice chorus samples finite");
assert_eq(t_any_nonzero(qchorus, 0, 61740), 1, "4-voice chorus is not silence");

# ================================================================
# serde roundtrip (restores the Rust #[derive(Serialize, Deserialize)] on
# CallElement / CallBout / CallPhrase). CallPhrase's element vec is hand-rolled.
test_group("sequence serde roundtrip");
var elser = sequence_call_element_new(PRANI_VOC_TRILL, 0x3FE6666666666666, 0x3FD3333333333333);   # 0.7, 0.3
var esb = str_builder_new();
CallElement_to_json(elser, esb);
var el2 = CallElement_from_json_str(str_data(str_builder_build(esb)));
assert_eq(CallElement_vocalization(el2), PRANI_VOC_TRILL, "element voc roundtrips");
assert_eq(CallElement_duration(el2), 0x3FE6666666666666, "element duration roundtrips");
assert_eq(CallElement_gap(el2), 0x3FD3333333333333, "element gap roundtrips");

var bser = sequence_call_bout_new(PRANI_VOC_HOWL, 3, 0x4008000000000000, f64_from(2), PRANI_INTENT_SOCIAL);   # 3.0, 2
var bsb = str_builder_new();
CallBout_to_json(bser, bsb);
var bo2 = CallBout_from_json_str(str_data(str_builder_build(bsb)));
assert_eq(CallBout_vocalization(bo2), PRANI_VOC_HOWL, "bout voc roundtrips");
assert_eq(CallBout_count(bo2), 3, "bout count roundtrips");
assert_eq(CallBout_call_duration(bo2), 0x4008000000000000, "bout call_duration roundtrips");
assert_eq(CallBout_intent(bo2), PRANI_INTENT_SOCIAL, "bout intent roundtrips");

# The oracle's own bout -- rust-old/tests/integration.rs:594-608 (tag 2.0.3).
# PRANI_VOC_HOWL above has discriminant 0, and bayan's int accessor yields 0 for
# a missing key, so that assertion survives a derive that dropped the
# "vocalization" key entirely. BARK's discriminant is 1, so this one does not.
# `interval` is round-tripped here too (asserted nowhere else).
var about = sequence_call_bout_new(PRANI_VOC_BARK, 3, T_0_2, T_0_3, PRANI_INTENT_ALARM);
var asb = str_builder_new();
CallBout_to_json(about, asb);
var ajson = str_data(str_builder_build(asb));
var abo2 = CallBout_from_json_str(ajson);
assert_eq(CallBout_vocalization(abo2), PRANI_VOC_BARK, "alarm bout voc roundtrips (nonzero)");
assert_eq(CallBout_count(abo2), 3, "alarm bout count roundtrips");
assert_eq(CallBout_call_duration(abo2), T_0_2, "alarm bout call_duration roundtrips");
assert_eq(CallBout_interval(abo2), T_0_3, "alarm bout interval roundtrips");
var asb2 = str_builder_new();
CallBout_to_json(abo2, asb2);
# length first: memeq over strlen() is a PREFIX compare, so a re-serialization
# that APPENDED a field would pass it. The oracle compared whole strings.
var ajson_2 = str_data(str_builder_build(asb2));
assert_eq(strlen(ajson_2), strlen(ajson), "bout json idempotent -- same length");
assert_eq(memeq(ajson, ajson_2, strlen(ajson)), 1, "bout json idempotent");

var pelems2 = vec_new();
vec_push(pelems2, sequence_call_element_new(PRANI_VOC_CHIRP, F64_HALF, f64_from(0)));
vec_push(pelems2, sequence_call_element_new(PRANI_VOC_TRILL, F64_ONE, F64_HALF));
var pser = sequence_call_phrase_new(pelems2, PRANI_INTENT_MATING);
var psb = str_builder_new();
sequence_call_phrase_to_json(pser, psb);
var pjson = str_data(str_builder_build(psb));
var ph2 = sequence_call_phrase_from_json_str(pjson);
assert_eq(CallPhrase_intent(ph2), PRANI_INTENT_MATING, "phrase intent roundtrips");
assert_eq(vec_len(CallPhrase_elements(ph2)), 2, "phrase 2 elements roundtrip");
assert_eq(CallElement_vocalization(vec_get(CallPhrase_elements(ph2), 1)), PRANI_VOC_TRILL, "phrase elem[1] voc roundtrips");
assert_eq(CallElement_gap(vec_get(CallPhrase_elements(ph2), 1)), F64_HALF, "phrase elem[1] gap roundtrips");
var psb2 = str_builder_new();
sequence_call_phrase_to_json(ph2, psb2);
# length first: memeq over strlen() is a PREFIX compare, so a re-serialization
# that APPENDED a field would pass it. The oracle compared whole strings.
var pjson_2 = str_data(str_builder_build(psb2));
assert_eq(strlen(pjson_2), strlen(pjson), "phrase json idempotent -- same length");
assert_eq(memeq(pjson, pjson_2, strlen(pjson)), 1, "phrase json idempotent");

# ================================================================
# rust-old/tests/integration.rs:619-651 (tag 2.0.3) -- SYNTHESIS half. Every
# species' own bout_template must render at 44100 Hz, non-empty and all finite.
# Non-error also carries the oracle's supports_vocalization invariant for free:
# crvoice_vocalize_with_intent returns PRANI_ERR_INVALID_VOCALIZATION for a pair
# the species cannot produce (src/voice.cyr:780-782), so a template naming a
# vocalization its own species does not support fails the first assert below.
# The template FIELD VALUES are asserted in tests/species.tcyr, not here.
# Failures accumulate into a bitmask of species indices, so a failure names the
# species instead of just the first one hit.
test_group("bout_template -- all 13 species synthesize finite @ 44100");
var bt_err_mask = 0;
var bt_empty_mask = 0;
var bt_inf_mask = 0;
var sp = 0;
while (sp < PRANI_SP_COUNT) {
    var tmpl = species_bout_template(sp);
    var tbuf = sequence_call_bout_synthesize(tmpl, crvoice_new(sp), T_SR_44100);
    if (prani_is_err(tbuf) == 1) {
        bt_err_mask = bt_err_mask | (1 << sp);
    } else {
        if (vec_len(tbuf) == 0) { bt_empty_mask = bt_empty_mask | (1 << sp); }
        if (t_all_finite(tbuf) == 0) { bt_inf_mask = bt_inf_mask | (1 << sp); }
    }
    sp = sp + 1;
}
assert_eq(bt_err_mask, 0, "every bout_template synthesizes (bitmask of failed species)");
assert_eq(bt_empty_mask, 0, "every bout_template is non-empty (bitmask)");
assert_eq(bt_inf_mask, 0, "every bout_template is all-finite (bitmask)");

# ================================================================
# 2.0.5 -- INPUT-RANGE VALIDATION. Ranges (src/sequence.cyr, top):
#   seconds (duration/gap/interval/spread)  finite, [0, 3600]
#   count / elements / voices               [0, 1024] syntheses per call
#   sample_rate                             finite, > 0
#   requested samples per buffer            [0, 2^24]
# Zero stays VALID -- the oracle's test_zero_duration_synthesis asserts an empty
# buffer, not an error. Every group below carries a valid-input control, because
# the failure mode of a range guard is rejecting something that used to work.
test_group("2.0.5 range helpers -- the boundaries are inclusive at both ends");
var T_NAN  = 0x7FF8000000000000;   # canonical quiet NaN
var T_3600 = f64_from(3600);       # PRANI_SEQ_MAX_SECONDS
var T_3601 = f64_from(3601);
assert_eq(prani_seq_seconds_ok(f64_from(0)), 1, "0 s accepted (zero duration is valid)");
assert_eq(prani_seq_seconds_ok(T_3600), 1, "3600 s accepted (upper bound inclusive)");
assert_eq(prani_seq_seconds_ok(T_3601), 0, "3601 s rejected");
assert_eq(prani_seq_seconds_ok(f64_neg(F64_ONE)), 0, "-1 s rejected");
assert_eq(prani_seq_seconds_ok(T_NAN), 0, "NaN rejected (F11: it passes every clamp)");
assert_eq(prani_seq_seconds_ok(PRANI_POS_INF), 0, "+inf rejected");
assert_eq(prani_seq_seconds_ok(PRANI_NEG_INF), 0, "-inf rejected");
assert_eq(prani_seq_count_ok(0), 1, "count 0 accepted (the oracle's u32 accepts it)");
assert_eq(prani_seq_count_ok(1024), 1, "count 1024 accepted (upper bound inclusive)");
assert_eq(prani_seq_count_ok(1025), 0, "count 1025 rejected");
assert_eq(prani_seq_count_ok((0 - 1)), 0, "count -1 rejected (unrepresentable in the oracle)");
assert_eq(prani_seq_samples_ok(f64_from(16777216)), 1, "2^24 samples accepted (bound inclusive)");
assert_eq(prani_seq_samples_ok(f64_from(16777217)), 0, "2^24 + 1 samples rejected");

# ================================================================
# The constructors return "pointer or negative code" -- the port's existing
# convention, so no signature changed. A heap pointer is never negative.
test_group("2.0.5 sequence_call_element_new rejects a bad span");
assert_eq(sequence_call_element_new(PRANI_VOC_CHIRP, T_NAN, F64_HALF), PRANI_ERR_INVALID_VOCALIZATION,
  "NaN duration -> INVALID_VOCALIZATION");
assert_eq(sequence_call_element_new(PRANI_VOC_CHIRP, PRANI_POS_INF, F64_HALF), PRANI_ERR_INVALID_VOCALIZATION,
  "+inf duration -> INVALID_VOCALIZATION");
assert_eq(sequence_call_element_new(PRANI_VOC_CHIRP, f64_neg(F64_ONE), F64_HALF), PRANI_ERR_INVALID_VOCALIZATION,
  "negative duration -> INVALID_VOCALIZATION");
assert_eq(sequence_call_element_new(PRANI_VOC_CHIRP, T_3601, F64_HALF), PRANI_ERR_INVALID_VOCALIZATION,
  "duration past 3600 s -> INVALID_VOCALIZATION");
assert_eq(sequence_call_element_new(PRANI_VOC_CHIRP, F64_ONE, T_NAN), PRANI_ERR_INVALID_VOCALIZATION,
  "NaN gap -> INVALID_VOCALIZATION");
assert_eq(sequence_call_element_new(PRANI_VOC_CHIRP, F64_ONE, f64_neg(F64_HALF)), PRANI_ERR_INVALID_VOCALIZATION,
  "negative gap -> INVALID_VOCALIZATION");
# controls: the two valid edges still build, with the fields untouched
var e_zero = sequence_call_element_new(PRANI_VOC_CHIRP, f64_from(0), f64_from(0));
assert_eq(prani_is_err(e_zero), 0, "control: a zero-duration element still builds");
assert_eq(CallElement_duration(e_zero), f64_from(0), "control: its duration is 0");
var e_max = sequence_call_element_new(PRANI_VOC_TRILL, T_3600, T_3600);
assert_eq(prani_is_err(e_max), 0, "control: a 3600 s element still builds");
assert_eq(CallElement_gap(e_max), T_3600, "control: its gap roundtrips");

# ================================================================
test_group("2.0.5 sequence_call_bout_new rejects a bad count or span");
assert_eq(sequence_call_bout_new(PRANI_VOC_HOWL, (0 - 1), CALL_D, GAP_I, PRANI_INTENT_SOCIAL),
  PRANI_ERR_INVALID_VOCALIZATION, "count -1 -> INVALID_VOCALIZATION");
assert_eq(sequence_call_bout_new(PRANI_VOC_HOWL, 1025, CALL_D, GAP_I, PRANI_INTENT_SOCIAL),
  PRANI_ERR_INVALID_VOCALIZATION, "count 1025 -> INVALID_VOCALIZATION");
assert_eq(sequence_call_bout_new(PRANI_VOC_HOWL, 2, T_NAN, GAP_I, PRANI_INTENT_SOCIAL),
  PRANI_ERR_INVALID_VOCALIZATION, "NaN call_duration -> INVALID_VOCALIZATION");
assert_eq(sequence_call_bout_new(PRANI_VOC_HOWL, 2, CALL_D, PRANI_POS_INF, PRANI_INTENT_SOCIAL),
  PRANI_ERR_INVALID_VOCALIZATION, "+inf interval -> INVALID_VOCALIZATION");
# controls: count 0 and count 1024 are both legal, and count 0 still renders an
# EMPTY buffer as a success (the oracle's u32 could hold 0 and looped zero times)
var b_zero = sequence_call_bout_new(PRANI_VOC_HOWL, 0, CALL_D, GAP_I, PRANI_INTENT_SOCIAL);
assert_eq(prani_is_err(b_zero), 0, "control: count 0 still builds");
var b_zero_buf = sequence_call_bout_synthesize(b_zero, crvoice_new(PRANI_SP_WOLF), SR);
assert_eq(prani_is_err(b_zero_buf), 0, "control: count 0 synthesizes as a SUCCESS");
assert_eq(vec_len(b_zero_buf), 0, "control: count 0 renders an empty buffer, not an error");
assert_eq(prani_is_err(sequence_call_bout_new(PRANI_VOC_HOWL, 1024, CALL_D, GAP_I, PRANI_INTENT_SOCIAL)), 0,
  "control: count 1024 still builds");

# ================================================================
# The synthesize entry points re-check the struct rather than trusting the
# constructor: CallBout_from_json_str and the derived setters have no error
# channel, so these fields can arrive unvalidated. Each "was" note below was
# MEASURED against this module's pre-guard source on the same tree, not assumed.
test_group("2.0.5 sequence_call_bout_synthesize -- sample_rate and the field recheck");
var g_wolf = crvoice_new(PRANI_SP_WOLF);
var g_bout = sequence_call_bout_new(PRANI_VOC_HOWL, 2, CALL_D, GAP_I, PRANI_INTENT_SOCIAL);
assert_eq(sequence_call_bout_synthesize(g_bout, g_wolf, T_NAN), PRANI_ERR_INVALID_TRACT,
  "NaN sample_rate -> INVALID_TRACT");
assert_eq(sequence_call_bout_synthesize(g_bout, g_wolf, f64_from(0)), PRANI_ERR_INVALID_TRACT,
  "0 Hz -> INVALID_TRACT");
assert_eq(sequence_call_bout_synthesize(g_bout, g_wolf, f64_neg(SR)), PRANI_ERR_INVALID_TRACT,
  "negative sample_rate -> INVALID_TRACT");
# A NaN smuggled past the constructor through the derived setter. The voice
# layer reports a NaN duration too, so this assertion is DEFENSE IN DEPTH on
# today's tree rather than the only report: what the recheck adds is that the
# bout is rejected before a single call is synthesized or a gap appended, and
# that sequence keeps saying so if the layer below ever stops.
var g_smuggled = sequence_call_bout_new(PRANI_VOC_HOWL, 2, CALL_D, GAP_I, PRANI_INTENT_SOCIAL);
CallBout_set_call_duration(g_smuggled, T_NAN);
assert_eq(sequence_call_bout_synthesize(g_smuggled, g_wolf, SR), PRANI_ERR_INVALID_VOCALIZATION,
  "NaN call_duration set after construction -> INVALID_VOCALIZATION");
# A negative count, by contrast, was reported by NOTHING: measured pre-guard, it
# returned an EMPTY buffer as a success -- F11's "silent empty where an error
# belongs", and a state the oracle's u32 count could not even hold.
var g_negcount = sequence_call_bout_new(PRANI_VOC_HOWL, 2, CALL_D, GAP_I, PRANI_INTENT_SOCIAL);
CallBout_set_count(g_negcount, (0 - 5));
assert_eq(sequence_call_bout_synthesize(g_negcount, g_wolf, SR), PRANI_ERR_INVALID_VOCALIZATION,
  "count -5 set after construction -> INVALID_VOCALIZATION (was empty + success)");
# allocation bound: 1024 calls of 3600 s at 44100 Hz is 1.6e11 samples, and a
# vec past 2^28 elements ABORTS the process ("vec: capacity overflow", exit 1),
# so this has to be reported before the first push rather than attempted
var g_huge = sequence_call_bout_new(PRANI_VOC_HOWL, 1024, T_3600, T_3600, PRANI_INTENT_SOCIAL);
assert_eq(prani_is_err(g_huge), 0, "1024 x 3600 s passes the per-parameter ranges");
assert_eq(sequence_call_bout_synthesize(g_huge, g_wolf, T_SR_44100), PRANI_ERR_INVALID_VOCALIZATION,
  "... and is rejected by the 2^24-sample allocation ceiling");
# control: the ordinary bout is untouched, same length as the group above
assert_eq(vec_len(sequence_call_bout_synthesize(g_bout, crvoice_new(PRANI_SP_WOLF), SR)), 1600,
  "control: the 8 kHz wolf bout still renders 1600 samples");

# ================================================================
test_group("2.0.5 sequence_call_phrase_synthesize -- sample_rate and the element pre-pass");
var g_pel = vec_new();
vec_push(g_pel, sequence_call_element_new(PRANI_VOC_HOWL, CALL_D, GAP_I));
vec_push(g_pel, sequence_call_element_new(PRANI_VOC_HOWL, CALL_D, f64_from(0)));
var g_phrase = sequence_call_phrase_new(g_pel, PRANI_INTENT_SOCIAL);
assert_eq(sequence_call_phrase_synthesize(g_phrase, g_wolf, T_NAN), PRANI_ERR_INVALID_TRACT,
  "NaN sample_rate -> INVALID_TRACT");
assert_eq(sequence_call_phrase_synthesize(g_phrase, g_wolf, f64_from(0)), PRANI_ERR_INVALID_TRACT,
  "0 Hz -> INVALID_TRACT");
# The bad element is the LAST one, so the pre-pass is what makes the report
# arrive before the first synthesis instead of after most of the buffer is
# already built (the voice layer also rejects a NaN duration, one element too
# late to stop the work).
CallElement_set_duration(vec_get(g_pel, 1), T_NAN);
assert_eq(sequence_call_phrase_synthesize(g_phrase, g_wolf, SR), PRANI_ERR_INVALID_VOCALIZATION,
  "NaN duration on the LAST element -> INVALID_VOCALIZATION");
CallElement_set_duration(vec_get(g_pel, 1), CALL_D);
CallElement_set_gap(vec_get(g_pel, 0), PRANI_POS_INF);
assert_eq(sequence_call_phrase_synthesize(g_phrase, g_wolf, SR), PRANI_ERR_INVALID_VOCALIZATION,
  "+inf gap -> INVALID_VOCALIZATION");
CallElement_set_gap(vec_get(g_pel, 0), GAP_I);
# control: with the fields restored the phrase renders exactly as before
assert_eq(vec_len(sequence_call_phrase_synthesize(g_phrase, crvoice_new(PRANI_SP_WOLF), SR)), 1600,
  "control: the restored phrase still renders (400+800)+(400+0)");
# 1025 elements is one synthesis too many for a single call
var g_many = vec_new();
var g_m = 0;
while (g_m < 1025) {
    vec_push(g_many, sequence_call_element_new(PRANI_VOC_HOWL, f64_from(0), f64_from(0)));
    g_m = g_m + 1;
}
assert_eq(sequence_call_phrase_synthesize(sequence_call_phrase_new(g_many, PRANI_INTENT_SOCIAL), g_wolf, SR),
  PRANI_ERR_INVALID_VOCALIZATION, "1025 elements -> INVALID_VOCALIZATION");

# ================================================================
# Audit F10, and it is worse than "overflows i64 at ~1e14 s". MEASURED on this
# tree: a timing_spread of 1e6 s at 44100 Hz asks for 4.41e10 offset samples, so
# the mix ALONE demands 705.6 GB -- eight orders of magnitude below the audit's
# overflow threshold. The reachable failure is exhaustion (a vec past 2^28
# elements dies "vec: capacity overflow", exit 1, which a library cannot
# report), so the guard bounds the ALLOCATION, not the arithmetic.
test_group("2.0.5 F10 -- synthesize_chorus bounds the allocation before it is made");
# the demand itself, computed the way the function computes it (nothing is
# allocated here -- this is the measurement the guard exists for)
var f10_offset = f64_to(f64_mul(f64_from(1000000), T_SR_44100));
assert_eq(f10_offset, 44100000000, "1e6 s spread @44100 = 4.41e10 offset samples");
assert_eq(f10_offset * 2 * 8, 705600000000, "-> the mix alone demands 705.6 GB");
var g_voices = vec_new();
vec_push(g_voices, crvoice_new(PRANI_SP_WOLF));
vec_push(g_voices, crvoice_new(PRANI_SP_WOLF));
var g_1e6 = f64_from(1000000);
var g_600 = f64_from(600);
var g_0s = f64_from(0);
assert_eq(sequence_synthesize_chorus(g_voices, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR_44100, F64_ONE, g_1e6),
  PRANI_ERR_INVALID_VOCALIZATION, "1e6 s spread -> INVALID_VOCALIZATION, not 705.6 GB");
# 600 s at 44100 is 26.46 M samples for the mix and twice that once both voices
# render their own call buffer: inside every per-parameter range, still past the
# 2^24 ceiling. The ceiling counts the whole call, not the longest buffer --
# a bump allocator never gives the per-voice buffers back.
assert_eq(sequence_synthesize_chorus(g_voices, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR_44100, g_600, g_0s),
  PRANI_ERR_INVALID_VOCALIZATION, "600 s @44100 -> rejected by the sample ceiling");
# 300 s at 44100 is 13.23 M for the mix alone -- under the ceiling -- and 26.46 M
# once the two voices are counted, which is what makes this one a rejection
var g_300 = f64_from(300);
assert_eq(sequence_synthesize_chorus(g_voices, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_SR_44100, g_300, g_0s),
  PRANI_ERR_INVALID_VOCALIZATION, "300 s x 2 voices -> rejected (the mix alone would have fit)");
# the NaN path was a SILENT SUCCESS, not a silent empty: f64_to(NaN) is i64::MIN
# and i64::MIN * 2 WRAPS TO 0, so total_len collapsed to base_samples and the
# chorus returned a correct-LENGTH buffer with the spread quietly dropped
assert_eq(f64_to(T_NAN) * 2, 0, "i64::MIN * 2 wraps to 0 -- why the NaN spread looked correct");
assert_eq(sequence_synthesize_chorus(g_voices, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, SR, CALL_D, T_NAN),
  PRANI_ERR_INVALID_VOCALIZATION, "NaN timing_spread -> INVALID_VOCALIZATION (was a 400-sample SUCCESS)");
assert_eq(sequence_synthesize_chorus(g_voices, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, SR, T_NAN, CALL_D),
  PRANI_ERR_INVALID_VOCALIZATION, "NaN duration -> INVALID_VOCALIZATION");
assert_eq(sequence_synthesize_chorus(g_voices, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, SR, T_3601, CALL_D),
  PRANI_ERR_INVALID_VOCALIZATION, "duration past 3600 s -> INVALID_VOCALIZATION");
assert_eq(sequence_synthesize_chorus(g_voices, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_NAN, CALL_D, CALL_D),
  PRANI_ERR_INVALID_TRACT, "NaN sample_rate -> INVALID_TRACT");
assert_eq(sequence_synthesize_chorus(g_voices, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, f64_from(0), CALL_D, CALL_D),
  PRANI_ERR_INVALID_TRACT, "0 Hz -> INVALID_TRACT");
# 1025 voices is one synthesis too many (each leaves per-call state behind)
var g_crowd = vec_new();
var g_c = 0;
while (g_c < 1025) {
    vec_push(g_crowd, crvoice_new(PRANI_SP_WOLF));
    g_c = g_c + 1;
}
assert_eq(sequence_synthesize_chorus(g_crowd, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, SR, CALL_D, CALL_D),
  PRANI_ERR_INVALID_VOCALIZATION, "1025 voices -> INVALID_VOCALIZATION");
# controls: the empty-voices short circuit still precedes every guard (the
# oracle returns Ok(vec![]) before it reads a number), and the ordinary
# two-wolf chorus is bit-for-bit unaffected
assert_eq(vec_len(sequence_synthesize_chorus(vec_new(), PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, T_NAN, T_NAN, T_NAN)), 0,
  "control: empty voices still short-circuits to an empty vec, ahead of the guards");
var g_ok = sequence_synthesize_chorus(g_voices, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, SR, CALL_D, CALL_D);
assert_eq(prani_is_err(g_ok), 0, "control: the ordinary chorus still synthesizes");
assert_eq(vec_len(g_ok), 1200, "control: still 400 + 2*400");

# ================================================================
# ADR-0002 left field ranges to roadmap 2.0.5: a document that PARSES can still
# carry nonsense. prani's own sequence_call_phrase_to_json output always
# satisfies these ranges, so only documents prani did not write are rejected.
# duration/gap are i64 BIT PATTERNS in the JSON, so 9221120237041090560 is
# 0x7FF8000000000000 (NaN) and -4611686018427387904 is 0xBFF0000000000000 (-1.0).
test_group("2.0.5 sequence_call_phrase_from_json_str -- field ranges, not just parse success");
var J_INTENT7 = "{\"intent\":7,\"elements\":[]}";
var J_INTENTN = "{\"intent\":-1,\"elements\":[]}";
var J_VOC14 = "{\"intent\":6,\"elements\":[{\"vocalization\":14,\"duration\":0,\"gap\":0}]}";
var J_VOCN = "{\"intent\":6,\"elements\":[{\"vocalization\":-1,\"duration\":0,\"gap\":0}]}";
var J_DUR_NAN = "{\"intent\":6,\"elements\":[{\"vocalization\":0,\"duration\":9221120237041090560,\"gap\":0}]}";
var J_GAP_NEG = "{\"intent\":6,\"elements\":[{\"vocalization\":0,\"duration\":0,\"gap\":-4611686018427387904}]}";
var J_OK = "{\"intent\":6,\"elements\":[{\"vocalization\":5,\"duration\":4602678819172646912,\"gap\":0}]}";
assert_eq(sequence_call_phrase_from_json_str(J_INTENT7), PRANI_ERR_INVALID_VOCALIZATION,
  "intent 7 (== PRANI_INTENT_COUNT) -> INVALID_VOCALIZATION");
assert_eq(sequence_call_phrase_from_json_str(J_INTENTN), PRANI_ERR_INVALID_VOCALIZATION,
  "intent -1 -> INVALID_VOCALIZATION");
assert_eq(sequence_call_phrase_from_json_str(J_VOC14), PRANI_ERR_INVALID_VOCALIZATION,
  "vocalization 14 (== PRANI_VOC_COUNT) -> INVALID_VOCALIZATION");
assert_eq(sequence_call_phrase_from_json_str(J_VOCN), PRANI_ERR_INVALID_VOCALIZATION,
  "vocalization -1 -> INVALID_VOCALIZATION");
assert_eq(sequence_call_phrase_from_json_str(J_DUR_NAN), PRANI_ERR_INVALID_VOCALIZATION,
  "NaN duration bit pattern -> INVALID_VOCALIZATION");
assert_eq(sequence_call_phrase_from_json_str(J_GAP_NEG), PRANI_ERR_INVALID_VOCALIZATION,
  "gap of -1.0 s -> INVALID_VOCALIZATION");
# an oversized document allocates one element per entry before anything looks at
# it, so the array length is checked before the loop runs
var g_sb = str_builder_new();
str_builder_add_cstr(g_sb, "{\"intent\":6,\"elements\":[");
var g_j = 0;
while (g_j < 1025) {
    if (g_j > 0) { str_builder_add_cstr(g_sb, ","); }
    str_builder_add_cstr(g_sb, "{\"vocalization\":0,\"duration\":0,\"gap\":0}");
    g_j = g_j + 1;
}
str_builder_add_cstr(g_sb, "]}");
assert_eq(sequence_call_phrase_from_json_str(str_data(str_builder_build(g_sb))), PRANI_ERR_INVALID_VOCALIZATION,
  "1025 elements in one document -> INVALID_VOCALIZATION");
# controls: a hand-written IN-RANGE document still parses, and prani's own
# output still roundtrips (the serde group above is the full roundtrip control)
var g_doc = sequence_call_phrase_from_json_str(J_OK);
assert_eq(prani_is_err(g_doc), 0, "control: an in-range hand-written document parses");
assert_eq(CallPhrase_intent(g_doc), PRANI_INTENT_SOCIAL, "control: its intent is Social");
assert_eq(vec_len(CallPhrase_elements(g_doc)), 1, "control: one element");
assert_eq(CallElement_duration(vec_get(CallPhrase_elements(g_doc), 0)), F64_HALF, "control: duration 0.5 s");
assert_eq(prani_is_err(sequence_call_phrase_from_json_str("nope")), 1, "control: garbage still fails to parse");

var rc = assert_summary();
syscall(60, rc);

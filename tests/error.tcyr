# error.tcyr -- tests for src/error.cyr.
# rust-old/src/error.rs had no #[test] blocks (its Display/serde behaviour is
# exercised in tests/integration.rs). The parity-meaningful surface in the
# Cyrius port is the integer codes + prani_from_svara mapping + finite test;
# serde round-trip and Display-string tests are dropped (integer codes).

include "src/error.cyr"

alloc_init();

var NAN_BITS = 0x7FF8000000000000;   # canonical quiet NaN

# ================================================================
test_group("error code identity");
assert_eq(prani_is_err(PRANI_ERR_NONE), 0, "ERR_NONE is not an error");
assert_eq(prani_is_err(PRANI_ERR_INVALID_TRACT), 1, "invalid tract is an error");
assert_eq(prani_is_err(PRANI_ERR_INVALID_VOCALIZATION), 1, "invalid vocalization is an error");
assert_eq(prani_is_err(PRANI_ERR_INVALID_SPECIES), 1, "invalid species is an error");
assert_eq(prani_is_err(PRANI_ERR_SYNTHESIS_FAILED), 1, "synthesis failed is an error");
assert_eq(prani_is_err(PRANI_ERR_SVARA), 1, "svara error is an error");

# distinct codes (one per Rust variant)
assert_neq(PRANI_ERR_INVALID_TRACT, PRANI_ERR_INVALID_VOCALIZATION, "codes distinct 1");
assert_neq(PRANI_ERR_INVALID_SPECIES, PRANI_ERR_SYNTHESIS_FAILED, "codes distinct 2");
assert_neq(PRANI_ERR_SYNTHESIS_FAILED, PRANI_ERR_SVARA, "codes distinct 3");

# ================================================================
test_group("err_name");
assert_streq(prani_err_name(PRANI_ERR_NONE), "none", "none name");
assert_streq(prani_err_name(PRANI_ERR_INVALID_TRACT), "invalid tract parameter", "tract name");
assert_streq(prani_err_name(PRANI_ERR_SVARA), "svara error", "svara name");
assert_streq(prani_err_name(999), "unknown error", "unknown fallback");

# ================================================================
test_group("from_svara (impl From<SvaraError>)");
assert_eq(prani_from_svara(0), PRANI_ERR_NONE, "svara none -> none");
assert_eq(prani_from_svara((0 - 1)), PRANI_ERR_SVARA, "svara invalid formant -> PRANI_ERR_SVARA");
assert_eq(prani_from_svara((0 - 6)), PRANI_ERR_SVARA, "svara computation -> PRANI_ERR_SVARA");

# ================================================================
test_group("is_finite");
assert_eq(prani_is_finite(f64_from(440)), 1, "440 is finite");
assert_eq(prani_is_finite(0), 1, "0 is finite");
assert_eq(prani_is_finite(NAN_BITS), 0, "NaN not finite");
assert_eq(prani_is_finite(PRANI_POS_INF), 0, "+inf not finite");
assert_eq(prani_is_finite(PRANI_NEG_INF), 0, "-inf not finite");

test_group("input-range guards (2.0.5)");
var e_nan = f64_div(0, 0);
var e_pinf = f64_div(f64_from(1), 0);
var e_ninf = f64_div(f64_from(0) - f64_from(1), 0);
# the measurements these guards exist because of -- pinned so they cannot drift
assert_eq(prani_is_finite(f64_clamp(e_nan, f64_from(1), f64_from(2))), 0,
  "f64_clamp passes NaN through (the reason the guards exist)");
assert_eq(f64_clamp(e_pinf, f64_from(1), f64_from(2)), f64_from(2),
  "f64_clamp DOES bound +inf -- infinities are not the clamp-site hazard");
assert_eq(f64_clamp(e_ninf, f64_from(1), f64_from(2)), f64_from(1), "f64_clamp bounds -inf");
assert_eq(f64_to(e_nan), f64_to(e_pinf), "f64_to(NaN) == f64_to(+inf) (both i64::MIN)");
assert_eq(f64_to(e_pinf) < 0, 1, "f64_to(+inf) is NEGATIVE, not i64::MAX -- so loop bounds go negative");

assert_eq(prani_finite2(F64_ONE, F64_ONE), 1, "finite2 accepts two finite");
assert_eq(prani_finite2(F64_ONE, e_nan), 0, "finite2 rejects a NaN second");
assert_eq(prani_finite2(e_pinf, F64_ONE), 0, "finite2 rejects an inf first");
assert_eq(prani_finite3(F64_ONE, F64_ONE, F64_ONE), 1, "finite3 accepts three finite");
assert_eq(prani_finite3(F64_ONE, F64_ONE, e_ninf), 0, "finite3 rejects a -inf third");

assert_eq(prani_in_range(f64_from(5), F64_ONE, f64_from(10)), 1, "in_range accepts an interior value");
assert_eq(prani_in_range(F64_ONE, F64_ONE, f64_from(10)), 1, "in_range is inclusive at lo");
assert_eq(prani_in_range(f64_from(10), F64_ONE, f64_from(10)), 1, "in_range is inclusive at hi");
assert_eq(prani_in_range(f64_from(0), F64_ONE, f64_from(10)), 0, "in_range rejects below lo");
assert_eq(prani_in_range(f64_from(11), F64_ONE, f64_from(10)), 0, "in_range rejects above hi");
assert_eq(prani_in_range(e_nan, F64_ONE, f64_from(10)), 0, "in_range rejects NaN");
assert_eq(prani_in_range(e_pinf, F64_ONE, f64_from(10)), 0, "in_range rejects +inf");

assert_eq(prani_is_positive(F64_ONE), 1, "is_positive accepts 1.0");
assert_eq(prani_is_positive(0), 0, "is_positive rejects exactly 0");
assert_eq(prani_is_positive(f64_neg(F64_ONE)), 0, "is_positive rejects negative");
assert_eq(prani_is_positive(e_nan), 0, "is_positive rejects NaN");
assert_eq(prani_is_non_negative(0), 1, "is_non_negative accepts 0 (a zero duration is legal)");
assert_eq(prani_is_non_negative(f64_neg(F64_ONE)), 0, "is_non_negative rejects negative");
assert_eq(prani_is_non_negative(e_nan), 0, "is_non_negative rejects NaN");

var rc = assert_summary();
syscall(60, rc);

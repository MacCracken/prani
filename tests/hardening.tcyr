# hardening.tcyr -- the P(-1) sweep's regression suite (2.0.3).
#
# One group per repaired finding in docs/audit/2026-08-30-audit.md. Every group
# is written so it FAILS on the 2.0.2 tree: the memory-safety groups crash the
# process there rather than reporting, which is exactly why they are worth
# keeping. Nothing here re-tests behaviour the parity suites already cover --
# these are the edges the oracle never exercised.
#
# Include order matches tests/ffi.tcyr (the widest unit: dep bundles, then every
# prani module in dependency order).

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/svara.cyr"
include "src/real.cyr"
include "src/error.cyr"
include "src/f64/error.cyr"
include "src/logging.cyr"
include "src/rng.cyr"
include "src/f64/rng.cyr"
include "src/dsp.cyr"
include "src/f64/dsp.cyr"
include "src/spatial.cyr"
include "src/f64/spatial.cyr"
include "src/vocalization.cyr"
include "src/fatigue.cyr"
include "src/f64/fatigue.cyr"
include "src/emotion.cyr"
include "src/f64/emotion.cyr"
include "src/sequence.cyr"
include "src/f64/sequence.cyr"
include "src/species.cyr"
include "src/f64/species.cyr"
include "src/bridge.cyr"
include "src/f64/bridge.cyr"
include "src/tract.cyr"
include "src/f64/tract.cyr"
include "src/voice.cyr"
include "src/f64/voice.cyr"
include "src/preset.cyr"
include "src/f64/preset.cyr"
include "src/stream.cyr"
include "src/f64/stream.cyr"
include "src/ffi.cyr"
include "tests/realt.cyr"

alloc_init();

#ifdef PRANI_F32
var H_SR      = 0x472C4400;           # 44100.0  a sample rate svara accepts
var H_DUR_005 = 0x3D4CCCCD;           # 0.05 s
var H_0_02    = 0x3CA3D70A;           # 0.02     the 20 ms block constant
var H_3_0     = 0x40400000;           # 3.0      an out-of-range size scale
#else
var H_SR      = 0x40e5888000000000;   # 44100.0  a sample rate svara accepts
var H_DUR_005 = 0x3fa999999999999a;   # 0.05 s
var H_0_02    = 0x3f947ae147ae147b;   # 0.02     the 20 ms block constant
var H_3_0     = 0x4008000000000000;   # 3.0      an out-of-range size scale
#endif

# all_finite(vec) -- 1 iff every element passes prani_is_finite.
#must_use
fn t_all_finite_h(v) {
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        if (prani_is_finite(vec_get(v, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ================================================================
# F1 (CRITICAL) -- svara_tract_new's error return was used as a pointer.
#
# svara 3.x hardened VocalTract::new into a checkable code and rejects every
# sample_rate <= 1000 Hz; crtract_new ignored it and handed -1 to
# svara_tract_set_formants_from_target. On the 2.0.2 tree each assertion in this
# group is a SIGSEGV, not a failure.
# ================================================================
test_group("F1 crtract_new reports svara's rejection instead of dereferencing it");
assert_eq(prani_is_err(crtract_new(species_params(PRANI_SP_WOLF), pr_from(10))), 1,
  "sample_rate 10 -> error, not a segfault");
assert_eq(prani_is_err(crtract_new(species_params(PRANI_SP_WOLF), pr_from(1000))), 1,
  "sample_rate 1000 (svara's boundary) -> error");
assert_eq(prani_is_err(crtract_new(species_params(PRANI_SP_WOLF), 0)), 1,
  "sample_rate 0 -> error");
assert_eq(prani_is_err(crtract_new(species_params(PRANI_SP_WOLF), pr_neg(H_SR))), 1,
  "negative sample_rate -> error");
assert_eq(prani_is_err(crtract_new(species_params(PRANI_SP_WOLF), pr_div(0, 0))), 1,
  "NaN sample_rate -> error");
# control: the rates the library is actually used at still build a tract.
assert_eq(prani_is_err(crtract_new(species_params(PRANI_SP_WOLF), H_SR)), 0,
  "44100 still builds (control)");
assert_eq(prani_is_err(crtract_new(species_params(PRANI_SP_WOLF), pr_from(8000))), 0,
  "8000 still builds (control)");

test_group("F1 the rejection propagates out of every public entry point");
var hv = crvoice_new(PRANI_SP_WOLF);
assert_eq(prani_is_err(crvoice_vocalize(hv, PRANI_VOC_HOWL, pr_from(10), PR_ONE)), 1,
  "crvoice_vocalize -> error at sample_rate 10");
assert_eq(prani_is_err(
    crvoice_vocalize_with_intent(hv, PRANI_VOC_HOWL, PRANI_INTENT_ALARM, pr_from(10), PR_ONE)), 1,
  "crvoice_vocalize_with_intent -> error at sample_rate 10");
# the cat-purr special path takes its own crtract_new call site
var hcat = crvoice_new(PRANI_SP_CAT);
assert_eq(prani_is_err(crvoice_vocalize(hcat, PRANI_VOC_PURR, pr_from(10), PR_ONE)), 1,
  "cat purr path -> error at sample_rate 10");
# control: the same calls at a real sample rate still synthesize
var hok = crvoice_vocalize(hv, PRANI_VOC_HOWL, H_SR, H_DUR_005);
assert_eq(prani_is_err(hok), 0, "44100 still synthesizes (control)");
assert_eq(vec_len(hok), 2205, "control length is 0.05 s * 44100");

test_group("F1 a rejected stream reports 0 written and retires");
var hsv = crvoice_new(PRANI_SP_WOLF);
var hs = stream_new(hsv, PRANI_VOC_HOWL, PRANI_INTENT_IDLE, pr_from(10), PR_ONE);
# 2.2.1 (ADR-0009, audit B10): stream_new builds the tract, so the rejection is its
# to report; through 2.2.0 it constructed and the first fill failed.
assert_eq(hs, PRANI_ERR_SVARA, "stream_new reports svara's rejection of the rate");
var hbuf = vec_new();
prani_vec_push_zeros(hbuf, 64);
assert_eq(stream_fill_buffer(hs, hbuf), 0, "a fill on the error handle writes 0, not 64, and reads nothing");
assert_eq(stream_is_finished(hs), 1, "and it reads as finished, so a drain loop terminates");

# ================================================================
# F2 (defense in depth) -- block_size floor.
#
# `(sample_rate * 0.02) as usize` is 0 below 50 Hz, and the oracle's loop
# (2.0.3:rust-old/src/voice.rs:227-231) advances by exactly that, so it never
# terminates. It is NOT independently reachable now -- F1's guard rejects
# everything below ~1000 Hz before the loop is built -- so this asserts the
# arithmetic and keeps the floor as a second line, not as a fix for a live
# defect.
# ================================================================
test_group("F2 block_size arithmetic underflows below 50 Hz (floor is defense in depth)");
assert_eq(pr_to(pr_mul(pr_from(10), H_0_02)), 0, "sr=10 -> block_size 0 unfloored");
assert_eq(pr_to(pr_mul(pr_from(49), H_0_02)), 0, "sr=49 -> block_size 0 unfloored");
assert_eq(pr_to(pr_mul(pr_from(50), H_0_02)), 1, "sr=50 -> block_size 1");
assert_eq(pr_to(pr_mul(H_SR, H_0_02)), 882, "sr=44100 -> block_size 882");

# ================================================================
# F3 (HIGH) -- a parse failure was indistinguishable from a successful parse.
#
# bayan's value accessors are all null-safe, so a malformed document used to
# yield a fully-formed struct with every field 0 -- including size_scale 0.0,
# which makes crvoice_effective_f0 divide by zero.
# ================================================================
test_group("F3 deserializers reject malformed JSON instead of fabricating zeros");
assert_eq(prani_is_err(crvoice_from_json_str("not json at all")), 1, "crvoice: garbage -> error");
assert_eq(prani_is_err(crvoice_from_json_str("")), 1, "crvoice: empty -> error");
assert_eq(prani_is_err(crvoice_from_json_str("{\"species\":")), 1, "crvoice: truncated -> error");
assert_eq(prani_is_err(crtract_from_json_str("not json at all")), 1, "crtract: garbage -> error");
assert_eq(prani_is_err(preset_from_json_str("not json at all")), 1, "preset: garbage -> error");
assert_eq(prani_is_err(sequence_call_phrase_from_json_str("nope")), 1, "phrase: garbage -> error");

test_group("F3 valid JSON still roundtrips (control for the guard)");
var hrv = crvoice_with_size(crvoice_new(PRANI_SP_LION), H_3_0);
var hsb = str_builder_new();
crvoice_to_json(hrv, hsb);
var hjson = str_data(str_builder_build(hsb));
var hrv2 = crvoice_from_json_str(hjson);
assert_eq(prani_is_err(hrv2), 0, "valid json is NOT rejected");
assert_eq(CreatureVoice_species(hrv2), PRANI_SP_LION, "species roundtrips");
assert_eq(CreatureVoice_size_scale(hrv2), CreatureVoice_size_scale(hrv), "size_scale roundtrips");

# ================================================================
# F4 (HIGH) -- NoiseOnly synthesis dereferenced a filter that may be absent.
# The field is only populated for NOISE_ONLY species and only when
# filter_biquad_new succeeded; the comment claimed it was always present.
# ================================================================
test_group("F4 a NoiseOnly tract with no bandpass reports instead of dereferencing 0");
var hsnake = crtract_new(species_params(PRANI_SP_SNAKE), H_SR);
assert_eq(prani_is_err(hsnake), 0, "snake tract builds (control)");
assert_eq(prani_is_err(crtract_synthesize(hsnake, pr_from(300), 32, crtract_options_default())), 0,
  "with a filter present, synthesis still succeeds (control)");
CreatureTract_set_noise_filter(hsnake, 0);   # the state crtract_new can leave behind
assert_eq(crtract_synthesize(hsnake, pr_from(300), 32, crtract_options_default()),
  PRANI_ERR_SYNTHESIS_FAILED, "filter absent -> PRANI_ERR_SYNTHESIS_FAILED, not a segfault");

# ================================================================
# F5 (MEDIUM) -- a zero-length fill buffer could never advance the stream.
# ================================================================
test_group("F5 stream_fill_buffer with an empty buffer returns 0 immediately");
var hsv2 = crvoice_new(PRANI_SP_WOLF);
var hs2 = stream_new(hsv2, PRANI_VOC_HOWL, PRANI_INTENT_IDLE, H_SR, H_DUR_005);
assert_eq(stream_fill_buffer(hs2, vec_new()), 0, "empty buffer -> 0 written");
assert_eq(stream_samples_rendered(hs2), 0, "and nothing was consumed");
# control: a real buffer still fills
var hb2 = vec_new();
prani_vec_push_zeros(hb2, 128);
assert_eq(stream_fill_buffer(hs2, hb2), 128, "128-sample buffer still fills fully");
assert_eq(stream_samples_rendered(hs2), 128, "and the stream advanced by 128");

# ================================================================
# F6 (MEDIUM) -- the FFI size RTPC allocated a throwaway voice per call.
# The rewrite must be observably identical to the rebuild it replaced.
# ================================================================
test_group("F6 ffi_voice_set_size matches a genuinely rebuilt voice, field for field");
var hff = crvoice_with_vocal_effort(crvoice_with_f0_offset(crvoice_new(PRANI_SP_DRAGON), pr_from(40)), PR_ONE);
prani_ffi_voice_set_size(hff, H_3_0);
var href = crvoice_with_size(crvoice_new(PRANI_SP_DRAGON), H_3_0);
assert_eq(CreatureVoice_species(hff), CreatureVoice_species(href), "species matches rebuild");
assert_eq(CreatureVoice_f0_offset(hff), CreatureVoice_f0_offset(href), "f0_offset reset like rebuild");
assert_eq(CreatureVoice_size_scale(hff), CreatureVoice_size_scale(href), "size_scale matches rebuild");
assert_eq(CreatureVoice_vocal_effort(hff), CreatureVoice_vocal_effort(href), "vocal_effort reset like rebuild");
assert_eq(crvoice_effective_f0(hff), crvoice_effective_f0(href), "effective_f0 identical");
# and the handle is unchanged, which is the whole point of the C contract
var hff2 = crvoice_new(PRANI_SP_CAT);
prani_ffi_voice_set_size(hff2, H_3_0);
assert_eq(CreatureVoice_species(hff2), PRANI_SP_CAT, "handle still addresses the same voice");

# ================================================================
# R1/R2 -- the two extracted loop shapes, including the edge every call site
# relies on: a count can reach here as i64::MIN (where f64_to lands below -2^63)
# or as 0 (where it lands for NaN), so a non-positive count must append nothing
# rather than loop.
# ================================================================
test_group("R1/R2 extracted vec helpers, including the non-positive count edge");
var hsrc = vec_new();
vec_push(hsrc, pr_from(1)); vec_push(hsrc, pr_from(2)); vec_push(hsrc, pr_from(3));
var hdst = vec_new();
prani_vec_extend(hdst, hsrc);
assert_eq(vec_len(hdst), 3, "extend appends every element");
assert_eq(vec_get(hdst, 2), pr_from(3), "in order");
prani_vec_extend(hdst, vec_new());
assert_eq(vec_len(hdst), 3, "extending by an empty vec is a no-op");
prani_vec_push_zeros(hdst, 4);
assert_eq(vec_len(hdst), 7, "push_zeros appends n zeros");
assert_eq(vec_get(hdst, 6), 0, "and they are zero");
prani_vec_push_zeros(hdst, 0);
assert_eq(vec_len(hdst), 7, "a zero count appends nothing");
prani_vec_push_zeros(hdst, pr_to(pr_neg(PRANI_POS_INF)));
assert_eq(vec_len(hdst), 7, "pr_to(-inf) == i64::MIN appends nothing, does not loop");
prani_vec_push_zeros(hdst, pr_to(pr_div(0, 0)));
assert_eq(vec_len(hdst), 7, "pr_to(NaN) == 0 appends nothing");

# ================================================================
# O1/O2 -- allocation budget. Cyrius's allocator is a bump arena that never
# frees, so an allocation on a per-frame or per-block path is retained for the
# life of the process. These measure alloc_used() across a fixed number of calls
# rather than asserting a wall-clock figure, because the win here is bytes, not
# nanoseconds (the benchmarks moved less than the measurement noise).
# ================================================================
test_group("O1 the FFI size RTPC allocates nothing per call");
var ho = crvoice_new(PRANI_SP_WOLF);
prani_ffi_voice_set_size(ho, H_3_0);          # warm any first-call cost
var ho_before = alloc_used();
var hoi = 0;
while (hoi < 1000) {
    prani_ffi_voice_set_size(ho, H_3_0);
    hoi = hoi + 1;
}
var ho_after = alloc_used();
# Before the rewrite each call built a CreatureVoice AND a SpeciesParams and
# dropped both, so 1000 calls retained a few hundred KB. It is now exactly 0.
assert_eq(ho_after - ho_before, 0, "1000 RTPC calls retain 0 bytes");
assert_eq(CreatureVoice_size_scale(ho), CreatureVoice_size_scale(
    crvoice_with_size(crvoice_new(PRANI_SP_WOLF), H_3_0)), "and still does the job");

test_group("O2 the block loop allocates one SynthesisOptions, not one per block");
var hb = crvoice_new(PRANI_SP_WOLF);
crvoice_vocalize(hb, PRANI_VOC_HOWL, H_SR, H_DUR_005);   # warm
var hb_before = alloc_used();
var hb_out = crvoice_vocalize(hb, PRANI_VOC_HOWL, H_SR, H_DUR_005);
var hb_used = alloc_used() - hb_before;
assert_eq(prani_is_err(hb_out), 0, "control: the call still succeeds");
assert_eq(vec_len(hb_out), 2205, "control: and still returns 0.05 s of audio");
# 2.2.1 (audit D3): this group's only bound was "under 1 MB" against a 16-byte
# regression, and a SynthesisOptions per block survived every suite. The exact
# test: 0.05 s (2205 samples, 3 blocks of 882) and 0.07 s (3087, 4 blocks) put
# every buffer in the same capacity class (4096 and 1024 slots), so their
# difference is what ONE more block costs -- one svara_glottal_new, svara's, and
# nothing of prani's. One SynthesisOptions per block would add 16 bytes to it.
assert_eq(hb_used < 1000000, 1, "one 0.05 s call stays under 1 MB retained");
var hb7 = crvoice_new(PRANI_SP_WOLF);
crvoice_vocalize(hb7, PRANI_VOC_HOWL, H_SR, pr_of64(0x3FB1EB851EB851EC));   # warm, 0.07 s
var hb7_before = alloc_used();
var hb7_out = crvoice_vocalize(hb7, PRANI_VOC_HOWL, H_SR, pr_of64(0x3FB1EB851EB851EC));
var hb7_used = alloc_used() - hb7_before;
var hb_g0 = alloc_used();
var hb_g = svara_glottal_new(f64_from(400), pr_to64(H_SR));
var hb_glottal = alloc_used() - hb_g0;
assert_eq(vec_len(hb7_out) > 2646, 1, "control: 0.07 s is a fourth block (2646 = 3 x 882)");
assert_gt(hb_glottal, 0, "control: a svara source allocates, so the equality below is not 0 = 0");
assert_eq(hb7_used - hb_used, hb_glottal,
  "one more 20 ms block costs exactly one svara_glottal_new, nothing of prani's");

# ================================================================
# F12 (CRITICAL, 2.0.5) -- the WHOLE band (1000, 7500] aborted the process.
#
# ADR-0001 established that crtract_new checks svara_tract_new's return. It did.
# The return was a valid pointer -- and the tract still could not survive its own
# next call, for two independent reasons inside svara (both repaired in 3.5.4,
# found from here):
#
#   1. Every svara vowel target carries F5 = 3750 Hz, so at or below 7500 Hz
#      svara fell back to a SINGLE 500 Hz formant and stored that one-element vec
#      as the tract's record -- then wrote five formants into it.
#   2. svara_tract_new stored two UNCHECKED naad error codes as filter pointers;
#      its fixed 600 Hz subglottal bandpass needs a rate above 1200 Hz.
#
# So `crvoice_vocalize(wolf, HOWL, 4000.0, ...)` -- an ordinary low sample rate,
# reachable from prani_ffi_stream_start where a host passes the rate straight in
# -- killed the process. On the svara 3.5.3 tree every "synthesizes" assertion in
# this group ABORTS rather than failing.
#
# The band is now split at 1200, and the split is svara's, not prani's: prani
# restates no threshold (ADR-0001 still holds) -- it propagates whatever svara
# reports. These assertions PIN THE MEASUREMENT. If they fail, svara's range
# moved; re-measure it, do not hardcode a new number in prani.
# ================================================================
test_group("F12 low sample rates report instead of aborting");
var hlv = crvoice_new(PRANI_SP_WOLF);
# below svara's floor: a checkable error, no crash
assert_eq(prani_is_err(crvoice_vocalize(hlv, PRANI_VOC_HOWL, pr_from(1001), H_DUR_005)), 1,
  "1001 Hz -> error (svara's 600 Hz subglottal bandpass is above nyquist)");
assert_eq(prani_is_err(crvoice_vocalize(hlv, PRANI_VOC_HOWL, pr_from(1200), H_DUR_005)), 1,
  "1200 Hz (600 Hz exactly at nyquist) -> error");
# above it: these ABORTED before svara 3.5.4 and now render
var h1201 = crvoice_vocalize(hlv, PRANI_VOC_HOWL, pr_from(1201), H_DUR_005);
assert_eq(prani_is_err(h1201), 0, "1201 Hz synthesizes (aborted before 3.5.4)");
assert_eq(vec_len(h1201), 60, "1201 Hz length is trunc(0.05 * 1201) = 60");
assert_eq(t_all_finite_h(h1201), 1, "1201 Hz output is finite");
var h4000 = crvoice_vocalize(hlv, PRANI_VOC_HOWL, pr_from(4000), H_DUR_005);
assert_eq(prani_is_err(h4000), 0, "4000 Hz synthesizes (aborted before 3.5.4)");
assert_eq(vec_len(h4000), 200, "4000 Hz length is 0.05 * 4000 = 200");
assert_eq(t_all_finite_h(h4000), 1, "4000 Hz output is finite");
var h7500 = crvoice_vocalize(hlv, PRANI_VOC_HOWL, pr_from(7500), H_DUR_005);
assert_eq(prani_is_err(h7500), 0, "7500 Hz synthesizes (aborted before 3.5.4)");
assert_eq(t_all_finite_h(h7500), 1, "7500 Hz output is finite");
# the boundary above which svara carries its FULL five-formant bank
var h7501 = crvoice_vocalize(hlv, PRANI_VOC_HOWL, pr_from(7501), H_DUR_005);
assert_eq(prani_is_err(h7501), 0, "7501 Hz synthesizes (full five-formant bank)");
# control: the rates the library is actually used at are untouched by all of this
assert_eq(prani_is_err(crvoice_vocalize(hlv, PRANI_VOC_HOWL, pr_from(8000), H_DUR_005)), 0,
  "control: 8000 unaffected");
assert_eq(vec_len(crvoice_vocalize(hlv, PRANI_VOC_HOWL, H_SR, H_DUR_005)), 2205,
  "control: 44100 still returns 0.05 s of audio");
# The FFI surface a host actually drives carries the same split. Since 2.2.1 the
# stream builds its tract when it starts (ADR-0009), so a rate svara refuses is a
# null handle from stream_start; through 2.2.0 it yielded a handle whose first
# fill failed.
var hfv = prani_ffi_voice_create(0);
var hfs_lo = prani_ffi_stream_start(hfv, 0, 6, pr_from(1200), H_DUR_005);
assert_eq(hfs_lo, 0, "FFI: 1200 Hz yields a null handle (svara rejects the rate)");
var hfbuf = vec_new();
prani_vec_push_zeros(hfbuf, 64);
assert_eq(prani_ffi_stream_fill(hfs_lo, hfbuf, 64), 0,
  "FFI: 1200 Hz fill reports 0 written, not a crash (ADR-0003)");
assert_eq(prani_ffi_stream_is_finished(hfs_lo), 1,
  "FFI: the 1200 Hz stream retires so a host drain loop terminates");
# and the band that used to abort now actually renders through the FFI
var hfs_ok = prani_ffi_stream_start(hfv, 0, 6, pr_from(4000), H_DUR_005);
assert_neq(hfs_ok, 0, "FFI: 4000 Hz stream starts");
assert_eq(prani_ffi_stream_fill(hfs_ok, hfbuf, 64), 64,
  "FFI: 4000 Hz fill writes 64 samples (aborted before svara 3.5.4)");
assert_eq(t_all_finite_h(hfbuf), 1, "FFI: what it wrote is finite");

# ================================================================
# F11 (2.0.5) -- NaN passed every clamp in the tree and came back as SUCCESS.
#
# f64_clamp(NaN, lo, hi) is NaN (both comparisons are false), so a NaN reached
# svara or a raw oscillator. MEASURED before the guards: crvoice_vocalize on a
# syringeal / stridulatory / vibratile species returned a FULL-LENGTH ALL-NaN
# BUFFER as a success -- worse than the audit's "silent empty", because a host
# plays it. On a laryngeal species svara refused the NaN f0 and it surfaced as
# an error, which is why this hid: the species you would test first was the one
# species that reported.
# ================================================================
test_group("F11 non-finite input is refused, not rendered");
var hnan = pr_div(0, 0);
var hpinf = pr_div(pr_from(1), 0);
var hnv = crvoice_new(PRANI_SP_WOLF);
assert_eq(prani_is_err(crvoice_vocalize(hnv, PRANI_VOC_HOWL, hnan, H_DUR_005)), 1,
  "NaN sample_rate -> error");
assert_eq(prani_is_err(crvoice_vocalize(hnv, PRANI_VOC_HOWL, H_SR, hnan)), 1,
  "NaN duration -> error, not an empty buffer");
assert_eq(prani_is_err(crvoice_vocalize(hnv, PRANI_VOC_HOWL, H_SR, hpinf)), 1,
  "+inf duration -> error");
# the species that used to return an all-NaN buffer as success
var hbird = crvoice_new(PRANI_SP_SONGBIRD);
assert_eq(prani_is_err(crvoice_vocalize(hbird, PRANI_VOC_TRILL, hnan, H_DUR_005)), 1,
  "syringeal + NaN rate -> error (was a full-length all-NaN buffer)");
var hcri = crvoice_new(PRANI_SP_CRICKET);
assert_eq(prani_is_err(crvoice_vocalize(hcri, PRANI_VOC_STRIDULATE, H_SR, hnan)), 1,
  "stridulatory + NaN duration -> error (was an all-NaN buffer)");
# a negative duration is not a length
assert_eq(prani_is_err(crvoice_vocalize(hnv, PRANI_VOC_HOWL, H_SR, pr_neg(PR_ONE))), 1,
  "negative duration -> error");
# CONTROL: zero duration stays VALID -- the oracle's test_zero_duration_synthesis
# asserts an empty buffer, not an error, and 2.0.5 must not have changed that.
var hzero = crvoice_vocalize(hnv, PRANI_VOC_HOWL, H_SR, 0);
assert_eq(prani_is_err(hzero), 0, "control: zero duration is NOT an error (oracle parity)");
assert_eq(vec_len(hzero), 0, "control: zero duration returns an empty buffer");
# CONTROL: every valid call still behaves exactly as before
assert_eq(vec_len(crvoice_vocalize(hnv, PRANI_VOC_HOWL, H_SR, H_DUR_005)), 2205,
  "control: a valid call is untouched by all of the above");

# ================================================================
# F10 (2.0.5) -- the chorus allocation, and why the audit understated it.
#
# total_len = base_samples + max_offset_samples * 2, then a vec of that many
# zeros. The audit filed this as an i64 overflow at a timing_spread around 1e14
# seconds. MEASURED: a spread of 1e6 seconds -- EIGHT ORDERS OF MAGNITUDE below
# that -- already demands 4.41e10 offset samples, i.e. over 700 GB at 8 bytes
# each. The reachable failure is arena exhaustion, not overflow, so a guard that
# only prevented the overflow would have missed nearly the whole range.
# Separately: a NaN spread reaches total_len as 0 (i64::MIN * 2 wrapped to 0
# before cyrius 6.6.8; f64_to(NaN) has been 0 itself since), so the chorus quietly
# returned a correct-length buffer -- a silent SUCCESS path, not the silent-empty
# the audit describes.
# ================================================================
test_group("F10 chorus rejects a timing_spread it cannot allocate");
var hvoices = vec_new();
vec_push(hvoices, crvoice_new(PRANI_SP_WOLF));
vec_push(hvoices, crvoice_new(PRANI_SP_WOLF));
assert_eq(prani_is_err(
    sequence_synthesize_chorus(hvoices, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, H_SR, H_DUR_005, hnan)), 1,
  "NaN timing_spread -> error (was a plausible-looking buffer)");
assert_eq(prani_is_err(
    sequence_synthesize_chorus(hvoices, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, H_SR, H_DUR_005, pr_from(1000000))), 1,
  "1e6 s timing_spread -> error (would have needed >700 GB)");
assert_eq(prani_is_err(
    sequence_synthesize_chorus(hvoices, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, H_SR, H_DUR_005, pr_neg(PR_ONE))), 1,
  "negative timing_spread -> error");
# CONTROL: an ordinary chorus is unaffected
var hchor = sequence_synthesize_chorus(hvoices, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, H_SR, H_DUR_005, PR_ST_0_1);
assert_eq(prani_is_err(hchor), 0, "control: a 0.1 s spread still mixes");
assert_eq(t_all_finite_h(hchor), 1, "control: and the mix is finite");

# ================================================================
# ADR-0002's deferral, closed (2.0.5): a document that PARSES but carries
# nonsense is now rejected too. 2.0.3 only checked that the parse succeeded.
# ================================================================
test_group("deserializers reject out-of-range fields, not just malformed JSON");
assert_eq(prani_is_err(crvoice_from_json_str(
      "{\"species\":0,\"f0_offset\":0,\"size_scale\":0,\"vocal_effort\":4602678819172646912,\"params\":{}}")), 1,
  "size_scale 0 rejected (it divides in effective_f0)");
var hj = str_builder_new();
str_builder_add_cstr(hj, "{\"species\":99,\"f0_offset\":0,\"size_scale\":4607182418800017408,");
str_builder_add_cstr(hj, "\"vocal_effort\":4602678819172646912,\"params\":{}}");
assert_eq(prani_is_err(crvoice_from_json_str(str_data(str_builder_build(hj)))), 1,
  "out-of-range species rejected");
# CONTROL: prani's OWN serialized output must still round-trip -- the guards are
# only allowed to reject documents prani did not write.
var hser = crvoice_new(PRANI_SP_WOLF);
var hsb2 = str_builder_new();
crvoice_to_json(hser, hsb2);
var hjson2 = str_data(str_builder_build(hsb2));
var hback = crvoice_from_json_str(hjson2);
assert_eq(prani_is_err(hback), 0, "control: prani's own to_json output still deserializes");
assert_eq(CreatureVoice_species(hback), PRANI_SP_WOLF, "control: and round-trips its species");

# ================================================================
# bayan 1.11.1 (2.1.1): a duplicate key or a leading zero refuses the document.
# Through bayan 1.5.13 the four hand-written decoders took the FIRST of two equal
# keys and read `00` as 0, so `{"species":1,"species":0,...}` restored a dog from
# a document that also said wolf. The rule is bayan's (RFC 8259 section 6 for the
# zero); this group pins what it does to prani's decoders. The #derive decoders
# are the compiler's scanner, which still takes the LAST key and accepts `05`.
# ================================================================
# Returns `doc` with its opening brace replaced by `lead`, which reopens it.
fn h_with_lead(doc, lead) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, lead);
    str_builder_add_cstr(sb, doc + 1);
    return str_data(str_builder_build(sb));
}

test_group("a duplicate key or a leading zero refuses the document (bayan 1.11.1)");
var hd_vsb = str_builder_new();
crvoice_to_json(crvoice_new(PRANI_SP_WOLF), hd_vsb);
var hd_voice = str_data(str_builder_build(hd_vsb));
var hd_tsb = str_builder_new();
crtract_to_json(crtract_new(species_params(PRANI_SP_WOLF), H_SR), hd_tsb);
var hd_tract = str_data(str_builder_build(hd_tsb));
var hd_psb = str_builder_new();
preset_to_json(preset_alpha_wolf(), hd_psb);
var hd_preset = str_data(str_builder_build(hd_psb));
var hd_elems = vec_new();
vec_push(hd_elems, sequence_call_element_new(PRANI_VOC_BARK, PR_HALF, PR_HALF));
var hd_qsb = str_builder_new();
sequence_call_phrase_to_json(sequence_call_phrase_new(hd_elems, PRANI_INTENT_ALARM), hd_qsb);
var hd_phrase = str_data(str_builder_build(hd_qsb));
# CONTROLS: each decoder still takes prani's own output, so a refusal below is
# the duplicate's doing and not a decoder that refuses everything.
assert_eq(prani_is_err(crvoice_from_json_str(hd_voice)), 0, "control: own voice json decodes");
assert_eq(prani_is_err(crtract_from_json_str(hd_tract)), 0, "control: own tract json decodes");
assert_eq(prani_is_err(preset_from_json_str(hd_preset)), 0, "control: own preset json decodes");
assert_eq(prani_is_err(sequence_call_phrase_from_json_str(hd_phrase)), 0, "control: own phrase json decodes");
assert_eq(prani_is_err(crvoice_from_json_str(h_with_lead(hd_voice, "{\"species\":1,"))), 1,
  "voice: a second species key refuses the document (took the first before)");
assert_eq(prani_is_err(crtract_from_json_str(h_with_lead(hd_tract, "{\"phase\":0,"))), 1,
  "tract: a second phase key refuses the document");
assert_eq(prani_is_err(preset_from_json_str(h_with_lead(hd_preset, "{\"species\":1,"))), 1,
  "preset: a second species key refuses the document");
assert_eq(prani_is_err(sequence_call_phrase_from_json_str(h_with_lead(hd_phrase, "{\"intent\":5,"))), 1,
  "phrase: a second intent key refuses the document");
var hd_zero_ok = "{\"name\":\"P\",\"species\":0,\"size\":4607182418800017408,\"f0_offset\":0,\"breathiness\":0}";
var hd_zero_bad = "{\"name\":\"P\",\"species\":0,\"size\":4607182418800017408,\"f0_offset\":0,\"breathiness\":00}";
assert_eq(prani_is_err(preset_from_json_str(hd_zero_ok)), 0, "control: the same preset with a plain 0 decodes");
assert_eq(prani_is_err(preset_from_json_str(hd_zero_bad)), 1, "preset: a leading zero (00) refuses the document");

# ================================================================
# F13 (2.0.6) -- an out-of-range SPECIES tag rendered audio as success.
#
# 2.0.5 guarded the voc and intent tags for exactly this reason (the oracle's
# enums made an out-of-range value UNREPRESENTABLE; the port carries i64) and
# MISSED species. species_params falls through to the FANTASY defaults for any
# unknown tag -- deliberately, to preserve totality -- so crvoice_new(99)
# returned a voice and crvoice_vocalize rendered 2205 samples for it, reporting
# success. Found by 2.0.6's error_handling example, which is precisely the job
# a worked example is supposed to do.
#
# crvoice_new returned a pointer with no error channel, so the guard went at the
# POINT OF USE, as ADR-0006 describes for the builders. Since 2.2.0 crvoice_new
# refuses an unknown tag itself; the point-of-use guards stay, for a tag set raw.
# ================================================================
test_group("F13 an out-of-range species tag is refused on every synthesis path");
assert_eq(crvoice_new(99), PRANI_ERR_INVALID_SPECIES, "crvoice_new(99) is refused at construction (2.2.0)");
var hbadsp = crvoice_new(PRANI_SP_WOLF);
CreatureVoice_set_species(hbadsp, 99);   # the door crvoice_new no longer opens
assert_eq(prani_is_err(crvoice_vocalize(hbadsp, PRANI_VOC_HOWL, H_SR, H_DUR_005)), 1,
  "species 99 -> vocalize refuses (rendered 2205 samples before)");
assert_eq(prani_is_err(
    crvoice_vocalize_with_intent(hbadsp, PRANI_VOC_HOWL, PRANI_INTENT_ALARM, H_SR, H_DUR_005)), 1,
  "species 99 -> vocalize_with_intent refuses");
assert_eq(prani_is_err(stream_new(hbadsp, PRANI_VOC_HOWL, PRANI_INTENT_IDLE, H_SR, H_DUR_005)), 1,
  "species 99 -> stream_new refuses");
assert_eq(prani_is_err(
    crvoice_vocalize(crvoice_new(0 - 1), PRANI_VOC_HOWL, H_SR, H_DUR_005)), 1,
  "a negative species tag is refused too");
# CONTROLS: the boundary tag and an ordinary one must be untouched. Without
# these, a guard that rejected EVERYTHING would pass the four assertions above.
assert_eq(prani_is_err(
    crvoice_vocalize(crvoice_new(PRANI_SP_FANTASY), PRANI_VOC_HOWL, H_SR, H_DUR_005)), 0,
  "control: FANTASY (the last valid tag, 12) still synthesizes");
assert_eq(vec_len(crvoice_vocalize(crvoice_new(PRANI_SP_WOLF), PRANI_VOC_HOWL, H_SR, H_DUR_005)), 2205,
  "control: a wolf howl is unchanged");

# ================================================================
# Cyrius 6.6.8 made f64_to saturate. An overflowing sample count went from
# i64::MIN, which `num_samples < 0` caught by accident, to i64::MAX, which it
# does not. On 2.0.13's source rebuilt against 6.6.20 the first assertion here is
# not a failure: it is "vec: capacity overflow" and exit 1, from a public entry
# point. Each boundary below was mutation-checked: a floor-only guard, a
# finite-only guard and a 2^63 ceiling each abort inside this group.
# ================================================================
test_group("an overflowing sample count is refused on every synthesis path");
#ifdef PRANI_F32
var H_1E300 = 0x7F7FFFFF;           # 1e300 s: finite, the product overflows to +inf
var H_1E308 = 0x7F7FFFFF;           # 1e308 s: finite, only Mating's x2 overflows it
var H_1E19  = 0x5F0AC723;           # 1e19: finite past 2^63, and no infinity anywhere
var H_2P54  = 0x5A800000;           # 2^54: inside i64, past the exact-count ceiling
#else
var H_1E300 = 0x7e37e43c8800759c;   # 1e300 s: finite, the product overflows to +inf
var H_1E308 = 0x7fe1ccf385ebc8a0;   # 1e308 s: finite, only Mating's x2 overflows it
var H_1E19  = 0x43e158e460913d00;   # 1e19: finite past 2^63, and no infinity anywhere
var H_2P54  = 0x4350000000000000;   # 2^54: inside i64, past the exact-count ceiling
#endif
var h_wolf = crvoice_new(PRANI_SP_WOLF);
assert_eq(crvoice_vocalize(h_wolf, PRANI_VOC_HOWL, H_SR, H_1E300), PRANI_ERR_INVALID_VOCALIZATION,
  "1e300 s at 44.1 kHz");
assert_eq(crvoice_vocalize(h_wolf, PRANI_VOC_HOWL, H_1E300, PR_ONE), PRANI_ERR_INVALID_VOCALIZATION,
  "the same product through the rate: 1 s at 1e300 Hz");
assert_eq(crvoice_vocalize(h_wolf, PRANI_VOC_HOWL, H_1E19, PR_ONE), PRANI_ERR_INVALID_VOCALIZATION,
  "1e19 samples: a finite product past i64, so no infinity for a check to find");
assert_eq(crvoice_vocalize(h_wolf, PRANI_VOC_HOWL, H_2P54, PR_ONE), PRANI_ERR_INVALID_VOCALIZATION,
  "2^54 samples: fits i64, past the ceiling stream_new already enforced");
assert_eq(crvoice_vocalize_with_intent(h_wolf, PRANI_VOC_HOWL, PRANI_INTENT_MATING, H_SR, H_1E308),
  PRANI_ERR_INVALID_VOCALIZATION, "the intent's duration_scale is what overflows");
# One voice per apparatus, plus the purr branch that returns before the block loop.
assert_eq(crvoice_vocalize(crvoice_new(PRANI_SP_CAT), PRANI_VOC_PURR, H_SR, H_1E300),
  PRANI_ERR_INVALID_VOCALIZATION, "the cat purr path");
assert_eq(crvoice_vocalize(crvoice_new(PRANI_SP_SONGBIRD), PRANI_VOC_CHIRP, H_SR, H_1E300),
  PRANI_ERR_INVALID_VOCALIZATION, "syringeal");
assert_eq(crvoice_vocalize(crvoice_new(PRANI_SP_SNAKE), PRANI_VOC_HISS, H_SR, H_1E300),
  PRANI_ERR_INVALID_VOCALIZATION, "noise only");
assert_eq(crvoice_vocalize(crvoice_new(PRANI_SP_CRICKET), PRANI_VOC_STRIDULATE, H_SR, H_1E300),
  PRANI_ERR_INVALID_VOCALIZATION, "stridulatory");
assert_eq(crvoice_vocalize(crvoice_new(PRANI_SP_BEE), PRANI_VOC_BUZZ, H_SR, H_1E300),
  PRANI_ERR_INVALID_VOCALIZATION, "vibratile");
# The other public route to a count must agree with vocalize about the same input.
assert_eq(stream_new(h_wolf, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, H_SR, H_1E300),
  PRANI_ERR_INVALID_VOCALIZATION, "stream_new refuses the same product");
var h_fv = prani_ffi_voice_create(PRANI_SP_WOLF);
assert_eq(prani_ffi_stream_start(h_fv, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, H_SR, H_1E300), 0,
  "and the FFI hands back null for it");
# CONTROLS: without these, a guard that refused everything would pass the above.
assert_eq(vec_len(crvoice_vocalize(h_wolf, PRANI_VOC_HOWL, H_SR, H_DUR_005)), 2205,
  "control: an ordinary howl is unchanged");
assert_eq(vec_len(crvoice_vocalize(h_wolf, PRANI_VOC_HOWL, H_SR, 0)), 0,
  "control: duration 0 is still an empty buffer, not an error");

# ================================================================
# A vec cannot grow past VEC_CAP_MAX: the push is "vec: capacity overflow" and a
# process exit no caller can intercept. 3e9 s at 44100 Hz rendered for minutes and
# then died that way, on 2.0.13 and on the first 2.0.14 fix alike. The refusal has
# to come before the render, so every assertion here returns at once. A render of
# exactly VEC_CAP_MAX samples was run by hand and returned all of them, all finite;
# it takes minutes and 4 GiB, so it is not an assertion here.
# ================================================================
test_group("a request past one vec's limit is refused before any rendering");
#ifdef PRANI_F32
var H_3E9 = 0x4F32D05E;           # 3e9 s: under 2^53 samples at 44.1 kHz, far past one vec
#else
var H_3E9 = 0x41e65a0bc0000000;   # 3e9 s: under 2^53 samples at 44.1 kHz, far past one vec
#endif
# The next count past the limit the format can hold: +1 in f64, +32 in f32 (ADR-0010).
var h_over = pr_from(VEC_CAP_MAX + t_per(1, 32));
assert_eq(crvoice_vocalize(h_wolf, PRANI_VOC_HOWL, H_SR, H_3E9), PRANI_ERR_INVALID_VOCALIZATION,
  "3e9 s at 44.1 kHz: under 2^53, past VEC_CAP_MAX");
assert_eq(crvoice_vocalize(h_wolf, PRANI_VOC_HOWL, h_over, PR_ONE), PRANI_ERR_INVALID_VOCALIZATION,
  "exactly one sample too many");
assert_eq(crvoice_vocalize_with_intent(h_wolf, PRANI_VOC_HOWL, PRANI_INTENT_MATING,
    pr_from(134217728 + t_per(1, 16)), PR_ONE), PRANI_ERR_INVALID_VOCALIZATION,   # f32: 2^27 + 16
  "2^27 + 1 samples, which only Mating's x2 takes past the limit");
assert_eq(crvoice_vocalize(crvoice_new(PRANI_SP_CAT), PRANI_VOC_PURR, H_SR, H_3E9),
  PRANI_ERR_INVALID_VOCALIZATION, "the cat purr path");
# A stream is NOT one buffer, so the same request is legal there. This is what a
# caller with a very long render is pointed at, so it has to keep working.
var h_long = stream_new(h_wolf, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, H_SR, H_3E9);
assert_eq(prani_is_err(h_long), 0, "control: stream_new still accepts it");
assert_gt(stream_total_samples(h_long), VEC_CAP_MAX, "and its total really is past one vec's limit");
# But one BLOCK of it is a buffer, and used to reach the same abort.
assert_eq(stream_next_block(h_long, VEC_CAP_MAX + 1), PRANI_ERR_INVALID_VOCALIZATION,
  "a single block past VEC_CAP_MAX is refused");
assert_eq(stream_samples_rendered(h_long), 0, "and nothing was rendered");
assert_eq(vec_len(stream_next_block(h_long, 64)), 64, "control: a smaller block still drains the stream");

# ================================================================
# 2.2.1 P(-1) sweep (docs/audit/2026-11-17-audit.md). Each group below fails on
# the 2.2.0 tree; the dead-handle group ends that run with SIGSEGV.
# ================================================================
test_group("2.2.1 A6/C1/C2/B9 -- a dead handle is answered, never read");
# 2.2.0 made constructors return negative codes and passed them through the
# renderers, but left the rest of the surface reading whatever it was handed: the
# FFI setters, the emotion and fatigue functions, the JSON writers, the tract's
# reset/tilt/blend/options, an error element inside a phrase. Each SIGSEGV'd on
# 2.2.0. Now an error comes back as itself (prani_handle_code) and a null as the
# module's category code; a function that returns nothing does nothing.
var dh_e = PRANI_ERR_ALLOC;
var dh_sb = str_builder_new();
assert_eq(emotion_valence(dh_e), dh_e, "emotion_valence(error) is the error");
assert_eq(emotion_arousal(0), PRANI_ERR_INVALID_VOCALIZATION, "emotion_arousal(null) is the category code");
assert_eq(emotion_update(dh_e, 0, 0), 0, "emotion_update(error) is a no-op");
assert_eq(emotion_set(0, 0, 0), 0, "emotion_set(null) is a no-op");
assert_eq(emotion_valence_zone(dh_e), dh_e, "emotion_valence_zone(error)");
assert_eq(emotion_arousal_zone(dh_e), dh_e, "emotion_arousal_zone(error)");
assert_eq(emotion_select_vocalization(dh_e), dh_e, "emotion_select_vocalization(error)");
assert_eq(emotion_select_intent(dh_e), dh_e, "emotion_select_intent(error)");
assert_eq(emotion_evaluate(0), PRANI_ERR_INVALID_VOCALIZATION, "emotion_evaluate(null)");
assert_eq(fatigue_modifiers(dh_e), dh_e, "fatigue_modifiers(error)");
assert_eq(fatigue_fatigue(dh_e), dh_e, "fatigue_fatigue(error)");
assert_eq(fatigue_record_call(dh_e, PR_ONE, 0), 0, "fatigue_record_call(error) is a no-op");
assert_eq(fatigue_rest(0, PR_ONE), 0, "fatigue_rest(null) is a no-op");
assert_eq(fatigue_reinforce_alarm(dh_e), 0, "fatigue_reinforce_alarm(error) is a no-op");
assert_eq(fatigue_reset(dh_e), 0, "fatigue_reset(error) is a no-op");
var TL_HARD_658_0 = pr_of64(0x3FE0000000000000);
assert_eq(prani_ffi_voice_set_effort(dh_e, TL_HARD_658_0), 0, "prani_ffi_voice_set_effort(error) is a no-op");
assert_eq(prani_ffi_voice_set_size(dh_e, PR_ONE), 0, "prani_ffi_voice_set_size(error) is a no-op");
assert_eq(prani_ffi_voice_apply_lombard(dh_e, pr_from(60)), 0, "prani_ffi_voice_apply_lombard(error) is a no-op");
assert_eq(crvoice_set_vocal_effort(dh_e, PR_ONE), 0, "crvoice_set_vocal_effort(error) is a no-op");
assert_eq(crvoice_apply_lombard_effect(0, pr_from(60)), 0, "crvoice_apply_lombard_effect(null) is a no-op");
assert_eq(crvoice_reset_individual(dh_e), dh_e, "crvoice_reset_individual(error)");
assert_eq(crvoice_species(dh_e), dh_e, "crvoice_species(error)");
assert_eq(crvoice_effective_f0(0), PRANI_ERR_INVALID_SPECIES, "crvoice_effective_f0(null)");
assert_eq(crvoice_to_json(dh_e, dh_sb), dh_e, "crvoice_to_json(error)");
assert_eq(crtract_to_json(dh_e, dh_sb), dh_e, "crtract_to_json(error)");
assert_eq(preset_to_json(dh_e, dh_sb), dh_e, "preset_to_json(error)");
assert_eq(sequence_call_phrase_to_json(dh_e, dh_sb), dh_e, "sequence_call_phrase_to_json(error)");
assert_eq(crtract_reset(dh_e), 0, "crtract_reset(error) is a no-op");
assert_eq(crtract_apply_spectral_tilt(dh_e, 0, H_SR), dh_e, "crtract_apply_spectral_tilt(error samples)");
assert_eq(prani_vec_extend(vec_new(), dh_e), dh_e, "prani_vec_extend(error src)");
assert_eq(prani_vec_push_zeros(dh_e, 4), dh_e, "prani_vec_push_zeros(error vec)");
var dh_t = crtract_new(species_params(PRANI_SP_WOLF), H_SR);
var dh_fb = vec_new();
vec_push(dh_fb, pr_from(500)); vec_push(dh_fb, pr_from(1500)); vec_push(dh_fb, pr_from(2500));
assert_eq(crtract_set_formant_blend(dh_t, dh_e, dh_fb, PR_ONE), dh_e, "crtract_set_formant_blend(error target)");
assert_eq(crtract_synthesize(dh_t, pr_from(220), 64, dh_e), dh_e, "crtract_synthesize(error options)");
assert_eq(crtract_synthesize_into(dh_t, pr_from(220), 64, crtract_options_default(), 0),
  PRANI_ERR_INVALID_VOCALIZATION,
  "crtract_synthesize_into(null out)");
assert_eq(spatial_apply_distance_attenuation(dh_e, PR_ONE, PR_ONE, H_SR), dh_e,
  "spatial attenuation keeps a chained error (C7)");
assert_eq(stream_next_block(dh_e, 64), dh_e, "stream_next_block(error) keeps its code");
assert_eq(crvoice_vocalize(0, PRANI_VOC_HOWL, H_SR, H_DUR_005), PRANI_ERR_INVALID_SPECIES,
  "crvoice_vocalize(null voice)");
# an error element inside a phrase, and a phrase over an error vec (C1)
var dh_els = vec_new();
vec_push(dh_els, sequence_call_element_new(PRANI_VOC_BARK, PRANI_POS_INF, 0));
var dh_ph = sequence_call_phrase_new(dh_els, PRANI_INTENT_SOCIAL);
assert_eq(sequence_call_phrase_synthesize(dh_ph, crvoice_new(PRANI_SP_WOLF), H_SR), PRANI_ERR_INVALID_VOCALIZATION,
  "a phrase holding an error element reports it");
assert_eq(sequence_call_phrase_new(dh_e, PRANI_INTENT_SOCIAL), dh_e, "sequence_call_phrase_new(error elements)");
# a null voice inside a chorus
var dh_vs = vec_new();
vec_push(dh_vs, crvoice_new(PRANI_SP_WOLF));
vec_push(dh_vs, 0);
assert_eq(sequence_synthesize_chorus(dh_vs, PRANI_VOC_HOWL, PRANI_INTENT_SOCIAL, H_SR, H_DUR_005, 0),
  PRANI_ERR_INVALID_SPECIES, "a null voice in a chorus is reported");
# controls: the same calls on live handles still work
var dh_live = emotion_with_values(pr_of64(0x3FE0000000000000), pr_of64(0x3FE0000000000000));
assert_eq(prani_is_err(emotion_select_intent(dh_live)), 0, "control: a live emotion still selects");
assert_eq(prani_is_err(crtract_synthesize(dh_t, pr_from(220), 64, crtract_options_default())), 0,
  "control: a live tract still renders");

# t_json_set(doc, keyq, rep) -- the cstring JSON `doc` with the value after the
# first `keyq` (a quoted key and its colon) replaced by the cstring `rep`, or, for
# rep == 0, with that field and its trailing comma dropped. 0 if keyq is absent.
fn t_json_set(doc, keyq, rep) {
    var n = strlen(doc);
    var s = str_new(doc, n);
    var at = str_index_of_cstr(s, keyq);
    if (at < 0) { return 0; }
    var vstart = at + strlen(keyq);
    var rest = str_sub(s, vstart, n - vstart);
    var c = str_index_of_cstr(rest, ",");
    var b = str_index_of_cstr(rest, "}");
    var vlen = c;
    if (vlen < 0) { vlen = b; }
    if (b >= 0) {
        if (b < vlen) { vlen = b; }
    }
    var sb = str_builder_new();
    if (rep == 0) {
        str_builder_add(sb, str_sub(s, 0, at));
        var after = vstart + vlen;
        if (vlen == c) { after = after + 1; }
        str_builder_add(sb, str_sub(s, after, n - after));
    } else {
        str_builder_add(sb, str_sub(s, 0, vstart));
        str_builder_add_cstr(sb, rep);
        str_builder_add(sb, str_sub(s, vstart + vlen, n - vstart - vlen));
    }
    return str_data(str_builder_build(sb));
}

test_group("2.2.1 A2/C4/C5/B5 -- a decoder refuses a field that is absent or not an integer");
# bayan reads an absent or mistyped field as 0, and the four hand-written decoders
# read without asking: no "species" decoded a Wolf, "vocal_effort":0.9 an effort of
# 0.0, "formant0":800.0 a subnormal formant that rendered, "{}" an empty phrase,
# and an absent rng pair a tract whose noise was exact silence. All succeeded on 2.2.0.
var dj_sb = str_builder_new();
crvoice_to_json(crvoice_new(PRANI_SP_CAT), dj_sb);
var dj_voice = str_data(str_builder_build(dj_sb));
assert_eq(prani_is_err(crvoice_from_json_str(dj_voice)), 0, "control: prani's own voice document decodes");
assert_eq(crvoice_from_json_str(t_json_set(dj_voice, "\"species\":", 0)), PRANI_ERR_INVALID_SPECIES,
  "voice: no species -> refused (2.2.0: a Wolf)");
assert_eq(crvoice_from_json_str(t_json_set(dj_voice, "\"species\":", "\"cat\"")), PRANI_ERR_INVALID_SPECIES,
  "voice: a string species -> refused");
assert_eq(crvoice_from_json_str(t_json_set(dj_voice, "\"vocal_effort\":", "0.9")), PRANI_ERR_INVALID_SPECIES,
  "voice: a float vocal_effort -> refused (2.2.0: 0.0)");
assert_eq(crvoice_from_json_str(t_json_set(dj_voice, "\"f0_offset\":", 0)), PRANI_ERR_INVALID_SPECIES,
  "voice: no f0_offset -> refused");
assert_eq(crvoice_from_json_str(t_json_set(dj_voice, "\"formant0\":", "800.0")), PRANI_ERR_INVALID_SPECIES,
  "voice params: a float formant -> refused (2.2.0: a 4e-321 Hz formant that rendered)");
assert_eq(crvoice_from_json_str(t_json_set(dj_voice, "\"breathiness\":", 0)), PRANI_ERR_INVALID_SPECIES,
  "voice params: no breathiness -> refused");
assert_eq(prani_is_err(crvoice_from_json_str(t_json_set(dj_voice, "\"spectral_tilt\":", 0))), 0,
  "control: no spectral_tilt still decodes, as the oracle's #[serde(default)] had it");
var dj_tb = str_builder_new();
crtract_to_json(crtract_new(species_params(PRANI_SP_SNAKE), H_SR), dj_tb);
var dj_tract = str_data(str_builder_build(dj_tb));
assert_eq(prani_is_err(crtract_from_json_str(dj_tract)), 0, "control: prani's own tract document decodes");
assert_eq(crtract_from_json_str(t_json_set(dj_tract, "\"rng_inc\":", "0")), PRANI_ERR_INVALID_TRACT,
  "tract: an even rng_inc -> refused (PCG32's increment is odd)");
assert_eq(crtract_from_json_str(t_json_set(dj_tract, "\"rng_inc\":", "6")), PRANI_ERR_INVALID_TRACT,
  "tract: any even rng_inc -> refused");
assert_eq(crtract_from_json_str(t_json_set(t_json_set(dj_tract, "\"rng_state\":", 0), "\"rng_inc\":", 0)),
  PRANI_ERR_INVALID_TRACT, "tract: no rng pair -> refused (2.2.0: a noise path of exact silence)");
assert_eq(crtract_from_json_str(t_json_set(dj_tract, "\"phase\":", 0)), PRANI_ERR_INVALID_TRACT,
  "tract: no phase -> refused");
assert_eq(prani_is_err(crtract_from_json_str(t_json_set(dj_tract, "\"rng_inc\":", "7"))), 0,
  "control: an odd rng_inc decodes");
assert_eq(sequence_call_phrase_from_json_str("{}"), PRANI_ERR_INVALID_VOCALIZATION,
  "phrase: {} -> refused (2.2.0: an empty ALARM phrase)");
assert_eq(sequence_call_phrase_from_json_str("{\"intent\":1,\"elements\":[{}]}"), PRANI_ERR_INVALID_VOCALIZATION,
  "phrase: an element of {} -> refused (2.2.0: a 0 s HOWL)");
assert_eq(sequence_call_phrase_from_json_str("{\"intent\":1,\"elements\":{\"x\":1}}"), PRANI_ERR_INVALID_VOCALIZATION,
  "phrase: elements that are not an array -> refused");
assert_eq(sequence_call_phrase_from_json_str("{\"intent\":\"social\",\"elements\":[]}"), PRANI_ERR_INVALID_VOCALIZATION,
  "phrase: a string intent -> refused");
assert_eq(prani_is_err(sequence_call_phrase_from_json_str("{\"intent\":1,\"elements\":[]}")), 0,
  "control: an empty element list is a phrase");

test_group("2.2.1 -- a voice document's apparatus is its species'");
# Found verifying the sweep (2026-11-17): the vocalization gate reads the species'
# own row, the tract renders the params' apparatus. On 2.2.0 this "wolf" passed the
# HOWL gate and rendered 4,410 samples of wing vibration as a successful howl.
var ap_sb = str_builder_new();
crvoice_to_json(crvoice_new(PRANI_SP_WOLF), ap_sb);
var ap_doc = str_data(str_builder_build(ap_sb));
assert_eq(prani_is_err(crvoice_from_json_str(ap_doc)), 0, "control: the wolf's own document decodes");
assert_eq(crvoice_from_json_str(t_json_set(ap_doc, "\"apparatus\":", "3")), PRANI_ERR_INVALID_SPECIES,
  "a wolf whose params say vibratile is refused");
assert_eq(crvoice_from_json_str(t_json_set(ap_doc, "\"apparatus\":", "0")) > 0, 1,
  "control: the same edit to the wolf's own apparatus (laryngeal) still decodes");

test_group("2.2.1 -- a tract's clock survives JSON, and a document without one reads as 0");
# ADR-0009 gave the tract a sample clock, and ADR-0005 restores prani's own state
# from a document. Through 2.2.0 there was no clock to save.
var ck_t = crtract_new(species_params(PRANI_SP_CRICKET), H_SR);
var ck_o = crtract_synthesize_stridulatory(ck_t, pr_from(4500), 300, crtract_options_default());
assert_eq(prani_is_err(ck_o), 0, "control: the render that advances the clock succeeded");
assert_eq(CreatureTract_clock(ck_t), 300, "control: 300 samples advance the clock to 300");
var ck_sb = str_builder_new();
crtract_to_json(ck_t, ck_sb);
var ck_doc = str_data(str_builder_build(ck_sb));
var ck_r = crtract_from_json_str(ck_doc);
assert_eq(prani_is_err(ck_r), 0, "control: the document decodes");
assert_eq(CreatureTract_clock(ck_r), 300, "the clock roundtrips");
var ck_old = crtract_from_json_str(t_json_set(ck_doc, "\"clock\":", 0));
assert_eq(prani_is_err(ck_old), 0, "a document with no clock, as 2.2.0 wrote, decodes");
assert_eq(CreatureTract_clock(ck_old), 0, "at clock 0, the time base such a tract had");
assert_eq(crtract_from_json_str(t_json_set(ck_doc, "\"clock\":", "-1")), PRANI_ERR_INVALID_TRACT,
  "a negative clock is refused");
assert_eq(crtract_from_json_str(t_json_set(ck_doc, "\"clock\":", "\"x\"")), PRANI_ERR_INVALID_TRACT,
  "a clock that is not an integer is refused");

test_group("2.2.1 A3/A4 -- a preset's own JSON always reads back");
var pj_q = preset_make("Big \"Bad\" Wolf", PRANI_SP_WOLF, PR_ONE, 0, 0);
var pj_sb = str_builder_new();
preset_to_json(pj_q, pj_sb);
var pj_back = preset_from_json_str(str_data(str_builder_build(pj_sb)));
assert_eq(prani_is_err(pj_back), 0, "a name with quotes re-reads (2.2.0 wrote it raw and refused its own output)");
assert_eq(streq(VoicePreset_name(pj_back), "Big \"Bad\" Wolf"), 1, "and comes back the same name");
var pj_b = preset_make("Dire\\Wolf", PRANI_SP_WOLF, PR_ONE, 0, 0);
var pj_sb2 = str_builder_new();
preset_to_json(pj_b, pj_sb2);
assert_eq(streq(VoicePreset_name(preset_from_json_str(str_data(str_builder_build(pj_sb2)))), "Dire\\Wolf"), 1,
  "a backslash survives the round trip");
assert_eq(preset_make(0, PRANI_SP_WOLF, PR_ONE, 0, 0), PRANI_ERR_INVALID_SPECIES,
  "a null name is refused (2.2.0: preset_to_json then crashed)");
var pj_big = preset_make("Huge", PRANI_SP_WOLF, pr_from(20), 0, 0);
var pj_sb3 = str_builder_new();
preset_to_json(pj_big, pj_sb3);
var pj_big_back = preset_from_json_str(str_data(str_builder_build(pj_sb3)));
assert_eq(prani_is_err(pj_big_back), 0, "a size-20 preset's own JSON reads back (2.2.0 refused it)");
assert_eq(VoicePreset_size(pj_big), pr_from(10), "because preset_make stores the 10 preset_build clamps it to");
assert_eq(CreatureVoice_size_scale(preset_build(pj_big)), pr_from(10), "control: and the built voice is unchanged");

test_group("2.2.1 A1/A5/B6/B7/B11 -- what the point-of-use guards missed");
var pu_cat = crvoice_new(PRANI_SP_CAT);
CreatureVoice_set_vocal_effort(pu_cat, PRANI_POS_INF);
assert_eq(crvoice_vocalize(pu_cat, PRANI_VOC_PURR, H_SR, H_DUR_005), PRANI_ERR_INVALID_SPECIES,
  "an out-of-range effort on a purr is refused (2.2.0: an all-NaN purr as success)");
var pu_cat2 = crvoice_new(PRANI_SP_CAT);
CreatureVoice_set_vocal_effort(pu_cat2, pr_of64(0x7FF8000000000000));
assert_eq(crvoice_vocalize(pu_cat2, PRANI_VOC_PURR, H_SR, H_DUR_005), PRANI_ERR_INVALID_SPECIES, "and a NaN one");
var pu_w = crvoice_new(PRANI_SP_WOLF);
crvoice_set_vocal_effort(pu_w, pr_of64(0x7FF8000000000000));
crvoice_apply_lombard_effect(pu_w, pr_of64(0x7FF8000000000000));
var TL_HARD_852_0 = pr_of64(0x3FE0000000000000);
assert_eq(CreatureVoice_vocal_effort(pu_w), TL_HARD_852_0, "the two mutators ignore a NaN (2.2.0 stored it)");
var pu_z = crvoice_new(PRANI_SP_WOLF);
CreatureVoice_set_size_scale(pu_z, 0);
assert_eq(crvoice_vocalize(pu_z, PRANI_VOC_HOWL, H_SR, H_DUR_005), PRANI_ERR_INVALID_SPECIES,
  "size_scale 0 is refused (2.2.0 rendered a fabricated f0_max as success)");
var pu_t = crtract_new(species_params(PRANI_SP_CAT), H_SR);
assert_eq(crtract_synthesize_purr(pu_t, 100, pr_neg(pr_from(27))), PRANI_ERR_INVALID_TRACT,
  "a negative purr f0 is refused (2.2.0 drove the phase out of [0, 1])");
assert_eq(crtract_synthesize_purr(pu_t, 100, H_SR), PRANI_ERR_INVALID_TRACT, "and one at the sample rate");
assert_eq(prani_is_err(crtract_synthesize_purr(pu_t, 100, pr_from(27))), 0, "control: 27 Hz purrs");
assert_eq(prani_in_range(CreatureTract_phase(pu_t), 0, PR_ONE), 1, "control: and the phase stays in [0, 1]");
var pu_bee = crtract_new(species_params(PRANI_SP_BEE), H_SR);
var TL_HARD_864_0 = pr_of64(0x7FEFFFFFFFFFFFFF);
assert_eq(crtract_synthesize(pu_bee, TL_HARD_864_0, 256, crtract_options_default()), PRANI_ERR_INVALID_TRACT,
  "an f0 whose phase overflows is refused (2.2.0: 256 NaN samples as success)");
var pu_cri = crtract_new(species_params(PRANI_SP_CRICKET), H_SR);
var TL_HARD_867_0 = pr_of64(0x7FEFFFFFFFFFFFFF);
assert_eq(crtract_synthesize(pu_cri, TL_HARD_867_0, 256, crtract_options_default()), PRANI_ERR_INVALID_TRACT,
  "on the stridulatory path too");
var pu_lo = crvoice_new(PRANI_SP_WOLF);
SpeciesParams_set_f0_min(CreatureVoice_params(pu_lo), pr_from(10));
SpeciesParams_set_f0_default(CreatureVoice_params(pu_lo), pr_from(10));
SpeciesParams_set_f0_max(CreatureVoice_params(pu_lo), pr_from(10));
assert_eq(crvoice_vocalize(pu_lo, PRANI_VOC_GROWL, H_SR, H_DUR_005), PRANI_ERR_INVALID_SPECIES,
  "a species range below the 20 Hz floor is refused (2.2.0 rendered it at 20 Hz)");

test_group("2.2.1 B8/C6/C8/C9 -- refused where it was accepted, accepted where it was refused");
var r8 = stream_new(crvoice_new(PRANI_SP_WOLF), PRANI_VOC_HOWL, PRANI_INTENT_IDLE, H_SR, PR_ONE);
SynthStream_set_spectral_tilt(r8, pr_of64(0x7FF8000000000000));
var r8_buf = vec_new();
prani_vec_push_zeros(r8_buf, 256);
assert_eq(stream_fill_buffer(r8, r8_buf), 0, "a rejected tilt fails the fill (2.2.0 wrote 256)");
assert_eq(stream_is_finished(r8), 1, "and retires the stream (ADR-0003)");
assert_eq(stream_last_error(r8), PRANI_ERR_INVALID_TRACT, "and says why");
var r6_sb = str_builder_new();
str_builder_add_cstr(r6_sb, "{\"fatigue\":4632233691727265792,\"alarm_habituation\":0,\"bout_calling_time\":0,");
str_builder_add_cstr(r6_sb, "\"alarm_count\":0,\"alarm_reinforced\":0}");
var r6 = FatigueState_from_json_str(str_data(str_builder_build(r6_sb)));
assert_eq(fatigue_modifiers(r6), PRANI_ERR_INVALID_VOCALIZATION, "fatigue 50 is refused (2.2.0: amplitude -19)");
assert_eq(prani_is_err(fatigue_modifiers(fatigue_new())), 0, "control: a fresh fatigue state derives modifiers");
var r_bout = sequence_call_bout_new(PRANI_VOC_HOWL, 1, H_DUR_005, pr_from(400), PRANI_INTENT_IDLE);
var r_bo = sequence_call_bout_synthesize(r_bout, crvoice_new(PRANI_SP_WOLF), H_SR);
assert_eq(prani_is_err(r_bo), 0, "a one-call bout with a long interval renders (2.2.0 refused it)");
assert_eq(vec_len(r_bo), 2205, "and is one call long: a bout has no interval after its last call");
assert_eq(bridge_intent_from_threat_level(pr_of64(0x7FF8000000000000)), PRANI_ERR_INVALID_VOCALIZATION,
  "bridge: a NaN threat is refused (2.2.0: IDLE)");
var TL_HARD_896_0 = pr_of64(0x7FF8000000000000);
assert_eq(bridge_species_from_f0(TL_HARD_896_0), PRANI_ERR_INVALID_SPECIES, "bridge: a NaN f0 (2.2.0: SNAKE)");
assert_eq(bridge_perturbation_from_urgency(pr_of64(0x7FF8000000000000)), PRANI_ERR_INVALID_VOCALIZATION,
  "bridge: a NaN urgency (2.2.0: a NaN jitter as success)");
var TL_HARD_899_0 = pr_of64(0x3FE999999999999A);
assert_eq(bridge_intent_from_threat_level(TL_HARD_899_0), PRANI_INTENT_DISTRESS, "control: 0.8 is DISTRESS");

test_group("2.2.1 B2/B4/C3 -- render defects the oracle had too (ADR-0009)");
# B2: at 8 kHz a dog's estimated F5 (1.5 x 2750 = 4125 Hz) crossed Nyquist, svara
# refused the whole target, and the tract kept svara's default vowel (523 Hz F1).
var rd_t = crtract_new(species_params(PRANI_SP_DOG), pr_from(8000));
var rd_fv = SvVocalTract_formants(CreatureTract_tract(rd_t));
# svara's formants are f64 in both builds (ADR-0010), so they are compared as f64.
assert_eq(SvFormant_frequency(vec_get(rd_fv, 0)), f64_from(550),
  "a dog at 8 kHz keeps its own F1 (2.2.0: svara's 523)");
assert_eq(SvFormant_frequency(vec_get(rd_fv, 2)), f64_from(2750), "and its F3");
assert_eq(f64_lt(SvFormant_frequency(vec_get(rd_fv, 4)), f64_from(4000)), 1, "with F5 placed inside the band");
assert_eq(f64_gt(SvFormant_frequency(vec_get(rd_fv, 4)), SvFormant_frequency(vec_get(rd_fv, 3))), 1,
  "above F4, so the order holds");
var rd_t44 = crtract_new(species_params(PRANI_SP_DOG), H_SR);
var rd_f44 = SvVocalTract_formants(CreatureTract_tract(rd_t44));
assert_eq(SvFormant_frequency(vec_get(rd_f44, 4)), f64_mul(f64_from(2750), 0x3ff8000000000000),
  "control: at 44.1 kHz F5 is the plain 1.5 x F3 estimate, unchanged");
# B4: a stream renders the voice it was given. Through 2.2.0 it built its tract from
# the species table, so a breathiness override changed nothing in a stream.
var rd_s1 = stream_new(crvoice_new(PRANI_SP_WOLF), PRANI_VOC_HOWL, PRANI_INTENT_IDLE, H_SR, H_DUR_005);
var rd_s2 = stream_new(crvoice_with_breathiness(crvoice_new(PRANI_SP_WOLF), pr_of64(0x3FECCCCCCCCCCCCD)),
  PRANI_VOC_HOWL, PRANI_INTENT_IDLE, H_SR, H_DUR_005);
var rd_b1 = vec_new();
prani_vec_push_zeros(rd_b1, 1024);
var rd_b2 = vec_new();
prani_vec_push_zeros(rd_b2, 1024);
stream_fill_buffer(rd_s1, rd_b1);
stream_fill_buffer(rd_s2, rd_b2);
var rd_same = 1;
var rd_i = 0;
while (rd_i < 1024) {
    if (vec_get(rd_b1, rd_i) != vec_get(rd_b2, rd_i)) { rd_same = 0; }
    rd_i = rd_i + 1;
}
assert_eq(rd_same, 0, "a breathier voice streams differently (2.2.0: bit-identical to the default)");
# C3: a chorus is as long as its calls. MATING doubles each call's duration.
var rd_vs = vec_new();
vec_push(rd_vs, crvoice_new(PRANI_SP_WOLF));
var rd_ch = sequence_synthesize_chorus(rd_vs, PRANI_VOC_HOWL, PRANI_INTENT_MATING, pr_from(8000),
  pr_of64(0x3FB999999999999A), 0);
var rd_solo = crvoice_vocalize_with_intent(crvoice_new(PRANI_SP_WOLF), PRANI_VOC_HOWL, PRANI_INTENT_MATING,
  pr_from(8000), pr_of64(0x3FB999999999999A));
assert_eq(vec_len(rd_ch), vec_len(rd_solo), "a MATING chorus spans its call (2.2.0: 800 of the call's 1600)");

var rc = assert_summary();
syscall(60, rc);

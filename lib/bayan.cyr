# Decode base64url cstr (with or without `=` padding) of length enc_len.
# Returns {data_ptr, decoded_len} as a 16-byte alloc'd pair, same shape
# as bayan_base64_decode, or 0 when the input is not canonical base64url (the
# reason in bayan_base64_last_error()). Padding is optional, but when present it
# is exactly what pads the input to a multiple of 4 (1.11.1: any run of '=' was
# stripped, and a dangling character dropped).
fn bayan_base64url_decode(encoded, enc_len): i64 {
    if (enc_len < 0) { return _b64_refuse("base64url: a negative length"); }
    var n = enc_len;
    var pad = 0;
    while (n > 0 && load8(encoded + n - 1) == 61) { n = n - 1; pad = pad + 1; }
    if (pad > 0 && (enc_len % 4 != 0 || pad > 2)) {
        return _b64_refuse("base64url: padding must be absent or pad to a multiple of 4");
    }
    return _b64_decode_core(encoded, n, 1);

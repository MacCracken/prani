}

# floor(a / b) for b > 0 (cyrius `/` truncates toward zero).
fn _d_floordiv(a, b): i64 {
    var q = a / b;
    if (a < 0) { if (q * b != a) { q = q - 1; } }
    return q;
}
# table accessors — significand from storage; exponents closed-form.
fn _d_sig(idx): i64 { return load64(&_D_POW10_SIG + idx * 8); }
fn _d_decexp(idx): i64 { return (0 - 348) + 8 * idx; }
# binexp = floor(decexp * log2(10)) - 63, with log2(10) ~= 108853/32768 (exact
# for every table entry, validated).
fn _d_binexp(idx): i64 { return _d_floordiv(_d_decexp(idx) * 108853, 32768) - 63; }
# integer 10^n for small nonneg n (0..18).
fn _d_pow10_i(n): i64 {
    var r = 1;
    var i = 0;
    while (i < n) { r = r * 10; i = i + 1; }
    return r;
}

# ---- unsigned 64-bit helpers (i64 holds u64 bit patterns) ----
# a < b as u64: flip both sign bits, then a signed compare yields the u64 order.
fn _d_ult(a, b): i64 { return (a ^ 0x8000000000000000) < (b ^ 0x8000000000000000); }
fn _d_ule(a, b): i64 { if (_d_ult(b, a) == 1) { return 0; } return 1; }

# High 64 bits of (a*b), rounded, both treated as u64 — the DiyFp significand
# multiply (rapidjson DiyFp::Multiply). Splits into 32-bit pieces so each partial
# product fits a register; `>>` is logical so the bit patterns are true unsigned
# products even when the i64 sign bit is set.
fn _d_mul_hi(a, b): i64 {
    var ah = (a >> 32) & _D_MASK32;
    var al = a & _D_MASK32;
    var bh = (b >> 32) & _D_MASK32;
    var bl = b & _D_MASK32;
    var ac = ah * bh;
    var bc = al * bh;
    var ad = ah * bl;
    var bd = al * bl;
    var tmp = ((bd >> 32) & _D_MASK32) + (ad & _D_MASK32) + (bc & _D_MASK32);
    tmp = tmp + 0x80000000;   # round-to-nearest of the discarded low half (1<<31)
    return ac + ((ad >> 32) & _D_MASK32) + ((bc >> 32) & _D_MASK32) + ((tmp >> 32) & _D_MASK32);
}

# Number of decimal digits in a 32-bit value p (1..10).
fn _d_dec_digits32(p): i64 {
    var n = 1;
    while (n < 10) {
        if (_d_ult(p, _d_pow10_i(n)) == 1) { return n; }
        n = n + 1;
    }
    return 10;
}

# Pick the cached-power index so the multiplied result's exponent lands in the
# Grisu window [-59,-32]. Exactly one 8-step entry qualifies for a given e (=Mp.e).
fn _d_pick_power(e): i64 {
    var idx = 0;
    while (idx < 87) {
        var pe = _d_binexp(idx) + e + 64;
        if (pe >= (0 - 59)) {
            if (pe <= (0 - 32)) { return idx; }
        }
        idx = idx + 1;
    }
    return 86;
}

# GrisuRound: nudge the last emitted digit down while staying inside the interval
# and getting closer to w (rapidjson GrisuRound). All compares are u64.
fn _d_grisu_round(buf, len, delta, rest, ten_kappa, wp_w): i64 {
    while (1 == 1) {
        if (_d_ult(rest, wp_w) != 1) { return 0; }
        if (_d_ule(ten_kappa, delta - rest) != 1) { return 0; }
        var cond = 0;
        if (_d_ult(rest + ten_kappa, wp_w) == 1) { cond = 1; }
        elif (_d_ult((rest + ten_kappa) - wp_w, wp_w - rest) == 1) { cond = 1; }
        if (cond == 0) { return 0; }
        store8(buf + len - 1, load8(buf + len - 1) - 1);
        rest = rest + ten_kappa;
    }
    return 0;
}

# Grisu2 digit generation. W = scaled value, Mp = scaled upper boundary (same e =
# mp_e), delta = interval width (u64). Writes ASCII digits into buf; returns count;
# writes the decimal power k to kout[0] (value == digits * 10^k).
fn _d_digit_gen(w_f, mp_f, mp_e, delta, buf, kout): i64 {
    var one_f = 1 << (0 - mp_e);
    var one_e = mp_e;
    var wp_w = mp_f - w_f;
    var p1 = (mp_f >> (0 - one_e)) & _D_MASK32;
    var p2 = mp_f & (one_f - 1);
    var kappa = _d_dec_digits32(p1);
    var len = 0;
    while (kappa > 0) {
        var pw = _d_pow10_i(kappa - 1);
        var d = p1 / pw;
        if (d != 0 || len != 0) { store8(buf + len, 48 + d); len = len + 1; }
        p1 = p1 - d * pw;
        kappa = kappa - 1;
        var tmp = ((p1 & _D_MASK32) << (0 - one_e)) + p2;
        if (_d_ule(tmp, delta) == 1) {
            _d_grisu_round(buf, len, delta, tmp, _d_pow10_i(kappa) << (0 - one_e), wp_w);
            store64(kout, kappa);
            return len;
        }
    }
    while (1 == 1) {
        p2 = p2 * 10;
        delta = delta * 10;
        var d2 = (p2 >> (0 - one_e)) & _D_MASK32;
        if (d2 != 0 || len != 0) { store8(buf + len, 48 + d2); len = len + 1; }
        p2 = p2 & (one_f - 1);
        kappa = kappa - 1;
        if (_d_ult(p2, delta) == 1) {
            var scale = _d_pow10_i(0 - kappa);
            _d_grisu_round(buf, len, delta, p2, one_f, wp_w * scale);
            store64(kout, kappa);
            return len;
        }
    }
    store64(kout, kappa);
    return len;
}

# Grisu2 core: f64 bits (finite, nonzero, positive) -> ASCII digits in buf,
# decimal exponent to kout[0]. Returns digit count. value == digits * 10^K.
fn _d_grisu2(bits, buf, kout): i64 {
    var mant = bits & 0x000FFFFFFFFFFFFF;
    var be   = (bits >> 52) & 0x7FF;
    var f = 0;
    var e = 0;
    if (be != 0) { f = mant + 0x0010000000000000; e = be - 1075; }
    else         { f = mant;                       e = 0 - 1074; }

    # NormalizedBoundaries: plus boundary
    var mp_f = (f << 1) + 1;
    var mp_e = e - 1;
    while ((mp_f & 0x0020000000000000) == 0) { mp_f = mp_f << 1; mp_e = mp_e - 1; }
    mp_f = mp_f << 10;
    mp_e = mp_e - 10;
    # minus boundary
    var mm_f = 0;
    if (f == 0x0010000000000000) { mm_f = (f << 2) - 1; }
    else                          { mm_f = (f << 1) - 1; }
    var mm_e = e - 1;
    if (f == 0x0010000000000000) { mm_e = e - 2; }
    mm_f = mm_f << (mm_e - mp_e);

    # normalize v
    var vf = f;
    var ve = e;
    while ((vf & _D_BIT63) == 0) { vf = vf << 1; ve = ve - 1; }

    var idx = _d_pick_power(mp_e);
    var cf = _d_sig(idx);
    var ce = _d_binexp(idx);
    var cdec = _d_decexp(idx);

    var W_f  = _d_mul_hi(vf, cf);
    var Wp_f = _d_mul_hi(mp_f, cf);
    var Wm_f = _d_mul_hi(mm_f, cf);
    Wp_f = Wp_f - 1;
    Wm_f = Wm_f + 1;
    var delta = Wp_f - Wm_f;
    var Wp_e = mp_e + ce + 64;

    var len = _d_digit_gen(W_f, Wp_f, Wp_e, delta, buf, kout);
    # value == digits * 10^(kappa - decexp)  (rapidjson: K=-decexp, then K+=kappa)
    store64(kout, load64(kout) - cdec);
    return len;
}

# write a signed decimal exponent at buf+pos; return chars written.
fn _d_write_exp(buf, pos, e): i64 {
    var n = 1;
    if (e < 0) { store8(buf + pos, 45); e = 0 - e; }
    else       { store8(buf + pos, 43); }
    pos = pos + 1;
    var tmp[8];
    var ti = 0;
    if (e == 0) { store8(&tmp, 48); ti = 1; }
    while (e > 0) { store8(&tmp + ti, 48 + e % 10); ti = ti + 1; e = e / 10; }
    var w = ti;
    while (ti > 0) { ti = ti - 1; store8(buf + pos, load8(&tmp + ti)); pos = pos + 1; }
    return n + w;
}

# Prettify (rapidjson): value == digits * 10^k, decimal point after (len + k).
# Fixed notation for a moderate window, else exponent form. `buf` holds `len`
# ASCII digits on entry. Returns total length.
fn _d_prettify(buf, len, k): i64 {
    var kk = len + k;
    if (len <= kk && kk <= 21) {
        var i = len;
        while (i < kk) { store8(buf + i, 48); i = i + 1; }
        store8(buf + kk, 46);
        store8(buf + kk + 1, 48);
        return kk + 2;
    } elif (0 < kk && kk <= 21) {
        var i2 = len;
        while (i2 > kk) { store8(buf + i2, load8(buf + i2 - 1)); i2 = i2 - 1; }
        store8(buf + kk, 46);
        return len + 1;
    } elif ((0 - 6) < kk && kk <= 0) {
        var offset = 2 - kk;
        var j = len - 1;
        while (j >= 0) { store8(buf + j + offset, load8(buf + j)); j = j - 1; }
        store8(buf, 48);
        store8(buf + 1, 46);
        var z = 0;
        while (z < (0 - kk)) { store8(buf + 2 + z, 48); z = z + 1; }
        return len + offset;
    } elif (len == 1) {
        store8(buf + 1, 101);
        return 2 + _d_write_exp(buf, 2, kk - 1);
    } else {
        # insert '.' after the first digit: move digits[1..len-1] right by one,
        # THEN write '.' at [1]. (The old `t=len..2` loop left buf[1] unmoved and
        # then clobbered it with '.', dropping digit[1] — only bit exponent form.)
        var t = len - 1;
        while (t >= 1) { store8(buf + t + 1, load8(buf + t)); t = t - 1; }
        store8(buf + 1, 46);
        store8(buf + len + 1, 101);
        return len + 2 + _d_write_exp(buf, len + 2, kk - 1);
    }
}

# Public: format an f64 bit pattern as a JSON number into `buf` (no NUL written).
# Returns the byte length. Non-finite -> "null" (4). Handles sign and zero.
fn bayan_f64_to_json(bits, buf): i64 {
    _d_init_tables();
    var be = (bits >> 52) & 0x7FF;
    var mant = bits & 0x000FFFFFFFFFFFFF;
    if (be == 0x7FF) {
        store8(buf, 110); store8(buf + 1, 117); store8(buf + 2, 108); store8(buf + 3, 108);
        return 4;
    }
    var pos = 0;
    if ((bits & _D_BIT63) != 0) { store8(buf, 45); pos = 1; }
    if (be == 0 && mant == 0) {
        store8(buf + pos, 48); store8(buf + pos + 1, 46); store8(buf + pos + 2, 48);
        return pos + 3;
    }
    var pbits = bits & 0x7FFFFFFFFFFFFFFF;
    var kbuf[8];
    var len = _d_grisu2(pbits, buf + pos, &kbuf);
    var k = load64(&kbuf);
    return pos + _d_prettify(buf + pos, len, k);
}

# ================================================================
# Parsing: decimal string -> f64 bit pattern (correctly rounded for the vast
# majority incl. every value bayan_f64_to_json emits; exponent clamped => no DoS).
# ================================================================

# Round a normalized DiyFp (f: 64-bit, bit63 set; e: binary exp; value=f*2^e,
# sign in `neg`) to the nearest f64 bit pattern (round-half-to-even). Handles
# subnormals and overflow (-> +/-Inf).
fn _d_diyfp_to_f64(f, e, neg): i64 {
    var sign = 0;
    if (neg != 0) { sign = _D_BIT63; }
    # unbiased exponent of the leading (bit-63) 1 is (e + 63); biased for the
    # 53-bit form (hidden bit at 2^52) is that + 1023.
    var biased = e + 63 + 1023;
    if (biased >= 2047) { return sign | 0x7FF0000000000000; }   # overflow -> Inf
    var drop = 11;                                              # 64 -> 53 bits
    if (biased <= 0) {
        # subnormal: shift right an extra (1 - biased) bits, exponent field = 0.
        drop = drop + (1 - biased);
        biased = 0;
        if (drop >= 64) { return sign; }                       # underflow -> +/-0
    }
    var low = f & ((1 << drop) - 1);                           # dropped bits
    var m = f >> drop;                                         # kept significand
    var halfway = 1 << (drop - 1);
    # round half to even
    if (_d_ult(halfway, low) == 1) { m = m + 1; }
    elif (low == halfway) { if ((m & 1) == 1) { m = m + 1; } }
    # rounding carry can bump into the next binade
    if (biased == 0) {
        # subnormal: if m reached 2^52 it becomes the smallest normal (biased 1);
        # the bit layout is continuous, so just OR the sign onto m.
        return sign | m;
    }
    if (m >= 0x0020000000000000) {          # 2^53: mantissa overflowed
        m = m >> 1;
        biased = biased + 1;
        if (biased >= 2047) { return sign | 0x7FF0000000000000; }
    }
    # m is in [2^52, 2^53): drop the hidden bit, splice exponent.
    return sign | (biased << 52) | (m & 0x000FFFFFFFFFFFFF);
}

# Core: significand W (u64, the decimal digits as an integer, <= ~19 digits),
# decimal exponent E (value == W * 10^E), sign. Returns the nearest f64 bits.
fn _d_decimal_to_f64(W, E, neg): i64 {
    var sign = 0;
    if (neg != 0) { sign = _D_BIT63; }
    if (W == 0) { return sign; }
    # gross range gates (double range ~ 10^-324 .. 10^308)
    if (E > 309) { return sign | 0x7FF0000000000000; }
    if (E < (0 - 342)) { return sign; }
    # Clinger fast path: W and 10^|E| both exactly representable as doubles
    # (W < 2^53, |E| <= 22) -> a single f64 mul/div is IEEE-correctly-rounded.
    if (_d_ult(W, 0x0020000000000000) == 1) {
        if (E >= (0 - 22)) {
            if (E <= 22) {
                var fv = f64_from(W);
                if (E >= 0) { fv = f64_mul(fv, load64(&_D_POW10_EXACT + E * 8)); }
                else        { fv = f64_div(fv, load64(&_D_POW10_EXACT + (0 - E) * 8)); }
                return fv | sign;
            }
        }
    }
    # normalize W into a DiyFp {wf, we}: bit 63 set.
    var wf = W;
    var we = 0;
    while ((wf & _D_BIT63) == 0) { wf = wf << 1; we = we - 1; }
    # cached power of ten for decimal exponent E (nearest table entry <= E within
    # 8), then correct the residual (E - decexp) with an exact integer 10^r factor.
    var idx = _d_decexp_index(E);
    var cf = _d_sig(idx);
    var cbe = _d_binexp(idx);
    var cdec = _d_decexp(idx);
    # multiply the two DiyFps
    var rf = _d_mul_hi(wf, cf);
    var re = we + cbe + 64;
    # renormalize (mul_hi may leave bit 63 clear by one)
    if ((rf & _D_BIT63) == 0) { rf = rf << 1; re = re - 1; }
    # apply the residual decimal exponent r = E - cdec (|r| < 8) by an exact
    # power-of-ten DiyFp multiply so the cached-power table stays 8-spaced.
    var r = E - cdec;
    if (r != 0) {
        var rp = _d_pow10_i(r);           # r in (0,8): exact, < 2^27
        if (r > 0) {
            var pf = rp;
            var pe = 0;
            while ((pf & _D_BIT63) == 0) { pf = pf << 1; pe = pe - 1; }
            rf = _d_mul_hi(rf, pf);
            re = re + pe + 64;
            if ((rf & _D_BIT63) == 0) { rf = rf << 1; re = re - 1; }
        }
    }
    return _d_diyfp_to_f64(rf, re, neg);
}

# table index whose decimal exponent is the largest multiple-of-8 entry <= E.
fn _d_decexp_index(E): i64 {
    # decexp(idx) = -348 + 8*idx ; want floor((E+348)/8), clamped to [0,86].
    var idx = _d_floordiv(E + 348, 8);
    if (idx < 0) { idx = 0; }
    if (idx > 86) { idx = 86; }
    return idx;
}

# Parse a decimal number to an f64 bit pattern, reading at most `n` bytes from `s`
# and stopping at the first non-number byte. Handles sign, integer/fraction, e/E
# exponent, Inf/NaN. The exponent accumulator SATURATES (no O(exp) loop -> no DoS).
fn bayan_f64_parse(s, n): i64 {
    _d_init_tables();
    var i = 0;
    var neg = 0;
    while (i < n && (load8(s + i) == 32 || load8(s + i) == 9)) { i = i + 1; }
    if (i < n && load8(s + i) == 45) { neg = 1; i = i + 1; }
    elif (i < n && load8(s + i) == 43) { i = i + 1; }
    # NaN / Inf (JSON emits null for these, but accept literals defensively)
    var c0 = 0;
    if (i < n) { c0 = load8(s + i); }
    if (c0 == 110 || c0 == 78) { return 0x7FF8000000000000; }              # n/N -> NaN (also 'null')
    if (c0 == 105 || c0 == 73) {                                           # i/I -> Inf
        if (neg == 1) { return 0xFFF0000000000000; }
        return 0x7FF0000000000000;
    }
    var W = 0;
    var ndig = 0;          # SIGNIFICANT digits accumulated into W (leading zeros excluded)
    var dexp = 0;          # decimal exponent adjustment from position
    var seen = 0;
    # integer part — skip leading zeros (they aren't significant digits)
    while (i < n && load8(s + i) >= 48 && load8(s + i) <= 57) {
        var d = load8(s + i) - 48;
        if (d != 0 || W != 0) {
            if (ndig < 19) { W = W * 10 + d; ndig = ndig + 1; }
            else { dexp = dexp + 1; }    # 20th+ digit: place value bumps the exponent
        }
        seen = 1;
        i = i + 1;
    }
    # fraction
    if (i < n && load8(s + i) == 46) {
        i = i + 1;
        while (i < n && load8(s + i) >= 48 && load8(s + i) <= 57) {
            var d2 = load8(s + i) - 48;
            if (d2 != 0 || W != 0) {
                # significant fraction digit
                if (ndig < 19) { W = W * 10 + d2; ndig = ndig + 1; dexp = dexp - 1; }
            } else {
                dexp = dexp - 1;         # leading fraction zero: shifts magnitude, not significant
            }
            seen = 1;
            i = i + 1;
        }
    }
    if (seen == 0) { return 0; }
    # exponent
    if (i < n && (load8(s + i) == 101 || load8(s + i) == 69)) {
        i = i + 1;
        var esign = 1;
        if (i < n && load8(s + i) == 45) { esign = 0 - 1; i = i + 1; }
        elif (i < n && load8(s + i) == 43) { i = i + 1; }
        var ev = 0;
        while (i < n && load8(s + i) >= 48 && load8(s + i) <= 57) {
            if (ev < 100000) { ev = ev * 10 + (load8(s + i) - 48); }   # SATURATE -> no DoS
            i = i + 1;
        }
        dexp = dexp + esign * ev;
    }
    return _d_decimal_to_f64(W, dexp, neg);
}

# Parse a NUL-terminated decimal cstring (the scan self-delimits at the NUL / any
# non-number byte). Used by #derive(Serialize) deserialize.
fn bayan_f64_from_json(s): i64 { return bayan_f64_parse(s, 2147483647); }

# --- json.cyr ---

# json.cyr — minimal JSON parser and builder
# Usage: include "lib/bayan.cyr" (full bundle) or "lib/bayan-json.cyr" (sublib).
#        `lib/json.cyr` was the pre-carve stdlib module and no longer ships —
#        this content moved into bayan at 1.0.0 / cyrius 6.1.25.
# Requires: string.cyr, alloc.cyr, str.cyr, vec.cyr, fmt.cyr, io.cyr
# Internally includes: fnptr.cyr (for streaming-parser fncallN dispatch)
#
# Parses flat JSON objects into key-value pairs.
# Values are stored as strings (callers convert with str_to_int etc).

# v5.8.30: Result-returning *_r variants for the file-loading
# parsers (`bayan_json_parse_file_r`). Bare `bayan_json_parse(src)` keeps its
# best-effort vec return — no clean -1 surface to migrate.

# v5.8.30 — JsonError variants. `JsonIoErr` covers any underlying
# IoError raised while reading the source file; `JsonParseErr` is
# reserved for a future slot when the parser tracks structural
# errors instead of best-effort recovery; `JsonOther` is the
# catch-all. Keep variant-name prefix `Json` to avoid colliding
# with IoError's `Io*` variants in the global enum-variant
# namespace.
enum JsonError {
    JsonIoErr;
    JsonParseErr;
    JsonOther;
}

# JSON value: { key: Str, value: Str }
var JSON_PAIR_SIZE = 16;

# v5.8.36 — Allocator-as-first-arg variant of bayan_json_pair_new.
# Allocates the 16-byte pair via `a`. Returns 0 on OOM.
fn bayan_json_pair_new_a(a, key, value): i64 {
    var p = alloc_via(a, JSON_PAIR_SIZE);
    if (p == 0) { return 0; }
    store64(p, key);
    store64(p + 8, value);
    return p;
}

# Create a new key-value pair for JSON storage. v5.8.36 wrapper.
fn bayan_json_pair_new(key, value): i64 {
    return bayan_json_pair_new_a(default_alloc(), key, value);
}

# Return the key Str from a JSON pair
fn bayan_json_key(p): i64 { return load64(p); }
# Return the value Str from a JSON pair
fn bayan_json_value(p): i64 { return load64(p + 8); }

# Parse a JSON object string into a vec of key-value pairs.
# Handles: {"key": "value", "key2": "value2", "num": 42}
# Returns vec of json_pair pointers.
fn bayan_json_parse(src): i64 {
    var pairs = vec_new();
    var data = str_data(src);
    var slen = str_len(src);
    var ji = 0;
    # Skip to opening brace
    while (ji < slen) {
        if (load8(data + ji) == 123) { ji = ji + 1; break; }
        ji = ji + 1;
    }
    # Parse key-value pairs
    var key = 0;
    var val = 0;
    while (ji < slen) {
        var c = load8(data + ji);
        # Skip whitespace and commas
        if (c == 32) { ji = ji + 1; }
        elif (c == 10) { ji = ji + 1; }
        elif (c == 13) { ji = ji + 1; }
        elif (c == 9) { ji = ji + 1; }
        elif (c == 44) { ji = ji + 1; }
        elif (c == 125) { break; }
        elif (c == 34) {
            # Parse quoted string.
            #
            # ESCAPES (fixed in 1.5.1 — this let a value inject object keys).
            # The scan used to stop at the first `"` regardless of a preceding
            # backslash, so for the perfectly valid document
            #
            #     {"note":"hi\"there","admin":"false"}
            #
            # the value of `note` ended at the ESCAPED quote and the parser
            # resynchronised mid-value: it produced the pairs [note]=[hi\] and
            # [,]=[false], and `admin` vanished entirely. A caller doing
            # bayan_json_get(pairs, "admin") to check a permission got a silent
            # "not found" that an attacker controls through any string field.
            #
            # The value bytes are still captured VERBATIM (this flat API does
            # not decode escapes — the tagged-tree parser does); the backslash
            # only has to stop the quote from terminating the scan.
            ji = ji + 1;
            var qs = ji;
            while (ji < slen) {
                var qc = load8(data + ji);
                if (qc == 34) { break; }
                if (qc == 92) { ji = ji + 1; }
                ji = ji + 1;
            }
            if (ji > slen) { ji = slen; }
            var qstr = str_new(data + qs, ji - qs);
            ji = ji + 1;
            # Is this a key or value?
            if (key == 0) {
                key = qstr;
                # Skip to colon
                while (ji < slen) {
                    if (load8(data + ji) == 58) { ji = ji + 1; break; }
                    ji = ji + 1;
                }
            } else {
                val = qstr;
                vec_push(pairs, bayan_json_pair_new(key, val));
                key = 0;
                val = 0;
            }
        } else {
            # Non-string value (number, true, false, null)
            # Note: historical — chained if/break inside while was broken
            # pre-3.2.6 (upstream report from argonaut, fixed long since);
            # keep the flag + || form below anyway — it's clear enough.
            if (key != 0) {
                var vs = ji;
                var done = 0;
                while (ji < slen && done == 0) {
                    var vc = load8(data + ji);
                    if (vc == 44 || vc == 125 || vc == 32 || vc == 10) {
                        done = 1;
                    } else {
                        ji = ji + 1;
                    }
                }
                val = str_new(data + vs, ji - vs);
                vec_push(pairs, bayan_json_pair_new(key, val));
                key = 0;
                val = 0;
            } else {
                ji = ji + 1;
            }
        }
    }
    return pairs;
}

# Find value by key in parsed JSON. Returns Str or 0 if not found.
fn bayan_json_get(pairs, key): i64 {
    if (pairs == 0) { return 0; }
    if (key == 0) { return 0; }
    var len = vec_len(pairs);
    var gi = 0;
    while (gi < len) {
        var p = vec_get(pairs, gi);
        if (str_eq(bayan_json_key(p), key) == 1) {
            return bayan_json_value(p);
        }
        gi = gi + 1;
    }
    return 0;
}

# Get value as integer (0 if not found or not numeric)
fn bayan_json_get_int(pairs, key): i64 {
    var v = bayan_json_get(pairs, key);
    if (v == 0) { return 0; }
    return str_to_int(v);
}

# Build a JSON object from a vec of key-value pairs
fn bayan_json_build(pairs): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    var len = vec_len(pairs);
    var bi = 0;
    while (bi < len) {
        if (bi > 0) { str_builder_add_cstr(sb, ", "); }
        var p = vec_get(pairs, bi);
        str_builder_add_cstr(sb, "\"");
        str_builder_add(sb, bayan_json_key(p));
        str_builder_add_cstr(sb, "\": \"");
        str_builder_add(sb, bayan_json_value(p));
        str_builder_add_cstr(sb, "\"");
        bi = bi + 1;
    }
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# Read a whole file into a Str, however large. 0 on open failure.
#
# The fixed-size read buffers these loaders used to carry (16 KiB here, 256 KiB
# in toml) TRUNCATED silently and then reported success: a 52 KB / 2,001-key
# JSON object parsed to 630 pairs with no error, and the cut landed mid-token,
# so the last surviving pair could be a fragment. A str_builder grows, so there
# is no cap left to exceed and no cliff to fall off.
fn _json_slurp(path): Str {
    var fd = file_open(path, 0, 0);
    if (fd < 0) { return 0; }
    var sb = str_builder_new();
    var chunk = alloc(65536);
    if (chunk == 0) { file_close(fd); return 0; }
    var go = 1;
    while (go == 1) {
        var n = file_read(fd, chunk, 65536);
        if (n <= 0) { go = 0; }
        else { str_builder_add(sb, str_new(chunk, n)); }
    }
    file_close(fd);
    return str_builder_build(sb);
}

# Parse a JSON file
fn bayan_json_parse_file(path): i64 {
    var src = _json_slurp(path);
    if (src == 0) { return vec_new(); }
    if (str_len(src) == 0) { return vec_new(); }
    return bayan_json_parse(src);
}

# v5.8.30 — Result variant of bayan_json_parse_file. Open + read are
# pushed through file_open_r / file_read_r so an underlying
# IoError surfaces as Err(JsonIoErr) instead of being silently
# converted to an empty vec (the back-compat behavior of
# `bayan_json_parse_file`).
fn bayan_json_parse_file_r(path): i64 {
    var fd_r = file_open_r(path, 0, 0);
    if (is_err_result(fd_r) == 1) { return Err(JsonIoErr); }
    var fd = load64(fd_r + 8);
    var sb = str_builder_new();
    var chunk = alloc(65536);
    if (chunk == 0) { sys_close(fd); return Err(JsonIoErr); }
    var total = 0;
    var rgo = 1;
    while (rgo == 1) {
        var rd_r = file_read_r(fd, chunk, 65536);
        if (is_err_result(rd_r) == 1) { sys_close(fd); return Err(JsonIoErr); }
        var n = load64(rd_r + 8);
        if (n <= 0) { rgo = 0; }
        else {
            str_builder_add(sb, str_new(chunk, n));
            total = total + n;
        }
    }
    sys_close(fd);
    if (total == 0) { return Err(JsonIoErr); }
    return Ok(bayan_json_parse(str_builder_build(sb)));
}

# ======================================================================
# JSON ENGINE (v5.7.20) — Tagged-value tree with full nesting + escapes
# ======================================================================
#
# Stdlib baseline. RPC-grade scope (custom serializers, binary
# extensions, etc.) is owned by sandhi (lib/sandhi.cyr).
#
# Backward compat: the flat key-value API at the top of this file
# (bayan_json_parse, bayan_json_get, bayan_json_get_int, bayan_json_pair_new, bayan_json_key,
# bayan_json_value, bayan_json_build, bayan_json_parse_file) is preserved unchanged.
# Existing kybernet / argonaut / libro callers stay green.
#
# The new engine below uses a `json_v_*` prefix and a tagged 24-byte
# heap value:
#
#   +0   tag      u64    JTAG_NULL / BOOL / INT / FLOAT / STR / ARR / OBJ
#   +8   payload  u64    i64 / f64 bits / Str ptr / vec ptr
#   +16  reserved u64    0 (future: source span for raw access)
#
# Vec contents:
#   ARR: vec<json_v*> — element values in declaration order
#   OBJ: vec<json_v_pair*> — { key: Str, value: json_v* } pairs in order
#
# Strings (STR tag and OBJ keys) are decoded — \" \\ \/ \b \f \n \r \t
# \uXXXX (UTF-8 encoded) are all resolved at parse time. The Str ptr  #skip-lint: \u-escape notation, not a deferral
# holds the decoded byte sequence, not the source-text bytes.
#
# Numbers: parsed as INT if the source has no `.` `e` `E`; else FLOAT.
# Float parsing handles scientific notation `3.14e10` / `1.5E-3`.
#
# Errors: parse failures set _json_err_msg (cstr) and _json_err_pos
# (input byte offset). bayan_json_v_parse* returns 0 on error.

var JTAG_NULL  = 0;
var JTAG_BOOL  = 1;
var JTAG_INT   = 2;
var JTAG_FLOAT = 3;
var JTAG_STR   = 4;
var JTAG_ARR   = 5;
var JTAG_OBJ   = 6;

var JV_SIZE = 24;

# Legacy single-threaded last-error slots. As of v1.0.3 the parser keys off a
# per-call state struct (see "Reentrant parser state" below), so these are
# populated by the globals-compat entry points (bayan_json_v_parse_buf /
# bayan_json_v_parse / bayan_json_stream_parse) AFTER a parse returns, purely so
# bayan_json_last_error()/_pos() keep working for existing single-threaded
# callers. Concurrent parsers must use bayan_json_v_parse_ctx and read the error
# from their own state via bayan_json_state_error()/_pos().
var _json_err_msg = 0;
var _json_err_pos = 0;

# Return the last parse error message (cstr) — set on bayan_json_v_parse* failure.
fn bayan_json_last_error(): i64 {
    if (_json_err_msg == 0) { return ""; }
    return _json_err_msg;
}

# Return the last parse error byte offset — set on bayan_json_v_parse* failure.
fn bayan_json_last_error_pos(): i64 { return _json_err_pos; }

# === Constructors ===

# v5.8.36 — Allocator-as-first-arg internal jv-cell allocator.
# Returns 0 on OOM (caller must check). Used by every json_v_*_new_a
# constructor below.
fn _jv_alloc_a(a, tag): i64 {
    var v = alloc_via(a, JV_SIZE);
    if (v == 0) { return 0; }
    store64(v, tag);
    store64(v + 8, 0);
    store64(v + 16, 0);
    return v;
}

# Internal jv-cell allocator (back-compat wrapper).
fn _jv_alloc(tag): i64 { return _jv_alloc_a(default_alloc(), tag); }

# v5.8.36 — Allocator-as-first-arg variant of bayan_json_v_null.
fn bayan_json_v_null_a(a): i64 { return _jv_alloc_a(a, JTAG_NULL); }

# Create a new JTAG_NULL value. v5.8.36 wrapper.
fn bayan_json_v_null(): i64 { return _jv_alloc(JTAG_NULL); }

# v5.8.36 — Allocator-as-first-arg variant of bayan_json_v_bool_new.
fn bayan_json_v_bool_new_a(a, b): i64 {
    var v = _jv_alloc_a(a, JTAG_BOOL);
    if (v == 0) { return 0; }
    if (b == 0) { store64(v + 8, 0); }
    else        { store64(v + 8, 1); }
    return v;
}

# Create a new JTAG_BOOL value (b is 0 or 1). v5.8.36 wrapper.
fn bayan_json_v_bool_new(b): i64 {
    return bayan_json_v_bool_new_a(default_alloc(), b);
}

# v5.8.36 — Allocator-as-first-arg variant of bayan_json_v_int_new.
fn bayan_json_v_int_new_a(a, n): i64 {
    var v = _jv_alloc_a(a, JTAG_INT);
    if (v == 0) { return 0; }
    store64(v + 8, n);
    return v;
}

# Create a new JTAG_INT value (n is i64). v5.8.36 wrapper.
fn bayan_json_v_int_new(n): i64 {
    return bayan_json_v_int_new_a(default_alloc(), n);
}

# v5.8.36 — Allocator-as-first-arg variant of bayan_json_v_float_new.
fn bayan_json_v_float_new_a(a, f): i64 {
    var v = _jv_alloc_a(a, JTAG_FLOAT);
    if (v == 0) { return 0; }
    store64(v + 8, f);
    return v;
}

# Create a new JTAG_FLOAT value (f is f64 bit pattern). v5.8.36 wrapper.
fn bayan_json_v_float_new(f): i64 {
    return bayan_json_v_float_new_a(default_alloc(), f);
}

# v5.8.36 — Allocator-as-first-arg variant of bayan_json_v_str_new.
fn bayan_json_v_str_new_a(a, s): i64 {
    var v = _jv_alloc_a(a, JTAG_STR);
    if (v == 0) { return 0; }
    store64(v + 8, s);
    return v;
}

# Create a new JTAG_STR value (s is a Str ptr). v5.8.36 wrapper.
fn bayan_json_v_str_new(s): i64 {
    return bayan_json_v_str_new_a(default_alloc(), s);
}

# v5.8.36 — Allocator-as-first-arg variant of bayan_json_v_arr_new.
# Allocates BOTH the jv-cell AND the inner vec via `a`.
fn bayan_json_v_arr_new_a(a): i64 {
    var v = _jv_alloc_a(a, JTAG_ARR);
    if (v == 0) { return 0; }
    var inner = vec_new_a(a);
    if (inner == 0) { return 0; }
    store64(v + 8, inner);
    return v;
}

# Create an empty JTAG_ARR value. v5.8.36 wrapper. Append via
# bayan_json_v_arr_push (use bayan_json_v_arr_push_a if you need the same
# allocator threaded through grows).
fn bayan_json_v_arr_new(): i64 {
    return bayan_json_v_arr_new_a(default_alloc());
}

# v5.8.36 — Allocator-as-first-arg variant of bayan_json_v_obj_new.
# Allocates BOTH the jv-cell AND the inner pairs vec via `a`.
fn bayan_json_v_obj_new_a(a): i64 {
    var v = _jv_alloc_a(a, JTAG_OBJ);
    if (v == 0) { return 0; }
    var inner = vec_new_a(a);
    if (inner == 0) { return 0; }
    store64(v + 8, inner);
    return v;
}

# Create an empty JTAG_OBJ value. v5.8.36 wrapper.
fn bayan_json_v_obj_new(): i64 {
    return bayan_json_v_obj_new_a(default_alloc());
}

# v5.8.36 — Allocator-as-first-arg variant of _jv_pair_new.
fn _jv_pair_new_a(a, key, val): i64 {
    var p = alloc_via(a, 16);
    if (p == 0) { return 0; }
    store64(p, key);
    store64(p + 8, val);
    return p;
}

# A pair is a 16-byte heap struct: { key: Str @ +0, value: json_v* @ +8 }.
# v5.8.36 wrapper.
fn _jv_pair_new(key, val): i64 {
    return _jv_pair_new_a(default_alloc(), key, val);
}

# v5.8.36 — Allocator-as-first-arg variant of bayan_json_v_arr_push.
# Routes any vec-grow through `a`. Returns -1 on grow OOM
# (vs. back-compat which aborts via vec_push).
fn bayan_json_v_arr_push_a(a, arr, val): i64 {
    if (arr == 0) { return 0 - 1; }
    if (load64(arr) != JTAG_ARR) { return 0 - 1; }
    return vec_push_a(a, load64(arr + 8), val);
}

# Append a value to an array. No-op if arr is not JTAG_ARR.
# v5.8.36 wrapper.
fn bayan_json_v_arr_push(arr, val): i64 {
    if (arr == 0) { return 0; }
    if (load64(arr) != JTAG_ARR) { return 0; }
    vec_push(load64(arr + 8), val);
    return 0;
}

# Allocator-as-first-arg variant of bayan_json_v_obj_set. Routes BOTH the
# 16-byte pair cell and any vec-grow through `a`. Returns -1 on a bad object or
# on OOM (vs. back-compat, which returns 0 for a bad object and aborts inside
# vec_push on OOM) — the same contract split bayan_json_v_arr_push_a uses.
#
# This is the last constructor in the value API to get an `_a` form. Without it
# a caller could build every cell of a tree through an arena and still leak the
# pair cells onto the global bump, which is the shape that makes an arena look
# like it is working while the per-request cost stays flat.
fn bayan_json_v_obj_set_a(a, obj, key, val): i64 {
    if (obj == 0) { return 0 - 1; }
    if (load64(obj) != JTAG_OBJ) { return 0 - 1; }
    var p = _jv_pair_new_a(a, key, val);
    if (p == 0) { return 0 - 1; }
    return vec_push_a(a, load64(obj + 8), p);
}

# Append a key/value pair to an object. No-op if obj is not JTAG_OBJ.
# ⚠ `key` is a `Str` and is stored AS a Str — the pair layout is `{ key: Str @ +0, ... }`.
# The lookup side (`bayan_json_v_obj_get`) takes a C-string. That asymmetry is real and
# intentional; see the banner there before "making them match".
fn bayan_json_v_obj_set(obj, key, val): i64 {
    if (obj == 0) { return 0; }
    if (load64(obj) != JTAG_OBJ) { return 0; }
    vec_push(load64(obj + 8), _jv_pair_new(key, val));
    return 0;
}

# === Tag predicates ===

# Return the value tag (JTAG_NULL/BOOL/INT/FLOAT/STR/ARR/OBJ), or -1 if v is 0.
fn bayan_json_v_tag(v): i64 {
    if (v == 0) { return 0 - 1; }
    return load64(v);
}

# Tag predicates — return 1 if v has the given tag, else 0. All return 0 on null v.
fn bayan_json_v_is_null(v): i64 { if (v == 0) { return 0; } if (load64(v) == JTAG_NULL)  { return 1; } return 0; }
# True if v is a JTAG_BOOL value.
fn bayan_json_v_is_bool(v): i64 { if (v == 0) { return 0; } if (load64(v) == JTAG_BOOL)  { return 1; } return 0; }
# True if v is a JTAG_INT value.
fn bayan_json_v_is_int(v): i64 { if (v == 0) { return 0; } if (load64(v) == JTAG_INT)   { return 1; } return 0; }
# True if v is a JTAG_FLOAT value.
fn bayan_json_v_is_float(v): i64 { if (v == 0) { return 0; } if (load64(v) == JTAG_FLOAT) { return 1; } return 0; }
# True if v is a JTAG_STR value.
fn bayan_json_v_is_str(v): i64 { if (v == 0) { return 0; } if (load64(v) == JTAG_STR)   { return 1; } return 0; }
# True if v is a JTAG_ARR value.
fn bayan_json_v_is_arr(v): i64 { if (v == 0) { return 0; } if (load64(v) == JTAG_ARR)   { return 1; } return 0; }
# True if v is a JTAG_OBJ value.
fn bayan_json_v_is_obj(v): i64 { if (v == 0) { return 0; } if (load64(v) == JTAG_OBJ)   { return 1; } return 0; }

# === Value accessors (INT/FLOAT coercion) ===

# Return v as i64 (0 or 1) if v is JTAG_BOOL, else 0.
fn bayan_json_v_bool(v): i64 {
    if (v == 0) { return 0; }
    if (load64(v) != JTAG_BOOL) { return 0; }
    return load64(v + 8);
}

# Return v as i64 — coerces JTAG_FLOAT via f64_to. Returns 0 on other tags.
fn bayan_json_v_int(v): i64 {
    if (v == 0) { return 0; }
    var t = load64(v);
    if (t == JTAG_INT) { return load64(v + 8); }
    if (t == JTAG_FLOAT) { return f64_to(load64(v + 8)); }
    return 0;
}

# Return v as f64 bit pattern — coerces JTAG_INT via f64_from. Returns f64_from(0) on other tags.
fn bayan_json_v_float(v): i64 {
    if (v == 0) { return 0; }
    var t = load64(v);
    if (t == JTAG_FLOAT) { return load64(v + 8); }
    if (t == JTAG_INT)   { return f64_from(load64(v + 8)); }
    return f64_from(0);
}

# Return v as Str ptr if v is JTAG_STR, else 0.
fn bayan_json_v_str(v): i64 {
    if (v == 0) { return 0; }
    if (load64(v) != JTAG_STR) { return 0; }
    return load64(v + 8);
}

# === Container accessors ===

# Return array length, or 0 if v is not JTAG_ARR.
fn bayan_json_v_arr_len(v): i64 {
    if (v == 0) { return 0; }
    if (load64(v) != JTAG_ARR) { return 0; }
    return vec_len(load64(v + 8));
}

# Return array element at index i (json_v* or 0 if out of range / wrong tag).
fn bayan_json_v_arr_get(v, i): i64 {
    if (v == 0) { return 0; }
    if (load64(v) != JTAG_ARR) { return 0; }
    var arr = load64(v + 8);
    if (i < 0) { return 0; }
    if (i >= vec_len(arr)) { return 0; }
    return vec_get(arr, i);
}

# Return object pair count, or 0 if v is not JTAG_OBJ.
fn bayan_json_v_obj_len(v): i64 {
    if (v == 0) { return 0; }
    if (load64(v) != JTAG_OBJ) { return 0; }
    return vec_len(load64(v + 8));
}

# Return the n-th object key (Str ptr or 0 if out of range / wrong tag).
fn bayan_json_v_obj_key(v, i): i64 {
    if (v == 0) { return 0; }
    if (load64(v) != JTAG_OBJ) { return 0; }
    var pairs = load64(v + 8);
    if (i < 0) { return 0; }
    if (i >= vec_len(pairs)) { return 0; }
    return load64(vec_get(pairs, i));
}

# Return the n-th object value (json_v* or 0 if out of range / wrong tag).
fn bayan_json_v_obj_val(v, i): i64 {
    if (v == 0) { return 0; }
    if (load64(v) != JTAG_OBJ) { return 0; }
    var pairs = load64(v + 8);
    if (i < 0) { return 0; }
    if (i >= vec_len(pairs)) { return 0; }
    return load64(vec_get(pairs, i) + 8);
}

# bayan_json_v_obj_get — lookup by C-string key. Returns json_v* or 0.
#
# ⛔ THE KEY IS A cstring HERE, BUT obj_set STORES A `Str`. The pair is deliberately
# asymmetric and always has been: `_jv_pair_new` writes `key` straight into the pair as a
# Str (see obj_set below), while this side does `strlen(key)`. Cyrius is i64-everywhere,
# so BOTH spellings compile and the symmetric-looking pair is memory-unsafe: passing a Str
# here makes `strlen` walk the 16-byte header, terminate a few bytes in on the data
# pointer's zero high bytes, and yield a junk length — so the compare misses and this
# returns 0, "not found". A SILENT WRONG ANSWER, which then SIGSEGVs downstream when the
# caller does `bayan_json_v_str(0)` -> `str_len(0)`.
#
# The `: cstring` annotation is what arms cyrius's existing Str-to-cstring diagnostic
# (src/frontend/parse_fn.cyr), which is otherwise inert because this parameter was
# untyped. It is DIAGNOSTIC ONLY — verified byte-identical output before and after — and
# it fires at every call site passing a Str-typed local, at any argument position.
#
# ⚠ DO NOT "fix" this by renaming to `_cstr` and giving the bare name a `: Str`. ~115
# call sites across ~16 repos pass a non-literal cstr and would break SILENTLY, and each
# break is WORSE than the current one (`str_len` on a raw cstr is arbitrary garbage). Use
# `bayan_json_v_obj_get_by_str` below for the Str-typed spelling. bayan 1.4.1.
fn bayan_json_v_obj_get(v, key: cstring): i64 {
    if (v == 0) { return 0; }
    if (load64(v) != JTAG_OBJ) { return 0; }
    var pairs = load64(v + 8);
    var n = vec_len(pairs);
    var klen = strlen(key);
    var i = 0;
    while (i < n) {
        var p = vec_get(pairs, i);
        var ks = load64(p);
        if (str_len(ks) == klen) {
            if (memeq(str_data(ks), key, klen) == 1) {
                return load64(p + 8);
            }
        }
        i = i + 1;
    }
    return 0;
}

# bayan_json_v_obj_get_by_str — the symmetric spelling: look up by `Str`, matching what
# `bayan_json_v_obj_set` stores. Additive, so no existing call site changes.
#
# ⚠ NOT named `..._obj_get_str`: a trailing `_str` is a RESERVED cyrius overload slot
# (the compiler dispatches `foo(Str, ...)` to `foo_str`), and claiming it here would make
# `bayan_json_v_obj_get("literal")` silently route to this function instead. bayan 1.4.1.
fn bayan_json_v_obj_get_by_str(v, key: Str): i64 {
    if (v == 0) { return 0; }
    if (load64(v) != JTAG_OBJ) { return 0; }
    return _jp_obj_lookup(v, str_data(key), str_len(key));
}

# === Reentrant parser state (v1.0.3) ===
#
# The recursive-descent value parser and the streaming parser both key off a
# per-call state struct threaded as their first argument — NOT module globals —
# so two threads can parse concurrently without clobbering each other's cursor.
# (Pre-1.0.3 this was a process-global _jp_buf/_jp_len/_jp_pos triplet; a second
# parse reset it mid-descent through the first. See
# docs/development/issues/2026-06-23-thoth-json-value-parser-global-cursor-not-thread-safe.md.)
#
# The state is _JP_STATE_SIZE bytes and may be stack- or heap-allocated by the
# caller; the globals-compat wrappers stack-allocate it, so existing callers are
# unaffected and become concurrency-safe. Node allocation still flows through the
# json_v_*_new constructors' default_alloc() — the filed race is the cursor, not
# the node arena (use a thread-safe / thread-local allocator for concurrent node
# allocation).
#
# Layout:
#   +0   buf      cstr   input pointer        (invariant during a parse)
#   +8   len      i64    input length         (invariant during a parse)
#   +16  pos      i64    current byte offset   (advanced through the descent)
#   +24  err_msg  cstr   parse-error message, or 0
#   +32  err_pos  i64    byte offset of the parse error
#   +40  depth    i64    open-container count  (bounds recursion, cap _JP_MAX_DEPTH)
var _JP_STATE_SIZE = 48;

# Recursion-depth cap shared by both descents (value + streaming). 128 matches
# serde_json's default, so Rust→Cyrius ports keep wire parity: a deeper
# document fails the parse with "nesting too deep" through the normal per-call
# error path instead of overflowing the caller's stack (a hostile `[[[[…` body
# costs 2 bytes per level, so any untrusted input can otherwise out-recurse any
# thread stack). See
# docs/development/issues/2026-07-16-agnosai-json-no-recursion-depth-cap.md.
var _JP_MAX_DEPTH = 128;

# Initialise a parser state over (buf, len). pos = 0, error cleared, depth 0.
fn _jp_state_init(ps, buf, len): i64 {
    store64(ps,      buf);
    store64(ps + 8,  len);
    store64(ps + 16, 0);
    store64(ps + 24, 0);
    store64(ps + 32, 0);
    store64(ps + 40, 0);
    return 0;
}

# Record a parse error (message + byte offset) into the per-call state. `pos` is
# passed explicitly because the hot scanners keep the cursor in a local.
fn _jp_set_err(ps, msg, pos): i64 {
    store64(ps + 24, msg);
    store64(ps + 32, pos);
    return 0;
}

# Skip whitespace (space, tab, LF, CR). Advances ps's cursor.
fn _jp_skip_ws(ps): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var pos = load64(ps + 16);
    while (pos < len) {
        var c = load8(buf + pos);
        if (c == 32 || c == 9 || c == 10 || c == 13) { pos = pos + 1; }
        else { store64(ps + 16, pos); return 0; }
    }
    store64(ps + 16, pos);
    return 0;
}

# Decode a hex digit (returns -1 if not a hex digit).
fn _jp_hex(c): i64 {
    if (c >= 48) { if (c <= 57)  { return c - 48; } }
    if (c >= 97) { if (c <= 102) { return c - 87; } }
    if (c >= 65) { if (c <= 70)  { return c - 55; } }
    return 0 - 1;
}

# Encode codepoint cp as UTF-8 into dst; return bytes written (1..4).
# Caller handles surrogate pairs before calling.
fn _jp_emit_utf8(dst, cp): i64 {
    if (cp < 128)    { store8(dst, cp); return 1; }
    if (cp < 2048)   {
        store8(dst, 192 | (cp >> 6));
        store8(dst + 1, 128 | (cp & 63));
        return 2;
    }
    if (cp < 65536)  {
        store8(dst, 224 | (cp >> 12));
        store8(dst + 1, 128 | ((cp >> 6) & 63));
        store8(dst + 2, 128 | (cp & 63));
        return 3;
    }
    store8(dst, 240 | (cp >> 18));
    store8(dst + 1, 128 | ((cp >> 12) & 63));
    store8(dst + 2, 128 | ((cp >> 6) & 63));
    store8(dst + 3, 128 | (cp & 63));
    return 4;
}

# Allocator-as-first-arg variant of _jp_parse_string. Returns Str* or 0.
#
# Parse a JSON string starting at the opening quote. Returns Str* or 0.
# On entry, ps's cursor points at the `"`. On success it points just past the
# closing `"`. The cursor is kept in a local for the hot scan loop and written
# back to ps only on success (error paths abort the whole parse).
fn _jp_parse_string_a(a, ps): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var pos = load64(ps + 16);
    if (pos >= len) { _jp_set_err(ps, "unexpected EOF in string", pos); return 0; }
    if (load8(buf + pos) != 34) { _jp_set_err(ps, "expected string", pos); return 0; }
    pos = pos + 1;
    # Size the buffer from THIS STRING'S span, not from the rest of the
    # document (1.5.1 — this was a quadratic memory blowup).
    #
    # `cap = len - pos + 1` used the whole remaining document length, so every
    # string in a document allocated ~(document size) bytes and nothing is ever
    # freed on a bump allocator. Measured on `["a","a",...]`: 40 KB of input
    # took 200 MB of heap, and 1 MB of input took 125 GB / 46 GB RSS. Both
    # parsers share this helper, so the STREAMING parser — whose entire stated
    # purpose is bounded memory for multi-MB input — was the most quadratic
    # path in the module.
    #
    # A pre-scan for the closing quote costs one extra linear pass per string,
    # so the parse stays O(n) overall while memory drops to O(sum of string
    # lengths). Decoding never expands: an escape is at least 2 raw bytes for 1
    # out, \uXXXX is 6 raw for at most 3 out, and a surrogate pair is 12 raw  #skip-lint: \u-escape notation, not a deferral
    # for 4 — so the raw span is always a sufficient cap.
    var scan = pos;
    while (scan < len) {
        var sc = load8(buf + scan);
        if (sc == 34) { break; }
        # Consume the backslash AND the byte it escapes, so an escaped quote
        # does not end the scan. A trailing lone backslash pushes scan past
        # len and is caught by the check below.
        if (sc == 92) { scan = scan + 1; }
        scan = scan + 1;
    }
    if (scan >= len) { _jp_set_err(ps, "unterminated string", pos); return 0; }
    var cap = scan - pos + 1;
    var out = alloc_via(a, cap + 4);
    # 1.4.0: an arena can genuinely run dry here; the pre-1.4.0 body used the
    # global bump and never checked, so a 0 would have been written through.
    if (out == 0) { _jp_set_err(ps, "out of memory in string", pos); return 0; }
    var oi = 0;
    while (1 == 1) {
        if (pos >= len) { _jp_set_err(ps, "unterminated string", pos); return 0; }
        var c = load8(buf + pos);
        if (c == 34) { pos = pos + 1; store64(ps + 16, pos); store8(out + oi, 0); return str_new_a(a, out, oi); }
        if (c == 92) {
            # Escape sequence
            pos = pos + 1;
            if (pos >= len) { _jp_set_err(ps, "unterminated escape", pos); return 0; }
            var e = load8(buf + pos);
            pos = pos + 1;
            if      (e == 34)  { store8(out + oi,  34); oi = oi + 1; }
            elif    (e == 92)  { store8(out + oi,  92); oi = oi + 1; }
            elif    (e == 47)  { store8(out + oi,  47); oi = oi + 1; }
            elif    (e == 98)  { store8(out + oi,   8); oi = oi + 1; }
            elif    (e == 102) { store8(out + oi,  12); oi = oi + 1; }
            elif    (e == 110) { store8(out + oi,  10); oi = oi + 1; }
            elif    (e == 114) { store8(out + oi,  13); oi = oi + 1; }
            elif    (e == 116) { store8(out + oi,   9); oi = oi + 1; }
            elif    (e == 117) {
                if (pos + 3 >= len) { _jp_set_err(ps, "\\u needs 4 hex digits", pos); return 0; }
                var d0 = _jp_hex(load8(buf + pos));
                var d1 = _jp_hex(load8(buf + pos + 1));
                var d2 = _jp_hex(load8(buf + pos + 2));
                var d3 = _jp_hex(load8(buf + pos + 3));
                if (d0 < 0 || d1 < 0 || d2 < 0 || d3 < 0) { _jp_set_err(ps, "\\u: bad hex digit", pos); return 0; }
                pos = pos + 4;
                var cp = (d0 << 12) | (d1 << 8) | (d2 << 4) | d3;
                # Surrogate pair handling
                if (cp >= 0xD800 && cp <= 0xDBFF) {
                    # High surrogate — expect low surrogate next
                    if (pos + 5 >= len) { _jp_set_err(ps, "incomplete surrogate pair", pos); return 0; }
                    if (load8(buf + pos) != 92 || load8(buf + pos + 1) != 117) {
                        _jp_set_err(ps, "expected low surrogate after high", pos);
                        return 0;
                    }
                    pos = pos + 2;
                    var l0 = _jp_hex(load8(buf + pos));
                    var l1 = _jp_hex(load8(buf + pos + 1));
                    var l2 = _jp_hex(load8(buf + pos + 2));
                    var l3 = _jp_hex(load8(buf + pos + 3));
                    if (l0 < 0 || l1 < 0 || l2 < 0 || l3 < 0) {
                        _jp_set_err(ps, "low surrogate: bad hex", pos); return 0;
                    }
                    pos = pos + 4;
                    var lo = (l0 << 12) | (l1 << 8) | (l2 << 4) | l3;
                    if (lo < 0xDC00 || lo > 0xDFFF) { _jp_set_err(ps, "invalid low surrogate", pos); return 0; }
                    cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
                }
                elif (cp >= 0xDC00 && cp <= 0xDFFF) {
                    _jp_set_err(ps, "unexpected low surrogate", pos);
                    return 0;
                }
                oi = oi + _jp_emit_utf8(out + oi, cp);
            }
            else { _jp_set_err(ps, "unknown escape sequence", pos); return 0; }
        }
        else {
            # Ordinary byte
            store8(out + oi, c);
            oi = oi + 1;
            pos = pos + 1;
        }
    }
    return 0;
}

# Parse a JSON string starting at the opening quote. Returns Str* or 0.
# Back-compat wrapper over the allocator-threaded form.
fn _jp_parse_string(ps): i64 {
    return _jp_parse_string_a(default_alloc(), ps);
}

# Allocator-as-first-arg variant of _jp_parse_number.
#
# Parse a number. Returns json_v* (INT or FLOAT) or 0. Cursor kept in a local;
# written back to ps before the (allocating) constructor call on success.
fn _jp_parse_number_a(a, ps): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var pos = load64(ps + 16);
    var start = pos;
    var is_float = 0;
    # Optional minus
    if (pos < len && load8(buf + pos) == 45) { pos = pos + 1; }
    # Integer part. At least ONE digit is required (1.5.1): the old code only
    # rejected an EMPTY token via `pos == start`, so a lone "-" advanced the
    # cursor by one, passed that check, and parsed as the integer 0 — and
    # "[-,-]" serialised back out as "[0,0]". Same for a fraction or exponent
    # with no digits: "1." and "1e" were accepted.
    var int_digits = 0;
    while (pos < len) {
        var c = load8(buf + pos);
        if (c >= 48 && c <= 57) { pos = pos + 1; int_digits = int_digits + 1; }
        else { break; }
    }
    if (int_digits == 0) { _jp_set_err(ps, "expected number", start); return 0; }
    var int_end = pos;
    # Fraction
    if (pos < len && load8(buf + pos) == 46) {
        is_float = 1;
        pos = pos + 1;
        var frac_digits = 0;
        while (pos < len) {
            var c2 = load8(buf + pos);
            if (c2 >= 48 && c2 <= 57) { pos = pos + 1; frac_digits = frac_digits + 1; }
            else { break; }
        }
        if (frac_digits == 0) { _jp_set_err(ps, "expected digits after the decimal point", pos); return 0; }
    }
    # Exponent
    if (pos < len) {
        var ec = load8(buf + pos);
        if (ec == 101 || ec == 69) {
            is_float = 1;
            pos = pos + 1;
            if (pos < len) {
                var sg = load8(buf + pos);
                if (sg == 43 || sg == 45) { pos = pos + 1; }
            }
            var exp_digits = 0;
            while (pos < len) {
                var c3 = load8(buf + pos);
                if (c3 >= 48 && c3 <= 57) { pos = pos + 1; exp_digits = exp_digits + 1; }
                else { break; }
            }
            if (exp_digits == 0) { _jp_set_err(ps, "expected digits in the exponent", pos); return 0; }
        }
    }
    store64(ps + 16, pos);
    if (is_float == 1) {
        var fbits = _jp_atof(buf + start, pos - start);
        var fv2 = bayan_json_v_float_new_a(a, fbits);
        if (fv2 == 0) { _jp_set_err(ps, "out of memory building a number", start); }
        return fv2;
    }
    # RANGE (1.5.1). _jp_atoi accumulates with `n * 10 + d` and wraps silently,
    # so 9223372036854775808 came back as -9223372036854775808 — a value whose
    # SIGN differs from the document's, round-tripping out of the serialiser as
    # a different number with no error. An integer bayan cannot represent is
    # now a parse error rather than a plausible wrong answer.
    if (_jp_int_fits(buf + start, int_end - start) == 0) {
        _jp_set_err(ps, "integer is out of range for i64", start);
        return 0;
    }
    var iv = _jp_atoi(buf + start, pos - start);
    var ivv = bayan_json_v_int_new_a(a, iv);
    if (ivv == 0) { _jp_set_err(ps, "out of memory building a number", start); }
    return ivv;
}

# Parse a number. Back-compat wrapper over the allocator-threaded form.
fn _jp_parse_number(ps): i64 {
    return _jp_parse_number_a(default_alloc(), ps);
}

# Parse a signed integer from buf[0..len). Returns i64.
# 1 when the decimal integer in buf[0..len) fits in an i64, else 0.
# `len` covers an optional leading '-' and the integer digits only.
#
# Compares by DIGIT COUNT then lexically against the i64 bound, because the
# obvious check — accumulate and see if it went negative — is exactly the
# wrapping this exists to detect.
fn _jp_int_fits(buf, len): i64 {
    var i = 0;
    var neg = 0;
    if (len > 0 && load8(buf) == 45) { neg = 1; i = 1; }
    # Leading zeros do not count toward magnitude.
    while (i < len && load8(buf + i) == 48) { i = i + 1; }
    var digits = len - i;
    if (digits < 19) { return 1; }
    if (digits > 19) { return 0; }
    var bound = "9223372036854775807";
    if (neg == 1) { bound = "9223372036854775808"; }
    var k = 0;
    while (k < 19) {
        var d = load8(buf + i + k);
        var b = load8(bound + k);
        if (d < b) { return 1; }
        if (d > b) { return 0; }
        k = k + 1;
    }
    return 1;
}

fn _jp_atoi(buf, len): i64 {
    var i = 0;
    var sign = 1;
    if (len > 0 && load8(buf) == 45) { sign = 0 - 1; i = 1; }
    var n = 0;
    while (i < len) {
        n = n * 10 + (load8(buf + i) - 48);
        i = i + 1;
    }
    return sign * n;
}

# Parse a float from buf[0..len). Returns f64 bit pattern.
# Handles signed mantissa, optional fraction, optional signed exponent.
# v1.2.1: delegates to the correctly-rounded, DoS-safe parser in dtoa.cyr. The
# old body accumulated digits in f64 (imprecise, disagreed with math f64_parse by
# 1 ULP) and applied the exponent as a loop of once-per-unit-of-exponent-VALUE
# f64 muls (O(exp) -> a 17-byte "1e100000000" burned ~237 ms). See dtoa.cyr.
fn _jp_atof(buf, len): i64 { return bayan_f64_parse(buf, len); }

# === Main parse entry ===

# Allocator-as-first-arg variant of _jp_parse_value.
#
# Recursive value parser. Returns json_v* or 0. The structural parsers cross
# sub-parser call boundaries, so they read/advance the cursor directly in ps
# (ps + 16) rather than caching it — no local/state desync is possible.
fn _jp_parse_value_a(a, ps): i64 {
    _jp_skip_ws(ps);
    var buf = load64(ps);
    var len = load64(ps + 8);
    var pos = load64(ps + 16);
    if (pos >= len) { _jp_set_err(ps, "unexpected EOF", pos); return 0; }
    var c = load8(buf + pos);
    if (c == 123 || c == 91) {
        # Containers recurse — bound the descent before entering (scalars can't
        # recurse, so only these two branches touch the depth counter).
        var depth = load64(ps + 40);
        if (depth >= _JP_MAX_DEPTH) { _jp_set_err(ps, "nesting too deep", pos); return 0; }
        store64(ps + 40, depth + 1);
        var v = 0;
        if (c == 123) { v = _jp_parse_object_a(a, ps); }
        else          { v = _jp_parse_array_a(a, ps); }
        store64(ps + 40, depth);
        return v;
    }
    if (c == 34)  {
        var s = _jp_parse_string_a(a, ps);
        if (s == 0) { return 0; }
        # A constructor returns 0 on OOM. Handing that back bare is
        # indistinguishable from a parse failure and leaves err_msg EMPTY, so
        # the caller sees "parse returned 0" with nothing to report (1.5.1 —
        # measured on a real arena: of 31 capacities that failed a "[1,2,3]"
        # parse, 9 reported no error at all). Every scalar arm now names it.
        var sv = bayan_json_v_str_new_a(a, s);
        if (sv == 0) { _jp_set_err(ps, "out of memory building a string value", pos); }
        return sv;
    }
    if (c == 116) {
        if (pos + 3 < len && memeq(buf + pos + 1, "rue", 3) == 1) {
            store64(ps + 16, pos + 4);
            var tv = bayan_json_v_bool_new_a(a, 1);
            if (tv == 0) { _jp_set_err(ps, "out of memory building a boolean", pos); }
            return tv;
        }
        _jp_set_err(ps, "expected 'true'", pos); return 0;
    }
    if (c == 102) {
        if (pos + 4 < len && memeq(buf + pos + 1, "alse", 4) == 1) {
            store64(ps + 16, pos + 5);
            var fv = bayan_json_v_bool_new_a(a, 0);
            if (fv == 0) { _jp_set_err(ps, "out of memory building a boolean", pos); }
            return fv;
        }
        _jp_set_err(ps, "expected 'false'", pos); return 0;
    }
    if (c == 110) {
        if (pos + 3 < len && memeq(buf + pos + 1, "ull", 3) == 1) {
            store64(ps + 16, pos + 4);
            var nv = bayan_json_v_null_a(a);
            if (nv == 0) { _jp_set_err(ps, "out of memory building null", pos); }
            return nv;
        }
        _jp_set_err(ps, "expected 'null'", pos); return 0;
    }
    if (c == 45 || (c >= 48 && c <= 57)) {
        return _jp_parse_number_a(a, ps);
    }
    _jp_set_err(ps, "unexpected character", pos);
    return 0;
}

# Recursive value parser. Back-compat wrapper over the allocator-threaded form.
fn _jp_parse_value(ps): i64 {
    return _jp_parse_value_a(default_alloc(), ps);
}

# Allocator-as-first-arg variant of _jp_parse_array.
fn _jp_parse_array_a(a, ps): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    if (load8(buf + load64(ps + 16)) != 91) { _jp_set_err(ps, "expected '['", load64(ps + 16)); return 0; }
    store64(ps + 16, load64(ps + 16) + 1);
    var arr = bayan_json_v_arr_new_a(a);
    if (arr == 0) { _jp_set_err(ps, "out of memory in array", load64(ps + 16)); return 0; }
    _jp_skip_ws(ps);
    if (load64(ps + 16) < len && load8(buf + load64(ps + 16)) == 93) {
        store64(ps + 16, load64(ps + 16) + 1);
        return arr;
    }
    while (1 == 1) {
        var v = _jp_parse_value_a(a, ps);
        if (v == 0) { return 0; }
        if (bayan_json_v_arr_push_a(a, arr, v) != 0) {
            _jp_set_err(ps, "out of memory in array", load64(ps + 16)); return 0;
        }
        _jp_skip_ws(ps);
        if (load64(ps + 16) >= len) { _jp_set_err(ps, "unterminated array", load64(ps + 16)); return 0; }
        var c = load8(buf + load64(ps + 16));
        if (c == 44) { store64(ps + 16, load64(ps + 16) + 1); _jp_skip_ws(ps); }
        elif (c == 93) { store64(ps + 16, load64(ps + 16) + 1); return arr; }
        else { _jp_set_err(ps, "expected ',' or ']'", load64(ps + 16)); return 0; }
    }
    return 0;
}

# Back-compat wrapper over the allocator-threaded form.
fn _jp_parse_array(ps): i64 {
    return _jp_parse_array_a(default_alloc(), ps);
}

# Allocator-as-first-arg variant of _jp_parse_object.
fn _jp_parse_object_a(a, ps): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    if (load8(buf + load64(ps + 16)) != 123) { _jp_set_err(ps, "expected '{'", load64(ps + 16)); return 0; }
    store64(ps + 16, load64(ps + 16) + 1);
    var obj = bayan_json_v_obj_new_a(a);
    if (obj == 0) { _jp_set_err(ps, "out of memory in object", load64(ps + 16)); return 0; }
    _jp_skip_ws(ps);
    if (load64(ps + 16) < len && load8(buf + load64(ps + 16)) == 125) {
        store64(ps + 16, load64(ps + 16) + 1);
        return obj;
    }
    while (1 == 1) {
        _jp_skip_ws(ps);
        var k = _jp_parse_string_a(a, ps);
        if (k == 0) { return 0; }
        _jp_skip_ws(ps);
        if (load64(ps + 16) >= len) { _jp_set_err(ps, "unterminated object", load64(ps + 16)); return 0; }
        if (load8(buf + load64(ps + 16)) != 58) {
            _jp_set_err(ps, "expected ':' after key", load64(ps + 16)); return 0;
        }
        store64(ps + 16, load64(ps + 16) + 1);
        _jp_skip_ws(ps);
        var val = _jp_parse_value_a(a, ps);
        if (val == 0) { return 0; }
        if (bayan_json_v_obj_set_a(a, obj, k, val) != 0) {
            _jp_set_err(ps, "out of memory in object", load64(ps + 16)); return 0;
        }
        _jp_skip_ws(ps);
        if (load64(ps + 16) >= len) { _jp_set_err(ps, "unterminated object", load64(ps + 16)); return 0; }
        var c = load8(buf + load64(ps + 16));
        if (c == 44) { store64(ps + 16, load64(ps + 16) + 1); }
        elif (c == 125) { store64(ps + 16, load64(ps + 16) + 1); return obj; }
        else { _jp_set_err(ps, "expected ',' or '}'", load64(ps + 16)); return 0; }
    }
    return 0;
}

# Back-compat wrapper over the allocator-threaded form.
fn _jp_parse_object(ps): i64 {
    return _jp_parse_object_a(default_alloc(), ps);
}

# === Reentrant parse entry (v1.0.3, thread-safe) ===
#
# bayan_json_v_parse_ctx threads all parser state through `ps` (a caller-owned
# _JP_STATE_SIZE-byte buffer — stack `var ps[48]` or heap `alloc(...)`). It
# touches NO module globals, so concurrent threads each parsing into their own
# `ps` cannot corrupt one another's cursor. On failure it returns 0 and records
# the error in `ps`; read it with bayan_json_state_error()/_pos().

# Size (bytes) a caller must reserve for a parser state passed to *_parse_ctx*.
fn bayan_json_parse_state_size(): i64 { return _JP_STATE_SIZE; }

# Error message (cstr) recorded in a parser state, or "" if none.
fn bayan_json_state_error(ps): i64 {
    var m = load64(ps + 24);
    if (m == 0) { return ""; }
    return m;
}

# Byte offset of the error recorded in a parser state.
fn bayan_json_state_error_pos(ps): i64 { return load64(ps + 32); }

# Allocator-as-first-arg variant of bayan_json_v_parse_ctx — the whole value
# tree (cells, pair cells, decoded key/value strings, and any vec growth) lands
# on `a`. Pair it with an arena + reset_via to make a parse cost nothing after
# the request that needed it. Returns json_v* or 0; on 0 the error lives in `ps`
# and an exhausted arena reports as a normal "out of memory in ..." parse error.
fn bayan_json_v_parse_ctx_a(a, ps, buf, len): i64 {
    _jp_state_init(ps, buf, len);
    var v = _jp_parse_value_a(a, ps);
    if (v == 0) { return 0; }
    _jp_skip_ws(ps);
    if (load64(ps + 16) != len) {
        _jp_set_err(ps, "trailing content after JSON value", load64(ps + 16));
        return 0;
    }
    return v;
}

# Reentrant parse — explicit cstr+len into a caller-owned state. Returns
# json_v* or 0; on 0 the error lives in `ps`. Does not touch the legacy globals.
fn bayan_json_v_parse_ctx(ps, buf, len): i64 {
    return bayan_json_v_parse_ctx_a(default_alloc(), ps, buf, len);
}

# Reentrant parse — Str convenience over bayan_json_v_parse_ctx.
fn bayan_json_v_parse_ctx_str(ps, src): i64 {
    if (src == 0) {
        _jp_state_init(ps, 0, 0);
        _jp_set_err(ps, "null source", 0);
        return 0;
    }
    return bayan_json_v_parse_ctx(ps, str_data(src), str_len(src));
}

# Public parse entry — Str. Returns json_v* or 0.
fn bayan_json_v_parse(src): i64 {
    if (src == 0) { _json_err_msg = "null source"; _json_err_pos = 0; return 0; }
    return bayan_json_v_parse_buf(str_data(src), str_len(src));
}

# Allocator-as-first-arg variant of bayan_json_v_parse — Str convenience over
# bayan_json_v_parse_buf_a.
fn bayan_json_v_parse_a(a, src): i64 {
    if (src == 0) { _json_err_msg = "null source"; _json_err_pos = 0; return 0; }
    return bayan_json_v_parse_buf_a(a, str_data(src), str_len(src));
}

# Public parse entry — explicit cstr+len. Globals-compat wrapper over the
# reentrant path: each call owns a stack-local parser state (so the parse itself
# is now thread-safe), then mirrors the per-call error into the legacy
# bayan_json_last_error()/_pos() slots for source compatibility. Concurrent
# callers that need race-free error reporting should call bayan_json_v_parse_ctx
# directly and read bayan_json_state_error()/_pos().
#
# NAMED `_buf`, NOT `_str` — and it must stay that way. Cyrius routes a call
# `X(a, ...)` to `X_str` whenever `a` is Str-typed at the call site and `X_str`
# exists (the same overload dispatch that routes `&IDENT` to `_ptr`). While this
# was `bayan_json_v_parse_str`, every `bayan_json_v_parse(someStr)` in the
# ecosystem was silently rewritten into a 1-arg call to this 2-arg function and
# returned 0 for valid JSON. In Cyrius, `X_str` means "the Str-taking variant of
# X" — so a cstr+len form may never occupy that name. See CHANGELOG [1.3.0].
fn bayan_json_v_parse_buf(buf, len): i64 {
    var ps[48];
    var v = bayan_json_v_parse_ctx(&ps, buf, len);
    _json_err_msg = load64(&ps + 24);
    _json_err_pos = load64(&ps + 32);
    return v;
}

# Allocator-as-first-arg variant of bayan_json_v_parse_buf. The whole tree lands
# on `a`; the parser state stays a stack local, so this allocates nothing outside
# `a`. Mirrors the same legacy-globals error slots as the non-`_a` form, so it is
# a drop-in for the common single-threaded call site.
#
# The `_buf` / `_str` naming rule above applies here too: the allocator suffix
# `_a` is a plain convention (as in str_from_a / alloc_via), NOT one of Cyrius's
# dispatch suffixes, so it cannot collide with the `X_str` / `X_ptr` routing.
fn bayan_json_v_parse_buf_a(a, buf, len): i64 {
    var ps[48];
    var v = bayan_json_v_parse_ctx_a(a, &ps, buf, len);
    _json_err_msg = load64(&ps + 24);
    _json_err_pos = load64(&ps + 32);
    return v;
}

# === Serializer ===

# Allocator-as-first-arg variant of _jb_append_string. Returns -1 if any
# grow through `a` fails, 0 otherwise.
fn _jb_append_string_a(a, sb, s): i64 {
    if (str_builder_add_cstr_a(a, sb, "\"") != 0) { return 0 - 1; }
    var data = str_data(s);
    var slen = str_len(s);
    var i = 0;
    while (i < slen) {
        var c = load8(data + i);
        var rc = 0;
        if      (c == 34) { rc = str_builder_add_cstr_a(a, sb, "\\\""); }
        elif    (c == 92) { rc = str_builder_add_cstr_a(a, sb, "\\\\"); }
        elif    (c ==  8) { rc = str_builder_add_cstr_a(a, sb, "\\b"); }
        elif    (c == 12) { rc = str_builder_add_cstr_a(a, sb, "\\f"); }
        elif    (c == 10) { rc = str_builder_add_cstr_a(a, sb, "\\n"); }
        elif    (c == 13) { rc = str_builder_add_cstr_a(a, sb, "\\r"); }
        elif    (c ==  9) { rc = str_builder_add_cstr_a(a, sb, "\\t"); }
        elif    (c < 32) {
            # Control char — emit \u00XX
            if (str_builder_add_cstr_a(a, sb, "\\u00") != 0) { return 0 - 1; }
            var hi = c >> 4;
            var lo = c & 15;
            var hb[3];
            if (hi < 10) { store8(&hb, 48 + hi); } else { store8(&hb, 87 + hi); }
            if (lo < 10) { store8(&hb + 1, 48 + lo); } else { store8(&hb + 1, 87 + lo); }
            store8(&hb + 2, 0);
            rc = str_builder_add_cstr_a(a, sb, &hb);
        }
        else {
            var bb[2];
            store8(&bb, c);
            store8(&bb + 1, 0);
            rc = str_builder_add_cstr_a(a, sb, &bb);
        }
        if (rc != 0) { return 0 - 1; }
        i = i + 1;
    }
    if (str_builder_add_cstr_a(a, sb, "\"") != 0) { return 0 - 1; }
    return 0;
}

# Append a JSON-escaped string into sb, including the surrounding quotes.
# Back-compat wrapper: aborts on OOM, matching the non-`_a` str_builder verbs
# it used to call directly.
fn _jb_append_string(sb, s): i64 {
    if (_jb_append_string_a(default_alloc(), sb, s) != 0) {
        syscall(1, 2, "bayan: json build alloc failed\n", 31);
        _sb_die();
    }
    return 0;
}

# Allocator-as-first-arg variant of _jb_emit_indent. Returns -1 on grow OOM.
#
# Emits the newline and each space through `str_builder_add_cstr_a` rather than
# `str_builder_add_byte`, which has no `_a` form and aborts on OOM. The bytes
# emitted are identical — both literals are one byte — so pretty output is
# unchanged; this only moves the growth onto `a` and makes the failure
# reportable instead of fatal.
fn _jb_emit_indent_a(a, sb, indent, level): i64 {
    if (str_builder_add_cstr_a(a, sb, "\n") != 0) { return 0 - 1; }
    var total = indent * level;
    var i = 0;
    while (i < total) {
        if (str_builder_add_cstr_a(a, sb, " ") != 0) { return 0 - 1; }
        i = i + 1;
    }
    return 0;
}

# Emit '\n' followed by (indent * level) spaces. Pretty-mode helper.
# Back-compat wrapper: aborts on OOM.
fn _jb_emit_indent(sb, indent, level): i64 {
    if (_jb_emit_indent_a(default_alloc(), sb, indent, level) != 0) {
        syscall(1, 2, "bayan: json build alloc failed\n", 31);
        _sb_die();
    }
    return 0;
}

# Allocator-as-first-arg variant of _jb_walk. Returns -1 if any append or grow
# through `a` fails, 0 otherwise. This is the single implementation; the
# back-compat `_jb_walk` delegates to it.
#
# Unified compact + pretty walker. `indent` param drives mode:
# 0 = compact (":" separator), >0 = pretty (newlines, ": ").
# `if n > 0` guards empty-container case for both modes.
# See CHANGELOG [5.7.47].
#
# NOTE: the recursion here is uncapped, matching the pre-1.4.0 serializer. Only
# reachable from a tree the caller built, so it is not an untrusted-input path
# — but do not build unbounded-depth values from user data. (The *parsers* both
# cap at _JP_MAX_DEPTH; the serializer never has.)
fn _jb_walk_a(a, sb, v, indent, level): i64 {
    if (v == 0) { return str_builder_add_cstr_a(a, sb, "null"); }
    var t = load64(v);
    if      (t == JTAG_NULL)  { return str_builder_add_cstr_a(a, sb, "null"); }
    elif    (t == JTAG_BOOL)  {
        if (load64(v + 8) == 0) { return str_builder_add_cstr_a(a, sb, "false"); }
        return str_builder_add_cstr_a(a, sb, "true");
    }
    elif    (t == JTAG_INT)   {
        var nb[24];
        var nl = fmt_int_buf(load64(v + 8), &nb);
        store8(&nb + nl, 0);
        return str_builder_add_cstr_a(a, sb, &nb);
    }
    elif    (t == JTAG_FLOAT) {
        var fb[64];
        # v1.2.1: Grisu2 round-trip-correct (was fmt_float_buf(,6) — 6-decimal cap
        # lost mantissa bits, flushed |x|<5e-7 to 0, and emitted "-.00000-" for
        # Inf/NaN/>=2^63). Non-finite -> "null". See dtoa.cyr.
        var fl = bayan_f64_to_json(load64(v + 8), &fb);
        store8(&fb + fl, 0);
        return str_builder_add_cstr_a(a, sb, &fb);
    }
    elif    (t == JTAG_STR)   { return _jb_append_string_a(a, sb, load64(v + 8)); }
    elif    (t == JTAG_ARR)   {
        if (str_builder_add_cstr_a(a, sb, "[") != 0) { return 0 - 1; }
        var arr = load64(v + 8);
        var n = vec_len(arr);
        if (n > 0) {
            var i = 0;
            while (i < n) {
                if (i > 0) {
                    if (str_builder_add_cstr_a(a, sb, ",") != 0) { return 0 - 1; }
                }
                if (indent > 0) {
                    if (_jb_emit_indent_a(a, sb, indent, level + 1) != 0) { return 0 - 1; }
                }
                if (_jb_walk_a(a, sb, vec_get(arr, i), indent, level + 1) != 0) { return 0 - 1; }
                i = i + 1;
            }
            if (indent > 0) {
                if (_jb_emit_indent_a(a, sb, indent, level) != 0) { return 0 - 1; }
            }
        }
        return str_builder_add_cstr_a(a, sb, "]");
    }
    elif    (t == JTAG_OBJ)   {
        if (str_builder_add_cstr_a(a, sb, "{") != 0) { return 0 - 1; }
        var pairs = load64(v + 8);
        var pn = vec_len(pairs);
        if (pn > 0) {
            var pi = 0;
            while (pi < pn) {
                if (pi > 0) {
                    if (str_builder_add_cstr_a(a, sb, ",") != 0) { return 0 - 1; }
                }
                if (indent > 0) {
                    if (_jb_emit_indent_a(a, sb, indent, level + 1) != 0) { return 0 - 1; }
                }
                var p = vec_get(pairs, pi);
                if (_jb_append_string_a(a, sb, load64(p)) != 0) { return 0 - 1; }
                if (indent > 0) {
                    if (str_builder_add_cstr_a(a, sb, ": ") != 0) { return 0 - 1; }
                } else {
                    if (str_builder_add_cstr_a(a, sb, ":") != 0) { return 0 - 1; }
                }
                if (_jb_walk_a(a, sb, load64(p + 8), indent, level + 1) != 0) { return 0 - 1; }
                pi = pi + 1;
            }
            if (indent > 0) {
                if (_jb_emit_indent_a(a, sb, indent, level) != 0) { return 0 - 1; }
            }
        }
        return str_builder_add_cstr_a(a, sb, "}");
    }
    return str_builder_add_cstr_a(a, sb, "null");
}

# Back-compat walker: aborts on OOM, matching the non-`_a` str_builder verbs
# this used to call directly. On the global bump allocator that branch is
# effectively unreachable (alloc only returns 0 for size<=0 or >ALLOC_MAX, and a
# failed chunk mmap exits inside alloc_init); with an arena it is reachable,
# which is exactly why the `_a` form reports rather than aborts.
fn _jb_walk(sb, v, indent, level): i64 {
    if (_jb_walk_a(default_alloc(), sb, v, indent, level) != 0) {
        syscall(1, 2, "bayan: json build alloc failed\n", 31);
        _sb_die();
    }
    return 0;
}

# Allocator-as-first-arg variant of bayan_json_v_build. Routes the builder's
# scratch buffer, every grow, and the final Str through `a`. Returns 0 on OOM
# (the caller cannot tell a failed build from an empty tree by the return value
# alone — check for 0, which a successful build never returns).
#
# This is the half of a per-request JSON response that an arena could not reach
# before 1.4.0: the value tree had `_a` constructors, the serializer did not.
fn bayan_json_v_build_a(a, v): i64 {
    var sb = str_builder_new_a(a);
    if (sb == 0) { return 0; }
    if (_jb_walk_a(a, sb, v, 0, 0) != 0) { return 0; }
    return str_builder_build_a(a, sb);
}

# bayan_json_v_build — serialize a tagged value tree to a Str (compact).
fn bayan_json_v_build(v): i64 {
    var sb = str_builder_new();
    _jb_walk(sb, v, 0, 0);
    return str_builder_build(sb);
}

# bayan_json_v_build_pretty — serialize a tagged value tree with newlines + indent.
# `indent` is the spaces per level; `indent <= 0` falls back to compact.
fn bayan_json_v_build_pretty(v, indent): i64 {
    if (indent <= 0) { return bayan_json_v_build(v); }
    var sb = str_builder_new();
    _jb_walk(sb, v, indent, 0);
    return str_builder_build(sb);
}

# Allocator-as-first-arg variant of bayan_json_v_build_pretty. Same `indent <= 0`
# fallback to the compact form. Returns 0 on OOM.
fn bayan_json_v_build_pretty_a(a, v, indent): i64 {
    if (indent <= 0) { return bayan_json_v_build_a(a, v); }
    var sb = str_builder_new_a(a);
    if (sb == 0) { return 0; }
    if (_jb_walk_a(a, sb, v, indent, 0) != 0) { return 0; }
    return str_builder_build_a(a, sb);
}

# ======================================================================
# STREAMING PARSER (v5.7.41) — event-driven, no tree allocation
# ======================================================================
#
# For multi-MB JSON inputs that don't fit the tagged-tree memory model.
# Caller allocates a handler struct, fills in the callbacks they care
# about (others stay 0 = no-op), and the driver fires events as it walks.
#
# Handler layout (96 bytes):
#   +0   ctx              user pointer (1st arg to every callback)
#   +8   on_object_start  fnptr or 0  fncall1(ctx)
#   +16  on_object_end    fnptr or 0  fncall1(ctx)
#   +24  on_array_start   fnptr or 0  fncall1(ctx)
#   +32  on_array_end     fnptr or 0  fncall1(ctx)
#   +40  on_key           fnptr or 0  fncall2(ctx, key_str)
#   +48  on_string        fnptr or 0  fncall2(ctx, value_str)
#   +56  on_int           fnptr or 0  fncall2(ctx, value_i64)
#   +64  on_float         fnptr or 0  fncall2(ctx, value_f64_bits)
#   +72  on_bool          fnptr or 0  fncall2(ctx, value_0_or_1)
#   +80  on_null          fnptr or 0  fncall1(ctx)
#   +88  on_error         fnptr or 0  fncall3(ctx, msg_cstr, pos)
#
# Lex state is the same per-call parser state struct the tree parser uses (`ps`,
# threaded as the first argument), so the shared helpers _jp_skip_ws,
# _jp_parse_string, _jp_atoi, _jp_atof, _jp_set_err are reused as-is and the
# streaming parser is reentrant too. This keeps the streaming surface ~210 LOC
# instead of ~400.

var JS_EV_OBJECT_START = 0;
var JS_EV_OBJECT_END   = 1;
var JS_EV_ARRAY_START  = 2;
var JS_EV_ARRAY_END    = 3;
var JS_EV_KEY          = 4;
var JS_EV_STRING       = 5;
var JS_EV_INT          = 6;
var JS_EV_FLOAT        = 7;
var JS_EV_BOOL         = 8;
var JS_EV_NULL         = 9;
var JS_EV_ERROR        = 10;
var JS_EV_COUNT        = 11;

var _JS_HANDLER_SIZE = 96;

# Allocate a handler with all callback slots 0 (no-op). `ctx` is the
# user pointer threaded through every callback as its first argument.
fn bayan_json_stream_handler_new(ctx): i64 {
    var h = alloc(_JS_HANDLER_SIZE);
    var i = 0;
    while (i < _JS_HANDLER_SIZE) { store64(h + i, 0); i = i + 8; }
    store64(h, ctx);
    return h;
}

# Bind callback `fp` to event `event_id`. Returns 0 on success, -1 on
# bad event_id. Pass fp=0 to clear an event.
fn bayan_json_stream_on(h, event_id, fp): i64 {
    if (event_id < 0 || event_id >= JS_EV_COUNT) { return 0 - 1; }
    store64(h + 8 + event_id * 8, fp);
    return 0;
}

fn _js_ctx(h): i64 { return load64(h); }
fn _js_cb(h, event_id): i64 { return load64(h + 8 + event_id * 8); }

# Record the error into the per-call state + fire on_error if registered.
fn _js_emit_error(ps, h, msg): i64 {
    var pos = load64(ps + 16);
    _jp_set_err(ps, msg, pos);
    var fp = _js_cb(h, JS_EV_ERROR);
    if (fp != 0) { fncall3(fp, _js_ctx(h), msg, pos); }
    return 0;
}

# Relay a _jp_set_err-set error through to on_error (for paths that
# call _jp_parse_string and get a 0 back — ps's error slots are already
# populated, just need to forward).
fn _js_relay_err(ps, h): i64 {
    var fp = _js_cb(h, JS_EV_ERROR);
    if (fp != 0) { fncall3(fp, _js_ctx(h), load64(ps + 24), load64(ps + 32)); }
    return 0;
}

# Number parser — mirrors _jp_parse_number's lex but emits via
# callback instead of allocating json_v*. Returns 0 on success, -1 on
# error.
fn _js_parse_number(ps, h): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var pos = load64(ps + 16);
    var start = pos;
    var is_float = 0;
    if (pos < len && load8(buf + pos) == 45) { pos = pos + 1; }
    while (pos < len) {
        var c = load8(buf + pos);
        if (c >= 48 && c <= 57) { pos = pos + 1; }
        else { break; }
    }
    if (pos < len && load8(buf + pos) == 46) {
        is_float = 1;
        pos = pos + 1;
        while (pos < len) {
            var c2 = load8(buf + pos);
            if (c2 >= 48 && c2 <= 57) { pos = pos + 1; }
            else { break; }
        }
    }
    if (pos < len) {
        var ec = load8(buf + pos);
        if (ec == 101 || ec == 69) {
            is_float = 1;
            pos = pos + 1;
            if (pos < len) {
                var sg = load8(buf + pos);
                if (sg == 43 || sg == 45) { pos = pos + 1; }
            }
            while (pos < len) {
                var c3 = load8(buf + pos);
                if (c3 >= 48 && c3 <= 57) { pos = pos + 1; }
                else { break; }
            }
        }
    }
    if (pos == start) { store64(ps + 16, pos); _js_emit_error(ps, h, "expected number"); return 0 - 1; }
    store64(ps + 16, pos);
    if (is_float == 1) {
        var fbits = _jp_atof(buf + start, pos - start);
        var fp_f = _js_cb(h, JS_EV_FLOAT);
        if (fp_f != 0) { fncall2(fp_f, _js_ctx(h), fbits); }
    } else {
        var iv = _jp_atoi(buf + start, pos - start);
        var fp_i = _js_cb(h, JS_EV_INT);
        if (fp_i != 0) { fncall2(fp_i, _js_ctx(h), iv); }
    }
    return 0;
}

fn _js_parse_array(ps, h): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    if (load8(buf + load64(ps + 16)) != 91) { _js_emit_error(ps, h, "expected '['"); return 0 - 1; }
    store64(ps + 16, load64(ps + 16) + 1);
    var fp_s = _js_cb(h, JS_EV_ARRAY_START);
    if (fp_s != 0) { fncall1(fp_s, _js_ctx(h)); }
    _jp_skip_ws(ps);
    if (load64(ps + 16) < len && load8(buf + load64(ps + 16)) == 93) {
        store64(ps + 16, load64(ps + 16) + 1);
        var fp_e = _js_cb(h, JS_EV_ARRAY_END);
        if (fp_e != 0) { fncall1(fp_e, _js_ctx(h)); }
        return 0;
    }
    while (1 == 1) {
        if (_js_parse_value(ps, h) != 0) { return 0 - 1; }
        _jp_skip_ws(ps);
        if (load64(ps + 16) >= len) { _js_emit_error(ps, h, "unterminated array"); return 0 - 1; }
        var c = load8(buf + load64(ps + 16));
        if (c == 44) { store64(ps + 16, load64(ps + 16) + 1); _jp_skip_ws(ps); }
        elif (c == 93) {
            store64(ps + 16, load64(ps + 16) + 1);
            var fp_e2 = _js_cb(h, JS_EV_ARRAY_END);
            if (fp_e2 != 0) { fncall1(fp_e2, _js_ctx(h)); }
            return 0;
        } else { _js_emit_error(ps, h, "expected ',' or ']'"); return 0 - 1; }
    }
    return 0;
}

fn _js_parse_object(ps, h): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    if (load8(buf + load64(ps + 16)) != 123) { _js_emit_error(ps, h, "expected '{'"); return 0 - 1; }
    store64(ps + 16, load64(ps + 16) + 1);
    var fp_s = _js_cb(h, JS_EV_OBJECT_START);
    if (fp_s != 0) { fncall1(fp_s, _js_ctx(h)); }
    _jp_skip_ws(ps);
    if (load64(ps + 16) < len && load8(buf + load64(ps + 16)) == 125) {
        store64(ps + 16, load64(ps + 16) + 1);
        var fp_e = _js_cb(h, JS_EV_OBJECT_END);
        if (fp_e != 0) { fncall1(fp_e, _js_ctx(h)); }
        return 0;
    }
    while (1 == 1) {
        _jp_skip_ws(ps);
        var k = _jp_parse_string(ps);
        if (k == 0) { _js_relay_err(ps, h); return 0 - 1; }
        var fp_k = _js_cb(h, JS_EV_KEY);
        if (fp_k != 0) { fncall2(fp_k, _js_ctx(h), k); }
        _jp_skip_ws(ps);
        if (load64(ps + 16) >= len) { _js_emit_error(ps, h, "unterminated object"); return 0 - 1; }
        if (load8(buf + load64(ps + 16)) != 58) { _js_emit_error(ps, h, "expected ':' after key"); return 0 - 1; }
        store64(ps + 16, load64(ps + 16) + 1);
        if (_js_parse_value(ps, h) != 0) { return 0 - 1; }
        _jp_skip_ws(ps);
        if (load64(ps + 16) >= len) { _js_emit_error(ps, h, "unterminated object"); return 0 - 1; }
        var c = load8(buf + load64(ps + 16));
        if (c == 44) { store64(ps + 16, load64(ps + 16) + 1); }
        elif (c == 125) {
            store64(ps + 16, load64(ps + 16) + 1);
            var fp_e2 = _js_cb(h, JS_EV_OBJECT_END);
            if (fp_e2 != 0) { fncall1(fp_e2, _js_ctx(h)); }
            return 0;
        } else { _js_emit_error(ps, h, "expected ',' or '}'"); return 0 - 1; }
    }
    return 0;
}

fn _js_parse_value(ps, h): i64 {
    _jp_skip_ws(ps);
    var buf = load64(ps);
    var len = load64(ps + 8);
    var pos = load64(ps + 16);
    if (pos >= len) { _js_emit_error(ps, h, "unexpected EOF"); return 0 - 1; }
    var c = load8(buf + pos);
    if (c == 123 || c == 91) {
        # Same depth bound as _jp_parse_value — the streaming descent recurses
        # through _js_parse_array/_js_parse_object identically.
        var depth = load64(ps + 40);
        if (depth >= _JP_MAX_DEPTH) { _js_emit_error(ps, h, "nesting too deep"); return 0 - 1; }
        store64(ps + 40, depth + 1);
        var rc = 0;
        if (c == 123) { rc = _js_parse_object(ps, h); }
        else          { rc = _js_parse_array(ps, h); }
        store64(ps + 40, depth);
        return rc;
    }
    if (c == 34)  {
        var s = _jp_parse_string(ps);
        if (s == 0) { _js_relay_err(ps, h); return 0 - 1; }
        var fp_s = _js_cb(h, JS_EV_STRING);
        if (fp_s != 0) { fncall2(fp_s, _js_ctx(h), s); }
        return 0;
    }
    if (c == 116) {
        if (pos + 3 < len && memeq(buf + pos + 1, "rue", 3) == 1) {
            store64(ps + 16, pos + 4);
            var fp_b = _js_cb(h, JS_EV_BOOL);
            if (fp_b != 0) { fncall2(fp_b, _js_ctx(h), 1); }
            return 0;
        }
        _js_emit_error(ps, h, "expected 'true'");
        return 0 - 1;
    }
    if (c == 102) {
        if (pos + 4 < len && memeq(buf + pos + 1, "alse", 4) == 1) {
            store64(ps + 16, pos + 5);
            var fp_b = _js_cb(h, JS_EV_BOOL);
            if (fp_b != 0) { fncall2(fp_b, _js_ctx(h), 0); }
            return 0;
        }
        _js_emit_error(ps, h, "expected 'false'");
        return 0 - 1;
    }
    if (c == 110) {
        if (pos + 3 < len && memeq(buf + pos + 1, "ull", 3) == 1) {
            store64(ps + 16, pos + 4);
            var fp_n = _js_cb(h, JS_EV_NULL);
            if (fp_n != 0) { fncall1(fp_n, _js_ctx(h)); }
            return 0;
        }
        _js_emit_error(ps, h, "expected 'null'");
        return 0 - 1;
    }
    if (c == 45 || (c >= 48 && c <= 57)) {
        return _js_parse_number(ps, h);
    }
    _js_emit_error(ps, h, "unexpected character");
    return 0 - 1;
}

# Public stream-parse entry — explicit cstr+len+handler. Returns 0 on
# success, -1 on error. After error, callers can read bayan_json_last_error()
# and bayan_json_last_error_pos(); the JS_EV_ERROR callback (if registered)
# already fired.
fn bayan_json_stream_parse(buf, len, h): i64 {
    var ps[48];
    _jp_state_init(&ps, buf, len);
    var rc = 0;
    if (_js_parse_value(&ps, h) != 0) {
        rc = 0 - 1;
    } else {
        _jp_skip_ws(&ps);
        if (load64(&ps + 16) != len) {
            _js_emit_error(&ps, h, "trailing content after JSON value");
            rc = 0 - 1;
        }
    }
    # Mirror the per-call error into the legacy last-error slots for back-compat
    # (0/0 on success). Concurrent stream parsers should read the JS_EV_ERROR
    # callback rather than bayan_json_last_error().
    _json_err_msg = load64(&ps + 24);
    _json_err_pos = load64(&ps + 32);
    return rc;
}

# Convenience: stream-parse from a Str.
fn bayan_json_stream_parse_str(src, h): i64 {
    if (src == 0) { _json_err_msg = "null source"; _json_err_pos = 0; return 0 - 1; }
    return bayan_json_stream_parse(str_data(src), str_len(src), h);
}

# ======================================================================
# JSON POINTER (v5.7.42, RFC 6901)
# ======================================================================
#
# Walk the tagged tree by slash-separated path. Returns the referenced
# json_v* or 0 (not found / invalid pointer / can't descend into scalar).
#
# Empty pointer ""           → whole document
# "/foo"                     → root["foo"]
# "/foo/0/bar"               → root["foo"][0]["bar"]
# "/" (just slash)           → root[""] (empty-string key)
# "/a/"                      → a[""] (trailing-slash empty token)
#
# Tokens are unescaped per RFC 6901 §3: "~1" → "/", "~0" → "~". The
# left-to-right single-pass unescape below is equivalent to the spec's
# two-pass "~1 then ~0" order — only "~0" and "~1" are valid escapes,
# so any other "~X" is an error and returns 0.
#
# Array tokens must match `0|[1-9][0-9]*` per RFC 6901 §4. The "-"
# (next-element) token is append-only and has no read meaning, so
# it returns 0.

# Look up (buf, len) as a key in OBJ value `v`. Length-explicit so
# tokens with interior NUL bytes (theoretical via `\u0000`) still match.
fn _jp_obj_lookup(v, buf, len): i64 {
    if (load64(v) != JTAG_OBJ) { return 0; }
    var pairs = load64(v + 8);
    var n = vec_len(pairs);
    var i = 0;
    while (i < n) {
        var p = vec_get(pairs, i);
        var ks = load64(p);
        if (str_len(ks) == len) {
            if (memeq(str_data(ks), buf, len) == 1) {
                return load64(p + 8);
            }
        }
        i = i + 1;
    }
    return 0;
}

# Parse (buf, len) as a strict array index per RFC 6901 §4. Returns
# index >= 0, or -1 on invalid (leading zero, non-digit, empty,
# the "-" next-element token, etc.).
fn _jp_parse_idx(buf, len): i64 {
    if (len == 0) { return 0 - 1; }
    var c0 = load8(buf);
    if (c0 == 48) { if (len == 1) { return 0; } return 0 - 1; }
    if (c0 < 49 || c0 > 57) { return 0 - 1; }
    var n = c0 - 48;
    var i = 1;
    while (i < len) {
        var c = load8(buf + i);
        if (c < 48 || c > 57) { return 0 - 1; }
        # OVERFLOW (fixed in 1.5.1). `n = n * 10 + d` wrapped mod 2^64, so a
        # pointer token of enough digits landed back INSIDE the array: against
        # a 3-element array, "/1" followed by 64 zeros selected element 0 and
        # "/18446744073709551618" selected element 2. An out-of-range pointer
        # must resolve to nothing, not to a neighbouring element chosen by
        # arithmetic wraparound. No array can hold 10^18 elements, so anything
        # past that is out of range by construction.
        if (n > 999999999999999999) { return 0 - 1; }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    return n;
}

# Unescape one reference token from (src, src_len) into a freshly
# allocated buffer. Layout: u64 length prefix at offset 0, decoded
# bytes from offset 8, NUL byte at offset 8+len. Returns the alloc
# pointer, or 0 on bad escape (lone "~" or "~X" where X != 0/1).
fn _jp_token_unescape(src, src_len): i64 {
    var out = alloc(src_len + 8 + 1);
    var oi = 0;
    var i = 0;
    while (i < src_len) {
        var c = load8(src + i);
        if (c == 126) {
            i = i + 1;
            if (i >= src_len) { return 0; }
            var e = load8(src + i);
            if      (e == 48) { store8(out + 8 + oi, 126); oi = oi + 1; }
            elif    (e == 49) { store8(out + 8 + oi,  47); oi = oi + 1; }
            else { return 0; }
            i = i + 1;
        } else {
            store8(out + 8 + oi, c);
            oi = oi + 1;
            i = i + 1;
        }
    }
    store8(out + 8 + oi, 0);
    store64(out, oi);
    return out;
}

# Public entry — explicit buf+len pointer string.
fn bayan_json_v_pointer_cstr(v, ptr, plen): i64 {
    if (v == 0) { return 0; }
    if (plen == 0) { return v; }
    if (load8(ptr) != 47) { return 0; }   # must start with '/'
    var pos = 1;
    var cur = v;
    while (pos <= plen) {
        var start = pos;
        while (pos < plen) {
            if (load8(ptr + pos) == 47) { break; }
            pos = pos + 1;
        }
        var tok_len = pos - start;
        var ub = _jp_token_unescape(ptr + start, tok_len);
        if (ub == 0) { return 0; }
        var ulen = load64(ub);
        var ubuf = ub + 8;
        if (cur == 0) { return 0; }
        var t = load64(cur);
        if (t == JTAG_OBJ) {
            cur = _jp_obj_lookup(cur, ubuf, ulen);
        } elif (t == JTAG_ARR) {
            var idx = _jp_parse_idx(ubuf, ulen);
            if (idx < 0) { return 0; }
            cur = bayan_json_v_arr_get(cur, idx);
        } else {
            return 0;
        }
        if (cur == 0) { return 0; }
        if (pos == plen) { return cur; }
        pos = pos + 1;
    }
    return cur;
}

# Convenience: pointer as a Str.
fn bayan_json_v_pointer(v, ptr): i64 {
    if (ptr == 0) { return v; }
    return bayan_json_v_pointer_cstr(v, str_data(ptr), str_len(ptr));
}

# --- yaml.cyr ---

# bayan — YAML subset parser -> the shared tagged value tree.
#
# Parses a pragmatic YAML subset into the SAME `JTAG_*`-tagged 24-byte
# `bayan_json_v_*` value cells the JSON value parser produces, so one
# consumer traverses one node shape regardless of input format (the
# serde-data-model property the Rust originals have). Filed by agnosai
# (definition files) and driven equally by mneme (Markdown frontmatter):
# docs/development/issues/2026-07-16-agnosai-yaml-parse-into-tagged-value-tree.md
#
# In the subset:
#   - block mappings (`key: value`), nested by indentation (spaces only);
#     plain or quoted keys
#   - block sequences (`- item`), incl. compact `- key: value` items and
#     sequences at the same indent as their parent mapping key
#   - flow sequences `[a, b, c]` (single-line, on the key line, nestable,
#     trailing comma ok)
#   - scalars: null / ~ / true / false, STRICT-JSON-grammar numbers
#     (INT/FLOAT; leading-zero `01` or digitless-exponent `1e` tokens fall
#     back to plain strings), single- or double-quoted strings (one quote
#     layer stripped, body VERBATIM — no \-escape decoding, matching the
#     toml module's convention), plain strings
#   - `#` comments (full-line or trailing, quote-aware) and blank lines.
#     A quote char opens a quoted region only at a token boundary (content
#     start, or after space / tab / `[` / `,`) — mid-word quotes (O'Brien,
#     5" nail) are literal text, in comment stripping and key splitting both
#   - one leading `---` document-start and one `...` document-end marker
#     (each on its own line)
#   - a single-line top-level scalar or flow-sequence document; an empty
#     document is JTAG_NULL; a leading UTF-8 BOM is skipped
#
# REJECTED LOUDLY (parse error, never a silent mis-parse):
#   - anchors/aliases (`&a` / `*a`), tags (`!` / `!!type`) — in value AND
#     key position
#   - block scalars (`|` / `>`); plain values led by `- ` or `? ` indicators
#   - flow mappings (`{k: v}`) and implicit flow-mapping entries (`[a: b]`)
#   - a second `---` (multi-document streams), content ON a `---`/`...`
#     marker line, content (or a second `...`) after `...`
#   - a flow sequence on its own line below the key (must follow the key)
#   - empty flow-sequence elements (`[,]` / `[a,,b]`; trailing comma is ok)
#   - tabs in indentation; unterminated flow sequences; unterminated or
#     malformed quoted scalars (content past the close quote)
#
# Out of subset entirely (not detected): lone-CR (classic Mac) line endings.
#
# Reentrancy + bounds: keys off the json module's per-call parser state
# (`_JP_STATE_SIZE` = 48 bytes — the same struct, so a caller reserves via
# bayan_json_parse_state_size()) and shares its recursion cap
# (`_JP_MAX_DEPTH` = 128, "nesting too deep") — both lessons applied from
# day one (thoth cursor issue 2026-06-23, agnosai depth-cap issue
# 2026-07-16). err_pos is a byte offset into the source buffer.
#
# Strings share the source buffer (no copy) like the toml parser — the
# source must outlive the returned tree. Node allocation flows through
# default_alloc(), matching the JSON value parser.
#
# NOTE (single-pass bundle order): this module references json.cyr internals
# (_jp_state_init / _jp_set_err / _jp_parse_number / constructors), so it
# must appear AFTER src/json.cyr in `[lib].modules` and in include lists.

# === Legacy last-error slots (mirror of the json module's convention) ===

var _yaml_err_msg = 0;
var _yaml_err_pos = 0;

# Return the last yaml parse error message (cstr) — set on bayan_yaml_parse*
# failure via the globals-compat entries. Concurrent callers use the ctx path
# and bayan_yaml_state_error() instead.
fn bayan_yaml_last_error(): i64 {
    if (_yaml_err_msg == 0) { return ""; }
    return _yaml_err_msg;
}

# Return the last yaml parse error byte offset.
fn bayan_yaml_last_error_pos(): i64 { return _yaml_err_pos; }

# Read the parse error from a caller-owned parser state (race-free). Thin
# forwarders over the shared state accessors.
fn bayan_yaml_state_error(ps): i64 { return bayan_json_state_error(ps); }

# Byte offset companion of bayan_yaml_state_error.
fn bayan_yaml_state_error_pos(ps): i64 { return bayan_json_state_error_pos(ps); }

# === Small helpers ===

# True if the token (ptr,len) equals the C string `s`.
fn _yp_tok_is(ptr, len, s): i64 {
    if (strlen(s) != len) { return 0; }
    return memeq(ptr, s, len);
}

# Trim ASCII space/tab from both ends of (ptr,len); returns new ptr via
# out-of-band: packs nothing — instead callers use _yp_trim_start/_yp_trim_len
# on their own. Kept as two passes to stay expression-free.
fn _yp_trim_start(ptr, len): i64 {
    var i = 0;
    while (i < len) {
        var c = load8(ptr + i);
        if (c == 32 || c == 9) { i = i + 1; }
        else { return i; }
    }
    return i;
}

# Length of (ptr,len) after trimming trailing space/tab.
fn _yp_trim_end(ptr, len): i64 {
    var n = len;
    while (n > 0) {
        var c = load8(ptr + n - 1);
        if (c == 32 || c == 9) { n = n - 1; }
        else { return n; }
    }
    return n;
}

# True if a quote char at index j of the content starting at `start` sits at
# a token boundary — content start, or after space / tab / `[` / `,`. Only
# there does it OPEN a quoted region; mid-word quotes (O'Brien, 5" nail) are
# literal text. Shared by the comment stripper and the key splitter so both
# agree on what is quoted.
fn _yp_quote_opens_at(ptr, start, j): i64 {
    if (j == start) { return 1; }
    var pc = load8(ptr + j - 1);
    if (pc == 32 || pc == 9 || pc == 91 || pc == 44) { return 1; }
    return 0;
}

# === Line records ===
#
# The scanner turns the input into a vec of 32-byte line records:
#   +0   off     i64   byte offset of the line's content start (for err_pos)
#   +8   ptr     cstr  first content byte (past indentation)
#   +16  len     i64   content length (comment-stripped, end-trimmed)
#   +24  indent  i64   leading-space count (the line's column)
# Blank lines, comment-only lines, and document markers never produce records.

# Scan (buf,len) into line records. Returns the vec, or 0 with the error set
# in ps (tab indentation, multi-document, content after `...`).
fn _yp_scan_lines(ps, buf, len): i64 {
    var lines = vec_new();
    var pos = 0;
    # skip a leading UTF-8 BOM so it can't be absorbed into the first key
    if (len >= 3 && load8(buf) == 239 && load8(buf + 1) == 187 && load8(buf + 2) == 191) {
        pos = 3;
    }
    var saw_doc_start = 0;
    var saw_content = 0;
    var ended = 0;
    while (pos < len) {
        # -- line extent [pos, eol), next line at nxt --
        var eol = pos;
        while (eol < len && load8(buf + eol) != 10) { eol = eol + 1; }
        var nxt = eol + 1;
        if (eol > pos && load8(buf + eol - 1) == 13) { eol = eol - 1; }   # strip \r
        # -- indentation: spaces only --
        var i = pos;
        while (i < eol && load8(buf + i) == 32) { i = i + 1; }
        if (i < eol && load8(buf + i) == 9) {
            _jp_set_err(ps, "tab in yaml indentation", i);
            return 0;
        }
        var indent = i - pos;
        # -- quote-aware comment strip: a `#` at content start, or preceded
        #    by space/tab, outside quotes, cuts the line --
        var q = 0;
        var cend = eol;
        var j = i;
        while (j < eol) {
            var c = load8(buf + j);
            if (q == 0) {
                if (c == 35) {
                    var at_start = 0;
                    if (j == i) { at_start = 1; }
                    else {
                        var pc = load8(buf + j - 1);
                        if (pc == 32 || pc == 9) { at_start = 1; }
                    }
                    if (at_start == 1) { cend = j; j = eol; }
                }
                if (j < eol) {
                    var c1 = load8(buf + j);
                    if (c1 == 34 || c1 == 39) {
                        if (_yp_quote_opens_at(buf, i, j) == 1) { q = c1; }
                    }
                }
            }
            else {
                if (c == q) { q = 0; }
            }
            j = j + 1;
        }
        var clen = _yp_trim_end(buf + i, cend - i);
        if (clen > 0) {
            # -- document markers (a marker line must carry NOTHING else:
            #    "--- foo" would otherwise be silently folded into the tree) --
            var handled = 0;
            if (clen >= 4) {
                var m3 = load8(buf + i + 3);
                if (m3 == 32 || m3 == 9) {
                    if (_yp_tok_is(buf + i, 3, "---") == 1) {
                        _jp_set_err(ps, "content on '---' marker line not supported", i);
                        return 0;
                    }
                    if (_yp_tok_is(buf + i, 3, "...") == 1) {
                        _jp_set_err(ps, "content on '...' marker line not supported", i);
                        return 0;
                    }
                }
            }
            if (_yp_tok_is(buf + i, clen, "---") == 1) {
                if (saw_content == 0 && saw_doc_start == 0) { saw_doc_start = 1; handled = 1; }
                else {
                    _jp_set_err(ps, "multi-document yaml not supported", i);
                    return 0;
                }
            }
            if (handled == 0) {
                if (_yp_tok_is(buf + i, clen, "...") == 1) {
                    if (ended == 1) {
                        _jp_set_err(ps, "content after '...' document end", i);
                        return 0;
                    }
                    ended = 1;
                    handled = 1;
                }
            }
            if (handled == 0) {
                if (ended == 1) {
                    _jp_set_err(ps, "content after '...' document end", i);
                    return 0;
                }
                saw_content = 1;
                var rec = alloc(32);
                store64(rec,      i);
                store64(rec + 8,  buf + i);
                store64(rec + 16, clen);
                store64(rec + 24, indent);
                vec_push(lines, rec);
            }
        }
        pos = nxt;
    }
    return lines;
}

# === Scalar typing ===

# True if (ptr,len) is EXACTLY a strict-JSON-grammar number:
#   -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?
# The shared _jp_parse_number scanner is laxer (digitless exponents, leading
# zeros), so this gate keeps the module's "JSON-syntax numbers" contract:
# "01", "1.", "1e", "1e+" all fall back to plain strings.
fn _yp_is_json_number(ptr, len): i64 {
    var i = 0;
    if (i < len && load8(ptr + i) == 45) { i = i + 1; }        # -
    if (i >= len) { return 0; }
    var c = load8(ptr + i);
    if (c == 48) { i = i + 1; }                                # 0
    else {
        if (c < 49 || c > 57) { return 0; }                    # [1-9]
        while (i < len) {
            var d = load8(ptr + i);
            if (d >= 48 && d <= 57) { i = i + 1; }
            else { break; }
        }
    }
    if (i < len && load8(ptr + i) == 46) {                     # .[0-9]+
        i = i + 1;
        if (i >= len) { return 0; }
        var f = load8(ptr + i);
        if (f < 48 || f > 57) { return 0; }
        while (i < len) {
            var d2 = load8(ptr + i);
            if (d2 >= 48 && d2 <= 57) { i = i + 1; }
            else { break; }
        }
    }
    if (i < len) {                                             # [eE][+-]?[0-9]+
        var e = load8(ptr + i);
        if (e == 101 || e == 69) {
            i = i + 1;
            if (i < len) {
                var sg = load8(ptr + i);
                if (sg == 43 || sg == 45) { i = i + 1; }
            }
            if (i >= len) { return 0; }
            var x = load8(ptr + i);
            if (x < 48 || x > 57) { return 0; }
            while (i < len) {
                var d3 = load8(ptr + i);
                if (d3 >= 48 && d3 <= 57) { i = i + 1; }
                else { break; }
            }
        }
    }
    if (i == len) { return 1; }
    return 0;
}

# Try (ptr,len) as a number. Returns an INT/FLOAT node, or 0 if the token is
# not entirely a strict-JSON number (caller falls through to string). The
# actual conversion reuses the json module's scanner so YAML and JSON type
# accepted numbers identically.
fn _yp_try_number(ptr, len): i64 {
    if (_yp_is_json_number(ptr, len) == 0) { return 0; }
    var nps[48];
    _jp_state_init(&nps, ptr, len);
    var v = _jp_parse_number(&nps);
    if (v == 0) { return 0; }
    if (load64(&nps + 16) != len) { return 0; }   # cannot happen post-gate; belt+braces
    return v;
}

# Reject out-of-subset value forms by leading byte: anchors/aliases, tags,
# block scalars, flow mappings. Returns -1 with the error set, else 0.
fn _yp_reject_check(ps, ptr, len, off): i64 {
    if (len == 0) { return 0; }
    var c = load8(ptr);
    if (c == 38 || c == 42) {   # & *
        _jp_set_err(ps, "yaml anchors/aliases not supported", off);
        return 0 - 1;
    }
    if (c == 33) {              # !
        _jp_set_err(ps, "yaml tags not supported", off);
        return 0 - 1;
    }
    if (c == 124 || c == 62) {  # | >
        _jp_set_err(ps, "yaml block scalars not supported", off);
        return 0 - 1;
    }
    if (c == 123) {             # {
        _jp_set_err(ps, "yaml flow mappings not supported", off);
        return 0 - 1;
    }
    if (c == 45 && len >= 2) {  # `- ` — a sequence indicator is not a scalar
        var n1 = load8(ptr + 1);
        if (n1 == 32 || n1 == 9) {
            _jp_set_err(ps, "unexpected '-' sequence indicator in scalar", off);
            return 0 - 1;
        }
    }
    if (c == 63) {              # `?` / `? ` — complex mapping keys
        var is_ck = 0;
        if (len == 1) { is_ck = 1; }
        else {
            var n2 = load8(ptr + 1);
            if (n2 == 32 || n2 == 9) { is_ck = 1; }
        }
        if (is_ck == 1) {
            _jp_set_err(ps, "yaml complex keys ('?') not supported", off);
            return 0 - 1;
        }
    }
    return 0;
}

# Type a PLAIN (unquoted, non-flow) scalar token: null/~/true/false, number,
# else a string sharing the source buffer. (ptr,len) is already trimmed.
fn _yp_plain_scalar(ptr, len): i64 {
    if (len == 0)                          { return bayan_json_v_null(); }
    if (_yp_tok_is(ptr, len, "null") == 1) { return bayan_json_v_null(); }
    if (_yp_tok_is(ptr, len, "~") == 1)    { return bayan_json_v_null(); }
    if (_yp_tok_is(ptr, len, "true") == 1) { return bayan_json_v_bool_new(1); }
    if (_yp_tok_is(ptr, len, "false") == 1){ return bayan_json_v_bool_new(0); }
    var num = _yp_try_number(ptr, len);
    if (num != 0) { return num; }
    return bayan_json_v_str_new(str_new(ptr, len));
}

# Parse a quoted scalar: (ptr,len) starts with `"` or `'`. Single-line; the
# last byte must be the matching close quote. Body captured VERBATIM (one
# layer stripped, no escape decoding — the toml convention).
fn _yp_quoted(ps, ptr, len, off): i64 {
    var q = load8(ptr);
    if (len < 2) {
        _jp_set_err(ps, "unterminated quoted scalar", off);
        return 0;
    }
    # the FIRST close quote must also be the last byte — `"a" "b"` and
    # `"a"b"` are malformed, not silently glued strings
    var k = 1;
    while (k < len && load8(ptr + k) != q) { k = k + 1; }
    if (k >= len) {
        _jp_set_err(ps, "unterminated quoted scalar", off);
        return 0;
    }
    if (k != len - 1) {
        _jp_set_err(ps, "malformed quoted scalar", off);
        return 0;
    }
    return bayan_json_v_str_new(str_new(ptr + 1, len - 2));
}

# === Flow sequences ===

# Parse a flow sequence from (ptr,len) starting at *cur (which must index a
# `[`). Advances *cur past the closing `]`. Depth-capped via ps. Elements:
# nested flow sequences, quoted scalars, plain scalars (up to `,` / `]`).
fn _yp_parse_flow_seq(ps, ptr, len, cur, off): i64 {
    var depth = load64(ps + 40);
    if (depth >= _JP_MAX_DEPTH) {
        _jp_set_err(ps, "nesting too deep", off + load64(cur));
        return 0;
    }
    store64(ps + 40, depth + 1);
    var arr = bayan_json_v_arr_new();
    var ix = load64(cur) + 1;   # past '['
    while (1 == 1) {
        while (ix < len) {      # skip inter-element whitespace
            var c = load8(ptr + ix);
            if (c == 32 || c == 9) { ix = ix + 1; }
            else { break; }
        }
        if (ix >= len) {
            _jp_set_err(ps, "unterminated flow sequence", off + ix);
            return 0;
        }
        var c = load8(ptr + ix);
        if (c == 93) {          # ]
            store64(cur, ix + 1);
            store64(ps + 40, load64(ps + 40) - 1);
            return arr;
        }
        # -- element --
        var item = 0;
        if (c == 91) {          # [ nested
            store64(cur, ix);
            item = _yp_parse_flow_seq(ps, ptr, len, cur, off);
            if (item == 0) { return 0; }
            ix = load64(cur);
        }
        else {
            if (c == 34 || c == 39) {   # quoted element
                var close = ix + 1;
                while (close < len && load8(ptr + close) != c) { close = close + 1; }
                if (close >= len) {
                    _jp_set_err(ps, "unterminated quoted scalar", off + ix);
                    return 0;
                }
                item = bayan_json_v_str_new(str_new(ptr + ix + 1, close - ix - 1));
                ix = close + 1;
            }
            else {
                if (_yp_reject_check(ps, ptr + ix, len - ix, off + ix) != 0) { return 0; }
                var e = ix;     # plain element: up to , or ]
                while (e < len) {
                    var ec = load8(ptr + e);
                    if (ec == 44 || ec == 93) { break; }
                    e = e + 1;
                }
                var tlen = _yp_trim_end(ptr + ix, e - ix);
                if (tlen == 0) {    # `[,]` / `[a,,b]` — no phantom nulls
                    _jp_set_err(ps, "empty flow-sequence element", off + ix);
                    return 0;
                }
                # `[a: b]` is an implicit flow-mapping entry, not a string
                if (_yp_find_colon(ptr + ix, tlen) >= 0) {
                    _jp_set_err(ps, "yaml flow mappings not supported", off + ix);
                    return 0;
                }
                item = _yp_plain_scalar(ptr + ix, tlen);
                ix = e;
            }
        }
        bayan_json_v_arr_push(arr, item);
        while (ix < len) {      # skip ws to separator/close
            var sc = load8(ptr + ix);
            if (sc == 32 || sc == 9) { ix = ix + 1; }
            else { break; }
        }
        if (ix >= len) {
            _jp_set_err(ps, "unterminated flow sequence", off + ix);
            return 0;
        }
        var sep = load8(ptr + ix);
        if (sep == 44) { ix = ix + 1; }     # , (trailing comma ok — loop re-checks ])
        else {
            if (sep != 93) {
                _jp_set_err(ps, "expected ',' or ']' in flow sequence", off + ix);
                return 0;
            }
        }
    }
    return 0;
}

# === Line-value dispatch ===

# Parse a whole-line value token (ptr,len) at source offset `off`: flow
# sequence, quoted scalar, or (reject-checked) plain scalar.
fn _yp_line_value(ps, ptr, len, off): i64 {
    if (len == 0) { return bayan_json_v_null(); }
    var c = load8(ptr);
    if (c == 91) {              # [ flow sequence — must consume the token
        var cx[8];
        store64(&cx, 0);
        var v = _yp_parse_flow_seq(ps, ptr, len, &cx, off);
        if (v == 0) { return 0; }
        var ix = load64(&cx);
        while (ix < len) {
            var tc = load8(ptr + ix);
            if (tc == 32 || tc == 9) { ix = ix + 1; }
            else { break; }
        }
        if (ix != len) {
            _jp_set_err(ps, "content after flow sequence", off + ix);
            return 0;
        }
        return v;
    }
    if (c == 34 || c == 39) { return _yp_quoted(ps, ptr, len, off); }
    if (_yp_reject_check(ps, ptr, len, off) != 0) { return 0; }
    return _yp_plain_scalar(ptr, len);
}

# === Block structure ===

# Find the mapping colon in (ptr,len): a `:` outside quotes whose successor
# is space/tab or end-of-line. Returns its index or -1. (A plain `url:
# http://x` value is safe — the FIRST qualifying colon ends the key.)
fn _yp_find_colon(ptr, len): i64 {
    var q = 0;
    var i = 0;
    while (i < len) {
        var c = load8(ptr + i);
        if (q == 0) {
            var opens = 0;
            if (c == 34 || c == 39) { opens = _yp_quote_opens_at(ptr, 0, i); }
            if (opens == 1) { q = c; }
            else {
                if (c == 58) {
                    if (i + 1 >= len) { return i; }
                    var nc = load8(ptr + i + 1);
                    if (nc == 32 || nc == 9) { return i; }
                }
            }
        }
        else {
            if (c == q) { q = 0; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# True if line content (ptr,len) is a block-sequence entry: `-` alone or `- x`.
fn _yp_is_seq_line(ptr, len): i64 {
    if (len == 0) { return 0; }
    if (load8(ptr) != 45) { return 0; }
    if (len == 1) { return 1; }
    var c = load8(ptr + 1);
    if (c == 32 || c == 9) { return 1; }
    return 0;
}

# yc — parse context over the scanned lines (stack struct, 24 bytes):
#   +0 lines vec   +8 idx   +16 nlines
fn _yc_cur(yc): i64 {
    var idx = load64(yc + 8);
    if (idx >= load64(yc + 16)) { return 0; }
    return vec_get(load64(yc), idx);
}

# Advance the line cursor.
fn _yc_advance(yc): i64 {
    store64(yc + 8, load64(yc + 8) + 1);
    return 0;
}

# Parse the block starting at the current line, which must sit at exactly
# `indent`. Dispatches sequence vs mapping; depth-capped via ps (+40).
fn _yp_parse_block(ps, yc, indent): i64 {
    var depth = load64(ps + 40);
    var rec = _yc_cur(yc);
    if (rec == 0) { return bayan_json_v_null(); }
    if (depth >= _JP_MAX_DEPTH) {
        _jp_set_err(ps, "nesting too deep", load64(rec));
        return 0;
    }
    store64(ps + 40, depth + 1);
    var v = 0;
    if (_yp_is_seq_line(load64(rec + 8), load64(rec + 16)) == 1) {
        v = _yp_parse_sequence(ps, yc, indent);
    }
    else {
        v = _yp_parse_mapping(ps, yc, indent);
    }
    store64(ps + 40, load64(ps + 40) - 1);
    return v;
}

# Parse consecutive mapping entries at exactly `indent` into a JTAG_OBJ.
# A dedented line ends the mapping (parent's problem); a deeper line is an
# error; a `- ` entry at this indent inside a mapping is an error.
fn _yp_parse_mapping(ps, yc, indent): i64 {
    var obj = bayan_json_v_obj_new();
    while (1 == 1) {
        var rec = _yc_cur(yc);
        if (rec == 0) { return obj; }
        var ri = load64(rec + 24);
        if (ri < indent) { return obj; }
        var roff = load64(rec);
        var rptr = load64(rec + 8);
        var rlen = load64(rec + 16);
        if (ri > indent) {
            _jp_set_err(ps, "unexpected indentation", roff);
            return 0;
        }
        if (_yp_is_seq_line(rptr, rlen) == 1) {
            _jp_set_err(ps, "unexpected sequence entry in mapping", roff);
            return 0;
        }
        if (load8(rptr) == 91) {    # a bare `[...]` line can't open a mapping
            _jp_set_err(ps, "flow sequence must follow its key on the same line", roff);
            return 0;
        }
        var ci = _yp_find_colon(rptr, rlen);
        if (ci < 0) {
            _jp_set_err(ps, "expected ':' in mapping entry", roff);
            return 0;
        }
        # -- key: trimmed; one quote layer stripped if fully quoted --
        var klen = _yp_trim_end(rptr, ci);
        var kptr = rptr;
        if (klen == 0) {
            _jp_set_err(ps, "empty mapping key", roff);
            return 0;
        }
        var kq = load8(kptr);
        if (kq == 34 || kq == 39) {
            if (klen >= 2 && load8(kptr + klen - 1) == kq) {
                kptr = kptr + 1;
                klen = klen - 2;
            }
        }
        else {
            # anchors/tags/indicators are as out-of-subset in KEY position
            # as in value position — reject, don't stringify
            if (_yp_reject_check(ps, kptr, klen, roff) != 0) { return 0; }
        }
        # -- rest of line after the colon --
        var vstart = ci + 1;
        var voff = _yp_trim_start(rptr + vstart, rlen - vstart);
        var vptr = rptr + vstart + voff;
        var vlen = _yp_trim_end(vptr, rlen - vstart - voff);
        _yc_advance(yc);
        var val = 0;
        if (vlen > 0) {
            val = _yp_line_value(ps, vptr, vlen, roff + (vptr - rptr));
        }
        else {
            # `key:` with nothing after — nested block (deeper, or a sequence
            # at the same indent), else null
            var nrec = _yc_cur(yc);
            if (nrec == 0) { val = bayan_json_v_null(); }
            else {
                var nin = load64(nrec + 24);
                if (nin > indent) { val = _yp_parse_block(ps, yc, nin); }
                else {
                    if (nin == indent && _yp_is_seq_line(load64(nrec + 8), load64(nrec + 16)) == 1) {
                        val = _yp_parse_block(ps, yc, indent);
                    }
                    else { val = bayan_json_v_null(); }
                }
            }
        }
        if (val == 0) { return 0; }
        # DUPLICATE KEYS are rejected (1.5.1). YAML 1.2 makes them an error,
        # and accepting them here produced a genuine divergence rather than a
        # cosmetic one: obj_set APPENDS, so `role: admin` / `role: guest` built
        # a two-entry object where bayan_json_v_obj_get returns the FIRST
        # ("admin") while the serialiser emits {"role":"admin","role":"guest"}
        # — and every downstream JSON reader takes the LAST. Two components
        # reading the same document disagreeing about a role is exactly the
        # shape a policy file must not have.
        var dupk = str_new(kptr, klen);
        if (bayan_json_v_obj_get_by_str(obj, dupk) != 0) {
            _jp_set_err(ps, "duplicate mapping key", kptr - load64(ps));
            return 0;
        }
        bayan_json_v_obj_set(obj, dupk, val);
    }
    return 0;
}

# Parse consecutive `- ` entries at exactly `indent` into a JTAG_ARR.
# Supports scalar/flow items, `-` alone + deeper block, and compact
# `- key: value` / `- - x` items (the item re-anchors at the rest column).
fn _yp_parse_sequence(ps, yc, indent): i64 {
    var arr = bayan_json_v_arr_new();
    while (1 == 1) {
        var rec = _yc_cur(yc);
        if (rec == 0) { return arr; }
        var ri = load64(rec + 24);
        if (ri < indent) { return arr; }
        var roff = load64(rec);
        var rptr = load64(rec + 8);
        var rlen = load64(rec + 16);
        if (ri > indent) {
            _jp_set_err(ps, "unexpected indentation", roff);
            return 0;
        }
        if (_yp_is_seq_line(rptr, rlen) == 0) { return arr; }   # back to parent mapping
        var item = 0;
        if (rlen == 1) {
            # bare `-` — item is a deeper block, else null
            _yc_advance(yc);
            var nrec = _yc_cur(yc);
            item = bayan_json_v_null();
            if (nrec != 0) {
                if (load64(nrec + 24) > indent) {
                    item = _yp_parse_block(ps, yc, load64(nrec + 24));
                }
            }
        }
        else {
            # `- rest` — rest starts past the dash + spaces
            var j = 1 + _yp_trim_start(rptr + 1, rlen - 1);
            var restp = rptr + j;
            var restl = rlen - j;
            var restcol = ri + j;
            var restoff = roff + j;
            var compact = 0;
            if (load8(restp) != 91) {                       # flow item is never compact
                if (_yp_is_seq_line(restp, restl) == 1) { compact = 1; }
                else {
                    if (_yp_find_colon(restp, restl) >= 0) { compact = 1; }
                }
            }
            if (compact == 1) {
                # re-anchor the record at the rest column and parse the whole
                # nested block (its continuation lines sit at restcol)
                store64(rec,      restoff);
                store64(rec + 8,  restp);
                store64(rec + 16, restl);
                store64(rec + 24, restcol);
                item = _yp_parse_block(ps, yc, restcol);
            }
            else {
                _yc_advance(yc);
                item = _yp_line_value(ps, restp, restl, restoff);
            }
        }
        if (item == 0) { return 0; }
        bayan_json_v_arr_push(arr, item);
    }
    return 0;
}

# === Public parse entries ===

# Reentrant parse — caller owns ps (bayan_json_parse_state_size() bytes; the
# yaml parser shares the json parser-state struct). Returns json_v* or 0 with
# the error in bayan_yaml_state_error(ps)/_pos(ps). Touches no globals.
fn bayan_yaml_parse_ctx(ps, buf, len): i64 {
    _jp_state_init(ps, buf, len);
    var lines = _yp_scan_lines(ps, buf, len);
    if (lines == 0) { return 0; }
    var n = vec_len(lines);
    if (n == 0) { return bayan_json_v_null(); }   # empty document
    var yc[24];
    store64(&yc,      lines);
    store64(&yc + 8,  0);
    store64(&yc + 16, n);
    var first = vec_get(lines, 0);
    var base = load64(first + 24);
    var fptr = load64(first + 8);
    var flen = load64(first + 16);
    # top-level flow-sequence document: `[...]` on the first line is a value
    # line, never a mapping (a ': ' inside the brackets must not key-split it)
    if (load8(fptr) == 91) {
        if (n == 1) { return _yp_line_value(ps, fptr, flen, load64(first)); }
        _jp_set_err(ps, "unexpected line", load64(vec_get(lines, 1)));
        return 0;
    }
    # top-level scalar document: a single line that is neither a mapping
    # entry nor a sequence entry
    if (_yp_is_seq_line(fptr, flen) == 0) {
        if (_yp_find_colon(fptr, flen) < 0) {
            if (n == 1) { return _yp_line_value(ps, fptr, flen, load64(first)); }
            _jp_set_err(ps, "expected mapping or sequence entry", load64(first));
            return 0;
        }
    }
    var v = _yp_parse_block(ps, &yc, base);
    if (v == 0) { return 0; }
    if (load64(&yc + 8) < n) {
        var left = _yc_cur(&yc);
        _jp_set_err(ps, "unexpected line", load64(left));
        return 0;
    }
    return v;
}

# Reentrant parse — Str convenience over bayan_yaml_parse_ctx.
fn bayan_yaml_parse_ctx_str(ps, src): i64 {
    if (src == 0) {
        _jp_state_init(ps, 0, 0);
        _jp_set_err(ps, "null source", 0);
        return 0;
    }
    return bayan_yaml_parse_ctx(ps, str_data(src), str_len(src));
}

# Public parse entry — explicit cstr+len. Globals-compat wrapper over the
# reentrant path (stack-local state per call, so the parse itself is
# thread-safe); mirrors the per-call error into bayan_yaml_last_error()/_pos().
#
# NAMED `_buf`, NOT `_str` — see the matching note on bayan_json_v_parse_buf.
# Cyrius routes `X(<Str>, ...)` to `X_str` when that name exists, so a cstr+len
# form may never occupy it. See CHANGELOG [1.3.0].
fn bayan_yaml_parse_buf(buf, len): i64 {
    var ps[48];
    var v = bayan_yaml_parse_ctx(&ps, buf, len);
    _yaml_err_msg = load64(&ps + 24);
    _yaml_err_pos = load64(&ps + 32);
    return v;
}

# Public parse entry — Str. Returns json_v* or 0.
fn bayan_yaml_parse(src): i64 {
    if (src == 0) { _yaml_err_msg = "null source"; _yaml_err_pos = 0; return 0; }
    return bayan_yaml_parse_buf(str_data(src), str_len(src));
}

# === Frontmatter split ===
#
# Split a Markdown document with optional YAML frontmatter:
#   ---            <- first line, exactly
#   <yaml...>
#   ---  (or ...)  <- closing fence line, exactly
#   <body...>
# Returns a 16-byte pair { yaml: Str|0 @ +0, body: Str @ +8 }. Without a
# well-formed frontmatter block (no leading `---`, or no closing fence),
# yaml is 0 and body is the whole input — mirroring the mneme interim
# parser's behavior. Both Strs share the source buffer (no copy).

# True if line [ls, le) (exclusive, \r already excluded) is exactly `---`
# or `...`.
fn _yfm_is_fence(buf, ls, le): i64 {
    if (le - ls != 3) { return 0; }
    var c = load8(buf + ls);
    if (c != 45 && c != 46) { return 0; }
    if (load8(buf + ls + 1) != c) { return 0; }
    if (load8(buf + ls + 2) != c) { return 0; }
    return 1;
}

# Allocator-threading variant of bayan_yaml_frontmatter_split.
fn bayan_yaml_frontmatter_split_a(a, src): i64 {
    # CHECK THE ALLOCATION (1.5.1). `a` may be a caller's arena, and an
    # exhausted arena returns 0 — after which `store64(p, 0)` below wrote
    # through a null pointer. Verified: a drained arena_allocator(64) took
    # SIGSEGV here, and so did a 64 KiB per-request arena on a document large
    # enough to fill it. Every other allocating entry in this module already
    # checks; this one did not.
    var p = alloc_via(a, 16);
    if (p == 0) { return 0; }
    if (src == 0) { return 0; }
    var buf = str_data(src);
    var len = str_len(src);
    store64(p, 0);
    store64(p + 8, src);
    # -- first line must be exactly --- --
    var e0 = 0;
    while (e0 < len && load8(buf + e0) != 10) { e0 = e0 + 1; }
    var t0 = e0;
    if (t0 > 0 && load8(buf + t0 - 1) == 13) { t0 = t0 - 1; }
    if (_yfm_is_fence(buf, 0, t0) == 0) { return p; }
    if (load8(buf) != 45) { return p; }            # `...` can't OPEN a block
    if (e0 >= len) { return p; }                   # `---` with no newline: no block
    # -- find the closing fence line --
    var ls = e0 + 1;
    while (ls <= len) {
        var le = ls;
        while (le < len && load8(buf + le) != 10) { le = le + 1; }
        var te = le;
        if (te > ls && load8(buf + te - 1) == 13) { te = te - 1; }
        if (_yfm_is_fence(buf, ls, te) == 1) {
            var bstart = le + 1;
            if (bstart > len) { bstart = len; }
            store64(p, str_new_a(a, buf + e0 + 1, ls - e0 - 1));
            store64(p + 8, str_new_a(a, buf + bstart, len - bstart));
            return p;
        }
        ls = le + 1;
    }
    return p;                                      # no closing fence
}

# Split Markdown into { yaml frontmatter | 0, body }. See above.
fn bayan_yaml_frontmatter_split(src): i64 {
    return bayan_yaml_frontmatter_split_a(default_alloc(), src);
}

# Frontmatter-pair accessor: the yaml Str (0 when no frontmatter was found).
fn bayan_yaml_fm_yaml(p): i64 { return load64(p); }

# Frontmatter-pair accessor: the body Str (whole input when no frontmatter).
fn bayan_yaml_fm_body(p): i64 { return load64(p + 8); }

# --- pdf.cyr ---

# pdf.cyr — PDF writer + reader (text extraction) for bayan.
# Usage: include "lib/bayan.cyr" (full bundle) or "lib/bayan-pdf.cyr" (sublib).
# Requires: alloc.cyr, string.cyr, str.cyr, vec.cyr, fmt.cyr, io.cyr, fnptr.cyr
#
# Greenfield module (written in-repo at 1.5.0) — not a carve from cyrius's
# stdlib, so unlike base64/csv/u128/bigint/toml/cyml/dtoa/json there is no
# pre-carve `lib/pdf.cyr` this content moved out of.
#
# THE OBJECT MODEL. A PDF file is a set of numbered objects drawn from eight
# types plus an indirect reference. `bayan_pdf_obj_*` is a tagged 32-byte cell
# (PTAG_*) covering all of them. It is deliberately NOT the `bayan_json_v_*`
# tree: PDF has name / stream / indirect-ref with no JSON analogue, PDF strings
# are raw bytes where JTAG_STR is documented as decoded UTF-8, and reusing the
# json tree would drag json.cyr + dtoa.cyr into the pdf sublib's closure.
#
# THE WRITER emits a PDF 1.7 file: a two-line header, indirect objects, a
# classic 20-byte-entry cross-reference table, and a trailer. Byte offsets are
# MEASURED from the output builder as it grows, never predicted from a running
# sum, and every recorded offset is re-checked against the bytes it names
# before to_bytes returns.
#
# THE READER parses the cross-reference (classic table AND PDF-1.5 xref
# streams, including /Prev chains and objects stored inside object streams),
# resolves indirect references, walks the page tree honouring inherited
# attributes, and extracts text from content streams.
#
# In scope:
#   - writer: pages, the standard-14 fonts with real AFM metrics, text and
#     graphics operators, /Info metadata, optional Flate compression
#   - reader: xref tables + xref streams, object streams, /Prev chains,
#     FlateDecode / ASCIIHexDecode / ASCII85Decode / RunLengthDecode,
#     PNG + TIFF predictors, page-tree walk, text extraction
#   - WinAnsiEncoding transcoding both ways, and metric text measurement
#     and word wrap (proportional-font-correct, not character counting)
#
# REJECTED LOUDLY (a parse error naming the byte offset, never a silent
# mis-parse — the house rule this module is held to):
#   - encrypted documents (/Encrypt in the trailer)
#   - unsupported stream filters, including LZWDecode and the image codecs
#   - a /Length that does not reach `endstream`
#   - a bare CR after the `stream` keyword
#   - a cross-reference entry that is not exactly 20 bytes in the strict form
#   - a cross-reference offset that does not land on `N G obj` for that N
#   - a trailer /Size that does not exceed the highest object number
#   - nesting past _PDF_MAX_DEPTH, reference chains past _PDF_MAX_REFS,
#     xref /Prev loops, and page-tree cycles
#   - a newline inside a show-text call, and unbalanced BT/ET or q/Q
#
# Reentrancy + bounds: every parse threads a caller-owned _PDF_STATE_SIZE-byte
# PdfState (buffer, length, cursor, error, depth counters) — there is NO
# module-global cursor. See
# docs/development/issues/2026-06-23-thoth-json-value-parser-global-cursor-not-thread-safe.md
# Every recursive descent is bounded by an explicit cap, per
# docs/development/issues/2026-07-16-agnosai-json-no-recursion-depth-cap.md
#
# NOTE (units): every geometric parameter and return in the public API is in
# MILLI-POINTS (mpt); 1 pt = 1000 mpt, so A4 is 595000 x 842000 mpt. Font
# metrics are in 1/1000 em. The module contains no floating point at all:
# bayan_f64_to_json emits exponent notation and the token "null", both of
# which are invalid PDF number syntax, and fncallN cannot pass an f64.
#
# NOTE (reals): a PDF real is captured losslessly as (scaled, places) with
# value == scaled / 10^places, so "0.50" round-trips as (50, 2) and the
# emitter is the exact inverse of the scanner. PDF has no exponent form.
#
# NOTE (compression hook, NOT a sankoch dep): FlateDecode is reached through
# a function pointer the consumer installs — bayan_pdf_set_inflate(&zlib_decompress)
# and bayan_pdf_set_deflate(&zlib_compress) from lib/sankoch.cyr. bayan folds
# INTO cyrius's stdlib, so a hard include of sankoch.cyr would create a
# module-ordering hazard in that fold for a filter most consumers never need.
# With no hook installed the writer emits uncompressed (still fully valid)
# output and the reader reports a specific error on a Flate stream.
#
# NOTE (internal prefixes): helpers use ten subsystem prefixes — _pdfe_ _pdff_ _pdfg_
# _pdfo_ _pdfl_ _pdfp_ _pdfx_ _pdfz_ _pdfc_ _pdfw_ — never a bare _pdf_ one.
# mneme's src/io_export_pdf.cyr defines 14 bare _pdf_* helpers and is the named
# consumer for this API, so it will have both files in scope during its
# migration. A duplicate fn name in cyrius is a WARNING with last-definition
# -wins that rebinds even textually-earlier call sites, so the intersection
# being empty is a correctness requirement, not tidiness. CI enforces it.
#
# NOTE (single-pass bundle order): pdf.cyr sits after yaml.cyr and before
# _compat.cyr in cyrius.cyml [lib].modules. It references no symbol from any
# other bayan module, so its sublib closure is this single file.
#
# NOTE (borrowed source buffer): bayan_pdf_parse_buf BORROWS the caller's
# bytes — the returned document holds Str views into that buffer rather than
# copies. The buffer must outlive the document, and alloc_reset() invalidates
# both together.

# === Constants ===============================================================

# Object cell tags. Plain vars mirroring JTAG_* (json.cyr:239-245).
var PTAG_NULL   = 0;
var PTAG_BOOL   = 1;
var PTAG_INT    = 2;
var PTAG_REAL   = 3;
var PTAG_NAME   = 4;
var PTAG_STR    = 5;
var PTAG_ARR    = 6;
var PTAG_DICT   = 7;
var PTAG_STREAM = 8;
var PTAG_REF    = 9;

# Standard-14 face ids — the exact order of scripts/gen-widths.py's FONTS_SRC.
var PDF_FONT_HELVETICA         = 0;
var PDF_FONT_HELVETICA_BOLD    = 1;
var PDF_FONT_HELVETICA_OBLIQUE = 2;
var PDF_FONT_HELVETICA_BOLDOBL = 3;
var PDF_FONT_TIMES_ROMAN       = 4;
var PDF_FONT_TIMES_BOLD        = 5;
var PDF_FONT_TIMES_ITALIC      = 6;
var PDF_FONT_TIMES_BOLDITALIC  = 7;
var PDF_FONT_COURIER           = 8;
var PDF_FONT_COURIER_BOLD      = 9;
var PDF_FONT_COURIER_OBLIQUE   = 10;
var PDF_FONT_COURIER_BOLDOBL   = 11;
var PDF_FONT_SYMBOL            = 12;
var PDF_FONT_ZAPFDINGBATS      = 13;
var PDF_FONT_COUNT             = 14;

# Page presets, in milli-points.
var PDF_PAGE_A4     = 0;
var PDF_PAGE_LETTER = 1;
var PDF_PAGE_LEGAL  = 2;

var PDF_MODE_WRITE = 0;
var PDF_MODE_READ  = 1;

# WinAnsi transcode policy for codepoints the encoding cannot represent.
var PDF_WINANSI_STRICT     = 0;   # reject loudly
var PDF_WINANSI_SUBSTITUTE = 1;   # emit '?'

# Handle guard word, 'BPDF'. In an i64-everywhere language a magic word is the
# only boundary check the type system can offer.
var PDF_MAGIC = 1112494662;

# === Struct sizes and bounds =================================================

var _PDF_OBJ_SIZE   = 32;    # PdfObj  {tag, a, b, c}
var _PDF_PAIR_SIZE  = 16;    # PdfPair {key, val}
var _PDF_STATE_SIZE = 64;    # PdfState — caller-owned, per call
var _PDF_XREF_SIZE  = 24;    # PdfXrefEnt {kind, a, b}

# Caps. Each has its own counter and its own rejection message, so a refusal
# always names which bound was hit.
var _PDF_MAX_DEPTH        = 128;         # array/dict nesting (json _JP_MAX_DEPTH parity)
var _PDF_MAX_REFS         = 64;          # indirect-reference chain length
var _PDF_MAX_XREF         = 64;          # xref /Prev chain sections
var _PDF_MAX_TREE         = 64;          # page-tree depth
var _PDF_MAX_GDEPTH       = 28;          # writer q/Q nesting (PDF's own limit)
var _PDF_MAX_OBJS         = 2097152;     # 1 << 21 objects in one document
var _PDF_MAX_INFLATE      = 67108864;    # 64 MiB, any single stream
var _PDF_MAX_INFTOT       = 536870912;   # 512 MiB per document (bomb guard)
var _PDF_MAX_WALK         = 1048576;     # page-tree node visits per document

# === Flate hooks =============================================================
#
# Bare integer literals: statically initialised, so they are immune to the
# initialisation-order hazard where a top-level initialiser reading a global
# declared further down the file silently reads 0.  #skip-lint: the deferred-global hazard, cyrius init-order jargon

var _pdf_inflate_fp = 0;
var _pdf_deflate_fp = 0;

# Install the inflate hook. `fp` is &zlib_decompress from lib/sankoch.cyr, or
# any fn(src, src_len, dst, dst_cap) returning bytes written, negative on
# error. The stream is zlib-wrapped, NOT raw DEFLATE.
#
# A consumer parsing untrusted PDFs should install a ratio-capped wrapper
# around zlib_decompress_with_ratio_cap rather than the bare entry: the
# 4-argument hook signature cannot express sankoch's ratio limit, so bayan's
# own defence is the dst_cap it passes plus a per-document total budget.
fn bayan_pdf_set_inflate(fp): i64 { _pdf_inflate_fp = fp; return 0; }

# Install the deflate hook — &zlib_compress. With none installed the writer
# emits uncompressed streams and omits /Filter, which is still valid PDF.
fn bayan_pdf_set_deflate(fp): i64 { _pdf_deflate_fp = fp; return 0; }

# 1 if an inflate hook is installed.
fn bayan_pdf_has_inflate(): i64 { if (_pdf_inflate_fp == 0) { return 0; } return 1; }

# 1 if a deflate hook is installed.
fn bayan_pdf_has_deflate(): i64 { if (_pdf_deflate_fp == 0) { return 0; } return 1; }

# === Last-error mirror =======================================================
#
# Populated by the globals-compat entry points AFTER a parse returns, purely so
# single-threaded callers keep a convenient accessor (json.cyr:256-266 pattern).
# Concurrent parsers must read the error from their own PdfState.

var _pdf_err_msg = 0;
var _pdf_err_pos = 0;

# Monotonic document generation, stamped into every PdfDoc at +168.
# alloc_reset() recycles document ADDRESSES, so a pointer alone cannot
# identify a document across a reset.
var _pdf_doc_gen = 0;

# Last parse error message (cstring); "" when there was none.
fn bayan_pdf_last_error(): i64 {
    if (_pdf_err_msg == 0) { return ""; }
    return _pdf_err_msg;
}

# Byte offset of the last parse error, or 0 - 1 when there was none.
fn bayan_pdf_last_error_pos(): i64 { return _pdf_err_pos; }

# === _pdfe_ — per-call state, errors, byte predicates, integer helpers =======

# Byte count of a PdfState, for `var ps[bayan_pdf_parse_state_size()]`-style
# sizing by consumers that allocate it dynamically.
fn bayan_pdf_parse_state_size(): i64 { return _PDF_STATE_SIZE; }

# Zero and seed a PdfState over (buf, len) allocating through `a`.
#   +0 buf  +8 len  +16 pos  +24 err_msg  +32 err_pos
#   +40 depth  +48 refs  +56 alloc
fn _pdfe_state_init(ps, buf, len, a): i64 {
    store64(ps,      buf);
    store64(ps + 8,  len);
    store64(ps + 16, 0);
    store64(ps + 24, 0);
    store64(ps + 32, 0 - 1);
    store64(ps + 40, 0);
    store64(ps + 48, 0);
    store64(ps + 56, a);
    return 0;
}

# Record a parse error, first-wins so the earliest failure survives. Always
# returns 0 so call sites can `return _pdfe_err(ps, "…", pos);`.
fn _pdfe_err(ps, msg, pos): i64 {
    if (load64(ps + 24) == 0) {
        store64(ps + 24, msg);
        store64(ps + 32, pos);
    }
    return 0;
}

# Error message held by a PdfState ("" when clean).
fn bayan_pdf_state_error(ps): i64 {
    if (ps == 0) { return ""; }
    if (load64(ps + 24) == 0) { return ""; }
    return load64(ps + 24);
}

# Error byte offset held by a PdfState, or 0 - 1 when clean.
fn bayan_pdf_state_error_pos(ps): i64 {
    if (ps == 0) { return 0 - 1; }
    return load64(ps + 32);
}

# PDF whitespace: NUL, tab, LF, FF, CR, space.
fn _pdfe_is_ws(c): i64 {
    if (c == 0)  { return 1; }
    if (c == 9)  { return 1; }
    if (c == 10) { return 1; }
    if (c == 12) { return 1; }
    if (c == 13) { return 1; }
    if (c == 32) { return 1; }
    return 0;
}

# PDF delimiters: ( ) < > [ ] { } / %
fn _pdfe_is_delim(c): i64 {
    if (c == 40)  { return 1; }
    if (c == 41)  { return 1; }
    if (c == 60)  { return 1; }
    if (c == 62)  { return 1; }
    if (c == 91)  { return 1; }
    if (c == 93)  { return 1; }
    if (c == 123) { return 1; }
    if (c == 125) { return 1; }
    if (c == 47)  { return 1; }
    if (c == 37)  { return 1; }
    return 0;
}

# A regular character is neither whitespace nor a delimiter.
fn _pdfe_is_regular(c): i64 {
    if (_pdfe_is_ws(c) == 1)    { return 0; }
    if (_pdfe_is_delim(c) == 1) { return 0; }
    return 1;
}

# ASCII digit test.
fn _pdfe_is_digit(c): i64 {
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}

# Hex digit value 0..15, or 0 - 1.
fn _pdfe_hexval(c): i64 {
    if (c >= 48 && c <= 57)  { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70)  { return c - 55; }
    return 0 - 1;
}

# 10^n for n in 0..18. Returns 1 for out-of-range n rather than overflowing.
fn _pdfe_pow10(n): i64 {
    var r = 1;
    var i = 0;
    if (n < 0 || n > 18) { return 1; }
    while (i < n) { r = r * 10; i = i + 1; }
    return r;
}

# a*b/c, guarding the multiply BEFORE it happens. Returns 0 - 1 on overflow or
# a zero divisor. The reader takes font sizes from untrusted Tf operands, so
# this guard is reachable from input, not merely defensive.
fn _pdfe_muldiv(a, b, c): i64 {
    var neg = 0;
    var x = a;
    var y = b;
    if (c == 0) { return 0 - 1; }
    if (x < 0) { x = 0 - x; neg = 1 - neg; }
    if (y < 0) { y = 0 - y; neg = 1 - neg; }
    if (y != 0) {
        if (x > 9223372036854775807 / y) { return 0 - 1; }
    }
    var r = (x * y) / c;
    if (neg == 1) { return 0 - r; }
    return r;
}

# Binary-safe forward search for `needle` (nlen bytes) in `hay` (hlen bytes)
# starting at `from`. Returns the offset, or 0 - 1. No strlen anywhere near
# payload bytes — a deflated stream contains NULs with near-certainty.
fn _pdfe_memfind(hay, hlen, needle, nlen, from): i64 {
    var i = from;
    if (nlen <= 0)    { return 0 - 1; }
    if (i < 0)        { i = 0; }
    while (i + nlen <= hlen) {
        if (memeq(hay + i, needle, nlen) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Binary-safe BACKWARD search — finds the LAST occurrence. Used for the final
# `startxref`, which is what makes incrementally-updated files resolve to their
# newest cross-reference section.
fn _pdfe_rmemfind(hay, hlen, needle, nlen): i64 {
    var i = hlen - nlen;
    if (nlen <= 0) { return 0 - 1; }
    while (i >= 0) {
        if (memeq(hay + i, needle, nlen) == 1) { return i; }
        i = i - 1;
    }
    return 0 - 1;
}

# Decimal integer over an exact span, with a leading sign. Non-digits end the
# scan. Returns 0 for an empty span.
fn _pdfe_atoi_span(p, n): i64 {
    var i = 0;
    var neg = 0;
    var r = 0;
    if (n <= 0) { return 0; }
    if (load8(p) == 45) { neg = 1; i = 1; }
    elif (load8(p) == 43) { i = 1; }
    while (i < n) {
        var c = load8(p + i);
        if (_pdfe_is_digit(c) == 0) { break; }
        r = r * 10 + (c - 48);
        i = i + 1;
    }
    if (neg == 1) { return 0 - r; }
    return r;
}

# --- Standard-14 font metrics -------------------------------------
#
# Advance widths in 1/1000 em, WinAnsiEncoding-indexed, derived from
# Adobe's original AFM metrics (via groff's afmtodit-generated devps
# font files) and verified against 22 documented spot widths plus a
# whole-family monospace check.
#
# GENERATED by scripts/gen-widths.py — do not hand-edit.
#
# Each width is two base64-alphabet characters (high 6 bits, low 6
# bits) covering codes 32..255 = 448 characters per font. Codes 0..31
# are control characters and carry no glyph. The Courier family is
# uniformly 600 at every code, so it is answered arithmetically by
# _pdf_font_width rather than tabled.

# Helvetica
var _PDF_W_HELV = "";  #skip-lint: generated data table, one literal, not wrappable

# Helvetica-Bold
var _PDF_W_HELV_B = "";  #skip-lint: generated data table, one literal, not wrappable

# Helvetica-Oblique
var _PDF_W_HELV_O = "";  #skip-lint: generated data table, one literal, not wrappable

# Helvetica-BoldOblique
var _PDF_W_HELV_BO = "";  #skip-lint: generated data table, one literal, not wrappable

# Times-Roman
var _PDF_W_TIMES = "";  #skip-lint: generated data table, one literal, not wrappable

# Times-Bold
var _PDF_W_TIMES_B = "";  #skip-lint: generated data table, one literal, not wrappable

# Times-Italic
var _PDF_W_TIMES_I = "";  #skip-lint: generated data table, one literal, not wrappable

# Times-BoldItalic
var _PDF_W_TIMES_BI = "";  #skip-lint: generated data table, one literal, not wrappable

# Symbol
var _PDF_W_SYMBOL = "";  #skip-lint: generated data table, one literal, not wrappable

# ZapfDingbats
var _PDF_W_ZAPF = "";  #skip-lint: generated data table, one literal, not wrappable

# 10 tabled fonts; the 4 Courier faces are constant-600.

# --- WinAnsiEncoding <-> Unicode --------------------------------
#
# Only the 0x80..0x9F block needs a table: 0x00..0x7F is ASCII and
# 0xA0..0xFF is Latin-1 identity (verified: zero non-identity maps).
# Three base64 chars per entry (max is U+2122, which exceeds 64^2).
# The five CP1252 holes 0x81 0x8D 0x8F 0x90 0x9D are emitted as 0.
var _PDF_WINANSI_HI = "CCsAAACAaAGSCAeCAmCAgCAhALGCAwAFgCA5AFSAAAAF9AAAAAACAYCAZCAcCAdCAiCATCAUALcCEiAFhCA6AFTAAAAF+AF4";  #skip-lint: generated data table, one literal, not wrappable

# === _pdff_ — fonts, metrics, units, metric measurement ======================
#
# Everything here is integer-only and encoding-indexed. The ten tables above
# hold advance widths in 1/1000 em; the four Courier faces are uniformly 600
# and are answered arithmetically rather than tabled (D14).
#
# NOTE (Symbol / ZapfDingbats): scripts/gen-widths.py indexes those two faces
# by their BUILT-IN encodings, not WinAnsiEncoding. A width from them is only
# meaningful for bytes already in that encoding, which is exactly why the
# writer never emits /Encoding /WinAnsiEncoding for them.

# One base64-alphabet character (A-Z a-z 0-9 + /) to its 0..63 value, or 0 - 1
# for anything else. Not base64 *decoding* — there is no padding and no bit
# repacking here; the generator writes each width as an independent
# (high 6 bits, low 6 bits) digit pair, so a digit is a plain digit.
fn _pdff_a2i(c): i64 {
    if (c >= 65 && c <= 90)  { return c - 65; }   # 'A'..'Z' -> 0..25
    if (c >= 97 && c <= 122) { return c - 71; }   # 'a'..'z' -> 26..51
    if (c >= 48 && c <= 57)  { return c + 4; }    # '0'..'9' -> 52..61
    if (c == 43) { return 62; }                   # '+'
    if (c == 47) { return 63; }                   # '/'
    return 0 - 1;
}

# The `_PDF_W_*` cstring for a face, or 0 for the four Courier faces (which
# have no table — see _pdff_width). Returns 0 for an out-of-range id too; the
# caller must range-check the face BEFORE reading a 0 as "Courier".
fn _pdff_table(font): i64 {
    if (font == PDF_FONT_HELVETICA)         { return _PDF_W_HELV; }
    if (font == PDF_FONT_HELVETICA_BOLD)    { return _PDF_W_HELV_B; }
    if (font == PDF_FONT_HELVETICA_OBLIQUE) { return _PDF_W_HELV_O; }
    if (font == PDF_FONT_HELVETICA_BOLDOBL) { return _PDF_W_HELV_BO; }
    if (font == PDF_FONT_TIMES_ROMAN)       { return _PDF_W_TIMES; }
    if (font == PDF_FONT_TIMES_BOLD)        { return _PDF_W_TIMES_B; }
    if (font == PDF_FONT_TIMES_ITALIC)      { return _PDF_W_TIMES_I; }
    if (font == PDF_FONT_TIMES_BOLDITALIC)  { return _PDF_W_TIMES_BI; }
    if (font == PDF_FONT_SYMBOL)            { return _PDF_W_SYMBOL; }
    if (font == PDF_FONT_ZAPFDINGBATS)      { return _PDF_W_ZAPF; }
    return 0;
}

# 1 for the five CP1252 code points that carry no glyph at all — 0x81 0x8D
# 0x8F 0x90 0x9D. The generator already writes 0 into the ten tables at these
# codes; this predicate exists so the untabled Courier family agrees with them.
fn _pdff_undefined(code): i64 {
    if (code == 129) { return 1; }   # 0x81
    if (code == 141) { return 1; }   # 0x8D
    if (code == 143) { return 1; }   # 0x8F
    if (code == 144) { return 1; }   # 0x90
    if (code == 157) { return 1; }   # 0x9D
    return 0;
}

# Advance width of one code in 1/1000 em. 0 for an out-of-range face or code,
# for the control range 0..31, and for a code the face has no glyph for.
#
# The undefined-code check is deliberately ABOVE the Courier shortcut. Hoist
# the shortcut over it and the four Courier faces answer 600 on exactly those
# five codes while every other face answers 0 — a divergence the WinAnsi
# encoder makes unreachable in practice, which is precisely how a silent bug
# describes itself. tests/ pins it as a paired assertion.
fn _pdff_width(font, code): i64 {
    if (font < 0 || font >= PDF_FONT_COUNT) { return 0; }
    if (code < 32 || code > 255)            { return 0; }
    if (_pdff_undefined(code) == 1)         { return 0; }
    var t = _pdff_table(font);
    if (t == 0) { return 600; }                    # the Courier family
    # The table covers codes 32..255 at two characters each, high digit first.
    var k = (code - 32) * 2;
    return _pdff_a2i(load8(t + k)) * 64 + _pdff_a2i(load8(t + k + 1));
}

# PostScript BaseFont name for a face id, as a cstring; "" when out of range.
# The order is PDF_FONT_*'s, which is gen-widths.py's FONTS_SRC order.
fn _pdff_basefont(id): i64 {
    if (id == PDF_FONT_HELVETICA)         { return "Helvetica"; }
    if (id == PDF_FONT_HELVETICA_BOLD)    { return "Helvetica-Bold"; }
    if (id == PDF_FONT_HELVETICA_OBLIQUE) { return "Helvetica-Oblique"; }
    if (id == PDF_FONT_HELVETICA_BOLDOBL) { return "Helvetica-BoldOblique"; }
    if (id == PDF_FONT_TIMES_ROMAN)       { return "Times-Roman"; }
    if (id == PDF_FONT_TIMES_BOLD)        { return "Times-Bold"; }
    if (id == PDF_FONT_TIMES_ITALIC)      { return "Times-Italic"; }
    if (id == PDF_FONT_TIMES_BOLDITALIC)  { return "Times-BoldItalic"; }
    if (id == PDF_FONT_COURIER)           { return "Courier"; }
    if (id == PDF_FONT_COURIER_BOLD)      { return "Courier-Bold"; }
    if (id == PDF_FONT_COURIER_OBLIQUE)   { return "Courier-Oblique"; }
    if (id == PDF_FONT_COURIER_BOLDOBL)   { return "Courier-BoldOblique"; }
    if (id == PDF_FONT_SYMBOL)            { return "Symbol"; }
    if (id == PDF_FONT_ZAPFDINGBATS)      { return "ZapfDingbats"; }
    return "";
}

# Sum of the 1/1000-em widths of `len` bytes at `ptr`. The SUM is the return
# value — no font size is applied here, and that is the whole point: scaling
# per character loses up to 1 mpt each, so 80 characters can drift 80 mpt.
# Callers scale the sum exactly once.
#
# `len` is explicit and no strlen is anywhere near this: text handed to the
# writer is WinAnsi bytes, which may legitimately contain a 0x00.
fn _pdff_run_width(font, ptr, len): i64 {
    var sum = 0;
    var i = 0;
    if (ptr == 0)  { return 0; }
    if (len <= 0)  { return 0; }
    # load8 zero-extends, so `code` is already 0..255 and needs no masking.
    while (i < len) {
        sum = sum + _pdff_width(font, load8(ptr + i));
        i = i + 1;
    }
    return sum;
}

# === Public: fonts and metrics ===============================================

# Number of standard-14 faces: 14.
fn bayan_pdf_font_count(): i64 { return PDF_FONT_COUNT; }

# BaseFont name -> face id, or 0 - 1 when the name is not one of the 14.
#
# `name` is annotated `: cstring` on purpose. Handing this a `Str` would make
# streq's strlen walk the 16-byte Str header and compare header bytes against
# "Helvetica" — a silent wrong answer, not a compile error. The annotation is
# what arms cyrius's Str-to-cstring diagnostic at the call site.
fn bayan_pdf_font_id(name: cstring): i64 {
    var i = 0;
    if (name == 0) { return 0 - 1; }
    while (i < PDF_FONT_COUNT) {
        if (streq(name, _pdff_basefont(i)) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Face id -> BaseFont name, or "" when out of range.
fn bayan_pdf_font_name(id): Str { return str_from(_pdff_basefont(id)); }

# 1 for the four Courier faces, which are the only monospaced standard-14
# faces (every code is 600/1000 em). 0 for everything else, out of range
# included — an accessor never aborts.
fn bayan_pdf_font_is_monospace(id): i64 {
    if (id >= PDF_FONT_COURIER && id <= PDF_FONT_COURIER_BOLDOBL) { return 1; }
    return 0;
}

# Advance width of one code, in 1/1000 em, WinAnsi-indexed (built-in-indexed
# for Symbol / ZapfDingbats). 0 for an out-of-range face or code and for the
# five CP1252 codes with no glyph — for all 14 faces, Courier included.
fn bayan_pdf_char_width(font, code): i64 { return _pdff_width(font, code); }

# Width of `len` WinAnsi bytes at `buf`, in mpt, at `size_mpt`.
#
# Sum first, then ONE multiply and ONE divide. `sum <= 1000 * len`; even a
# 4096-byte line at 100 pt is ~4.1e11, six orders of magnitude inside i64.
# _pdfe_muldiv still guards the multiply because the reader takes size_mpt
# from an untrusted Tf operand, so the overflow path is reachable from input.
#
# Named `_buf`, never `_str`: the `_str` suffix claims a compiler overload
# slot and would silently mis-dispatch `bayan_pdf_text_width`.
fn bayan_pdf_text_width_buf(font, size_mpt, buf, len): i64 {
    if (size_mpt <= 0) { return 0; }
    var sum = _pdff_run_width(font, buf, len);
    if (sum <= 0) { return 0; }
    var r = _pdfe_muldiv(sum, size_mpt, 1000);
    if (r < 0) { return 0; }              # overflow — 0 - 1 is not a width
    return r;
}

# Width of a Str of WinAnsi bytes, in mpt. `s` must ALREADY be WinAnsi —
# bayan_pdf_winansi() is the converter, and passing raw UTF-8 here measures
# continuation bytes as if they were glyphs.
fn bayan_pdf_text_width(font, size_mpt, s: Str): i64 {
    if (s == 0) { return 0; }
    return bayan_pdf_text_width_buf(font, size_mpt, str_data(s), str_len(s));
}

# === Public: units ===========================================================
#
# 1 pt = 1000 mpt needs no helper. These two do, because both conversions are
# rational and this module has no floating point: bayan_f64_to_json emits
# exponent notation and the token `null`, and fncallN cannot carry an f64.

# Millimetres -> mpt. 1 in = 72 pt = 72000 mpt and 1 in = 25.4 mm, so
# 1 mm = 72000/25.4 = 720000/254 mpt (~2834.65). 210 mm therefore lands on
# 595276 mpt, which is A4's documented 595.276 pt.
#
# The sign is split off BEFORE the rounding add, because Cyrius division
# truncates toward ZERO: (0-7)/2 == -3, so `(v * 720000 + 127) / 254` on a
# negative v rounds the wrong way and bayan_pdf_mm(0 - k) stops being
# 0 - bayan_pdf_mm(k). 0 on overflow rather than a wrapped value.
fn bayan_pdf_mm(n): i64 {
    var neg = 0;
    var v = n;
    if (v < 0) { neg = 1; v = 0 - v; }
    if (v > 12810238940076) { return 0; }         # v * 720000 would overflow
    var r = (v * 720000 + 127) / 254;
    if (neg == 1) { return 0 - r; }
    return r;
}

# Inches -> mpt. 1 in = 72 pt exactly, so this is a scale with no rounding.
# 0 on overflow.
fn bayan_pdf_in(n): i64 {
    if (n > 128102389400760)       { return 0; }
    if (n < 0 - 128102389400760)   { return 0; }
    return n * 72000;
}

# === Public: metric word wrap ================================================

# Greedy word wrap BY MEASURED WIDTH into a vec of Str lines, each a view into
# `s` (no copy — the vec and the 16-byte headers come from `a`, the bytes do
# not). Splits on byte 0x20 only; runs of spaces collapse and leading and
# trailing spaces are dropped. 0 on OOM.
#
# This is the function that replaces character-count wrapping. At 11 pt,
# 80 'W' measures 830.72 pt and 80 'l' measures 195.36 pt — the same character
# count, 4.25x apart, and 308 pt of the first one hangs off a 595 pt page.
# A counter cannot see that; a measurement can.
#
# A word wider than the column is emitted ALONE on its own line, never
# truncated and never split mid-glyph. That is what makes the loop terminate:
# every iteration consumes at least one word, so an unbreakable word costs one
# line rather than spinning forever trying to make it fit.
fn bayan_pdf_wrap_a(a, font, size_mpt, width_mpt, s: Str): i64 {
    var v = vec_new_a(a);
    if (v == 0) { return 0; }
    if (s == 0) { return v; }
    var p = str_data(s);
    var n = str_len(s);
    if (p == 0) { return v; }
    if (n <= 0) { return v; }
    var spw = _pdff_width(font, 32);   # the joining space, in 1/1000 em
    var ls = 0 - 1;                    # first byte of the open line; -1 = none
    var le = 0;                        # one past its last byte
    var lw = 0;                        # its width in 1/1000 em, NEVER scaled
    var i = 0;
    while (i < n) {
        # Skip the separator run.
        while (i < n) {
            if (load8(p + i) != 32) { break; }
            i = i + 1;
        }
        if (i >= n) { break; }
        # Take one word.
        var ws = i;
        while (i < n) {
            if (load8(p + i) == 32) { break; }
            i = i + 1;
        }
        var ww = _pdff_run_width(font, p + ws, i - ws);
        if (ls < 0) {
            # First word of a line goes on unconditionally, however wide.
            ls = ws;
            le = i;
            lw = ww;
        } else {
            # Scale the CANDIDATE SUM once, here — not the pieces separately.
            var cand = lw + spw + ww;
            var mpt = _pdfe_muldiv(cand, size_mpt, 1000);
            if ((mpt >= 0) && (mpt <= width_mpt)) {
                le = i;
                lw = cand;
            } else {
                var ln = str_sub_a(a, s, ls, le - ls);
                if (ln == 0) { return 0; }
                if (vec_push_a(a, v, ln) != 0) { return 0; }
                ls = ws;
                le = i;
                lw = ww;
            }
        }
    }
    if (ls >= 0) {
        var last = str_sub_a(a, s, ls, le - ls);
        if (last == 0) { return 0; }
        if (vec_push_a(a, v, last) != 0) { return 0; }
    }
    return v;
}

# default_alloc() twin of bayan_pdf_wrap_a. Callers use vec_len / vec_get on
# the result; there are no wrap_len / wrap_get wrappers.
fn bayan_pdf_wrap(font, size_mpt, width_mpt, s: Str): i64 {
    return bayan_pdf_wrap_a(default_alloc(), font, size_mpt, width_mpt, s);
}

# === _pdfg_ — WinAnsiEncoding transcoding and UTF-8 ==========================
#
# THE BUG THIS SECTION EXISTS TO KILL. mneme's src/io_export_pdf.cyr writes the
# caller's raw UTF-8 bytes straight into a Type1 font dict that carries no
# /Encoding, so the viewer falls back to the font's built-in StandardEncoding —
# where only 54 of the 128 high codes are defined. "Résumé" (UTF-8 52 C3 A9 …)
# is shown one byte at a time and renders "RÃ©sumÃ©", and an em-dash (E2 80 94)
# lands on three StandardEncoding holes and disappears entirely. Neither half of
# the fix works alone: declaring /WinAnsiEncoding without transcoding just
# changes the flavour of the mojibake, and transcoding without declaring it
# produces a different one again. bayan does both — _pdfw_font_obj always emits
# /Encoding /WinAnsiEncoding, and every text-showing entry point takes bytes
# that came out of here.
#
# THE STRUCTURE OF WinAnsi (CP1252), which is why this is ~200 lines and not a
# 256-entry table in both directions:
#   0x00..0x7F  ASCII, identity.
#   0x80..0x9F  the only interesting block — 27 typographic characters scattered
#               across U+0152..U+2122, plus five codes with no character at all
#               (0x81 0x8D 0x8F 0x90 0x9D). _PDF_WINANSI_HI holds exactly these
#               32 entries; it is generated, and the five holes are stored as 0.
#   0xA0..0xFF  Latin-1, identity — gen-widths.py verified zero non-identity
#               mappings in that range, so no table is needed for it either.
#
# NAMING: this subsystem is `_pdfg_` rather than the `_pdff_` of the font
# metrics it sits next to. A duplicate fn name in cyrius is only a WARNING with
# last-definition-wins that silently rebinds textually-earlier call sites, so
# splitting the encoding half onto its own prefix keeps the two halves provably
# non-overlapping. _PDF_WINANSI_HI and _pdff_a2i come from the metrics section
# above and are used, never redefined.

# WinAnsi byte -> Unicode codepoint. Returns 0 for the five undefined codes and
# for anything outside 0..255 — a caller that needs to tell "undefined" from a
# real NUL must check the byte, since only b == 0 maps to 0 legitimately.
#
# Three base64-alphabet characters per entry: the codepoints run past U+FFFF's
# worth of two-character encoding (U+2122 needs three), so the generator fixed
# the stride at 3 rather than varying it.
fn _pdfg_winansi_to_cp(b): i64 {
    if (b < 0 || b > 255) { return 0; }
    if (b < 128)  { return b; }          # ASCII, identity
    if (b >= 160) { return b; }          # Latin-1, identity (verified)
    var k = (b - 128) * 3;
    var c0 = _pdff_a2i(load8(_PDF_WINANSI_HI + k));
    var c1 = _pdff_a2i(load8(_PDF_WINANSI_HI + k + 1));
    var c2 = _pdff_a2i(load8(_PDF_WINANSI_HI + k + 2));
    return c0 * 4096 + c1 * 64 + c2;
}

# Unicode codepoint -> WinAnsi byte, or 0 - 1 when the encoding has no byte for
# it. The two identity ranges answer without touching the table; everything else
# is a 32-entry linear scan, which is cheaper than building a reverse map and is
# reached only for the 27 characters that actually live in the high block.
#
# U+0080..U+009F (the C1 controls) deliberately fall through to the scan and
# come back 0 - 1: WinAnsi puts characters, not controls, at those byte values.
# The scan cannot false-match on the five holes either — their stored codepoint
# is 0, and every cp that reaches the scan is >= 128.
fn _pdfg_cp_to_winansi(cp): i64 {
    if (cp < 0)                 { return 0 - 1; }
    if (cp < 128)               { return cp; }
    if (cp >= 160 && cp <= 255) { return cp; }
    var i = 0;
    while (i < 32) {
        if (_pdfg_winansi_to_cp(128 + i) == cp) { return 128 + i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Decode ONE UTF-8 codepoint at `cur` in (p, len). Writes {codepoint, byte
# length} to the 16-byte `out16`; returns 1 on success, 0 on malformed input.
#
# `var out16[16]` at the call site is 16 BYTES = 2 i64 slots (G2), and +8 is the
# byte offset of the second slot (G3).
#
# This rejects all three of the classic decoder holes, because each one is a
# security bug and not a pedantry:
#   - OVERLONG forms (C0 AF for '/', E0 80 AF, …) — the canonical path-filter
#     bypass; a decoder that accepts them lets "\xC0\xAF" through a check for
#     '/' and then produces a '/' anyway.
#   - SURROGATES U+D800..U+DFFF — not characters, only ever valid inside UTF-16;
#     round-tripping them produces CESU-8, which is not UTF-8.
#   - anything above U+10FFFF — outside Unicode entirely.
# The overlong check is done on the decoded value against the minimum for that
# length, which subsumes the special-casing of lead bytes C0/C1 and F5..FF.
#
# Arithmetic is masks and multiplies, never shifts: `>>` is LOGICAL in cyrius
# (G12), and while every operand here is a zero-extended load8 and would in fact
# be safe, a later edit that introduced a signed intermediate would not be.
fn _pdfg_utf8_next(p, len, cur, out16): i64 {
    store64(out16, 0);
    store64(out16 + 8, 0);
    if (cur < 0 || cur >= len) { return 0; }
    var c0 = load8(p + cur);

    if (c0 < 128) {                       # 0xxxxxxx — ASCII
        store64(out16, c0);
        store64(out16 + 8, 1);
        return 1;
    }
    if (c0 < 192) { return 0; }           # 10xxxxxx — a continuation byte as lead

    var n = 0;
    var lo = 0;                           # smallest codepoint this length may encode
    if (c0 < 224)      { n = 2; lo = 128; }
    elif (c0 < 240)    { n = 3; lo = 2048; }
    elif (c0 < 248)    { n = 4; lo = 65536; }
    else               { return 0; }      # F8..FF — 5- and 6-byte forms never existed
    if (cur + n > len) { return 0; }      # truncated at the end of the buffer

    # Every trailing byte must be 10xxxxxx.
    var i = 1;
    while (i < n) {
        var ci = load8(p + cur + i);
        if (ci < 128 || ci > 191) { return 0; }
        i = i + 1;
    }

    var cp = 0;
    if (n == 2) {
        cp = (c0 & 31) * 64
        + (load8(p + cur + 1) & 63);
    } elif (n == 3) {
        cp = (c0 & 15) * 4096
        + (load8(p + cur + 1) & 63) * 64
        + (load8(p + cur + 2) & 63);
    } else {
        cp = (c0 & 7) * 262144
        + (load8(p + cur + 1) & 63) * 4096
        + (load8(p + cur + 2) & 63) * 64
        + (load8(p + cur + 3) & 63);
    }

    if (cp < lo)                        { return 0; }   # overlong
    if (cp >= 55296 && cp <= 57343)     { return 0; }   # U+D800..U+DFFF surrogate
    if (cp > 1114111)                   { return 0; }   # past U+10FFFF
    store64(out16, cp);
    store64(out16 + 8, n);
    return 1;
}

# Encode one codepoint as UTF-8 into `dst`, returning the byte count (1..4), or
# 0 for a value UTF-8 cannot represent. `dst` must have room for 4 bytes.
#
# The exact inverse of _pdfg_utf8_next, refusing the same three classes, so a
# codepoint that survives one survives the other. Division rather than `>>` for
# the same reason as the decoder (G12).
fn _pdfg_utf8_write(dst, cp): i64 {
    if (cp < 0 || cp > 1114111)     { return 0; }
    if (cp >= 55296 && cp <= 57343) { return 0; }
    if (cp < 128) {
        store8(dst, cp);
        return 1;
    }
    if (cp < 2048) {
        store8(dst,     192 + cp / 64);
        store8(dst + 1, 128 + (cp & 63));
        return 2;
    }
    if (cp < 65536) {
        store8(dst,     224 + cp / 4096);
        store8(dst + 1, 128 + ((cp / 64) & 63));
        store8(dst + 2, 128 + (cp & 63));
        return 3;
    }
    store8(dst,     240 + cp / 262144);
    store8(dst + 1, 128 + ((cp / 4096) & 63));
    store8(dst + 2, 128 + ((cp / 64) & 63));
    store8(dst + 3, 128 + (cp & 63));
    return 4;
}

# Append one codepoint to a str_builder as UTF-8. Returns 0, or 0 - 1 if the
# codepoint is unencodable (in which case nothing is appended — the partial
# write would corrupt the stream).
#
# Byte-at-a-time through str_builder_add_byte, never str_builder_add_cstr:
# that helper is strlen-based and would truncate at the first NUL (G10), and
# U+0000 is a perfectly ordinary thing to find in a PDF string.
fn _pdfg_utf8_put(sb, cp): i64 {
    var tmp[8];
    var n = _pdfg_utf8_write(&tmp, cp);
    if (n == 0) { return 0 - 1; }
    var i = 0;
    while (i < n) {
        str_builder_add_byte(sb, load8(&tmp + i));
        i = i + 1;
    }
    return 0;
}

# Uppercase hex into `dst`, zero-padded to at least 4 digits, returning the
# digit count (4..6 for any valid codepoint). NOT fmt_hex_buf: that emits
# lowercase and no padding, and "U+65e5" is not how a codepoint is written.
fn _pdfg_hex4(dst, v): i64 {
    var tmp[8];
    var n = 0;
    var x = v;
    if (x < 0) { x = 0; }
    while (x > 0) {
        var d = x % 16;
        if (d < 10) { store8(&tmp + n, 48 + d); }
        else        { store8(&tmp + n, 55 + d); }
        n = n + 1;
        x = x / 16;
    }
    while (n < 4) { store8(&tmp + n, 48); n = n + 1; }   # pad, then reverse
    var i = 0;
    while (i < n) {
        store8(dst + i, load8(&tmp + (n - 1 - i)));
        i = i + 1;
    }
    return n;
}

# Set the last-error mirror to "codepoint U+<hex> has no WinAnsi encoding" with
# the real codepoint spliced in. Always returns 0 so call sites can chain it.
#
# The message is built into `a` because it names a value only known at runtime —
# a static cstring cannot say WHICH codepoint failed, and "unmappable codepoint"
# with no identity is exactly the kind of error that sends a caller hunting
# through a 40 KB document by hand. 64 bytes covers the longest possible form
# (12 + 6 digits + 24 + NUL = 43).
fn _pdfg_err_unmappable(a, cp, off): i64 {
    var msg = alloc_via(a, 64);
    if (msg == 0) {
        _pdf_err_msg = "codepoint has no WinAnsi encoding";
        _pdf_err_pos = off;
        return 0;
    }
    memcpy(msg, "codepoint U+", 12);
    var n = 12 + _pdfg_hex4(msg + 12, cp);
    memcpy(msg + n, " has no WinAnsi encoding", 24);
    n = n + 24;
    store8(msg + n, 0);
    _pdf_err_msg = msg;
    _pdf_err_pos = off;
    return 0;
}

# Byte count of the transcode stats block, for `var st[bayan_pdf_winansi_stats_size()];`.
#   +0  substituted   count of codepoints replaced by '?'
#   +8  first_bad_off byte offset of the first failure, or 0 - 1 when clean
fn bayan_pdf_winansi_stats_size(): i64 { return 16; }

# UTF-8 Str -> WinAnsi-encoded Str, allocating through `a`.
#
# `mode` is PDF_WINANSI_STRICT (an unrepresentable codepoint aborts the
# transcode: return 0, last-error names the codepoint and its byte offset) or
# PDF_WINANSI_SUBSTITUTE (emit '?' = 63, count it, and locate the first one).
# `stats` may be 0 if the caller does not want the counts.
#
# SIZING: WinAnsi is one byte per codepoint and UTF-8 is at least one byte per
# codepoint, so the output can never exceed the input length — one allocation,
# no growth loop, no builder. `n + 1` rather than `n` both leaves room for the
# NUL and dodges alloc(0) returning 0 on empty input (G15).
#
# MALFORMED UTF-8 is rejected in BOTH modes. SUBSTITUTE's contract covers
# codepoints the *encoding* cannot represent, not bytes that were never text;
# silently '?'-ing a broken sequence would turn a caller's memory bug into a
# document that looks fine, which is the house rule's whole objection.
fn bayan_pdf_winansi_a(a, src: Str, mode, stats): Str {
    if (stats != 0) {
        store64(stats, 0);
        store64(stats + 8, 0 - 1);
    }
    if (src == 0) { return 0; }
    var n = str_len(src);
    var p = str_data(src);
    var out = alloc_via(a, n + 1);
    if (out == 0) { return 0; }

    var dec[16];              # 16 BYTES = the 2 i64 slots _pdfg_utf8_next writes (G2)
    var i = 0;
    var w = 0;
    while (i < n) {
        if (_pdfg_utf8_next(p, n, i, &dec) == 0) {
            if (stats != 0) { store64(stats + 8, i); }
            _pdf_err_msg = "malformed UTF-8 in text to be WinAnsi-encoded";
            _pdf_err_pos = i;
            return 0;
        }
        var cp = load64(&dec);
        var b = _pdfg_cp_to_winansi(cp);
        if (b < 0) {
            if (mode == PDF_WINANSI_STRICT) {
                if (stats != 0) { store64(stats + 8, i); }
                _pdfg_err_unmappable(a, cp, i);
                return 0;
            }
            if (stats != 0) {
                if (load64(stats + 8) < 0) { store64(stats + 8, i); }
                store64(stats, load64(stats) + 1);
            }
            b = 63;                                     # '?'
        }
        store8(out + w, b);
        w = w + 1;
        i = i + load64(&dec + 8);                       # +8 is the length slot (G3)
    }
    store8(out + w, 0);
    return str_new_a(a, out, w);
}

# default_alloc() twin of bayan_pdf_winansi_a.
fn bayan_pdf_winansi(src: Str, mode, stats): Str {
    return bayan_pdf_winansi_a(default_alloc(), src, mode, stats);
}

# WinAnsi Str -> UTF-8 Str, allocating through `a`. The inverse direction, used
# by the reader's text extraction: page content bytes are WinAnsi and the
# extracted text is UTF-8.
#
# The five CP1252 codes with no character (0x81 0x8D 0x8F 0x90 0x9D) decode to
# U+FFFD REPLACEMENT CHARACTER rather than vanishing or aborting. A byte that
# reached a page's content stream is already in the file; refusing to extract
# the rest of the page over it would be a worse answer than marking it, and
# dropping it silently would shift every following character's meaning.
#
# SIZING: the largest codepoint WinAnsi can name is U+2122 and U+FFFD is also
# three bytes, so 3 bytes per input byte is an exact upper bound.
fn bayan_pdf_from_winansi_a(a, src: Str): Str {
    if (src == 0) { return 0; }
    var n = str_len(src);
    var p = str_data(src);
    var out = alloc_via(a, n * 3 + 1);
    if (out == 0) { return 0; }
    var i = 0;
    var w = 0;
    while (i < n) {
        var b = load8(p + i);
        var cp = _pdfg_winansi_to_cp(b);
        if (cp == 0 && b != 0) { cp = 65533; }          # U+FFFD, one of the five holes
        w = w + _pdfg_utf8_write(out + w, cp);
        i = i + 1;
    }
    store8(out + w, 0);
    return str_new_a(a, out, w);
}

# default_alloc() twin of bayan_pdf_from_winansi_a.
fn bayan_pdf_from_winansi(src: Str): Str {
    return bayan_pdf_from_winansi_a(default_alloc(), src);
}

# 1 if every codepoint in this UTF-8 Str has a WinAnsi byte, else 0. Lets a
# caller choose between transcoding and a UTF-16BE string object without
# provoking an error, and answers 0 for malformed UTF-8 too — "can this be
# WinAnsi-encoded" is no less false when the input was never text.
fn bayan_pdf_winansi_ok(src: Str): i64 {
    if (src == 0) { return 0; }
    var n = str_len(src);
    var p = str_data(src);
    var dec[16];
    var i = 0;
    while (i < n) {
        if (_pdfg_utf8_next(p, n, i, &dec) == 0) { return 0; }
        if (_pdfg_cp_to_winansi(load64(&dec)) < 0) { return 0; }
        i = i + load64(&dec + 8);
    }
    return 1;
}

# === _pdfo_ — the PdfObj object-cell model ===================================
#
# A PDF object is a 32-byte cell {tag@0, a@8, b@16, c@24} (_PDF_OBJ_SIZE). It
# reuses json.cyr's *grammar* — an `_a` twin per allocating constructor, a
# 0 - 1 tag sentinel, 0-on-failure accessors — and none of its *tree* (D1): PDF
# has name / stream / indirect-ref with no JSON analogue, and PTAG_STR is raw
# bytes where JTAG_STR is documented as decoded UTF-8.
#
#   tag          a                          b                       c
#   -----------------------------------------------------------------------
#   PTAG_NULL    0                          0                       0
#   PTAG_BOOL    0 | 1                       0                       0
#   PTAG_INT     exact i64 value            0                       0
#   PTAG_REAL    signed scaled integer      decimal places (0..9)   0
#   PTAG_NAME    Str*  decoded, no '/'      0                       0
#   PTAG_STR     Str*  raw decoded bytes    0=literal 1=<hex>       0
#   PTAG_ARR     vec*<PdfObj*>              0                       0
#   PTAG_DICT    vec*<PdfPair*>             0                       0
#   PTAG_STREAM  PdfObj* (its DICT cell)    Str* raw stored bytes   Str* decoded, or 0
#   PTAG_REF     object number              generation              0 (spare)
#
# PTAG_STREAM.c != 0 IS the decoded flag; there is no separate state word, so
# there is no second place for "have we decoded this yet" to drift out of sync.
#
# EVERY accessor here is reachable from parsed input, so every one of them is
# total: a 0 pointer, a wrong tag, or an out-of-range index yields 0 (or the
# empty Str) and NEVER aborts. That is not politeness — vec_get calls _vec_die
# and exit(1)s the whole process on an out-of-range index (lib/vec.cyr:78-84),
# so a missing bounds check here is a remote kill switch, not a wrong answer.

# PdfPair (16) — one dict entry, insertion-ordered.
#   +0 key  Str*      decoded name, no '/', #xx already resolved
#   +8 val  PdfObj*   may be a PTAG_REF

# Saturation ceiling for bayan_pdf_obj_num_mpt: 2^62. Bare literal, so it is
# statically initialised and immune to the global init-order hazard where a
# top-level initialiser reading a later global silently reads 0.
var _PDFO_MPT_SAT = 4611686018427387904;

# The shared empty Str handed back by every Str-valued accessor on a null or
# wrong-tagged cell. Returning the bare cstring "" would be a trap: callers run
# str_len() on the result, which loads from ptr + 8 — that is inside the string
# literal's own bytes, not a Str header, so the length comes back as junk. Built
# lazily so this module needs no init entry point of its own.
var _PDFO_NIL: i64[2];

# The canonical empty Str. Never 0 once alloc_init() has run.
fn _pdfo_empty_bytes(): Str {
    # STATIC storage, not a heap-cached Str. The previous form memoised
    # `str_from("")`, which allocates its 16-byte header through
    # default_alloc(); alloc_reset() then rewinds the bump allocator, leaving
    # the cached pointer dangling while still non-zero, so the guard did not
    # re-create it. Immediately after a reset the read is benign — alloc_reset
    # zeroes the reused span, giving {data 0, len 0} — but the very next
    # allocation lands on that exact address and writes over it, after which
    # this returns an arbitrary {data, len} pair to every accessor error path
    # in the module. A BSS slot cannot be recycled, and rewriting it costs two
    # stores against the one allocation it replaces.
    store64(&_PDFO_NIL,     "");
    store64(&_PDFO_NIL + 8, 0);
    return &_PDFO_NIL;
}

# Allocate a zeroed 32-byte cell with `tag` through `a`. 0 on OOM.
fn _pdfo_alloc_a(a, tag): i64 {
    var o = alloc_via(a, _PDF_OBJ_SIZE);
    if (o == 0) { return 0; }
    store64(o,      tag);
    store64(o + 8,  0);
    store64(o + 16, 0);
    store64(o + 24, 0);
    return o;
}

# Allocate a 16-byte PdfPair {key: Str*, val: PdfObj*} through `a`. 0 on OOM.
fn _pdfo_pair_new_a(a, key, val): i64 {
    var p = alloc_via(a, _PDF_PAIR_SIZE);
    if (p == 0) { return 0; }
    store64(p,     key);
    store64(p + 8, val);
    return p;
}

# Tag of a cell, or 0 - 1 for a null pointer. The internal twin of
# bayan_pdf_obj_tag, so internal call sites need no null dance of their own.
fn _pdfo_tag(o): i64 {
    if (o == 0) { return 0 - 1; }
    return load64(o);
}

# Payload slot a, or 0 for a null pointer.
fn _pdfo_a(o): i64 {
    if (o == 0) { return 0; }
    return load64(o + 8);
}

# Payload slot b, or 0 for a null pointer.
fn _pdfo_b(o): i64 {
    if (o == 0) { return 0; }
    return load64(o + 16);
}

# Payload slot c, or 0 for a null pointer.
fn _pdfo_c(o): i64 {
    if (o == 0) { return 0; }
    return load64(o + 24);
}

# Write payload slot c. The reader uses this to attach a stream's decoded bytes
# on first demand; writing c is what flips the cell to "decoded".
fn _pdfo_set_c(o, v): i64 {
    if (o == 0) { return 0; }
    store64(o + 24, v);
    return 0;
}

# The payload vec for an ARR (vec<PdfObj*>) or a DICT (vec<PdfPair*>), else 0.
# Both live in slot a, which is why one accessor serves both.
fn _pdfo_vec(o): i64 {
    if (o == 0) { return 0; }
    var t = load64(o);
    if (t == PTAG_ARR)  { return load64(o + 8); }
    if (t == PTAG_DICT) { return load64(o + 8); }
    return 0;
}

# Index of the pair in dict `d` whose key is the `klen` bytes at `key`, or
# 0 - 1. Linear byte compare, insertion order — a PDF dict big enough for the
# scan to matter does not occur in a page tree, and keeping insertion order is
# what makes the writer's output stable and the round-trip test meaningful.
#
# `key` is a raw byte pointer plus an explicit length, never a Str and never a
# cstring: dict keys come from #xx-decoded names and may contain any byte.
fn _pdfo_dict_find(d, key, klen): i64 {
    if (d == 0) { return 0 - 1; }
    if (load64(d) != PTAG_DICT) { return 0 - 1; }
    var pairs = load64(d + 8);
    if (pairs == 0) { return 0 - 1; }
    var n = vec_len(pairs);
    var i = 0;
    while (i < n) {
        var p = vec_get(pairs, i);
        if (p != 0) {
            var ks = load64(p);
            if (ks != 0) {
                if (load64(ks + 8) == klen) {
                    if (memeq(load64(ks), key, klen) == 1) { return i; }
                }
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# Binary-safe equality for two Str payloads, tolerating 0 on either side.
# str_eq would segfault on a 0 header, and these headers come from parsed input.
fn _pdfo_bytes_eq(sx, sy): i64 {
    if (sx == sy) { return 1; }
    if (sx == 0)  { return 0; }
    if (sy == 0)  { return 0; }
    var lx = load64(sx + 8);
    if (lx != load64(sy + 8)) { return 0; }
    return memeq(load64(sx), load64(sy), lx);
}

# Equality for two (scaled, places) reals, compared by VALUE rather than by
# token: 0.50 (50, 2) and 0.500 (500, 3) denote the same number and PDF draws no
# distinction between them. Trailing decimal zeros are stripped from each side
# first, which is exact integer work — no division by a power of ten that is not
# already known to divide evenly, and therefore no rounding question at all.
#
# `scaled % 10` on a negative scaled yields a negative remainder (Cyrius
# truncates toward zero on BOTH / and %), but the only test here is `== 0`, and
# -50 / 10 == -5 exactly, so the sign never needs splitting on this path.
fn _pdfo_real_eq(sx, px, sy, py): i64 {
    var ax = sx;
    var bx = px;
    var ay = sy;
    var by = py;
    while (bx > 0) {
        if (ax % 10 != 0) { break; }
        ax = ax / 10;
        bx = bx - 1;
    }
    while (by > 0) {
        if (ay % 10 != 0) { break; }
        ay = ay / 10;
        by = by - 1;
    }
    if (ax != ay) { return 0; }
    if (bx != by) { return 0; }
    return 1;
}

# Deep equality at a given nesting depth. Mutually recursive with _pdfo_eq_arr
# and _pdfo_eq_dict; every descent bumps `depth` and the cap is _PDF_MAX_DEPTH.
# Hitting the cap answers "not equal" — a conservative 0, never an abort and
# never an unbounded walk, because both sides may be attacker-shaped.
fn _pdfo_eq_d(x, y, depth): i64 {
    if (x == y) { return 1; }
    if (x == 0) { return 0; }
    if (y == 0) { return 0; }
    if (depth >= _PDF_MAX_DEPTH) { return 0; }
    var t = load64(x);
    if (t != load64(y)) { return 0; }
    if (t == PTAG_NULL) { return 1; }
    if (t == PTAG_BOOL) {
        if (load64(x + 8) == load64(y + 8)) { return 1; }
        return 0;
    }
    if (t == PTAG_INT) {
        if (load64(x + 8) == load64(y + 8)) { return 1; }
        return 0;
    }
    if (t == PTAG_REAL) {
        return _pdfo_real_eq(load64(x + 8), load64(x + 16),
          load64(y + 8), load64(y + 16));
    }
    if (t == PTAG_NAME) {
        return _pdfo_bytes_eq(load64(x + 8), load64(y + 8));
    }
    if (t == PTAG_STR) {
        # The hex flag is part of the cell, and the round-trip contract is that
        # serialise . parse is the identity — so <41> and (A) are NOT equal even
        # though they carry the same byte. bayan_pdf_obj_bytes is the comparison
        # to reach for when only the payload matters.
        if (load64(x + 16) != load64(y + 16)) { return 0; }
        return _pdfo_bytes_eq(load64(x + 8), load64(y + 8));
    }
    if (t == PTAG_ARR)  { return _pdfo_eq_arr(x, y, depth); }
    if (t == PTAG_DICT) { return _pdfo_eq_dict(x, y, depth); }
    if (t == PTAG_STREAM) {
        if (_pdfo_eq_d(load64(x + 8), load64(y + 8), depth + 1) == 0) { return 0; }
        # Decoded bytes when the cell has them, raw stored bytes otherwise —
        # comparing a decoded stream against an undecoded one on raw bytes would
        # answer "different" for two streams that are in fact the same payload.
        var px = load64(x + 24);
        if (px == 0) { px = load64(x + 16); }
        var py = load64(y + 24);
        if (py == 0) { py = load64(y + 16); }
        return _pdfo_bytes_eq(px, py);
    }
    if (t == PTAG_REF) {
        if (load64(x + 8)  != load64(y + 8))  { return 0; }
        if (load64(x + 16) != load64(y + 16)) { return 0; }
        return 1;
    }
    return 0;
}

# Elementwise array equality. Both indices stay below the shared length, so the
# vec_get calls are bounds-checked by construction.
fn _pdfo_eq_arr(x, y, depth): i64 {
    var vx = load64(x + 8);
    var vy = load64(y + 8);
    if (vx == 0) { if (vy == 0) { return 1; } return 0; }
    if (vy == 0) { return 0; }
    var n = vec_len(vx);
    if (n != vec_len(vy)) { return 0; }
    var i = 0;
    while (i < n) {
        if (_pdfo_eq_d(vec_get(vx, i), vec_get(vy, i), depth + 1) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Dict equality: same entry count, and every key of x present in y with an equal
# value. Compared by KEY, not by position — PDF 32000-1 §7.3.7 defines a
# dictionary as an unordered association, so /Type before /Subtype and the
# reverse are the same dictionary. Insertion order is still preserved by the
# cell itself, because the WRITER's output must be byte-stable.
fn _pdfo_eq_dict(x, y, depth): i64 {
    var vx = load64(x + 8);
    var vy = load64(y + 8);
    if (vx == 0) { if (vy == 0) { return 1; } return 0; }
    if (vy == 0) { return 0; }
    var n = vec_len(vx);
    if (n != vec_len(vy)) { return 0; }
    var i = 0;
    while (i < n) {
        var p = vec_get(vx, i);
        if (p == 0) { return 0; }
        var k = load64(p);
        if (k == 0) { return 0; }
        var j = _pdfo_dict_find(y, load64(k), load64(k + 8));
        if (j < 0) { return 0; }
        # j came from _pdfo_dict_find, which only ever returns an index it read
        # out of vy itself, so this vec_get is in range.
        var q = vec_get(vy, j);
        if (_pdfo_eq_d(load64(p + 8), load64(q + 8), depth + 1) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# === Object cells — constructors =============================================
#
# Every allocating constructor has an `_a` twin taking the Allocator first, with
# the bare form a one-line delegate to default_alloc() — json.cyr:301-303's
# grammar exactly. All of them return 0 on OOM; none of them abort.

# Allocator-first variant of bayan_pdf_obj_null.
fn bayan_pdf_obj_null_a(a): i64 { return _pdfo_alloc_a(a, PTAG_NULL); }

# Create the PDF `null` object.
fn bayan_pdf_obj_null(): i64 { return bayan_pdf_obj_null_a(default_alloc()); }

# Allocator-first variant of bayan_pdf_obj_bool_new.
fn bayan_pdf_obj_bool_new_a(a, b): i64 {
    var o = _pdfo_alloc_a(a, PTAG_BOOL);
    if (o == 0) { return 0; }
    if (b == 0) { store64(o + 8, 0); }
    else        { store64(o + 8, 1); }
    return o;
}

# Create a PDF boolean (`true` / `false`); any non-zero `b` is true.
fn bayan_pdf_obj_bool_new(b): i64 {
    return bayan_pdf_obj_bool_new_a(default_alloc(), b);
}

# Allocator-first variant of bayan_pdf_obj_int_new.
fn bayan_pdf_obj_int_new_a(a, v): i64 {
    var o = _pdfo_alloc_a(a, PTAG_INT);
    if (o == 0) { return 0; }
    store64(o + 8, v);
    return o;
}

# Create a PDF integer. Exact i64 — PDF integers have no fractional form, and
# an INT re-emits as `72`, never `72.0`.
fn bayan_pdf_obj_int_new(v): i64 {
    return bayan_pdf_obj_int_new_a(default_alloc(), v);
}

# Allocator-first variant of bayan_pdf_obj_real_new.
#
# A real is captured LOSSLESSLY as (scaled, places) with value =
# scaled / 10^places, so "0.50" is (50, 2) and the emitter is the literal
# inverse of the scanner (D3). There is no f64 anywhere on this path:
# bayan_f64_to_json emits exponent notation and the token `null`, both of which
# are invalid PDF number syntax and both of which compile clean.
#
# `places` outside 0..9 is rejected with 0 rather than clamped: 10^places must
# stay exactly representable, and a caller asking for 12 places has a bug that
# silently rounding would hide.
fn bayan_pdf_obj_real_new_a(a, scaled, places): i64 {
    if (places < 0) { return 0; }
    if (places > 9) { return 0; }
    var o = _pdfo_alloc_a(a, PTAG_REAL);
    if (o == 0) { return 0; }
    store64(o + 8,  scaled);
    store64(o + 16, places);
    return o;
}

# Create a PDF real with value scaled / 10^places; places must be 0..9.
fn bayan_pdf_obj_real_new(scaled, places): i64 {
    return bayan_pdf_obj_real_new_a(default_alloc(), scaled, places);
}

# Allocator-first variant of bayan_pdf_obj_name_new.
#
# `n` is the DECODED name — no leading '/', no #xx escapes. The writer applies
# #xx on the way out, so a name containing a space or a '#' round-trips.
#
# The `: cstring` annotation is load-bearing, not decoration: passing a Str here
# makes strlen walk the 16-byte Str header instead of the text, and the length
# comes back as junk (json.cyr:542-561 documents the measured case, "hello" -> 3).
fn bayan_pdf_obj_name_new_a(a, n: cstring): i64 {
    var o = _pdfo_alloc_a(a, PTAG_NAME);
    if (o == 0) { return 0; }
    var s = str_new_a(a, n, strlen(n));
    if (s == 0) { return 0; }
    store64(o + 8, s);
    return o;
}

# Create a PDF name from a decoded C string, e.g. "Catalog" for /Catalog.
fn bayan_pdf_obj_name_new(n: cstring): i64 {
    return bayan_pdf_obj_name_new_a(default_alloc(), n);
}

# Allocator-first variant of bayan_pdf_obj_string_new.
#
# `s` is RAW BYTES, not text: a PDF string is a byte string that may contain
# NUL and is not required to be valid UTF-8. It is taken as a Str precisely so
# no strlen ever touches it.
fn bayan_pdf_obj_string_new_a(a, s: Str): i64 {
    if (s == 0) { return 0; }
    var o = _pdfo_alloc_a(a, PTAG_STR);
    if (o == 0) { return 0; }
    store64(o + 8,  s);
    store64(o + 16, 0);       # source form: literal ( ... )
    return o;
}

# Create a PDF literal string `( ... )` from raw bytes.
fn bayan_pdf_obj_string_new(s: Str): i64 {
    return bayan_pdf_obj_string_new_a(default_alloc(), s);
}

# Allocator-first variant of bayan_pdf_obj_hex_new.
fn bayan_pdf_obj_hex_new_a(a, s: Str): i64 {
    if (s == 0) { return 0; }
    var o = _pdfo_alloc_a(a, PTAG_STR);
    if (o == 0) { return 0; }
    store64(o + 8,  s);
    store64(o + 16, 1);       # source form: <hex>
    return o;
}

# Create a PDF hex string `< ... >` from raw bytes. Same payload as a literal
# string; only the source form differs, which is what slot b records.
fn bayan_pdf_obj_hex_new(s: Str): i64 {
    return bayan_pdf_obj_hex_new_a(default_alloc(), s);
}

# Allocator-first variant of bayan_pdf_obj_array_new.
fn bayan_pdf_obj_array_new_a(a): i64 {
    var o = _pdfo_alloc_a(a, PTAG_ARR);
    if (o == 0) { return 0; }
    var v = vec_new_a(a);
    if (v == 0) { return 0; }
    store64(o + 8, v);
    return o;
}

# Create an empty PDF array `[ ]`.
fn bayan_pdf_obj_array_new(): i64 {
    return bayan_pdf_obj_array_new_a(default_alloc());
}

# Allocator-first variant of bayan_pdf_obj_dict_new.
fn bayan_pdf_obj_dict_new_a(a): i64 {
    var o = _pdfo_alloc_a(a, PTAG_DICT);
    if (o == 0) { return 0; }
    var v = vec_new_a(a);
    if (v == 0) { return 0; }
    store64(o + 8, v);
    return o;
}

# Create an empty PDF dictionary `<< >>`. Entries keep insertion order.
fn bayan_pdf_obj_dict_new(): i64 {
    return bayan_pdf_obj_dict_new_a(default_alloc());
}

# Allocator-first variant of bayan_pdf_obj_stream_new.
#
# `data` goes into slot c (DECODED); slot b (the raw bytes as they will sit on
# disk) stays 0 until emit time, when the filter chain runs and /Length is
# computed from the very Str that is then appended. One source, one layout (D9).
fn bayan_pdf_obj_stream_new_a(a, dict, data: Str): i64 {
    if (dict == 0) { return 0; }
    if (load64(dict) != PTAG_DICT) { return 0; }
    var o = _pdfo_alloc_a(a, PTAG_STREAM);
    if (o == 0) { return 0; }
    store64(o + 8,  dict);
    store64(o + 16, 0);
    store64(o + 24, data);
    return o;
}

# Create a PDF stream from its dictionary and its decoded payload bytes.
fn bayan_pdf_obj_stream_new(dict, data: Str): i64 {
    return bayan_pdf_obj_stream_new_a(default_alloc(), dict, data);
}

# Allocator-first variant of bayan_pdf_obj_ref_new.
fn bayan_pdf_obj_ref_new_a(a, num, gen): i64 {
    var o = _pdfo_alloc_a(a, PTAG_REF);
    if (o == 0) { return 0; }
    store64(o + 8,  num);
    store64(o + 16, gen);
    return o;
}

# Create an indirect reference `N G R`.
fn bayan_pdf_obj_ref_new(num, gen): i64 {
    return bayan_pdf_obj_ref_new_a(default_alloc(), num, gen);
}

# === Object cells — inspection ===============================================

# Tag of an object cell (PTAG_*), or 0 - 1 for a null pointer. The 0 - 1
# sentinel mirrors bayan_json_v_tag (json.cyr:442) so the two trees answer
# "not an object at all" the same way.
fn bayan_pdf_obj_tag(o): i64 {
    if (o == 0) { return 0 - 1; }
    return load64(o);
}

# 1 if `o` is a number — INT or REAL. Geometry readers want either.
fn bayan_pdf_obj_is_num(o): i64 {
    if (o == 0) { return 0; }
    var t = load64(o);
    if (t == PTAG_INT)  { return 1; }
    if (t == PTAG_REAL) { return 1; }
    return 0;
}

# 1 if `o` is a PTAG_NAME.
fn bayan_pdf_obj_is_name(o): i64 {
    if (o == 0) { return 0; }
    if (load64(o) == PTAG_NAME) { return 1; }
    return 0;
}

# 1 if `o` is a PTAG_STR (either source form).
fn bayan_pdf_obj_is_string(o): i64 {
    if (o == 0) { return 0; }
    if (load64(o) == PTAG_STR) { return 1; }
    return 0;
}

# 1 if `o` is a PTAG_ARR.
fn bayan_pdf_obj_is_array(o): i64 {
    if (o == 0) { return 0; }
    if (load64(o) == PTAG_ARR) { return 1; }
    return 0;
}

# 1 if `o` is a PTAG_DICT.
fn bayan_pdf_obj_is_dict(o): i64 {
    if (o == 0) { return 0; }
    if (load64(o) == PTAG_DICT) { return 1; }
    return 0;
}

# 1 if `o` is a PTAG_STREAM.
fn bayan_pdf_obj_is_stream(o): i64 {
    if (o == 0) { return 0; }
    if (load64(o) == PTAG_STREAM) { return 1; }
    return 0;
}

# 1 if `o` is a PTAG_REF (an unresolved `N G R`).
fn bayan_pdf_obj_is_ref(o): i64 {
    if (o == 0) { return 0; }
    if (load64(o) == PTAG_REF) { return 1; }
    return 0;
}

# Boolean payload (0 or 1); 0 on any other tag.
fn bayan_pdf_obj_bool_value(o): i64 {
    if (o == 0) { return 0; }
    if (load64(o) != PTAG_BOOL) { return 0; }
    return load64(o + 8);
}

# Integer value of a number: an INT exactly, a REAL truncated TOWARD ZERO,
# 0 on any other tag. Cyrius division truncates toward zero, which is also what
# PDF's own integer conversion does, so (-2500, 3) answers -2 and not -3.
fn bayan_pdf_obj_int_value(o): i64 {
    if (o == 0) { return 0; }
    var t = load64(o);
    if (t == PTAG_INT) { return load64(o + 8); }
    if (t == PTAG_REAL) {
        var p = _pdfe_pow10(load64(o + 16));
        if (p == 0) { return 0; }
        return load64(o + 8) / p;
    }
    return 0;
}

# The scaled integer of a REAL — 50 for the token "0.50". 0 on any other tag.
fn bayan_pdf_obj_real_scaled(o): i64 {
    if (o == 0) { return 0; }
    if (load64(o) != PTAG_REAL) { return 0; }
    return load64(o + 8);
}

# The decimal-place count of a REAL — 2 for the token "0.50". 0 on any other
# tag, which is also the honest answer for an INT: it has no fractional digits.
fn bayan_pdf_obj_real_places(o): i64 {
    if (o == 0) { return 0; }
    if (load64(o) != PTAG_REAL) { return 0; }
    return load64(o + 16);
}

# Any number as MILLI-POINTS, so a caller reading geometry never branches on the
# tag: an INT n answers n * 1000, a REAL is rescaled to 3 places. 0 on any other
# tag. 1 pt = 1000 mpt, and every geometric value in this API is mpt.
#
# The INT multiply SATURATES at +/- 2^62 rather than wrapping. A wrapped value
# would be a silently plausible coordinate — the exact silent-wrong-answer shape
# the module's loud-rejection rule exists to prevent — and object numbers and
# /MediaBox entries both come from untrusted files.
fn bayan_pdf_obj_num_mpt(o): i64 {
    if (o == 0) { return 0; }
    var t = load64(o);
    if (t == PTAG_INT) {
        var v = load64(o + 8);
        if (v > 4611686018427387)       { return _PDFO_MPT_SAT; }
        if (v < 0 - 4611686018427387)   { return 0 - _PDFO_MPT_SAT; }
        return v * 1000;
    }
    if (t == PTAG_REAL) {
        var s = load64(o + 8);
        var p = load64(o + 16);
        if (p > 3) {
            var d = _pdfe_pow10(p - 3);
            if (d == 0) { return 0; }
            return s / d;                      # truncates toward zero, both signs
        }
        var m = _pdfe_pow10(3 - p);
        if (m == 0) { return 0; }
        # Guard the multiply BEFORE it happens; there is no post-hoc overflow
        # flag to consult in an i64-everywhere language.
        if (s > 9223372036854775807 / m)         { return _PDFO_MPT_SAT; }
        if (s < (0 - 9223372036854775807) / m)   { return 0 - _PDFO_MPT_SAT; }
        return s * m;
    }
    return 0;
}

# The decoded name of a PTAG_NAME — no leading '/', #xx already resolved.
# The empty Str on any other tag; never 0, so str_len on the result is safe.
fn bayan_pdf_obj_name(o): Str {
    if (o == 0) { return _pdfo_empty_bytes(); }
    if (load64(o) != PTAG_NAME) { return _pdfo_empty_bytes(); }
    var s = load64(o + 8);
    if (s == 0) { return _pdfo_empty_bytes(); }
    return s;
}

# 1 if `o` is a name equal to `s`. The /Type /Catalog workhorse.
#
# `s` is a cstring — the same annotation that makes bayan_json_v_obj_get safe,
# and for the same reason. Names are ASCII identifiers in practice, so a
# NUL-terminated comparand costs nothing; the payload side is still compared
# with memeq over an explicit length, so a name containing NUL simply never
# matches instead of matching a prefix.
fn bayan_pdf_obj_name_eq(o, s: cstring): i64 {
    if (o == 0) { return 0; }
    if (load64(o) != PTAG_NAME) { return 0; }
    var ns = load64(o + 8);
    if (ns == 0) { return 0; }
    var n = strlen(s);
    if (load64(ns + 8) != n) { return 0; }
    return memeq(load64(ns), s, n);
}

# The raw decoded bytes of a PTAG_STR. BINARY, not UTF-8, and may contain NUL —
# hand it to str_builder_add, never to str_builder_add_cstr. The empty Str on
# any other tag.
fn bayan_pdf_obj_bytes(o): Str {
    if (o == 0) { return _pdfo_empty_bytes(); }
    if (load64(o) != PTAG_STR) { return _pdfo_empty_bytes(); }
    var s = load64(o + 8);
    if (s == 0) { return _pdfo_empty_bytes(); }
    return s;
}

# 1 if the source form of this string was <hex> rather than a literal ( ... ).
fn bayan_pdf_obj_is_hex(o): i64 {
    if (o == 0) { return 0; }
    if (load64(o) != PTAG_STR) { return 0; }
    if (load64(o + 16) == 1) { return 1; }
    return 0;
}

# Element count of an array, or 0 - 1 if `o` is not an array. The 0 - 1 makes
# "not an array" distinguishable from "an empty array", which a bare 0 cannot.
fn bayan_pdf_obj_array_len(o): i64 {
    if (o == 0) { return 0 - 1; }
    if (load64(o) != PTAG_ARR) { return 0 - 1; }
    var v = load64(o + 8);
    if (v == 0) { return 0 - 1; }
    return vec_len(v);
}

# Element `i` of an array, or 0 out of range / on a non-array. The bounds check
# is BEFORE the vec_get on purpose: vec_get exit(1)s the process on an
# out-of-range index, and `i` here routinely comes from a parsed /Kids index.
fn bayan_pdf_obj_array_get(o, i): i64 {
    if (o == 0) { return 0; }
    if (load64(o) != PTAG_ARR) { return 0; }
    var v = load64(o + 8);
    if (v == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= vec_len(v)) { return 0; }
    return vec_get(v, i);
}

# Entry count of a dictionary, or 0 - 1 if `o` is not a dictionary.
fn bayan_pdf_obj_dict_len(o): i64 {
    if (o == 0) { return 0 - 1; }
    if (load64(o) != PTAG_DICT) { return 0 - 1; }
    var v = load64(o + 8);
    if (v == 0) { return 0 - 1; }
    return vec_len(v);
}

# The i-th key of a dictionary, in insertion order. The empty Str out of range.
fn bayan_pdf_obj_dict_key(o, i): Str {
    if (o == 0) { return _pdfo_empty_bytes(); }
    if (load64(o) != PTAG_DICT) { return _pdfo_empty_bytes(); }
    var v = load64(o + 8);
    if (v == 0) { return _pdfo_empty_bytes(); }
    if (i < 0) { return _pdfo_empty_bytes(); }
    if (i >= vec_len(v)) { return _pdfo_empty_bytes(); }
    var p = vec_get(v, i);
    if (p == 0) { return _pdfo_empty_bytes(); }
    var k = load64(p);
    if (k == 0) { return _pdfo_empty_bytes(); }
    return k;
}

# The i-th value of a dictionary, in insertion order. May be a PTAG_REF — this
# accessor does NOT resolve indirect references. 0 out of range.
fn bayan_pdf_obj_dict_value(o, i): i64 {
    if (o == 0) { return 0; }
    if (load64(o) != PTAG_DICT) { return 0; }
    var v = load64(o + 8);
    if (v == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= vec_len(v)) { return 0; }
    var p = vec_get(v, i);
    if (p == 0) { return 0; }
    return load64(p + 8);
}

# Look up a dictionary entry by name. Returns the UNRESOLVED value (possibly a
# PTAG_REF), or 0 if the key is absent or `o` is not a dictionary.
#
# THE `: cstring` ANNOTATION IS THE MOST IMPORTANT ONE IN THIS MODULE.
# Cyrius is i64-everywhere, so passing a Str here compiles clean — and then
# strlen walks the 16-byte Str header, terminates on the data pointer's zero
# high bytes, and returns a junk length. The compare misses, this silently
# answers "not found", and the caller SIGSEGVs somewhere else entirely on
# str_len(0). That is json.cyr:542-561 and the bayan 1.4.1 CHANGELOG entry.
# Use bayan_pdf_obj_dict_get_by_str for the Str-typed spelling.
fn bayan_pdf_obj_dict_get(o, key: cstring): i64 {
    if (o == 0) { return 0; }
    if (load64(o) != PTAG_DICT) { return 0; }
    var i = _pdfo_dict_find(o, key, strlen(key));
    if (i < 0) { return 0; }
    return load64(vec_get(load64(o + 8), i) + 8);
}

# The Str-typed spelling of bayan_pdf_obj_dict_get, for keys that came out of
# the lexer rather than out of a literal.
#
# NOT named `..._dict_get_str`: a trailing `_str` is a reserved cyrius overload
# slot, and claiming it would make bayan_pdf_obj_dict_get("Type") silently route
# here instead. That is exactly the 1.3.0 breakage json.cyr:582-587 records.
fn bayan_pdf_obj_dict_get_by_str(o, key: Str): i64 {
    if (o == 0) { return 0; }
    if (key == 0) { return 0; }
    if (load64(o) != PTAG_DICT) { return 0; }
    var i = _pdfo_dict_find(o, load64(key), load64(key + 8));
    if (i < 0) { return 0; }
    return load64(vec_get(load64(o + 8), i) + 8);
}

# The dictionary of a stream, or 0 on any other tag.
fn bayan_pdf_obj_stream_dict(o): i64 {
    if (o == 0) { return 0; }
    if (load64(o) != PTAG_STREAM) { return 0; }
    return load64(o + 8);
}

# A stream's bytes exactly as stored on disk — STILL FILTERED. The empty Str
# when the cell has no stored form yet, which is the normal state of a stream
# the writer built and has not emitted.
fn bayan_pdf_obj_stream_raw(o): Str {
    if (o == 0) { return _pdfo_empty_bytes(); }
    if (load64(o) != PTAG_STREAM) { return _pdfo_empty_bytes(); }
    var s = load64(o + 16);
    if (s == 0) { return _pdfo_empty_bytes(); }
    return s;
}

# Object number of an indirect reference, or 0 - 1 if `o` is not a reference.
fn bayan_pdf_obj_ref_num(o): i64 {
    if (o == 0) { return 0 - 1; }
    if (load64(o) != PTAG_REF) { return 0 - 1; }
    return load64(o + 8);
}

# Generation number of an indirect reference, or 0 - 1 if `o` is not one.
fn bayan_pdf_obj_ref_gen(o): i64 {
    if (o == 0) { return 0 - 1; }
    if (load64(o) != PTAG_REF) { return 0 - 1; }
    return load64(o + 16);
}

# === Object cells — mutation =================================================

# Allocator-first variant of bayan_pdf_obj_array_push. 0 on success, 0 - 1 on a
# non-array target or a grow OOM. vec_push_a is used rather than vec_push
# because vec_push aborts the process on grow OOM (lib/vec.cyr:132-140).
fn bayan_pdf_obj_array_push_a(a, arr, v): i64 {
    if (arr == 0) { return 0 - 1; }
    if (load64(arr) != PTAG_ARR) { return 0 - 1; }
    var vv = load64(arr + 8);
    if (vv == 0) { return 0 - 1; }
    if (vec_push_a(a, vv, v) < 0) { return 0 - 1; }
    return 0;
}

# Append `v` to array `arr`. 0 on success, 0 - 1 on failure.
fn bayan_pdf_obj_array_push(arr, v): i64 {
    return bayan_pdf_obj_array_push_a(default_alloc(), arr, v);
}

# Allocator-first variant of bayan_pdf_obj_dict_set.
#
# An existing key is REPLACED IN PLACE so insertion order survives — the writer
# depends on that for byte-stable output, and a caller that overwrites /Length
# must not see the key jump to the end of the dictionary.
#
# `key: cstring` for the same reason as bayan_pdf_obj_dict_get; the bytes are
# copied into a Str header that borrows them, matching str_from's semantics, so
# a caller passing a buffer it later mutates must clone first.
fn bayan_pdf_obj_dict_set_a(a, d, key: cstring, v): i64 {
    if (d == 0) { return 0 - 1; }
    if (load64(d) != PTAG_DICT) { return 0 - 1; }
    var pairs = load64(d + 8);
    if (pairs == 0) { return 0 - 1; }
    var klen = strlen(key);
    var i = _pdfo_dict_find(d, key, klen);
    if (i >= 0) {
        store64(vec_get(pairs, i) + 8, v);
        return 0;
    }
    var ks = str_new_a(a, key, klen);
    if (ks == 0) { return 0 - 1; }
    var p = _pdfo_pair_new_a(a, ks, v);
    if (p == 0) { return 0 - 1; }
    if (vec_push_a(a, pairs, p) < 0) { return 0 - 1; }
    return 0;
}

# Set `key` to `v` in dictionary `d`. 0 on success, 0 - 1 on failure.
fn bayan_pdf_obj_dict_set(d, key: cstring, v): i64 {
    return bayan_pdf_obj_dict_set_a(default_alloc(), d, key, v);
}

# Deep structural equality, depth-capped by _PDF_MAX_DEPTH.
#
# REALs compare by value (0.50 == 0.500), dictionaries compare by key rather
# than by position, REFs compare by (num, gen) without resolving, and STREAMs
# compare by dictionary plus payload bytes. Strings additionally compare their
# source form, because the round-trip contract is that serialise . parse is the
# identity — this is the predicate that assertion is written against.
fn bayan_pdf_obj_eq(x, y): i64 {
    return _pdfo_eq_d(x, y, 0);
}

# === _pdfz_ — stream filters ================================================
#
# The decode chain a PDF stream goes through between the raw bytes stored in
# the file and the bytes a consumer sees: /Filter (possibly an array of them,
# applied left to right) and then /DecodeParms's predictor.
#
# Everything here operates on raw (ptr, len) spans and hands back a `Str`.
# Nothing in this section touches an object cell or the cross-reference — the
# caller pulls /Filter and /DecodeParms out of the dict and passes plain
# integers down. That keeps the filters testable in isolation and keeps the
# dictionary walk in one place instead of two.
#
# ERROR POSITIONS. A filter failure is located by an offset into the ENCODED
# STREAM, not into the file: the decoder never learns where the stream started.
# The caller (which does know) is free to record a file offset of its own; the
# message text always names the filter so the two are never confused. Where no
# position is meaningful at all — a missing hook, an exceeded budget — the
# position is 0 - 1, matching PdfState's clean sentinel.
#
# ALLOCATION. Every decoder writes into ONE buffer sized by an exact up-front
# bound (ASCIIHex, ASCII85, the predictors) or by a cheap validating pre-pass
# (RunLength), never into a str_builder. str_builder_putc has no allocator-
# threaded twin, so a builder here would silently escape the caller's `a` and
# land in default_alloc(); and str_builder_add_cstr is strlen-based, so it
# truncates payload bytes at the first NUL (G10) — a decoded stream contains
# NULs with near-certainty. Direct alloc_via sidesteps both.

# Filter identities. 0 is deliberately "no filter", so a caller may test a
# filter slot for truth; 0 - 1 is "a /Filter name this build does not know".
# The rejected codecs each get their OWN id rather than sharing one, so the
# refusal can name the filter the file actually asked for.
var _PDFZ_F_NONE  = 0;
var _PDFZ_F_FLATE = 1;
var _PDFZ_F_AHX   = 2;
var _PDFZ_F_A85   = 3;
var _PDFZ_F_RL    = 4;
var _PDFZ_F_LZW   = 5;
var _PDFZ_F_DCT   = 6;
var _PDFZ_F_JPX   = 7;
var _PDFZ_F_CCITT = 8;
var _PDFZ_F_JBIG2 = 9;
var _PDFZ_F_CRYPT = 10;

# The largest ASCII85 group value, 2^32 - 1. A five-character group encoding
# anything above this is malformed; i64 holds 85^5 - 1 = 4437053124 with room
# to spare, so the check happens after the accumulate, not during it.
var _PDFZ_A85_MAX = 4294967295;

# --- error channel ----------------------------------------------------------

# Record a filter failure. `doc` is an opaque PdfDoc handle here — this section
# never calls into the document or xref subsystems, so the doc's own error
# slots are written through the frozen layout (err_msg +128, err_pos +136,
# err_count +144) behind a PDF_MAGIC guard. First-error-wins, matching
# _pdfe_err, but err_count is bumped for every failure so a doc that limped
# through with per-object errors can still report how many.
#
# With doc == 0 — a standalone decode, or a unit test — the failure lands in
# the globals-compat mirror instead, so bayan_pdf_last_error() still answers.
#
# Always returns 0 so a call site can read `_pdfz_err(...); return 0;`.
fn _pdfz_err(doc, msg: cstring, pos): i64 {
    if (doc == 0) {
        _pdf_err_msg = msg;
        _pdf_err_pos = pos;
        return 0;
    }
    if (load64(doc) != PDF_MAGIC) { return 0; }
    if (load64(doc + 128) == 0) {
        store64(doc + 128, msg);
        store64(doc + 136, pos);
    }
    store64(doc + 144, load64(doc + 144) + 1);
    return 0;
}

# --- the decompression budget ----------------------------------------------
#
# _PDF_MAX_INFLATE caps ONE stream; a zip bomb spreads itself over a thousand
# small streams instead, so the real guard is the per-document total. The
# running total is kept in a fixed side table keyed on the doc pointer rather
# than in a PdfDoc slot: this section is written against the doc layout only
# for the three error fields above, and claiming a fourth slot would couple the
# filters to the document struct for a counter nothing else reads.
#
# 16 entries of {doc, total}, 16 bytes each. A 17th live document evicts the
# oldest — an evicted doc restarts its accounting, which is a weakening of the
# guard and not a hole in it: _PDF_MAX_INFLATE still bounds every single
# stream, and 16 concurrently-parsing documents is not a shape this API has.
# The table is static storage, so it survives alloc_reset() intact; a doc
# pointer recycled by the allocator inherits the old total, which fails toward
# rejection rather than toward admitting a bomb.
var _pdfz_bud[256];
var _pdfz_bud_used = 0;
var _pdfz_bud_next = 0;

# Slot index for `doc`, or 0 - 1 when it has none yet.
fn _pdfz_budget_slot(doc): i64 {
    var i = 0;
    while (i < _pdfz_bud_used) {
        if (load64(&_pdfz_bud + i * 16) == doc) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Bytes already decompressed for `doc`; 0 for an untracked doc.
fn _pdfz_budget_total(doc): i64 {
    var i = _pdfz_budget_slot(doc);
    if (i < 0) { return 0; }
    return load64(&_pdfz_bud + i * 16 + 8);
}

# Set the running total for `doc`, claiming or evicting a slot as needed.
fn _pdfz_budget_store(doc, total): i64 {
    var i = _pdfz_budget_slot(doc);
    if (i < 0) {
        if (_pdfz_bud_used < 16) {
            i = _pdfz_bud_used;
            _pdfz_bud_used = _pdfz_bud_used + 1;
        } else {
            i = _pdfz_bud_next;
            _pdfz_bud_next = (_pdfz_bud_next + 1) % 16;
        }
    }
    # &TABLE + i is a BYTE offset in Cyrius, so a 16-byte entry strides by
    # i * 16 — never by i alone and never by i * 8 (G3).
    store64(&_pdfz_bud + i * 16, doc);
    store64(&_pdfz_bud + i * 16 + 8, total);
    return 0;
}

# Forget `doc`'s accounting. A document constructor may call this so a recycled
# handle starts from zero rather than inheriting a dead doc's total.
fn _pdfz_budget_reset(doc): i64 {
    var i = _pdfz_budget_slot(doc);
    if (i < 0) { return 0; }
    store64(&_pdfz_bud + i * 16, 0);
    store64(&_pdfz_bud + i * 16 + 8, 0);
    return 0;
}

# Charge `n` decoded bytes against `doc`'s budget. Returns 1 if allowed, 0 if
# the document has now asked for more than _PDF_MAX_INFTOT in total (with the
# refusal recorded). doc == 0 means "no document to account against" and is a
# no-op that always allows — a standalone decode is still bounded per stream.
fn _pdfz_budget(doc, n): i64 {
    if (doc == 0) { return 1; }
    if (n <= 0)   { return 1; }
    var tot = _pdfz_budget_total(doc);
    # Subtract instead of adding: tot <= _PDF_MAX_INFTOT holds by induction, so
    # the right-hand side cannot go negative and the sum never happens.
    if (n > _PDF_MAX_INFTOT - tot) {
        _pdfz_err(doc, "decoded stream bytes exceed the per-document limit", 0 - 1);
        return 0;
    }
    _pdfz_budget_store(doc, tot + n);
    return 1;
}

# --- filter names -----------------------------------------------------------

# Exact-length byte compare against a literal. memeq, never strcmp: a /Filter
# name arrives as a decoded Str whose data pointer is not NUL-terminated in
# the general case, and handing a Str to strlen walks the 16-byte header and
# returns junk (G1).
fn _pdfz_name_is(p, n, kw: cstring, klen): i64 {
    if (n != klen) { return 0; }
    return memeq(p, kw, klen);
}

# Map a /Filter name (decoded, without the leading '/') to a _PDFZ_F_* id.
# PDF 32000-1 §7.4.1 defines a one-to-three-letter abbreviation for each of the
# four filters used in inline images; those abbreviations are legal in a normal
# stream dict too, and a reader that only knows the long spellings silently
# treats `/Fl` as an unknown filter. Returns 0 - 1 for anything unrecognised.
fn _pdfz_filter_id(name: Str): i64 {
    if (name == 0) { return 0 - 1; }
    var p = str_data(name);
    var n = str_len(name);
    if (n <= 0) { return 0 - 1; }

    if (_pdfz_name_is(p, n, "FlateDecode", 11) == 1)     { return _PDFZ_F_FLATE; }
    if (_pdfz_name_is(p, n, "Fl", 2) == 1)               { return _PDFZ_F_FLATE; }
    if (_pdfz_name_is(p, n, "ASCIIHexDecode", 14) == 1)  { return _PDFZ_F_AHX; }
    if (_pdfz_name_is(p, n, "AHx", 3) == 1)              { return _PDFZ_F_AHX; }
    if (_pdfz_name_is(p, n, "ASCII85Decode", 13) == 1)   { return _PDFZ_F_A85; }
    if (_pdfz_name_is(p, n, "A85", 3) == 1)              { return _PDFZ_F_A85; }
    if (_pdfz_name_is(p, n, "RunLengthDecode", 15) == 1) { return _PDFZ_F_RL; }
    if (_pdfz_name_is(p, n, "RL", 2) == 1)               { return _PDFZ_F_RL; }

    # Known but not implemented. Each keeps its own id so the rejection can
    # name the filter — "unsupported filter" without the name is the kind of
    # message that costs a user an afternoon.
    if (_pdfz_name_is(p, n, "LZWDecode", 9) == 1)        { return _PDFZ_F_LZW; }
    if (_pdfz_name_is(p, n, "LZW", 3) == 1)              { return _PDFZ_F_LZW; }
    if (_pdfz_name_is(p, n, "DCTDecode", 9) == 1)        { return _PDFZ_F_DCT; }
    if (_pdfz_name_is(p, n, "DCT", 3) == 1)              { return _PDFZ_F_DCT; }
    if (_pdfz_name_is(p, n, "JPXDecode", 9) == 1)        { return _PDFZ_F_JPX; }
    if (_pdfz_name_is(p, n, "CCITTFaxDecode", 14) == 1)  { return _PDFZ_F_CCITT; }
    if (_pdfz_name_is(p, n, "CCF", 3) == 1)              { return _PDFZ_F_CCITT; }
    if (_pdfz_name_is(p, n, "JBIG2Decode", 11) == 1)     { return _PDFZ_F_JBIG2; }
    if (_pdfz_name_is(p, n, "Crypt", 5) == 1)            { return _PDFZ_F_CRYPT; }

    return 0 - 1;
}

# The canonical spelling of a filter id, for error messages. "?" for 0 - 1.
fn _pdfz_filter_label(id): i64 {
    if (id == _PDFZ_F_FLATE) { return "FlateDecode"; }
    if (id == _PDFZ_F_AHX)   { return "ASCIIHexDecode"; }
    if (id == _PDFZ_F_A85)   { return "ASCII85Decode"; }
    if (id == _PDFZ_F_RL)    { return "RunLengthDecode"; }
    if (id == _PDFZ_F_LZW)   { return "LZWDecode"; }
    if (id == _PDFZ_F_DCT)   { return "DCTDecode"; }
    if (id == _PDFZ_F_JPX)   { return "JPXDecode"; }
    if (id == _PDFZ_F_CCITT) { return "CCITTFaxDecode"; }
    if (id == _PDFZ_F_JBIG2) { return "JBIG2Decode"; }
    if (id == _PDFZ_F_CRYPT) { return "Crypt"; }
    if (id == _PDFZ_F_NONE)  { return "none"; }
    return "?";
}

# 1 if this build can actually decode `id`.
fn _pdfz_filter_supported(id): i64 {
    if (id == _PDFZ_F_FLATE) { return 1; }
    if (id == _PDFZ_F_AHX)   { return 1; }
    if (id == _PDFZ_F_A85)   { return 1; }
    if (id == _PDFZ_F_RL)    { return 1; }
    return 0;
}

# 1 if `id` is an image codec — a stream ending in one of these holds pixel
# data this module never decodes, which is a different answer from "broken".
fn _pdfz_filter_is_image(id): i64 {
    if (id == _PDFZ_F_DCT)   { return 1; }
    if (id == _PDFZ_F_JPX)   { return 1; }
    if (id == _PDFZ_F_CCITT) { return 1; }
    if (id == _PDFZ_F_JBIG2) { return 1; }
    return 0;
}

# --- Flate, through the installed hook --------------------------------------

# Inflate (src, len) via the hook installed by bayan_pdf_set_inflate.
#
# The hook signature is fn(src, src_len, dst, dst_cap) -> bytes written, or a
# negative error, and it demands a PRE-SIZED destination — zlib's streaming
# interface is not reachable through four i64 arguments. So the size is a
# guess that grows: `hint` (a /DL or /Length1 value the caller found) when
# there is one, otherwise 4x the compressed length floored at 4096.
#
# Three results are retried rather than trusted:
#   n == 0 - 2   the documented "destination too small" code (sankoch's
#                ERR_BUFFER_TOO_SMALL) — grow and go again
#   n == cap     ambiguous: a hook returning exactly cap may have fitted
#                exactly or may have truncated, and there is no way to tell
#                from the outside, so it is treated as truncation
# Every OTHER negative n is a hard failure. It is emphatically NOT "zero bytes
# decoded": sankoch reports errors as 0 - ERR_*, so a `if (n <= 0) return
# empty` reading turns a corrupt stream into a silently empty page.
#
# Returns 0 (never a partial buffer) on any failure, with the reason recorded.
fn _pdfz_inflate_a(a, doc, src, len, hint): Str {
    if (_pdf_inflate_fp == 0) {
        _pdfz_err(doc,
          "FlateDecode stream but no inflate hook is installed (call bayan_pdf_set_inflate)",
          0 - 1);
        return 0;
    }
    if (src == 0) {
        _pdfz_err(doc, "FlateDecode: null source buffer", 0 - 1);
        return 0;
    }
    if (len < 0) {
        _pdfz_err(doc, "FlateDecode: negative source length", 0 - 1);
        return 0;
    }
    if (len == 0) { return str_from_a(a, ""); }

    var cap = 0;
    if (hint > 0) {
        cap = hint;
    } else {
        # Guard the multiply BEFORE it happens — `len` comes from a /Length in
        # an untrusted file and 4 * len is a reachable overflow.
        if (len > _PDF_MAX_INFLATE / 4) { cap = _PDF_MAX_INFLATE; }
        else { cap = len * 4; }
        if (cap < 4096) { cap = 4096; }
    }
    if (cap < 64) { cap = 64; }
    if (cap > _PDF_MAX_INFLATE) { cap = _PDF_MAX_INFLATE; }

    # 32 doublings from 64 bytes overshoots _PDF_MAX_INFLATE by orders of
    # magnitude, so the counter is a liveness backstop against a hook that
    # answers "too small" forever, not a real bound on the size search.
    var iter = 0;
    while (iter < 32) {
        # +1 for the NUL str_builder_build_a would have written; callers that
        # hand the decoded bytes to a cstring-shaped API get a terminator, and
        # the length is still authoritative for binary payloads.
        var dst = alloc_via(a, cap + 1);
        if (dst == 0) {
            _pdfz_err(doc, "FlateDecode: out of memory sizing the output buffer", 0 - 1);
            return 0;
        }
        # fncall4, never callptr — callptr is a hard compile error on one
        # backend (G13). No f64 crosses this boundary; nothing here is a float.
        var n = fncall4(_pdf_inflate_fp, src, len, dst, cap);
        if (n > cap) {
            _pdfz_err(doc,
              "FlateDecode: the inflate hook reported more bytes than the buffer holds",
              0 - 1);
            return 0;
        }
        if (n >= 0) {
            if (n < cap) {
                if (_pdfz_budget(doc, n) == 0) { return 0; }
                store8(dst + n, 0);
                return str_new_a(a, dst, n);
            }
        } elif (n != 0 - 2) {
            _pdfz_err(doc, "FlateDecode failed (the inflate hook reported an error)", 0 - 1);
            return 0;
        }
        if (cap >= _PDF_MAX_INFLATE) {
            _pdfz_err(doc, "FlateDecode output exceeds the per-stream inflate limit", 0 - 1);
            return 0;
        }
        cap = cap * 2;
        if (cap > _PDF_MAX_INFLATE) { cap = _PDF_MAX_INFLATE; }
        iter = iter + 1;
    }
    _pdfz_err(doc, "FlateDecode: the inflate hook never accepted an output buffer", 0 - 1);
    return 0;
}

# Deflate (src, len) via the hook installed by bayan_pdf_set_deflate — the
# writer's side of the same contract. Callers check bayan_pdf_has_deflate()
# first and fall back to an uncompressed stream, which is still valid PDF; the
# loud error here is for the case where compression was explicitly requested.
#
# The starting size is len + len/8 + 1024. zlib's stored-block worst case adds
# five bytes per 65535-byte block plus a header, so len/8 is generous by two
# orders of magnitude and the retry loop covers the rest.
fn _pdfz_deflate_a(a, doc, src, len): Str {
    if (_pdf_deflate_fp == 0) {
        _pdfz_err(doc,
          "compression requested but no deflate hook is installed (call bayan_pdf_set_deflate)",
          0 - 1);
        return 0;
    }
    if (src == 0) {
        _pdfz_err(doc, "deflate: null source buffer", 0 - 1);
        return 0;
    }
    if (len < 0) {
        _pdfz_err(doc, "deflate: negative source length", 0 - 1);
        return 0;
    }
    if (len > _PDF_MAX_INFLATE) {
        _pdfz_err(doc, "deflate: input exceeds the per-stream limit", 0 - 1);
        return 0;
    }

    var cap = len + len / 8 + 1024;
    if (cap > _PDF_MAX_INFLATE) { cap = _PDF_MAX_INFLATE; }

    var iter = 0;
    while (iter < 32) {
        var dst = alloc_via(a, cap + 1);
        if (dst == 0) {
            _pdfz_err(doc, "deflate: out of memory sizing the output buffer", 0 - 1);
            return 0;
        }
        var n = fncall4(_pdf_deflate_fp, src, len, dst, cap);
        if (n > cap) {
            _pdfz_err(doc, "deflate: the hook reported more bytes than the buffer holds", 0 - 1);
            return 0;
        }
        if (n >= 0) {
            if (n < cap) {
                store8(dst + n, 0);
                return str_new_a(a, dst, n);
            }
        } elif (n != 0 - 2) {
            _pdfz_err(doc, "deflate failed (the compression hook reported an error)", 0 - 1);
            return 0;
        }
        if (cap >= _PDF_MAX_INFLATE) {
            _pdfz_err(doc, "deflate output exceeds the per-stream limit", 0 - 1);
            return 0;
        }
        cap = cap * 2;
        if (cap > _PDF_MAX_INFLATE) { cap = _PDF_MAX_INFLATE; }
        iter = iter + 1;
    }
    _pdfz_err(doc, "deflate: the compression hook never accepted an output buffer", 0 - 1);
    return 0;
}

# --- ASCIIHexDecode ---------------------------------------------------------

# Hex pairs, whitespace ignored, '>' ends the data. PDF 32000-1 §7.4.2: an odd
# final nibble is completed with a '0', so "48656C6C6F7" would decode as if it
# read "...70". That is a SPEC-MANDATED completion, not a recovery from
# malformed input — anything that is neither a hex digit, whitespace, nor '>'
# is rejected with its offset.
fn _pdfz_ahx_a(a, doc, src, len): Str {
    var n = len;
    if (n < 0) { n = 0; }
    if (src == 0) { n = 0; }
    # Output is at most ceil(n/2) bytes, so n/2 + 1 always fits; + 1 more for
    # the NUL. Never alloc(0) — alloc returns 0 for a zero request (G15) and
    # that would read as OOM.
    var out = alloc_via(a, n / 2 + 2);
    if (out == 0) {
        _pdfz_err(doc, "ASCIIHexDecode: out of memory", 0 - 1);
        return 0;
    }

    var i = 0;
    var nout = 0;
    var hi = 0 - 1;                 # the pending high nibble, or 0 - 1 for none
    while (i < n) {
        var c = load8(src + i);
        i = i + 1;
        if (c == 62) { break; }     # '>' — end of data
        if (_pdfe_is_ws(c) == 1) {
            hi = hi;                # whitespace is ignored, even mid-pair
        } else {
            var v = _pdfe_hexval(c);
            if (v < 0) {
                _pdfz_err(doc, "ASCIIHexDecode: byte is not a hex digit", i - 1);
                return 0;
            }
            if (hi < 0) {
                hi = v;
            } else {
                store8(out + nout, hi * 16 + v);
                nout = nout + 1;
                hi = 0 - 1;
            }
        }
    }
    if (hi >= 0) {
        # The trailing odd nibble, completed with '0' per §7.4.2.
        store8(out + nout, hi * 16);
        nout = nout + 1;
    }
    store8(out + nout, 0);
    return str_new_a(a, out, nout);
}

# --- ASCII85Decode ----------------------------------------------------------

# Base-85, five characters to four bytes, '!'..'u'. 'z' abbreviates a group of
# four zero bytes and is only legal where a group starts. A leading "<~" is
# accepted (Adobe writes it in inline images), "~>" ends the data, and the
# final group may be short — k characters yield k-1 bytes after padding with
# 'u'. A final group of exactly one character encodes nothing and is malformed.
fn _pdfz_a85_a(a, doc, src, len): Str {
    var n = len;
    if (n < 0) { n = 0; }
    if (src == 0) { n = 0; }
    # 'z' is the expanding case: one input byte becomes four output bytes, so
    # the bound is 4n, not 4n/5. Guard the multiply before it happens.
    if (n > _PDF_MAX_INFLATE / 4) {
        _pdfz_err(doc, "ASCII85Decode: input exceeds the per-stream limit", 0 - 1);
        return 0;
    }
    var out = alloc_via(a, n * 4 + 8);
    if (out == 0) {
        _pdfz_err(doc, "ASCII85Decode: out of memory", 0 - 1);
        return 0;
    }

    var i = 0;
    # Skip leading whitespace so the optional "<~" is still recognised after it.
    while (i < n) {
        if (_pdfe_is_ws(load8(src + i)) == 1) { i = i + 1; } else { break; }
    }
    if (i + 2 <= n) {
        if (load8(src + i) == 60) {
            if (load8(src + i + 1) == 126) { i = i + 2; }
        }
    }

    var nout = 0;
    var grp = 0;
    var k = 0;
    var eod = 0;
    while (i < n) {
        var c = load8(src + i);
        i = i + 1;
        if (c == 126) { eod = 1; break; }          # '~' opens "~>"
        if (_pdfe_is_ws(c) == 1) {
            k = k;                                  # whitespace is ignored
        } elif (c == 122) {                         # 'z'
            if (k != 0) {
                _pdfz_err(doc, "ASCII85Decode: 'z' inside a group", i - 1);
                return 0;
            }
            store8(out + nout,     0);
            store8(out + nout + 1, 0);
            store8(out + nout + 2, 0);
            store8(out + nout + 3, 0);
            nout = nout + 4;
        } elif (c < 33) {
            _pdfz_err(doc, "ASCII85Decode: byte is outside the '!'..'u' alphabet", i - 1);
            return 0;
        } elif (c > 117) {
            _pdfz_err(doc, "ASCII85Decode: byte is outside the '!'..'u' alphabet", i - 1);
            return 0;
        } else {
            # 85^5 - 1 is 4437053124 — an i64 holds a full group with nine
            # decimal digits to spare, so the range check happens on the
            # finished group rather than on every accumulate.
            grp = grp * 85 + (c - 33);
            k = k + 1;
            if (k == 5) {
                if (grp > _PDFZ_A85_MAX) {
                    _pdfz_err(doc, "ASCII85Decode: group does not fit in 32 bits", i - 1);
                    return 0;
                }
                # grp is non-negative here, so the LOGICAL `>>` is the right
                # shift; `>>>` is the arithmetic one in Cyrius (G12).
                store8(out + nout,     (grp >> 24) & 255);
                store8(out + nout + 1, (grp >> 16) & 255);
                store8(out + nout + 2, (grp >> 8)  & 255);
                store8(out + nout + 3, grp & 255);
                nout = nout + 4;
                grp = 0;
                k = 0;
            }
        }
    }

    if (k == 1) {
        _pdfz_err(doc, "ASCII85Decode: final group of one character encodes nothing", i);
        return 0;
    }
    if (k > 1) {
        var pad = k;
        while (pad < 5) { grp = grp * 85 + 84; pad = pad + 1; }   # 'u' - '!' == 84
        if (grp > _PDFZ_A85_MAX) {
            _pdfz_err(doc, "ASCII85Decode: final group does not fit in 32 bits", i);
            return 0;
        }
        var sh = 24;
        var emit = 0;
        while (emit < k - 1) {
            store8(out + nout, (grp >> sh) & 255);
            nout = nout + 1;
            sh = sh - 8;
            emit = emit + 1;
        }
    }
    if (eod == 1) {
        # "~" must be followed by ">" when anything follows it at all. A stream
        # that simply ends after the "~" is accepted: the data is complete and
        # the missing byte carries no information.
        if (i < n) {
            if (load8(src + i) != 62) {
                _pdfz_err(doc, "ASCII85Decode: '~' not followed by '>'", i);
                return 0;
            }
        }
    }
    store8(out + nout, 0);
    return str_new_a(a, out, nout);
}

# --- RunLengthDecode --------------------------------------------------------

# PDF 32000-1 §7.4.5. A length byte L:
#   L <  128   the next L + 1 bytes are literal
#   L >  128   the next byte repeats 257 - L times (2..128)
#   L == 128   end of data
#
# Two passes over the same grammar: the first measures and validates, the
# second fills a buffer sized exactly. That is cheaper than a growing builder
# and, more to the point, it lets a run that would blow the limit be refused
# BEFORE anything is allocated for it.

# Decoded length of a RunLength stream, or 0 - 1 with the reason recorded.
fn _pdfz_rl_len(doc, src, len): i64 {
    var total = 0;
    var i = 0;
    while (i < len) {
        var c = load8(src + i);
        i = i + 1;
        if (c == 128) { break; }
        if (c < 128) {
            if (i + c + 1 > len) {
                _pdfz_err(doc, "RunLengthDecode: literal run runs past the end of the stream", i - 1);
                return 0 - 1;
            }
            total = total + c + 1;
            i = i + c + 1;
        } else {
            if (i >= len) {
                _pdfz_err(doc, "RunLengthDecode: repeat run is missing its data byte", i - 1);
                return 0 - 1;
            }
            total = total + (257 - c);
            i = i + 1;
        }
        if (total > _PDF_MAX_INFLATE) {
            _pdfz_err(doc, "RunLengthDecode output exceeds the per-stream limit", i - 1);
            return 0 - 1;
        }
    }
    return total;
}

# Decode a RunLength stream. Returns 0 on any failure.
fn _pdfz_rl_a(a, doc, src, len): Str {
    var n = len;
    if (n < 0) { n = 0; }
    if (src == 0) { n = 0; }

    var total = _pdfz_rl_len(doc, src, n);
    if (total < 0) { return 0; }
    if (_pdfz_budget(doc, total) == 0) { return 0; }

    var out = alloc_via(a, total + 1);      # total may be 0; + 1 keeps it non-zero
    if (out == 0) {
        _pdfz_err(doc, "RunLengthDecode: out of memory", 0 - 1);
        return 0;
    }

    var i = 0;
    var w = 0;
    while (i < n) {
        var c = load8(src + i);
        i = i + 1;
        if (c == 128) { break; }
        if (c < 128) {
            memcpy(out + w, src + i, c + 1);
            w = w + c + 1;
            i = i + c + 1;
        } else {
            var b = load8(src + i);
            i = i + 1;
            var rep = 257 - c;
            var j = 0;
            while (j < rep) { store8(out + w + j, b); j = j + 1; }
            w = w + rep;
        }
    }
    store8(out + w, 0);
    return str_new_a(a, out, w);
}

# --- predictors -------------------------------------------------------------

# The Paeth predictor of PNG (RFC 2083 §6.6). The textbook form computes
# p = a + b - c and then |p - a|, |p - b|, |p - c|; those simplify to |b - c|,
# |a - c| and |a + b - 2c|.
#
# a + b - 2c is a SIGNED intermediate — it is negative whenever c exceeds the
# mean of a and b, which happens constantly on real image data. Its magnitude
# is taken by COMPARISON, never by a shift: `>>` in Cyrius is the LOGICAL
# shift, so (0 - 8) >> 1 is 9223372036854775804 rather than -4 (G12), and a
# shift-based abs here would pick the wrong predictor on roughly half the
# pixels while compiling perfectly clean.
fn _pdfz_paeth(av, bv, cv): i64 {
    var pa = bv - cv;
    if (pa < 0) { pa = 0 - pa; }
    var pb = av - cv;
    if (pb < 0) { pb = 0 - pb; }
    var pc = av + bv - cv - cv;
    if (pc < 0) { pc = 0 - pc; }
    if (pa <= pb) {
        if (pa <= pc) { return av; }
    }
    if (pb <= pc) { return bv; }
    return cv;
}

# Reverse one PNG row filter IN PLACE over `cur` (rowlen bytes). `prev` is the
# already-reconstructed previous row, or 0 for the first row (which the format
# defines as an all-zero row). `bpp` is the byte distance to the left
# neighbour, at least 1. `ft` is the filter-type byte that preceded the row.
#
# Reconstruction is strictly left to right because Sub, Average and Paeth all
# read `cur[i - bpp]` AFTER it has been reconstructed — writing back as we go
# is what makes that true, not an accident of loop order.
#
# Returns 0, or 0 - 1 for a filter type the format does not define.
fn _pdfz_png_row(prev, cur, rowlen, bpp, ft): i64 {
    if (ft < 0) { return 0 - 1; }
    if (ft > 4) { return 0 - 1; }
    if (ft == 0) { return 0; }              # None — the bytes are already raw
    var step = bpp;
    if (step < 1) { step = 1; }

    var i = 0;
    while (i < rowlen) {
        var x = load8(cur + i);
        var av = 0;
        var bv = 0;
        var cv = 0;
        if (i >= step) { av = load8(cur + i - step); }
        if (prev != 0) {
            bv = load8(prev + i);
            if (i >= step) { cv = load8(prev + i - step); }
        }
        if (ft == 1) {
            x = x + av;
        } elif (ft == 2) {
            x = x + bv;
        } elif (ft == 3) {
            # floor((a + b) / 2). Both operands come from load8 and are
            # non-negative, so Cyrius's truncate-toward-zero division is floor.
            x = x + (av + bv) / 2;
        } else {
            x = x + _pdfz_paeth(av, bv, cv);
        }
        store8(cur + i, x & 255);
        i = i + 1;
    }
    return 0;
}

# 1 if `bpc` is one of PDF's five legal /BitsPerComponent values.
fn _pdfz_bpc_ok(bpc): i64 {
    if (bpc == 1)  { return 1; }
    if (bpc == 2)  { return 1; }
    if (bpc == 4)  { return 1; }
    if (bpc == 8)  { return 1; }
    if (bpc == 16) { return 1; }
    return 0;
}

# Read sample `j` of a row at `p`, `bpc` bits wide. Sub-byte samples are packed
# high bits first. Every operand originates in load8, which zero-extends, so
# the LOGICAL `>>` is the correct shift here (G12).
fn _pdfz_get_sample(p, j, bpc): i64 {
    if (bpc == 8)  { return load8(p + j); }
    if (bpc == 16) { return load8(p + j * 2) * 256 + load8(p + j * 2 + 1); }
    var per   = 8 / bpc;
    var slot  = j % per;
    var shift = (per - 1 - slot) * bpc;
    var mask  = (1 << bpc) - 1;
    return (load8(p + j / per) >> shift) & mask;
}

# Write sample `j` of a row at `p`, truncated to `bpc` bits.
fn _pdfz_put_sample(p, j, bpc, v): i64 {
    if (bpc == 8) {
        store8(p + j, v & 255);
        return 0;
    }
    if (bpc == 16) {
        store8(p + j * 2,     (v >> 8) & 255);
        store8(p + j * 2 + 1, v & 255);
        return 0;
    }
    var per   = 8 / bpc;
    var idx   = j / per;
    var slot  = j % per;
    var shift = (per - 1 - slot) * bpc;
    var mask  = (1 << bpc) - 1;
    var byte  = load8(p + idx);
    # 255 - (mask << shift) is the in-byte complement of the field. Written as
    # a subtraction rather than a bitwise NOT so the value can never widen past
    # eight bits and clobber the neighbouring samples.
    byte = byte & (255 - (mask << shift));
    byte = byte | ((v & mask) << shift);
    store8(p + idx, byte & 255);
    return 0;
}

# Undo a /DecodeParms predictor over (data, len).
#
# The four parameters arrive as plain integers — the caller reads /Predictor,
# /Colors, /BitsPerComponent and /Columns out of the parms dict and applies the
# defaults (1, 1, 8, 1). Keeping the dict walk out of here means the predictor
# math has exactly one entry point and can be tested without building an object.
#
#   predictor <= 1   no predictor; the span passes through as a borrowed view
#   predictor == 2   TIFF Predictor 2, horizontal differencing
#   predictor 10..15 the PNG filters, one filter-type byte per row
#
# TIFF Predictor 2 is implemented rather than refused. It is rare next to PNG
# Predictor 12 but it is legal, it appears in real image XObjects, and a reader
# that silently returns undifferenced bytes hands back a plausible-looking
# gradient — the exact silent-mis-parse shape this module refuses.
#
# Returns 0 with the reason recorded on any failure.
fn _pdfz_unpredict_a(a, doc, data, len, parms_pred, parms_colors, parms_bpc, parms_columns): Str {
    var n = len;
    if (n < 0) { n = 0; }
    if (data == 0) { n = 0; }

    if (parms_pred <= 1) {
        # A borrowed view, deliberately: /Predictor 1 is the identity and
        # copying a multi-megabyte content stream to say so is pure waste. The
        # view's lifetime is the source buffer's, which is already the rule for
        # every Str this reader hands back.
        return str_new_a(a, data, n);
    }

    # Validate BEFORE any multiply. colors * bpc is at most 32 * 16 == 512, and
    # 512 * 16777216 is 8.6e9 — comfortably inside i64 — so once these three
    # bounds hold, none of the arithmetic below can overflow.
    if (parms_colors < 1) {
        _pdfz_err(doc, "predictor: /Colors must be at least 1", 0 - 1);
        return 0;
    }
    if (parms_colors > 32) {
        _pdfz_err(doc, "predictor: /Colors exceeds the supported maximum of 32", 0 - 1);
        return 0;
    }
    if (_pdfz_bpc_ok(parms_bpc) == 0) {
        _pdfz_err(doc, "predictor: /BitsPerComponent must be 1, 2, 4, 8 or 16", 0 - 1);
        return 0;
    }
    if (parms_columns < 1) {
        _pdfz_err(doc, "predictor: /Columns must be at least 1", 0 - 1);
        return 0;
    }
    if (parms_columns > 16777216) {
        _pdfz_err(doc, "predictor: /Columns exceeds the supported maximum", 0 - 1);
        return 0;
    }

    var bits   = parms_colors * parms_bpc;
    var bpp    = (bits + 7) / 8;
    if (bpp < 1) { bpp = 1; }
    var rowlen = (bits * parms_columns + 7) / 8;
    if (rowlen < 1) {
        _pdfz_err(doc, "predictor: computed row length is zero", 0 - 1);
        return 0;
    }

    if (parms_pred == 2) {
        # TIFF Predictor 2: no per-row filter byte, so a row is exactly rowlen
        # bytes and a leftover tail means the caller's /Columns disagrees with
        # the data. That is refused, not truncated silently.
        if (rowlen > n) {
            _pdfz_err(doc, "TIFF Predictor 2: row length exceeds the stream length", 0 - 1);
            return 0;
        }
        if (n % rowlen != 0) {
            _pdfz_err(doc, "TIFF Predictor 2: stream length is not a whole number of rows", 0 - 1);
            return 0;
        }
        var trows = n / rowlen;
        var tout = alloc_via(a, n + 1);
        if (tout == 0) {
            _pdfz_err(doc, "TIFF Predictor 2: out of memory", 0 - 1);
            return 0;
        }
        memcpy(tout, data, n);

        var spr = parms_colors * parms_columns;     # samples per row
        var r = 0;
        while (r < trows) {
            var base = tout + r * rowlen;
            # Each sample is the difference from the sample `colors` positions
            # to its left — i.e. the same component of the previous pixel. The
            # left neighbour must already be reconstructed, so this walks
            # forward and writes back in place, exactly as the PNG row does.
            var j = parms_colors;
            while (j < spr) {
                var acc = _pdfz_get_sample(base, j, parms_bpc)
                + _pdfz_get_sample(base, j - parms_colors, parms_bpc);
                _pdfz_put_sample(base, j, parms_bpc, acc);
                j = j + 1;
            }
            r = r + 1;
        }
        store8(tout + n, 0);
        return str_new_a(a, tout, n);
    }

    if (parms_pred < 10) {
        _pdfz_err(doc, "predictor: /Predictor values 3 to 9 are not defined", 0 - 1);
        return 0;
    }
    if (parms_pred > 15) {
        _pdfz_err(doc, "predictor: /Predictor is outside the defined range", 0 - 1);
        return 0;
    }

    # PNG predictors. /Predictor 10..15 names the filter the ENCODER was
    # allowed to use, but the actual filter is the per-row type byte, so all
    # six values decode identically — there is no branch on parms_pred here
    # and there should not be one.
    var stride = rowlen + 1;
    if (n % stride != 0) {
        _pdfz_err(doc, "PNG predictor: stream length is not a whole number of filtered rows", 0 - 1);
        return 0;
    }
    var nrows = n / stride;
    var out = alloc_via(a, nrows * rowlen + 1);
    if (out == 0) {
        _pdfz_err(doc, "PNG predictor: out of memory", 0 - 1);
        return 0;
    }

    var prev = 0;
    var row = 0;
    while (row < nrows) {
        var srow = data + row * stride;
        var drow = out + row * rowlen;
        memcpy(drow, srow + 1, rowlen);
        if (_pdfz_png_row(prev, drow, rowlen, bpp, load8(srow)) != 0) {
            _pdfz_err(doc, "PNG predictor: row filter type is not one of 0 to 4", row * stride);
            return 0;
        }
        prev = drow;
        row = row + 1;
    }
    store8(out + nrows * rowlen, 0);
    return str_new_a(a, out, nrows * rowlen);
}

# === _pdfl_ — the PDF lexer ==================================================
#
# ONE implementation of PDF's token grammar, used in three places: file bodies,
# the interiors of object streams, and content-stream operands. There is no
# second, looser path — that is the structural reason this reader cannot drift
# into a guess-machine. A token that does not fit the grammar is an error
# naming its byte offset, never a rescan from the next plausible-looking byte.
#
# Every entry point threads the caller-owned 64-byte PdfState:
#   +0 buf  +8 len  +16 pos  +24 err_msg  +32 err_pos  +40 depth  +48 refs
#   +56 alloc
# There is no module-global cursor. See
# docs/development/issues/2026-06-23-thoth-json-value-parser-global-cursor-not-thread-safe.md
#
# NOTE (no strlen on input): the source is a (ptr, len) span, never a cstring.
# A PDF carries NUL bytes inside literal strings, inside hex strings, and all
# over any Flate-compressed stream, so every scan here is length-bounded and
# every byte read goes through load8 — which zero-extends, which is in turn why
# the `>>`-is-logical hazard (G12) never bites on this path. Nothing in this
# section shifts a signed intermediate; the two places that could (hex nibble
# packing, octal accumulation) multiply instead, so the question does not arise.

# 1 when the cursor has reached the end of the input span.
fn _pdfl_eof(ps): i64 {
    if (load64(ps + 16) >= load64(ps + 8)) { return 1; }
    return 0;
}

# The byte under the cursor without consuming it, or 0 - 1 at end of input.
# A real byte is always 0..255 (load8 zero-extends), so 0 - 1 is unforgeable.
fn _pdfl_peek(ps): i64 {
    var p = load64(ps + 16);
    if (p >= load64(ps + 8)) { return 0 - 1; }
    return load8(load64(ps) + p);
}

# Advance past whitespace AND `%` comments.
#
# Consuming comments here is mandatory, not a nicety: real-world files put a
# `%%Invocation:` or `%%Creator:` line — routinely several hundred bytes — in
# the middle of the header, and Ghostscript sprinkles `%` lines between objects.
# A lexer that only ate whitespace would hit `%` as an unexpected delimiter and
# reject files every viewer opens. The comment runs to the next CR or LF, which
# is deliberately left unconsumed: the loop's whitespace branch takes it on the
# next turn, so a `%comment` at end of input terminates cleanly too.
fn _pdfl_skip_ws(ps): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var p   = load64(ps + 16);
    while (p < len) {
        var c = load8(buf + p);
        if (_pdfe_is_ws(c) == 1) {
            p = p + 1;
        } elif (c == 37) {
            p = p + 1;
            while (p < len) {
                var k = load8(buf + p);
                if (k == 10) { break; }
                if (k == 13) { break; }
                p = p + 1;
            }
        } else {
            break;
        }
    }
    store64(ps + 16, p);
    return 0;
}

# 1 when the `n` bytes at the cursor equal `kw`, without consuming anything.
#
# `kw` is annotated `: cstring` because it is always a literal here; `n` is
# passed explicitly anyway so no strlen runs, which keeps the helper usable for
# a keyword containing a NUL should one ever be needed.
fn _pdfl_at(ps, kw: cstring, n): i64 {
    var p = load64(ps + 16);
    if (n <= 0) { return 0; }
    if (p + n > load64(ps + 8)) { return 0; }
    if (memeq(load64(ps) + p, kw, n) == 1) { return 1; }
    return 0;
}

# Consume `kw` (n bytes) at the cursor. Returns 1 on success; on a mismatch it
# records the error at the offending offset and returns 0 without moving.
fn _pdfl_expect(ps, kw: cstring, n): i64 {
    if (_pdfl_at(ps, kw, n) == 0) {
        return _pdfe_err(ps, "expected pdf keyword", load64(ps + 16));
    }
    store64(ps + 16, load64(ps + 16) + n);
    return 1;
}

# Snapshot the cursor for backtracking. Only `pos` is captured, because it is
# the only field a speculative lex is allowed to move: the probes below never
# record an error, so err_msg/err_pos cannot need rewinding, and depth is only
# touched by the parser's own balanced push/pop.
fn _pdfl_save(ps): i64 { return load64(ps + 16); }

# Restore a cursor snapshot taken by _pdfl_save.
fn _pdfl_restore(ps, saved): i64 { store64(ps + 16, saved); return 0; }

# Enter one level of array/dict nesting. 1 on success; 0 with the error set
# once _PDF_MAX_DEPTH levels are already open.
#
# The cap exists because recursive descent on attacker-supplied bytes is a
# stack-exhaustion primitive otherwise, per
# docs/development/issues/2026-07-16-agnosai-json-no-recursion-depth-cap.md
# The counter lives in the state, never in a global — a process-global depth
# counter would be the thoth bug wearing a different variable name, and it
# would be reachable here because extraction naturally nests page walk ->
# content decode -> operand parse.
fn _pdfl_depth_push(ps): i64 {
    var d = load64(ps + 40);
    if (d >= _PDF_MAX_DEPTH) {
        return _pdfe_err(ps, "pdf object nesting too deep", load64(ps + 16));
    }
    store64(ps + 40, d + 1);
    return 1;
}

# Leave one level of nesting. Clamped at 0 so a stray pop can never underflow
# the counter into a colossal unsigned-looking value. Every push in this module
# is paired with exactly one pop on a single exit path, so an error unwinding
# out of a half-built array still leaves the counter exactly where it started.
fn _pdfl_depth_pop(ps): i64 {
    var d = load64(ps + 40);
    if (d > 0) { store64(ps + 40, d - 1); }
    return 0;
}

# Read a name token — the cursor must be on '/'. Returns the DECODED bytes as a
# Str allocated through `a` (no leading '/', every `#xx` resolved), or 0 with
# the error set.
#
# The scan is two-phase: measure the regular-character run, then decode into a
# buffer sized from that run. Decoding never grows a name (`#41` is three bytes
# in and one byte out), so span + 1 is an exact upper bound. The `+ 1` is not
# slack — alloc(0) returns 0 (G15), and `/` alone is a legal PDF name whose
# decoded form is empty.
fn _pdfl_read_name_a(a, ps): Str {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var p   = load64(ps + 16);
    if (p >= len) { _pdfe_err(ps, "unexpected end of pdf input", p); return 0; }
    if (load8(buf + p) != 47) { _pdfe_err(ps, "expected a pdf name", p); return 0; }
    var s = p + 1;
    var e = s;
    while (e < len) {
        if (_pdfe_is_regular(load8(buf + e)) == 0) { break; }
        e = e + 1;
    }
    var out = alloc_via(a, (e - s) + 1);
    if (out == 0) { _pdfe_err(ps, "out of memory parsing pdf object", s); return 0; }
    var i = s;
    var n = 0;
    while (i < e) {
        var c = load8(buf + i);
        if (c == 35) {
            # `#` MUST be followed by two hex digits. A lone '#' is malformed,
            # not a literal '#': accepting it silently would make /A#B and
            # /A#42 decode by different rules, which is exactly the quiet
            # mis-parse the house rule forbids.
            if (i + 2 >= e) {
                _pdfe_err(ps, "malformed #xx escape in pdf name", i);
                return 0;
            }
            var h1 = _pdfe_hexval(load8(buf + i + 1));
            var h2 = _pdfe_hexval(load8(buf + i + 2));
            if (h1 < 0 || h2 < 0) {
                _pdfe_err(ps, "malformed #xx escape in pdf name", i);
                return 0;
            }
            store8(out + n, h1 * 16 + h2);
            i = i + 3;
        } else {
            store8(out + n, c);
            i = i + 1;
        }
        n = n + 1;
    }
    store64(ps + 16, e);
    return str_new_a(a, out, n);
}

# Read a literal string `( ... )` — the cursor must be on '('. Returns the
# decoded RAW BYTES as a Str through `a` (they may contain NUL and are not
# required to be UTF-8), or 0 with the error set.
#
# Two passes, and the split is deliberate. Pass one only has to find the
# matching ')': `\` skips two bytes, '(' and ')' track nesting. That rule is
# complete on its own — an octal escape's leading digit is skipped as the
# escaped byte and its remaining digits are ordinary non-paren bytes, and a
# backslash-EOL continuation skips the CR while the LF is likewise ordinary.
# Pass two then decodes into a buffer sized from the measured span, which is an
# exact upper bound because no escape ever expands. Sizing from the span rather
# than from the whole remaining input is what keeps a document full of short
# strings from allocating the file's length once per string.
fn _pdfl_read_litstr_a(a, ps): Str {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var p0  = load64(ps + 16);
    if (p0 >= len) { _pdfe_err(ps, "unexpected end of pdf input", p0); return 0; }
    if (load8(buf + p0) != 40) { _pdfe_err(ps, "expected a pdf string", p0); return 0; }
    var s = p0 + 1;
    var i = s;
    var depth = 1;
    var e = 0 - 1;
    while (i < len) {
        var c = load8(buf + i);
        if (c == 92) {
            i = i + 2;
        } elif (c == 40) {
            depth = depth + 1;
            i = i + 1;
        } elif (c == 41) {
            depth = depth - 1;
            if (depth == 0) { e = i; break; }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    if (e < 0) { _pdfe_err(ps, "unterminated pdf literal string", p0); return 0; }
    var out = alloc_via(a, (e - s) + 1);
    if (out == 0) { _pdfe_err(ps, "out of memory parsing pdf object", s); return 0; }
    var n = 0;
    var j = s;
    while (j < e) {
        var c2 = load8(buf + j);
        if (c2 != 92) {
            # Balanced parens inside the string are literal content; pass one
            # already proved they are balanced, so nothing to check here.
            store8(out + n, c2);
            n = n + 1;
            j = j + 1;
        } else {
            j = j + 1;
            if (j >= e) {
                # Unreachable given pass one's `\` skip-two rule, but a decoder
                # that trusts a scanner's invariant without checking it is one
                # refactor away from reading off the end.
                _pdfe_err(ps, "unterminated pdf literal string", p0);
                return 0;
            }
            var ec = load8(buf + j);
            if (ec == 110)      { store8(out + n, 10);  n = n + 1; j = j + 1; }
            elif (ec == 114)    { store8(out + n, 13);  n = n + 1; j = j + 1; }
            elif (ec == 116)    { store8(out + n, 9);   n = n + 1; j = j + 1; }
            elif (ec == 98)     { store8(out + n, 8);   n = n + 1; j = j + 1; }
            elif (ec == 102)    { store8(out + n, 12);  n = n + 1; j = j + 1; }
            elif (ec == 40)     { store8(out + n, 40);  n = n + 1; j = j + 1; }
            elif (ec == 41)     { store8(out + n, 41);  n = n + 1; j = j + 1; }
            elif (ec == 92)     { store8(out + n, 92);  n = n + 1; j = j + 1; }
            elif (ec == 13) {
                # Backslash-EOL is a line continuation: it contributes NOTHING
                # to the string. CRLF counts as one EOL, so the LF goes too.
                j = j + 1;
                if (j < e) { if (load8(buf + j) == 10) { j = j + 1; } }
            } elif (ec == 10) {
                j = j + 1;
            } elif (ec >= 48 && ec <= 55) {
                # 1-3 octal digits. Multiplied, never shifted: the accumulator
                # is a signed intermediate and `>>` is LOGICAL in Cyrius (G12),
                # so keeping the arithmetic multiplicative removes the question.
                var ov = ec - 48;
                var k = 1;
                j = j + 1;
                while (k < 3) {
                    if (j >= e) { break; }
                    var oc = load8(buf + j);
                    if (oc < 48 || oc > 55) { break; }
                    ov = ov * 8 + (oc - 48);
                    j = j + 1;
                    k = k + 1;
                }
                store8(out + n, ov & 255);
                n = n + 1;
            } else {
                # PDF 32000-1 7.3.4.2: a backslash before any other character
                # is ignored and the character stands for itself.
                store8(out + n, ec);
                n = n + 1;
                j = j + 1;
            }
        }
    }
    store64(ps + 16, e + 1);
    return str_new_a(a, out, n);
}

# Read a hex string `< ... >` — the cursor must be on '<' and the byte after it
# must NOT be a second '<' (that is a dictionary; the caller disambiguates).
# Returns the decoded raw bytes as a Str through `a`, or 0 with the error set.
#
# Whitespace between nibbles is ignored, as the format requires. A final odd
# nibble is padded with '0' on the RIGHT — `<4A6>` is 0x4A 0x60, not 0x4A 0x06.
# Anything that is neither a hex digit, whitespace, nor '>' is rejected at its
# own byte offset rather than skipped.
fn _pdfl_read_hexstr_a(a, ps): Str {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var p0  = load64(ps + 16);
    if (p0 >= len) { _pdfe_err(ps, "unexpected end of pdf input", p0); return 0; }
    if (load8(buf + p0) != 60) { _pdfe_err(ps, "expected a pdf hex string", p0); return 0; }
    var i = p0 + 1;
    var nib = 0;
    var e = 0 - 1;
    while (i < len) {
        var c = load8(buf + i);
        if (c == 62) { e = i; break; }
        if (_pdfe_is_ws(c) == 0) {
            if (_pdfe_hexval(c) < 0) {
                _pdfe_err(ps, "invalid hex digit in pdf string", i);
                return 0;
            }
            nib = nib + 1;
        }
        i = i + 1;
    }
    if (e < 0) { _pdfe_err(ps, "unterminated pdf hex string", p0); return 0; }
    # (nib + 1) / 2 rounds the odd nibble up into its own byte. `+ 1` on the
    # allocation because an empty `<>` is legal and alloc(0) returns 0 (G15).
    var out = alloc_via(a, (nib + 1) / 2 + 1);
    if (out == 0) { _pdfe_err(ps, "out of memory parsing pdf object", p0); return 0; }
    var n = 0;
    var hi = 0;
    var have = 0;
    var j = p0 + 1;
    while (j < e) {
        var c2 = load8(buf + j);
        if (_pdfe_is_ws(c2) == 0) {
            var hv = _pdfe_hexval(c2);
            if (have == 0) { hi = hv; have = 1; }
            else { store8(out + n, hi * 16 + hv); n = n + 1; have = 0; }
        }
        j = j + 1;
    }
    if (have == 1) { store8(out + n, hi * 16); n = n + 1; }
    store64(ps + 16, e + 1);
    return str_new_a(a, out, n);
}

# Overflow guard for decimal accumulation: 9223372036854775807 / 10, minus one
# so that `v * 10 + d` for any digit d is provably representable. Bare literal,
# so it is statically initialised and immune to the global init-order hazard
# where a top-level initialiser reading a later global silently reads 0.
var _PDFL_DEC_MAX = 922337203685477579;

# Read a number token. Writes (scaled, places) to the caller's 16-byte `out16`
# — `store64(out16, scaled)` and `store64(out16 + 8, places)` — where
# `places == 0 - 1` means the token was an INTEGER and any other value means a
# real with value scaled / 10^places. Returns 1 on success, 0 with the error set.
#
# `var out16[16]` at the call site is 16 BYTES, i.e. exactly the two i64 slots
# wanted (G2), and `out16 + 8` is a BYTE offset to the second slot (G3).
#
# There is no floating point anywhere on this path and there never can be:
# a PDF real is captured losslessly as (scaled, places), which makes the
# emitter the literal inverse of this scanner and makes exponent notation and
# the token `null` — the two things bayan_f64_to_json would produce, both
# invalid PDF — unrepresentable rather than merely avoided (G11).
#
# Accepted: [+-]?digits, [+-]?digits.digits, [+-]?.digits, [+-]?digits. — the
# whole of PDF's number syntax. Rejected loudly: no digits at all, a run that
# runs past i64, and a token followed immediately by a regular character, which
# is what makes `1.2.3` and `42e5` errors instead of a silent `1.2` plus junk.
fn _pdfl_read_number(ps, out16): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var p   = load64(ps + 16);
    var start = p;
    var neg = 0;
    var v = 0;
    var digits = 0;
    var places = 0 - 1;
    if (p < len) {
        var c0 = load8(buf + p);
        if (c0 == 45)      { neg = 1; p = p + 1; }
        elif (c0 == 43)    { p = p + 1; }
    }
    while (p < len) {
        var ci = load8(buf + p);
        if (_pdfe_is_digit(ci) == 0) { break; }
        if (v > _PDFL_DEC_MAX) { return _pdfe_err(ps, "pdf number out of range", start); }
        v = v * 10 + (ci - 48);
        digits = digits + 1;
        p = p + 1;
    }
    if (p < len && load8(buf + p) == 46) {
        p = p + 1;
        places = 0;
        while (p < len) {
            var cf = load8(buf + p);
            if (_pdfe_is_digit(cf) == 0) { break; }
            digits = digits + 1;
            # Digits past the ninth place are dropped rather than rejected:
            # 10^places must stay exactly representable for the emitter to be
            # the exact inverse, and PDF's own stated implementation limit is
            # five decimal digits, so nine is already generous. Extra
            # precision is not malformed input, so it is not a loud error.
            if (places < 9) {
                if (v > _PDFL_DEC_MAX) { return _pdfe_err(ps, "pdf number out of range", start); }
                v = v * 10 + (cf - 48);
                places = places + 1;
            }
            p = p + 1;
        }
    }
    if (digits == 0) { return _pdfe_err(ps, "malformed pdf number", start); }
    if (p < len) {
        if (_pdfe_is_regular(load8(buf + p)) == 1) {
            return _pdfe_err(ps, "malformed pdf number", p);
        }
    }
    if (neg == 1) { v = 0 - v; }
    store64(out16,     v);
    store64(out16 + 8, places);
    store64(ps + 16, p);
    return 1;
}

# Read a bare keyword — a run of regular characters — writing (ptr, len) to the
# caller's 16-byte `out16`. Returns 1 when the run is non-empty, else 0.
#
# This is how `true`, `false`, `null`, `obj`, `endobj`, `R`, and every content
# operator are lexed, so it records NO error of its own: which keywords are
# legal is the caller's grammar, not the lexer's. The span points INTO the
# source buffer and is not copied.
fn _pdfl_read_kw(ps, out16): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var p   = load64(ps + 16);
    var s   = p;
    while (p < len) {
        if (_pdfe_is_regular(load8(buf + p)) == 0) { break; }
        p = p + 1;
    }
    if (p == s) { return 0; }
    store64(out16,     buf + s);
    store64(out16 + 8, p - s);
    store64(ps + 16, p);
    return 1;
}

# Speculatively read an UNSIGNED integer token. Writes the value to the 8-byte
# `out8` and returns 1 only when the cursor is on a complete run of digits
# terminated by whitespace, a delimiter, or end of input. Returns 0 otherwise,
# and on failure the cursor has NOT moved.
#
# This exists instead of a _pdfl_read_number call because the `N G R` lookahead
# is speculative and _pdfe_err is FIRST-WINS and sticky: a probe that recorded
# "malformed pdf number" while sniffing at `[1 0]`'s closing bracket would
# poison the state's error for the rest of the parse even though the parse then
# succeeded. A probe must be able to fail silently; a lexer must not.
fn _pdfl_probe_unsigned(ps, out8): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var p   = load64(ps + 16);
    var v = 0;
    var n = 0;
    while (p < len) {
        var c = load8(buf + p);
        if (_pdfe_is_digit(c) == 0) { break; }
        if (v > _PDFL_DEC_MAX) { return 0; }
        v = v * 10 + (c - 48);
        n = n + 1;
        p = p + 1;
    }
    if (n == 0) { return 0; }
    if (p < len) {
        if (_pdfe_is_regular(load8(buf + p)) == 1) { return 0; }
    }
    store64(out8, v);
    store64(ps + 16, p);
    return 1;
}

# === _pdfp_ — the object-grammar parser ======================================
#
# Recursive descent over the eight PDF object types plus the indirect
# reference, producing _pdfo_ cells. Every level is depth-counted against
# _PDF_MAX_DEPTH through the state, never a global.

# Parse one array `[ ... ]` — the cursor must be on '['. Returns a PTAG_ARR
# cell allocated through `a`, or 0 with the error set.
#
# The nesting level for this array is pushed by the caller (_pdfp_obj_a), which
# is also what pops it, so this function stays a single balanced unit no matter
# which of its exits fires.
fn _pdfp_array_a(a, ps): i64 {
    var open = load64(ps + 16);
    store64(ps + 16, open + 1);
    var arr = bayan_pdf_obj_array_new_a(a);
    if (arr == 0) { return _pdfe_err(ps, "out of memory parsing pdf object", open); }
    while (1 == 1) {
        _pdfl_skip_ws(ps);
        if (_pdfl_eof(ps) == 1) {
            return _pdfe_err(ps, "unterminated pdf array", open);
        }
        if (_pdfl_peek(ps) == 93) {
            store64(ps + 16, load64(ps + 16) + 1);
            return arr;
        }
        var v = _pdfp_obj_a(a, ps);
        if (v == 0) { return 0; }
        if (bayan_pdf_obj_array_push_a(a, arr, v) < 0) {
            return _pdfe_err(ps, "out of memory parsing pdf object", load64(ps + 16));
        }
    }
    return arr;
}

# Parse one dictionary `<< ... >>` — the cursor must be on the first '<' of the
# pair. Returns a PTAG_DICT cell allocated through `a`, or 0 with the error set.
#
# A key that is not a name is a LOUD error rather than a skipped token. The
# tempting recovery — "ignore the malformed entry and keep going" — is exactly
# how a reader silently drops a /Length or a /Filter and then reports confident
# nonsense about the stream that follows.
#
# Duplicate keys are preserved in insertion order rather than merged: PDF does
# not define which wins, _pdfo_dict_find takes the first, and rewriting the
# caller's bytes to make a lookup tidier is not the parser's job.
fn _pdfp_dict_a(a, ps): i64 {
    var open = load64(ps + 16);
    store64(ps + 16, open + 2);
    var d = bayan_pdf_obj_dict_new_a(a);
    if (d == 0) { return _pdfe_err(ps, "out of memory parsing pdf object", open); }
    var pairs = _pdfo_vec(d);
    while (1 == 1) {
        _pdfl_skip_ws(ps);
        if (_pdfl_at(ps, ">>", 2) == 1) {
            store64(ps + 16, load64(ps + 16) + 2);
            return d;
        }
        if (_pdfl_eof(ps) == 1) {
            return _pdfe_err(ps, "unterminated pdf dictionary", open);
        }
        if (_pdfl_peek(ps) != 47) {
            return _pdfe_err(ps, "pdf dictionary key is not a name", load64(ps + 16));
        }
        var key = _pdfl_read_name_a(a, ps);
        if (key == 0) { return 0; }
        var val = _pdfp_obj_a(a, ps);
        if (val == 0) { return 0; }
        var pr = _pdfo_pair_new_a(a, key, val);
        if (pr == 0) {
            return _pdfe_err(ps, "out of memory parsing pdf object", load64(ps + 16));
        }
        if (vec_push_a(a, pairs, pr) < 0) {
            return _pdfe_err(ps, "out of memory parsing pdf object", load64(ps + 16));
        }
    }
    return d;
}

# Parse a number, or the three-token indirect reference `N G R`.
#
# THE AMBIGUITY. `1 0 R` and the two integers `1 0` followed by an `R` operator
# are lexically identical up to the third token, and no amount of local
# cleverness fixes that — the grammar genuinely requires lookahead with a full
# rewind. Resolved in two stages, both rewinding to the SAME point (just past
# the first integer), because whenever the reference reading fails, what the
# caller wanted was that first integer alone and everything after it must be
# re-lexed from scratch:
#
#   1. the first token must be an UNSIGNED integer — `-1 0 R` is not a
#      reference, object numbers are non-negative and generations are too;
#   2. save; if the next token is not an unsigned integer, rewind and hand back
#      the first integer (this is the `[1 0]` case, and also `[1 /X]`);
#   3. if the next byte is `R` AND the byte after it is whitespace, a
#      delimiter, or end of input, consume it and return PTAG_REF(N, G);
#      otherwise rewind and hand back the first integer.
#
# The boundary requirement in step 3 is a DELIBERATE improvement on the
# reference oracle, which lexes `1 0 Rx` as a reference followed by nothing:
# `Rx` is one regular-character run and therefore one keyword token, so reading
# an `R` out of the middle of it is reading a token that is not there. Under
# this rule `1 0 Rx` yields the integer 1 with the cursor parked before `0 Rx`,
# which is what the grammar actually says.
#
# Neither probe records an error, so a rewound speculation leaves the state
# byte-for-byte as it found it.
fn _pdfp_number_or_ref_a(a, ps): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var start = load64(ps + 16);
    var num16[16];
    if (_pdfl_read_number(ps, &num16) == 0) { return 0; }
    var scaled = load64(&num16);
    var places = load64(&num16 + 8);

    if (places != 0 - 1) {
        var ro = bayan_pdf_obj_real_new_a(a, scaled, places);
        if (ro == 0) { return _pdfe_err(ps, "out of memory parsing pdf object", start); }
        return ro;
    }

    # Step 1. Only a token that STARTED with a digit can open a reference; a
    # leading '+' or '-' rules it out before any lookahead happens.
    var unsigned = 0;
    if (start < len) {
        if (_pdfe_is_digit(load8(buf + start)) == 1) { unsigned = 1; }
    }
    if (unsigned == 0) {
        var io = bayan_pdf_obj_int_new_a(a, scaled);
        if (io == 0) { return _pdfe_err(ps, "out of memory parsing pdf object", start); }
        return io;
    }

    # `after1` is the single rewind target for BOTH failure paths below.
    var after1 = _pdfl_save(ps);

    # Step 2 — the generation number.
    var gen8[8];
    _pdfl_skip_ws(ps);
    if (_pdfl_probe_unsigned(ps, &gen8) == 1) {
        # Step 3 — the `R` keyword, which must stand alone as its own token.
        _pdfl_skip_ws(ps);
        var rp = load64(ps + 16);
        if (rp < len) {
            if (load8(buf + rp) == 82) {
                var bounded = 0;
                if (rp + 1 >= len) { bounded = 1; }
                else {
                    var nc = load8(buf + rp + 1);
                    if (_pdfe_is_ws(nc) == 1)    { bounded = 1; }
                    elif (_pdfe_is_delim(nc) == 1) { bounded = 1; }
                }
                if (bounded == 1) {
                    store64(ps + 16, rp + 1);
                    var rf = bayan_pdf_obj_ref_new_a(a, scaled, load64(&gen8));
                    if (rf == 0) {
                        return _pdfe_err(ps, "out of memory parsing pdf object", start);
                    }
                    return rf;
                }
            }
        }
    }

    _pdfl_restore(ps, after1);
    var io2 = bayan_pdf_obj_int_new_a(a, scaled);
    if (io2 == 0) { return _pdfe_err(ps, "out of memory parsing pdf object", start); }
    return io2;
}

# Parse ONE PDF object at the cursor, allocating through `a`. Returns the cell,
# or 0 with the state's (msg, pos) set.
#
# Dispatch is on the first byte alone, which is enough for every case except
# `<` (a hex string or the start of a dictionary — decided by the byte after
# it) and a leading digit (a number or the head of an `N G R` reference —
# decided by _pdfp_number_or_ref_a's lookahead).
#
# The depth counter is pushed HERE and popped HERE, around the two recursive
# arms and nowhere else, so the push/pop pairing is visible in one screen and
# an error unwinding out of arbitrarily deep nesting still restores the count
# exactly — each level pops on its way out through this same single exit.
fn _pdfp_obj_a(a, ps): i64 {
    _pdfl_skip_ws(ps);
    var pos = load64(ps + 16);
    if (pos >= load64(ps + 8)) {
        return _pdfe_err(ps, "unexpected end of pdf input", pos);
    }
    var c = load8(load64(ps) + pos);

    if (c == 47) {
        var nm = _pdfl_read_name_a(a, ps);
        if (nm == 0) { return 0; }
        # Built directly rather than through bayan_pdf_obj_name_new_a: that
        # constructor takes a `: cstring` and runs strlen, and a decoded name
        # is a (ptr, len) span that may legitimately contain a NUL via `#00`.
        # Handing it a Str would make strlen walk the 16-byte Str header and
        # return junk — the G1 silent-wrong-answer, not a crash.
        var no = _pdfo_alloc_a(a, PTAG_NAME);
        if (no == 0) { return _pdfe_err(ps, "out of memory parsing pdf object", pos); }
        store64(no + 8, nm);
        return no;
    }
    if (c == 40) {
        var ls = _pdfl_read_litstr_a(a, ps);
        if (ls == 0) { return 0; }
        var lo = bayan_pdf_obj_string_new_a(a, ls);
        if (lo == 0) { return _pdfe_err(ps, "out of memory parsing pdf object", pos); }
        return lo;
    }
    if (c == 60) {
        if (_pdfl_at(ps, "<<", 2) == 1) {
            if (_pdfl_depth_push(ps) == 0) { return 0; }
            var dv = _pdfp_dict_a(a, ps);
            _pdfl_depth_pop(ps);
            return dv;
        }
        var hs = _pdfl_read_hexstr_a(a, ps);
        if (hs == 0) { return 0; }
        var ho = bayan_pdf_obj_hex_new_a(a, hs);
        if (ho == 0) { return _pdfe_err(ps, "out of memory parsing pdf object", pos); }
        return ho;
    }
    if (c == 91) {
        if (_pdfl_depth_push(ps) == 0) { return 0; }
        var av = _pdfp_array_a(a, ps);
        _pdfl_depth_pop(ps);
        return av;
    }
    if (c == 93 || c == 41) {
        return _pdfe_err(ps, "unexpected pdf delimiter", pos);
    }
    if (c == 62 || c == 123 || c == 125) {
        return _pdfe_err(ps, "unexpected pdf delimiter", pos);
    }
    if (_pdfe_is_digit(c) == 1 || c == 43) {
        return _pdfp_number_or_ref_a(a, ps);
    }
    if (c == 45 || c == 46) {
        return _pdfp_number_or_ref_a(a, ps);
    }

    var kw16[16];
    if (_pdfl_read_kw(ps, &kw16) == 0) {
        return _pdfe_err(ps, "unexpected token in pdf object", pos);
    }
    var kp = load64(&kw16);
    var kl = load64(&kw16 + 8);
    if (kl == 4) {
        if (memeq(kp, "true", 4) == 1) {
            var tb = bayan_pdf_obj_bool_new_a(a, 1);
            if (tb == 0) { return _pdfe_err(ps, "out of memory parsing pdf object", pos); }
            return tb;
        }
        if (memeq(kp, "null", 4) == 1) {
            var nl = bayan_pdf_obj_null_a(a);
            if (nl == 0) { return _pdfe_err(ps, "out of memory parsing pdf object", pos); }
            return nl;
        }
    }
    if (kl == 5) {
        if (memeq(kp, "false", 5) == 1) {
            var fb = bayan_pdf_obj_bool_new_a(a, 0);
            if (fb == 0) { return _pdfe_err(ps, "out of memory parsing pdf object", pos); }
            return fb;
        }
    }
    # The keyword was consumed, but the cursor is irrelevant now: the error is
    # reported at the token's own first byte, which is what a caller needs to
    # point at the offending bytes.
    return _pdfe_err(ps, "unexpected token in pdf object", pos);
}

# Parse ONE PDF object from the byte span (buf, len), allocating both the cells
# and their payloads through `a`. Returns the object, or 0 with the state's
# error set to (message, byte offset).
#
# The caller-owned `ps` is seeded here, so the parse starts at offset 0 and
# `load64(ps + 16)` afterwards is the offset one past the object — which is how
# a caller walks a sequence of objects out of one buffer.
#
# UNLIKE bayan_json_v_parse_ctx_a, trailing content is NOT an error. "Parse one
# object" is the contract: PDF bodies are streams of objects separated by
# keywords this function deliberately knows nothing about (`obj`, `endobj`,
# `stream`), so demanding that the span be exhausted would make the entry
# useless to every caller inside the reader.
fn bayan_pdf_obj_parse_ctx_a(a, ps, buf, len): i64 {
    if (ps == 0) { return 0; }
    if (buf == 0) {
        _pdfe_state_init(ps, 0, 0, a);
        _pdfe_err(ps, "null pdf source", 0);
        return 0;
    }
    var n = len;
    if (n < 0) { n = 0; }
    _pdfe_state_init(ps, buf, n, a);
    return _pdfp_obj_a(a, ps);
}

# Parse ONE PDF object from a byte span using the default allocator.
#
# Globals-compat wrapper over the reentrant path: the parse itself owns a
# stack-local PdfState and is therefore thread-safe, and only afterwards does
# it mirror the per-call error into the legacy bayan_pdf_last_error()/_pos()
# slots — json.cyr:1087-1093's pattern exactly. Concurrent callers must use
# bayan_pdf_obj_parse_ctx_a and read bayan_pdf_state_error()/_pos() instead.
#
# NAMED `_buf`, NOT `_str`: Cyrius routes `X(a, ...)` to `X_str` whenever `a`
# is Str-typed at the call site, so a cstr+len form occupying that name would
# silently swallow every `X(someStr)` call in the ecosystem. That is the 1.3.0
# json breakage, and `var ps[64]` here is 64 BYTES — the full _PDF_STATE_SIZE,
# not 64 slots (G2).
fn bayan_pdf_obj_parse_buf(buf, len): i64 {
    var ps[64];
    var o = bayan_pdf_obj_parse_ctx_a(default_alloc(), &ps, buf, len);
    _pdf_err_msg = load64(&ps + 24);
    _pdf_err_pos = load64(&ps + 32);
    return o;
}

# === _pdfw_ — the object serialiser (PdfObj -> PDF syntax bytes) =============
#
# The exact inverse of the lexer: every token this section emits is one the
# reader's `_pdfl_` scanner reads back to an identical cell, which is what makes
# the round-trip assertion (serialise . parse == identity) meaningful rather
# than decorative.
#
# ALLOCATION. Everything on the writer path grows the output builder through
# the CALLER's allocator. lib/str.cyr's convenience appenders — putc,
# add_int, add_cstr, add — come in two flavours, and only the `_a` flavour
# threads the allocator into `_sb_grow_a`; the bare ones grow through
# default_alloc() and would silently leak the caller's arena into the global
# bump. `str_builder_putc` has no `_a` twin at all, so `_pdfw_putc` below is
# that missing twin, written against the same documented builder layout that
# `_pdfw_pos` reads. The zero-growth property asserted for
# bayan_pdf_to_bytes_a depends on nothing in this section calling a bare
# builder appender.
#
# Every helper here mirrors the house `_a` grammar: `_pdfw_<x>_a(a, ...)` does
# the work, `_pdfw_<x>(...)` is a one-line delegate through default_alloc().
# The bare forms are the ones the content-stream layer calls, because a page's
# content builder is already owned by its document.
#
# Return convention: 0 on success, 0 - 1 on failure (OOM, a depth-cap refusal,
# or a malformed cell). Failure propagates to bayan_pdf_obj_to_bytes_*, which
# hands back the empty Str per the house "0 / empty on failure" sentinel.

# --- builder primitives, allocator-threaded ---------------------------------

# The live byte length of a str_builder, and THE SINGLE SOURCE OF EVERY BYTE
# OFFSET the writer records.
#
# This is a deliberate coupling to lib/str.cyr's builder layout
# { buf@0, len@8, cap@16 } (lib/str.cyr:427-448): `_sb_grow_a` (:453) and
# `str_builder_build_a` (:574) both take the live count from load64(sb + 8),
# so it is exact, monotonic, and counts BINARY bytes — embedded NULs and
# 0x80..0xFF included. That is precisely why the xref offsets are measured from
# it instead of predicted from a running sum: a running sum has to be kept in
# step with every future change to the header or the object bodies, and it is
# wrong silently.
#
# lib/ is a vendored snapshot, so the coupling is pinned by a test that names
# this function; if a stdlib re-sync ever moves `len`, that test fails by name
# and the fallback is a side counter bumped by every append helper here.
fn _pdfw_pos(sb): i64 {
    if (sb == 0) { return 0; }
    return load64(sb + 8);
}

# Append one raw byte through `a`. The allocator-threaded twin lib/str.cyr does
# not ship: str_builder_putc grows via default_alloc(), which would move the
# output buffer out of the caller's arena the first time it outgrew the 64-byte
# inline block — i.e. always, for any real PDF.
fn _pdfw_putc(a, sb, ch): i64 {
    if (sb == 0) { return 0 - 1; }
    if (_sb_grow_a(a, sb, 1) != 0) { return 0 - 1; }
    var buf = load64(sb);
    var len = load64(sb + 8);
    store8(buf + len, ch & 255);
    store64(sb + 8, len + 1);
    return 0;
}

# Append a NUL-terminated keyword ("null", "true", "stream\n", ...). Safe here
# and ONLY here: every argument is a literal drawn from PDF's own syntax, never
# a payload byte. str_builder_add_cstr_a is strlen-based and truncates at the
# first NUL (G10), so it must never see stream data — that path is _pdfw_bytes.
fn _pdfw_kw(a, sb, kw: cstring): i64 {
    if (sb == 0) { return 0 - 1; }
    return str_builder_add_cstr_a(a, sb, kw);
}

# Append a decimal integer. Named _pdfw_num, not _pdfw_int: a trailing `_int`
# claims a compiler overload slot and would silently capture calls meant for
# something else (G4).
fn _pdfw_num(a, sb, n): i64 {
    if (sb == 0) { return 0 - 1; }
    return str_builder_add_int_a(a, sb, n);
}

# Append a Str's bytes verbatim. THE binary-safe payload path — this is what
# stream data goes through, and it is length-driven, so a NUL in the middle of
# a deflated stream is just another byte.
fn _pdfw_bytes(a, sb, s: Str): i64 {
    if (sb == 0) { return 0 - 1; }
    if (s == 0)  { return 0; }
    return str_builder_add_a(a, sb, s);
}

# Uppercase hex digit for 0..15. PDF accepts either case in <hex> strings and
# in #xx name escapes; uppercase is what the reference writers emit, so the
# round-trip fixtures are stable byte-for-byte.
fn _pdfw_hexdig(v): i64 {
    var d = v & 15;
    if (d < 10) { return 48 + d; }
    return 55 + d;
}

# --- numbers ----------------------------------------------------------------

# Emit a PDF real held as (scaled, places), value = scaled / 10^places.
#
# The exact inverse of _pdfl_read_number, and TOKEN-EXACT: (50, 2) emits
# "0.50", not "0.5". Trailing-zero trimming belongs to _pdfw_mpt, whose input
# is a measurement rather than a token; doing it here would break the
# parse -> serialise identity the object model exists to provide (D3).
#
# THE SIGN IS SPLIT FIRST, and that is not stylistic. Cyrius division and
# modulo BOTH truncate toward zero: (0 - 7) / 2 == -3 and (0 - 7) % 2 == -1.
# So the naive "integer part, '.', fraction digits" spelling on scaled =
# -13200, places = 3 computes -13 and -200 and emits "-13.-200" — not a PDF
# number, accepted by no viewer, and produced by code that compiles clean and
# looks right. Negating into a non-negative `v` up front makes every division
# below unsigned in effect, so the digit loop has one behaviour, not two.
#
# places <= 0 is the INT spelling (the lexer writes places = 0 - 1 for an
# integer token); places > 18 cannot be produced by the constructor, which
# rejects anything above 9, and is folded into the same branch rather than
# handed to _pdfe_pow10, whose out-of-range answer is 1.
fn _pdfw_real_a(a, sb, scaled, places): i64 {
    if (places <= 0 || places > 18) { return _pdfw_num(a, sb, scaled); }
    var v = scaled;
    if (v < 0) {
        if (_pdfw_putc(a, sb, 45) != 0) { return 0 - 1; }
        # 0 - i64::MIN is not representable; clamp rather than wrap, so a
        # hostile token can produce a wrong magnitude but never a wrong sign
        # or a garbage digit run.
        if (v < 0 - 9223372036854775807) { v = 9223372036854775807; }
        else { v = 0 - v; }
    }
    var p = _pdfe_pow10(places);
    if (_pdfw_num(a, sb, v / p) != 0)  { return 0 - 1; }
    if (_pdfw_putc(a, sb, 46) != 0)    { return 0 - 1; }
    var f = v % p;
    var k = places;
    while (k > 0) {
        k = k - 1;
        if (_pdfw_putc(a, sb, 48 + ((f / _pdfe_pow10(k)) % 10)) != 0) { return 0 - 1; }
    }
    return 0;
}

# Emit a PDF real from (scaled, places) through default_alloc().
fn _pdfw_real(sb, scaled, places): i64 {
    return _pdfw_real_a(default_alloc(), sb, scaled, places);
}

# Emit a milli-point measurement as a PDF number, trimming trailing zeros:
# 72000 -> "72", 10500 -> "10.5", 1 -> "0.001", 0 -> "0".
#
# Trimming is exact integer work, never a division that loses a digit: a factor
# of ten only comes off while the low decimal digit IS zero. It works unchanged
# on negatives because Cyrius's modulo truncates toward zero, so -13200 % 10 is
# 0 and -132 % 10 is -2 — the loop stops in the same place it would for +13200,
# leaving (0 - 132, 1) and the token "-13.2".
#
# This is the emitter every content-stream coordinate goes through. Trimming is
# worth the code: a page of text operators is thousands of numbers, and "72" is
# four bytes smaller than "72.000" every single time.
fn _pdfw_mpt_a(a, sb, mpt): i64 {
    var v = mpt;
    var places = 3;
    while (places > 0) {
        if (v % 10 != 0) { break; }
        v = v / 10;
        places = places - 1;
    }
    return _pdfw_real_a(a, sb, v, places);
}

# Emit a milli-point measurement through default_alloc().
fn _pdfw_mpt(sb, mpt): i64 {
    return _pdfw_mpt_a(default_alloc(), sb, mpt);
}

# --- names ------------------------------------------------------------------

# Emit a PDF name: '/' followed by the decoded bytes, with #xx substituted for
# anything that cannot appear literally.
#
# The escape set is the exact inverse of _pdfl_read_name_a's #xx resolution:
# '#' itself (or it would be read back as the start of an escape), every
# delimiter, and every byte outside the printable range 0x21..0x7E — which
# covers all six PDF whitespace bytes, including the NUL that PDF counts as
# whitespace. A name is stored decoded, so "A B#C" round-trips to "/A#20B#23C".
#
# An empty name emits a bare "/", which is legal PDF and reads back as the
# empty name.
fn _pdfw_name_a(a, sb, s: Str): i64 {
    if (_pdfw_putc(a, sb, 47) != 0) { return 0 - 1; }
    if (s == 0) { return 0; }
    var p = str_data(s);
    var n = str_len(s);
    var i = 0;
    while (i < n) {
        # load8 zero-extends, so c is 0..255 and every comparison below is on a
        # non-negative value.
        var c = load8(p + i);
        var esc = 0;
        if (c < 33 || c > 126)          { esc = 1; }
        elif (c == 35)                  { esc = 1; }
        elif (_pdfe_is_delim(c) == 1)   { esc = 1; }
        if (esc == 1) {
            if (_pdfw_putc(a, sb, 35) != 0)                { return 0 - 1; }
            # Division, not `>>`: shifting is correct on a load8 result but the
            # habit is what bites elsewhere in this module, since `>>` is
            # LOGICAL in Cyrius and `>>>` is arithmetic (G12).
            if (_pdfw_putc(a, sb, _pdfw_hexdig(c / 16)) != 0) { return 0 - 1; }
            if (_pdfw_putc(a, sb, _pdfw_hexdig(c % 16)) != 0) { return 0 - 1; }
        } else {
            if (_pdfw_putc(a, sb, c) != 0) { return 0 - 1; }
        }
        i = i + 1;
    }
    return 0;
}

# Emit a PDF name through default_alloc().
fn _pdfw_name(sb, s: Str): i64 {
    return _pdfw_name_a(default_alloc(), sb, s);
}

# --- strings ----------------------------------------------------------------

# Emit a PDF literal string: '(' ... ')' with D10's escape rules.
#
#   '(' ')' '\'      always escaped, so the reader's paren balance cannot be
#                    thrown by payload bytes and a lone ')' cannot end the
#                    string early
#   LF CR TAB BS FF  named escapes \n \r \t \b \f, never the raw byte — a raw
#                    CR inside a string is silently normalised to LF by some
#                    readers, which would make the round-trip lossy
#   other < 0x20,    three-digit octal \ddd
#   and 0x7F
#   0x80..0xFF       passed through raw; these are WinAnsi text bytes and PDF
#                    literal strings are byte strings, not text
#
# Length-driven throughout, so an embedded NUL is escaped as \000 like any
# other control byte rather than ending the string (G10).
fn _pdfw_litstr_a(a, sb, s: Str): i64 {
    if (_pdfw_putc(a, sb, 40) != 0) { return 0 - 1; }
    if (s != 0) {
        var p = str_data(s);
        var n = str_len(s);
        var i = 0;
        while (i < n) {
            var c = load8(p + i);
            if (c == 40 || c == 41) {
                if (_pdfw_putc(a, sb, 92) != 0) { return 0 - 1; }
                if (_pdfw_putc(a, sb, c) != 0)  { return 0 - 1; }
            } elif (c == 92) {
                if (_pdfw_putc(a, sb, 92) != 0) { return 0 - 1; }
                if (_pdfw_putc(a, sb, 92) != 0) { return 0 - 1; }
            } elif (c == 10) {
                if (_pdfw_kw(a, sb, "\\n") != 0) { return 0 - 1; }
            } elif (c == 13) {
                if (_pdfw_kw(a, sb, "\\r") != 0) { return 0 - 1; }
            } elif (c == 9) {
                if (_pdfw_kw(a, sb, "\\t") != 0) { return 0 - 1; }
            } elif (c == 8) {
                if (_pdfw_kw(a, sb, "\\b") != 0) { return 0 - 1; }
            } elif (c == 12) {
                if (_pdfw_kw(a, sb, "\\f") != 0) { return 0 - 1; }
            } elif (c < 32 || c == 127) {
                # Always three digits. A short octal escape would swallow a
                # following literal digit: "\0" then '7' reads back as \07.
                if (_pdfw_putc(a, sb, 92) != 0)                    { return 0 - 1; }
                if (_pdfw_putc(a, sb, 48 + ((c / 64) % 8)) != 0)   { return 0 - 1; }
                if (_pdfw_putc(a, sb, 48 + ((c / 8) % 8)) != 0)    { return 0 - 1; }
                if (_pdfw_putc(a, sb, 48 + (c % 8)) != 0)          { return 0 - 1; }
            } else {
                if (_pdfw_putc(a, sb, c) != 0) { return 0 - 1; }
            }
            i = i + 1;
        }
    }
    return _pdfw_putc(a, sb, 41);
}

# Emit a PDF literal string through default_alloc().
fn _pdfw_litstr(sb, s: Str): i64 {
    return _pdfw_litstr_a(default_alloc(), sb, s);
}

# Emit a PDF hexadecimal string: '<' + two uppercase hex digits per byte + '>'.
# Always an even digit count, so the reader's odd-final-nibble padding rule is
# never exercised by our own output.
fn _pdfw_hexstr_a(a, sb, s: Str): i64 {
    if (_pdfw_putc(a, sb, 60) != 0) { return 0 - 1; }
    if (s != 0) {
        var p = str_data(s);
        var n = str_len(s);
        var i = 0;
        while (i < n) {
            var c = load8(p + i);
            if (_pdfw_putc(a, sb, _pdfw_hexdig(c / 16)) != 0) { return 0 - 1; }
            if (_pdfw_putc(a, sb, _pdfw_hexdig(c % 16)) != 0) { return 0 - 1; }
            i = i + 1;
        }
    }
    return _pdfw_putc(a, sb, 62);
}

# Emit a PDF hexadecimal string through default_alloc().
fn _pdfw_hexstr(sb, s: Str): i64 {
    return _pdfw_hexstr_a(default_alloc(), sb, s);
}

# --- composites -------------------------------------------------------------

# Emit an array: '[' elements separated by a single space ']'.
#
# The separator is unconditional. PDF only REQUIRES one between two tokens that
# would otherwise merge — two numbers, a number and a keyword — but working out
# which pairs those are at emit time is a per-pair correctness question, and
# getting it wrong turns "[1 2]" into "[12]", a different array that parses
# perfectly. One space per gap costs one byte and cannot be wrong.
fn _pdfw_array(a, sb, o, depth): i64 {
    if (_pdfw_putc(a, sb, 91) != 0) { return 0 - 1; }
    var v = _pdfo_vec(o);
    if (v != 0) {
        var n = vec_len(v);
        var i = 0;
        while (i < n) {
            if (i > 0) {
                if (_pdfw_putc(a, sb, 32) != 0) { return 0 - 1; }
            }
            if (_pdfw_obj(a, sb, vec_get(v, i), depth + 1) != 0) { return 0 - 1; }
            i = i + 1;
        }
    }
    return _pdfw_putc(a, sb, 93);
}

# Emit a dictionary: '<<' /Key value pairs in INSERTION ORDER '>>'.
#
# Insertion order, not sorted order, because it is what makes the writer's
# output byte-stable and the round-trip fixtures comparable with str_eq rather
# than with a set comparison.
fn _pdfw_dict(a, sb, o, depth): i64 {
    if (_pdfw_kw(a, sb, "<<") != 0) { return 0 - 1; }
    var v = _pdfo_vec(o);
    if (v != 0) {
        var n = vec_len(v);
        var i = 0;
        while (i < n) {
            var pr = vec_get(v, i);
            if (pr == 0) { return 0 - 1; }
            if (i > 0) {
                if (_pdfw_putc(a, sb, 32) != 0) { return 0 - 1; }
            }
            if (_pdfw_name_a(a, sb, load64(pr)) != 0) { return 0 - 1; }
            if (_pdfw_putc(a, sb, 32) != 0)           { return 0 - 1; }
            if (_pdfw_obj(a, sb, load64(pr + 8), depth + 1) != 0) { return 0 - 1; }
            i = i + 1;
        }
    }
    return _pdfw_kw(a, sb, ">>");
}

# Emit a stream dictionary with /Length forced to `length`, dropping whatever
# /Length the cell happens to carry.
#
# ONE SOURCE for the byte count (D9). A parsed stream's dict holds the /Length
# the FILE claimed, which may be an indirect reference or simply wrong; a
# writer-built stream has none at all. Either way the only number that can be
# correct is the one measured from the payload Str about to be appended, so
# that is the only one emitted. /Length goes last, after the preserved keys,
# which keeps /Filter and /DecodeParms in the order the reader saw them.
fn _pdfw_dict_with_length(a, sb, d, length, depth): i64 {
    if (_pdfw_kw(a, sb, "<<") != 0) { return 0 - 1; }
    var emitted = 0;
    var v = _pdfo_vec(d);
    if (v != 0) {
        var n = vec_len(v);
        var i = 0;
        while (i < n) {
            var pr = vec_get(v, i);
            if (pr == 0) { return 0 - 1; }
            var ks = load64(pr);
            var skip = 0;
            if (ks != 0) {
                if (str_len(ks) == 6) {
                    if (memeq(str_data(ks), "Length", 6) == 1) { skip = 1; }
                }
            }
            if (skip == 0) {
                if (emitted > 0) {
                    if (_pdfw_putc(a, sb, 32) != 0) { return 0 - 1; }
                }
                if (_pdfw_name_a(a, sb, ks) != 0) { return 0 - 1; }
                if (_pdfw_putc(a, sb, 32) != 0)   { return 0 - 1; }
                if (_pdfw_obj(a, sb, load64(pr + 8), depth + 1) != 0) { return 0 - 1; }
                emitted = emitted + 1;
            }
            i = i + 1;
        }
    }
    if (emitted > 0) {
        if (_pdfw_putc(a, sb, 32) != 0) { return 0 - 1; }
    }
    if (_pdfw_kw(a, sb, "/Length ") != 0) { return 0 - 1; }
    if (_pdfw_num(a, sb, length) != 0)    { return 0 - 1; }
    return _pdfw_kw(a, sb, ">>");
}

# Emit a stream object: its dictionary, then the row-3 body layout (D9, §6.2).
#
#     <<...  /Length N>>
#     stream<LF>
#     <exactly N payload bytes, last one NOT an EOL>
#     endstream
#
# Two details are load-bearing.
#
# The EOL after `stream` is a bare LF, never a bare CR: PDF 32000-1 §7.3.8.1
# allows CRLF or LF and forbids a lone CR, and the reader refuses one loudly,
# so emitting one would make bayan unable to read its own output.
#
# There is NO EOL between the payload and `endstream`, and the payload never
# ends on one either. §7.3.8.1 says `endstream` SHOULD be preceded by an EOL —
# it is a SHOULD, every checker and viewer accepts zero, and this is the only
# one of the four possible layouts in which BOTH an off-by-one-short and an
# off-by-one-long /Length are detectable. Trading the SHOULD for a gate that a
# byte-count bug cannot slide past is the whole point: with a trailing EOL,
# /Length + 1 simply eats it and the broken file ships green.
#
# The bytes emitted are the RAW (still-filtered) payload when the cell has one,
# because that is what the dictionary's /Filter describes. Only a cell with no
# raw form — one the writer built — falls back to the decoded slot.
fn _pdfw_stream(a, sb, o, depth): i64 {
    var dict = _pdfo_a(o);
    var data = _pdfo_b(o);
    if (data == 0) { data = _pdfo_c(o); }
    var length = 0;
    if (data != 0) { length = str_len(data); }
    # Forward the caller's depth. Hard-coding 1 here made PTAG_STREAM the one
    # composite arm that reset the counter, so _PDF_MAX_DEPTH never fired
    # through a stream and a dict holding its own stream recursed forever.
    if (_pdfw_dict_with_length(a, sb, dict, length, depth) != 0) { return 0 - 1; }
    if (_pdfw_kw(a, sb, "\nstream\n") != 0) { return 0 - 1; }
    # _pdfw_bytes, never _pdfw_kw: a deflated payload contains NUL bytes with
    # near-certainty and strlen-based appending would truncate there (G10).
    if (_pdfw_bytes(a, sb, data) != 0)     { return 0 - 1; }
    return _pdfw_kw(a, sb, "endstream");
}

# Emit any PdfObj. The recursive core, depth-capped by _PDF_MAX_DEPTH so a
# cyclic or pathologically nested tree cannot blow the native stack.
#
# A 0 cell is a failure, not a silently-emitted `null`: the only way to reach
# one is a half-built dictionary or an array slot that never got filled, and
# turning that into valid-looking output is exactly the silent mis-parse this
# module refuses to produce.
fn _pdfw_obj(a, sb, o, depth): i64 {
    if (sb == 0) { return 0 - 1; }
    if (o == 0)  { return 0 - 1; }
    if (depth >= _PDF_MAX_DEPTH) { return 0 - 1; }
    var t = load64(o);
    if (t == PTAG_NULL) { return _pdfw_kw(a, sb, "null"); }
    if (t == PTAG_BOOL) {
        if (load64(o + 8) == 0) { return _pdfw_kw(a, sb, "false"); }
        return _pdfw_kw(a, sb, "true");
    }
    if (t == PTAG_INT)  { return _pdfw_num(a, sb, load64(o + 8)); }
    if (t == PTAG_REAL) { return _pdfw_real_a(a, sb, load64(o + 8), load64(o + 16)); }
    if (t == PTAG_NAME) { return _pdfw_name_a(a, sb, load64(o + 8)); }
    if (t == PTAG_STR) {
        # Slot b records the SOURCE form. Re-emitting a <hex> string as a
        # literal would still denote the same bytes, but it would break the
        # token-exact round trip the object model is built around.
        if (load64(o + 16) == 1) { return _pdfw_hexstr_a(a, sb, load64(o + 8)); }
        return _pdfw_litstr_a(a, sb, load64(o + 8));
    }
    if (t == PTAG_ARR)    { return _pdfw_array(a, sb, o, depth); }
    if (t == PTAG_DICT)   { return _pdfw_dict(a, sb, o, depth); }
    if (t == PTAG_STREAM) { return _pdfw_stream(a, sb, o, depth); }
    if (t == PTAG_REF) {
        # "N G R" — the three tokens the lexer reads back with its three-token
        # lookahead. Both separators are mandatory: "1 0R" is not a reference.
        if (_pdfw_num(a, sb, load64(o + 8)) != 0)  { return 0 - 1; }
        if (_pdfw_putc(a, sb, 32) != 0)            { return 0 - 1; }
        if (_pdfw_num(a, sb, load64(o + 16)) != 0) { return 0 - 1; }
        if (_pdfw_putc(a, sb, 32) != 0)            { return 0 - 1; }
        return _pdfw_kw(a, sb, "R");
    }
    return 0 - 1;
}

# === Object serialisation — public ===========================================

# Serialise one object to PDF syntax bytes, allocating through `a`.
#
# The exact inverse of bayan_pdf_obj_parse_*: feeding the result back through
# the parser yields a cell that bayan_pdf_obj_eq reports as equal, which is the
# assertion §7.2 is written against. Returns the empty Str on failure — a null
# or malformed cell, a nesting depth past _PDF_MAX_DEPTH, or OOM — never 0, so
# a caller running str_len() on the result cannot fault.
fn bayan_pdf_obj_to_bytes_a(a, o): Str {
    if (o == 0) { return _pdfo_empty_bytes(); }
    var sb = str_builder_new_a(a);
    if (sb == 0) { return _pdfo_empty_bytes(); }
    if (_pdfw_obj(a, sb, o, 0) != 0) { return _pdfo_empty_bytes(); }
    var out = str_builder_build_a(a, sb);
    if (out == 0) { return _pdfo_empty_bytes(); }
    return out;
}

# Serialise one object to PDF syntax bytes through default_alloc().
fn bayan_pdf_obj_to_bytes(o): Str {
    return bayan_pdf_obj_to_bytes_a(default_alloc(), o);
}

# === Document handle, cross-reference, and the reader ========================
#
# This section owns three things that only make sense together:
#
#   1. THE DOCUMENT RECORD. One PdfDoc serves both directions (D5). `mode`
#      says which, `magic` says whether the pointer is a document at all — in
#      an i64-everywhere language that compare is the only boundary check the
#      type system can offer, so every public entry starts with _pdfe_magic.
#
#   2. THE CROSS-REFERENCE. Classic 20-byte-entry tables, PDF-1.5 cross-
#      reference streams, /Prev chains, and the hybrid /XRefStm key, resolved
#      into one flat table indexed by object number. Every section is read
#      newest-first and every write is FIRST-WINS, which is what makes an
#      incrementally-updated file resolve to its newest revision.
#
#   3. THE READER. Objects are parsed LAZILY: the cross-reference gives a byte
#      offset (or an object-stream slot), and _pdfp_get parses that one object
#      the first time it is asked for and memoises the cell. Nothing walks the
#      body linearly, so opening a 400 MB file to read its page count costs a
#      xref parse and nothing else.
#
# WHY THE READER REFUSES TO GUESS. Every failure below names a byte offset and
# stops. There is deliberately no "scan forward for the next `N 0 obj`" repair
# path, no "the /Length looked wrong so search for endstream", no "the entry
# was 19 bytes so resynchronise on the next digit". Each of those repairs turns
# a file the producer got wrong into a document whose contents are a guess, and
# a guess presented as an extraction is the exact failure this module exists to
# avoid. A file that needs repair is a file the caller should be told about.

# Result variants for the two _r loaders. Prefixed `Pdf` because enum variant
# names share one global namespace (json.cyr:18-21) — a bare `IoErr` here would
# collide with IoError's own variants.
enum PdfError {
    PdfIoErr;
    PdfParseErr;
    PdfFlateErr;
    PdfXrefErr;
    PdfEncryptErr;
    PdfOther;
}

# --- record sizes -----------------------------------------------------------
#
# PdfDoc (160) — the document handle, SHARED by writer and reader.
#   +0   magic     PDF_MAGIC
#   +8   mode      PDF_MODE_WRITE | PDF_MODE_READ
#   +16  alloc     Allocator; EVERY allocation in this doc routes through it
#   +24  objs      vec<PdfObj*>   index == object number; slot 0 always 0
#   +32  pages     vec<PdfPage*>
#   +40  fonts     vec<PdfFont*>
#   +48  trailer   PdfObj* dict (reader: merged first-wins across /Prev)
#   +56  catalog   PdfObj* dict (/Type /Catalog)
#   +64  ptree     PdfObj* dict (/Type /Pages), root of the page tree
#   +72  info      PdfObj* dict, or 0
#   +80  src       Str* reader: the source buffer (BORROWED); writer: 0
#   +88  xref      ptr to xref_n * _PDF_XREF_SIZE bytes, or 0
#   +96  xref_n    trailer /Size, after the admission rule
#   +104 cache     ptr to xref_n * 8 bytes: 0 unresolved, 1 RESOLVING, else PdfObj*
#   +112 version   14..17 for "%PDF-1.4".."%PDF-1.7"
#   +120 flags     bit0 compress  bit1 sealed  bit2 id_set
#                  bit3 encrypted bit4 pages_walked
#   +128 err_msg   cstring, FIRST error only, or 0
#   +136 err_pos   byte offset into src, or 0 - 1 for writer-side errors
#   +144 err_count total diagnostics, including non-fatal per-object ones
#   +152 next_font next /F<k> resource index
#   +160 fmaps     vec<i64>, alternating {PdfObj* font, PdfFontMap*} — the
#                  reader's per-font byte-to-Unicode decode cache (§_pdfu_),
#                  built lazily on the first extraction that names the font
#   +168 gen       monotonic document generation. alloc_reset() rewinds the
#                  bump allocator and a PdfDoc is the first thing a parse
#                  allocates, so document POINTERS are recycled. Anything
#                  memoised on a doc pointer must also match this stamp.
#   +176 sdepth    stream-parse re-entry count. An indirect /Length sends
#                  _pdfp_stream_a back through _pdfp_resolve_d ->
#                  _pdfp_indirect_at_a -> _pdfp_stream_a, and each of those
#                  resolve calls starts its own depth at 0, so _PDF_MAX_REFS
#                  never accumulates across the re-entry. Per-DOCUMENT rather
#                  than a module global, so concurrent parses stay independent.
#   +192 walkbud   remaining page-tree node visits. _PDF_MAX_TREE caps DEPTH
#                  only, and the cycle set is path-scoped, so a /Pages node
#                  listing the same kid twice doubles the work per level: 30
#                  such levels is 2^30 visits at depth 30 — well inside the
#                  depth cap and indistinguishable from a hang. A total-work
#                  budget is the bound that actually holds.
#   +184 xrefcap   ALLOCATED entries in the +88/+104 tables. Kept separate from
#                  +96, which is the LOGICAL /Size and bounds which object
#                  numbers may be resolved. Growth is geometric, so capacity
#                  runs ahead of size; conflating them would let a resolve
#                  reach past the declared /Size.
var _PDF_DOC_SIZE = 200;

# PdfPage (64) — one page, SHARED. The reader fills `dict`; the writer fills
# `dict` + `content`. That sharing is what makes bayan_pdf_page_count /
# _page / _page_dict / _page_number / _page_media_box ONE implementation each.
#   +0 doc  +8 num  +16 dict  +24 content(sb*)  +32 fonts(vec<i64>)
#   +40 in_text  +48 gdepth  +56 index
var _PDF_PAGE_SIZE = 64;

# PdfFont (32) — one document-scoped standard-14 font resource.
#   +0 std_id  +8 objnum  +16 resname(Str*)  +24 reserved
var _PDF_FONT_SIZE = 32;

# PdfObjStm (32) — one decoded /Type /ObjStm container.
#   +0 container  +8 data(Str*)  +16 first  +24 index(vec<i64>, 2n entries)
var _PDF_OBJSTM_SIZE = 32;

# Flag bits in PdfDoc + 120. Named because `load64(doc + 120) & 8` at a call
# site is unreadable and a mistyped bit is a silent behaviour change.
var _PDF_F_COMPRESS = 1;
var _PDF_F_SEALED   = 2;
var _PDF_F_ID_SET   = 4;
var _PDF_F_ENCRYPT  = 8;
var _PDF_F_WALKED   = 16;

# The four page-tree attributes PDF 32000-1 Table 30 marks inheritable. A
# reader that reads only the /Page dict reports "missing /MediaBox" on a large
# fraction of real files, because most producers put it on the root /Pages.
var _PDF_INH_COUNT = 4;

# === _pdfe_ — the document error channel and the handle guard ================

# 1 when `h` is a live PdfDoc; `want_mode` of 0 - 1 accepts either mode.
#
# Handles arrive from consumer code as bare i64, so this compare is the whole
# of the type check. It is also why PdfPage has no magic of its own: a page's
# +0 slot is its document, so guarding that pointer guards the page.
fn _pdfe_magic(h, want_mode): i64 {
    if (h == 0) { return 0; }
    if (load64(h) != PDF_MAGIC) { return 0; }
    if (want_mode < 0) { return 1; }
    if (load64(h + 8) != want_mode) { return 0; }
    return 1;
}

# The document's Allocator. Every writer allocation and every lazily-parsed
# reader object routes through this one slot (D7): a PdfDoc IS an owner, so
# owner-scoping the allocator buys the same zero-growth property as a full set
# of `_a` twins over a third of the surface.
fn _pdfe_alloc_of(doc): i64 {
    if (doc == 0) { return default_alloc(); }
    var a = load64(doc + 16);
    if (a == 0) { return default_alloc(); }
    return a;
}

# Record a diagnostic on the document. FIRST-WINS on the message so the
# earliest failure survives, but err_count is bumped every time — a document
# that limped through with per-object failures can still report how many.
#
# Layout-compatible with _pdfz_err, which writes the same three slots from the
# filter section without depending on anything else in the document.
fn _pdfe_doc_err(doc, msg: cstring, pos): i64 {
    if (doc == 0) { return 0; }
    if (load64(doc) != PDF_MAGIC) { return 0; }
    if (load64(doc + 128) == 0) {
        store64(doc + 128, msg);
        store64(doc + 136, pos);
    }
    store64(doc + 144, load64(doc + 144) + 1);
    return 0;
}

# The warning channel — a /Type0 font on an extracted page, an image stream
# nothing will decode. Warnings share the document's diagnostic channel rather
# than getting slots of their own: err_count is documented as "total errors,
# including non-fatal ones", nothing in this module branches on a warning, and
# a second first-wins channel would be a second place for a diagnostic to hide.
# The position is 0 - 1 because a warning is about the document, not a byte.
fn _pdfe_doc_warn(doc, msg: cstring): i64 {
    return _pdfe_doc_err(doc, msg, 0 - 1);
}

# Copy a parse failure out of a PdfState and onto the document.
fn _pdfe_doc_adopt(doc, ps): i64 {
    if (ps == 0) { return 0; }
    if (load64(ps + 24) == 0) { return 0; }
    return _pdfe_doc_err(doc, load64(ps + 24), load64(ps + 32));
}

# Copy a document failure back into the caller's PdfState, so a caller holding
# only `ps` after a failed bayan_pdf_parse_ctx_a still learns what went wrong.
fn _pdfe_ps_adopt(ps, doc): i64 {
    if (ps == 0) { return 0; }
    if (doc == 0) { return 0; }
    if (load64(ps + 24) != 0) { return 0; }
    if (load64(doc + 128) == 0) { return 0; }
    store64(ps + 24, load64(doc + 128));
    store64(ps + 32, load64(doc + 136));
    return 0;
}

# First error recorded on the document; "" when clean.
fn bayan_pdf_doc_error(doc): i64 {
    if (_pdfe_magic(doc, 0 - 1) == 0) { return ""; }
    if (load64(doc + 128) == 0) { return ""; }
    return load64(doc + 128);
}

# Byte offset of the document's first error, or 0 - 1 (which is also what a
# writer-side error reports, since it has no source file to point into).
fn bayan_pdf_doc_error_pos(doc): i64 {
    if (_pdfe_magic(doc, 0 - 1) == 0) { return 0 - 1; }
    return load64(doc + 136);
}

# Total diagnostics recorded, including non-fatal per-object ones.
fn bayan_pdf_doc_error_count(doc): i64 {
    if (_pdfe_magic(doc, 0 - 1) == 0) { return 0; }
    return load64(doc + 144);
}

# === The document record =====================================================

# Allocate and seed a PdfDoc in `mode`. 0 on OOM.
#
# alloc() does NOT zero (it is a bump allocator over recycled chunks), so every
# slot is written explicitly. A half-initialised handle here would read another
# document's trailer pointer out of recycled memory.
fn _pdfe_doc_new_a(a, mode): i64 {
    var d = alloc_via(a, _PDF_DOC_SIZE);
    if (d == 0) { return 0; }
    var i = 0;
    while (i < _PDF_DOC_SIZE) { store64(d + i, 0); i = i + 8; }
    store64(d,       PDF_MAGIC);
    store64(d + 8,   mode);
    store64(d + 16,  a);
    store64(d + 112, 17);                 # default output version, PDF 1.7
    store64(d + 136, 0 - 1);              # no error yet
    # Stamp a fresh generation. Document pointers are recycled by alloc_reset(),
    # so every cache keyed on `doc` must also compare this.
    _pdf_doc_gen = _pdf_doc_gen + 1;
    store64(d + 168, _pdf_doc_gen);
    store64(d + 192, _PDF_MAX_WALK);      # page-tree total-work budget
    var objs = vec_new_a(a);
    if (objs == 0) { return 0; }
    # Object number 0 is permanently the free-list head and can never name an
    # object, so slot 0 is a hole. Pushing it now makes vec index == object
    # number for every later push, which is the whole of the numbering scheme
    # (D6) — there is no closed-form offset arithmetic to get wrong.
    if (vec_push_a(a, objs, 0) < 0) { return 0; }
    store64(d + 24, objs);
    var pages = vec_new_a(a);
    if (pages == 0) { return 0; }
    store64(d + 32, pages);
    var fonts = vec_new_a(a);
    if (fonts == 0) { return 0; }
    store64(d + 40, fonts);
    var tr = bayan_pdf_obj_dict_new_a(a);
    if (tr == 0) { return 0; }
    store64(d + 48, tr);
    # A recycled doc pointer would otherwise inherit a dead document's
    # decompression total from the filter section's side table.
    _pdfz_budget_reset(d);
    return d;
}

# Allocate a writer document. `a` is stored at +16 and EVERY later writer
# allocation routes through it. 0 on OOM.
fn bayan_pdf_new_a(a): i64 {
    return _pdfe_doc_new_a(a, PDF_MODE_WRITE);
}

# Allocate a writer document on the default allocator.
fn bayan_pdf_new(): i64 { return bayan_pdf_new_a(default_alloc()); }

# === Writer-side document settings ==========================================

# Set the output version. 14..17 ("%PDF-1.4".."%PDF-1.7"); 0 - 1 otherwise.
fn bayan_pdf_set_version(doc, v): i64 {
    if (_pdfe_magic(doc, PDF_MODE_WRITE) == 0) { return 0 - 1; }
    if (v < 14 || v > 17) {
        _pdfe_doc_err(doc, "pdf version must be 14..17 (PDF 1.4 through 1.7)", 0 - 1);
        return 0 - 1;
    }
    store64(doc + 112, v);
    return 0;
}

# Turn Flate compression of content streams on or off.
#
# Asking for compression with no deflate hook installed is 0 - 1 AND a loud
# document error — NEVER a silent fallback to uncompressed. A caller who asked
# for compression and did not get it has a size budget that is now wrong, and
# finding that out from a file listing three weeks later is not a fix.
fn bayan_pdf_set_compress(doc, on): i64 {
    if (_pdfe_magic(doc, PDF_MODE_WRITE) == 0) { return 0 - 1; }
    var f = load64(doc + 120);
    if (on == 0) {
        store64(doc + 120, f - (f & _PDF_F_COMPRESS));
        return 0;
    }
    if (on != 1) { return 0 - 1; }
    if (_pdf_deflate_fp == 0) {
        _pdfe_doc_err(doc,
          "compression requested but no deflate hook is installed (call bayan_pdf_set_deflate)",
          0 - 1);
        return 0 - 1;
    }
    store64(doc + 120, f | _PDF_F_COMPRESS);
    return 0;
}

# 1 when `key` is one of the eight /Info keys PDF 32000-1 Table 317 defines.
# Anything else is refused rather than written through: an /Info dictionary is
# not a free-form bag, and a viewer that ignores an unknown key makes the
# refusal invisible if it is not made here.
fn _pdfe_info_key_ok(key: cstring): i64 {
    if (streq(key, "Title") == 1) { return 1; }
    if (streq(key, "Author") == 1) { return 1; }
    if (streq(key, "Subject") == 1) { return 1; }
    if (streq(key, "Keywords") == 1) { return 1; }
    if (streq(key, "Creator") == 1) { return 1; }
    if (streq(key, "Producer") == 1) { return 1; }
    if (streq(key, "CreationDate") == 1) { return 1; }
    if (streq(key, "ModDate") == 1) { return 1; }
    return 0;
}

# UTF-8 Str -> UTF-16BE bytes with a leading FE FF byte-order mark, the form
# PDF 32000-1 §7.9.2.2 defines for a text string that WinAnsi cannot hold.
# Returns 0 (with the last-error mirror set by _pdfg_utf8_next's caller) on
# malformed UTF-8.
#
# SIZING: a codepoint is at least one UTF-8 byte and at most two UTF-16 code
# units, so 2 + 4n is an exact upper bound. + 1 for the NUL, which also dodges
# alloc(0) returning 0 on empty input (G15).
fn _pdfe_utf16be_a(a, s: Str): Str {
    if (s == 0) { return 0; }
    var n = str_len(s);
    var p = str_data(s);
    var out = alloc_via(a, n * 4 + 3);
    if (out == 0) { return 0; }
    store8(out,     254);
    store8(out + 1, 255);
    var w = 2;
    var i = 0;
    var dec[16];                    # 16 BYTES == the two i64 slots written (G2)
    while (i < n) {
        if (_pdfg_utf8_next(p, n, i, &dec) == 0) {
            _pdf_err_msg = "malformed UTF-8 in a pdf text string";
            _pdf_err_pos = i;
            return 0;
        }
        var cp = load64(&dec);
        i = i + load64(&dec + 8);
        if (cp < 65536) {
            # Division, not `>>`: `>>` is LOGICAL in Cyrius and `>>>` is the
            # arithmetic one (G12). cp is non-negative here so both would work,
            # but arithmetic that never depends on which shift is which cannot
            # be broken by someone reading the line with JS reflexes.
            store8(out + w,     (cp / 256) % 256);
            store8(out + w + 1, cp % 256);
            w = w + 2;
        } else {
            var v = cp - 65536;
            var hi = 55296 + (v / 1024);
            var lo = 56320 + (v % 1024);
            store8(out + w,     (hi / 256) % 256);
            store8(out + w + 1, hi % 256);
            store8(out + w + 2, (lo / 256) % 256);
            store8(out + w + 3, lo % 256);
            w = w + 4;
        }
    }
    store8(out + w, 0);
    return str_new_a(a, out, w);
}

# Set one /Info entry. 0 on success, 0 - 1 on a rejected key or a value that is
# not valid UTF-8.
#
# The value is WinAnsi-transcoded when it can be and emitted as a UTF-16BE hex
# string when it cannot. Transcoding is not optional: PDF text strings are
# WinAnsi or UTF-16BE, never UTF-8, and writing UTF-8 bytes into a literal
# string produces mojibake in every viewer rather than an error anywhere.
fn bayan_pdf_set_info(doc, key: cstring, value: Str): i64 {
    if (_pdfe_magic(doc, PDF_MODE_WRITE) == 0) { return 0 - 1; }
    if (_pdfe_info_key_ok(key) == 0) {
        _pdfe_doc_err(doc, "unsupported /Info key", 0 - 1);
        return 0 - 1;
    }
    if (value == 0) { return 0 - 1; }
    var a = _pdfe_alloc_of(doc);
    var info = load64(doc + 72);
    if (info == 0) {
        info = bayan_pdf_obj_dict_new_a(a);
        if (info == 0) { return 0 - 1; }
        store64(doc + 72, info);
    }
    var o = 0;
    var enc = bayan_pdf_winansi_a(a, value, PDF_WINANSI_STRICT, 0);
    if (enc != 0) {
        o = bayan_pdf_obj_string_new_a(a, enc);
    } else {
        var u = _pdfe_utf16be_a(a, value);
        if (u == 0) {
            _pdfe_doc_err(doc, "/Info value is not valid UTF-8", 0 - 1);
            return 0 - 1;
        }
        o = bayan_pdf_obj_hex_new_a(a, u);
    }
    if (o == 0) { return 0 - 1; }
    return bayan_pdf_obj_dict_set_a(a, info, key, o);
}

# Set the file identifier: /ID [<a> <b>], each exactly 16 bytes. 0 - 1 on any
# other length.
#
# The pair lives in the document's trailer dictionary rather than in a slot of
# its own — the trailer is where it has to end up anyway, PdfDoc's 160-byte
# layout is frozen, and one storage location cannot drift out of sync with
# itself. Left unset, the writer derives it by FNV-1a over the finished body so
# an unchanged document produces an unchanged file.
fn bayan_pdf_set_id(doc, id_a: Str, id_b: Str): i64 {
    if (_pdfe_magic(doc, PDF_MODE_WRITE) == 0) { return 0 - 1; }
    if (id_a == 0 || id_b == 0) { return 0 - 1; }
    if (str_len(id_a) != 16 || str_len(id_b) != 16) {
        _pdfe_doc_err(doc, "/ID halves must be exactly 16 bytes each", 0 - 1);
        return 0 - 1;
    }
    var a = _pdfe_alloc_of(doc);
    var arr = bayan_pdf_obj_array_new_a(a);
    if (arr == 0) { return 0 - 1; }
    var x = bayan_pdf_obj_hex_new_a(a, id_a);
    var y = bayan_pdf_obj_hex_new_a(a, id_b);
    if (x == 0 || y == 0) { return 0 - 1; }
    if (bayan_pdf_obj_array_push_a(a, arr, x) < 0) { return 0 - 1; }
    if (bayan_pdf_obj_array_push_a(a, arr, y) < 0) { return 0 - 1; }
    if (bayan_pdf_obj_dict_set_a(a, load64(doc + 48), "ID", arr) < 0) { return 0 - 1; }
    store64(doc + 120, load64(doc + 120) | _PDF_F_ID_SET);
    return 0;
}

# Width of a page preset in MILLI-POINTS, or 0 - 1 for an unknown id.
fn bayan_pdf_page_size_w(size_id): i64 {
    if (size_id == PDF_PAGE_A4)     { return 595000; }
    if (size_id == PDF_PAGE_LETTER) { return 612000; }
    if (size_id == PDF_PAGE_LEGAL)  { return 612000; }
    return 0 - 1;
}

# Height of a page preset in MILLI-POINTS, or 0 - 1 for an unknown id.
fn bayan_pdf_page_size_h(size_id): i64 {
    if (size_id == PDF_PAGE_A4)     { return 842000; }
    if (size_id == PDF_PAGE_LETTER) { return 792000; }
    if (size_id == PDF_PAGE_LEGAL)  { return 1008000; }
    return 0 - 1;
}

# === _pdfx_ — the cross-reference table ======================================
#
# One flat array of PdfXrefEnt {kind, a, b} indexed by object number:
#
#   kind 0 - 1   UNSET. Not a PDF state — the sentinel that makes FIRST-WINS
#                work, because kind 0 (free) is a real value a newer section
#                is entitled to assert and an older one must not overwrite.
#   kind 0       free / absent. A reference to it resolves to `null`.
#   kind 1       uncompressed:  a = byte offset, b = generation
#   kind 2       in an object stream: a = container object number, b = index
#
# Sections are read newest-first (startxref, then each /Prev), and _pdfx_set
# never overwrites a set entry. That single rule is the whole of incremental-
# update support: the newest revision of every object wins by construction
# rather than by comparing revision numbers nobody records.

# Grow the table to hold at least `size` objects, applying the /Size admission
# rule. 1 on success, 0 with the reason recorded.
#
# THE ADMISSION RULE IS LOAD-BEARING, NOT DECORATION. `size <= len / 8 + 16`
# self-scales: an object needs at least eight bytes of file to exist, so a
# 40-byte hostile file cannot claim /Size 2000000 and induce a 50 MB
# allocation. The absolute cap alone would let it induce a 50 MB one.
fn _pdfx_alloc_table(doc, size): i64 {
    if (doc == 0) { return 0; }
    if (size <= 0) {
        _pdfe_doc_err(doc, "cross-reference /Size must be positive", 0 - 1);
        return 0;
    }
    if (size > _PDF_MAX_OBJS) {
        _pdfe_doc_err(doc, "cross-reference /Size exceeds the object limit", 0 - 1);
        return 0;
    }
    var src = load64(doc + 80);
    if (src != 0) {
        if (size > str_len(src) / 8 + 16) {
            _pdfe_doc_err(doc,
              "cross-reference /Size is impossible for a file this small", 0 - 1);
            return 0;
        }
    }
    var old_n = load64(doc + 96);
    var cap   = load64(doc + 184);
    if (size <= cap) {
        # Capacity already covers it; only the logical size moves.
        if (size > old_n) { store64(doc + 96, size); }
        return 1;
    }

    # Grow GEOMETRICALLY. _pdfx_read_subsec calls this once per subsection and
    # nothing is freed, so growing to the exact request made a table of N
    # one-entry subsections allocate O(N^2) bytes — ~38,000 subsections in a
    # 1 MB file is tens of gigabytes of bump allocation. Doubling makes the
    # total linear in the final size.
    var want = size;
    if (cap > 0) {
        var dbl = cap * 2;
        if (dbl > want) { want = dbl; }
        if (want > _PDF_MAX_OBJS) { want = _PDF_MAX_OBJS; }
        if (want < size) { want = size; }
    }
    var a = _pdfe_alloc_of(doc);
    var nx = alloc_via(a, want * _PDF_XREF_SIZE);
    var nc = alloc_via(a, want * 8);
    if (nx == 0 || nc == 0) {
        _pdfe_doc_err(doc, "out of memory allocating the cross-reference table", 0 - 1);
        return 0;
    }
    var i = 0;
    while (i < want) {
        # &TABLE + i is a BYTE offset in Cyrius, so a 24-byte entry strides by
        # i * _PDF_XREF_SIZE and never by i alone (G3).
        store64(nx + i * _PDF_XREF_SIZE,      0 - 1);   # UNSET
        store64(nx + i * _PDF_XREF_SIZE + 8,  0);
        store64(nx + i * _PDF_XREF_SIZE + 16, 0);
        store64(nc + i * 8, 0);
        i = i + 1;
    }
    var ox = load64(doc + 88);
    var oc = load64(doc + 104);
    if (ox != 0) {
        i = 0;
        while (i < old_n) {
            store64(nx + i * _PDF_XREF_SIZE,      load64(ox + i * _PDF_XREF_SIZE));
            store64(nx + i * _PDF_XREF_SIZE + 8,  load64(ox + i * _PDF_XREF_SIZE + 8));
            store64(nx + i * _PDF_XREF_SIZE + 16, load64(ox + i * _PDF_XREF_SIZE + 16));
            store64(nc + i * 8, load64(oc + i * 8));
            i = i + 1;
        }
    }
    store64(doc + 88,  nx);
    store64(doc + 96,  size);
    store64(doc + 104, nc);
    store64(doc + 184, want);
    return 1;
}

# The entry for object `num`, or 0 when the table does not reach it.
fn _pdfx_get(doc, num): i64 {
    if (doc == 0) { return 0; }
    if (num < 0)  { return 0; }
    var x = load64(doc + 88);
    if (x == 0) { return 0; }
    if (num >= load64(doc + 96)) { return 0; }
    return x + num * _PDF_XREF_SIZE;
}

# Record an entry. `over` is 0 for the normal FIRST-WINS rule and 1 for the
# hybrid-reference case, where a /XRefStm's entries are allowed to replace the
# free entries the classic table wrote for the same objects (PDF 32000-1
# §7.5.8.4 — a hybrid file's classic table deliberately marks its compressed
# objects free so that a 1.4 reader ignores them). 1 on success.
fn _pdfx_set(doc, num, kind, ea, eb, over): i64 {
    if (num < 0) { return 0; }
    if (_pdfx_alloc_table(doc, num + 1) == 0) { return 0; }
    var e = _pdfx_get(doc, num);
    if (e == 0) { return 0; }
    var k = load64(e);
    if (k != 0 - 1) {
        if (over == 0)  { return 1; }
        if (k != 0)     { return 1; }
    }
    store64(e,      kind);
    store64(e + 8,  ea);
    store64(e + 16, eb);
    return 1;
}

# The highest object number any section actually described, or 0.
fn _pdfx_highest(doc): i64 {
    var n = load64(doc + 96);
    var i = n - 1;
    while (i > 0) {
        var e = _pdfx_get(doc, i);
        if (e != 0) {
            if (load64(e) != 0 - 1) { return i; }
        }
        i = i - 1;
    }
    return 0;
}

# Merge a section's trailer into the document's, FIRST-WINS.
#
# The newest section is read first, so its /Root, /Info and /Encrypt win over
# every older revision's. Merging the other way round would open an
# incrementally-updated file at its ORIGINAL revision while reporting success.
fn _pdfx_merge_trailer(doc, t): i64 {
    if (t == 0) { return 0; }
    if (_pdfo_tag(t) != PTAG_DICT) { return 0; }
    var a = _pdfe_alloc_of(doc);
    var dst = load64(doc + 48);
    if (dst == 0) { return 0; }
    var dv = _pdfo_vec(dst);
    var sv = _pdfo_vec(t);
    if (dv == 0 || sv == 0) { return 0; }
    var n = vec_len(sv);
    var i = 0;
    while (i < n) {
        var p = vec_get(sv, i);
        if (p != 0) {
            var ks = load64(p);
            if (ks != 0) {
                if (_pdfo_dict_find(dst, load64(ks), load64(ks + 8)) < 0) {
                    var np = _pdfo_pair_new_a(a, ks, load64(p + 8));
                    if (np != 0) { vec_push_a(a, dv, np); }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

# Byte offset named by the LAST `startxref` in the file, or 0 - 1.
#
# The trailing 2 KB first, then the whole file. "Last" is not a nicety: an
# incrementally-updated PDF appends a new body, a new cross-reference section
# and a new `startxref` for every revision, so the FIRST occurrence names the
# document as it stood before every later edit. The cursor is restored, so this
# is a pure query on the state.
fn _pdfx_find_startxref(ps): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var saved = load64(ps + 16);
    var from = len - 2048;
    if (from < 0) { from = 0; }
    var i = _pdfe_rmemfind(buf + from, len - from, "startxref", 9);
    if (i >= 0) { i = i + from; }
    else        { i = _pdfe_rmemfind(buf, len, "startxref", 9); }
    if (i < 0) {
        _pdfe_err(ps, "no startxref in the file", len);
        return 0 - 1;
    }
    store64(ps + 16, i + 9);
    _pdfl_skip_ws(ps);
    var o8[8];
    if (_pdfl_probe_unsigned(ps, &o8) == 0) {
        _pdfe_err(ps, "startxref is not followed by a byte offset", load64(ps + 16));
        store64(ps + 16, saved);
        return 0 - 1;
    }
    var off = load64(&o8);
    store64(ps + 16, saved);
    if (off < 0 || off >= len) {
        _pdfe_err(ps, "startxref names an offset outside the file", i);
        return 0 - 1;
    }
    return off;
}

# Read ONE classic cross-reference entry for object `num`.
#
# STRICTLY 20 BYTES: ten digits, a space, five digits, a space, `n` or `f`,
# then two bytes drawn from {" \r", " \n", "\r\n"} — and the cursor advances by
# exactly 20. Not `\s+`, not "skip to the next digit".
#
# The rigidity is the point. pdfcheck.py:370 advances by an unconditional
# `pos += 20`, and so does every other conforming reader, so a 19-byte entry
# does not misread ONE object — it shifts every following entry by a byte and
# turns the rest of the table into offsets that point at the middle of tokens.
# There is no way to tell that apart from a file whose objects genuinely live
# there, so the only honest answer is to refuse at the first short entry.
fn _pdfx_read_entry(doc, ps, num): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var p   = load64(ps + 16);
    if (p + 20 > len) {
        _pdfe_doc_err(doc, "cross-reference entry is truncated", p);
        return 0;
    }
    var i = 0;
    while (i < 10) {
        if (_pdfe_is_digit(load8(buf + p + i)) == 0) {
            _pdfe_doc_err(doc,
              "cross-reference entry is not the required 20-byte form", p);
            return 0;
        }
        i = i + 1;
    }
    if (load8(buf + p + 10) != 32) {
        _pdfe_doc_err(doc, "cross-reference entry is not the required 20-byte form", p);
        return 0;
    }
    i = 11;
    while (i < 16) {
        if (_pdfe_is_digit(load8(buf + p + i)) == 0) {
            _pdfe_doc_err(doc,
              "cross-reference entry is not the required 20-byte form", p);
            return 0;
        }
        i = i + 1;
    }
    if (load8(buf + p + 16) != 32) {
        _pdfe_doc_err(doc, "cross-reference entry is not the required 20-byte form", p);
        return 0;
    }
    var ty = load8(buf + p + 17);
    if (ty != 110 && ty != 102) {
        _pdfe_doc_err(doc, "cross-reference entry type is neither 'n' nor 'f'", p + 17);
        return 0;
    }
    var e1 = load8(buf + p + 18);
    var e2 = load8(buf + p + 19);
    var eol = 0;
    if (e1 == 32 && e2 == 13) { eol = 1; }
    if (e1 == 32 && e2 == 10) { eol = 1; }
    if (e1 == 13 && e2 == 10) { eol = 1; }
    if (eol == 0) {
        _pdfe_doc_err(doc,
          "cross-reference entry does not end with the required two-byte end-of-line",
          p + 18);
        return 0;
    }
    var off = _pdfe_atoi_span(buf + p,      10);
    var gen = _pdfe_atoi_span(buf + p + 11, 5);
    store64(ps + 16, p + 20);
    if (ty == 110) { return _pdfx_set(doc, num, 1, off, gen, 0); }
    return _pdfx_set(doc, num, 0, 0, gen, 0);
}

# Read one `first count` subsection header and its `count` entries. 1 on
# success, 0 with the reason recorded.
fn _pdfx_read_subsec(doc, ps): i64 {
    var o8[8];
    _pdfl_skip_ws(ps);
    var hdr = load64(ps + 16);
    if (_pdfl_probe_unsigned(ps, &o8) == 0) {
        _pdfe_doc_err(doc, "malformed cross-reference subsection header", hdr);
        return 0;
    }
    var first = load64(&o8);
    _pdfl_skip_ws(ps);
    if (_pdfl_probe_unsigned(ps, &o8) == 0) {
        _pdfe_doc_err(doc, "malformed cross-reference subsection header", hdr);
        return 0;
    }
    var count = load64(&o8);
    if (first > _PDF_MAX_OBJS || count > _PDF_MAX_OBJS) {
        _pdfe_doc_err(doc, "cross-reference subsection exceeds the object limit", hdr);
        return 0;
    }
    if (count == 0) { return 1; }
    # Size the table ONCE for the whole subsection. Growing per entry would be
    # quadratic in a table with a hundred thousand objects, and the admission
    # rule inside _pdfx_alloc_table still gates this single request.
    if (_pdfx_alloc_table(doc, first + count) == 0) { return 0; }
    _pdfl_skip_ws(ps);
    var i = 0;
    while (i < count) {
        if (_pdfx_read_entry(doc, ps, first + i) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Big-endian integer over `n` bytes. n is 0..8 by construction (the /W widths
# are validated before this is reached) and 0 bytes is the value 0.
#
# MULTIPLIES rather than shifts. load8 zero-extends so `<< 8` would in fact be
# correct here, but `>>` is LOGICAL and `>>>` is ARITHMETIC in Cyrius — the
# reverse of JS and Java (G12) — and arithmetic that never asks the question
# cannot be broken by a later reader who answers it wrong.
fn _pdfx_be(p, n): i64 {
    var v = 0;
    var i = 0;
    while (i < n) {
        v = v * 256 + load8(p + i);
        i = i + 1;
    }
    return v;
}

# Read a PDF-1.5 cross-reference STREAM. `st` is the already-parsed
# PTAG_STREAM cell. Writes the /Prev offset (or 0 - 1) to `out8`.
#
# /W gives the byte width of each of the three row fields. Width 0 on field 1
# means "the type is 1" — the spec's own default, and a reader that misses it
# reads every entry of such a file as a free object and then reports an empty
# document. Widths 0 on fields 2 and 3 simply make those fields 0.
fn _pdfx_read_stream(doc, ps, st, out8, over): i64 {
    store64(out8, 0 - 1);
    var a = _pdfe_alloc_of(doc);
    var dict = _pdfo_a(st);
    if (_pdfo_tag(dict) != PTAG_DICT) {
        _pdfe_doc_err(doc, "cross-reference stream has no dictionary", load64(ps + 16));
        return 0;
    }
    var ty = bayan_pdf_obj_dict_get(dict, "Type");
    if (bayan_pdf_obj_name_eq(ty, "XRef") == 0) {
        _pdfe_doc_err(doc,
          "startxref does not point at a cross-reference table or a /Type /XRef stream",
          load64(ps + 16));
        return 0;
    }
    var szo = bayan_pdf_obj_dict_get(dict, "Size");
    if (_pdfo_tag(szo) != PTAG_INT) {
        _pdfe_doc_err(doc, "cross-reference stream has no integer /Size", load64(ps + 16));
        return 0;
    }
    var size = load64(szo + 8);
    if (_pdfx_alloc_table(doc, size) == 0) { return 0; }

    var w = bayan_pdf_obj_dict_get(dict, "W");
    if (_pdfo_tag(w) != PTAG_ARR) {
        _pdfe_doc_err(doc, "cross-reference stream has no /W array", load64(ps + 16));
        return 0;
    }
    var wv = _pdfo_vec(w);
    if (vec_len(wv) != 3) {
        _pdfe_doc_err(doc,
          "cross-reference stream /W must have exactly three widths", load64(ps + 16));
        return 0;
    }
    var w0 = bayan_pdf_obj_int_value(vec_get(wv, 0));
    var w1 = bayan_pdf_obj_int_value(vec_get(wv, 1));
    var w2 = bayan_pdf_obj_int_value(vec_get(wv, 2));
    if (w0 < 0 || w1 < 0 || w2 < 0 || w0 > 8 || w1 > 8 || w2 > 8) {
        _pdfe_doc_err(doc, "cross-reference stream /W widths are out of range",
          load64(ps + 16));
        return 0;
    }
    var rowlen = w0 + w1 + w2;
    if (rowlen <= 0) {
        _pdfe_doc_err(doc, "cross-reference stream /W widths are all zero", load64(ps + 16));
        return 0;
    }

    var data = _pdfp_decode_chain_a(a, doc, st);
    if (data == 0) { return 0; }
    var dp = str_data(data);
    var dn = str_len(data);

    # /Index defaults to [0 Size]; when present it is pairs of (first, count).
    var idx = bayan_pdf_obj_dict_get(dict, "Index");
    var pairs = 0;
    var iv = 0;
    if (idx == 0) {
        pairs = 1;
    } else {
        if (_pdfo_tag(idx) != PTAG_ARR) {
            _pdfe_doc_err(doc, "cross-reference stream /Index is not an array",
              load64(ps + 16));
            return 0;
        }
        iv = _pdfo_vec(idx);
        if (vec_len(iv) % 2 != 0) {
            _pdfe_doc_err(doc,
              "cross-reference stream /Index is not a list of first/count pairs",
              load64(ps + 16));
            return 0;
        }
        pairs = vec_len(iv) / 2;
    }

    var pos = 0;
    var k = 0;
    while (k < pairs) {
        var first = 0;
        var count = size;
        if (iv != 0) {
            first = bayan_pdf_obj_int_value(vec_get(iv, k * 2));
            count = bayan_pdf_obj_int_value(vec_get(iv, k * 2 + 1));
        }
        if (first < 0 || count < 0 || first > _PDF_MAX_OBJS || count > _PDF_MAX_OBJS) {
            _pdfe_doc_err(doc, "cross-reference stream /Index is out of range",
              load64(ps + 16));
            return 0;
        }
        if (count > 0) {
            if (_pdfx_alloc_table(doc, first + count) == 0) { return 0; }
        }
        var i = 0;
        while (i < count) {
            if (pos + rowlen > dn) {
                _pdfe_doc_err(doc,
                  "cross-reference stream is shorter than its /Index declares",
                  load64(ps + 16));
                return 0;
            }
            var t1 = 1;
            if (w0 > 0) { t1 = _pdfx_be(dp + pos, w0); }
            var f2 = _pdfx_be(dp + pos + w0, w1);
            var f3 = _pdfx_be(dp + pos + w0 + w1, w2);
            var num = first + i;
            if (t1 == 0)      { _pdfx_set(doc, num, 0, 0,  f3, over); }
            elif (t1 == 1)    { _pdfx_set(doc, num, 1, f2, f3, over); }
            elif (t1 == 2)    { _pdfx_set(doc, num, 2, f2, f3, over); }
            else {
                # §7.5.8.3: a type this build does not define is to be treated
                # as a free entry, not as a reason to abandon the file. It is
                # still recorded, because silently ignoring an unknown row type
                # is how a future extension becomes an empty document.
                _pdfe_doc_warn(doc, "cross-reference stream row has an unknown type");
            }
            pos = pos + rowlen;
            i = i + 1;
        }
        k = k + 1;
    }

    _pdfx_merge_trailer(doc, dict);
    var pv = bayan_pdf_obj_dict_get(dict, "Prev");
    if (_pdfo_tag(pv) == PTAG_INT) { store64(out8, load64(pv + 8)); }
    return 1;
}

# Read a classic `xref` table at `off`, its trailer, and any /XRefStm.
# Writes the /Prev offset (or 0 - 1) to `out8`.
fn _pdfx_read_table(doc, ps, off, seen, out8): i64 {
    store64(out8, 0 - 1);
    var a = _pdfe_alloc_of(doc);
    store64(ps + 16, off);
    if (_pdfl_at(ps, "xref", 4) == 0) {
        _pdfe_doc_err(doc, "startxref does not point at an xref keyword", off);
        return 0;
    }
    store64(ps + 16, off + 4);
    while (1 == 1) {
        _pdfl_skip_ws(ps);
        if (_pdfl_eof(ps) == 1) {
            _pdfe_doc_err(doc, "cross-reference table ends without a trailer",
              load64(ps + 16));
            return 0;
        }
        if (_pdfl_at(ps, "trailer", 7) == 1) {
            store64(ps + 16, load64(ps + 16) + 7);
            break;
        }
        if (_pdfx_read_subsec(doc, ps) == 0) { return 0; }
    }
    _pdfl_skip_ws(ps);
    var tpos = load64(ps + 16);
    var t = _pdfp_obj_a(a, ps);
    if (t == 0) {
        _pdfe_doc_adopt(doc, ps);
        return 0;
    }
    if (_pdfo_tag(t) != PTAG_DICT) {
        _pdfe_doc_err(doc, "trailer is not a dictionary", tpos);
        return 0;
    }
    _pdfx_merge_trailer(doc, t);

    # Hybrid-reference file: the classic table above marked the compressed
    # objects free so a PDF-1.4 reader would skip them, and /XRefStm names a
    # cross-reference stream that describes them for real. Its entries are read
    # with over = 1, so they replace exactly those free entries and nothing
    # else — which is the priority the spec gives them.
    var xs = bayan_pdf_obj_dict_get(t, "XRefStm");
    if (_pdfo_tag(xs) == PTAG_INT) {
        var xoff = load64(xs + 8);
        # `seen` stops a REPEATED offset, but a hybrid file can chain thousands
        # of DISTINCT /XRefStm sections, and this path recurses
        # (_pdfx_read_table -> _pdfx_read_section -> _pdfx_read_table) without
        # passing through _pdfx_load's /Prev counter — so _PDF_MAX_XREF was
        # enforced on one of the two chains only, and the other exhausted the
        # native stack. `seen` accumulates offsets from BOTH chains, so its
        # length is the honest total-sections bound.
        if (vec_len(seen) >= _PDF_MAX_XREF) {
            _pdfe_doc_err(doc, "too many cross-reference sections", xoff);
            return 0;
        }
        if (vec_find(seen, xoff) < 0) {
            if (vec_push_a(a, seen, xoff) >= 0) {
                var tmp8[8];
                if (_pdfx_read_section(doc, ps, xoff, seen, &tmp8, 1) == 0) { return 0; }
            }
        }
    }
    var pv = bayan_pdf_obj_dict_get(t, "Prev");
    if (_pdfo_tag(pv) == PTAG_INT) { store64(out8, load64(pv + 8)); }
    return 1;
}

# Read ONE cross-reference section at `off`, whichever form it takes.
#
# The dispatch is on the keyword alone: `xref` is a classic table, anything
# else must be an indirect object whose stream dictionary says /Type /XRef.
# There is no third case and no sniffing — a byte offset that is neither is a
# refusal, because "probably a table with some junk in front" is precisely the
# guess this reader does not make.
fn _pdfx_read_section(doc, ps, off, seen, out8, over): i64 {
    store64(out8, 0 - 1);
    var len = load64(ps + 8);
    if (off < 0 || off >= len) {
        _pdfe_doc_err(doc, "cross-reference offset is outside the file", off);
        return 0;
    }
    store64(ps + 16, off);
    _pdfl_skip_ws(ps);
    if (_pdfl_at(ps, "xref", 4) == 1) {
        return _pdfx_read_table(doc, ps, load64(ps + 16), seen, out8);
    }
    var a = _pdfe_alloc_of(doc);
    var st = _pdfp_indirect_at_a(a, ps, doc, off, 0 - 1);
    if (st == 0) { return 0; }
    if (_pdfo_tag(st) != PTAG_STREAM) {
        _pdfe_doc_err(doc,
          "startxref does not point at a cross-reference table or a /Type /XRef stream",
          off);
        return 0;
    }
    return _pdfx_read_stream(doc, ps, st, out8, over);
}

# Follow the whole /Prev chain from `start`, newest section first.
#
# TWO guards, because they catch different things (D12). The counter refuses a
# 4,000-section chain of distinct offsets — legal-looking, and a denial of
# service. The visited set refuses a 3-cycle, which the counter would happily
# walk 64 times before noticing. A depth cap alone is not a cycle detector.
fn _pdfx_load(doc, ps, start): i64 {
    var a = _pdfe_alloc_of(doc);
    var seen = vec_new_a(a);
    if (seen == 0) { return 0; }
    var off = start;
    var n = 0;
    var out8[8];
    while (off >= 0) {
        if (n >= _PDF_MAX_XREF) {
            _pdfe_doc_err(doc, "too many cross-reference sections in the /Prev chain", off);
            return 0;
        }
        if (vec_find(seen, off) >= 0) {
            _pdfe_doc_err(doc, "loop in the cross-reference /Prev chain", off);
            return 0;
        }
        if (vec_push_a(a, seen, off) < 0) { return 0; }
        if (_pdfx_read_section(doc, ps, off, seen, &out8, 0) == 0) { return 0; }
        off = load64(&out8);
        n = n + 1;
    }
    return 1;
}

# Check every uncompressed entry against the bytes it names.
#
# This is the reader's own version of the writer's self-check (§6.1): a kind-1
# entry claims object N lives at byte B, so `N G obj` must actually be at B.
# Without this a table that is off by a few bytes — the single most common
# real-world corruption, and what mneme's predicted-offset writer produces —
# parses "successfully" into objects assembled from the middle of other
# objects. The alternative every lenient reader picks is to rescan the file for
# `N 0 obj`; that repairs the file at the cost of making the cross-reference
# advisory, and a reader whose cross-reference is advisory cannot tell a
# corrupt document from a correct one ever again.
fn _pdfx_verify(doc): i64 {
    var src = load64(doc + 80);
    if (src == 0) { return 1; }
    var vps[64];
    _pdfe_state_init(&vps, str_data(src), str_len(src), _pdfe_alloc_of(doc));
    var o8[8];
    var n = load64(doc + 96);
    var num = 1;
    while (num < n) {
        var e = _pdfx_get(doc, num);
        if (e != 0) {
            if (load64(e) == 1) {
                var off = load64(e + 8);
                if (off < 0 || off >= load64(&vps + 8)) {
                    _pdfe_doc_err(doc,
                      "cross-reference offset is outside the file", off);
                    return 0;
                }
                store64(&vps + 16, off);
                # Leading whitespace is tolerated (some producers pad the gap
                # between objects); the object NUMBER is not negotiable.
                _pdfl_skip_ws(&vps);
                if (_pdfl_probe_unsigned(&vps, &o8) == 0) {
                    _pdfe_doc_err(doc,
                      "cross-reference offset does not point at an object header", off);
                    return 0;
                }
                if (load64(&o8) != num) {
                    _pdfe_doc_err(doc,
                      "cross-reference offset points at the wrong object number", off);
                    return 0;
                }
                _pdfl_skip_ws(&vps);
                if (_pdfl_probe_unsigned(&vps, &o8) == 0) {
                    _pdfe_doc_err(doc,
                      "cross-reference offset does not point at an object header", off);
                    return 0;
                }
                _pdfl_skip_ws(&vps);
                if (_pdfl_at(&vps, "obj", 3) == 0) {
                    _pdfe_doc_err(doc,
                      "cross-reference offset does not point at an object header", off);
                    return 0;
                }
            }
        }
        num = num + 1;
    }
    return 1;
}

# === _pdfp_ — the reader ====================================================

# The one-entry object-stream cache, keyed on BOTH the document and the
# container number.
#
# It cannot live in a PdfDoc slot: the 160-byte layout is frozen and every slot
# is spoken for. Static storage is safe here because the key includes the doc
# pointer AND its generation stamp. The pointer alone is NOT enough:
# alloc_reset() rewinds the bump allocator and a PdfDoc is the first allocation
# a parse makes, so the next document lands on the same address and a
# pointer-only key would serve a freed record whose vec and Str words now hold
# unrelated bytes. Sequential reads of a document's objects hit the same
# container repeatedly, which is the access pattern this exists for.
var _pdfp_ostm_doc = 0;
var _pdfp_ostm_gen = 0;
var _pdfp_ostm_num = 0;
var _pdfp_ostm_rec = 0;

# Whether the LAST document parsed carried /Encrypt, for the bayan_pdf_is_
# encrypted(0) spelling: an encrypted file is always a fatal parse, so there is
# no document handle left to ask.
var _pdfp_last_enc = 0;

# Resolve an indirect reference chain, capped at _PDF_MAX_REFS.
#
# Written as a loop rather than recursion — the chain is linear, so a loop
# needs no stack and the cap is a plain counter.
#
# TWO guards, because the counter alone would answer the wrong question. A
# 63-link chain of DISTINCT objects is legal; `6 0 obj 6 0 R endobj` is not,
# and the counter can only say "too deep" about it after 64 pointless lookups.
# The visited set says "cycle" immediately and names the axis correctly — the
# difference between a caller fixing a producer bug and a caller raising a
# limit that was never the problem (D12).
#
# `var vis: i64[64]` is 64 i64 SLOTS, not 64 bytes (G2), and 64 is exactly
# _PDF_MAX_REFS: the depth check above fires first, so the array can never be
# asked to hold a 65th number. `&vis + i * 8` because `&TABLE + i` is a BYTE
# offset in Cyrius (G3).
#
# The `cache[num] == 1` sentinel in _pdfp_get is the third guard on this axis
# and catches the different case where a cycle runs through an object that is
# still being PARSED rather than one already parsed into a reference.
fn _pdfp_resolve_d(doc, o, depth): i64 {
    var vis: i64[64];
    var nv = 0;
    var cur = o;
    var d = depth;
    while (_pdfo_tag(cur) == PTAG_REF) {
        if (d >= _PDF_MAX_REFS) {
            _pdfe_doc_err(doc, "indirect reference chain too deep", 0 - 1);
            return 0;
        }
        var num = _pdfo_a(cur);
        var i = 0;
        while (i < nv) {
            if (load64(&vis + i * 8) == num) {
                _pdfe_doc_err(doc, "reference cycle through this object", 0 - 1);
                return 0;
            }
            i = i + 1;
        }
        if (nv < _PDF_MAX_REFS) {
            store64(&vis + nv * 8, num);
            nv = nv + 1;
        }
        cur = _pdfp_get(doc, num);
        if (cur == 0) { return 0; }
        d = d + 1;
    }
    return cur;
}

# Resolve `key` in dict `d` to an integer, or `dflt` when it is absent or is
# not a number. The reader's most common two-line idiom, written once.
fn _pdfp_dict_num(doc, d, key: cstring, dflt): i64 {
    var v = _pdfp_resolve_d(doc, bayan_pdf_obj_dict_get(d, key), 0);
    if (_pdfo_tag(v) == PTAG_INT)  { return load64(v + 8); }
    if (_pdfo_tag(v) == PTAG_REAL) { return bayan_pdf_obj_int_value(v); }
    return dflt;
}

# A value no legal PDF parameter can take, so "present but not a number" is
# distinguishable from every real answer AND from the caller's default.
var _PDF_NUM_BAD = 0 - 2147483648;

# _pdfp_dict_num, but strict about TYPE.
#
# The lenient form cannot tell "the key is absent" from "the key is present and
# is a name, a string, or an array", and returns the default for both. For a
# parameter that decides how bytes are decoded that is a silent wrong answer:
# `/Predictor /Foo` reads as "no predictor" and the stream comes back
# plausibly-shaped garbage rather than a refusal. Absent still yields the
# default — that is what a default is for — but a present, wrong-typed value
# returns _PDF_NUM_BAD and records the reason.
fn _pdfp_dict_num_strict(doc, d, key: cstring, dflt): i64 {
    var raw = bayan_pdf_obj_dict_get(d, key);
    if (raw == 0) { return dflt; }
    var v = _pdfp_resolve_d(doc, raw, 0);
    if (_pdfo_tag(v) == PTAG_INT)  { return load64(v + 8); }
    if (_pdfo_tag(v) == PTAG_REAL) { return bayan_pdf_obj_int_value(v); }
    _pdfe_doc_err(doc, "a stream decode parameter is present but is not a number", 0 - 1);
    return _PDF_NUM_BAD;
}

# The /DecodeParms dictionary that applies to filter `i` of the chain — the
# dict itself when there is one filter, or element `i` when both are arrays.
fn _pdfp_parms_at(doc, parms, i, nf): i64 {
    if (parms == 0) { return 0; }
    var t = _pdfo_tag(parms);
    if (t == PTAG_DICT) {
        if (nf <= 1) { return parms; }
        if (i == 0)  { return parms; }
        return 0;
    }
    if (t == PTAG_ARR) {
        var v = _pdfo_vec(parms);
        if (i < 0 || i >= vec_len(v)) { return 0; }
        return _pdfp_resolve_d(doc, vec_get(v, i), 0);
    }
    return 0;
}

# Run one filter, then its predictor, over (src, len).
fn _pdfp_decode_one_a(a, doc, id, src, len, hint, parms): Str {
    var out = 0;
    if (id == _PDFZ_F_FLATE)    { out = _pdfz_inflate_a(a, doc, src, len, hint); }
    elif (id == _PDFZ_F_AHX)    { out = _pdfz_ahx_a(a, doc, src, len); }
    elif (id == _PDFZ_F_A85)    { out = _pdfz_a85_a(a, doc, src, len); }
    elif (id == _PDFZ_F_RL)     { out = _pdfz_rl_a(a, doc, src, len); }
    else {
        _pdfz_err(doc, "stream uses a filter this build cannot decode", 0 - 1);
        return 0;
    }
    if (out == 0) { return 0; }
    # STRICT here: every one of these four decides how the bytes are
    # interpreted, so a present-but-wrong-typed value must refuse rather than
    # fall back to a default that silently changes the output.
    var pred = _pdfp_dict_num_strict(doc, parms, "Predictor", 1);
    if (pred == _PDF_NUM_BAD) { return 0; }
    if (pred <= 1) { return out; }
    var colors  = _pdfp_dict_num_strict(doc, parms, "Colors", 1);
    var bpc     = _pdfp_dict_num_strict(doc, parms, "BitsPerComponent", 8);
    var columns = _pdfp_dict_num_strict(doc, parms, "Columns", 1);
    if (colors == _PDF_NUM_BAD || bpc == _PDF_NUM_BAD) { return 0; }
    if (columns == _PDF_NUM_BAD) { return 0; }
    return _pdfz_unpredict_a(a, doc, str_data(out), str_len(out),
      pred, colors, bpc, columns);
}

# Decode a stream through its whole /Filter chain, left to right.
#
# Returns 0 (never a partial answer) with the reason recorded on the document.
# An image codec is refused HERE rather than decoded to nothing: `/DCTDecode`
# means the bytes are a JPEG, and handing a caller an empty Str for a page that
# genuinely contains a photograph is a wrong answer wearing a success.
fn _pdfp_decode_chain_a(a, doc, st): Str {
    if (_pdfo_tag(st) != PTAG_STREAM) { return 0; }
    var dict = _pdfo_a(st);
    var raw  = _pdfo_b(st);
    if (raw == 0) { return str_from_a(a, ""); }

    var f = _pdfp_resolve_d(doc, bayan_pdf_obj_dict_get(dict, "Filter"), 0);
    var parms = _pdfp_resolve_d(doc, bayan_pdf_obj_dict_get(dict, "DecodeParms"), 0);
    if (parms == 0) {
        parms = _pdfp_resolve_d(doc, bayan_pdf_obj_dict_get(dict, "DP"), 0);
    }
    var hint = _pdfp_dict_num(doc, dict, "DL", 0);

    var nf = 0;
    var fv = 0;
    if (f == 0) { nf = 0; }
    elif (_pdfo_tag(f) == PTAG_NAME) { nf = 1; }
    elif (_pdfo_tag(f) == PTAG_ARR) {
        fv = _pdfo_vec(f);
        nf = vec_len(fv);
    } else {
        _pdfe_doc_err(doc, "stream /Filter is neither a name nor an array", 0 - 1);
        return 0;
    }

    var cur = raw;
    var i = 0;
    while (i < nf) {
        var nm = f;
        if (fv != 0) { nm = _pdfp_resolve_d(doc, vec_get(fv, i), 0); }
        if (_pdfo_tag(nm) != PTAG_NAME) {
            _pdfe_doc_err(doc, "stream /Filter array holds something that is not a name",
              0 - 1);
            return 0;
        }
        var id = _pdfz_filter_id(bayan_pdf_obj_name(nm));
        if (id < 0) {
            _pdfe_doc_err(doc, "stream uses an unrecognised /Filter", 0 - 1);
            return 0;
        }
        if (_pdfz_filter_is_image(id) == 1) {
            _pdfe_doc_err(doc,
              "stream is image data (DCT/JPX/CCITT/JBIG2) and is never decoded here",
              0 - 1);
            return 0;
        }
        if (_pdfz_filter_supported(id) == 0) {
            _pdfe_doc_err(doc, "stream uses a filter this build does not implement",
              0 - 1);
            return 0;
        }
        var p = _pdfp_parms_at(doc, parms, i, nf);
        cur = _pdfp_decode_one_a(a, doc, id, str_data(cur), str_len(cur), hint, p);
        if (cur == 0) { return 0; }
        i = i + 1;
    }
    return cur;
}

# Parse the stream body that follows a stream dictionary. The cursor must be on
# the `stream` keyword. Returns a PTAG_STREAM cell, or 0 with the error set.
#
# THE CONTRACT, and every clause of it is a refusal:
#
#   `stream` then CRLF or LF. A BARE CR IS A HARD ERROR — PDF 32000-1 §7.3.8.1
#   forbids it explicitly, and accepting it means the first payload byte is
#   whatever followed, so the stream is off by one for its whole length.
#
#   Then EXACTLY /Length bytes, with an indirect /Length resolved first.
#
#   Then AT MOST ONE end-of-line, then `endstream`. Anything else is
#   "/Length does not reach endstream" at the byte where endstream should have
#   started. There is deliberately no scan for the real `endstream`: a wrong
#   /Length is a producer bug, the recovered payload is a guess, and a guessed
#   payload flows straight into extracted text with no marking at all.
fn _pdfp_stream_a(a, ps, doc, dict): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var kw  = load64(ps + 16);
    if (_pdfl_at(ps, "stream", 6) == 0) {
        return _pdfe_err(ps, "expected the stream keyword", kw);
    }
    var p = kw + 6;
    if (p < len && load8(buf + p) == 13) {
        if (p + 1 < len && load8(buf + p + 1) == 10) { p = p + 2; }
        else {
            return _pdfe_err(ps,
              "a bare carriage return may not follow the stream keyword", p);
        }
    } elif (p < len && load8(buf + p) == 10) {
        p = p + 1;
    } else {
        return _pdfe_err(ps, "the stream keyword is not followed by an end-of-line", p);
    }
    var start = p;

    var lo = bayan_pdf_obj_dict_get(dict, "Length");
    if (_pdfo_tag(lo) == PTAG_REF) {
        if (load64(doc + 88) == 0) {
            return _pdfe_err(ps,
              "stream /Length is an indirect reference but no cross-reference is loaded yet",
              kw);
        }
        # Bound the re-entry. `k 0 obj<</Length k+1 0 R>>stream..endstream`
        # repeated N times recurses N deep otherwise: every _pdfp_resolve_d
        # call site passes a literal 0, and its visited set is per-call, so
        # neither survives the trip back through _pdfp_stream_a.
        var sd = load64(doc + 176);
        if (sd >= _PDF_MAX_REFS) {
            return _pdfe_err(ps, "indirect /Length chain is too deep", kw);
        }
        store64(doc + 176, sd + 1);
        lo = _pdfp_resolve_d(doc, lo, 0);
        store64(doc + 176, sd);
    }
    if (_pdfo_tag(lo) != PTAG_INT) {
        return _pdfe_err(ps, "stream /Length is missing or is not an integer", kw);
    }
    var n = load64(lo + 8);
    # Compare by SUBTRACTION, never `start + n > len`. `n` is the file's own
    # /Length and the number lexer admits anything up to 9223372036854775799
    # (its range guard runs before the multiply-accumulate), so `start + n`
    # wraps to a large NEGATIVE i64 — which is neither `n < 0` nor `> len`, so
    # the additive form passes, and `load8(buf + e)` below then reads about 9.2
    # exabytes before the buffer. `start <= len` always holds here, so
    # `len - start` is non-negative and this form cannot overflow.
    if (n < 0 || n > len - start) {
        return _pdfe_err(ps, "stream /Length does not reach endstream", start);
    }
    var e = start + n;
    if (e < len && load8(buf + e) == 13) {
        e = e + 1;
        if (e < len && load8(buf + e) == 10) { e = e + 1; }
    } elif (e < len && load8(buf + e) == 10) {
        e = e + 1;
    }
    if (e + 9 > len) {
        return _pdfe_err(ps, "stream /Length does not reach endstream", start + n);
    }
    if (memeq(buf + e, "endstream", 9) == 0) {
        return _pdfe_err(ps, "stream /Length does not reach endstream", start + n);
    }
    store64(ps + 16, e + 9);

    var o = _pdfo_alloc_a(a, PTAG_STREAM);
    if (o == 0) { return _pdfe_err(ps, "out of memory parsing a pdf stream", kw); }
    store64(o + 8,  dict);
    # The stored bytes are a VIEW into the source buffer, not a copy (G14): the
    # document borrows the caller's bytes and every Str it hands back borrows
    # them too. str_new_a, never str_from_a — a stream contains NULs.
    store64(o + 16, str_new_a(a, buf + start, n));
    store64(o + 24, 0);                        # not decoded yet; c != 0 IS the flag
    return o;
}

# Parse the indirect object whose header sits at `off`. `want_num` of 0 - 1
# accepts any object number; otherwise a mismatch is refused, which is what
# catches a cross-reference that points at a real object header for the WRONG
# object — an off-by-one subsection start, say.
fn _pdfp_indirect_at_a(a, ps, doc, off, want_num): i64 {
    var len = load64(ps + 8);
    if (off < 0 || off >= len) {
        _pdfe_doc_err(doc, "object offset is outside the file", off);
        return 0;
    }
    store64(ps + 16, off);
    _pdfl_skip_ws(ps);
    var o8[8];
    if (_pdfl_probe_unsigned(ps, &o8) == 0) {
        _pdfe_doc_err(doc, "expected an object header", off);
        return 0;
    }
    var num = load64(&o8);
    _pdfl_skip_ws(ps);
    if (_pdfl_probe_unsigned(ps, &o8) == 0) {
        _pdfe_doc_err(doc, "expected a generation number in the object header", off);
        return 0;
    }
    _pdfl_skip_ws(ps);
    if (_pdfl_at(ps, "obj", 3) == 0) {
        _pdfe_doc_err(doc, "expected the obj keyword in the object header", off);
        return 0;
    }
    store64(ps + 16, load64(ps + 16) + 3);
    if (want_num >= 0) {
        if (num != want_num) {
            _pdfe_doc_err(doc,
              "the object header at this offset names a different object number", off);
            return 0;
        }
    }
    var o = _pdfp_obj_a(a, ps);
    if (o == 0) {
        _pdfe_doc_adopt(doc, ps);
        return 0;
    }
    if (_pdfo_tag(o) == PTAG_DICT) {
        _pdfl_skip_ws(ps);
        if (_pdfl_at(ps, "stream", 6) == 1) {
            var s = _pdfp_stream_a(a, ps, doc, o);
            if (s == 0) {
                _pdfe_doc_adopt(doc, ps);
                return 0;
            }
            o = s;
        }
    }
    _pdfl_skip_ws(ps);
    if (_pdfl_at(ps, "endobj", 6) == 0) {
        # Recorded, not fatal (D13). The object itself parsed cleanly and its
        # bytes are not in doubt; only the producer's punctuation is. A caller
        # that cares reads bayan_pdf_doc_error_count.
        _pdfe_doc_err(doc, "object is not terminated by endobj", load64(ps + 16));
    } else {
        store64(ps + 16, load64(ps + 16) + 6);
    }
    return o;
}

# Load and index the object stream `container`. Returns a PdfObjStm record.
fn _pdfp_objstm_load(doc, container): i64 {
    # Key on the document's GENERATION as well as its pointer. alloc_reset()
    # rewinds the bump allocator, and a PdfDoc is the first thing a parse
    # allocates, so the next document lands on the same address — a
    # pointer-only key then serves a freed record whose vec and Str words
    # now hold another document's bytes. _pdfz_budget_reset guards the
    # decompression total against exactly this recycling; the memo needs the
    # same discipline, and unlike the budget it fails toward a wrong answer
    # rather than toward a refusal.
    if (_pdfp_ostm_doc == doc && _pdfp_ostm_gen == load64(doc + 168)
      && _pdfp_ostm_num == container) {
        if (_pdfp_ostm_rec != 0) { return _pdfp_ostm_rec; }
    }
    var a = _pdfe_alloc_of(doc);

    # An object stream must itself be an ordinary uncompressed object. PDF
    # 32000-1 §7.5.7 forbids nesting, and without this check a file can point
    # two containers at each other and walk the resolver in a circle that the
    # per-object sentinel would only break after the damage is interesting.
    var ce = _pdfx_get(doc, container);
    if (ce == 0) {
        _pdfe_doc_err(doc, "object stream container is outside the cross-reference",
          0 - 1);
        return 0;
    }
    if (load64(ce) != 1) {
        _pdfe_doc_err(doc, "an object stream may not itself live inside an object stream",
          0 - 1);
        return 0;
    }

    var st = _pdfp_get(doc, container);
    if (_pdfo_tag(st) != PTAG_STREAM) {
        _pdfe_doc_err(doc, "an object-stream container is not a stream", 0 - 1);
        return 0;
    }
    var dict = _pdfo_a(st);
    if (bayan_pdf_obj_name_eq(bayan_pdf_obj_dict_get(dict, "Type"), "ObjStm") == 0) {
        _pdfe_doc_err(doc, "an object-stream container is not /Type /ObjStm", 0 - 1);
        return 0;
    }
    var data = bayan_pdf_stream_data_a(a, doc, st);
    if (data == 0) { return 0; }
    if (str_len(data) == 0) {
        _pdfe_doc_err(doc, "object stream decoded to nothing", 0 - 1);
        return 0;
    }
    # Strict: /N and /First slice the payload, so a wrong-typed value would
    # index into it at an arbitrary place rather than be refused.
    var n     = _pdfp_dict_num_strict(doc, dict, "N", 0 - 1);
    var first = _pdfp_dict_num_strict(doc, dict, "First", 0 - 1);
    if (n == _PDF_NUM_BAD || first == _PDF_NUM_BAD) { return 0; }
    if (n < 0 || first < 0 || first > str_len(data)) {
        _pdfe_doc_err(doc, "object stream has a bad /N or /First", 0 - 1);
        return 0;
    }
    if (n > _PDF_MAX_OBJS) {
        _pdfe_doc_err(doc, "object stream /N exceeds the object limit", 0 - 1);
        return 0;
    }

    var idx = vec_new_a(a);
    if (idx == 0) { return 0; }
    # The header pairs live in data[0 .. First); bounding the state's length at
    # `first` is what stops a truncated header from reading pair numbers out of
    # the object bodies that follow.
    var hps[64];
    _pdfe_state_init(&hps, str_data(data), first, a);
    var o8[8];
    var i = 0;
    while (i < n) {
        _pdfl_skip_ws(&hps);
        if (_pdfl_probe_unsigned(&hps, &o8) == 0) {
            _pdfe_doc_err(doc, "object stream header is shorter than /N declares", 0 - 1);
            return 0;
        }
        var onum = load64(&o8);
        _pdfl_skip_ws(&hps);
        if (_pdfl_probe_unsigned(&hps, &o8) == 0) {
            _pdfe_doc_err(doc, "object stream header is shorter than /N declares", 0 - 1);
            return 0;
        }
        if (vec_push_a(a, idx, onum) < 0) { return 0; }
        if (vec_push_a(a, idx, load64(&o8)) < 0) { return 0; }
        i = i + 1;
    }

    var rec = alloc_via(a, _PDF_OBJSTM_SIZE);
    if (rec == 0) { return 0; }
    store64(rec,      container);
    store64(rec + 8,  data);
    store64(rec + 16, first);
    store64(rec + 24, idx);
    _pdfp_ostm_doc = doc;
    _pdfp_ostm_gen = load64(doc + 168);
    _pdfp_ostm_num = container;
    _pdfp_ostm_rec = rec;
    return rec;
}

# Parse entry `idx` out of object stream `container`.
fn _pdfp_objstm_get(doc, container, idx, want_num): i64 {
    var rec = _pdfp_objstm_load(doc, container);
    if (rec == 0) { return 0; }
    var a = _pdfe_alloc_of(doc);
    var v = load64(rec + 24);
    var n = vec_len(v) / 2;
    if (idx < 0 || idx >= n) {
        _pdfe_doc_err(doc, "object-stream index is out of range for its container", 0 - 1);
        return 0;
    }
    var onum = vec_get(v, idx * 2);
    var roff = vec_get(v, idx * 2 + 1);
    if (want_num >= 0) {
        if (onum != want_num) {
            _pdfe_doc_err(doc,
              "the object stream slot named by the cross-reference holds a different object",
              0 - 1);
            return 0;
        }
    }
    var data = load64(rec + 8);
    var start = load64(rec + 16) + roff;
    if (roff < 0 || start < 0 || start >= str_len(data)) {
        _pdfe_doc_err(doc, "object-stream entry offset is outside the container", 0 - 1);
        return 0;
    }
    var ops[64];
    _pdfe_state_init(&ops, str_data(data), str_len(data), a);
    store64(&ops + 16, start);
    var o = _pdfp_obj_a(a, &ops);
    if (o == 0) {
        _pdfe_doc_adopt(doc, &ops);
        return 0;
    }
    # §7.5.7: an object stream holds no streams. A `stream` keyword here would
    # have no /Length accounting anywhere and no `endstream` contract, so a
    # reader that tried to honour it would be inventing a grammar.
    _pdfl_skip_ws(&ops);
    if (_pdfl_at(&ops, "stream", 6) == 1) {
        _pdfe_doc_err(doc, "an object stream may not contain a stream", 0 - 1);
        return 0;
    }
    if (_pdfo_tag(o) == PTAG_DICT) {
        if (bayan_pdf_obj_name_eq(bayan_pdf_obj_dict_get(o, "Type"), "ObjStm") == 1) {
            _pdfe_doc_err(doc, "an object stream may not contain another object stream",
              0 - 1);
            return 0;
        }
    }
    return o;
}

# Resolve object `num`, parsing it on demand and memoising the cell.
#
# The cache doubles as the cycle guard: slot `num` is set to 1 BEFORE the parse
# and to the cell afterwards, so a reference that comes back round to `num`
# while it is still being built finds the sentinel. Every real allocation is at
# least 8-aligned and non-zero, so 1 is unforgeable and no second in-progress
# array is needed — this mirrors pdfcheck.py:479's `self._cache[key] = None`.
fn _pdfp_get(doc, num): i64 {
    if (_pdfe_magic(doc, PDF_MODE_READ) == 0) { return 0; }
    if (num < 1) { return 0; }
    if (num >= load64(doc + 96)) {
        _pdfe_doc_err(doc, "object number is outside the cross-reference", 0 - 1);
        return 0;
    }
    var cache = load64(doc + 104);
    if (cache == 0) { return 0; }
    var slot = cache + num * 8;
    var v = load64(slot);
    if (v == 1) {
        _pdfe_doc_err(doc, "reference cycle through this object", 0 - 1);
        return 0;
    }
    if (v != 0) { return v; }

    var a = _pdfe_alloc_of(doc);
    var e = _pdfx_get(doc, num);
    if (e == 0) { return 0; }
    var kind = load64(e);
    if (kind != 1 && kind != 2) {
        # A free or never-described object IS `null` (§7.3.10), not a failure.
        # Returning 0 here would make every optional key look like a broken
        # file the first time a producer left a dangling reference behind.
        var nl = _pdfo_alloc_a(a, PTAG_NULL);
        if (nl != 0) { store64(slot, nl); }
        return nl;
    }

    store64(slot, 1);
    var o = 0;
    if (kind == 1) {
        var gps[64];
        var src = load64(doc + 80);
        _pdfe_state_init(&gps, str_data(src), str_len(src), a);
        o = _pdfp_indirect_at_a(a, &gps, doc, load64(e + 8), num);
    } else {
        var cnum = load64(e + 8);
        if (cnum == num) {
            _pdfe_doc_err(doc, "an object stream cannot contain itself", 0 - 1);
            store64(slot, 0);
            return 0;
        }
        o = _pdfp_objstm_get(doc, cnum, load64(e + 16), num);
    }
    if (o == 0) {
        # Clear the sentinel rather than leaving it: a later, differently-routed
        # attempt should report the real failure again, not "reference cycle".
        store64(slot, 0);
        return 0;
    }
    store64(slot, o);
    return o;
}

# Read `%PDF-1.n`. Fatal on anything else.
#
# The header must be at offset 0. Some producers prepend junk and rely on the
# reader to search for the marker — but every byte offset in the cross-
# reference is then relative to the marker rather than to the file, and a
# reader that finds the header without applying that shift silently reads every
# object from the wrong place. Refusing is the answer that cannot be wrong.
fn _pdfp_header(ps, doc): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    if (len < 8) { return _pdfe_err(ps, "file is too short to be a pdf", 0); }
    if (memeq(buf, "%PDF-", 5) == 0) {
        return _pdfe_err(ps, "file does not begin with %PDF-", 0);
    }
    var maj = load8(buf + 5);
    var dot = load8(buf + 6);
    var min = load8(buf + 7);
    if (_pdfe_is_digit(maj) == 0 || dot != 46 || _pdfe_is_digit(min) == 0) {
        return _pdfe_err(ps, "malformed pdf version in the %PDF- header", 5);
    }
    store64(doc + 112, (maj - 48) * 10 + (min - 48));
    return 1;
}

# The four inheritable attributes, accumulated for a node's children: the
# node's own value where it has one, the ancestors' otherwise.
fn _pdfp_inherit_key(a, dst, node, inherited, key: cstring): i64 {
    var v = bayan_pdf_obj_dict_get(node, key);
    if (v == 0) { v = bayan_pdf_obj_dict_get(inherited, key); }
    if (v == 0) { return 0; }
    return bayan_pdf_obj_dict_set_a(a, dst, key, v);
}

# Build the inherited-attribute dictionary a node passes to its children. A
# value set on a node overrides for its whole subtree, and the leaf wins over
# all of them — which is exactly PDF 32000-1 Table 30's rule.
fn _pdfp_inherit_a(a, node, inherited): i64 {
    var d = bayan_pdf_obj_dict_new_a(a);
    if (d == 0) { return inherited; }
    _pdfp_inherit_key(a, d, node, inherited, "Resources");
    _pdfp_inherit_key(a, d, node, inherited, "MediaBox");
    _pdfp_inherit_key(a, d, node, inherited, "CropBox");
    _pdfp_inherit_key(a, d, node, inherited, "Rotate");
    return d;
}

# The dictionary a caller sees for a leaf page: every key the page itself
# carries, plus any of the four inheritable ones it does not.
#
# Fresh pairs rather than shared ones. Sharing a PdfPair between the page dict
# and the object cell would make bayan_pdf_obj_dict_set on either one mutate
# the other, and the page dict is the handle consumers are invited to poke at.
fn _pdfp_merge_page_a(a, node, inherited): i64 {
    var d = bayan_pdf_obj_dict_new_a(a);
    if (d == 0) { return node; }
    var dv = _pdfo_vec(d);
    var sv = _pdfo_vec(node);
    if (dv == 0 || sv == 0) { return node; }
    var n = vec_len(sv);
    var i = 0;
    while (i < n) {
        var p = vec_get(sv, i);
        if (p != 0) {
            var np = _pdfo_pair_new_a(a, load64(p), load64(p + 8));
            if (np != 0) { vec_push_a(a, dv, np); }
        }
        i = i + 1;
    }
    _pdfp_inherit_key(a, d, d, inherited, "Resources");
    _pdfp_inherit_key(a, d, d, inherited, "MediaBox");
    _pdfp_inherit_key(a, d, d, inherited, "CropBox");
    _pdfp_inherit_key(a, d, d, inherited, "Rotate");
    return d;
}

# 1 for an internal /Pages node, 2 for a leaf /Page, 0 for neither.
#
# /Type is checked first and the /Kids fallback second: producers do omit
# /Type, but a node that has /Kids is structurally an internal node no matter
# what it calls itself, and getting that backwards loses whole subtrees.
fn _pdfp_node_kind(doc, node): i64 {
    if (_pdfo_tag(node) != PTAG_DICT) { return 0; }
    var ty = _pdfp_resolve_d(doc, bayan_pdf_obj_dict_get(node, "Type"), 0);
    if (_pdfo_tag(ty) == PTAG_NAME) {
        if (bayan_pdf_obj_name_eq(ty, "Pages") == 1) { return 1; }
        if (bayan_pdf_obj_name_eq(ty, "Page") == 1)  { return 2; }
    }
    if (bayan_pdf_obj_dict_get(node, "Kids") != 0) { return 1; }
    return 0;
}

# Allocate a PdfPage. `num` is the object number of the page dictionary, or 0
# when it has none yet (a writer page before sealing, or a leaf reached through
# an inline dictionary).
fn _pdfp_page_new_a(a, doc, dict, num, index): i64 {
    var pg = alloc_via(a, _PDF_PAGE_SIZE);
    if (pg == 0) { return 0; }
    store64(pg,      doc);
    store64(pg + 8,  num);
    store64(pg + 16, dict);
    store64(pg + 24, 0);
    var fv = vec_new_a(a);
    if (fv == 0) { return 0; }
    store64(pg + 32, fv);
    store64(pg + 40, 0);
    store64(pg + 48, 0);
    store64(pg + 56, index);
    return pg;
}

# Walk the page tree, honouring inherited attributes and refusing cycles.
#
# `seen` holds the OBJECT NUMBERS on the current path, pushed before descending
# and popped after. Path-scoped, not global: a tree that reaches the same
# /Pages node down two different branches is odd but finite, while a node that
# reaches ITSELF is the thing that never terminates. Keying on object number
# rather than on pointer identity matters because two resolutions of the same
# reference are two different pointers here — pdfcheck.py's `id(node)` works
# only because Python memoises the parse.
fn _pdfp_walk_pages(doc, node, depth, inherited, seen): i64 {
    var a = _pdfe_alloc_of(doc);
    if (depth >= _PDF_MAX_TREE) {
        _pdfe_doc_err(doc, "the page tree is nested too deeply", 0 - 1);
        return 0;
    }
    # Total-work budget, not just depth. See the +192 note on PdfDoc: the
    # path-scoped `seen` set stops self-reference but not a node reached down
    # exponentially many distinct paths.
    var bud = load64(doc + 192);
    if (bud <= 0) {
        _pdfe_doc_err(doc, "the page tree visits too many nodes", 0 - 1);
        return 0;
    }
    store64(doc + 192, bud - 1);
    var kind = _pdfp_node_kind(doc, node);
    if (kind == 0) {
        _pdfe_doc_err(doc, "page-tree node is neither /Pages nor /Page", 0 - 1);
        return 0;
    }
    if (kind == 2) {
        var pages = load64(doc + 32);
        var pd = _pdfp_merge_page_a(a, node, inherited);
        var pg = _pdfp_page_new_a(a, doc, pd, 0, vec_len(pages));
        if (pg == 0) {
            _pdfe_doc_err(doc, "out of memory building a page", 0 - 1);
            return 0;
        }
        if (vec_push_a(a, pages, pg) < 0) { return 0; }
        return 1;
    }

    var kids = _pdfp_resolve_d(doc, bayan_pdf_obj_dict_get(node, "Kids"), 0);
    if (_pdfo_tag(kids) != PTAG_ARR) {
        _pdfe_doc_err(doc, "a /Pages node has no /Kids array", 0 - 1);
        return 0;
    }
    var inh = _pdfp_inherit_a(a, node, inherited);
    var kv = _pdfo_vec(kids);
    var n = vec_len(kv);
    var i = 0;
    while (i < n) {
        var k = vec_get(kv, i);
        var knum = 0;
        if (_pdfo_tag(k) == PTAG_REF) {
            knum = _pdfo_a(k);
            if (vec_find(seen, knum) >= 0) {
                _pdfe_doc_err(doc, "cycle in the page tree", 0 - 1);
                return 0;
            }
            if (vec_push_a(a, seen, knum) < 0) { return 0; }
        }
        var kd = _pdfp_resolve_d(doc, k, 0);
        if (kd == 0) {
            _pdfe_doc_err(doc, "a page-tree kid does not resolve", 0 - 1);
            return 0;
        }
        var leaf = _pdfp_node_kind(doc, kd);
        if (_pdfp_walk_pages(doc, kd, depth + 1, inh, seen) == 0) { return 0; }
        if (leaf == 2 && knum != 0) {
            var pages2 = load64(doc + 32);
            var last = vec_len(pages2) - 1;
            if (last >= 0) { store64(vec_get(pages2, last) + 8, knum); }
        }
        if (knum != 0) { vec_pop(seen); }
        i = i + 1;
    }
    return 1;
}

# Perform the page-tree walk once, on first demand.
fn _pdfp_ensure_pages(doc): i64 {
    var f = load64(doc + 120);
    if ((f & _PDF_F_WALKED) != 0) { return 1; }
    # Set the flag FIRST. A failed walk must not be retried on every call —
    # each retry would append the pages it managed to reach before failing.
    store64(doc + 120, f | _PDF_F_WALKED);
    var root = load64(doc + 64);
    if (root == 0) {
        _pdfe_doc_err(doc, "the catalog has no /Pages tree", 0 - 1);
        return 0;
    }
    var a = _pdfe_alloc_of(doc);
    var seen = vec_new_a(a);
    var inh  = bayan_pdf_obj_dict_new_a(a);
    if (seen == 0 || inh == 0) { return 0; }
    var pref = bayan_pdf_obj_dict_get(load64(doc + 56), "Pages");
    if (_pdfo_tag(pref) == PTAG_REF) {
        if (vec_push_a(a, seen, _pdfo_a(pref)) < 0) { return 0; }
    }
    if (_pdfp_walk_pages(doc, root, 0, inh, seen) == 0) { return 0; }
    var want = _pdfp_dict_num(doc, root, "Count", 0 - 1);
    var got = vec_len(load64(doc + 32));
    if (want >= 0 && want != got) {
        # Recorded, and the WALKED count is what every accessor uses: /Count is
        # a claim, the tree is the evidence.
        _pdfe_doc_err(doc, "the page tree /Count disagrees with the pages found", 0 - 1);
    }
    return 1;
}

# === Reader — public entry points ===========================================

# Parse a PDF from a borrowed byte span. The real implementation: reentrant,
# with `ps` a caller-owned 64-byte PdfState and every allocation on `a`.
#
# Returns a PdfDoc with mode PDF_MODE_READ, or 0 on a FATAL failure — no
# %PDF- header, no usable startxref, an unparseable cross-reference, a /Size
# that fails admission, a missing or non-/Catalog /Root, or /Encrypt. Per-
# object failures are recorded on the document and are not fatal (D13).
#
# THE BUFFER IS BORROWED, NOT COPIED (G14). Every Str the document hands back
# is a view into `buf`; freeing it or calling alloc_reset() invalidates the
# document and every string taken out of it at the same instant.
fn bayan_pdf_parse_ctx_a(a, ps, buf, len): i64 {
    if (ps == 0) { return 0; }
    if (buf == 0 || len <= 0) {
        _pdfe_state_init(ps, 0, 0, a);
        _pdfe_err(ps, "empty pdf source", 0);
        return 0;
    }
    _pdfe_state_init(ps, buf, len, a);
    _pdfp_last_enc = 0;
    var doc = _pdfe_doc_new_a(a, PDF_MODE_READ);
    if (doc == 0) {
        _pdfe_err(ps, "out of memory allocating the pdf document", 0);
        return 0;
    }
    var src = str_new_a(a, buf, len);
    if (src == 0) {
        _pdfe_err(ps, "out of memory recording the pdf source", 0);
        return 0;
    }
    store64(doc + 80, src);

    if (_pdfp_header(ps, doc) == 0) { return 0; }
    var sx = _pdfx_find_startxref(ps);
    if (sx < 0) { return 0; }
    if (_pdfx_load(doc, ps, sx) == 0) { _pdfe_ps_adopt(ps, doc); return 0; }

    var tr = load64(doc + 48);

    # ENCRYPTION IS REFUSED BEFORE ANY STRING OR STREAM IS TOUCHED. Half-
    # handling an encrypted file means every string and every content stream is
    # ciphertext, and ciphertext presented as extracted text is the single
    # worst answer this module could give. Out of scope for 1.5.0, loudly.
    if (bayan_pdf_obj_dict_get(tr, "Encrypt") != 0) {
        store64(doc + 120, load64(doc + 120) | _PDF_F_ENCRYPT);
        _pdfp_last_enc = 1;
        _pdfe_doc_err(doc, "encrypted pdf documents are not supported (/Encrypt in the trailer)",
          0 - 1);
        _pdfe_ps_adopt(ps, doc);
        return 0;
    }

    var szo = bayan_pdf_obj_dict_get(tr, "Size");
    if (_pdfo_tag(szo) != PTAG_INT) {
        _pdfe_doc_err(doc, "the trailer has no integer /Size", 0 - 1);
        _pdfe_ps_adopt(ps, doc);
        return 0;
    }
    var size = load64(szo + 8);
    var hi = _pdfx_highest(doc);
    if (size <= hi) {
        # /Size is defined as one MORE than the highest object number, so a
        # /Size that does not exceed it is a table describing objects the
        # trailer says do not exist.
        _pdfe_doc_err(doc,
          "the trailer /Size does not exceed the highest object number in the table",
          0 - 1);
        _pdfe_ps_adopt(ps, doc);
        return 0;
    }
    if (_pdfx_alloc_table(doc, size) == 0) { _pdfe_ps_adopt(ps, doc); return 0; }
    if (_pdfx_verify(doc) == 0) { _pdfe_ps_adopt(ps, doc); return 0; }

    var root = _pdfp_resolve_d(doc, bayan_pdf_obj_dict_get(tr, "Root"), 0);
    if (_pdfo_tag(root) != PTAG_DICT) {
        _pdfe_doc_err(doc, "the trailer /Root does not resolve to a dictionary", 0 - 1);
        _pdfe_ps_adopt(ps, doc);
        return 0;
    }
    if (bayan_pdf_obj_name_eq(bayan_pdf_obj_dict_get(root, "Type"), "Catalog") == 0) {
        _pdfe_doc_err(doc, "the trailer /Root is not a /Type /Catalog", 0 - 1);
        _pdfe_ps_adopt(ps, doc);
        return 0;
    }
    store64(doc + 56, root);

    var pt = _pdfp_resolve_d(doc, bayan_pdf_obj_dict_get(root, "Pages"), 0);
    if (_pdfo_tag(pt) == PTAG_DICT) { store64(doc + 64, pt); }

    var inf = _pdfp_resolve_d(doc, bayan_pdf_obj_dict_get(tr, "Info"), 0);
    if (_pdfo_tag(inf) == PTAG_DICT) { store64(doc + 72, inf); }

    # A catalog /Version overrides the header (§7.5.5) when it is higher — this
    # is how an incrementally-updated 1.4 file declares that it now uses 1.6
    # features without rewriting its first line.
    var cv = _pdfp_resolve_d(doc, bayan_pdf_obj_dict_get(root, "Version"), 0);
    if (_pdfo_tag(cv) == PTAG_NAME) {
        var vs = bayan_pdf_obj_name(cv);
        if (str_len(vs) == 3) {
            var vp = str_data(vs);
            if (_pdfe_is_digit(load8(vp)) == 1 && load8(vp + 1) == 46) {
                if (_pdfe_is_digit(load8(vp + 2)) == 1) {
                    var nv = (load8(vp) - 48) * 10 + (load8(vp + 2) - 48);
                    if (nv > load64(doc + 112)) { store64(doc + 112, nv); }
                }
            }
        }
    }
    return doc;
}

# Reentrant parse on the default allocator.
fn bayan_pdf_parse_ctx(ps, buf, len): i64 {
    return bayan_pdf_parse_ctx_a(default_alloc(), ps, buf, len);
}

# Parse a PDF from a byte span, mirroring the failure into the legacy
# bayan_pdf_last_error() slots afterwards (json.cyr:1087-1093's pattern).
#
# NAMED `_buf`, NOT `_str`: a trailing `_str` is a reserved cyrius overload
# slot, so a cstr+len form occupying it would silently swallow every
# `bayan_pdf_parse(someStr)` call in the ecosystem. `var ps[64]` is 64 BYTES,
# which is exactly _PDF_STATE_SIZE (G2).
fn bayan_pdf_parse_buf(buf, len): i64 {
    var ps[64];
    var d = bayan_pdf_parse_ctx_a(default_alloc(), &ps, buf, len);
    _pdf_err_msg = load64(&ps + 24);
    _pdf_err_pos = load64(&ps + 32);
    return d;
}

# Parse a PDF held in a Str, allocating the document through `a`.
fn bayan_pdf_parse_a(a, src: Str): i64 {
    if (src == 0) { return 0; }
    var ps[64];
    var d = bayan_pdf_parse_ctx_a(a, &ps, str_data(src), str_len(src));
    _pdf_err_msg = load64(&ps + 24);
    _pdf_err_pos = load64(&ps + 32);
    return d;
}

# Parse a PDF held in a Str.
fn bayan_pdf_parse(src: Str): i64 { return bayan_pdf_parse_a(default_alloc(), src); }

# Read a file and parse it. The document OWNS that buffer, so it stays valid
# for the document's whole life without the caller holding anything.
#
# The size is discovered by doubling rather than by stat: `n == cap` is
# genuinely ambiguous (an exact fit or a truncation) and there is no way to
# tell from the outside, so it is treated as truncation and retried — the same
# reasoning as the inflate hook's grow loop.
fn bayan_pdf_parse_file(path: cstring): i64 {
    var cap = 1048576;
    while (cap <= 67108864) {
        var buf = alloc(cap);
        if (buf == 0) {
            _pdf_err_msg = "out of memory reading the pdf file";
            _pdf_err_pos = 0 - 1;
            return 0;
        }
        var n = file_read_all(path, buf, cap);
        if (n < 0) {
            _pdf_err_msg = "cannot read the pdf file";
            _pdf_err_pos = 0 - 1;
            return 0;
        }
        if (n < cap) { return bayan_pdf_parse_buf(buf, n); }
        cap = cap * 2;
    }
    _pdf_err_msg = "pdf file is larger than the 64 MiB read limit";
    _pdf_err_pos = 0 - 1;
    return 0;
}

# Result-typed twin of bayan_pdf_parse_file: Ok(doc), or Err distinguishing a
# read failure from a parse failure — which a 0 return cannot.
fn bayan_pdf_parse_file_r(path: cstring): Result {
    if (file_exists(path) == 0) { return Err(PdfIoErr); }
    var d = bayan_pdf_parse_file(path);
    if (d == 0) { return Err(PdfParseErr); }
    return Ok(d);
}

# The document's PDF version: 14..17 for 1.4..1.7, or 0 - 1 on a bad handle.
fn bayan_pdf_version(doc): i64 {
    if (_pdfe_magic(doc, 0 - 1) == 0) { return 0 - 1; }
    return load64(doc + 112);
}

# 1 when /Encrypt was present. `doc` of 0 asks about the LAST parse, which is
# the spelling that matters: an encrypted file is always a fatal parse, so
# there is no handle to ask.
fn bayan_pdf_is_encrypted(doc): i64 {
    if (doc == 0) { return _pdfp_last_enc; }
    if (_pdfe_magic(doc, 0 - 1) == 0) { return 0; }
    if ((load64(doc + 120) & _PDF_F_ENCRYPT) != 0) { return 1; }
    return 0;
}

# Object count: the trailer /Size for a reader, the highest allocated number
# plus one for a writer. 0 on a bad handle.
fn bayan_pdf_obj_count(doc): i64 {
    if (_pdfe_magic(doc, 0 - 1) == 0) { return 0; }
    if (load64(doc + 8) == PDF_MODE_READ) { return load64(doc + 96); }
    return vec_len(load64(doc + 24));
}

# Resolve object `num`. Bounds-checked; 0 with a recorded error on failure.
fn bayan_pdf_obj(doc, num): i64 {
    if (_pdfe_magic(doc, 0 - 1) == 0) { return 0; }
    if (load64(doc + 8) == PDF_MODE_READ) { return _pdfp_get(doc, num); }
    var objs = load64(doc + 24);
    # vec_get ABORTS the process on an out-of-range index (G7), so every access
    # driven by a caller-supplied number is bounds-checked first.
    if (num < 0 || num >= vec_len(objs)) { return 0; }
    return vec_get(objs, num);
}

# The merged trailer dictionary (first-wins across the /Prev chain).
fn bayan_pdf_trailer(doc): i64 {
    if (_pdfe_magic(doc, 0 - 1) == 0) { return 0; }
    return load64(doc + 48);
}

# The resolved /Root catalog dictionary.
fn bayan_pdf_catalog(doc): i64 {
    if (_pdfe_magic(doc, 0 - 1) == 0) { return 0; }
    return load64(doc + 56);
}

# Follow an indirect-reference chain. A non-reference passes through unchanged,
# so this is safe to wrap around any value of unknown shape.
fn bayan_pdf_resolve(doc, o): i64 {
    if (_pdfe_magic(doc, 0 - 1) == 0) { return o; }
    return _pdfp_resolve_d(doc, o, 0);
}

# Look a key up in a dictionary and resolve the result — the 90 % path.
# 0 when the key is absent or the reference does not resolve.
fn bayan_pdf_dict_lookup(doc, d, key: cstring): i64 {
    if (_pdfe_magic(doc, 0 - 1) == 0) { return 0; }
    var v = bayan_pdf_obj_dict_get(d, key);
    if (v == 0) { return 0; }
    return _pdfp_resolve_d(doc, v, 0);
}

# Decoded stream bytes, through the whole filter chain. Lazy and memoised into
# the cell's slot c — `c != 0` IS the decoded flag, there is no second state
# word to drift out of sync with it.
#
# "" with a named error on failure: a missing hook, an unsupported or unknown
# filter, an image codec, a bad predictor, or the per-document budget.
fn bayan_pdf_stream_data_a(a, doc, st): Str {
    if (_pdfe_magic(doc, 0 - 1) == 0) { return _pdfo_empty_bytes(); }
    if (_pdfo_tag(st) != PTAG_STREAM) {
        _pdfe_doc_err(doc, "bayan_pdf_stream_data called on something that is not a stream",
          0 - 1);
        return _pdfo_empty_bytes();
    }
    var c = _pdfo_c(st);
    if (c != 0) { return c; }
    var d = _pdfp_decode_chain_a(a, doc, st);
    if (d == 0) { return _pdfo_empty_bytes(); }
    _pdfo_set_c(st, d);
    return d;
}

# Decoded stream bytes on the default allocator.
fn bayan_pdf_stream_data(doc, st): Str {
    return bayan_pdf_stream_data_a(default_alloc(), doc, st);
}

# 1 when the filter chain TERMINATES in an image codec — DCTDecode, JPXDecode,
# JBIG2Decode or CCITTFaxDecode. Those hold pixel data this module never
# decodes, so asking for their bytes is a documented error rather than a crash,
# and this is the predicate that lets a caller not ask.
fn bayan_pdf_stream_is_image(doc, st): i64 {
    if (_pdfe_magic(doc, 0 - 1) == 0) { return 0; }
    if (_pdfo_tag(st) != PTAG_STREAM) { return 0; }
    var dict = _pdfo_a(st);
    var f = _pdfp_resolve_d(doc, bayan_pdf_obj_dict_get(dict, "Filter"), 0);
    var last = 0;
    if (_pdfo_tag(f) == PTAG_NAME) {
        last = f;
    } elif (_pdfo_tag(f) == PTAG_ARR) {
        var v = _pdfo_vec(f);
        var n = vec_len(v);
        if (n <= 0) { return 0; }
        last = _pdfp_resolve_d(doc, vec_get(v, n - 1), 0);
    } else {
        return 0;
    }
    if (_pdfo_tag(last) != PTAG_NAME) { return 0; }
    return _pdfz_filter_is_image(_pdfz_filter_id(bayan_pdf_obj_name(last)));
}

# Every /Contents stream of a page, decoded and joined with an interleaved
# newline.
#
# The separator is MANDATORY, not cosmetic: PDF 32000-1 §7.8.2 says the streams
# concatenate as if they were one, but a TOKEN may not span the boundary — so a
# page whose first stream ends `BT /F1 12 T` and whose second begins `f` is
# malformed, while `...12 Tf` + `72 700 Td` concatenated without a separator
# would silently read as the single token `Tf72`.
fn bayan_pdf_page_content_a(a, doc, pg): Str {
    if (_pdfe_magic(doc, 0 - 1) == 0) { return _pdfo_empty_bytes(); }
    if (pg == 0) { return _pdfo_empty_bytes(); }
    var d = load64(pg + 16);
    var c = _pdfp_resolve_d(doc, bayan_pdf_obj_dict_get(d, "Contents"), 0);
    if (c == 0) { return _pdfo_empty_bytes(); }
    if (_pdfo_tag(c) == PTAG_STREAM) { return bayan_pdf_stream_data_a(a, doc, c); }
    if (_pdfo_tag(c) != PTAG_ARR) {
        _pdfe_doc_err(doc, "page /Contents is neither a stream nor an array", 0 - 1);
        return _pdfo_empty_bytes();
    }
    var v = _pdfo_vec(c);
    var n = vec_len(v);
    var sb = str_builder_new_a(a);
    if (sb == 0) { return _pdfo_empty_bytes(); }
    var i = 0;
    while (i < n) {
        var s = _pdfp_resolve_d(doc, vec_get(v, i), 0);
        if (_pdfo_tag(s) == PTAG_STREAM) {
            if (i > 0) {
                # A cstring literal is safe here precisely because it holds no
                # NUL; the payload below never goes through add_cstr (G10).
                str_builder_add_cstr_a(a, sb, "\n");
            }
            var b = bayan_pdf_stream_data_a(a, doc, s);
            # str_builder_add_a takes a Str and is binary-safe end to end. A
            # decoded content stream contains NULs with near-certainty, so
            # str_builder_add_cstr here would truncate the page at the first
            # one and report success.
            str_builder_add_a(a, sb, b);
        } else {
            _pdfe_doc_err(doc, "a page /Contents element is not a stream", 0 - 1);
        }
        i = i + 1;
    }
    return str_builder_build_a(a, sb);
}

# Page content on the default allocator.
fn bayan_pdf_page_content(doc, pg): Str {
    return bayan_pdf_page_content_a(default_alloc(), doc, pg);
}

# === Pages — shared by the reader and the writer =============================

# Number of pages. The writer answers with the pages added; the reader performs
# the tree walk on first call and caches it. 0 - 1 on a bad handle.
#
# When the root /Count disagrees with the walk, the disagreement is recorded
# and the WALKED count is returned — /Count is a producer's claim, the tree is
# the evidence, and a reader that trusts the claim reports pages it cannot
# hand you.
fn bayan_pdf_page_count(doc): i64 {
    if (_pdfe_magic(doc, 0 - 1) == 0) { return 0 - 1; }
    if (load64(doc + 8) == PDF_MODE_READ) { _pdfp_ensure_pages(doc); }
    return vec_len(load64(doc + 32));
}

# Page `i`, 0-based. Bounds-checked; 0 out of range.
fn bayan_pdf_page(doc, i): i64 {
    if (_pdfe_magic(doc, 0 - 1) == 0) { return 0; }
    if (load64(doc + 8) == PDF_MODE_READ) { _pdfp_ensure_pages(doc); }
    var pages = load64(doc + 32);
    if (i < 0 || i >= vec_len(pages)) { return 0; }
    return vec_get(pages, i);
}

# The page dictionary. For a reader page this already has /Resources,
# /MediaBox, /CropBox and /Rotate merged down from its ancestors, with the
# page's own keys winning.
fn bayan_pdf_page_dict(pg): i64 {
    if (pg == 0) { return 0; }
    if (_pdfe_magic(load64(pg), 0 - 1) == 0) { return 0; }
    return load64(pg + 16);
}

# Object number of the page dictionary, or 0 when it has none yet.
fn bayan_pdf_page_number(pg): i64 {
    if (pg == 0) { return 0; }
    if (_pdfe_magic(load64(pg), 0 - 1) == 0) { return 0; }
    return load64(pg + 8);
}

# Write the page's media box as four MILLI-POINT values (llx, lly, urx, ury)
# into a caller-supplied 32-BYTE buffer — `var box[32]`, which is 32 bytes and
# therefore exactly the four i64 slots wanted (G2).
#
# Swapped corners are normalised rather than refused: PDF 32000-1 §7.9.5 says a
# rectangle is specified by any two diagonally opposite corners, so [595 842
# 0 0] is legal and means the same box.
#
# 0 on success, 0 - 1 when /MediaBox is absent or malformed.
fn bayan_pdf_page_media_box(pg, out4): i64 {
    if (pg == 0 || out4 == 0) { return 0 - 1; }
    var doc = load64(pg);
    if (_pdfe_magic(doc, 0 - 1) == 0) { return 0 - 1; }
    var mb = _pdfp_resolve_d(doc, bayan_pdf_obj_dict_get(load64(pg + 16), "MediaBox"), 0);
    if (_pdfo_tag(mb) != PTAG_ARR) { return 0 - 1; }
    var v = _pdfo_vec(mb);
    if (vec_len(v) != 4) { return 0 - 1; }
    var q: i64[4];
    var i = 0;
    while (i < 4) {
        var e = _pdfp_resolve_d(doc, vec_get(v, i), 0);
        var t = _pdfo_tag(e);
        if (t != PTAG_INT && t != PTAG_REAL) { return 0 - 1; }
        # &q + i * 8 — `&TABLE + i` is a BYTE offset in Cyrius, so i64 slots
        # stride by 8 and never by 1 (G3).
        store64(&q + i * 8, bayan_pdf_obj_num_mpt(e));
        i = i + 1;
    }
    var x0 = load64(&q);
    var y0 = load64(&q + 8);
    var x1 = load64(&q + 16);
    var y1 = load64(&q + 24);
    var llx = x0;
    var urx = x1;
    if (x1 < x0) { llx = x1; urx = x0; }
    var lly = y0;
    var ury = y1;
    if (y1 < y0) { lly = y1; ury = y0; }
    store64(out4,      llx);
    store64(out4 + 8,  lly);
    store64(out4 + 16, urx);
    store64(out4 + 24, ury);
    return 0;
}

# === _pdfc_ — content streams, both directions ===============================
#
# ONE section, two directions, because they are the same grammar read from
# opposite ends: everything the writer emits here is a token the reader's
# operator loop below reads back, and the round-trip assertion
# (write text -> parse -> extract text == the original) is what holds them in
# step. Splitting them would let the two drift, and the drift would be silent.
#
# WRITER — the 22 content operators. Each one is a page-scoped call that
# appends to that page's str_builder (PdfPage + 24). Two invariants are load-
# bearing rather than stylistic:
#
#   1. THE SEPARATOR GOES BEFORE THE OPERATOR LINE, NEVER AFTER. _pdfc_sp
#      emits an LF only when the builder is already non-empty, so the last
#      byte of every content stream is a non-EOL byte — `T`, `Q`, `)`, `f`.
#      Combined with the writer emitting no EOL between the stream data and
#      `endstream`, that is the only one of four possible layouts in which
#      BOTH a /Length that is one short and one long fail the acceptance
#      oracle (§6.2). Move the newline to the end of the line and a /Length + 1
#      bug ships green.
#
#   2. BT/ET AND q/Q ARE TRACKED, AND VIOLATIONS ARE LOUD. A show-text outside
#      BT, a nested BT, a Q with no matching q, and q nesting past
#      _PDF_MAX_GDEPTH each return 0 - 1 with a named error on the document.
#      An unbalanced page is refused by bayan_pdf_to_bytes rather than written
#      out as a file that renders as a blank page in one viewer and as garbage
#      in the next.
#
# Show-text TRANSCODES THROUGH WinAnsi and REJECTS AN EMBEDDED NEWLINE. A
# newline inside a run is a structural event — break the run — not a lexical
# one, and silently deleting it (which is what the hand-rolled writer this
# module replaces does) joins two lines of a title into one. That is exactly
# the silent-mis-parse class the house rule forbids, so it is a 0 - 1 and a
# message naming the fix (D10).
#
# READER — text extraction, mirroring scripts/pdfcheck.py's `page_text` newline
# rules byte for byte (D18): a newline on Td / TD / T* / ET, a newline plus the
# text on ' and ", a space for a TJ numeric element more negative than -120,
# then runs of three or more newlines collapsed to two and the result stripped.
# Matching the oracle exactly is what makes the cross-oracle diff in the test
# suite a gate rather than a formality; a second, "nicer" set of rules would
# make it vacuous.
#
# The operator loop reuses `_pdfl_` and `_pdfp_obj_a` for operands, so there is
# exactly ONE implementation of PDF's grammar in this module. It deliberately
# does NOT take the `N G R` indirect-reference path: a content stream contains
# no indirect references, and running that lookahead here would mis-split the
# `RG` operator's operands. Numbers are therefore read with `_pdfl_read_number`
# directly — the same scanner one level down, not a second one.
#
# Extraction decodes bytes as WinAnsi and emits UTF-8 (D17); a page whose font
# resources include a /Type0 subtype records a warning naming the limitation
# rather than pretending the bytes were WinAnsi without saying so.

# --- writer: page and builder access ----------------------------------------

# The owning document of a WRITER page, or 0 if `pg` is not one.
#
# Three checks, not one: a null page, a page whose document fails the magic /
# mode guard, and a page with no content builder — which is what a READER page
# looks like, since the reader fills `dict` and leaves `content` at 0. A writer
# op on a page parsed out of a file is a caller bug, and it answers 0 - 1 here
# instead of storing into a builder that does not exist.
fn _pdfc_page_doc(pg): i64 {
    if (pg == 0) { return 0; }
    var doc = load64(pg);
    if (_pdfe_magic(doc, PDF_MODE_WRITE) == 0) { return 0; }
    if (load64(pg + 24) == 0) { return 0; }
    return doc;
}

# Record `msg` against the page's document and return the 0 - 1 every content
# operator answers with. Written so a call site reads
# `return _pdfc_fail(pg, "...");` — one line, no error dance.
#
# The byte offset is 0 - 1 because these are writer-side failures: there is no
# source file to point into, which is precisely what bayan_pdf_doc_error_pos
# documents 0 - 1 to mean.
fn _pdfc_fail(pg, msg: cstring): i64 {
    if (pg != 0) {
        var doc = load64(pg);
        if (_pdfe_magic(doc, PDF_MODE_WRITE) == 1) {
            _pdfe_doc_err(doc, msg, 0 - 1);
        }
    }
    return 0 - 1;
}

# Emit the inter-operator separator: an LF before every operator line EXCEPT
# the first. Returns 0, or 0 - 1 on a grow failure.
#
# The whole /Length guard rests on this being a *leading* separator. See the
# section header, invariant 1: emitting the LF after the line instead would
# leave the stream ending in an EOL byte, and the reader's "at most one EOL
# before endstream" rule would then accept a /Length that is one byte too
# large. Nothing else in the writer depends on where the byte goes, which is
# why it is worth spending a comment on: the correct spelling and the wrong one
# produce identical-looking output.
fn _pdfc_sp(pg): i64 {
    var sb = load64(pg + 24);
    if (sb == 0) { return 0 - 1; }
    if (_pdfw_pos(sb) == 0) { return 0; }
    return _pdfw_putc(load64(load64(pg) + 16), sb, 10);
}

# Append one milli-point operand followed by its trailing space.
#
# _pdfw_mpt_a trims trailing zeros, so 72000 emits "72" and 10500 emits "10.5".
# The same emitter serves colour components: a milli value 0..1000 formats to
# "0", "0.5", "1" exactly as a coordinate does, so `rg` needs no second path.
fn _pdfc_arg(a, sb, v): i64 {
    if (_pdfw_mpt_a(a, sb, v) != 0) { return 0 - 1; }
    return _pdfw_putc(a, sb, 32);
}

# --- writer: the operator emitters ------------------------------------------
#
# Failure accumulates into `rc` by ADDITION rather than by early return. Every
# helper answers 0 or 0 - 1 and nothing else, so a sum that is non-zero means
# at least one step failed, and there is exactly one error-reporting site per
# operator instead of six. A half-written operator in the builder is harmless:
# the document is already marked failed and bayan_pdf_to_bytes refuses it.

# Emit an operator with no operands: `BT`, `ET`, `q`, `Q`, `S`, `f`, `T*`.
fn _pdfc_op0(pg, op: cstring): i64 {
    var doc = _pdfc_page_doc(pg);
    if (doc == 0) { return 0 - 1; }
    var a  = load64(doc + 16);
    var sb = load64(pg + 24);
    var rc = 0;
    rc = rc + _pdfc_sp(pg);
    rc = rc + _pdfw_kw(a, sb, op);
    if (rc != 0) { return _pdfc_fail(pg, "out of memory building the content stream"); }
    return 0;
}

# Emit an operator with one mpt operand: `w`, `TL`, `Tc`, `Tw`, `g`, `G`.
fn _pdfc_op1(pg, x, op: cstring): i64 {
    var doc = _pdfc_page_doc(pg);
    if (doc == 0) { return 0 - 1; }
    var a  = load64(doc + 16);
    var sb = load64(pg + 24);
    var rc = 0;
    rc = rc + _pdfc_sp(pg);
    rc = rc + _pdfc_arg(a, sb, x);
    rc = rc + _pdfw_kw(a, sb, op);
    if (rc != 0) { return _pdfc_fail(pg, "out of memory building the content stream"); }
    return 0;
}

# Emit an operator with two mpt operands: `Td`, `TD`, `m`, `l`.
fn _pdfc_op2(pg, x, y, op: cstring): i64 {
    var doc = _pdfc_page_doc(pg);
    if (doc == 0) { return 0 - 1; }
    var a  = load64(doc + 16);
    var sb = load64(pg + 24);
    var rc = 0;
    rc = rc + _pdfc_sp(pg);
    rc = rc + _pdfc_arg(a, sb, x);
    rc = rc + _pdfc_arg(a, sb, y);
    rc = rc + _pdfw_kw(a, sb, op);
    if (rc != 0) { return _pdfc_fail(pg, "out of memory building the content stream"); }
    return 0;
}

# Emit an operator with three milli operands: `rg`, `RG`.
fn _pdfc_op3(pg, x, y, z, op: cstring): i64 {
    var doc = _pdfc_page_doc(pg);
    if (doc == 0) { return 0 - 1; }
    var a  = load64(doc + 16);
    var sb = load64(pg + 24);
    var rc = 0;
    rc = rc + _pdfc_sp(pg);
    rc = rc + _pdfc_arg(a, sb, x);
    rc = rc + _pdfc_arg(a, sb, y);
    rc = rc + _pdfc_arg(a, sb, z);
    rc = rc + _pdfw_kw(a, sb, op);
    if (rc != 0) { return _pdfc_fail(pg, "out of memory building the content stream"); }
    return 0;
}

# Emit an operator with four mpt operands: `re`.
fn _pdfc_op4(pg, x, y, z, w, op: cstring): i64 {
    var doc = _pdfc_page_doc(pg);
    if (doc == 0) { return 0 - 1; }
    var a  = load64(doc + 16);
    var sb = load64(pg + 24);
    var rc = 0;
    rc = rc + _pdfc_sp(pg);
    rc = rc + _pdfc_arg(a, sb, x);
    rc = rc + _pdfc_arg(a, sb, y);
    rc = rc + _pdfc_arg(a, sb, z);
    rc = rc + _pdfc_arg(a, sb, w);
    rc = rc + _pdfw_kw(a, sb, op);
    if (rc != 0) { return _pdfc_fail(pg, "out of memory building the content stream"); }
    return 0;
}

# Emit an operator with six mpt operands: `Tm`, `cm`.
fn _pdfc_op6(pg, x, y, z, w, e, f, op: cstring): i64 {
    var doc = _pdfc_page_doc(pg);
    if (doc == 0) { return 0 - 1; }
    var a  = load64(doc + 16);
    var sb = load64(pg + 24);
    var rc = 0;
    rc = rc + _pdfc_sp(pg);
    rc = rc + _pdfc_arg(a, sb, x);
    rc = rc + _pdfc_arg(a, sb, y);
    rc = rc + _pdfc_arg(a, sb, z);
    rc = rc + _pdfc_arg(a, sb, w);
    rc = rc + _pdfc_arg(a, sb, e);
    rc = rc + _pdfc_arg(a, sb, f);
    rc = rc + _pdfw_kw(a, sb, op);
    if (rc != 0) { return _pdfc_fail(pg, "out of memory building the content stream"); }
    return 0;
}

# The BT/ET state guard. `want` is 1 for "a text object must be open" and 0 for
# "one must not be". Returns 1 when the page is in the required state, else 0
# with the error already recorded.
#
# bayan_pdf_text_show and _show_line do NOT route their open-check through here:
# their refusal message is pinned by the test suite as "show-text outside
# BT..ET", which names the operator that failed, and a shared message could not.
fn _pdfc_need_text(pg, want): i64 {
    var doc = _pdfc_page_doc(pg);
    if (doc == 0) { return 0; }
    var open = load64(pg + 40);
    if (want == 1) {
        if (open == 0) {
            _pdfc_fail(pg, "text operator outside BT..ET");
            return 0;
        }
        return 1;
    }
    if (open != 0) {
        _pdfc_fail(pg, "nested BT: a text object is already open");
        return 0;
    }
    return 1;
}

# --- writer: pages and font resources ---------------------------------------

# A milli-point measurement as a PdfObj number cell, trailing zeros trimmed:
# 595000 becomes the INTEGER 595, 10500 becomes the real (105, 1) == "10.5".
#
# The integer collapse matters for /MediaBox. A box written as "595.000" is
# legal PDF and every viewer accepts it, but it is not what any reference
# writer emits, and byte-stable output is what makes the fixture comparisons in
# the test suite worth running.
fn _pdfc_mpt_obj_a(a, mpt): i64 {
    var v = mpt;
    var places = 3;
    while (places > 0) {
        if (v % 10 != 0) { break; }
        v = v / 10;
        places = places - 1;
    }
    if (places == 0) { return bayan_pdf_obj_int_new_a(a, v); }
    return bayan_pdf_obj_real_new_a(a, v, places);
}

# Build the NUL-terminated resource name for font slot `k`: "F1", "F2", ...
# Returns the cstring, or 0 on OOM.
#
# NUL-terminated because bayan_pdf_obj_dict_set_a takes `key: cstring` and
# strlen's it — the buffer is then borrowed by the Str stored on the PdfFont,
# so one allocation serves both spellings and they cannot disagree.
fn _pdfc_resname_a(a, k): i64 {
    var buf = alloc_via(a, 24);
    if (buf == 0) { return 0; }
    store8(buf, 70);                                  # 'F'
    var digits[24];
    var n = 0;
    var v = k;
    if (v <= 0) { v = 1; }
    while (v > 0) {
        store8(&digits + n, 48 + (v % 10));
        v = v / 10;
        n = n + 1;
    }
    var w = 1;
    while (n > 0) {
        n = n - 1;
        store8(buf + w, load8(&digits + n));
        w = w + 1;
    }
    store8(buf + w, 0);
    return buf;
}

# Add a page of `w_mpt` x `h_mpt` to a writer document. Returns the PdfPage*,
# or 0 with a doc error on a bad handle, a non-positive size, or OOM.
#
# The page dictionary is built EAGERLY — /Type, /MediaBox and an empty
# /Resources /Font — rather than at seal time. That is what lets
# bayan_pdf_page_dict and bayan_pdf_page_media_box be single implementations
# shared with the reader (D5), and it gives bayan_pdf_use_font somewhere to put
# the font resource the moment it is asked for instead of maintaining a second
# pending-resources structure that could fall out of step with the page.
#
# PdfPage is 64 BYTES — `var p[64]` would be 64 bytes too (G2), but this one is
# heap-allocated through the document's own allocator, because the page must
# outlive the call and every allocation in a document routes through
# load64(doc + 16) (D7).
fn bayan_pdf_add_page(doc, w_mpt, h_mpt): i64 {
    if (_pdfe_magic(doc, PDF_MODE_WRITE) == 0) { return 0; }
    if (w_mpt <= 0 || h_mpt <= 0) {
        _pdfe_doc_err(doc, "page dimensions must be positive milli-points", 0 - 1);
        return 0;
    }
    var a = load64(doc + 16);

    var d     = bayan_pdf_obj_dict_new_a(a);
    var mb    = bayan_pdf_obj_array_new_a(a);
    var res   = bayan_pdf_obj_dict_new_a(a);
    var fonts = bayan_pdf_obj_dict_new_a(a);
    var pg    = alloc_via(a, _PDF_PAGE_SIZE);
    var sb    = str_builder_new_a(a);
    var used  = vec_new_a(a);
    if (d == 0 || mb == 0 || res == 0 || fonts == 0) {
        _pdfe_doc_err(doc, "out of memory adding a page", 0 - 1);
        return 0;
    }
    if (pg == 0 || sb == 0 || used == 0) {
        _pdfe_doc_err(doc, "out of memory adding a page", 0 - 1);
        return 0;
    }

    var z0 = bayan_pdf_obj_int_new_a(a, 0);
    var z1 = bayan_pdf_obj_int_new_a(a, 0);
    var ux = _pdfc_mpt_obj_a(a, w_mpt);
    var uy = _pdfc_mpt_obj_a(a, h_mpt);
    if (z0 == 0 || z1 == 0 || ux == 0 || uy == 0) {
        _pdfe_doc_err(doc, "out of memory adding a page", 0 - 1);
        return 0;
    }
    var rc = 0;
    rc = rc + bayan_pdf_obj_array_push_a(a, mb, z0);
    rc = rc + bayan_pdf_obj_array_push_a(a, mb, z1);
    rc = rc + bayan_pdf_obj_array_push_a(a, mb, ux);
    rc = rc + bayan_pdf_obj_array_push_a(a, mb, uy);
    rc = rc + bayan_pdf_obj_dict_set_a(a, res, "Font", fonts);

    var ty = bayan_pdf_obj_name_new_a(a, "Page");
    if (ty == 0) {
        _pdfe_doc_err(doc, "out of memory adding a page", 0 - 1);
        return 0;
    }
    rc = rc + bayan_pdf_obj_dict_set_a(a, d, "Type", ty);
    rc = rc + bayan_pdf_obj_dict_set_a(a, d, "MediaBox", mb);
    rc = rc + bayan_pdf_obj_dict_set_a(a, d, "Resources", res);
    if (rc != 0) {
        _pdfe_doc_err(doc, "out of memory adding a page", 0 - 1);
        return 0;
    }

    var pages = load64(doc + 32);
    store64(pg,      doc);
    store64(pg + 8,  0);                              # object number: set at seal
    store64(pg + 16, d);
    store64(pg + 24, sb);
    store64(pg + 32, used);
    store64(pg + 40, 0);                              # in_text
    store64(pg + 48, 0);                              # gdepth
    store64(pg + 56, vec_len(pages));
    if (vec_push_a(a, pages, pg) < 0) {
        _pdfe_doc_err(doc, "out of memory adding a page", 0 - 1);
        return 0;
    }
    return pg;
}

# Ensure `font_id` is registered document-wide and present in this page's
# /Resources /Font, and return its resource name ("F1"). The empty Str on a bad
# handle or an unknown face id — never 0, so str_len on the result is safe.
#
# The font's OBJECT NUMBER is not assigned here. Numbering is a counter over
# doc.objs (D6) and the bodies are emitted at seal time, so every page that
# uses a face shares ONE PTAG_REF cell — held on the PdfFont at + 24 — and the
# sealer patches that single cell's number once. Patching per page would mean
# finding every /Resources /Font entry that names the face, which is the same
# information stored twice and therefore a place for it to disagree.
#
# PdfFont is 32 bytes: {std_id@0, objnum@8, resname Str*@16, ref cell@24}.
fn bayan_pdf_use_font(doc, pg, font_id): Str {
    if (_pdfe_magic(doc, PDF_MODE_WRITE) == 0) { return _pdfo_empty_bytes(); }
    if (pg == 0)            { return _pdfo_empty_bytes(); }
    if (load64(pg) != doc)  { return _pdfo_empty_bytes(); }
    if (font_id < 0 || font_id >= PDF_FONT_COUNT) {
        _pdfe_doc_err(doc, "unknown standard-14 font id", 0 - 1);
        return _pdfo_empty_bytes();
    }
    var a = load64(doc + 16);

    # 1. document-wide registration, keyed on the face id.
    var fonts = load64(doc + 40);
    if (fonts == 0) { return _pdfo_empty_bytes(); }
    var f = 0;
    var i = 0;
    var n = vec_len(fonts);
    while (i < n) {
        var cand = vec_get(fonts, i);
        if (cand != 0) {
            if (load64(cand) == font_id) { f = cand; break; }
        }
        i = i + 1;
    }
    if (f == 0) {
        var k = load64(doc + 152);
        if (k <= 0) { k = 1; }
        var cs = _pdfc_resname_a(a, k);
        if (cs == 0) {
            _pdfe_doc_err(doc, "out of memory registering a font", 0 - 1);
            return _pdfo_empty_bytes();
        }
        var nm  = str_new_a(a, cs, strlen(cs));
        var ref = bayan_pdf_obj_ref_new_a(a, 0, 0);
        f = alloc_via(a, _PDF_FONT_SIZE);
        if (nm == 0 || ref == 0 || f == 0) {
            _pdfe_doc_err(doc, "out of memory registering a font", 0 - 1);
            return _pdfo_empty_bytes();
        }
        store64(f,      font_id);
        store64(f + 8,  0);
        store64(f + 16, nm);
        store64(f + 24, ref);
        if (vec_push_a(a, fonts, f) < 0) {
            _pdfe_doc_err(doc, "out of memory registering a font", 0 - 1);
            return _pdfo_empty_bytes();
        }
        store64(doc + 152, k + 1);
    }

    # 2. this page's /Resources /Font.
    var name = load64(f + 16);
    var res  = bayan_pdf_obj_dict_get(load64(pg + 16), "Resources");
    if (res == 0) {
        _pdfe_doc_err(doc, "page has no /Resources dictionary", 0 - 1);
        return _pdfo_empty_bytes();
    }
    var fdict = bayan_pdf_obj_dict_get(res, "Font");
    if (fdict == 0) {
        fdict = bayan_pdf_obj_dict_new_a(a);
        if (fdict == 0) {
            _pdfe_doc_err(doc, "out of memory registering a font", 0 - 1);
            return _pdfo_empty_bytes();
        }
        if (bayan_pdf_obj_dict_set_a(a, res, "Font", fdict) != 0) {
            _pdfe_doc_err(doc, "out of memory registering a font", 0 - 1);
            return _pdfo_empty_bytes();
        }
    }
    if (bayan_pdf_obj_dict_get_by_str(fdict, name) == 0) {
        # str_data(name) IS the NUL-terminated buffer _pdfc_resname_a built, so
        # the cstring the dict key is copied from and the Str this returns can
        # never name different things.
        if (bayan_pdf_obj_dict_set_a(a, fdict, str_data(name), load64(f + 24)) != 0) {
            _pdfe_doc_err(doc, "out of memory registering a font", 0 - 1);
            return _pdfo_empty_bytes();
        }
        vec_push_a(a, load64(pg + 32), font_id);
    }
    return name;
}

# --- writer: text operators -------------------------------------------------

# Open a text object: `BT`. 0 - 1 if one is already open.
fn bayan_pdf_text_begin(pg): i64 {
    if (_pdfc_page_doc(pg) == 0) { return 0 - 1; }
    if (_pdfc_need_text(pg, 0) == 0) { return 0 - 1; }
    if (_pdfc_op0(pg, "BT") != 0) { return 0 - 1; }
    store64(pg + 40, 1);
    return 0;
}

# Close a text object: `ET`. 0 - 1 if none is open.
fn bayan_pdf_text_end(pg): i64 {
    if (_pdfc_page_doc(pg) == 0) { return 0 - 1; }
    if (load64(pg + 40) == 0) {
        return _pdfc_fail(pg, "unbalanced ET: no matching BT");
    }
    if (_pdfc_op0(pg, "ET") != 0) { return 0 - 1; }
    store64(pg + 40, 0);
    return 0;
}

# Select a face and size: `/Fk <size> Tf`. Registers the face on the document
# and in this page's /Resources /Font as a side effect, so a caller can never
# emit a Tf that names a resource the page does not declare.
fn bayan_pdf_text_font(pg, font_id, size_mpt): i64 {
    var doc = _pdfc_page_doc(pg);
    if (doc == 0) { return 0 - 1; }
    if (_pdfc_need_text(pg, 1) == 0) { return 0 - 1; }
    if (font_id < 0 || font_id >= PDF_FONT_COUNT) {
        return _pdfc_fail(pg, "unknown standard-14 font id");
    }
    if (size_mpt <= 0) {
        return _pdfc_fail(pg, "font size must be a positive number of milli-points");
    }
    var name = bayan_pdf_use_font(doc, pg, font_id);
    if (str_len(name) == 0) { return 0 - 1; }
    var a  = load64(doc + 16);
    var sb = load64(pg + 24);
    var rc = 0;
    rc = rc + _pdfc_sp(pg);
    rc = rc + _pdfw_name_a(a, sb, name);
    rc = rc + _pdfw_putc(a, sb, 32);
    rc = rc + _pdfc_arg(a, sb, size_mpt);
    rc = rc + _pdfw_kw(a, sb, "Tf");
    if (rc != 0) { return _pdfc_fail(pg, "out of memory building the content stream"); }
    return 0;
}

# Set the leading used by T*, ' and ": `<mpt> TL`.
fn bayan_pdf_text_leading(pg, mpt): i64 {
    if (_pdfc_need_text(pg, 1) == 0) { return 0 - 1; }
    return _pdfc_op1(pg, mpt, "TL");
}

# Set inter-character spacing: `<mpt> Tc`. Negative values are legal — that is
# how tracking is tightened — so there is no sign check here.
fn bayan_pdf_text_char_spacing(pg, mpt): i64 {
    if (_pdfc_need_text(pg, 1) == 0) { return 0 - 1; }
    return _pdfc_op1(pg, mpt, "Tc");
}

# Set inter-word spacing: `<mpt> Tw`. Applies to byte 32 only, which is what
# makes it useless for justifying multi-byte encodings and fine for WinAnsi.
fn bayan_pdf_text_word_spacing(pg, mpt): i64 {
    if (_pdfc_need_text(pg, 1) == 0) { return 0 - 1; }
    return _pdfc_op1(pg, mpt, "Tw");
}

# Position the text cursor absolutely: `1 0 0 1 x y Tm` FOLLOWED BY `0 0 Td`.
#
# The trailing Td is 7 bytes and it is not decoration. Text extraction — ours
# and the acceptance oracle's alike — starts a new line on Td / TD / T* / ET
# and on nothing else (D11, D18). A writer that emitted Tm alone would produce
# visually identical pages whose extracted text ran together into one line,
# which would in turn make every round-trip text assertion in the suite pass
# without testing anything.
fn bayan_pdf_text_pos(pg, x_mpt, y_mpt): i64 {
    if (_pdfc_need_text(pg, 1) == 0) { return 0 - 1; }
    # 1000 mpt is the identity scale; _pdfw_mpt trims it to the token "1".
    if (_pdfc_op6(pg, 1000, 0, 0, 1000, x_mpt, y_mpt, "Tm") != 0) { return 0 - 1; }
    return _pdfc_op2(pg, 0, 0, "Td");
}

# Move to the next line using the current leading: `T*`.
fn bayan_pdf_text_next_line(pg): i64 {
    if (_pdfc_need_text(pg, 1) == 0) { return 0 - 1; }
    return _pdfc_op0(pg, "T*");
}

# Transcode `s` for a show-text operator: UTF-8 in, WinAnsi bytes out.
# Returns the encoded Str, or 0 with the document error already set.
#
# TWO refusals, both loud, both reachable from ordinary caller data:
#
#   * An embedded LF or CR. PDF has no line break inside a text run — a
#     newline is a Td / T* / ' , i.e. a structural event. The alternative,
#     silently dropping the byte, welds two lines into one and is exactly the
#     behaviour this module was written to replace (D10).
#
#   * A codepoint WinAnsi cannot name. STRICT rather than SUBSTITUTE: a caller
#     who wants '?' can ask for it explicitly through bayan_pdf_winansi, and a
#     caller who did not ask should not discover the substitution by reading
#     the rendered page. The message names the codepoint.
fn _pdfc_encode_a(doc, s: Str): Str {
    if (s == 0) { return 0; }
    var p = str_data(s);
    var n = str_len(s);
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        if (c == 10 || c == 13) {
            _pdfe_doc_err(doc,
              "newline in show-text; use bayan_pdf_text_show_line or the flow layer", i);
            return 0;
        }
        i = i + 1;
    }
    var enc = bayan_pdf_winansi_a(load64(doc + 16), s, PDF_WINANSI_STRICT, 0);
    if (enc == 0) {
        var msg = _pdf_err_msg;
        if (msg == 0) { msg = "text cannot be encoded as WinAnsi"; }
        _pdfe_doc_err(doc, msg, _pdf_err_pos);
        return 0;
    }
    return enc;
}

# Show a text run: `( ... ) Tj`. 0 - 1 outside BT..ET, on an embedded newline,
# or on a codepoint WinAnsi cannot represent.
fn bayan_pdf_text_show(pg, s: Str): i64 {
    var doc = _pdfc_page_doc(pg);
    if (doc == 0) { return 0 - 1; }
    # Checked here rather than through _pdfc_need_text so the message names the
    # operator: the test suite pins this exact string.
    if (load64(pg + 40) == 0) { return _pdfc_fail(pg, "show-text outside BT..ET"); }
    var enc = _pdfc_encode_a(doc, s);
    if (enc == 0) { return 0 - 1; }
    var a  = load64(doc + 16);
    var sb = load64(pg + 24);
    var rc = 0;
    rc = rc + _pdfc_sp(pg);
    rc = rc + _pdfw_litstr_a(a, sb, enc);
    rc = rc + _pdfw_putc(a, sb, 32);
    rc = rc + _pdfw_kw(a, sb, "Tj");
    if (rc != 0) { return _pdfc_fail(pg, "out of memory building the content stream"); }
    return 0;
}

# Move to the next line and show a run: `( ... ) '` — T* followed by Tj in one
# operator. This is the supported way to write a line break, and the message on
# bayan_pdf_text_show names it.
fn bayan_pdf_text_show_line(pg, s: Str): i64 {
    var doc = _pdfc_page_doc(pg);
    if (doc == 0) { return 0 - 1; }
    if (load64(pg + 40) == 0) { return _pdfc_fail(pg, "show-text outside BT..ET"); }
    var enc = _pdfc_encode_a(doc, s);
    if (enc == 0) { return 0 - 1; }
    var a  = load64(doc + 16);
    var sb = load64(pg + 24);
    var rc = 0;
    rc = rc + _pdfc_sp(pg);
    rc = rc + _pdfw_litstr_a(a, sb, enc);
    rc = rc + _pdfw_putc(a, sb, 32);
    rc = rc + _pdfw_kw(a, sb, "'");
    if (rc != 0) { return _pdfc_fail(pg, "out of memory building the content stream"); }
    return 0;
}

# The whole of a one-line text object: BT, Tf, Tm + Td, Tj, ET.
#
# Six arguments is the ceiling this module works to, and this is the one public
# function that reaches it. It exists because placing a single line of text is
# what a consumer does hundreds of times per document, and spelling it out is
# five calls whose only interesting content is whether the BT and the ET match.
fn bayan_pdf_text_at(pg, font_id, size_mpt, x_mpt, y_mpt, s: Str): i64 {
    if (_pdfc_page_doc(pg) == 0) { return 0 - 1; }
    if (bayan_pdf_text_begin(pg) != 0)                  { return 0 - 1; }
    if (bayan_pdf_text_font(pg, font_id, size_mpt) != 0) { return 0 - 1; }
    if (bayan_pdf_text_pos(pg, x_mpt, y_mpt) != 0)       { return 0 - 1; }
    if (bayan_pdf_text_show(pg, s) != 0) {
        # Close the text object even on a rejected run, so one bad string does
        # not leave the page permanently unbalanced and therefore unwritable.
        bayan_pdf_text_end(pg);
        return 0 - 1;
    }
    return bayan_pdf_text_end(pg);
}

# --- writer: graphics operators ---------------------------------------------

# Save the graphics state: `q`. 0 - 1 past _PDF_MAX_GDEPTH levels, which is
# PDF's own stated implementation limit for graphics-state nesting.
fn bayan_pdf_gsave(pg): i64 {
    if (_pdfc_page_doc(pg) == 0) { return 0 - 1; }
    if (load64(pg + 48) >= _PDF_MAX_GDEPTH) {
        return _pdfc_fail(pg, "graphics state nesting too deep");
    }
    if (_pdfc_op0(pg, "q") != 0) { return 0 - 1; }
    store64(pg + 48, load64(pg + 48) + 1);
    return 0;
}

# Restore the graphics state: `Q`. 0 - 1 on underflow — an unmatched Q makes
# the rest of the page render under whatever state the viewer happened to have,
# which is a different bug in every viewer.
fn bayan_pdf_grestore(pg): i64 {
    if (_pdfc_page_doc(pg) == 0) { return 0 - 1; }
    if (load64(pg + 48) <= 0) {
        return _pdfc_fail(pg, "unbalanced Q: no matching q");
    }
    if (_pdfc_op0(pg, "Q") != 0) { return 0 - 1; }
    store64(pg + 48, load64(pg + 48) - 1);
    return 0;
}

# Set the stroke width: `<mpt> w`. A width of 0 is legal and means "the
# thinnest line the device can draw", so only negatives are refused.
fn bayan_pdf_set_line_width(pg, mpt): i64 {
    if (mpt < 0) { return _pdfc_fail(pg, "line width may not be negative"); }
    return _pdfc_op1(pg, mpt, "w");
}

# Set both fill and stroke to a grey level, `milli` in 0..1000: `<v> g` then
# `<v> G`. Both are emitted because a caller who says "make this grey" and gets
# grey fill with black strokes has been surprised by an implementation detail.
fn bayan_pdf_set_gray(pg, milli): i64 {
    if (milli < 0 || milli > 1000) {
        return _pdfc_fail(pg, "grey level must be 0..1000 milli-units");
    }
    if (_pdfc_op1(pg, milli, "g") != 0) { return 0 - 1; }
    return _pdfc_op1(pg, milli, "G");
}

# Set both fill and stroke colour, each component in 0..1000 milli-units:
# `r g b rg` then `r g b RG`.
fn bayan_pdf_set_rgb(pg, r, g, b): i64 {
    if (r < 0 || r > 1000) { return _pdfc_fail(pg, "colour components must be 0..1000 milli-units"); }
    if (g < 0 || g > 1000) { return _pdfc_fail(pg, "colour components must be 0..1000 milli-units"); }
    if (b < 0 || b > 1000) { return _pdfc_fail(pg, "colour components must be 0..1000 milli-units"); }
    if (_pdfc_op3(pg, r, g, b, "rg") != 0) { return 0 - 1; }
    return _pdfc_op3(pg, r, g, b, "RG");
}

# Begin a subpath: `<x> <y> m`.
fn bayan_pdf_move_to(pg, x_mpt, y_mpt): i64 { return _pdfc_op2(pg, x_mpt, y_mpt, "m"); }

# Extend the current subpath: `<x> <y> l`.
fn bayan_pdf_line_to(pg, x_mpt, y_mpt): i64 { return _pdfc_op2(pg, x_mpt, y_mpt, "l"); }

# Append a closed rectangular subpath: `<x> <y> <w> <h> re`. Negative width or
# height is legal PDF (the corner is the far one) and is passed through.
fn bayan_pdf_rect(pg, x_mpt, y_mpt, w_mpt, h_mpt): i64 {
    return _pdfc_op4(pg, x_mpt, y_mpt, w_mpt, h_mpt, "re");
}

# Stroke the current path: `S`.
fn bayan_pdf_stroke(pg): i64 { return _pdfc_op0(pg, "S"); }

# Fill the current path with the non-zero winding rule: `f`.
fn bayan_pdf_fill(pg): i64 { return _pdfc_op0(pg, "f"); }

# Append raw content-stream bytes verbatim — the documented pressure valve, so
# a consumer with an exotic need never has to fork this module.
#
# THE WRITER'S GUARANTEES ARE VOID FOR WHATEVER THIS EMITS. Three things are
# still checked, because each of them would break an invariant the rest of the
# module relies on rather than merely produce an odd-looking page:
#
#   * a CR byte, which the reader treats as a hard error after `stream` and
#     which some viewers silently normalise inside strings;
#   * a `BT`, `ET`, `q` or `Q` token, which would desynchronise the tracked
#     page state and make the balance check at seal time meaningless;
#   * a trailing EOL byte, which would move the finished stream out of the
#     row-3 layout that makes a /Length one byte too large detectable (§6.2).
fn bayan_pdf_raw_op(pg, s: Str): i64 {
    var doc = _pdfc_page_doc(pg);
    if (doc == 0) { return 0 - 1; }
    if (s == 0) { return _pdfc_fail(pg, "raw content operator is null"); }
    var p = str_data(s);
    var n = str_len(s);
    if (n == 0) { return 0; }
    var i = 0;
    while (i < n) {
        if (load8(p + i) == 13) {
            return _pdfc_fail(pg, "CR in raw content operator; use LF");
        }
        i = i + 1;
    }
    var last = load8(p + n - 1);
    if (last == 10 || last == 13) {
        return _pdfc_fail(pg, "raw content operator may not end with an end-of-line byte");
    }
    # Token scan for the four state-changing operators, over regular-character
    # runs — so the `q` in `qq` is not matched.
    #
    # It DOES match a `q` inside a literal string: `(` and `)` are delimiters,
    # so `(a q b) Tj` tokenises to `a`, `q`, `b` and is refused. That is a
    # deliberate false positive, not an oversight. This is an escape hatch
    # whose whole job is to keep BT/ET and q/Q balance accountable, and making
    # the check string-aware would mean running a second literal-string lexer
    # inside a safety check to permit an operand the typed ops already cover.
    # Refusing too much here costs a caller one call; refusing too little costs
    # the document its graphics-state balance.
    i = 0;
    while (i < n) {
        if (_pdfe_is_regular(load8(p + i)) == 0) { i = i + 1; }
        else {
            var st = i;
            while (i < n) {
                if (_pdfe_is_regular(load8(p + i)) == 0) { break; }
                i = i + 1;
            }
            var kl = i - st;
            if (kl == 1) {
                if (load8(p + st) == 113 || load8(p + st) == 81) {
                    return _pdfc_fail(pg, "raw content operator may not contain BT, ET, q or Q");
                }
            } elif (kl == 2) {
                if (memeq(p + st, "BT", 2) == 1 || memeq(p + st, "ET", 2) == 1) {
                    return _pdfc_fail(pg, "raw content operator may not contain BT, ET, q or Q");
                }
            }
        }
    }
    var a  = load64(doc + 16);
    var sb = load64(pg + 24);
    var rc = 0;
    rc = rc + _pdfc_sp(pg);
    rc = rc + _pdfw_bytes(a, sb, s);
    if (rc != 0) { return _pdfc_fail(pg, "out of memory building the content stream"); }
    return 0;
}

# === Text extraction =========================================================

# === _pdfu_ — byte-to-Unicode mapping for extraction =========================
#
# The bytes inside a Tj/TJ string are NOT characters. What they are depends
# entirely on the font that was current when the operator ran, and PDF gives a
# font three independent ways to say so:
#
#   1. a SIMPLE font's base encoding — /WinAnsiEncoding, /MacRomanEncoding or
#      /StandardEncoding — one byte per code;
#   2. that base encoding overridden per code by /Encoding /Differences, a flat
#      array of glyph NAMES which have to be resolved through the Adobe glyph
#      list before they mean anything;
#   3. a /ToUnicode CMap — a stream of PostScript-ish operators mapping code
#      ranges to UTF-16BE destinations — which overrides everything and is the
#      ONLY thing that can decode a composite /Type0 font, whose codes are
#      two-byte CIDs with no relationship to any character set at all.
#
# Through bayan 1.5.0 every byte went through WinAnsi. For (1) that is right;
# for (3) it produces fluent-looking mojibake — glm's manual.pdf extracted as
# `* / 0        0 D Q X D O` where the page reads `GLM 0.9.9 manual`, because
# an Identity-H CID is the glyph index and Arial's glyph 3 is a space.
#
# THE INVARIANT THIS SECTION ADDS: a run is decoded through its font or it is
# not emitted. A Type0 face with no /ToUnicode has no mapping anyone can
# reconstruct, so its runs produce NOTHING and the document records a warning.
# Loud silence beats quiet garbage — plausible mojibake is indistinguishable
# from a correct extraction at the call site, which is the whole failure this
# module exists to avoid.

# Base-encoding ids. Small integers rather than name comparisons at every code
# point: the name is resolved ONCE when the font map is built.
var _PDF_ENC_WINANSI  = 0;
var _PDF_ENC_MACROMAN = 1;
var _PDF_ENC_STANDARD = 2;

# StandardEncoding code -> Unicode, all 256 entries, three base64-alphabet
# characters each (the same packing _PDF_WINANSI_HI uses, and read back with
# the same _pdff_a2i). The FULL range is tabled, not just the high half:
# StandardEncoding differs from ASCII below 0x80 too — 0x27 is `quoteright`
# (U+2019) and 0x60 is `quoteleft` (U+2018), not the ASCII apostrophe and
# grave — and a table that started at 0x80 would silently hand back the ASCII
# reading for exactly the two codes typography cares about. Unassigned codes
# hold 0.
var _PDF_STD_ENC = "";  #skip-lint: generated data table, one literal, not wrappable

# MacRomanEncoding 0x80..0xFF -> Unicode; 0x00..0x7F is ASCII identity, so only
# the high half is tabled. Three characters per entry, as above.
#
# This is PDF's MacRomanEncoding (Annex D.2), NOT Apple's MacOS Roman: they
# differ at 0xDB, which PDF names `currency` (U+00A4) where Apple has the euro
# sign. 0xBD is `Omega` and 0xC6 is `Delta` — the Greek letters, not the
# look-alike U+2126/U+2206 symbol forms Apple maps.
var _PDF_MACROMAN_HI = "";  #skip-lint: generated data table, one literal, not wrappable

# The Adobe glyph list, Latin repertoire — `name HHHH ` records, space
# separated, split across five cstrings purely so no single source line runs to
# four kilobytes. Scanned in order; the split is invisible to the lookup.
#
# A table and not an algorithm because glyph names are a NAMING CONVENTION with
# a history, not a function of the codepoint: `germandbls` is U+00DF,
# `quotesingle` is U+0027 while `quoteright` is U+2019, and no rule connects
# either pair. The two algorithmic forms that DO exist — a `uni` prefix on four
# hex digits, and a `u` prefix on four to six — are handled in _pdfu_glyph_cp
# rather than tabled, because they enumerate the whole of Unicode.
var _PDF_AGL_0 = "A 0041 AE 00C6 Aacute 00C1 Acircumflex 00C2 Adieresis 00C4 Agrave 00C0 Aogonek 0104 Aring 00C5 Atilde 00C3 B 0042 C 0043 Cacute 0106 Ccaron 010C Ccedilla 00C7 Ccircumflex 0108 D 0044 Delta 2206 E 0045 Eacute 00C9 Ecircumflex 00CA Edieresis 00CB Egrave 00C8 Eth 00D0 Euro 20AC F 0046 G 0047 Gcedilla 0122 Gcircumflex 011C H 0048 Hcircumflex 0124 I 0049 Iacute 00CD Icircumflex 00CE Idieresis 00CF Idotaccent 0130 Igrave 00CC Itilde 0128 J 004A Jcircumflex 0134 K 004B Kcedilla 0136 L 004C Lacute 0139 Lcedilla 013B Lslash 0141 M 004D N 004E Nacute 0143 Ncedilla 0145 Ntilde 00D1 O 004F OE 0152 Oacute 00D3 Ocircumflex 00D4 Odieresis 00D6 Ograve 00D2 Omega 2126 Oslash 00D8 Otilde 00D5 P 0050 Q 0051 R 0052 Racute 0154 Rcedilla 0156 S 0053 Sacute 015A Scaron 0160 Scedilla 015E Scircumflex 015C T 0054 Tcedilla 0162 Thorn 00DE U 0055 Uacute 00DA Ucircumflex 00DB Udieresis 00DC Ugrave 00D9 Uring 016E";  #skip-lint: generated data table, one literal, not wrappable
var _PDF_AGL_1 = "Utilde 0168 V 0056 W 0057 Wcircumflex 0174 X 0058 Y 0059 Yacute 00DD Ycircumflex 0176 Ydieresis 0178 Z 005A Zacute 0179 Zcaron 017D a 0061 aacute 00E1 acircumflex 00E2 acute 00B4 adieresis 00E4 ae 00E6 agrave 00E0 ampersand 0026 aogonek 0105 apple F8FF approxequal 2248 aring 00E5 asciicircum 005E asciitilde 007E asterisk 002A at 0040 atilde 00E3 b 0062 backslash 005C bar 007C braceleft 007B braceright 007D bracketleft 005B bracketright 005D breve 02D8 brokenbar 00A6 bullet 2022 c 0063 cacute 0107 caron 02C7 ccaron 010D ccedilla 00E7 ccircumflex 0109 cedilla 00B8 cent 00A2 circumflex 02C6 colon 003A comma 002C copyright 00A9 currency 00A4 d 0064 dagger 2020 daggerdbl 2021 degree 00B0 dieresis 00A8 divide 00F7 dollar 0024 dotaccent 02D9 dotlessi 0131 e 0065 eacute 00E9 ecircumflex 00EA edieresis 00EB egrave 00E8 eight 0038 ellipsis 2026 emdash 2014 endash 2013 equal 003D eth 00F0";  #skip-lint: generated data table, one literal, not wrappable
var _PDF_AGL_2 = "exclam 0021 exclamdown 00A1 f 0066 ff FB00 ffi FB03 ffl FB04 fi FB01 five 0035 fl FB02 florin 0192 four 0034 fraction 2044 g 0067 gcedilla 0123 gcircumflex 011D germandbls 00DF grave 0060 greater 003E greaterequal 2265 guillemotleft 00AB guillemotright 00BB guilsinglleft 2039 guilsinglright 203A h 0068 hcircumflex 0125 hungarumlaut 02DD hyphen 002D i 0069 iacute 00ED icircumflex 00EE idieresis 00EF igrave 00EC infinity 221E integral 222B itilde 0129 j 006A jcircumflex 0135 k 006B kcedilla 0137 l 006C lacute 013A lcedilla 013C less 003C lessequal 2264 logicalnot 00AC lozenge 25CA lslash 0142 m 006D macron 00AF minus 2212 mu 00B5 multiply 00D7 n 006E nacute 0144 nbspace 00A0 ncedilla 0146 nine 0039 notequal 2260 ntilde 00F1 numbersign 0023 o 006F oacute 00F3 ocircumflex 00F4 odieresis 00F6 oe 0153 ogonek 02DB ograve 00F2 one 0031 onehalf 00BD onequarter 00BC onesuperior 00B9";  #skip-lint: generated data table, one literal, not wrappable
var _PDF_AGL_3 = "ordfeminine 00AA ordmasculine 00BA oslash 00F8 otilde 00F5 p 0070 paragraph 00B6 parenleft 0028 parenright 0029 partialdiff 2202 percent 0025 period 002E periodcentered 00B7 perthousand 2030 pi 03C0 plus 002B plusminus 00B1 product 220F q 0071 question 003F questiondown 00BF quotedbl 0022 quotedblbase 201E quotedblleft 201C quotedblright 201D quoteleft 2018 quoteright 2019 quotesinglbase 201A quotesingle 0027 r 0072 racute 0155 radical 221A rcedilla 0157 registered 00AE ring 02DA s 0073 sacute 015B scaron 0161 scedilla 015F scircumflex 015D section 00A7 semicolon 003B seven 0037 sfthyphen 00AD six 0036 slash 002F space 0020 sterling 00A3 summation 2211 t 0074 tcedilla 0163 thorn 00FE three 0033 threequarters 00BE threesuperior 00B3 tilde 02DC trademark 2122 two 0032 twosuperior 00B2 u 0075 uacute 00FA ucircumflex 00FB udieresis 00FC ugrave 00F9 underscore 005F uring 016F utilde 0169";  #skip-lint: generated data table, one literal, not wrappable
var _PDF_AGL_4 = "v 0076 w 0077 wcircumflex 0175 x 0078 y 0079 yacute 00FD ycircumflex 0177 ydieresis 00FF yen 00A5 z 007A zacute 017A zcaron 017E zero 0030";  #skip-lint: generated data table, one literal, not wrappable

# PdfUniMap (24) — a parsed /ToUnicode CMap.
#   +0  pages   ptr to 256 leaf-page pointers (8 bytes each), 0 == no page
#   +8  cwidth  1 or 2 — bytes per code in a show-text string
#   +16 count   codes actually mapped; 0 means the CMap said nothing usable
#
# A TWO-LEVEL page table, not one flat array: a 2-byte code space is 65536
# entries, and a font that uses 300 glyphs would otherwise pay half a megabyte
# per face and a 357-page document would pay it once per face per document. The
# leaf pages are allocated on first write, so the same font costs two or three
# 2 KB pages.
var _PDF_UMAP_SIZE = 24;

# PdfFontMap (48) — everything extraction needs to know about one font.
#   +0  tou     PdfUniMap*, or 0 when the font has no /ToUnicode
#   +8  cwidth  1 or 2 — bytes consumed per code
#   +16 diffs   ptr to 256 codepoints from /Encoding /Differences, or 0
#   +24 base    _PDF_ENC_* id of the base encoding
#   +32 type0   1 when /Subtype is /Type0
#   +40 usable  1 when this font can decode anything at all
var _PDF_FMAP_SIZE = 48;

# --- the code -> Unicode map -------------------------------------------------
#
# A leaf slot holds ONE i64 with two readings, told apart by its low bit:
#   0            the code is unmapped
#   odd          a single codepoint, stored as cp * 2 + 1
#   even, non-0  a pointer to {count, cp0, cp1, ...} for a ligature destination
# Heap pointers are 8-byte aligned and therefore always even, so the two
# readings can never be confused — which is what lets one slot carry both
# without a parallel tag array.

# Allocate an empty map with `cwidth` bytes per code. 0 on OOM.
fn _pdfu_map_new_a(a, cwidth): i64 {
    var m = alloc_via(a, _PDF_UMAP_SIZE);
    if (m == 0) { return 0; }
    var pages = alloc_via(a, 2048);
    if (pages == 0) { return 0; }
    var i = 0;
    while (i < 2048) { store64(pages + i, 0); i = i + 8; }
    store64(m,      pages);
    store64(m + 8,  cwidth);
    store64(m + 16, 0);
    return m;
}

# Record `v` (an already-encoded leaf value) for `code`. Codes outside the
# two-byte space and the zero value are refused rather than stored: 0 IS the
# "unmapped" reading, so storing it would inflate the count while mapping
# nothing.
fn _pdfu_map_put(a, m, code, v): i64 {
    if (m == 0)      { return 0 - 1; }
    if (v == 0)      { return 0 - 1; }
    if (code < 0)    { return 0 - 1; }
    if (code > 65535) { return 0 - 1; }
    var pages = load64(m);
    var hi = code / 256;
    var leaf = load64(pages + hi * 8);
    if (leaf == 0) {
        leaf = alloc_via(a, 2048);
        if (leaf == 0) { return 0 - 1; }
        var i = 0;
        while (i < 2048) { store64(leaf + i, 0); i = i + 8; }
        store64(pages + hi * 8, leaf);
    }
    var lo = code % 256;
    if (load64(leaf + lo * 8) == 0) { store64(m + 16, load64(m + 16) + 1); }
    store64(leaf + lo * 8, v);
    return 0;
}

# The leaf value for `code`, or 0 when it is unmapped.
fn _pdfu_map_get(m, code): i64 {
    if (m == 0)       { return 0; }
    if (code < 0)     { return 0; }
    if (code > 65535) { return 0; }
    var leaf = load64(load64(m) + (code / 256) * 8);
    if (leaf == 0) { return 0; }
    return load64(leaf + (code % 256) * 8);
}

# Encode a CMap destination — a UTF-16BE byte string — as a leaf value, with
# `bump` added to its LAST codepoint. 0 when the destination is unusable.
#
# `bump` is what makes `beginbfrange`'s consecutive form work: `<20> <7E> <0020>`
# means code 0x20+k maps to U+0020+k, and when the destination is a ligature
# the spec advances its final unit, so "ffi" + 1 is "ffj" rather than "gfi".
#
# A LONE SURROGATE kills the whole destination rather than being passed
# through. It is not a character, _pdfg_utf8_write would refuse it anyway, and
# a producer that emitted one has told us nothing we can act on — dropping the
# code is honest, emitting a replacement character is a guess wearing a glyph.
#
# `var cps: i64[8]` is 8 SLOTS (G2 — `var cps[8]` would be 8 bytes), and eight
# is past every real ligature destination; a longer one is truncated, which
# loses characters from one code rather than the whole CMap.
fn _pdfu_dst_a(a, s: Str, bump): i64 {
    if (s == 0) { return 0; }
    var n = str_len(s);
    var p = str_data(s);
    var cps: i64[8];
    var cnt = 0;
    var i = 0;
    while (i + 2 <= n) {
        if (cnt >= 8) { break; }
        var u = _pdfx_be(p + i, 2);
        i = i + 2;
        if (u >= 55296) {
            if (u <= 56319) {
                if (i + 2 > n) { return 0; }
                var lo = _pdfx_be(p + i, 2);
                if (lo < 56320) { return 0; }
                if (lo > 57343) { return 0; }
                i = i + 2;
                u = 65536 + (u - 55296) * 1024 + (lo - 56320);
            } elif (u <= 57343) {
                return 0;
            }
        }
        store64(&cps + cnt * 8, u);
        cnt = cnt + 1;
    }
    if (cnt == 0) { return 0; }
    var last = load64(&cps + (cnt - 1) * 8) + bump;
    if (last < 0)       { return 0; }
    if (last > 1114111) { return 0; }
    if (last >= 55296) { if (last <= 57343) { return 0; } }
    store64(&cps + (cnt - 1) * 8, last);
    # cp * 2 + 1 is always odd; the record pointer below is always even. That
    # is the whole of the discriminator.
    if (cnt == 1) { return last * 2 + 1; }
    var rec = alloc_via(a, (cnt + 1) * 8);
    if (rec == 0) { return 0; }
    store64(rec, cnt);
    var k = 0;
    while (k < cnt) {
        store64(rec + 8 + k * 8, load64(&cps + k * 8));
        k = k + 1;
    }
    return rec;
}

# A CMap source code as an integer, or 0 - 1 when the hex string is empty or
# wider than the two-byte code space this map indexes.
fn _pdfu_code_of(s: Str): i64 {
    if (s == 0) { return 0 - 1; }
    var n = str_len(s);
    if (n < 1) { return 0 - 1; }
    if (n > 2) { return 0 - 1; }
    return _pdfx_be(str_data(s), n);
}

# --- the CMap lexer ----------------------------------------------------------

# Clear a speculative failure and guarantee forward progress.
#
# The _pdfl_ readers record FIRST-WINS sticky errors, and a CMap is full of
# constructs this parser deliberately does not model (`/CIDSystemInfo << … >>
# def`, `12 dict begin`). A malformed token inside one of those must not poison
# the rest of the CMap, and it must not park the cursor either — hence both
# halves here.
fn _pdfu_recover(ps, pos): i64 {
    store64(ps + 24, 0);
    store64(ps + 32, 0 - 1);
    if (load64(ps + 16) <= pos) { store64(ps + 16, pos + 1); }
    return 0;
}

# 1 when the cursor is on `<<`, which opens a dictionary rather than a hex
# string. The CMap header has one, and telling them apart is a two-byte peek.
fn _pdfu_at_dict(ps): i64 {
    var p = load64(ps + 16);
    if (p + 2 > load64(ps + 8)) { return 0; }
    if (load8(load64(ps) + p) != 60)     { return 0; }
    if (load8(load64(ps) + p + 1) != 60) { return 0; }
    return 1;
}

# Consume exactly ONE CMap token that is not a bare keyword. Returns 1 when
# something was consumed, 0 when the cursor sits on a keyword or at end of
# input — which is the caller's signal to read the keyword itself.
#
# Every branch delegates to the existing _pdfl_/_pdfp_ readers. There is
# deliberately no second lexer here: a CMap is PDF syntax with PostScript
# operators sprinkled through it, and re-implementing hex strings or names
# would give this section its own opinion about `#xx` escapes and odd nibbles.
fn _pdfu_skip_token(a, ps): i64 {
    var num16[16];
    var c = _pdfl_peek(ps);
    if (c < 0) { return 0; }
    var pos = load64(ps + 16);
    if (c == 60) {
        # `<<` opens a dict: step over the two bytes and let the loop read its
        # contents as ordinary tokens. The matching `>>` falls out as two
        # skipped delimiters below, so nothing has to track dictionary depth.
        if (_pdfu_at_dict(ps) == 1) { store64(ps + 16, pos + 2); return 1; }
        if (_pdfl_read_hexstr_a(a, ps) == 0) { _pdfu_recover(ps, pos); }
        return 1;
    }
    if (c == 40) {
        if (_pdfl_read_litstr_a(a, ps) == 0) { _pdfu_recover(ps, pos); }
        return 1;
    }
    if (c == 47) {
        if (_pdfl_read_name_a(a, ps) == 0) { _pdfu_recover(ps, pos); }
        return 1;
    }
    if (c == 91) {
        if (_pdfp_obj_a(a, ps) == 0) { _pdfu_recover(ps, pos); }
        return 1;
    }
    if (_pdfe_is_digit(c) == 1 || c == 43 || c == 45 || c == 46) {
        if (_pdfl_read_number(ps, &num16) == 0) { _pdfu_recover(ps, pos); }
        return 1;
    }
    # A stray closer — ) ] > } { — is one byte forward, exactly as the content
    # scanner treats them.
    if (_pdfe_is_regular(c) == 0) { store64(ps + 16, pos + 1); return 1; }
    return 0;
}

# Consume the keyword under the cursor, or one byte when there is none. Used to
# leave a `end…` terminator behind without caring which one it was.
fn _pdfu_eat_kw(ps): i64 {
    var kw16[16];
    var pos = load64(ps + 16);
    if (_pdfl_read_kw(ps, &kw16) == 0) { store64(ps + 16, pos + 1); }
    return 0;
}

# `begincodespacerange` … `endcodespacerange`: pairs of hex strings whose BYTE
# LENGTH — not their value — gives the code width. `<0000> <FFFF>` is the
# Identity-H signature and means two-byte codes; `<00> <FF>` means one.
#
# The WIDEST range wins, clamped to two. A CMap that mixes one- and two-byte
# ranges would need per-prefix widths to decode exactly; no real /ToUnicode
# does that, and answering at the widest keeps a two-byte font readable
# instead of splitting every CID in half.
fn _pdfu_codespace(a, m, ps): i64 {
    var n = 0;
    while (n < 4096) {
        n = n + 1;
        _pdfl_skip_ws(ps);
        if (_pdfl_eof(ps) == 1) { return 0; }
        if (_pdfl_peek(ps) != 60) { return _pdfu_eat_kw(ps); }
        var pos = load64(ps + 16);
        var lo = _pdfl_read_hexstr_a(a, ps);
        if (lo == 0) { return _pdfu_recover(ps, pos); }
        _pdfl_skip_ws(ps);
        if (_pdfl_peek(ps) == 60) {
            pos = load64(ps + 16);
            if (_pdfl_read_hexstr_a(a, ps) == 0) { return _pdfu_recover(ps, pos); }
        }
        var w = str_len(lo);
        if (w > 2) { w = 2; }
        if (w > load64(m + 8)) { store64(m + 8, w); }
    }
    return 0;
}

# `beginbfchar` … `endbfchar`: `<src> <dst>` pairs, `dst` UTF-16BE.
fn _pdfu_bfchar(a, m, ps): i64 {
    var n = 0;
    while (n < 65536) {
        n = n + 1;
        _pdfl_skip_ws(ps);
        if (_pdfl_eof(ps) == 1) { return 0; }
        if (_pdfl_peek(ps) != 60) { return _pdfu_eat_kw(ps); }
        var pos = load64(ps + 16);
        var src = _pdfl_read_hexstr_a(a, ps);
        if (src == 0) { return _pdfu_recover(ps, pos); }
        _pdfl_skip_ws(ps);
        if (_pdfl_peek(ps) != 60) { return 0; }
        pos = load64(ps + 16);
        var dst = _pdfl_read_hexstr_a(a, ps);
        if (dst == 0) { return _pdfu_recover(ps, pos); }
        var code = _pdfu_code_of(src);
        if (code >= 0) { _pdfu_map_put(a, m, code, _pdfu_dst_a(a, dst, 0)); }
    }
    return 0;
}

# `beginbfrange` … `endbfrange`, BOTH forms:
#   `<lo> <hi> <dst>`          destinations run consecutively from dst
#   `<lo> <hi> [<d1> <d2> …]`  one explicit destination per code
#
# The array form is expanded code by code rather than stored as a range: the
# elements are independent, so there is nothing to interpolate, and expanding
# keeps the lookup a single leaf read for every code in the map.
fn _pdfu_bfrange(a, m, ps): i64 {
    var n = 0;
    # CUMULATIVE budget, not just a per-range one. Each entry may span up to
    # 65,536 codes and the outer loop admits 65,536 entries, so bounding only
    # the outer count still allows ~4e9 map writes from a ~2 KB compressed
    # CMap. A code space has 65,536 distinct codes in it, so any honest CMap
    # writes at most that many useful entries; anything past a small multiple
    # of it is redundant by construction.
    var work = 0;
    while (n < 65536) {
        n = n + 1;
        if (work > 262144) {
            return 0;
        }
        _pdfl_skip_ws(ps);
        if (_pdfl_eof(ps) == 1) { return 0; }
        if (_pdfl_peek(ps) != 60) { return _pdfu_eat_kw(ps); }
        var pos = load64(ps + 16);
        var lo_s = _pdfl_read_hexstr_a(a, ps);
        if (lo_s == 0) { return _pdfu_recover(ps, pos); }
        _pdfl_skip_ws(ps);
        if (_pdfl_peek(ps) != 60) { return 0; }
        pos = load64(ps + 16);
        var hi_s = _pdfl_read_hexstr_a(a, ps);
        if (hi_s == 0) { return _pdfu_recover(ps, pos); }
        var lo = _pdfu_code_of(lo_s);
        var hi = _pdfu_code_of(hi_s);
        # A backwards or out-of-space range is skipped, not clamped: clamping
        # would invent a mapping the file never stated.
        if (lo < 0) { lo = 0; hi = 0 - 1; }
        if (hi > 65535) { hi = 65535; }
        _pdfl_skip_ws(ps);
        var c = _pdfl_peek(ps);
        if (c == 91) {
            pos = load64(ps + 16);
            var arr = _pdfp_obj_a(a, ps);
            if (arr == 0) { return _pdfu_recover(ps, pos); }
            if (_pdfo_tag(arr) == PTAG_ARR) {
                var v = _pdfo_vec(arr);
                var cn = vec_len(v);
                var k = 0;
                while (k < cn) {
                    if (lo + k > hi) { break; }
                    var e = vec_get(v, k);
                    if (_pdfo_tag(e) == PTAG_STR) {
                        _pdfu_map_put(a, m, lo + k, _pdfu_dst_a(a, bayan_pdf_obj_bytes(e), 0));
                        work = work + 1;
                    }
                    k = k + 1;
                }
            }
        } elif (c == 60) {
            pos = load64(ps + 16);
            var dst = _pdfl_read_hexstr_a(a, ps);
            if (dst == 0) { return _pdfu_recover(ps, pos); }
            var j = lo;
            while (j <= hi) {
                if (work > 262144) { return 0; }
                _pdfu_map_put(a, m, j, _pdfu_dst_a(a, dst, j - lo));
                work = work + 1;
                j = j + 1;
            }
        } else {
            return 0;
        }
    }
    return 0;
}

# Parse a whole /ToUnicode CMap. `dflt` is the code width to assume when the
# CMap declares no codespace range — 1 for a simple font, 2 for Identity-H.
# Returns the map, or 0 on OOM.
#
# The PdfState is a 64-BYTE stack local of its own (G2), seeded over the
# decoded CMap bytes, so parsing a CMap cannot disturb the content-stream
# cursor that asked for it and two threads decoding the same document share
# nothing.
fn _pdfu_cmap_a(a, doc, data: Str, dflt): i64 {
    var m = _pdfu_map_new_a(a, dflt);
    if (m == 0) { return 0; }
    if (data == 0) { return m; }
    var len = str_len(data);
    if (len == 0) { return m; }
    var ps[64];
    var kw16[16];
    _pdfe_state_init(&ps, str_data(data), len, a);
    while (1 == 1) {
        _pdfl_skip_ws(&ps);
        if (_pdfl_eof(&ps) == 1) { break; }
        var pos = load64(&ps + 16);
        if (_pdfu_skip_token(a, &ps) == 1) {
            # The same progress guard the content scanner carries: every reader
            # above consumes at least its opening byte today, and one compare
            # buys immunity from an infinite loop if that ever stops holding.
            if (load64(&ps + 16) == pos) { store64(&ps + 16, pos + 1); }
            continue;
        }
        if (_pdfl_read_kw(&ps, &kw16) == 0) { store64(&ps + 16, pos + 1); continue; }
        var kp = load64(&kw16);
        var kl = load64(&kw16 + 8);
        if (kl == 19) {
            if (memeq(kp, "begincodespacerange", 19) == 1) { _pdfu_codespace(a, m, &ps); }
        } elif (kl == 11) {
            if (memeq(kp, "beginbfchar", 11) == 1) { _pdfu_bfchar(a, m, &ps); }
        } elif (kl == 12) {
            if (memeq(kp, "beginbfrange", 12) == 1) { _pdfu_bfrange(a, m, &ps); }
        }
    }
    # A CMap that failed to lex is not an error on the DOCUMENT: the page still
    # extracts, and the font map simply falls back to its base encoding. What
    # would be wrong is letting the sticky state error escape into a caller who
    # asked about something else entirely.
    store64(&ps + 24, 0);
    return m;
}

# --- glyph names and base encodings ------------------------------------------

# Scan one `name HHHH ` table for `n` bytes at `p`. Returns the codepoint, or 0
# when the name is absent. Linear, and deliberately so: this runs once per
# /Differences entry when a font map is built, never per character.
fn _pdfu_agl_scan(tab: cstring, p, n): i64 {
    var i = 0;
    while (1 == 1) {
        if (load8(tab + i) == 0) { return 0; }
        var s = i;
        while (1 == 1) {
            var k = load8(tab + i);
            if (k == 0)  { break; }
            if (k == 32) { break; }
            i = i + 1;
        }
        var nl = i - s;
        if (load8(tab + i) == 32) { i = i + 1; }
        var hs = i;
        while (1 == 1) {
            var h = load8(tab + i);
            if (h == 0)  { break; }
            if (h == 32) { break; }
            i = i + 1;
        }
        var hl = i - hs;
        if (load8(tab + i) == 32) { i = i + 1; }
        if (nl == n) {
            if (memeq(tab + s, p, n) == 1) {
                var v = 0;
                var j = 0;
                while (j < hl) {
                    var d = _pdfe_hexval(load8(tab + hs + j));
                    if (d < 0) { return 0; }
                    v = v * 16 + d;
                    j = j + 1;
                }
                return v;
            }
        }
    }
    return 0;
}

# Adobe glyph name -> Unicode codepoint, or 0 when the name means nothing this
# module can resolve.
#
# ZERO IS THE IMPORTANT RETURN. A /Differences entry naming a glyph we cannot
# place must fall back to the base encoding, not emit a guess — the caller
# checks for 0 and does exactly that. A subsetted font routinely names its
# glyphs `g43` or `index17`, which carry no character identity at all, and
# inventing one for them would put wrong letters in the output.
#
# Three forms are recognised beyond the table:
#   a `uni` prefix on four hex digits — the codepoint, written out
#   a `u` prefix on four to six hex digits — the same, variable width
#   `name.suffix` — a stylistic variant such as `a.sc` or `one.oldstyle`, whose
#   identity is carried by the part before the dot
fn _pdfu_glyph_cp(s: Str): i64 {
    if (s == 0) { return 0; }
    var p = str_data(s);
    var n = str_len(s);
    if (n <= 0) { return 0; }
    var d = 0;
    while (d < n) {
        if (load8(p + d) == 46) { break; }
        d = d + 1;
    }
    # A leading dot is a glyph name in its own right (`.notdef`), so only trim
    # when something precedes it.
    if (d > 0) { n = d; }
    if (n >= 7) {
        if (memeq(p, "uni", 3) == 1) {
            var v = 0;
            var i = 0;
            while (i < 4) {
                var hv = _pdfe_hexval(load8(p + 3 + i));
                if (hv < 0) { return 0; }
                v = v * 16 + hv;
                i = i + 1;
            }
            # A `uni` name carrying more than four digits names a SEQUENCE of
            # codepoints; a /Differences slot holds one, so the first is what
            # survives. The base-encoding fallback cannot help here — the name
            # did identify a character, just more of one than the slot holds.
            return v;
        }
    }
    if (n >= 5) {
        if (n <= 7) {
            if (load8(p) == 117) {
                var v2 = 0;
                var i2 = 1;
                while (i2 < n) {
                    var hv2 = _pdfe_hexval(load8(p + i2));
                    if (hv2 < 0) { v2 = 0 - 1; break; }
                    v2 = v2 * 16 + hv2;
                    i2 = i2 + 1;
                }
                if (v2 >= 0) { if (v2 <= 1114111) { return v2; } }
            }
        }
    }
    var cp = _pdfu_agl_scan(_PDF_AGL_0, p, n);
    if (cp != 0) { return cp; }
    cp = _pdfu_agl_scan(_PDF_AGL_1, p, n);
    if (cp != 0) { return cp; }
    cp = _pdfu_agl_scan(_PDF_AGL_2, p, n);
    if (cp != 0) { return cp; }
    cp = _pdfu_agl_scan(_PDF_AGL_3, p, n);
    if (cp != 0) { return cp; }
    return _pdfu_agl_scan(_PDF_AGL_4, p, n);
}

# One base-encoding code -> Unicode, or 0 for a code the encoding leaves
# undefined. WinAnsi routes to the existing table so there is exactly one
# WinAnsi opinion in this module.
fn _pdfu_base_cp(base, code): i64 {
    if (code < 0)   { return 0; }
    if (code > 255) { return 0; }
    if (base == _PDF_ENC_MACROMAN) {
        if (code < 128) { return code; }
        var k = (code - 128) * 3;
        return _pdff_a2i(load8(_PDF_MACROMAN_HI + k)) * 4096
        + _pdff_a2i(load8(_PDF_MACROMAN_HI + k + 1)) * 64
        + _pdff_a2i(load8(_PDF_MACROMAN_HI + k + 2));
    }
    if (base == _PDF_ENC_STANDARD) {
        var j = code * 3;
        return _pdff_a2i(load8(_PDF_STD_ENC + j)) * 4096
        + _pdff_a2i(load8(_PDF_STD_ENC + j + 1)) * 64
        + _pdff_a2i(load8(_PDF_STD_ENC + j + 2));
    }
    return _pdfg_winansi_to_cp(code);
}

# An /Encoding (or /BaseEncoding) name -> a _PDF_ENC_* id.
#
# ANYTHING UNRECOGNISED ANSWERS WINANSI, including a font with no /Encoding at
# all. The spec's answer there is "the font's built-in encoding", which lives
# inside a font program this module does not read; WinAnsi is what bayan's own
# writer emits and what every extraction before this section assumed, so it is
# the reading that changes no existing output.
fn _pdfu_enc_id(o): i64 {
    if (bayan_pdf_obj_name_eq(o, "MacRomanEncoding") == 1) { return _PDF_ENC_MACROMAN; }
    if (bayan_pdf_obj_name_eq(o, "StandardEncoding") == 1) { return _PDF_ENC_STANDARD; }
    return _PDF_ENC_WINANSI;
}

# Fill a font map's `base` and `diffs` from a SIMPLE font's /Encoding.
#
# /Differences is a flat array — `[ 32 /space /exclam 65 /A ]` — where every
# integer RESETS the running code and every name assigns to it and advances.
# The two element kinds are not grouped and the codes need not ascend, so the
# running counter is the whole of the grammar.
#
# A name the glyph list cannot place leaves the slot at 0, which the decoder
# reads as "use the base encoding". That is the difference between a font whose
# /Differences names three glyphs and a font whose /Differences has silently
# blanked 253 codes.
fn _pdfu_encoding(a, doc, fobj, fm): i64 {
    var enc = bayan_pdf_dict_lookup(doc, fobj, "Encoding");
    if (enc == 0) { return 0; }
    if (_pdfo_tag(enc) == PTAG_NAME) {
        store64(fm + 24, _pdfu_enc_id(enc));
        return 0;
    }
    if (_pdfo_tag(enc) != PTAG_DICT) { return 0; }
    var be = bayan_pdf_dict_lookup(doc, enc, "BaseEncoding");
    if (_pdfo_tag(be) == PTAG_NAME) { store64(fm + 24, _pdfu_enc_id(be)); }
    var diff = bayan_pdf_dict_lookup(doc, enc, "Differences");
    if (_pdfo_tag(diff) != PTAG_ARR) { return 0; }
    var v = _pdfo_vec(diff);
    if (v == 0) { return 0; }
    var n = vec_len(v);
    if (n <= 0) { return 0; }
    var tab = alloc_via(a, 2048);
    if (tab == 0) { return 0; }
    var i = 0;
    while (i < 2048) { store64(tab + i, 0); i = i + 8; }
    var code = 0;
    var used = 0;
    var k = 0;
    while (k < n) {
        var e = bayan_pdf_resolve(doc, vec_get(v, k));
        var t = _pdfo_tag(e);
        if (t == PTAG_INT) {
            code = _pdfo_a(e);
        } elif (t == PTAG_NAME) {
            if (code >= 0) {
                if (code <= 255) {
                    var cp = _pdfu_glyph_cp(bayan_pdf_obj_name(e));
                    if (cp > 0) {
                        store64(tab + code * 8, cp);
                        used = used + 1;
                    }
                }
            }
            code = code + 1;
        }
        k = k + 1;
    }
    # No table at all when nothing landed in it — the decoder then skips the
    # per-code lookup entirely instead of reading 256 zeroes per character.
    if (used > 0) { store64(fm + 16, tab); }
    return 0;
}

# --- the per-font map and its cache ------------------------------------------

# Build the font map for one resolved /Font object. Never 0 except on OOM: a
# font this module cannot decode still gets a map, with `usable` clear, and
# that is what makes "emit nothing, loudly" reachable instead of falling
# through to WinAnsi.
fn _pdfu_fmap_a(a, doc, fobj): i64 {
    var fm = alloc_via(a, _PDF_FMAP_SIZE);
    if (fm == 0) { return 0; }
    var i = 0;
    while (i < _PDF_FMAP_SIZE) { store64(fm + i, 0); i = i + 8; }
    store64(fm + 8,  1);                    # simple fonts: one byte per code
    store64(fm + 24, _PDF_ENC_WINANSI);
    store64(fm + 40, 1);
    if (fobj == 0) { return fm; }
    var sub = bayan_pdf_dict_lookup(doc, fobj, "Subtype");
    if (bayan_pdf_obj_name_eq(sub, "Type0") == 1) {
        store64(fm + 32, 1);
        # /Identity-H and /Identity-V are two-byte CIDs, and so is every CMap
        # a /ToUnicode would sensibly accompany. `usable` starts CLEAR: without
        # a /ToUnicode there is no way back from a CID to a character, so the
        # runs are dropped rather than decoded as something they are not.
        store64(fm + 8,  2);
        store64(fm + 40, 0);
    } else {
        _pdfu_encoding(a, doc, fobj, fm);
    }
    var tu = bayan_pdf_dict_lookup(doc, fobj, "ToUnicode");
    if (_pdfo_tag(tu) == PTAG_STREAM) {
        var data = bayan_pdf_stream_data_a(a, doc, tu);
        if (str_len(data) > 0) {
            var m = _pdfu_cmap_a(a, doc, data, load64(fm + 8));
            if (m != 0) {
                if (load64(m + 16) > 0) {
                    store64(fm,      m);
                    store64(fm + 40, 1);
                    # THE CMAP DOES NOT GET TO WIDEN A SIMPLE FONT. A simple
                    # font's codes are one byte by definition (PDF 32000-1
                    # §9.6), yet producers routinely copy the Identity-H
                    # header into its /ToUnicode and declare
                    # `<0000> <FFFF>`. Believing that would read every pair of
                    # letters as one code and halve the page. Only a composite
                    # font takes its width from the CMap.
                    #
                    # The two agree anyway where it matters: a two-byte source
                    # code `<0041>` is big-endian 65, which is exactly the
                    # one-byte code `<41>`, so such a CMap's entries land on
                    # the right slots either way.
                    if (load64(fm + 32) == 1) { store64(fm + 8, load64(m + 8)); }
                }
            }
        }
    }
    return fm;
}

# The cached font map for `fobj`, building it on first ask. 0 only on OOM.
#
# THE CACHE IS WHY THIS IS AFFORDABLE. A 357-page document names the same three
# fonts on every page; without memoisation each page would re-inflate and
# re-parse the same CMaps, which is the same shape of waste _pdfp_get exists to
# avoid one level down. The key is the resolved PdfObj POINTER, which is stable
# for the life of the document precisely because _pdfp_get memoises it.
#
# Entries are {font, map} pairs pushed onto one vec. A push that fails halfway
# leaves an odd length, and the `i + 1 < n` scan below simply never reads the
# dangling key — vec_get ABORTS on an out-of-range index (G8), so the bound is
# the guard, not a comment.
fn _pdfu_fmap_for(doc, fobj): i64 {
    if (fobj == 0) { return 0; }
    var a = _pdfe_alloc_of(doc);
    var cache = load64(doc + 160);
    if (cache == 0) {
        cache = vec_new_a(a);
        if (cache == 0) { return 0; }
        store64(doc + 160, cache);
    }
    var n = vec_len(cache);
    var i = 0;
    while (i + 1 < n) {
        if (vec_get(cache, i) == fobj) { return vec_get(cache, i + 1); }
        i = i + 2;
    }
    var fm = _pdfu_fmap_a(a, doc, fobj);
    if (fm == 0) { return 0; }
    # The scan above is linear, so an unbounded cache would make a file that
    # gives every page its own DIRECT font dictionary quadratic in page count.
    # Past the cap the map is still built and still correct — only the
    # memoisation stops, which costs time on a shape no real producer emits.
    if (n >= 512) { return fm; }
    if (vec_push_a(a, cache, fobj) < 0) { return fm; }
    vec_push_a(a, cache, fm);
    return fm;
}

# Resolve a Tf operand — a resource name — to a font map through the page's
# /Resources /Font dictionary. 0 when the page names a font it does not carry,
# which the decoder reads as "no font context" and answers in WinAnsi.
#
# That fallback stays — refusing would fail a large number of real files whose
# resources are merely sloppy, and for a simple font WinAnsi is usually right.
# But it is RECORDED, because for a /Type0 face it is not right at all and the
# caller has no other way to learn that some of the text it just received was
# decoded under a guess. Same treatment as an object missing its `endobj`:
# a diagnostic the caller can read, not a refusal.
fn _pdfu_font_by_name(doc, fdict, nm: Str): i64 {
    if (nm == 0) { return 0; }
    if (fdict == 0) {
        _pdfe_doc_warn(doc, "a Tf names a font but the page has no /Resources /Font; run decoded as WinAnsi");
        return 0;
    }
    var fo = bayan_pdf_resolve(doc, bayan_pdf_obj_dict_get_by_str(fdict, nm));
    if (fo == 0) {
        _pdfe_doc_warn(doc, "a Tf names a font absent from /Resources /Font; run decoded as WinAnsi");
        return 0;
    }
    return _pdfu_fmap_for(doc, fo);
}

# The /Resources /Font dictionary of a page, or 0.
fn _pdfu_page_fonts(doc, pg): i64 {
    var res = bayan_pdf_dict_lookup(doc, bayan_pdf_page_dict(pg), "Resources");
    if (res == 0) { return 0; }
    return bayan_pdf_dict_lookup(doc, res, "Font");
}

# Append WinAnsi bytes to the output builder as UTF-8. Text comes OUT of this
# module as UTF-8 (D17); the bytes on the page are WinAnsi.
#
# bayan_pdf_from_winansi_a rather than a byte loop through _pdfg_utf8_put: that
# helper appends via the bare str_builder_add_byte, which grows through
# default_alloc() and would leak an extraction done in a caller's arena into
# the global bump — the zero-growth property the test suite asserts.
fn _pdfc_emit_text(a, sb, s: Str): i64 {
    if (s == 0)          { return 0; }
    if (str_len(s) == 0) { return 0; }
    var u = bayan_pdf_from_winansi_a(a, s);
    if (u == 0) { return 0 - 1; }
    return _pdfw_bytes(a, sb, u);
}

# Append one codepoint to the output builder as UTF-8, through `a`.
#
# _pdfw_putc and NOT _pdfg_utf8_put, for the reason _pdfc_emit_text gives: that
# helper grows through default_alloc(), which would move an extraction done in
# a caller's arena into the global bump the first time the builder outgrew its
# inline block. An unencodable codepoint appends NOTHING rather than a partial
# sequence, which would corrupt every byte after it.
fn _pdfu_put_cp(a, sb, cp): i64 {
    var tmp[8];
    var n = _pdfg_utf8_write(&tmp, cp);
    if (n == 0) { return 0; }
    var i = 0;
    while (i < n) {
        _pdfw_putc(a, sb, load8(&tmp + i));
        i = i + 1;
    }
    return 0;
}

# Append one leaf value — see the discriminator note above _pdfu_map_new_a: odd
# is a single codepoint, even and non-zero is a ligature record.
fn _pdfu_put_val(a, sb, v): i64 {
    if (v == 0) { return 0; }
    if (v % 2 == 1) { return _pdfu_put_cp(a, sb, (v - 1) / 2); }
    var cnt = load64(v);
    if (cnt <= 0) { return 0; }
    var i = 0;
    while (i < cnt) {
        _pdfu_put_cp(a, sb, load64(v + 8 + i * 8));
        i = i + 1;
    }
    return 0;
}

# Decode one show-text string through `fmap` and append it as UTF-8.
#
# THE THREE CASES, in the order they are tried per code:
#   * the font's /ToUnicode CMap, which outranks everything and is the only
#     thing that can read a Type0 CID;
#   * /Differences, for a simple font whose producer renamed a code;
#   * the base encoding.
# A code none of them places emits NOTHING. That is a deliberate asymmetry with
# the old WinAnsi path, which had an answer for all 256 bytes: a font that says
# a code is undefined has said something, and honouring it is what keeps the
# output free of characters the page does not contain.
#
# The fast path matters. A font with no CMap, no /Differences and a WinAnsi
# base is bayan's own writer's output and most of the world's simple fonts, and
# routing it back through _pdfc_emit_text keeps that case a single bulk
# transcode instead of a per-byte loop — and keeps it byte-identical to what
# every release before this one produced.
fn _pdfu_emit_a(a, sb, s: Str, fmap): i64 {
    if (s == 0)          { return 0; }
    if (str_len(s) == 0) { return 0; }
    if (fmap == 0)       { return _pdfc_emit_text(a, sb, s); }
    # A font with no mapping at all emits nothing; the warning was already
    # recorded once for the page by _pdfc_warn_type0.
    if (load64(fmap + 40) == 0) { return 0; }
    var tou   = load64(fmap);
    var w     = load64(fmap + 8);
    var diffs = load64(fmap + 16);
    var base  = load64(fmap + 24);
    # The width is 1 or 2 by construction everywhere it is written. Pinning it
    # again here is not distrust of that argument, it is refusing to let a
    # future edit turn a zero into an infinite loop over `i + w <= n`.
    if (w != 2) { w = 1; }
    if (tou == 0) {
        if (diffs == 0) {
            if (w == 1) {
                if (base == _PDF_ENC_WINANSI) { return _pdfc_emit_text(a, sb, s); }
            }
        }
    }
    var p = str_data(s);
    var n = str_len(s);
    var i = 0;
    # `i + w <= n` drops a trailing odd byte on a two-byte font rather than
    # padding it into a code the file never wrote. A show string whose length
    # is not a multiple of the code width is malformed; half of it is not a
    # character.
    while (i + w <= n) {
        var code = _pdfx_be(p + i, w);
        i = i + w;
        var v = 0;
        if (tou != 0) { v = _pdfu_map_get(tou, code); }
        if (v == 0) {
            if (w == 1) {
                var cp = 0;
                if (diffs != 0) { cp = load64(diffs + code * 8); }
                if (cp == 0)    { cp = _pdfu_base_cp(base, code); }
                if (cp != 0)    { v = cp * 2 + 1; }
            }
        }
        _pdfu_put_val(a, sb, v);
    }
    return 0;
}

# Handle a TJ array through the current font: strings are decoded and emitted,
# and a numeric element more negative than -120 becomes a single space.
#
# -120 is the acceptance oracle's threshold (pdfcheck.py:684) and matching it
# is the point: TJ numbers are thousandths of an em of NEGATIVE displacement,
# so -120 is 0.12 em — wider than any kerning pair and narrower than any space.
#
# The REAL comparison multiplies rather than divides: value < -120 is exactly
# scaled < -120 * 10^places, and doing it that way means a kern of -120.5
# lands on the correct side of the threshold instead of being truncated onto
# it. The multiply is on a bounded factor (places is 0..9 by construction) and
# the comparison is a plain signed compare — no shift, because `>>` is LOGICAL
# in Cyrius and would turn a negative kern into a colossal positive (G12).
fn _pdfu_tj_a(a, doc, sb, arr, fmap): i64 {
    if (_pdfo_tag(arr) != PTAG_ARR) { return 0; }
    var v = _pdfo_vec(arr);
    if (v == 0) { return 0; }
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        var e = vec_get(v, i);
        var t = _pdfo_tag(e);
        if (t == PTAG_STR) {
            _pdfu_emit_a(a, sb, bayan_pdf_obj_bytes(e), fmap);
        } elif (t == PTAG_INT) {
            if (load64(e + 8) < 0 - 120) { _pdfw_putc(a, sb, 32); }
        } elif (t == PTAG_REAL) {
            var places = load64(e + 16);
            if (places < 0) { places = 0; }
            if (places > 9) { places = 9; }
            if (load64(e + 8) < (0 - 120) * _pdfe_pow10(places)) { _pdfw_putc(a, sb, 32); }
        }
        i = i + 1;
    }
    return 0;
}

# A TJ array with no font context — every byte WinAnsi, which is what this
# module did everywhere before /ToUnicode existed here. Kept at its original
# name and signature so nothing outside this section has to know.
fn _pdfc_tj(a, doc, sb, arr): i64 {
    return _pdfu_tj_a(a, doc, sb, arr, 0);
}

# Skip an inline image, from just after `BI` to just past its `EI`. Returns 1
# when the terminator was found, 0 when the stream ended first (cursor parked
# at the end).
#
# THIS IS NOT AN OPTIMISATION. An inline image's payload sits raw in the
# content stream between `ID` and `EI`, and those bytes are image data, not
# operators. A lexer that walked into them would tokenise them as numbers,
# names and keywords, and would either emit binary garbage as extracted text or
# reject the page over a byte that was never meant to be read as syntax.
#
# The terminator must be preceded by whitespace AND followed by a delimiter,
# whitespace, or end of input. Compressed image data contains the two bytes
# `EI` with probability that is not small, and both boundary tests are what
# make an accidental occurrence inside the payload not end the image early.
fn _pdfc_skip_inline(ps): i64 {
    var buf = load64(ps);
    var len = load64(ps + 8);
    var p   = load64(ps + 16);
    while (p + 2 <= len) {
        if (load8(buf + p) == 69) {
            if (load8(buf + p + 1) == 73) {
                var pre = 0;
                if (p > 0) {
                    if (_pdfe_is_ws(load8(buf + p - 1)) == 1) { pre = 1; }
                }
                var post = 0;
                if (p + 2 >= len) { post = 1; }
                else {
                    var nc = load8(buf + p + 2);
                    if (_pdfe_is_ws(nc) == 1)      { post = 1; }
                    elif (_pdfe_is_delim(nc) == 1) { post = 1; }
                }
                if (pre == 1 && post == 1) {
                    store64(ps + 16, p + 2);
                    return 1;
                }
            }
        }
        p = p + 1;
    }
    store64(ps + 16, len);
    return 0;
}

# Push one operand cell onto the pending-operand list, capped.
#
# NOTE: the list is named `ops` rather than `stack` because `stack` is a
# reserved word in cyrius and cannot be an identifier.
#
# The cap is not decoration: an operand run with no operator after it is a
# perfectly parseable byte sequence, so a hostile page could otherwise push
# unboundedly. Dropping from the FRONT keeps the newest operands, which are the
# ones every operator reads.
fn _pdfc_push(a, ops, o): i64 {
    while (vec_len(ops) >= 64) { vec_remove(ops, 0); }
    if (vec_push_a(a, ops, o) < 0) { return 0 - 1; }
    return 0;
}

# The last operand, or 0 when there is none. The oracle reads stack[-1] for Tj
# and TJ, so this does too.
fn _pdfc_top(ops): i64 {
    var n = vec_len(ops);
    if (n <= 0) { return 0; }
    return vec_get(ops, n - 1);
}

# The operator loop, font-aware.
#
# `ps` is seeded over the page's DECODED content bytes; `sb` collects the
# extracted text; `fdict` is the page's /Resources /Font dictionary, or 0 when
# the page has none. Structure mirrors pdfcheck.py's page_text exactly (D18):
# a byte that can start an operand starts one, anything else that is a regular
# character is an operator, and everything else is skipped one byte at a time.
# The pending-operand list is cleared after every operator, so operands never
# leak from one to the next.
#
# THE FONT IS STATE, and the only text state this extractor models. `Tf` names
# a resource in `fdict`; every show-text operator after it decodes through that
# font's map until the next `Tf`. It is tracked here rather than in the PdfState
# because it belongs to the CONTENT STREAM being scanned, not to the lexer —
# and because a module-global "current font" would be the thoth bug wearing a
# different variable name, reachable the moment two threads extract from one
# document.
#
# The font deliberately does NOT reset at `BT` or unwind at `Q`. PDF says text
# state survives BT/ET and that `q`/`Q` save and restore it, so a fully correct
# model needs a graphics-state stack; what real content streams do is emit `Tf`
# before every run that needs one. Carrying the last `Tf` forward is right for
# those and no worse than the alternative for the rest — and the alternative,
# resetting to "no font", would silently re-Latin-1 a Type0 run.
#
# NO `N G R` LOOKAHEAD. Content streams contain no indirect references, and
# running the reference probe here would try to read an `R` out of the middle
# of `1 0 0 RG` — a real operator with a leading `R`. Numbers therefore go
# straight to _pdfl_read_number, which is the same scanner _pdfp_obj_a uses one
# level down, not a second grammar.
#
# A number at the top level is pushed as the null cell rather than as an
# allocated one: the only operators that read their operands are Tf, Tj, TJ, '
# and ", all of which want a name, a string or an array, and a number is none
# of them. Numbers INSIDE a TJ array are real cells — _pdfp_obj_a builds those
# — which is where the -120 rule needs them.
#
# ERROR HANDLING. A malformed operand records a NON-FATAL error on the document
# (per-object failures are recorded, not fatal — D13), then clears the state's
# sticky first-wins error and advances one byte, exactly as the oracle does.
# Continuing is deliberate: a page that ends in three corrupt bytes should give
# up its text and an error count, not neither. The error is on the document, so
# the failure is countable and visible; nothing is recovered silently.
fn _pdfu_scan_a(a, doc, ps, sb, fdict): i64 {
    var ops = vec_new_a(a);
    if (ops == 0) { return 0 - 1; }
    var kw16[16];
    var num16[16];
    var len = load64(ps + 8);
    var buf = load64(ps);
    var fmap = 0;

    while (1 == 1) {
        _pdfl_skip_ws(ps);
        var pos = load64(ps + 16);
        if (pos >= len) { break; }
        var c = load8(buf + pos);

        # --- operands that _pdfp_obj_a owns: ( <hex> <<dict>> [array] /name ---
        if (c == 40 || c == 60 || c == 91 || c == 47) {
            var o = _pdfp_obj_a(a, ps);
            if (o == 0) {
                _pdfe_doc_err(doc, "malformed operand in content stream", pos);
                store64(ps + 24, 0);
                store64(ps + 32, 0 - 1);
                store64(ps + 16, pos + 1);
                vec_truncate(ops, 0);
            } else {
                # THE PROGRESS GUARD. Every operand form _pdfp_obj_a accepts
                # consumes at least its opening delimiter, so the cursor always
                # moves — but "always" is an argument about code that could
                # change, and the failure mode if it ever stopped being true is
                # an infinite loop on attacker-supplied bytes rather than a
                # wrong answer. One comparison buys immunity, and it is what
                # the reference oracle does at the same point.
                if (load64(ps + 16) == pos) { store64(ps + 16, pos + 1); }
                if (_pdfc_push(a, ops, o) != 0) { return 0 - 1; }
            }
            continue;
        }

        # --- numeric operands ------------------------------------------------
        if (_pdfe_is_digit(c) == 1 || c == 43 || c == 45 || c == 46) {
            if (_pdfl_read_number(ps, &num16) == 0) {
                _pdfe_doc_err(doc, "malformed number in content stream", pos);
                store64(ps + 24, 0);
                store64(ps + 32, 0 - 1);
                store64(ps + 16, pos + 1);
                vec_truncate(ops, 0);
            } else {
                if (_pdfc_push(a, ops, 0) != 0) { return 0 - 1; }
            }
            continue;
        }

        # --- a delimiter that cannot open an operand: ) ] > { } ---------------
        # These are stray closers in a stream we are reading tolerantly. One
        # byte forward, exactly as the oracle steps over them. `%` never
        # reaches here: _pdfl_skip_ws consumes comments.
        if (_pdfe_is_regular(c) == 0) {
            store64(ps + 16, pos + 1);
            continue;
        }

        # --- an operator -----------------------------------------------------
        if (_pdfl_read_kw(ps, &kw16) == 0) {
            store64(ps + 16, pos + 1);
            continue;
        }
        var kp = load64(&kw16);
        var kl = load64(&kw16 + 8);

        if (kl == 2) {
            if (memeq(kp, "Tj", 2) == 1) {
                var tv = _pdfc_top(ops);
                if (_pdfo_tag(tv) == PTAG_STR) {
                    _pdfu_emit_a(a, sb, bayan_pdf_obj_bytes(tv), fmap);
                }
            } elif (memeq(kp, "TJ", 2) == 1) {
                _pdfu_tj_a(a, doc, sb, _pdfc_top(ops), fmap);
            } elif (memeq(kp, "Tf", 2) == 1) {
                # `/F1 12 Tf` — the size is on top, so the scan runs backwards
                # to the last NAME. Backwards rather than reading ops[-2]
                # because a malformed stream can leave a different number of
                # operands pending, and a wrong resource name is a wrong
                # decoding for every run that follows it.
                var j = vec_len(ops);
                while (j > 0) {
                    j = j - 1;
                    var fe = vec_get(ops, j);
                    if (_pdfo_tag(fe) == PTAG_NAME) {
                        fmap = _pdfu_font_by_name(doc, fdict, bayan_pdf_obj_name(fe));
                        break;
                    }
                }
            } elif (memeq(kp, "Td", 2) == 1) {
                _pdfw_putc(a, sb, 10);
            } elif (memeq(kp, "TD", 2) == 1) {
                _pdfw_putc(a, sb, 10);
            } elif (memeq(kp, "T*", 2) == 1) {
                _pdfw_putc(a, sb, 10);
            } elif (memeq(kp, "ET", 2) == 1) {
                _pdfw_putc(a, sb, 10);
            } elif (memeq(kp, "BI", 2) == 1) {
                if (_pdfc_skip_inline(ps) == 0) {
                    _pdfe_doc_err(doc, "unterminated inline image (BI with no EI)", pos);
                }
            }
            # BT, Tm and TL fall through: they change state this extractor
            # does not model. Only Td / TD / T* / ET break a line (D18), and
            # adding Tm to that list would insert a newline into the middle of
            # every run our own writer emits, since text_pos emits Tm then Td.
        } elif (kl == 1) {
            # ' and " both show a run on a NEW line. The operand scan runs
            # backwards because " takes `aw ac string "` — the string is not
            # necessarily the only operand, merely the last one that is bytes.
            if (load8(kp) == 39 || load8(kp) == 34) {
                var j2 = vec_len(ops);
                while (j2 > 0) {
                    j2 = j2 - 1;
                    var e = vec_get(ops, j2);
                    if (_pdfo_tag(e) == PTAG_STR) {
                        _pdfw_putc(a, sb, 10);
                        _pdfu_emit_a(a, sb, bayan_pdf_obj_bytes(e), fmap);
                        break;
                    }
                }
            }
        }
        vec_truncate(ops, 0);
    }
    return 0;
}

# The operator loop with no font resources — every byte WinAnsi. Kept at its
# original name and signature; extraction proper goes through _pdfu_scan_a with
# the page's /Font dictionary.
fn _pdfc_scan_a(a, doc, ps, sb): i64 {
    return _pdfu_scan_a(a, doc, ps, sb, 0);
}

# 1 for the ASCII whitespace bytes Python's str.strip() removes. NOT
# _pdfe_is_ws: that set includes NUL, which PDF counts as whitespace but which
# strip() does not remove, and the extraction rules are pinned to the oracle's
# behaviour rather than to PDF's lexical classes.
fn _pdfc_is_strip(c): i64 {
    if (c == 9)  { return 1; }
    if (c == 10) { return 1; }
    if (c == 11) { return 1; }
    if (c == 12) { return 1; }
    if (c == 13) { return 1; }
    if (c == 32) { return 1; }
    return 0;
}

# Apply the oracle's two normalisation rules to the raw extraction: collapse
# runs of three or more LF to two, then strip leading and trailing whitespace.
#
# Both rules exist because the raw operator trace is noisy in a way that says
# nothing about the document: our own writer emits Tm-then-Td and then ET, so a
# one-line page produces "\n" + text + "\n" before anything else happens. Three
# newlines mean "a blank line was intended"; four mean the same thing.
#
# Stripping ASCII whitespace bytes is safe on UTF-8 output: every byte of a
# multi-byte sequence is >= 0x80, so no continuation byte can be mistaken for
# a space. The output length never exceeds the input, so one allocation sized
# n + 1 is exact — the + 1 both holds the NUL and dodges alloc(0) == 0 (G15).
fn _pdfc_normalise_a(a, s: Str): Str {
    if (s == 0) { return _pdfo_empty_bytes(); }
    var n = str_len(s);
    var p = str_data(s);
    var out = alloc_via(a, n + 1);
    if (out == 0) { return _pdfo_empty_bytes(); }
    var i = 0;
    var w = 0;
    while (i < n) {
        var c = load8(p + i);
        if (c == 10) {
            var j = i;
            while (j < n) {
                if (load8(p + j) != 10) { break; }
                j = j + 1;
            }
            var run = j - i;
            if (run >= 3) { run = 2; }
            var k = 0;
            while (k < run) {
                store8(out + w, 10);
                w = w + 1;
                k = k + 1;
            }
            i = j;
        } else {
            store8(out + w, c);
            w = w + 1;
            i = i + 1;
        }
    }
    var st = 0;
    while (st < w) {
        if (_pdfc_is_strip(load8(out + st)) == 0) { break; }
        st = st + 1;
    }
    var en = w;
    while (en > st) {
        if (_pdfc_is_strip(load8(out + en - 1)) == 0) { break; }
        en = en - 1;
    }
    store8(out + en, 0);
    return str_new_a(a, out + st, en - st);
}

# Warn once per page for every font resource that offers NO usable mapping.
#
# The only shape that reaches this today is a composite /Type0 face with no
# /ToUnicode CMap: its codes are CIDs — indices into a glyph program — and
# nothing outside the embedded font file relates them to characters. bayan
# decodes what it can and emits NOTHING for those runs (_pdfu_emit_a), so the
# warning is the only thing that distinguishes "this page had no text" from
# "this page had text bayan refused to guess at".
#
# Through 1.5.0 this warned for EVERY /Type0 font, including the overwhelming
# majority that do carry a /ToUnicode, and the text it warned about was
# WinAnsi-decoded mojibake. Loud and wrong is still wrong.
#
# It also warms the per-font cache for the page, so the scan that follows finds
# every font already parsed.
fn _pdfc_warn_type0(doc, pg): i64 {
    var fdict = _pdfu_page_fonts(doc, pg);
    if (fdict == 0) { return 0; }
    var n = bayan_pdf_obj_dict_len(fdict);
    var i = 0;
    var bad = 0;
    while (i < n) {
        var fo = bayan_pdf_resolve(doc, bayan_pdf_obj_dict_value(fdict, i));
        var fm = _pdfu_fmap_for(doc, fo);
        if (fm != 0) {
            if (load64(fm + 40) == 0) {
                _pdfe_doc_warn(doc,
                  "page uses a /Type0 font with no /ToUnicode CMap; its text runs are dropped, not guessed at");
                bad = 1;
            }
        }
        i = i + 1;
    }
    return bad;
}

# Extract one page's text as UTF-8, allocating through `a`. The empty Str on a
# bad handle or an undecodable content stream — never 0, so str_len is safe.
#
# The PdfState is a 64-BYTE stack local (G2: `var ps[64]` is bytes, and 64 is
# exactly _PDF_STATE_SIZE), so two threads extracting from the same document
# share no cursor. That is the thoth lesson applied at the outermost layer as
# well as the innermost.
fn bayan_pdf_page_extract_text_a(a, doc, pg): Str {
    if (_pdfe_magic(doc, 0 - 1) == 0) { return _pdfo_empty_bytes(); }
    if (load64(doc + 8) != PDF_MODE_READ) {
        # A writer document HAS no /Contents until it is sealed, so extraction
        # would answer the empty Str and look like a page with no text. Naming
        # the mismatch is the difference between "no text" and "wrong handle".
        _pdfe_doc_err(doc, "text extraction needs a parsed document, not a writer document", 0 - 1);
        return _pdfo_empty_bytes();
    }
    if (pg == 0) { return _pdfo_empty_bytes(); }
    _pdfc_warn_type0(doc, pg);
    var content = bayan_pdf_page_content_a(a, doc, pg);
    if (content == 0)          { return _pdfo_empty_bytes(); }
    if (str_len(content) == 0) { return _pdfo_empty_bytes(); }
    var sb = str_builder_new_a(a);
    if (sb == 0) { return _pdfo_empty_bytes(); }
    var ps[64];
    _pdfe_state_init(&ps, str_data(content), str_len(content), a);
    # The page's /Resources /Font dictionary is what turns a Tf operand into a
    # decoding. The font maps themselves are cached on the DOCUMENT's
    # allocator, not on `a`: they outlive this one page, and a 357-page file
    # that re-inflated the same CMap once per page would spend more time in
    # zlib than in the scanner.
    _pdfu_scan_a(a, doc, &ps, sb, _pdfu_page_fonts(doc, pg));
    return _pdfc_normalise_a(a, str_builder_build_a(a, sb));
}

# Extract one page's text as UTF-8 through default_alloc().
fn bayan_pdf_page_extract_text(doc, pg): Str {
    return bayan_pdf_page_extract_text_a(default_alloc(), doc, pg);
}

# Extract the whole document's text, pages joined by a single LF, allocating
# through `a`.
#
# The join is a plain LF and NOT the per-page normalisation applied again: each
# page has already been collapsed and stripped, so a page boundary is exactly
# one newline. Re-collapsing across the join would merge a page that genuinely
# ends in a blank line with the next page's first line.
fn bayan_pdf_extract_text_a(a, doc): Str {
    if (_pdfe_magic(doc, 0 - 1) == 0) { return _pdfo_empty_bytes(); }
    var n = bayan_pdf_page_count(doc);
    if (n <= 0) { return _pdfo_empty_bytes(); }
    var sb = str_builder_new_a(a);
    if (sb == 0) { return _pdfo_empty_bytes(); }
    var i = 0;
    while (i < n) {
        if (i > 0) { _pdfw_putc(a, sb, 10); }
        _pdfw_bytes(a, sb, bayan_pdf_page_extract_text_a(a, doc, bayan_pdf_page(doc, i)));
        i = i + 1;
    }
    return str_builder_build_a(a, sb);
}

# Extract the whole document's text through default_alloc().
fn bayan_pdf_extract_text(doc): Str {
    return bayan_pdf_extract_text_a(default_alloc(), doc);
}

# === _pdfw_ — document assembly: objects, xref table, trailer, self-check ====
#
# Section 15 turned a PdfObj into PDF syntax. This section turns a PdfDoc into
# a FILE: it allocates object numbers, emits every object as `N 0 obj … endobj`,
# writes the cross-reference table, writes the trailer, and then re-reads its
# own output to prove every recorded offset lands where it claims to.
#
# TWO RULES GOVERN EVERYTHING BELOW.
#
# RULE 1 — object numbers come from A COUNTER (D6). `_pdfw_push_obj` appends
# the cell to doc.objs and hands back the vec index; the index IS the object
# number, with slot 0 permanently the free head so no `+ 1` appears anywhere.
# mneme's writer computes them in closed form (`4 + 2p` for a page dict,
# `5 + 2p` for its content stream, io_export_pdf.cyr) — verified correct today
# and silently wrong the moment an /Info dictionary, a second font, or an /ID
# joins the file, because every one of those constants has to be re-derived by
# hand. A counter has no arithmetic to get wrong.
#
# RULE 2 — every byte offset is MEASURED, never predicted (D8, §6.1). The
# header, the binary comment line and all object bodies go into ONE
# str_builder, and the offset for object n is `_pdfw_pos(sb)` read immediately
# before object n is appended. mneme hardcodes `var offset = 9;` — the length
# of "%PDF-1.4\n" — and adds up body lengths from there. bayan emits a two-line
# header ("%PDF-1.7\n" plus the six-byte binary marker line = 15 bytes), so a
# predicted constant is six bytes short for EVERY object, and scripts/
# pdfcheck.py answers with five "does not point at an object header" errors and
# a fatal page-tree failure. The oracle deliberately refuses to rescan for
# `N 0 obj` the way poppler does, precisely so this class of bug cannot hide.
#
# And a third, belt-and-braces: _pdfw_selfcheck re-reads the finished bytes and
# memeq's "<k> 0 obj" at every offset the writer recorded, BEFORE to_bytes
# returns. A byte-accounting bug becomes an empty Str and a loud doc error
# instead of a file that opens in some viewers and not others.

# --- the object counter -----------------------------------------------------

# Append `o` to the document's object table and return its object number, or 0
# on failure. THE COUNTER (D6): the vec index and the PDF object number are the
# same integer.
#
# Slot 0 is created on first use and stays 0 forever — it is object 0, the head
# of the free list, which every PDF has and no PDF ever stores. Keeping it in
# the vec is what removes the off-by-one that a "0 means the first real object"
# table would need at every read.
fn _pdfw_push_obj(a, doc, o): i64 {
    if (doc == 0 || o == 0) { return 0; }
    var objs = load64(doc + 24);
    if (objs == 0) { return 0; }
    if (vec_len(objs) == 0) {
        if (vec_push_a(a, objs, 0) < 0) { return 0; }
    }
    if (vec_len(objs) >= _PDF_MAX_OBJS) {
        _pdfe_doc_err(doc, "too many objects in one document", 0 - 1);
        return 0;
    }
    var num = vec_len(objs);
    # vec_push_a, never vec_push: vec_push exit(1)s the process on a grow OOM
    # (lib/vec.cyr:132-140), and a writer must report OOM, not abort a caller.
    if (vec_push_a(a, objs, o) < 0) { return 0; }
    return num;
}

# Object number of the cell `o` in the document's table, or 0 if it has none.
#
# A linear scan, run at most twice per file (the catalog and the /Info dict),
# over a table whose size is the object count. Storing the two numbers in
# PdfDoc slots would be faster and would also be two more pieces of state that
# can disagree with the table; the table is the single source of truth for
# "which number is this object", so it is the thing that gets asked.
fn _pdfw_numof(doc, o): i64 {
    if (doc == 0 || o == 0) { return 0; }
    var objs = load64(doc + 24);
    if (objs == 0) { return 0; }
    var n = vec_len(objs);
    var i = 1;
    while (i < n) {
        if (vec_get(objs, i) == o) { return i; }
        i = i + 1;
    }
    return 0;
}

# --- font objects -----------------------------------------------------------

# Build the /Type /Font dictionary for standard-14 face `font_id`, append it to
# the object table, and return its object number (0 on failure).
#
#     << /Type /Font /Subtype /Type1 /BaseFont /Helvetica
#        /Encoding /WinAnsiEncoding >>
#
# /Encoding IS THE POINT OF THIS FUNCTION. A Type1 font dictionary with no
# /Encoding key uses the font program's built-in encoding, which for the twelve
# text faces is StandardEncoding — and StandardEncoding is NOT WinAnsi above
# 0x7F. mneme omits the key, so its writer transcodes "Résumé" to WinAnsi bytes
# (0xE9 for e-acute) and then tells the viewer to read them as Standard, where
# 0xE9 is the ligature "OE"; the em-dash 0x97 has no Standard glyph at all and
# is dropped silently. Declaring WinAnsi without transcoding, and transcoding
# without declaring it, are each exactly half a fix and each produce a
# different flavour of mojibake (§6.3).
#
# Symbol and ZapfDingbats are the two exceptions, and they are exceptions in
# the spec, not a workaround: their built-in encodings are their own glyph
# sets, WinAnsi cannot name a single one of those glyphs, and PDF 32000-1
# §9.6.6.1 says an /Encoding entry on them is ignored at best.
fn _pdfw_font_obj(a, doc, font_id): i64 {
    if (font_id < 0 || font_id >= PDF_FONT_COUNT) {
        _pdfe_doc_err(doc, "unknown standard-14 font id in the document font table", 0 - 1);
        return 0;
    }
    var d = bayan_pdf_obj_dict_new_a(a);
    if (d == 0) { return 0; }
    if (bayan_pdf_obj_dict_set_a(a, d, "Type",
        bayan_pdf_obj_name_new_a(a, "Font")) != 0) { return 0; }
    if (bayan_pdf_obj_dict_set_a(a, d, "Subtype",
        bayan_pdf_obj_name_new_a(a, "Type1")) != 0) { return 0; }
    if (bayan_pdf_obj_dict_set_a(a, d, "BaseFont",
        bayan_pdf_obj_name_new_a(a, _pdff_basefont(font_id))) != 0) { return 0; }
    if (font_id != PDF_FONT_SYMBOL && font_id != PDF_FONT_ZAPFDINGBATS) {
        if (bayan_pdf_obj_dict_set_a(a, d, "Encoding",
            bayan_pdf_obj_name_new_a(a, "WinAnsiEncoding")) != 0) { return 0; }
    }
    return _pdfw_push_obj(a, doc, d);
}

# --- page objects -----------------------------------------------------------

# Emit one page as two objects — its content stream and its /Page dictionary —
# and return the dictionary's object number (0 on failure).
#
# The page dictionary already exists and is nearly complete:
# bayan_pdf_add_page built it eagerly with /Type, /MediaBox and an empty
# /Resources /Font, and bayan_pdf_use_font has since filled that /Font in. This
# function adds only the two keys that CANNOT be known before numbering starts
# — /Parent and /Contents — and then numbers the dictionary.
#
# It does NOT rebuild /Resources. The font entries there hold the one shared
# PTAG_REF cell per face that _pdfw_build_tree patches with the real object
# number; rebuilding the dictionary here would be the same information derived
# a second way, which is exactly how two views of "which object is F1" come to
# disagree.
fn _pdfw_page_obj(a, doc, pg, ptree_num): i64 {
    if (pg == 0) { return 0; }
    var pd = load64(pg + 16);
    if (pd == 0 || _pdfo_tag(pd) != PTAG_DICT) {
        _pdfe_doc_err(doc, "page has no dictionary", 0 - 1);
        return 0;
    }
    # pdfcheck.py flags a page with no /MediaBox, and so does every viewer that
    # then has to guess a size. The writer cannot invent one — PdfPage carries
    # no width/height of its own, the box IS the width and height — so a page
    # that reached here without one is a bug upstream and is refused loudly.
    if (_pdfo_dict_find(pd, "MediaBox", 8) < 0) {
        _pdfe_doc_err(doc, "page has no /MediaBox", 0 - 1);
        return 0;
    }
    # Likewise /Resources: pdfcheck.py reports "page N: /Resources missing or
    # not a dictionary", and a page dict that lost it did not come from
    # bayan_pdf_add_page.
    if (_pdfo_dict_find(pd, "Resources", 9) < 0) {
        _pdfe_doc_err(doc, "page has no /Resources dictionary", 0 - 1);
        return 0;
    }

    # --- the content stream ---------------------------------------------
    var data = _pdfo_empty_bytes();
    var cb = load64(pg + 24);
    if (cb != 0) {
        data = str_builder_build_a(a, cb);
        if (data == 0) {
            _pdfe_doc_err(doc, "out of memory building a page content stream", 0 - 1);
            return 0;
        }
    }

    # THE ROW-3 INVARIANT (D9, §6.2). The payload must not end on an EOL byte,
    # because there is also no EOL between the payload and `endstream`. That
    # combination is the ONLY one of the four possible layouts in which both a
    # /Length one short and a /Length one long fail the oracle: with a trailing
    # newline anywhere, an over-long /Length simply eats it and a broken file
    # ships green. The content builder already emits separators BEFORE each
    # operator line rather than after, so this loop normally removes nothing;
    # it is here so the invariant is enforced at the one place that depends on
    # it rather than assumed across a section boundary.
    var dn = str_len(data);
    var dp = str_data(data);
    while (dn > 0) {
        var lc = load8(dp + dn - 1);
        if (lc != 10 && lc != 13) { break; }
        dn = dn - 1;
    }
    if (dn != str_len(data)) {
        # A Str header borrowing a prefix of the built buffer — the buffer is a
        # fresh copy owned by `a` and outlives this call, and nothing ever
        # strlen()s a payload, so the missing NUL at dn is not observable.
        data = str_new_a(a, dp, dn);
        if (data == 0) {
            _pdfe_doc_err(doc, "out of memory trimming a page content stream", 0 - 1);
            return 0;
        }
    }

    var sdict = bayan_pdf_obj_dict_new_a(a);
    if (sdict == 0) {
        _pdfe_doc_err(doc, "out of memory building a stream dictionary", 0 - 1);
        return 0;
    }
    # bit0 of doc.flags is "compress". bayan_pdf_set_compress already refused
    # to set it without a deflate hook installed, so reaching _pdfz_deflate_a
    # with none is not possible from the public API; the failure path is still
    # honoured because _pdfz_deflate_a reports OOM and hook errors the same way.
    #
    # Compression runs AFTER the trim, so a deflated payload can end on an 0x0A
    # byte that happens to fall there. That weakens the /Length + 1 half of the
    # mutation gate for compressed streams only — the file is still exactly as
    # valid, and the uncompressed path (the default, and the one the gate runs
    # against) keeps the full guarantee. Trimming compressed bytes would corrupt
    # the stream, so there is nothing to do about it and nothing that should be.
    if ((load64(doc + 120) & 1) == 1 && dn > 0) {
        var z = _pdfz_deflate_a(a, doc, str_data(data), str_len(data));
        if (z == 0) { return 0; }        # _pdfz_deflate_a recorded the reason
        data = z;
        if (bayan_pdf_obj_dict_set_a(a, sdict, "Filter",
            bayan_pdf_obj_name_new_a(a, "FlateDecode")) != 0) {
            _pdfe_doc_err(doc, "out of memory setting /Filter /FlateDecode", 0 - 1);
            return 0;
        }
    }

    # /Length is NOT set here. _pdfw_dict_with_length computes it at emit time
    # from str_len() of the very Str it is about to append — one source, one
    # layout (D9). Anything written into the dictionary now would be a second
    # source and would eventually disagree.
    var cs = bayan_pdf_obj_stream_new_a(a, sdict, data);
    if (cs == 0) {
        _pdfe_doc_err(doc, "out of memory building the content stream object", 0 - 1);
        return 0;
    }
    var cnum = _pdfw_push_obj(a, doc, cs);
    if (cnum == 0) { return 0; }

    # --- complete and number the page dictionary ------------------------
    #
    # bayan_pdf_obj_dict_set_a replaces an existing key IN PLACE, so a page
    # written twice does not accumulate duplicate /Parent or /Contents entries
    # and the key order — and therefore the output bytes — stay identical.
    if (bayan_pdf_obj_dict_set_a(a, pd, "Parent",
        bayan_pdf_obj_ref_new_a(a, ptree_num, 0)) != 0) {
        _pdfe_doc_err(doc, "out of memory completing a page dictionary", 0 - 1);
        return 0;
    }
    if (bayan_pdf_obj_dict_set_a(a, pd, "Contents",
        bayan_pdf_obj_ref_new_a(a, cnum, 0)) != 0) {
        _pdfe_doc_err(doc, "out of memory completing a page dictionary", 0 - 1);
        return 0;
    }

    var pnum = _pdfw_push_obj(a, doc, pd);
    if (pnum == 0) { return 0; }
    store64(pg + 8, pnum);
    return pnum;
}

# --- the document object tree ----------------------------------------------

# Build every indirect object the file needs — font dictionaries, page content
# streams, page dictionaries, the /Pages tree, the /Catalog and the /Info
# dictionary — into doc.objs. 0 on success, 0 - 1 on failure.
#
# The order is forced by one dependency: a /Page carries /Parent, so the
# /Pages node must own a number before any page is emitted. It gets one by
# being pushed EMPTY and filled in afterwards — reserving through the counter
# rather than reasoning about what its number will turn out to be.
#
# The table is rebuilt from scratch on every call, which makes to_bytes
# idempotent: calling it twice, or calling to_bytes and then write_file, cannot
# double-number the same objects.
fn _pdfw_build_tree(a, doc): i64 {
    var objs = load64(doc + 24);
    if (objs == 0) { return 0 - 1; }
    vec_truncate(objs, 0);
    if (vec_push_a(a, objs, 0) < 0) { return 0 - 1; }

    # Fonts first. Numbering them first keeps the low object numbers stable
    # across edits to the page content, which makes diffing two outputs useful.
    #
    # PdfFont is {std_id@0, objnum@8, resname Str*@16, ref cell@24}. Slot 24
    # holds the ONE PTAG_REF cell that every page's /Resources /Font entry for
    # this face points at, created with number 0 by bayan_pdf_use_font. Setting
    # its number here patches all of them at once. The alternative — walking
    # every page's resource dictionary looking for entries that name this face
    # — is the same fact stored in N places, and the first page the walk misses
    # gets `/F1 0 0 R`, a reference to the free object, which resolves to null
    # and renders no text at all.
    var fonts = load64(doc + 40);
    if (fonts != 0) {
        var nfo = vec_len(fonts);
        var i = 0;
        while (i < nfo) {
            var fr = vec_get(fonts, i);
            if (fr == 0) { return 0 - 1; }
            var fnum = _pdfw_font_obj(a, doc, load64(fr));
            if (fnum == 0) { return 0 - 1; }
            store64(fr + 8, fnum);
            var ref = load64(fr + 24);
            if (ref != 0) {
                if (_pdfo_tag(ref) != PTAG_REF) { return 0 - 1; }
                store64(ref + 8, fnum);
            }
            i = i + 1;
        }
    }

    # Reserve the /Pages number by pushing the (still empty) node.
    var ptree = bayan_pdf_obj_dict_new_a(a);
    if (ptree == 0) { return 0 - 1; }
    var ptree_num = _pdfw_push_obj(a, doc, ptree);
    if (ptree_num == 0) { return 0 - 1; }

    var kids = bayan_pdf_obj_array_new_a(a);
    if (kids == 0) { return 0 - 1; }
    var pages = load64(doc + 32);
    var np = 0;
    if (pages != 0) { np = vec_len(pages); }
    var k = 0;
    while (k < np) {
        var pnum = _pdfw_page_obj(a, doc, vec_get(pages, k), ptree_num);
        if (pnum == 0) { return 0 - 1; }
        if (bayan_pdf_obj_array_push_a(a, kids,
            bayan_pdf_obj_ref_new_a(a, pnum, 0)) != 0) { return 0 - 1; }
        k = k + 1;
    }

    # A single flat /Pages node. A balanced tree matters for a 10,000-page
    # document a viewer opens at page 9,000; bayan's writer is a document
    # generator, the reader handles arbitrary trees, and a flat node is the
    # shape whose /Count cannot drift from its /Kids.
    if (bayan_pdf_obj_dict_set_a(a, ptree, "Type",
        bayan_pdf_obj_name_new_a(a, "Pages")) != 0) { return 0 - 1; }
    if (bayan_pdf_obj_dict_set_a(a, ptree, "Kids", kids) != 0) { return 0 - 1; }
    if (bayan_pdf_obj_dict_set_a(a, ptree, "Count",
        bayan_pdf_obj_int_new_a(a, np)) != 0) { return 0 - 1; }
    store64(doc + 64, ptree);

    var cat = bayan_pdf_obj_dict_new_a(a);
    if (cat == 0) { return 0 - 1; }
    if (bayan_pdf_obj_dict_set_a(a, cat, "Type",
        bayan_pdf_obj_name_new_a(a, "Catalog")) != 0) { return 0 - 1; }
    if (bayan_pdf_obj_dict_set_a(a, cat, "Pages",
        bayan_pdf_obj_ref_new_a(a, ptree_num, 0)) != 0) { return 0 - 1; }
    if (_pdfw_push_obj(a, doc, cat) == 0) { return 0 - 1; }
    store64(doc + 56, cat);

    # /Info is optional and is only given a number when it has something to
    # say. An empty << >> in the trailer is legal and useless.
    var info = load64(doc + 72);
    if (info != 0) {
        if (bayan_pdf_obj_dict_len(info) > 0) {
            if (_pdfw_push_obj(a, doc, info) == 0) { return 0 - 1; }
        }
    }
    return 0;
}

# --- indirect objects -------------------------------------------------------

# Emit one indirect object: `N 0 obj`, a newline, the body, a newline, `endobj`.
#
# The header shape is what every xref offset is checked against, here and by
# pdfcheck.py's `(\d+)\s+(\d+)\s+obj`. Generation is always 0: bayan's writer
# never produces an incremental update, so no object has ever been freed and
# reused, and a non-zero generation would be a claim about history that did not
# happen.
#
# The newline before `endobj` is a separator, not decoration — without it a
# stream body ending in `endstream` would run straight into `endobj`, and a
# numeric body would merge with the keyword.
fn _pdfw_indirect(a, sb, num, o): i64 {
    if (sb == 0 || o == 0) { return 0 - 1; }
    if (_pdfw_num(a, sb, num) != 0)          { return 0 - 1; }
    if (_pdfw_kw(a, sb, " 0 obj\n") != 0)    { return 0 - 1; }
    if (_pdfw_obj(a, sb, o, 0) != 0)         { return 0 - 1; }
    return _pdfw_kw(a, sb, "\nendobj\n");
}

# --- the cross-reference table ---------------------------------------------

# Append `v` as exactly ten decimal digits, zero-padded. 0 on success, 0 - 1 if
# it does not fit.
#
# REFUSES rather than truncates. A ten-digit field holds offsets below 10 GB;
# an eleven-digit offset silently losing its leading digit would produce a
# table that points into the middle of the file and a document that opens
# nowhere, so the writer stops instead and the caller gets a named error.
fn _pdfw_pad10(a, sb, v): i64 {
    if (v < 0 || v >= 10000000000) { return 0 - 1; }
    var k = 10;
    while (k > 0) {
        k = k - 1;
        if (_pdfw_putc(a, sb, 48 + ((v / _pdfe_pow10(k)) % 10)) != 0) { return 0 - 1; }
    }
    return 0;
}

# Emit the classic cross-reference table for objects 0..n-1, reading each
# offset from `offsets` (index == object number). 0 on success, 0 - 1 on
# failure.
#
#     xref
#     0 <n>
#     0000000000 65535 f \n
#     0000000015 00000 n \n
#     ...
#
# EVERY ENTRY IS EXACTLY 20 BYTES, and that is a hard requirement rather than a
# convention: pdfcheck.py:370 advances its cursor by an unconditional
# `lx.pos += 20`, so a 19-byte entry desynchronises the whole table and turns
# the next entry into a FATAL parse error. The layout is ten digits, a space,
# five digits, a space, the `n`/`f` type byte, then a two-byte EOL — here
# space + LF, which is one of the three forms PDF 32000-1 §7.5.4 permits and
# one of the three pdfcheck.py:373 accepts without a warning.
#
# Object 0 is the head of the free list with generation 65535, as every PDF
# has had since 1.0. One subsection covering the whole range: bayan's writer
# never leaves a gap, because the counter never skips a number.
fn _pdfw_xref(a, sb, offsets, n): i64 {
    if (sb == 0 || offsets == 0) { return 0 - 1; }
    if (_pdfw_kw(a, sb, "xref\n0 ") != 0) { return 0 - 1; }
    if (_pdfw_num(a, sb, n) != 0)         { return 0 - 1; }
    if (_pdfw_putc(a, sb, 10) != 0)       { return 0 - 1; }
    if (_pdfw_kw(a, sb, "0000000000 65535 f \n") != 0) { return 0 - 1; }
    var i = 1;
    var have = vec_len(offsets);
    while (i < n) {
        var off = 0;
        # Bounds-checked before the read: vec_get exit(1)s the process on an
        # out-of-range index (G7), and a table shorter than the object count
        # would be a writer bug worth reporting, not worth aborting over.
        if (i < have) { off = vec_get(offsets, i); }
        if (off <= 0) { return 0 - 1; }
        if (_pdfw_pad10(a, sb, off) != 0)         { return 0 - 1; }
        if (_pdfw_kw(a, sb, " 00000 n \n") != 0)  { return 0 - 1; }
        i = i + 1;
    }
    return 0;
}

# --- /ID --------------------------------------------------------------------

# FNV-1a over `n` bytes at `p`, seeded with `seed`. Not a cryptographic hash
# and not asked to be one: /ID exists so a viewer can tell two revisions of the
# same document apart, and deriving it from the finished bytes is what makes
# the writer REPRODUCIBLE — the same document written twice is the same file,
# which is the property §7.10's "to_bytes_a == to_bytes byte-for-byte"
# assertion rests on. A timestamp-based /ID would break it silently.
fn _pdfw_fnv(p, n, seed): i64 {
    var h = seed;
    var i = 0;
    if (p == 0) { return h; }
    while (i < n) {
        # load8 zero-extends, so the xor operand is 0..255. The multiply is
        # allowed to wrap; that is what a hash mixer is for.
        h = (h ^ load8(p + i)) * 1099511628211;
        i = i + 1;
    }
    return h;
}

# A deterministic 16-byte /ID value derived from everything written so far.
# 0 on OOM.
fn _pdfw_id_a(a, sb): Str {
    var p = load64(sb);
    var n = _pdfw_pos(sb);
    var h1 = _pdfw_fnv(p, n, 5381);
    var h2 = _pdfw_fnv(p, n, 63689);
    var b = alloc_via(a, 16);
    if (b == 0) { return 0; }
    var i = 0;
    while (i < 8) {
        # `>>` is LOGICAL in Cyrius and `>>>` is arithmetic — the reverse of
        # JS/Java (G12). Logical is exactly what is wanted here: h1 and h2 are
        # deliberately allowed to be negative, and a logical shift feeds the
        # sign bit into the top byte instead of smearing it across all eight.
        store8(b + i,     (h1 >> ((7 - i) * 8)) & 255);
        store8(b + 8 + i, (h2 >> ((7 - i) * 8)) & 255);
        i = i + 1;
    }
    return str_new_a(a, b, 16);
}

# --- the trailer ------------------------------------------------------------

# Emit the trailer dictionary, `startxref`, the cross-reference offset, and
# `%%EOF`. 0 on success, 0 - 1 on failure.
#
#     trailer
#     << /Size 9 /Root 8 0 R /Info 9 0 R /ID [<..16 bytes..> <..16 bytes..>] >>
#     startxref
#     15234
#     %%EOF
#
# /Size MUST EXCEED THE HIGHEST OBJECT NUMBER — it is the size of the
# cross-reference table, not the count of objects in it, so a file whose
# highest object is 8 declares 9. vec_len(doc.objs) is that number by
# construction, because slot 0 is in the vec. pdfcheck.py:333 checks it
# (`size < highest + 1`) and the reader's own /Size admission rule (§6.1)
# checks it again from the other side.
#
# /ID is a two-element array of byte strings. A file that has never been
# incrementally updated has the same value twice — the first element is the
# original document identity and the second is the current revision's, and this
# writer only ever emits originals.
fn _pdfw_trailer(a, sb, doc, xref_off): i64 {
    if (sb == 0 || doc == 0) { return 0 - 1; }
    var objs = load64(doc + 24);
    if (objs == 0) { return 0 - 1; }
    var size = vec_len(objs);

    var catnum = _pdfw_numof(doc, load64(doc + 56));
    if (catnum == 0) {
        _pdfe_doc_err(doc, "the document catalog was never numbered", 0 - 1);
        return 0 - 1;
    }

    if (_pdfw_kw(a, sb, "trailer\n<< /Size ") != 0) { return 0 - 1; }
    if (_pdfw_num(a, sb, size) != 0)                { return 0 - 1; }
    if (_pdfw_kw(a, sb, " /Root ") != 0)            { return 0 - 1; }
    if (_pdfw_num(a, sb, catnum) != 0)              { return 0 - 1; }
    if (_pdfw_kw(a, sb, " 0 R") != 0)               { return 0 - 1; }

    var infonum = _pdfw_numof(doc, load64(doc + 72));
    if (infonum != 0) {
        if (_pdfw_kw(a, sb, " /Info ") != 0) { return 0 - 1; }
        if (_pdfw_num(a, sb, infonum) != 0)  { return 0 - 1; }
        if (_pdfw_kw(a, sb, " 0 R") != 0)    { return 0 - 1; }
    }

    # A caller-supplied /ID lives in the writer's trailer dictionary, where
    # bayan_pdf_set_id put it. Anything else — including a trailer that does
    # not exist yet — falls through to the derived form, so the key is always
    # present and the derivation never overwrites a deliberate choice.
    var given = 0;
    var tr = load64(doc + 48);
    if (tr != 0) {
        if (_pdfo_tag(tr) == PTAG_DICT) {
            var ki = _pdfo_dict_find(tr, "ID", 2);
            if (ki >= 0) {
                var pr = vec_get(_pdfo_vec(tr), ki);
                if (pr != 0) { given = load64(pr + 8); }
            }
        }
    }
    if (_pdfw_kw(a, sb, " /ID ") != 0) { return 0 - 1; }
    if (given != 0 && _pdfo_tag(given) == PTAG_ARR) {
        if (_pdfw_obj(a, sb, given, 0) != 0) { return 0 - 1; }
    } else {
        # Derived from the header, every object body and the xref table — i.e.
        # from bytes that are already final. Computed here rather than earlier
        # for exactly that reason.
        var id = _pdfw_id_a(a, sb);
        if (id == 0) { return 0 - 1; }
        if (_pdfw_putc(a, sb, 91) != 0)      { return 0 - 1; }
        if (_pdfw_hexstr_a(a, sb, id) != 0)  { return 0 - 1; }
        if (_pdfw_putc(a, sb, 32) != 0)      { return 0 - 1; }
        if (_pdfw_hexstr_a(a, sb, id) != 0)  { return 0 - 1; }
        if (_pdfw_putc(a, sb, 93) != 0)      { return 0 - 1; }
    }

    if (_pdfw_kw(a, sb, " >>\nstartxref\n") != 0) { return 0 - 1; }
    if (_pdfw_num(a, sb, xref_off) != 0)          { return 0 - 1; }
    return _pdfw_kw(a, sb, "\n%%EOF\n");
}

# --- the writer's self-check ------------------------------------------------

# Decimal digit count of a non-negative integer; 1 for 0.
fn _pdfw_ndigits(v): i64 {
    var d = 0;
    var x = v;
    if (x <= 0) { return 1; }
    while (x > 0) { d = d + 1; x = x / 10; }
    return d;
}

# 1 if the bytes at `p + off` are exactly the object header `"<num> 0 obj"`.
#
# Compared digit by digit against `num` rather than formatted into a scratch
# buffer and memeq'd: no buffer means no buffer-size question, and the
# `" 0 obj"` tail immediately after the digits is what rejects a near-miss —
# an offset pointing at object 12 while looking for object 1 fails on the '2'
# where a prefix compare would pass.
fn _pdfw_hdr_at(p, avail, off, num): i64 {
    var d = _pdfw_ndigits(num);
    if (off < 0) { return 0; }
    if (off + d + 6 > avail) { return 0; }
    var i = 0;
    while (i < d) {
        if (load8(p + off + i) != 48 + ((num / _pdfe_pow10(d - 1 - i)) % 10)) { return 0; }
        i = i + 1;
    }
    return memeq(p + off + d, " 0 obj", 6);
}

# LAYER 2 of the byte-offset defence (§6.1): re-read the finished output and
# confirm that every offset the writer recorded names the object it claims to.
# 0 on success, 0 - 1 with a doc error on any mismatch.
#
# This is the guard that makes a byte-accounting bug impossible to SHIP, as
# opposed to merely detectable by an external tool: a writer that miscounts
# returns the empty Str and a named error instead of a file that opens in a
# lenient viewer and fails in a strict one. It costs one linear pass over an
# array the size of the object count.
fn _pdfw_selfcheck(doc, bytes: Str, offsets, n): i64 {
    if (bytes == 0 || offsets == 0) { return 0 - 1; }
    var p = str_data(bytes);
    var avail = str_len(bytes);
    var have = vec_len(offsets);
    var k = 1;
    while (k < n) {
        if (k >= have) {
            _pdfe_doc_err(doc, "internal: fewer recorded xref offsets than objects", 0 - 1);
            return 0 - 1;
        }
        if (_pdfw_hdr_at(p, avail, vec_get(offsets, k), k) != 1) {
            _pdfe_doc_err(doc,
              "internal: a recorded xref offset does not name its object (byte accounting is wrong)",
              0 - 1);
            return 0 - 1;
        }
        k = k + 1;
    }
    return 0;
}

# === Writer — the whole file =================================================

# Serialise the whole document to PDF bytes, allocating through `a`. Returns
# the empty Str with a loud doc error on any refusal.
#
# The refusals are deliberate and each names a caller mistake:
#   - no page was ever added
#   - a page left BT open (bayan_pdf_text_end was never called)
#   - a page left q open (bayan_pdf_grestore was never called)
#   - the writer's own self-check failed
#
# THE HEADER IS TWO LINES. "%PDF-1.7\n" then "%" followed by four bytes above
# 0x7F and a newline. The binary comment is conventional but not decorative:
# PDF 32000-1 §7.5.2 says a file containing binary data should carry it so that
# tools sniffing the first bytes classify the file as binary rather than text,
# which is what stops an FTP client or a naive filter from "helpfully"
# translating line endings inside a compressed stream.
#
# It is also the exact reason a predicted offset cannot work here: the header is
# 15 bytes, not the 9 that "%PDF-1.4\n" alone would be. Every offset below is
# read from _pdfw_pos(sb) immediately before the object it belongs to.
fn bayan_pdf_to_bytes_a(a, doc): Str {
    if (_pdfe_magic(doc, PDF_MODE_WRITE) == 0) { return _pdfo_empty_bytes(); }

    var pages = load64(doc + 32);
    var np = 0;
    if (pages != 0) { np = vec_len(pages); }
    if (np == 0) {
        _pdfe_doc_err(doc, "cannot write a PDF with no pages (call bayan_pdf_add_page first)", 0 - 1);
        return _pdfo_empty_bytes();
    }

    # Balance is checked for EVERY page before a single byte is emitted, so a
    # document with an unclosed BT on page 40 fails before it has written 39
    # pages worth of output the caller then has to throw away.
    var i = 0;
    while (i < np) {
        var pg = vec_get(pages, i);
        if (pg == 0) {
            _pdfe_doc_err(doc, "internal: null page in the document page table", 0 - 1);
            return _pdfo_empty_bytes();
        }
        if (load64(pg + 40) != 0) {
            _pdfe_doc_err(doc, "a page has an unbalanced BT/ET (bayan_pdf_text_end was never called)", 0 - 1);
            return _pdfo_empty_bytes();
        }
        if (load64(pg + 48) != 0) {
            _pdfe_doc_err(doc, "a page has an unbalanced q/Q (bayan_pdf_grestore was never called)", 0 - 1);
            return _pdfo_empty_bytes();
        }
        i = i + 1;
    }

    if (_pdfw_build_tree(a, doc) != 0) {
        # _pdfw_build_tree's own failures are already named where they happen;
        # this catches the OOM paths, which have nothing more specific to say.
        _pdfe_doc_err(doc, "failed to build the document object tree", 0 - 1);
        return _pdfo_empty_bytes();
    }

    var objs = load64(doc + 24);
    var n = vec_len(objs);
    var sb = str_builder_new_a(a);
    if (sb == 0) {
        _pdfe_doc_err(doc, "out of memory allocating the output builder", 0 - 1);
        return _pdfo_empty_bytes();
    }

    # The only failure any of these can have is a grow OOM, so the codes are
    # summed and reported once rather than branched on eight times; a non-zero
    # sum means at least one append failed and the builder is unusable.
    var ver = load64(doc + 112);
    if (ver < 14 || ver > 17) { ver = 17; }
    var hrc = 0;
    hrc = hrc + _pdfw_kw(a, sb, "%PDF-1.");
    hrc = hrc + _pdfw_putc(a, sb, 48 + (ver % 10));
    hrc = hrc + _pdfw_putc(a, sb, 10);
    # The binary marker line: '%' then four bytes >= 0x80 then LF.
    hrc = hrc + _pdfw_putc(a, sb, 37);
    hrc = hrc + _pdfw_putc(a, sb, 226);
    hrc = hrc + _pdfw_putc(a, sb, 227);
    hrc = hrc + _pdfw_putc(a, sb, 207);
    hrc = hrc + _pdfw_putc(a, sb, 211);
    hrc = hrc + _pdfw_putc(a, sb, 10);
    if (hrc != 0) {
        _pdfe_doc_err(doc, "out of memory writing the file header", 0 - 1);
        return _pdfo_empty_bytes();
    }

    var offsets = vec_new_a(a);
    if (offsets == 0) {
        _pdfe_doc_err(doc, "out of memory allocating the xref offset table", 0 - 1);
        return _pdfo_empty_bytes();
    }
    # Object 0 is the free head and has no body, so its slot is a placeholder.
    if (vec_push_a(a, offsets, 0) < 0) {
        _pdfe_doc_err(doc, "out of memory recording an xref offset", 0 - 1);
        return _pdfo_empty_bytes();
    }

    var k = 1;
    while (k < n) {
        # MEASURED, NEVER PREDICTED (D8). This one line is the whole of §6.1:
        # the builder's live length is read here, one statement before the
        # bytes it names are appended, so nothing about the header, the object
        # bodies, or any future addition can put it out of step.
        if (vec_push_a(a, offsets, _pdfw_pos(sb)) < 0) {
            _pdfe_doc_err(doc, "out of memory recording an xref offset", 0 - 1);
            return _pdfo_empty_bytes();
        }
        if (_pdfw_indirect(a, sb, k, vec_get(objs, k)) != 0) {
            _pdfe_doc_err(doc, "failed to serialise an indirect object", 0 - 1);
            return _pdfo_empty_bytes();
        }
        k = k + 1;
    }

    var xref_off = _pdfw_pos(sb);
    if (_pdfw_xref(a, sb, offsets, n) != 0) {
        _pdfe_doc_err(doc, "cross-reference offset does not fit in ten digits", 0 - 1);
        return _pdfo_empty_bytes();
    }
    if (_pdfw_trailer(a, sb, doc, xref_off) != 0) {
        _pdfe_doc_err(doc, "failed to write the trailer", 0 - 1);
        return _pdfo_empty_bytes();
    }

    var out = str_builder_build_a(a, sb);
    if (out == 0) {
        _pdfe_doc_err(doc, "out of memory building the output bytes", 0 - 1);
        return _pdfo_empty_bytes();
    }
    if (_pdfw_selfcheck(doc, out, offsets, n) != 0) { return _pdfo_empty_bytes(); }

    # bit1 of doc.flags is "sealed". It is a record that the document has been
    # written, not a lock: _pdfw_build_tree rebuilds the table from scratch, so
    # writing twice is well-defined and produces identical bytes.
    store64(doc + 120, load64(doc + 120) | 2);
    return out;
}

# Serialise the whole document to PDF bytes.
#
# The bare form routes through the DOCUMENT's allocator rather than blindly
# through default_alloc(), because a PdfDoc is an owner (D7): bayan_pdf_new_a
# stored an allocator at doc + 16 and every writer allocation since has gone
# through it, so sending only the final buffer somewhere else would scatter one
# document across two arenas. The output bytes are identical either way, which
# is what §7.10's "to_bytes_a == to_bytes byte-for-byte" asserts.
fn bayan_pdf_to_bytes(doc): Str {
    var a = default_alloc();
    if (_pdfe_magic(doc, PDF_MODE_WRITE) == 1) {
        var da = load64(doc + 16);
        if (da != 0) { a = da; }
    }
    return bayan_pdf_to_bytes_a(a, doc);
}

# Write the document to `path`. 0 on success, 0 - 1 with the doc error set.
#
# THE RETURN VALUE OF file_write_all IS CHECKED, and both of its failure modes
# are distinguished. mneme's io_export_pdf.cyr:422 discards it, so a full disk,
# a read-only directory, or a quota refusal all report success and the user
# discovers the truncated file later — the exact shape of silent failure this
# module's contract forbids. file_write_all returns a negative errno when the
# open fails and a SHORT COUNT when the write is cut off partway, and only the
# second one leaves a partial file on disk.
#
# `path` is annotated `: cstring`, matching bayan_pdf_parse_file and lib/io.cyr.
# Passing a Str here would make file_open's strlen walk the 16-byte Str header
# and open a garbage path (G1).
fn bayan_pdf_write_file(doc, path: cstring): i64 {
    if (_pdfe_magic(doc, PDF_MODE_WRITE) == 0) { return 0 - 1; }
    if (path == 0) {
        _pdfe_doc_err(doc, "null output path", 0 - 1);
        return 0 - 1;
    }
    var bytes = bayan_pdf_to_bytes(doc);
    var n = str_len(bytes);
    if (n == 0) { return 0 - 1; }        # to_bytes already recorded the reason
    var w = file_write_all(path, str_data(bytes), n);
    if (w < 0) {
        _pdfe_doc_err(doc, "could not open the output file for writing", 0 - 1);
        return 0 - 1;
    }
    if (w != n) {
        _pdfe_doc_err(doc, "short write: the output file is incomplete (disk full?)", 0 - 1);
        return 0 - 1;
    }
    return 0;
}


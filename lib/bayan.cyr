# --- base64.cyr ---

# base64.cyr — RFC 4648 Base64 encoding/decoding (standard + URL-safe)
# Usage: include "lib/bayan.cyr" (full bundle) or "lib/bayan-base64.cyr" (sublib).
#        `lib/base64.cyr` was the pre-carve stdlib module and no longer ships —
#        this content moved into bayan at 1.0.0 / cyrius 6.1.25.
# Requires: alloc.cyr, string.cyr

var _b64_enc = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
# RFC 4648 §5 — URL- and filename-safe alphabet. Differs from standard
# at positions 62/63 only (`+/` → `-_`); padding `=` is also typically
# omitted in URL-safe usage (JWT, OAuth state, capability URLs).
var _b64u_enc = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";

# Encode buf[0..len] to base64. Returns a null-terminated string, or 0 when the
# allocator refuses the output buffer (1.5.9: it used to store through the refused
# 0 and die of SIGSEGV; lib/ws.cyr and lib/ws_server.cyr already test for 0).
fn bayan_base64_encode(buf, len): i64 {
    var out_len = ((len + 2) / 3) * 4;
    var out = alloc(out_len + 1);
    if (out == 0) { return 0; }
    var si = 0;
    var di = 0;
    while (si < len) {
        var b0 = load8(buf + si);
        var b1 = 0; if (si + 1 < len) { b1 = load8(buf + si + 1); }
        var b2 = 0; if (si + 2 < len) { b2 = load8(buf + si + 2); }
        store8(out + di, load8(_b64_enc + (b0 >> 2)));
        store8(out + di + 1, load8(_b64_enc + ((b0 & 3) << 4 | (b1 >> 4))));
        if (si + 1 < len) {
            store8(out + di + 2, load8(_b64_enc + ((b1 & 15) << 2 | (b2 >> 6))));
        } else { store8(out + di + 2, 61); }
        if (si + 2 < len) {
            store8(out + di + 3, load8(_b64_enc + (b2 & 63)));
        } else { store8(out + di + 3, 61); }
        si = si + 3;
        di = di + 4;
    }
    store8(out + di, 0);
    return out;
}

# --- Decoding: what is refused, and why (1.11.1) -----------------------------
#
# A DECODER REFUSES WHAT IS NOT CANONICAL BASE64, BY NAME: 0, with the reason in
# bayan_base64_last_error() ("" after a decode that succeeded). The user's
# decision at the 6.7.18 audit. Until 1.11.1 a '=' anywhere decoded as six zero
# bits, so QQ==QUFB gave 41 00 00 41 41 41, =AAA gave 00 00 00 and ==== one 00;
# QR== gave 41 as QQ== does; base64url dropped a dangling character (QUFBQ gave
# 41 41 41, Q nothing) and stripped any run of '='. A consumer that compares,
# deduplicates or revokes by the encoded string (a JWT signature, say) met
# several accepted spellings of the same bytes. Refused now:
#   - a byte outside the decoder's alphabet, the other alphabet's '-' '_' or
#     '+' '/' included: the two never mix;
#   - '=' anywhere but as the padding that ends the last group;
#   - padding of the wrong length: base64 is padded to a multiple of 4 always,
#     base64url either not at all or exactly so;
#   - a last group of one character (6 bits cannot make a byte);
#   - bits left over below the last byte that are not zero (RFC 4648 section
#     3.5): one byte string, one spelling.
# The decoders no longer build a 256-byte table per call (an allocation nothing
# checked, never freed on the bump allocator); every allocation is checked.

var _b64_err = 0;

# Why the last bayan_base64_decode / bayan_base64url_decode refused its input
# (cstring), or "" when it decoded (1.11.1).
fn bayan_base64_last_error(): i64 {
    if (_b64_err == 0) { return ""; }
    return _b64_err;
}

# Record a refusal and return 0, the refused answer.
fn _b64_refuse(msg): i64 {
    _b64_err = msg;
    return 0;
}

# The sextet byte `ch` stands for in the standard (url == 0) or URL-safe (url ==
# 1) alphabet, or 0 - 1. '=' is not in either; the caller handles padding.
fn _b64_val(ch, url): i64 {
    if (ch >= 65 && ch <= 90) { return ch - 65; }
    if (ch >= 97 && ch <= 122) { return ch - 71; }
    if (ch >= 48 && ch <= 57) { return ch + 4; }
    if (url == 0) {
        if (ch == 43) { return 62; }
        if (ch == 47) { return 63; }
    } else {
        if (ch == 45) { return 62; }
        if (ch == 95) { return 63; }
    }
    return 0 - 1;
}

# The message for a byte that is not in the alphabet: the other alphabet's two
# characters are named, so mixing the two reads as what it is.
fn _b64_bad_byte(ch, url): i64 {
    if (url == 0 && (ch == 45 || ch == 95)) {
        return _b64_refuse("base64: '-' or '_' is base64url's alphabet, not base64's");
    }
    if (url == 1 && (ch == 43 || ch == 47)) {
        return _b64_refuse("base64url: '+' or '/' is base64's alphabet, not base64url's");
    }
    if (ch == 61) { return _b64_refuse("base64: '=' is padding, and may only end the last group"); }
    return _b64_refuse("base64: a byte outside the alphabet");
}

# Decode the `n` data characters at encoded[0, n) (no padding; n % 4 != 1) in
# alphabet `url` into a fresh {data_ptr, length} pair, refusing what is not
# canonical. 0 on any refusal, with the reason recorded.
fn _b64_decode_core(encoded, n, url): i64 {
    var rem = n % 4;
    if (rem == 1) { return _b64_refuse("base64: a last group of one character cannot hold a byte"); }
    var out_len = (n / 4) * 3;
    if (rem == 2) { out_len = out_len + 1; }
    if (rem == 3) { out_len = out_len + 2; }
    var out = alloc(out_len + 1);
    if (out == 0) { return _b64_refuse("base64: out of memory"); }
    var acc = 0;
    var bits = 0;
    var di = 0;
    var i = 0;
    while (i < n) {
        var ch = load8(encoded + i);
        var v = _b64_val(ch, url);
        if (v < 0) { return _b64_bad_byte(ch, url); }
        acc = ((acc << 6) | v) & 0xFFFFFF;
        bits = bits + 6;
        if (bits >= 8) {
            bits = bits - 8;
            store8(out + di, (acc >> bits) & 255);
            di = di + 1;
        }
        i = i + 1;
    }
    # 2 or 4 bits are left after a short last group: RFC 4648 section 3.5 makes
    # them zero, and anything else is a second spelling of the same bytes.
    if ((acc & ((1 << bits) - 1)) != 0) {
        return _b64_refuse("base64: the bits below the last byte are not zero (not canonical)");
    }
    store8(out + out_len, 0);
    var result = alloc(16);
    if (result == 0) { return _b64_refuse("base64: out of memory"); }
    store64(result, out);
    store64(result + 8, out_len);
    _b64_err = 0;
    return result;
}

# Decode base64 string to buffer. Returns {data_ptr, length} as alloc'd pair,
# or 0 when the input is not canonical base64 (the reason in
# bayan_base64_last_error(); see above).
#
# LENGTH (1.5.1 — this was a null-pointer write): bayan_base64_decode("=", 1)
# computed an output length of -1 and wrote through 0xFFFFFFFFFFFFFFFF. Base64
# is a 4-character-group encoding, so a length that is negative or not a
# multiple of 4 is refused. 0 returns an empty result, not an error.
fn bayan_base64_decode(encoded, enc_len): i64 {
    if (enc_len < 0) { return _b64_refuse("base64: a negative length"); }
    if (enc_len % 4 != 0) { return _b64_refuse("base64: the length is not a multiple of 4"); }
    var n = enc_len;
    var pad = 0;
    while (n > 0 && pad < 3 && load8(encoded + n - 1) == 61) { n = n - 1; pad = pad + 1; }
    # "x===" and "====": three '=' would leave one character (or none) of a
    # last group; a fourth '=' before them is caught as a byte below.
    if (pad > 2 || (pad > 0 && n % 4 == 1)) {
        return _b64_refuse("base64: too much padding: at most \"==\", after two characters");
    }
    return _b64_decode_core(encoded, n, 0);

# --- csv.cyr ---

# csv.cyr — RFC 4180 records, one line at a time
#
# As of 1.7.0 this reads and writes what Python's `csv` module does with its
# defaults (QUOTE_MINIMAL, a `"` quote, CRLF records), and tests/vectors.tcyr
# checks it against vectors that module wrote (scripts/gen-csv-vectors.py).
# Until 1.7.0 it was an RFC 4180 subset that a caller could hit in four ways,
# documented from 1.5.3:
#   * a TRAILING EMPTY FIELD was not emitted: `a,` parsed to one field where
#     the RFC has two, so a round trip lost a column;
#   * records ended in a lone LF where RFC 4180 s2.1 says CRLF, and the parser
#     kept a line's own terminator as data in its last field;
#   * a field holding CR was not quoted, so it came back as a line break;
#   * the text after a closing quote began a NEW field: `"a"b,c` parsed to
#     a, b, c (Python: ab, c), shifting every later column.
#
# ONE RECORD PER CALL. bayan_csv_parse_line reads one line. A CR or LF outside
# quotes ends the record only as the line's terminator: its last byte, or CRLF
# as its last two. Anywhere else it is kept as data, where Python's reader would
# start a second record; a caller splitting a file into lines never passes one.
# Inside quotes CR and LF are data, as the RFC says, so a whole quoted record
# that spans lines parses whole when it is passed whole.
# Usage: include "lib/bayan.cyr" (full bundle) or "lib/bayan-csv.cyr" (sublib).
#        `lib/csv.cyr` was the pre-carve stdlib module and no longer ships —
#        this content moved into bayan at 1.0.0 / cyrius 6.1.25.
# Requires: alloc.cyr, string.cyr, vec.cyr, str.cyr
#
# A REFUSED ALLOCATION IS 0 (1.7.1). Each public function returns 0 when an
# allocation is refused, and every allocation goes through default_alloc()
# (the global bump allocator, as before), so tests/bayan.tcyr can refuse each
# allocation point alone. Until 1.7.1 a refusal gave a different wrong answer
# in each place: bayan_csv_parse_line returned the fields it had so far (a
# short row), bayan_csv_escape stored through address 0, bayan_csv_write_line
# passed a refused escape's 0 to strlen, and a refused growth of either
# function's vec ended the process (the default vec_push does).

# Parse a CSV line into a vec of field strings (C strings).
# Handles quoted fields, escaped quotes (""), and commas within quotes.
#
# SIZING (fixed in 1.5.1 — this was a heap buffer overflow). Each field used to
# get a fixed `alloc(1024)` and was then filled one byte per input byte with no
# bound, so any field longer than 1023 bytes wrote past its allocation with
# attacker-controlled data. Verified before the fix: a 4,000-byte field wrote
# 4,000 bytes into the 1,024-byte block.
#
# A field can never be longer than the line that contains it, so one scratch
# buffer of `len + 1` is always sufficient for every field. It is allocated
# once and reused, and each field is then copied out at its exact length —
# which is also why this is not a per-field `alloc(len + 1)`: that would be
# quadratic in memory for a line of many short fields, trading an overflow for
# a memory-exhaustion DoS.
fn bayan_csv_parse_line(line): i64 {
    var fields = vec_new();
    if (fields == 0) { return 0; }
    var len = strlen(line);
    var scratch = alloc_via(default_alloc(), len + 1);
    if (scratch == 0) { return 0; }
    # The RFC 4180 grammar as Python's reader runs it (1.7.0). state:
    #   0 at the start of a field   1 in an unquoted field
    #   2 inside quotes             3 just after a quote inside quotes
    # In state 3 a second quote is an escaped one, and anything else but a
    # comma or the terminator continues the field unquoted: `"a"b` is ab.
    var pos = 0;
    var fi = 0;
    var state = 0;
    while (pos < len) {
        var c = load8(line + pos);
        if (state == 2) {
            if (c == 34) { state = 3; }
            else { store8(scratch + fi, c); fi = fi + 1; }
        } elif (c == 44) {
            if (_csv_push_field(fields, scratch, fi) < 0) { return 0; }
            fi = 0;
            state = 0;
        } elif ((c == 13 || c == 10) && _csv_is_terminator(line, len, pos) == 1) {
            pos = len;                           # the record's own line ending
        } elif (c == 34 && state == 0) {
            state = 2;
        } elif (c == 34 && state == 3) {
            store8(scratch + fi, 34); fi = fi + 1;
            state = 2;
        } else {
            store8(scratch + fi, c); fi = fi + 1;
            state = 1;
        }
        pos = pos + 1;
    }
    # The last field. A record that ends in a comma ends in an empty field
    # (`a,` is a and ""), and a line with no field at all is a record of none.
    if (state != 0 || vec_len(fields) > 0) {
        if (_csv_push_field(fields, scratch, fi) < 0) { return 0; }
    }
    return fields;
}

# 1 when the CR or LF at line[pos] is the line's terminator: the last byte, or
# a CR followed by the last byte, LF.
fn _csv_is_terminator(line, len, pos): i64 {
    if (pos + 1 == len) { return 1; }
    if (pos + 2 == len && load8(line + pos) == 13 && load8(line + pos + 1) == 10) { return 1; }
    return 0;
}

# Copy scratch[0..n) out at its exact length and push it. -1 when the copy or
# the vec's growth is refused. `scratch` is shared by every field, so it cannot
# be pushed directly: the next field would overwrite it.
fn _csv_push_field(fields, scratch, n): i64 {
    var out = alloc_via(default_alloc(), n + 1);
    if (out == 0) { return 0 - 1; }
    memcpy(out, scratch, n);
    store8(out + n, 0);
    if (vec_push_a(default_alloc(), fields, out) < 0) { return 0 - 1; }
    return 0;
}

# Escape a field for CSV output: quoted, with each `"` doubled, when it holds a
# comma, a quote, a CR or an LF (QUOTE_MINIMAL). A CR did not trigger quoting
# until 1.7.0, so a field holding one came back from a reader as a line break.
fn bayan_csv_escape(field): i64 {
    var len = strlen(field);
    var needs_quote = 0;
    var i = 0;
    while (i < len) {
        var c = load8(field + i);
        if (c == 44) { needs_quote = 1; }
        if (c == 34) { needs_quote = 1; }
        if (c == 10) { needs_quote = 1; }
        if (c == 13) { needs_quote = 1; }
        i = i + 1;
    }
    if (needs_quote == 0) { return field; }
    # Quote and escape internal quotes
    var out = alloc_via(default_alloc(), len * 2 + 3);
    if (out == 0) { return 0; }
    var oi = 0;
    store8(out + oi, 34); oi = oi + 1;
    i = 0;
    while (i < len) {
        var c = load8(field + i);
        if (c == 34) { store8(out + oi, 34); oi = oi + 1; }
        store8(out + oi, c); oi = oi + 1;
        i = i + 1;
    }
    store8(out + oi, 34); oi = oi + 1;
    store8(out + oi, 0);
    return out;
}

# Write a vec of fields as one CSV record, ending in CRLF (returns a
# NUL-terminated string). Until 1.7.0 records ended in a lone LF, where RFC
# 4180 s2.1 says CRLF. A row of one empty field is written `""`, as Python's
# writer does: written bare it would be an empty line, which reads back as a
# record of no fields.
fn bayan_csv_write_line(fields): i64 {
    # SIZING (fixed in 1.5.1 — the write side of the same overflow). This used
    # a fixed `alloc(4096)` and memcpy'd every escaped field into it with no
    # bound, so any row totalling more than 4,095 bytes wrote past the block.
    # Measure first: escape each field once, sum the exact lengths, allocate,
    # then copy. Escaping twice would be wasteful and — worse — would let the
    # measured and copied lengths disagree if escaping were ever non-
    # deterministic, so the escaped forms are kept.
    var n = vec_len(fields);
    if (n == 1) {
        if (strlen(vec_get(fields, 0)) == 0) {
            var lone = alloc_via(default_alloc(), 5);
            if (lone == 0) { return 0; }
            memcpy(lone, "\"\"\r\n", 4);
            store8(lone + 4, 0);
            return lone;
        }
    }
    var esc = vec_new();
    if (esc == 0) { return 0; }
    var total = 0;
    var i = 0;
    while (i < n) {
        var e = bayan_csv_escape(vec_get(fields, i));
        if (e == 0) { return 0; }
        if (vec_push_a(default_alloc(), esc, e) < 0) { return 0; }
        total = total + strlen(e);
        if (i > 0) { total = total + 1; }        # the separating comma
        i = i + 1;
    }
    var buf = alloc_via(default_alloc(), total + 3);   # + CRLF + NUL
    if (buf == 0) { return 0; }
    var pos = 0;
    i = 0;
    while (i < n) {
        if (i > 0) { store8(buf + pos, 44); pos = pos + 1; }
        var escaped = vec_get(esc, i);
        var elen = strlen(escaped);
        memcpy(buf + pos, escaped, elen);
        pos = pos + elen;
        i = i + 1;
    }
    store8(buf + pos, 13); pos = pos + 1;
    store8(buf + pos, 10); pos = pos + 1;
    store8(buf + pos, 0);
    return buf;
}

# --- u128.cyr ---

# lib/u128.cyr — 128-bit unsigned integer helpers
#
# A u128 is a 16-byte slot: low 8 bytes at ptr+0, high 8 bytes at ptr+8.
# Declared with `var x: u128 = 0;` (v4.8.0).
# These helpers cover construction, copy, part-access, equality,
# arithmetic, shifts, comparisons, and divmod.
#
# Convention: functions take pointers (returned by `&x`), never values,
# because the cyrius ABI currently passes / returns scalars in a single
# register.

# Set both limbs at `dst` to (lo, hi). Both args are u64 treated as
# unsigned.
fn bayan_u128_set(dst, lo, hi): i64 {
    store64(dst, lo);
    store64(dst + 8, hi);
    return 0;
}

# Zero-extend a u64 to a u128 at `dst`.
fn bayan_u128_from_u64(dst, lo): i64 {
    store64(dst, lo);
    store64(dst + 8, 0);
    return 0;
}

# Copy 16 bytes `src` → `dst`. Source and destination must not overlap.
fn bayan_u128_copy(dst, src): i64 {
    store64(dst, load64(src));
    store64(dst + 8, load64(src + 8));
    return 0;
}

# Low 64-bit limb of a u128 at `ptr`.
fn bayan_u128_lo(ptr): i64 { return load64(ptr); }
# High 64-bit limb of a u128 at `ptr`.
fn bayan_u128_hi(ptr): i64 { return load64(ptr + 8); }

# Equality — true when both limbs are identical.
#pure
fn bayan_u128_eq(a, b): bool {
    if (load64(a) != load64(b)) { return false; }
    if (load64(a + 8) != load64(b + 8)) { return false; }
    return true;
}

# Zero-test.
#pure
fn bayan_u128_is_zero(ptr): bool {
    if (load64(ptr) != 0) { return false; }
    if (load64(ptr + 8) != 0) { return false; }
    return true;
}

# -------- Arithmetic --------
#
# Carry / borrow detection without an unsigned primitive: split each
# 64-bit limb into two 32-bit halves, add/subtract in pieces (cyrius's
# i64 arith has more than enough headroom), propagate the carry bit
# from bit 32 of each partial result. Shifts here are on values whose
# high bit (63) is zero, so signed and logical `>>` coincide.

# dst = a + b  (u128 wraps at 2^128)
fn bayan_u128_add(dst, a, b): i64 {
    var a_lo = load64(a);
    var a_hi = load64(a + 8);
    var b_lo = load64(b);
    var b_hi = load64(b + 8);
    var a_lolo = a_lo & 0xFFFFFFFF;
    var a_lohi = (a_lo >> 32) & 0xFFFFFFFF;
    var b_lolo = b_lo & 0xFFFFFFFF;
    var b_lohi = (b_lo >> 32) & 0xFFFFFFFF;
    var s_lolo = a_lolo + b_lolo;
    var s_lohi = a_lohi + b_lohi + (s_lolo >> 32);
    var new_lo = (s_lolo & 0xFFFFFFFF) | ((s_lohi & 0xFFFFFFFF) << 32);
    var carry = s_lohi >> 32;
    var new_hi = a_hi + b_hi + carry;
    store64(dst, new_lo);
    store64(dst + 8, new_hi);
    return 0;
}

# dst = a - b  (u128 wraps at 2^128, so 0 - 1 = 2^128 - 1)
fn bayan_u128_sub(dst, a, b): i64 {
    var a_lo = load64(a);
    var a_hi = load64(a + 8);
    var b_lo = load64(b);
    var b_hi = load64(b + 8);
    var a_lolo = a_lo & 0xFFFFFFFF;
    var a_lohi = (a_lo >> 32) & 0xFFFFFFFF;
    var b_lolo = b_lo & 0xFFFFFFFF;
    var b_lohi = (b_lo >> 32) & 0xFFFFFFFF;
    var d_lolo = a_lolo - b_lolo;
    var borrow_lo = 0;
    if (d_lolo < 0) { d_lolo = d_lolo + 0x100000000; borrow_lo = 1; }
    var d_lohi = a_lohi - b_lohi - borrow_lo;
    var borrow_hi = 0;
    if (d_lohi < 0) { d_lohi = d_lohi + 0x100000000; borrow_hi = 1; }
    var new_lo = (d_lolo & 0xFFFFFFFF) | ((d_lohi & 0xFFFFFFFF) << 32);
    var new_hi = a_hi - b_hi - borrow_hi;
    store64(dst, new_lo);
    store64(dst + 8, new_hi);
    return 0;
}

# `dst += src` — wraps at 2^128.
fn bayan_u128_addeq(dst, src): i64 { return bayan_u128_add(dst, dst, src); }
# `dst -= src` — wraps at 2^128.
fn bayan_u128_subeq(dst, src): i64 { return bayan_u128_sub(dst, dst, src); }

# dst = a * b  (u128 wraps at 2^128)
#
# Standard schoolbook: a = a_lo + a_hi*2^64, b likewise.
# a * b (mod 2^128) = a_lo*b_lo  +  (a_hi*b_lo + a_lo*b_hi)*2^64
# (the a_hi*b_hi*2^128 term wraps to 0).
# Cross terms contribute to the HIGH limb only — we take their low 64
# bits via natural i64 wrap.
# For the full 128-bit product of a_lo*b_lo we split each 64-bit limb
# into two 32-bit halves and accumulate per 32-bit chunk with carry.
fn bayan_u128_mul(dst, a, b): i64 {
    var a_lo = load64(a);
    var a_hi = load64(a + 8);
    var b_lo = load64(b);
    var b_hi = load64(b + 8);

    var a_ll = a_lo & 0xFFFFFFFF;
    var a_lh = (a_lo >> 32) & 0xFFFFFFFF;
    var b_ll = b_lo & 0xFFFFFFFF;
    var b_lh = (b_lo >> 32) & 0xFFFFFFFF;

    # Four 32x32 partial products (each fits in 64 bits; masking with
    # 0xFFFFFFFF after `>> 32` discards any sign-extension bits).
    var p0 = a_ll * b_ll;
    var p1 = a_ll * b_lh;
    var p2 = a_lh * b_ll;
    var p3 = a_lh * b_lh;

    var chunk0 = p0 & 0xFFFFFFFF;
    var sum1 = ((p0 >> 32) & 0xFFFFFFFF) + (p1 & 0xFFFFFFFF) + (p2 & 0xFFFFFFFF);
    var chunk1 = sum1 & 0xFFFFFFFF;
    var carry1 = (sum1 >> 32) & 0xFFFFFFFF;

    var sum2 = ((p1 >> 32) & 0xFFFFFFFF) + ((p2 >> 32) & 0xFFFFFFFF) + (p3 & 0xFFFFFFFF) + carry1;
    var chunk2 = sum2 & 0xFFFFFFFF;
    var carry2 = (sum2 >> 32) & 0xFFFFFFFF;

    var chunk3 = (((p3 >> 32) & 0xFFFFFFFF) + carry2) & 0xFFFFFFFF;

    var new_lo = chunk0 | (chunk1 << 32);
    var lolo_hi = chunk2 | (chunk3 << 32);

    # Cross terms (low 64 bits of each — natural wrap).
    var mid = a_hi * b_lo + a_lo * b_hi;
    var new_hi = lolo_hi + mid;

    store64(dst, new_lo);
    store64(dst + 8, new_hi);
    return 0;
}

# `dst *= src` — wraps at 2^128.
fn bayan_u128_muleq(dst, src): i64 { return bayan_u128_mul(dst, dst, src); }

# -------- Shifts & bitwise --------
#
# Cyrius `>>` is a LOGICAL shift: it fills with zeros on every backend
# (measured at 1.5.10 on cyrius 6.6.12 and at 1.6.1 on 6.7.12, on x86_64,
# aarch64 and cx: `-16 >> 2` is 0x3ffffffffffffffc). Until 1.6.1 this
# comment said it sign-extends, and the mask below was written for that.
# It is kept: it costs one AND, and it keeps this shift unsigned whatever a
# backend's `>>` does.
#   (x >> 1) & 0x7FFFFFFFFFFFFFFF   →   bit 63 now 0
#   >> (n-1)                         →   a zero fill either way
# Defined for 0 <= n < 64. Caller handles n == 0 (return x unchanged)
# and n >= 64 (whole-limb shift paths).
fn _u128_lshr64(x, n): i64 {
    if (n == 0) { return x; }
    return ((x >> 1) & 0x7FFFFFFFFFFFFFFF) >> (n - 1);
}

# dst = src << n  (u128 wraps at 2^128; n >= 128 yields 0)
fn bayan_u128_shl(dst, src, n): i64 {
    var lo = load64(src);
    var hi = load64(src + 8);
    if (n == 0) {
        store64(dst, lo);
        store64(dst + 8, hi);
        return 0;
    }
    if (n >= 128) {
        store64(dst, 0);
        store64(dst + 8, 0);
        return 0;
    }
    if (n >= 64) {
        store64(dst, 0);
        store64(dst + 8, lo << (n - 64));
        return 0;
    }
    # 0 < n < 64: spill top n bits of lo into bottom n bits of hi.
    var new_lo = lo << n;
    var spill = _u128_lshr64(lo, 64 - n);
    var new_hi = (hi << n) | spill;
    store64(dst, new_lo);
    store64(dst + 8, new_hi);
    return 0;
}

# dst = src >> n  (logical right — always fills with 0)
fn bayan_u128_shr(dst, src, n): i64 {
    var lo = load64(src);
    var hi = load64(src + 8);
    if (n == 0) {
        store64(dst, lo);
        store64(dst + 8, hi);
        return 0;
    }
    if (n >= 128) {
        store64(dst, 0);
        store64(dst + 8, 0);
        return 0;
    }
    if (n >= 64) {
        store64(dst, _u128_lshr64(hi, n - 64));
        store64(dst + 8, 0);
        return 0;
    }
    # 0 < n < 64: bottom n bits of hi spill into top n bits of lo.
    var new_lo = _u128_lshr64(lo, n) | (hi << (64 - n));
    var new_hi = _u128_lshr64(hi, n);
    store64(dst, new_lo);
    store64(dst + 8, new_hi);
    return 0;
}

# dst = a & b — per-limb bitwise AND.
fn bayan_u128_and(dst, a, b): i64 {
    store64(dst, load64(a) & load64(b));
    store64(dst + 8, load64(a + 8) & load64(b + 8));
    return 0;
}

# dst = a | b — per-limb bitwise OR.
fn bayan_u128_or(dst, a, b): i64 {
    store64(dst, load64(a) | load64(b));
    store64(dst + 8, load64(a + 8) | load64(b + 8));
    return 0;
}

# dst = a ^ b — per-limb bitwise XOR.
fn bayan_u128_xor(dst, a, b): i64 {
    store64(dst, load64(a) ^ load64(b));
    store64(dst + 8, load64(a + 8) ^ load64(b + 8));
    return 0;
}

# dst = ~src — per-limb bitwise NOT.
fn bayan_u128_not(dst, src): i64 {
    store64(dst, ~load64(src));
    store64(dst + 8, ~load64(src + 8));
    return 0;
}

# `dst <<= n`.
fn bayan_u128_shleq(dst, n): i64 { return bayan_u128_shl(dst, dst, n); }
# `dst >>= n` (logical right).
fn bayan_u128_shreq(dst, n): i64 { return bayan_u128_shr(dst, dst, n); }
# `dst &= src`.
fn bayan_u128_andeq(dst, src): i64 { return bayan_u128_and(dst, dst, src); }
# `dst |= src`.
fn bayan_u128_oreq(dst, src): i64 { return bayan_u128_or(dst, dst, src); }
# `dst ^= src`.
fn bayan_u128_xoreq(dst, src): i64 { return bayan_u128_xor(dst, dst, src); }

# -------- Unsigned comparisons + divmod --------
#
# Cyrius native `<` / `>` / `>=` are signed. For u64 pieces we need
# an unsigned interpretation (bit 63 is a real value bit, not a
# sign flag).

# Unsigned a > b on 64-bit limbs.
fn _u64_ugt(a, b): i64 {
    if (a >= 0) {
        if (b >= 0) { if (a > b) { return 1; } return 0; }
        return 0;           # a non-negative, b "negative" (bit 63 set) → b larger
    }
    if (b >= 0) { return 1; }   # a "negative" (huge unsigned), b non-negative
    if (a > b) { return 1; }     # both "negative" — signed order matches unsigned here
    return 0;
}

# Unsigned a >= b on 64-bit limbs.
fn _u64_uge(a, b): i64 {
    if (a == b) { return 1; }
    return _u64_ugt(a, b);
}

# u128 unsigned comparisons. `a` / `b` are pointers to u128 slots.
fn bayan_u128_ugt(a, b): i64 {
    var a_hi = load64(a + 8);
    var b_hi = load64(b + 8);
    if (a_hi != b_hi) { return _u64_ugt(a_hi, b_hi); }
    return _u64_ugt(load64(a), load64(b));
}

# Unsigned a >= b on u128 pointers.
fn bayan_u128_uge(a, b): i64 {
    var a_hi = load64(a + 8);
    var b_hi = load64(b + 8);
    if (a_hi != b_hi) { return _u64_ugt(a_hi, b_hi); }
    return _u64_uge(load64(a), load64(b));
}

# Unsigned a < b on u128 pointers.
fn bayan_u128_ult(a, b): i64 { return bayan_u128_ugt(b, a); }
# Unsigned a <= b on u128 pointers.
fn bayan_u128_ule(a, b): i64 { return bayan_u128_uge(b, a); }

# Unsigned two-limb subtract helper — writes (a - b) into (*out_lo,
# *out_hi) with natural mod-2^128 wrap. Shared between divmod and
# anything else that needs scalar-limb borrow propagation.
# (Kept local to the file; public callers use bayan_u128_sub.)

# (qdst, rdst) = (a / b, a % b).
# On b == 0, writes "u128: division by zero" to stderr and exits 1.
# A divisor below 2^64 takes a hardware path: two `div` on x86_64, two-digit
# Algorithm D over `udiv` on aarch64 (1.6.2). A wider divisor, and every
# division on a target with neither arch macro (cx), takes shift-subtract
# long division:
#   q = 0, r = 0
#   for i in 127..0:
#       r = (r << 1) | bit_i(a)
#       if r >= b: r -= b; q |= (1 << i)
fn bayan_u128_divmod(qdst, rdst, a, b): i64 {
    if (bayan_u128_is_zero(b) == 1) {
        syscall(SYS_WRITE, 2, "u128: division by zero\n", 23);
        syscall(SYS_EXIT, 1);
    }
    var a_lo = load64(a);
    var a_hi = load64(a + 8);
    var b_lo = load64(b);
    var b_hi = load64(b + 8);
    # Hardware fast-path when the divisor fits in 64 bits
    # bits. Covers every `(u64 * u64) % u64` pipeline — Miller-Rabin,
    # Pollard rho, RSA, `random::shuffle`, hashing. The slow path
    # below burns 128 shift-subtract iterations even when the top
    # half of b is zero; this path takes two hardware `div`
    # instructions instead, trading O(128) on the critical path for
    # O(1). Abaco's ntheory::mod_mul gets ~40× on the hot loop.
    #
    # Two hardware `div` steps back-to-back, both inside one asm
    # block so both divisions run UNSIGNED (Cyrius's `/` operator
    # lowers to `idiv` — signed — which would mis-compute whenever
    # an operand has its top bit set, mulmod's common case):
    #   step 1:  rax = a_hi, rdx = 0
    #            div b_lo           ; rax = q_hi, rdx = r1
    #   step 2:  rax = a_lo, rdx = r1 (carried from step 1)
    #            div b_lo           ; rax = q_lo, rdx = r_final
    # When a_hi == 0, step 1 returns q_hi=0, r1=0 and step 2 falls
    # through to straight 64-bit a_lo/b_lo — so this same block
    # handles both a_hi==0 and a_hi!=0 correctly. r1 < b_lo by the
    # definition of the first remainder, so step 2 never trips #DE.
    #ifdef CYRIUS_ARCH_X86
    if (b_hi == 0) {
        var q_hi_fast = 0;
        var q_lo_fast = 0;
        var r_final   = 0;
        # Local layout after this point (flat fn index order):
        #   qdst(0), rdst(1), a(2), b(3),
        #   a_lo(4), a_hi(5), b_lo(6), b_hi(7),
        #   q_hi_fast(8), q_lo_fast(9), r_final(10)
        # disp8 = -(idx+1)*8.
        # x86-only fast path. Non-x86 targets (aarch64/cx) fall through
        # to the portable shift-subtract loop below — these raw `div`
        # bytes are x86 machine code and would emit verbatim into the
        # text section on other arches (SIGILL). See CHANGELOG.
        asm {
            0x48; 0x8B; 0x45; 0xD0;   # mov rax, [rbp-48]   ; a_hi
            0x48; 0x31; 0xD2;         # xor rdx, rdx        ; zero-ext
            0x48; 0xF7; 0x75; 0xC8;   # div qword [rbp-56]  ; / b_lo
            0x48; 0x89; 0x45; 0xB8;   # mov [rbp-72], rax   ; q_hi_fast
            0x48; 0x8B; 0x45; 0xD8;   # mov rax, [rbp-40]   ; a_lo
            0x48; 0xF7; 0x75; 0xC8;   # div qword [rbp-56]  ; rdx:rax/b_lo
            0x48; 0x89; 0x45; 0xB0;   # mov [rbp-80], rax   ; q_lo_fast
            0x48; 0x89; 0x55; 0xA8;   # mov [rbp-88], rdx   ; r_final
        }
        store64(qdst,     q_lo_fast);
        store64(qdst + 8, q_hi_fast);
        store64(rdst,     r_final);
        store64(rdst + 8, 0);
        return 0;
    }
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    if (b_hi == 0) {
        # aarch64 has no 128/64 divide (1.6.2 — this was bit-serial). Through
        # 1.6.1 every aarch64 division took the loop below: 128 shift-subtract
        # rounds with three to five helper calls each, ~650-700x a plain 64-bit
        # division under qemu-aarch64 (tests/mulmod_speed.cyr), where x86 takes
        # two `div`. Now, for a divisor d below 2^64: q.hi = a.hi / d and
        # u1 = a.hi % d by udiv/msub, then (u1 * 2^64 + a.lo) / d by Knuth's
        # Algorithm D with two 32-bit digits (TAOCP vol. 2, 4.3.1; Hacker's
        # Delight 2nd ed., fig. 9-3 `divlu`). That is the routine 1.5.10's
        # mulmod block runs for its remainder, keeping the quotient as well:
        # four udiv, no loop over bits, no calls.
        #
        # Why it is exact, given d != 0 (checked above) and u1 < d:
        #  - u1 < d makes (u1 * 2^64 + a.lo) / d fit in 64 bits. With
        #    s = clz(d), v = d << s has bit 63 set, and un32, the top 64 bits
        #    of the numerator shifted by s, is below v. `lsr` takes its count
        #    mod 64, so for s = 0 `u0 >> (64 - s)` would be u0, not 0; the
        #    csel zeroes it.
        #  - A digit's estimate q-hat = num / vn1 is at most 2^32 + 1 (num < v
        #    < (vn1 + 1) * 2^32, and vn1 >= 2^31), and Knuth's theorem B gives
        #    q-hat - 2 <= q <= q-hat, so each correction loop runs at most
        #    twice. Unlike mulmod's numerator, this one is any value below
        #    d * 2^64, so either digit can need both corrections (the u128
        #    vectors have rows that do, for s = 0 and s > 0).
        #  - `q-hat * vn0` fits in 64 bits: q-hat <= 2^32 + 1 and vn0 < 2^32
        #    give at most 2^64 - 1. rhat starts below vn1 < 2^32 and is checked
        #    against 2^32 before every retest, so `rhat << 32` keeps all its
        #    bits. That check must be `b.lo`: at rhat == 2^32 exactly,
        #    `rhat << 32` is 0, and a `b.ls` retest would decrement a digit that
        #    is already right (the vectors have rows aimed at that exit).
        #  - un21 and `r << s` are formed mod 2^64. Their true values are
        #    partial remainders below v, so the wrap is exact; `r << s` has its
        #    low s bits clear, and `lsr` by s gives r.
        #  - q.lo = q1 * 2^32 + q0, both digits below 2^32 once corrected.
        #
        # The two `b.hs` tests stay for fidelity to the textbook routine,
        # although removing either changes no result (a mutation pass sees
        # them survive; that is not a gap in the tests). The product cannot
        # overflow without them (above), and with a two-digit divisor the
        # product test alone is exact: q-hat * v > num * 2^32 + un
        # exactly when q-hat * vn0 > rhat * 2^32 + un, so every q-hat >= 2^32,
        # which is always too large, is corrected without them. Both correction
        # loops' back-edges, by contrast, are live (mulmod's first one is not).
        #
        # The block reads its four pointer parameters with param_load (their
        # real prologue slots) and the limbs through them, so unlike the x86
        # block above it does not depend on this fn's local layout. Every input
        # is loaded before the first store, so qdst or rdst may be a or b
        # (bayan_u128_diveq passes dst as both qdst and a). It stores q, then r,
        # as the loop does. Scratch is x0-x15, caller-saved under AAPCS64 and
        # never live across a statement in cyrius's aarch64 codegen; x16-x18
        # and x28 are untouched. The 58 encoded words (the param_loads are the
        # compiler's) were assembled by llvm-mc 23.1.1 and by GNU as 2.47, which
        # agree on every word, and read back with objdump, which places every
        # branch on the label named beside it.
        asm {
            param_load(x0, 2);        # a
            param_load(x1, 3);        # b
            0x03; 0x00; 0x40; 0xF9;   #      ldr   x3, [x0]            ; u0 = a.lo
            0x04; 0x04; 0x40; 0xF9;   #      ldr   x4, [x0, #8]        ; a.hi
            0x22; 0x00; 0x40; 0xF9;   #      ldr   x2, [x1]            ; d = b.lo (nonzero)
            0x80; 0x08; 0xC2; 0x9A;   #      udiv  x0, x4, x2          ; q.hi = a.hi / d
            0x04; 0x90; 0x02; 0x9B;   #      msub  x4, x0, x2, x4      ; u1 = a.hi % d < d
            0x45; 0x10; 0xC0; 0xDA;   #      clz   x5, x2              ; s
            0x42; 0x20; 0xC5; 0x9A;   #      lsl   x2, x2, x5          ; v = d << s
            0x46; 0xFC; 0x60; 0xD3;   #      lsr   x6, x2, #32         ; vn1
            0x47; 0x7C; 0x40; 0x92;   #      and   x7, x2, #0xffffffff ; vn0
            0x88; 0x20; 0xC5; 0x9A;   #      lsl   x8, x4, x5
            0xE9; 0x03; 0x05; 0xCB;   #      neg   x9, x5
            0x69; 0x24; 0xC9; 0x9A;   #      lsr   x9, x3, x9          ; u0 >> (64 - s)
            0xBF; 0x00; 0x00; 0xF1;   #      cmp   x5, #0
            0xE9; 0x03; 0x89; 0x9A;   #      csel  x9, xzr, x9, eq     ; 0 when s == 0
            0x08; 0x01; 0x09; 0xAA;   #      orr   x8, x8, x9          ; un32
            0x6A; 0x20; 0xC5; 0x9A;   #      lsl   x10, x3, x5         ; un10
            0x4B; 0xFD; 0x60; 0xD3;   #      lsr   x11, x10, #32       ; un1
            0x4A; 0x7D; 0x40; 0x92;   #      and   x10, x10, #0xffffffff ; un0
            0x2F; 0x00; 0xC0; 0xD2;   #      mov   x15, #0x100000000   ; b = 2^32
            0x0C; 0x09; 0xC6; 0x9A;   #      udiv  x12, x8, x6         ; q1
            0x8D; 0xA1; 0x06; 0x9B;   #      msub  x13, x12, x6, x8    ; rhat
            0x9F; 0x01; 0x0F; 0xEB;   # L1:  cmp   x12, x15
            0xC2; 0x00; 0x00; 0x54;   #      b.hs  L2                  ; q1 >= b
            0x8E; 0x7D; 0x07; 0x9B;   #      mul   x14, x12, x7
            0xA9; 0x7D; 0x60; 0xD3;   #      lsl   x9, x13, #32
            0x29; 0x01; 0x0B; 0xAA;   #      orr   x9, x9, x11
            0xDF; 0x01; 0x09; 0xEB;   #      cmp   x14, x9
            0xA9; 0x00; 0x00; 0x54;   #      b.ls  L3                  ; q1*vn0 <= b*rhat+un1
            0x8C; 0x05; 0x00; 0xD1;   # L2:  sub   x12, x12, #1
            0xAD; 0x01; 0x06; 0x8B;   #      add   x13, x13, x6
            0xBF; 0x01; 0x0F; 0xEB;   #      cmp   x13, x15
            0xC3; 0xFE; 0xFF; 0x54;   #      b.lo  L1
            0x09; 0x7D; 0x60; 0xD3;   # L3:  lsl   x9, x8, #32
            0x29; 0x01; 0x0B; 0xAA;   #      orr   x9, x9, x11
            0x89; 0xA5; 0x02; 0x9B;   #      msub  x9, x12, x2, x9     ; un21
            0xE1; 0x03; 0x0C; 0xAA;   #      mov   x1, x12             ; q1, kept
            0x2C; 0x09; 0xC6; 0x9A;   #      udiv  x12, x9, x6         ; q0
            0x8D; 0xA5; 0x06; 0x9B;   #      msub  x13, x12, x6, x9    ; rhat
            0x9F; 0x01; 0x0F; 0xEB;   # L4:  cmp   x12, x15
            0xC2; 0x00; 0x00; 0x54;   #      b.hs  L5                  ; q0 >= b
            0x8E; 0x7D; 0x07; 0x9B;   #      mul   x14, x12, x7
            0xA8; 0x7D; 0x60; 0xD3;   #      lsl   x8, x13, #32
            0x08; 0x01; 0x0A; 0xAA;   #      orr   x8, x8, x10
            0xDF; 0x01; 0x08; 0xEB;   #      cmp   x14, x8
            0xA9; 0x00; 0x00; 0x54;   #      b.ls  L6                  ; q0*vn0 <= b*rhat+un0
            0x8C; 0x05; 0x00; 0xD1;   # L5:  sub   x12, x12, #1
            0xAD; 0x01; 0x06; 0x8B;   #      add   x13, x13, x6
            0xBF; 0x01; 0x0F; 0xEB;   #      cmp   x13, x15
            0xC3; 0xFE; 0xFF; 0x54;   #      b.lo  L4
            0x28; 0x7D; 0x60; 0xD3;   # L6:  lsl   x8, x9, #32
            0x08; 0x01; 0x0A; 0xAA;   #      orr   x8, x8, x10
            0x88; 0xA1; 0x02; 0x9B;   #      msub  x8, x12, x2, x8     ; r << s
            0x08; 0x25; 0xC5; 0x9A;   #      lsr   x8, x8, x5          ; r
            0x81; 0x81; 0x01; 0xAA;   #      orr   x1, x12, x1, lsl #32 ; q.lo = q1 * 2^32 + q0
            param_load(x9, 0);        # qdst
            param_load(x10, 1);       # rdst
            0x21; 0x01; 0x00; 0xF9;   #      str   x1, [x9]            ; q.lo
            0x20; 0x05; 0x00; 0xF9;   #      str   x0, [x9, #8]        ; q.hi
            0x48; 0x01; 0x00; 0xF9;   #      str   x8, [x10]           ; r.lo
            0x5F; 0x05; 0x00; 0xF9;   #      str   xzr, [x10, #8]      ; r.hi = 0
        }
        return 0;
    }
    #endif
    var q_lo = 0;
    var q_hi = 0;
    var r_lo = 0;
    var r_hi = 0;
    var i = 127;
    while (i >= 0) {
        # r <<= 1 (128-bit) — top bit of r_lo spills into r_hi
        var spill = _u128_lshr64(r_lo, 63) & 1;
        r_hi = (r_hi << 1) | spill;
        r_lo = r_lo << 1;
        # Bring bit i of `a` into r's LSB.
        var bit = 0;
        if (i >= 64) { bit = _u128_lshr64(a_hi, i - 64) & 1; }
        else { bit = _u128_lshr64(a_lo, i) & 1; }
        r_lo = r_lo | bit;
        # Compare r >= b (unsigned 128-bit).
        var ge = 0;
        if (r_hi != b_hi) { ge = _u64_ugt(r_hi, b_hi); }
        else { ge = _u64_uge(r_lo, b_lo); }
        if (ge == 1) {
            # r -= b
            var borrow = 0;
            if (_u64_ugt(b_lo, r_lo) == 1) { borrow = 1; }
            r_lo = r_lo - b_lo;
            r_hi = r_hi - b_hi - borrow;
            # q |= (1 << i)
            if (i >= 64) { q_hi = q_hi | (1 << (i - 64)); }
            else { q_lo = q_lo | (1 << i); }
        }
        i = i - 1;
    }
    store64(qdst, q_lo);
    store64(qdst + 8, q_hi);
    store64(rdst, r_lo);
    store64(rdst + 8, r_hi);
    return 0;
}

# Convenience: quotient only / remainder only. Uses a module-level
# scratch u128 for the discarded half.
var _u128_discard: u128 = 0;

# dst = a / b (quotient only). Division by zero exits 1.
fn bayan_u128_div(dst, a, b): i64 {
    return bayan_u128_divmod(dst, &_u128_discard, a, b);
}
# dst = a % b (remainder only). Division by zero exits 1.
fn bayan_u128_mod(dst, a, b): i64 {
    return bayan_u128_divmod(&_u128_discard, dst, a, b);
}

# `dst /= src`.
fn bayan_u128_diveq(dst, src): i64 { return bayan_u128_div(dst, dst, src); }
# `dst %= src`.
fn bayan_u128_modeq(dst, src): i64 { return bayan_u128_mod(dst, dst, src); }

# ================================================================
# u64 MODULAR ARITHMETIC
# ================================================================
# Two ergonomic helpers built on top of the `bayan_u128_mul + bayan_u128_mod`
# pipeline, whose fast-path now uses hardware `div` when
# the modulus fits in 64 bits. Purpose is abaco's ntheory::mod_mul
# / mod_pow call shape — and every RSA / primality / cryptographic-
# hash consumer that used to hand-roll a double-and-add loop. The
# helpers keep the u128 machinery hidden from the caller.
#
# Preconditions (caller-enforced; no runtime checks):
#   bayan_u64_mulmod(a, b, m): m > 0. a and b may be >= m (they're
#     reduced internally via the mod), but for abaco's Miller-
#     Rabin style workloads a, b < m is the common case.
#   bayan_u64_powmod(base, exp, m): m > 0. On m == 1, returns 0 without
#     touching the fast path.
#
# `bayan_u64_mulmod` stack scratch: two u128 locals (product + modulus
# envelope). The abaco bench in benches/bench_mulmod.bcyr shows
# the concrete win versus a pure-Cyrius double-and-add reference.

# Return (a * b) mod m, all u64. Collapses to three hardware
# instructions: `mul b ; div m ; mov result, rdx` — no u128
# intermediate, no shift-subtract loop, no Cyrius-level function
# calls inside the hot path.
#
# The fast path needs a < m and b < m, because x86's `DIV`
# raises #DE when the QUOTIENT does not fit in 64 bits — not
# only when the divisor is zero. With a 128-bit product over a
# 31-bit modulus the quotient wants ~97 bits and the process
# dies.
#
# 1.5.2: that precondition is now ENFORCED here rather than
# asserted in a comment. It used to be caller-enforced, and the
# two targets disagreed about what happened when a caller got it
# wrong: the aarch64 path went through the u128 pipeline and
# returned the right answer, while x86 took SIGFPE. Code
# developed and tested on one architecture therefore died on the
# other, with a documented-but-fatal precondition as the only
# warning. Measured: mulmod(0xfdec65fe72129737, 0x93548b905e5c7474,
# 0x7222d728) — an ordinary 31-bit modulus — killed the process.
#
# Operands are reduced up front when that is provably safe with
# Cyrius's SIGNED `%` (both operands and the modulus below 2^63),
# which is the overwhelmingly common case and costs two hardware
# divisions. Anything else goes through the wide path. aarch64
# takes neither: its asm block reduces with the unsigned `udiv`.
# Callers that already reduce — Miller-Rabin, Pollard rho, RSA —
# pay only the two extra divisions.
# The wide fallback: full 128-bit product, then a 128-bit
# remainder by shift-subtract. Correct for every input including
# unreduced operands and a modulus at or above 2^63. Kept in its
# own function so its locals cannot disturb the fixed frame
# offsets the x86 asm block below depends on.
fn _u64_mulmod_wide(a, b, m): i64 {
    var pa: u128 = 0;
    var pb: u128 = 0;
    var pr: u128 = 0;
    var pm: u128 = 0;
    bayan_u128_from_u64(&pa, a);
    bayan_u128_from_u64(&pb, b);
    bayan_u128_from_u64(&pm, m);
    bayan_u128_mul(&pr, &pa, &pb);
    bayan_u128_mod(&pr, &pr, &pm);
    return bayan_u128_lo(&pr);
}

fn bayan_u64_mulmod(a, b, m): i64 {
    var result = 0;
    # NOTE: `result` must stay local index 3 — the x86 and aarch64 asm blocks
    # below address it at a fixed frame offset ([rbp-32] / [x29, #-32]). Locals
    # declared AFTER it take higher indices and do not disturb that slot; a
    # local declared before it would shift every offset and silently corrupt
    # the blocks.
    if (m == 0) { return 0; }
    #ifdef CYRIUS_ARCH_AARCH64
    # aarch64 has no 128/64 divide, so the remainder of the 128-bit product
    # (mul + umulh) is taken by Knuth's Algorithm D with two 32-bit digits
    # (TAOCP vol. 2, 4.3.1; Hacker's Delight 2nd ed., fig. 9-3 `divlu`,
    # remainder only), in registers: four udiv, no loop over bits, no calls.
    # Through 1.5.9 every aarch64 call went to _u64_mulmod_wide instead, whose
    # 128-round shift-subtract in bayan_u128_divmod (three to five helper calls
    # a round) cost ~18 us per call under qemu-aarch64 — ~600x a plain
    # `(a * b) % m` call, where x86 sits at 2x — and powmod paid it once or
    # twice per exponent bit.
    #
    # Operands are reduced first with udiv/msub, which is unsigned, so this
    # takes every input with m != 0 — unreduced operands and m >= 2^63 too.
    # Then a, b < m, so the high word of a*b is below m: the precondition of
    # the two-digit division. The normalising shift s = clz(m) is 0 for
    # m >= 2^63, and `lsr` takes its count mod 64, so `u0 >> (64 - s)` would be
    # u0 rather than 0 there; the csel zeroes it. Each digit's correction loop
    # runs at most twice (Knuth's q-hat - 2 <= q <= q-hat), and rhat starts
    # below vn1 < 2^32 and is re-checked against 2^32 before every retest, so
    # `rhat << 32` never loses bits. That re-check must be `b.lo`: a loop that
    # retested at rhat == 2^32 exactly would read `rhat << 32` as 0.
    #
    # Three parts stay for fidelity to the textbook routine although removing
    # any one of them changes no result (a mutation pass sees them survive;
    # that is not a gap in the tests):
    #  - L1's back-edge. The first digit corrects at most once for a product
    #    of reduced operands, so the retest the back-edge leads to always
    #    passes and L2 never runs twice. With D = un32:un1 (96 bits) and
    #    q1 = D / v, a second pass needs q-hat >= q1 + 2, so
    #    D >= (q1 + 2) * vn1 * 2^32; with D < (q1 + 1) * v that forces
    #    vn1 * 2^32 < (q1 + 1) * vn0, so q1 >= vn1. But a, b < m gives
    #    q1 <= (m - 1)^2 * 2^s / (2^32 * v) < (vn1 + 1) / 2^s. For s >= 1 that
    #    contradicts q1 >= vn1. For s = 0 it forces q1 = vn1 and
    #    vn0 = 2^32 - 1, and then D <= (m - 1)^2 / 2^32
    #    = (vn1 + 1)^2 * 2^32 - 4 * (vn1 + 1), short of the
    #    ((vn1 + 1)^2 - 1) * 2^32 that q-hat >= vn1 + 2 needs, because
    #    4 * (vn1 + 1) > 2^32.
    #  - the `b.hs` tests, which 64-bit registers make redundant
    #    (q-hat <= 2^32 + 1, so q-hat * vn0 cannot overflow).
    #  - one of the two udiv/msub reductions. Either alone already puts the
    #    high word below m (a < 2^64 and b < m give a * b < 2^64 * m).
    #
    # Locals: a(0)=[x29,#-8], b(1)=[x29,#-16], m(2)=[x29,#-24],
    #         result(3)=[x29,#-32]. cyrius never enables regalloc on aarch64
    # or in a fn containing asm, so these slots are fixed. Scratch is x0-x15,
    # caller-saved under AAPCS64 and never live across a statement in cyrius's
    # aarch64 codegen; x16-x18 and x28 (the arm64 Mach-O argv park) are
    # untouched. Encoded with llvm-mc 22.1.8 and read back with objdump, which
    # also places every branch on the label named beside it.
    asm {
        param_load(x0, 0);        # a
        param_load(x1, 1);        # b
        param_load(x2, 2);        # m
        0x03; 0x08; 0xC2; 0x9A;   #      udiv  x3, x0, x2
        0x60; 0x80; 0x02; 0x9B;   #      msub  x0, x3, x2, x0     ; a %= m
        0x23; 0x08; 0xC2; 0x9A;   #      udiv  x3, x1, x2
        0x61; 0x84; 0x02; 0x9B;   #      msub  x1, x3, x2, x1     ; b %= m
        0x03; 0x7C; 0x01; 0x9B;   #      mul   x3, x0, x1         ; u0 = lo
        0x04; 0x7C; 0xC1; 0x9B;   #      umulh x4, x0, x1         ; u1 = hi < m
        0x45; 0x10; 0xC0; 0xDA;   #      clz   x5, x2             ; s
        0x42; 0x20; 0xC5; 0x9A;   #      lsl   x2, x2, x5         ; v = m << s
        0x46; 0xFC; 0x60; 0xD3;   #      lsr   x6, x2, #32        ; vn1
        0x47; 0x7C; 0x40; 0x92;   #      and   x7, x2, #0xffffffff ; vn0
        0x88; 0x20; 0xC5; 0x9A;   #      lsl   x8, x4, x5
        0xE9; 0x03; 0x05; 0xCB;   #      neg   x9, x5
        0x69; 0x24; 0xC9; 0x9A;   #      lsr   x9, x3, x9         ; u0 >> (64 - s)
        0xBF; 0x00; 0x00; 0xF1;   #      cmp   x5, #0
        0xE9; 0x03; 0x89; 0x9A;   #      csel  x9, xzr, x9, eq    ; 0 when s == 0
        0x08; 0x01; 0x09; 0xAA;   #      orr   x8, x8, x9         ; un32
        0x6A; 0x20; 0xC5; 0x9A;   #      lsl   x10, x3, x5        ; un10
        0x4B; 0xFD; 0x60; 0xD3;   #      lsr   x11, x10, #32      ; un1
        0x4A; 0x7D; 0x40; 0x92;   #      and   x10, x10, #0xffffffff ; un0
        0x2F; 0x00; 0xC0; 0xD2;   #      mov   x15, #0x100000000  ; b = 2^32
        0x0C; 0x09; 0xC6; 0x9A;   #      udiv  x12, x8, x6        ; q1
        0x8D; 0xA1; 0x06; 0x9B;   #      msub  x13, x12, x6, x8   ; rhat
        0x9F; 0x01; 0x0F; 0xEB;   # L1:  cmp   x12, x15
        0xC2; 0x00; 0x00; 0x54;   #      b.hs  L2                 ; q1 >= b
        0x8E; 0x7D; 0x07; 0x9B;   #      mul   x14, x12, x7
        0xA9; 0x7D; 0x60; 0xD3;   #      lsl   x9, x13, #32
        0x29; 0x01; 0x0B; 0xAA;   #      orr   x9, x9, x11
        0xDF; 0x01; 0x09; 0xEB;   #      cmp   x14, x9
        0xA9; 0x00; 0x00; 0x54;   #      b.ls  L3                 ; q1*vn0 <= b*rhat+un1
        0x8C; 0x05; 0x00; 0xD1;   # L2:  sub   x12, x12, #1
        0xAD; 0x01; 0x06; 0x8B;   #      add   x13, x13, x6
        0xBF; 0x01; 0x0F; 0xEB;   #      cmp   x13, x15
        0xC3; 0xFE; 0xFF; 0x54;   #      b.lo  L1
        0x09; 0x7D; 0x60; 0xD3;   # L3:  lsl   x9, x8, #32
        0x29; 0x01; 0x0B; 0xAA;   #      orr   x9, x9, x11
        0x89; 0xA5; 0x02; 0x9B;   #      msub  x9, x12, x2, x9    ; un21
        0x2C; 0x09; 0xC6; 0x9A;   #      udiv  x12, x9, x6        ; q0
        0x8D; 0xA5; 0x06; 0x9B;   #      msub  x13, x12, x6, x9   ; rhat
        0x9F; 0x01; 0x0F; 0xEB;   # L4:  cmp   x12, x15
        0xC2; 0x00; 0x00; 0x54;   #      b.hs  L5                 ; q0 >= b
        0x8E; 0x7D; 0x07; 0x9B;   #      mul   x14, x12, x7
        0xA8; 0x7D; 0x60; 0xD3;   #      lsl   x8, x13, #32
        0x08; 0x01; 0x0A; 0xAA;   #      orr   x8, x8, x10
        0xDF; 0x01; 0x08; 0xEB;   #      cmp   x14, x8
        0xA9; 0x00; 0x00; 0x54;   #      b.ls  L6                 ; q0*vn0 <= b*rhat+un0
        0x8C; 0x05; 0x00; 0xD1;   # L5:  sub   x12, x12, #1
        0xAD; 0x01; 0x06; 0x8B;   #      add   x13, x13, x6
        0xBF; 0x01; 0x0F; 0xEB;   #      cmp   x13, x15
        0xC3; 0xFE; 0xFF; 0x54;   #      b.lo  L4
        0x28; 0x7D; 0x60; 0xD3;   # L6:  lsl   x8, x9, #32
        0x08; 0x01; 0x0A; 0xAA;   #      orr   x8, x8, x10
        0x88; 0xA1; 0x02; 0x9B;   #      msub  x8, x12, x2, x8
        0x08; 0x25; 0xC5; 0x9A;   #      lsr   x8, x8, x5         ; remainder
        0xA8; 0x03; 0x1E; 0xF8;   #      stur  x8, [x29, #-32]    ; result
    }
    #else
    var wide = 0;
    if (m < 0) { wide = 1; }        # modulus >= 2^63 read as unsigned
    if (a < 0) { wide = 1; }        # operand  >= 2^63 read as unsigned
    if (b < 0) { wide = 1; }
    if (wide == 1) { return _u64_mulmod_wide(a, b, m); }
    # Now 0 <= a, b and 0 < m < 2^63, so the signed `%` is the unsigned one.
    # After reducing, a*b < m^2 and the quotient a*b/m < m < 2^63 — it fits in
    # 64 bits, which is exactly what x86's DIV requires.
    a = a % m;
    b = b % m;
    #ifdef CYRIUS_ARCH_X86
    # Locals: a(0)=[rbp-8], b(1)=[rbp-16], m(2)=[rbp-24],
    #         result(3)=[rbp-32].
    asm {
        0x48; 0x8B; 0x45; 0xF8;   # mov rax, [rbp-8]    ; a
        0x48; 0xF7; 0x65; 0xF0;   # mul qword [rbp-16]  ; rdx:rax = a*b
        0x48; 0xF7; 0x75; 0xE8;   # div qword [rbp-24]  ; rax=quot rdx=rem
        0x48; 0x89; 0x55; 0xE0;   # mov [rbp-32], rdx   ; result = rem
    }
    #else
    # A target with neither arch macro: the cx bytecode backend predefines
    # CYRIUS_TARGET_CX and no CYRIUS_ARCH_*. Through 1.5.9 this arm was `#ifdef
    # CYRIUS_ARCH_AARCH64`, so on cx neither arm compiled and every call with
    # a, b and m below 2^63 returned the 0 `result` starts at: mulmod(3, 5, 7)
    # said 0, and so did every powmod with 1 < m < 2^63 and exp > 0 (cxvm,
    # cyrius 6.6.12). CI cannot build cx, so scripts/check-arch-arms.py checks
    # that this arm is still here.
    result = _u64_mulmod_wide(a, b, m);
    #endif
    #endif
    return result;
}

# Return base^exp mod m, all u64. Square-and-multiply via
# bayan_u64_mulmod on every step, so the inner loop cost is two hardware
# `div` instructions per iteration instead of a 128-iter shift-
# subtract. Loop count is exactly the bit-length of `exp`, read as
# unsigned. Through 1.5.9 the loop was `while (exp > 0)`, a signed test,
# so for every exp at or above 2^63 it never ran and the call returned 1.
# It now runs until exp is 0, shifting with _u128_lshr64, which is
# logical whatever a backend's `>>` does.
fn bayan_u64_powmod(base, exp, m): i64 {
    if (m == 0) { return 0; }
    if (m == 1) { return 0; }
    var result = 1;
    # `base % m` is the SIGNED remainder, so it is only the unsigned one when
    # both are below 2^63. Outside that, let mulmod do the reduction (its
    # wide path on x86, the unsigned udiv on aarch64) rather than feeding it
    # a negative value (1.5.2).
    if (base >= 0 && m > 0) { base = base % m; }
    else { base = bayan_u64_mulmod(base, 1, m); }
    while (exp != 0) {
        if ((exp & 1) == 1) {
            result = bayan_u64_mulmod(result, base, m);
        }
        exp = _u128_lshr64(exp, 1);
        if (exp != 0) {
            base = bayan_u64_mulmod(base, base, m);
        }
    }
    return result;
}

# --- bigint.cyr ---

# bigint.cyr — 256-bit unsigned integer arithmetic
# Usage: include "lib/bayan.cyr" (full bundle) or "lib/bayan-bigint.cyr" (sublib).
#        `lib/bigint.cyr` was the pre-carve stdlib module and no longer ships —
#        this content moved into bayan at 1.0.0 / cyrius 6.1.25.
# Requires: alloc.cyr, string.cyr
#
# Representation: 4 × 64-bit limbs in little-endian order
# u256 = { limb[0] (low), limb[1], limb[2], limb[3] (high) }
# Each limb treated as unsigned via masking.
#
# Core operations: add, sub, mul, mod, compare, shift
# For Ed25519/secp256k1 curve arithmetic.

# ================================================================
# Limb access (32 bytes = 4 × 8)
# ================================================================

const U256_SIZE = 32;

# Create a zero u256
fn bayan_u256_zero(): i64 {
    var r = alloc(32);
    store64(r, 0);
    store64(r + 8, 0);
    store64(r + 16, 0);
    store64(r + 24, 0);
    return r;
}

# Create u256 from a single 64-bit value
fn bayan_u256_from(val): i64 {
    var r = alloc(32);
    store64(r, val);
    store64(r + 8, 0);
    store64(r + 16, 0);
    store64(r + 24, 0);
    return r;
}

# Copy u256
fn bayan_u256_copy(dst, src): i64 {
    store64(dst, load64(src));
    store64(dst + 8, load64(src + 8));
    store64(dst + 16, load64(src + 16));
    store64(dst + 24, load64(src + 24));
    return 0;
}

# Clone u256 (allocates new)
fn bayan_u256_clone(a): i64 {
    var r = alloc(32);
    bayan_u256_copy(r, a);
    return r;
}

# Get/set individual limbs
fn bayan_u256_limb(a, i): i64 { return load64(a + i * 8); }
# Set limb i of u256 to value v
fn bayan_u256_set_limb(a, i, v): i64 { store64(a + i * 8, v); return 0; }

# True if zero
fn bayan_u256_is_zero(a): bool {
    if (load64(a) != 0) { return false; }
    if (load64(a + 8) != 0) { return false; }
    if (load64(a + 16) != 0) { return false; }
    if (load64(a + 24) != 0) { return false; }
    return true;
}

# ================================================================
# Comparison (unsigned)
# ================================================================

# Compare a vs b: returns 1 if a > b, -1 if a < b, 0 if equal
fn bayan_u256_cmp(a, b): i64 {
    # Compare from high limb to low
    var i = 3;
    while (i >= 0) {
        var al = load64(a + i * 8);
        var bl = load64(b + i * 8);
        # Unsigned comparison via XOR high bit trick
        var ax = al ^ (1 << 63);
        var bx = bl ^ (1 << 63);
        if (ax > bx) { return 1; }
        if (ax < bx) { return 0 - 1; }
        i = i - 1;
    }
    return 0;
}

# True when all four limbs are equal
fn bayan_u256_eq(a, b): bool {
    if (load64(a) != load64(b)) { return false; }
    if (load64(a + 8) != load64(b + 8)) { return false; }
    if (load64(a + 16) != load64(b + 16)) { return false; }
    if (load64(a + 24) != load64(b + 24)) { return false; }
    return true;
}

# ================================================================
# Addition / Subtraction with carry
# ================================================================

# Add two 64-bit values, return {sum, carry}
# Uses the fact that if a + b < a, carry occurred (unsigned overflow)
fn _add64(a, b): i64 {
    var sum = a + b;
    # Unsigned carry detection: if sum < a (treating as unsigned)
    var carry = 0;
    var sa = a ^ (1 << 63);
    var ss = sum ^ (1 << 63);
    if (ss < sa) { carry = 1; }
    # Edge case: if b was added to get exactly 0 (full wrap)
    if (sum == 0) { if (a != 0) { carry = 1; } }
    return carry;
}

# Add single limb pair, return carry
fn _add_limb(r_off, r, a, b, carry_in): i64 {
    var al = load64(a + r_off);
    var bl = load64(b + r_off);
    var s1 = al + bl;
    var c1 = _add64(al, bl);
    var s2 = s1 + carry_in;
    var c2 = 0;
    if (carry_in > 0) {
        if (s2 == 0) { c2 = 1; }
        else { var sx = s2 ^ (1 << 63); var s1x = s1 ^ (1 << 63); if (sx < s1x) { c2 = 1; } }
    }
    store64(r + r_off, s2);
    return c1 + c2;
}

# r = a + b (mod 2^256). Returns carry (0 or 1).
fn bayan_u256_add(r, a, b): i64 {
    var c = _add_limb(0, r, a, b, 0);
    c = _add_limb(8, r, a, b, c);
    c = _add_limb(16, r, a, b, c);
    c = _add_limb(24, r, a, b, c);
    return c;
}

# r = a - b (mod 2^256). Returns borrow (0 or 1).
# Subtract single limb pair, return borrow
fn _sub_limb(r_off, r, a, b, borrow_in): i64 {
    var al = load64(a + r_off);
    var bl = load64(b + r_off);
    var new_borrow = 0;
    if (borrow_in > 0) {
        if (bl == (0 - 1)) {
            new_borrow = 1;
            store64(r + r_off, al);
        } else {
            var bl2 = bl + 1;
            var ax = al ^ (1 << 63);
            var bx = bl2 ^ (1 << 63);
            if (bx > ax) { new_borrow = 1; }
            store64(r + r_off, al - bl2);
        }
    } else {
        var ax = al ^ (1 << 63);
        var bx = bl ^ (1 << 63);
        if (bx > ax) { new_borrow = 1; }
        store64(r + r_off, al - bl);
    }
    return new_borrow;
}

# r = a - b (mod 2^256). Returns borrow (0 or 1).
fn bayan_u256_sub(r, a, b): i64 {
    var c = _sub_limb(0, r, a, b, 0);
    c = _sub_limb(8, r, a, b, c);
    c = _sub_limb(16, r, a, b, c);
    c = _sub_limb(24, r, a, b, c);
    return c;
}

# ================================================================
# Multiplication (64×64→128 via 32-bit halves)
# ================================================================

# Multiply two 64-bit values, store 128-bit result in {lo, hi}
# Split each into 32-bit halves: a = aH*2^32 + aL, b = bH*2^32 + bL
# a*b = aH*bH*2^64 + (aH*bL + aL*bH)*2^32 + aL*bL
fn _mul64(a, b, out_lo, out_hi): i64 {
    var mask32 = 0xFFFFFFFF;
    var aL = a & mask32;
    var aH = (a >> 32) & mask32;
    var bL = b & mask32;
    var bH = (b >> 32) & mask32;
    # Partial products (each fits in 64 bits since 32×32 = 64)
    var ll = aL * bL;
    var lh = aL * bH;
    var hl = aH * bL;
    var hh = aH * bH;
    # Combine: lo = ll + (lh + hl) << 32, hi = hh + carries
    var mid = lh + hl;
    # Carry from lh + hl overflow
    var mid_carry = 0;
    if ((mid ^ (1 << 63)) < (lh ^ (1 << 63))) { mid_carry = 1; }
    var lo = ll + (mid << 32);
    var lo_carry = 0;
    if ((lo ^ (1 << 63)) < (ll ^ (1 << 63))) { lo_carry = 1; }
    var hi = hh + (mid >> 32) + (mid_carry << 32) + lo_carry;
    store64(out_lo, lo);
    store64(out_hi, hi);
    return 0;
}

# Unsigned 64-bit less-than. Cyrius `<` is SIGNED, so comparing limbs directly
# treats any value with bit 63 set as negative. Flipping the sign bit on both
# operands maps unsigned order onto signed order.
fn _u256_ult(x, y): i64 {
    if ((x ^ (1 << 63)) < (y ^ (1 << 63))) { return 1; }
    return 0;
}

# r = a * b (mod 2^256). Truncates to 256 bits.
#
# CARRY PROPAGATION (fixed in 1.5.1 — this produced wrong answers).
#
# The previous inner step was a three-term sum, `cur = tmp + lo + carry`, whose
# overflow was detected with a SINGLE comparison of `cur` against the old
# `tmp`. That misses the case where `lo + carry` wraps on its own: the sum then
# lands back at or above `prev` and no carry is recorded. Measured before the
# fix: **220 of 400 random 256-bit products were wrong**, and 53 of 100
# `mulmod` results were wrong under Curve25519's p = 2^255-19. Single-limb
# (64x64) inputs were all correct, which is exactly why the pre-existing tests
# never caught it.
#
# The fix adds the three terms in two steps and records a carry out of each,
# which is the standard schoolbook form. `hi + c1 + c2` cannot overflow: for
# the worst case a[i] = b[j] = 2^64-1, the full quantity
# a[i]*b[j] + tmp + carry is at most (2^64-1)^2 + 2*(2^64-1) = 2^128 - 1, so
# its high word is at most 2^64-1.
fn bayan_u256_mul(r, a, b): i64 {
    # Schoolbook multiplication: 4×4 limbs
    var tmp[64];  # 8 limbs temp (512 bits)
    memset(&tmp, 0, 64);
    var i = 0;
    while (i < 4) {
        var carry = 0;
        var j = 0;
        while (j < 4) {
            if (i + j < 4) {
                var lo[8];
                var hi[8];
                _mul64(load64(a + i * 8), load64(b + j * 8), &lo, &hi);
                var prev = load64(&tmp + (i + j) * 8);
                var s1 = prev + load64(&lo);
                var c1 = 0;
                if (_u256_ult(s1, prev) == 1) { c1 = 1; }
                var s2 = s1 + carry;
                var c2 = 0;
                if (_u256_ult(s2, s1) == 1) { c2 = 1; }
                store64(&tmp + (i + j) * 8, s2);
                carry = load64(&hi) + c1 + c2;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    # Copy low 4 limbs to result
    store64(r, load64(&tmp));
    store64(r + 8, load64(&tmp + 8));
    store64(r + 16, load64(&tmp + 16));
    store64(r + 24, load64(&tmp + 24));
    return 0;
}

# ================================================================
# Shift operations
# ================================================================

# Left shift by 1 bit
fn bayan_u256_shl1(r, a): i64 {
    var carry = 0;
    var i = 0;
    while (i < 4) {
        var v = load64(a + i * 8);
        store64(r + i * 8, (v << 1) | carry);
        carry = (v >> 63) & 1;
        i = i + 1;
    }
    return carry;
}

# Right shift by 1 bit
fn bayan_u256_shr1(r, a): i64 {
    var carry = 0;
    var i = 3;
    while (i >= 0) {
        var v = load64(a + i * 8);
        store64(r + i * 8, (v >> 1) | (carry << 63));
        carry = v & 1;
        i = i - 1;
    }
    return 0;
}

# ================================================================
# Modular reduction: r = a mod p
# ================================================================

# r = a mod p (simple repeated subtraction for small quotients,
# or shift-subtract for general case)
# r = a mod p. Returns 0, or 0 - 1 when p == 0 (r is set to zero).
#
# ALGORITHM (fixed in 1.5.1 — this used to hang).
#
# The previous body reduced by REPEATED SUBTRACTION:
#
#     while (cmp(r, p) >= 0) { sub(r, r, p); }
#
# which runs a/p times. Two consequences, both measured: with p == 0 the
# comparison is always >= and subtracting zero never changes r, so it spins
# **forever** (killed at a 5-second timeout); and with a small p it needs up to
# 2^256 iterations — a 256-bit `a` mod 1 was clocked at 2.06e7 iterations per
# second, i.e. longer than the age of the universe.
#
# Replaced with binary long division: shift a one bit at a time into a running
# remainder and subtract p whenever it fits. That is exactly 256 iterations for
# any input, with no data-dependent bound left for a caller to trip over.
fn bayan_u256_mod(r, a, p): i64 {
    if (bayan_u256_is_zero(p) == 1) {
        bayan_u256_copy(r, bayan_u256_zero());
        return 0 - 1;
    }
    var rem = bayan_u256_zero();
    var i = 255;
    while (i >= 0) {
        # rem = rem * 2 + bit i of a
        bayan_u256_shl1(rem, rem);
        var limb = load64(a + (i / 64) * 8);
        var bit = (limb >> (i % 64)) & 1;
        if (bit == 1) { store64(rem, load64(rem) | 1); }
        if (bayan_u256_cmp(rem, p) >= 0) { bayan_u256_sub(rem, rem, p); }
        i = i - 1;
    }
    bayan_u256_copy(r, rem);
    return 0;
}

# r = (a + b) mod p. Precondition: a, b < p (so a + b < 2p → one reduce
# suffices). Honors bayan_u256_add's carry-out — without it, when a + b ≥ 2^256
# the truncated r tests < p and the needed subtract is skipped, leaving r
# short by 2^256 − p (wrong for moduli near 2^256, e.g. the P-256 group
# order; Curve25519 callers with p < 2^255 never overflow). Mirrors
# bayan_u256_submod's borrow handling. See CHANGELOG [6.0.36].
fn bayan_u256_addmod(r, a, b, p): i64 {
    var carry = bayan_u256_add(r, a, b);
    if (carry > 0) {
        bayan_u256_sub(r, r, p);              # overflowed 2^256 → reduce once
    } else {
        if (bayan_u256_cmp(r, p) >= 0) { bayan_u256_sub(r, r, p); }
    }
    return 0;
}

# r = (a - b) mod p (handles underflow by adding p)
fn bayan_u256_submod(r, a, b, p): i64 {
    var borrow = bayan_u256_sub(r, a, b);
    if (borrow > 0) { bayan_u256_add(r, r, p); }
    return 0;
}

# r = (a * b) mod p
fn bayan_u256_mulmod(r, a, b, p): i64 {
    bayan_u256_mul(r, a, b);
    bayan_u256_mod(r, r, p);
    return 0;
}

# ================================================================
# Hex conversion
# ================================================================

# Format u256 as 64-char hex string (big-endian, no prefix)
fn bayan_u256_to_hex(a): i64 {
    var hex = "0123456789abcdef";
    var buf = alloc(65);
    var bi = 0;
    var i = 3;
    while (i >= 0) {
        var v = load64(a + i * 8);
        var j = 15;
        while (j >= 0) {
            store8(buf + bi, load8(hex + ((v >> (j * 4)) & 0xF)));
            bi = bi + 1;
            j = j - 1;
        }
        i = i - 1;
    }
    store8(buf + 64, 0);
    return buf;
}

# Parse hex string to u256 (big-endian, up to 64 chars)
# Parse a hex string into a u256. Returns the value, or 0 (a NULL pointer,
# distinguishable from a pointer to the value zero) when the input is not a
# representable hex number.
#
# VALIDATION (added in 1.5.1 — this used to accept anything).
#
# Two silent wrong answers were measured. `if (len > 64) { len = 64; }` kept
# the FIRST 64 characters and dropped the rest, so a 65-character string parsed
# to a value 16x too small with no complaint. And a byte outside [0-9a-fA-F]
# left the digit at 0 and was OR'd in as a zero, so `"hello world"` parsed to
# 0x...e00000000d and `"12-34"` to 0x12034 — the '-' absorbed as a digit.
#
# Both now refuse. A 65-character number does not fit in 256 bits and a
# non-hex byte is not a digit; answering anyway is the shape this library
# exists to remove.
fn bayan_u256_from_hex(s): i64 {
    var r = bayan_u256_zero();
    var len = strlen(s);
    if (len == 0)  { return 0; }
    if (len > 64)  { return 0; }
    var v0 = 0;
    while (v0 < len) {
        var cc = load8(s + v0);
        var ok = 0;
        if (cc >= 48 && cc <= 57)  { ok = 1; }
        if (cc >= 97 && cc <= 102) { ok = 1; }
        if (cc >= 65 && cc <= 70)  { ok = 1; }
        if (ok == 0) { return 0; }
        v0 = v0 + 1;
    }
    var i = 0;
    while (i < len) {
        # Shift left by 4 bits
        var carry = 0;
        var li = 0;
        while (li < 4) {
            var v = load64(r + li * 8);
            store64(r + li * 8, (v << 4) | carry);
            carry = (v >> 60) & 0xF;
            li = li + 1;
        }
        # Add hex digit
        var c = load8(s + i);
        var d = 0;
        if (c >= 48) { if (c <= 57) { d = c - 48; } }
        if (c >= 97) { if (c <= 102) { d = c - 87; } }
        if (c >= 65) { if (c <= 70) { d = c - 55; } }
        store64(r, load64(r) | d);
        i = i + 1;
    }
    return r;
}

# --- toml.cyr ---

# toml.cyr — TOML parser for vidya content format
# Usage: include "lib/bayan.cyr" (full bundle) or "lib/bayan-toml.cyr" (sublib).
#        `lib/toml.cyr` was the pre-carve stdlib module and no longer ships —
#        this content moved into bayan at 1.0.0 / cyrius 6.1.25.
# Requires: string.cyr, alloc.cyr, str.cyr, vec.cyr, fmt.cyr, fs.cyr,
#           hashseed.cyr (1.11.1: the dotted-key index's per-process hash seed)
#
# Parses TOML files with:
#   key = "value"          (basic string — ESCAPES DECODED as of 1.5.3)
#   key = 'value'          (literal string — verbatim, no escapes; 1.5.3)
#   key = """multi-line""" (basic multi-line — escapes decoded; 1.5.3)
#   key = '''multi-line''' (literal multi-line — verbatim)
#   key = [1, 2, 3]        (array values — captured verbatim, decomposable)
#   [section]              (table headers — v6.0.62, and undocumented until 1.5.3)
#   [[section]]            (arrays of tables)
#   # comments, inline or on their own line (inline handled from 1.5.3)
#
# SUPPORTED AS OF 1.5.4 — the seven items this block used to list as gaps are
# closed. Quoted keys (`"key one" = 1`, `'k' = 1`), dotted keys (`a.b.c = 1`
# names the table `a.b`), inline tables (see bayan_toml_inline_parse), empty
# tables (emitted), duplicate keys (the LAST wins, and bayan_toml_count is
# there for a caller that wants the spec's "duplicate is an error"), the value
# KIND (bayan_toml_pair_kind, so bayan_toml_pair_is_array cannot be fooled by
# a string starting with `[`), and trimmed/unquoted header names.
#
# STILL NOT SUPPORTED — a narrower subset, stated here because the list above
# is what a caller trusts, and an unlisted gap is how a downstream repo ends up
# hand-rolling a second parser (the outcome bayan exists to prevent). Both
# DEGRADE rather than reporting, because this parser has no error channel.
#
#   * A DOTTED KEY WHOSE QUOTED SEGMENT CONTAINS A DOT. `a."b.c".d = 1` joins
#     to the table name `a.b.c`, indistinguishable from what `a.b.c.d = 1`
#     produces. Table names are flat dotted strings here, so there is nowhere
#     to record that one of the dots was quoted.
#   * A [[ARRAY-OF-TABLES]] UNDER A DOTTED PARENT is not merged with a
#     same-named sibling — each `[[a.b]]` block is its own section, which is
#     what you want for array entries and not what you want if you expected
#     `a.b` to be one table.
#
# Neither has a known consumer. They are recorded rather than assumed away,
# because the last time this file described its own limits from memory instead
# of from the code it was wrong about six of seven. Both have answers in
# bayan_toml_v_parse (src/toml_tree.cyr, 1.11.0), which reads TOML into json's
# value tree, keeps a key's segments apart, and refuses what TOML refuses.
#
# STRING VALUES ARE SPEC-DECODED AS OF 1.5.3. Before that every parser here
# returned the raw bytes between the quotes, so `"say \"hi\""` came back with
# its backslashes and a literal string came back with its QUOTES. Consumers
# that compensated for either (mneme did) must drop the compensation or they
# will double-decode — see the CHANGELOG entry for 1.5.3, which is deliberately
# loud about this. `bayan_toml_escape` / `bayan_toml_unescape` are provided so
# a consumer writing TOML by hand does not hand-roll the other half.
#
# Each table is a vec of key-value pairs (like json.cyr).
# bayan_toml_parse returns a vec of { section_name, pairs_vec } entries.
#
# An array VALUE (`key = [ ... ]`) is stored verbatim as its raw bracketed
# Str; `bayan_toml_array_parse` / `bayan_toml_get_array` decompose that raw
# value into a vec of top-level element Strs on demand (v1.1.0). This is the
# scalar-array counterpart to `[[section]]` arrays-of-tables, which remain
# accessible via `bayan_toml_get_sections`.

# v5.8.30 — Result-returning *_r variant for the file-loading
# parser (`bayan_toml_parse_file_r`). Bare `bayan_toml_parse(src)` keeps its
# best-effort vec return — no clean -1 surface to migrate.

# v5.8.30 — TomlError variants. Mirrors the JsonError shape:
# `TomlIoErr` for any IoError raised while reading the source
# file; `TomlParseErr` reserved for a future slot when the
# parser tracks structural errors instead of best-effort
# recovery; `TomlOther` is the catch-all. Variant-name prefix
# `Toml` to keep these distinct from `Io*` / `Json*` variants
# in the global enum-variant namespace.
enum TomlError {
    TomlIoErr;
    TomlParseErr;
    TomlOther;
}

# TOML entry: { section: Str, pairs: vec of {key: Str, value: Str} }

# v5.8.36 — Allocator-as-first-arg variant of bayan_toml_section_new.
# Allocates the 16-byte section header via `a`. Returns 0 on OOM.
fn bayan_toml_section_new_a(a, name, pairs): i64 {
    var s = alloc_via(a, 16);
    if (s == 0) { return 0; }
    store64(s, name);
    store64(s + 8, pairs);
    return s;
}

# Create a TOML section entry. v5.8.36 wrapper.
fn bayan_toml_section_new(name, pairs): i64 {
    return bayan_toml_section_new_a(default_alloc(), name, pairs);
}

# Get section name from a TOML section entry
fn bayan_toml_section_name(s) : i64 { return load64(s); }
# Get pairs vec from a TOML section entry
fn bayan_toml_section_pairs(s) : i64 { return load64(s + 8); }

# --- Value kinds (1.5.4) ---------------------------------------------------
#
# A pair now records WHICH SYNTACTIC FORM produced its value. Until 1.5.4 that
# information was thrown away at parse time, and `bayan_toml_is_array` had to
# guess from the value bytes — so a string whose content starts with `[`
# classified as an array. `format = '[ $host ]($style)'`, an ordinary prompt
# template, was the case that made it concrete.
#
# The kind is the parser's own answer, not a re-derivation, so it cannot be
# fooled by content. TOML_K_UNKNOWN is what a hand-built pair gets: callers
# that construct pairs themselves through bayan_toml_pair_new have no form to
# report, and a guess there would be worse than an honest "unknown".
const TOML_K_UNKNOWN  = 0;   # built by hand, or from a source bayan did not parse
const TOML_K_BASIC    = 1;   # "..."
const TOML_K_LITERAL  = 2;   # '...'
const TOML_K_ML_BASIC = 3;   # """..."""
const TOML_K_ML_LIT   = 4;   # '''...'''
const TOML_K_ARRAY    = 5;   # [ ... ]
const TOML_K_INLINE   = 6;   # { ... }
const TOML_K_BARE     = 7;   # number, boolean, date — unquoted

# 1.5.4 — Allocator-as-first-arg pair constructor that records the value kind.
# The pair is 24 bytes: { key, value, kind }.
fn bayan_toml_pair_new_kind_a(a, key, value, kind): i64 {
    var p = alloc_via(a, 24);
    if (p == 0) { return 0; }
    store64(p, key);
    store64(p + 8, value);
    store64(p + 16, kind);
    return p;
}

# v5.8.36 — Allocator-as-first-arg variant of bayan_toml_pair_new.
#
# ⚠ THE PAIR IS 24 BYTES AS OF 1.5.4, not 16. Anything that allocated a pair by
# hand, or assumed the size, must be re-checked. Reading a pair through the
# accessors below is unaffected, and this constructor keeps its signature —
# a pair built here reports TOML_K_UNKNOWN, because a caller supplying only a
# key and a value has not said what form the value took.
fn bayan_toml_pair_new_a(a, key, value): i64 {
    return bayan_toml_pair_new_kind_a(a, key, value, TOML_K_UNKNOWN);
}

# Create a TOML key-value pair. v5.8.36 wrapper.
fn bayan_toml_pair_new(key, value): i64 {
    return bayan_toml_pair_new_a(default_alloc(), key, value);
}

# 1.5.4 — Default-allocator form of bayan_toml_pair_new_kind_a.
fn bayan_toml_pair_new_kind(key, value, kind): i64 {
    return bayan_toml_pair_new_kind_a(default_alloc(), key, value, kind);
}

# Get key from a TOML pair
fn bayan_toml_pair_key(p) : i64 { return load64(p); }
# Get value from a TOML pair
fn bayan_toml_pair_value(p) : i64 { return load64(p + 8); }

# 1.5.4 — Which syntactic form produced this pair's value (a TOML_K_* value).
fn bayan_toml_pair_kind(p) : i64 { return load64(p + 16); }

# 1.5.4 — true if this pair's value was written as an ARRAY. Unlike
# bayan_toml_is_array, which sniffs the value bytes and cannot tell an array
# from a string that starts with `[`, this is the parser's own answer.
# A hand-built pair (TOML_K_UNKNOWN) reports false.
fn bayan_toml_pair_is_array(p): bool {
    if (bayan_toml_pair_kind(p) == TOML_K_ARRAY) { return true; }
    return false;
}

# 1.5.4 — true if this pair's value was written as an INLINE TABLE `{ ... }`.
fn bayan_toml_pair_is_inline(p): bool {
    if (bayan_toml_pair_kind(p) == TOML_K_INLINE) { return true; }
    return false;
}

# 1.5.4 — true if this pair's value was written as any of the four STRING forms.
fn bayan_toml_pair_is_string(p): bool {
    var k = bayan_toml_pair_kind(p);
    if (k == TOML_K_BASIC || k == TOML_K_LITERAL) { return true; }
    if (k == TOML_K_ML_BASIC || k == TOML_K_ML_LIT) { return true; }
    return false;
}

# Skip whitespace in buffer, return new position
fn _toml_skip_ws(buf, pos, end): i64 {
    while (pos < end) {
        var c = load8(buf + pos);
        if (c != 32 && c != 9) { return pos; }
        pos = pos + 1;
    }
    return pos;
}

# --- Escape handling (1.5.3) ----------------------------------------------
#
# Until 1.5.3 the string parsers returned the RAW bytes between the quotes.
# The backslash was used only to stop an escaped quote from ending the scan;
# it was never consumed as an escape. So `name = "say \"hi\""` came back as
# the 10 bytes `say \"hi\"` instead of the 8 bytes `say "hi"`, and
# `path = "C:\\tmp"` as `C:\\tmp` instead of `C:\tmp` — wrong answers, silent,
# and shaped to look fine because a value with no escapes round-trips.
#
# Reported by mneme (docs/development/issues/2026-08-22-...). mneme had
# compensated in its own code; the compensation is exactly the hand-roll bayan
# exists to delete.
#
# Only the PARSER can do this. A `bayan_toml_unescape` a caller applies to a
# returned value cannot work, because by then the string kind is gone: a basic
# string resolves escapes and a literal string must not, so the same bytes
# decode two different ways depending on which quote produced them. Hence the
# decode happens where the quote is still known, and the public
# unescape/escape helpers below exist for callers writing TOML by hand.
#
# Decoding never expands: an escape is at least 2 raw bytes for at most 1 out,
# `\uXXXX` is 6 raw for at most 3, and `\UXXXXXXXX` is 10 raw for at most 4 —  #skip-lint: escape notation, not a deferral
# so the raw span is always a sufficient cap for the decoded output.

# Decode one hex digit. -1 if not a hex digit.
fn _toml_hex(c): i64 {
    if (c >= 48) { if (c <= 57)  { return c - 48; } }
    if (c >= 97) { if (c <= 102) { return c - 87; } }
    if (c >= 65) { if (c <= 70)  { return c - 55; } }
    return 0 - 1;
}

# ASCII digit for a nibble (uppercase hex).
fn _toml_hexdig(v): i64 {
    if (v < 10) { return 48 + v; }
    return 55 + v;
}

# Encode codepoint `cp` as UTF-8 into dst; returns bytes written (1..4).
# Callers must reject surrogates first — see _toml_hex_run.
#
# This duplicates json.cyr's _jp_emit_utf8 on purpose. `[lib.toml]` is a
# single-module closure (cyrius.cyml) and toml.cyr is emitted BEFORE json.cyr
# in the full bundle, so referencing the json helper is impossible under the
# single-pass compiler and would also drag json.cyr into every TOML-only
# consumer. Twelve lines is the cheaper of the two costs.
fn _toml_emit_utf8(dst, cp): i64 {
    if (cp < 128) { store8(dst, cp); return 1; }
    if (cp < 2048) {
        store8(dst, 192 | (cp >> 6));
        store8(dst + 1, 128 | (cp & 63));
        return 2;
    }
    if (cp < 65536) {
        store8(dst, 224 | (cp >> 12));
        store8(dst + 1, 128 | ((cp >> 6) & 63));
        store8(dst + 2, 128 | (cp & 63));
        return 3;
    }
    store8(dst, 240 | (cp >> 18));
    store8(dst + 1, 128 | ((cp >> 12) & 63));
    store8(dst + 2, 128 | ((cp >> 6) & 63));
    store8(dst + 3, 128 | (cp & 63));
    return 4;
}

# Read exactly `nd` hex digits at buf+p (bounded by n) and return the
# codepoint, or -1 if there are too few digits, a non-hex digit, a value past
# U+10FFFF, or a surrogate. A -1 makes the caller emit the escape VERBATIM
# rather than fabricate a replacement character or invalid UTF-8.
#
# TOML has both `\uXXXX` (nd=4) and `\UXXXXXXXX` (nd=8); JSON has only the  #skip-lint: escape notation, not a deferral
# former and reaches astral planes through surrogate PAIRS, which TOML does
# not use. That is why this is not json.cyr's decoder with a width argument.
fn _toml_hex_run(buf, p, n, nd): i64 {
    if (p + nd > n) { return 0 - 1; }
    var v = 0;
    var k = 0;
    while (k < nd) {
        var d = _toml_hex(load8(buf + p + k));
        if (d < 0) { return 0 - 1; }
        v = (v << 4) | d;
        k = k + 1;
    }
    if (v > 0x10FFFF) { return 0 - 1; }
    if (v >= 0xD800) { if (v <= 0xDFFF) { return 0 - 1; } }
    return v;
}

# The multi-line "line-ending backslash": when the last non-whitespace byte on
# a line inside a `"""` string is an unescaped `\`, the backslash, the newline,
# and all leading whitespace on the following lines are trimmed. `p` points at
# the byte AFTER the backslash; returns the index to resume at, or -1 if this
# backslash is not a line-ending one (no newline in the whitespace run).
fn _toml_ml_fold(buf, p, n): i64 {
    var j = p;
    var saw_nl = 0;
    while (j < n) {
        var w = load8(buf + j);
        if (w == 10) { saw_nl = 1; }
        elif (w != 32 && w != 9 && w != 13) { break; }
        j = j + 1;
    }
    if (saw_nl == 0) { return 0 - 1; }
    return j;
}

# 1 if any of the `n` bytes at `buf` is a backslash.
#
# The parsers call this before decoding so a string with no escapes — the
# overwhelmingly common case — keeps the module's zero-copy property and is
# returned as a VIEW into the source buffer. Only a string that actually
# carries a backslash pays for a copy.
fn _toml_has_bs(buf, n): i64 {
    var i = 0;
    while (i < n) {
        if (load8(buf + i) == 92) { return 1; }
        i = i + 1;
    }
    return 0;
}

# 1 if the `n` bytes at `buf` contain a CRLF pair.
fn _toml_has_crlf(buf, n): i64 {
    var i = 0;
    while (i + 1 < n) {
        if (load8(buf + i) == 13 && load8(buf + i + 1) == 10) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Copy `n` bytes into a fresh buffer, normalising CRLF to LF.
#
# TOML defines "newline" as LF *or* CRLF and says a parser may normalise to
# whatever suits its platform, so the raw CRLF a multi-line body carries is
# genuinely implementation-defined. bayan normalises, which is what tomllib,
# toml-rs, go-toml and tomlkit all do — a distfile whose job is to be the ONE
# shared implementation is the wrong place to be the odd one out, and a value
# that silently carries a stray CR compares unequal to the obvious literal.
#
# An ESCAPED `\r` is deliberately NOT normalised: the author asked for that
# byte by name. Only a raw CRLF newline is folded.
#
# Returns 0 when `a` refuses the copy or its Str (1.5.11). A refused copy used
# to fall back to a view of the RAW bytes made by the DEFAULT allocator — the
# CRs this function exists to remove, reported as success.
fn _toml_crlf_copy_a(a, buf, n): Str {
    var out = alloc_via(a, n + 4);
    if (out == 0) { return 0; }
    var oi = 0;
    var i = 0;
    while (i < n) {
        var c = load8(buf + i);
        if (c == 13 && (i + 1) < n && load8(buf + i + 1) == 10) { i = i + 1; }
        else { store8(out + oi, c); oi = oi + 1; i = i + 1; }
    }
    store8(out + oi, 0);
    return str_new_a(a, out, oi);
}

# Default-allocator wrapper for _toml_crlf_copy_a.
fn _toml_crlf_copy(buf, n): Str {
    return _toml_crlf_copy_a(default_alloc(), buf, n);
}

# Decode TOML basic-string escapes from the `n` bytes at `buf` into a fresh
# buffer allocated via `a`. `ml` = 1 enables the multi-line line-ending
# backslash (see _toml_ml_fold); pass 0 for a single-line basic string.
#
# UNKNOWN ESCAPES ARE PRESERVED VERBATIM. The spec calls `\d` invalid, but
# this parser is best-effort and has no error channel — every other failure
# here (unterminated string, missing `=`) degrades rather than reports. Given
# that, keeping the bytes is strictly better than deleting them: a caller can
# still see what was written, and a Windows path that lost its escaping is a
# recoverable annoyance rather than silent data loss.
#
# Returns 0 when `a` refuses the buffer or the Str (1.5.11). A refused buffer
# used to be answered with str_from("") — an EMPTY string, made by the DEFAULT
# allocator — so every value arm above it reported a refusal as a successfully
# parsed empty value. Every caller now passes the 0 on as a failure: the value
# and key arms, bayan_toml_parse, bayan_toml_inline_parse_a,
# bayan_toml_array_parse_a and bayan_toml_unescape_a.
fn _toml_unescape_span_a(a, buf, n, ml): Str {
    if (n < 0) { n = 0; }
    var out = alloc_via(a, n + 4);
    if (out == 0) { return 0; }
    var oi = 0;
    var i = 0;
    while (i < n) {
        var c = load8(buf + i);
        if (c != 92) {
            # A RAW CRLF inside a multi-line body normalises to LF (see
            # _toml_crlf_copy_a). An ESCAPED \r is not affected: it is stored
            # by the escape arm below and never reaches this path, which is the
            # distinction tomllib draws too.
            if (ml == 1 && c == 13 && (i + 1) < n && load8(buf + i + 1) == 10) { i = i + 1; }
            else { store8(out + oi, c); oi = oi + 1; i = i + 1; }
        }
        elif (i + 1 >= n) { store8(out + oi, 92); oi = oi + 1; i = i + 1; }
        else {
            var e = load8(buf + i + 1);
            if   (e == 34)  { store8(out + oi,  34); oi = oi + 1; i = i + 2; }
            elif (e == 92)  { store8(out + oi,  92); oi = oi + 1; i = i + 2; }
            elif (e == 98)  { store8(out + oi,   8); oi = oi + 1; i = i + 2; }
            elif (e == 102) { store8(out + oi,  12); oi = oi + 1; i = i + 2; }
            elif (e == 110) { store8(out + oi,  10); oi = oi + 1; i = i + 2; }
            elif (e == 114) { store8(out + oi,  13); oi = oi + 1; i = i + 2; }
            elif (e == 116) { store8(out + oi,   9); oi = oi + 1; i = i + 2; }
            elif (e == 117 || e == 85) {
                var nd = 4;
                if (e == 85) { nd = 8; }
                var cp = _toml_hex_run(buf, i + 2, n, nd);
                if (cp < 0) { store8(out + oi, 92); oi = oi + 1; i = i + 1; }
                else {
                    oi = oi + _toml_emit_utf8(out + oi, cp);
                    i = i + 2 + nd;
                }
            }
            elif (ml == 1) {
                var j = _toml_ml_fold(buf, i + 1, n);
                if (j < 0) { store8(out + oi, 92); oi = oi + 1; i = i + 1; }
                else { i = j; }
            }
            else { store8(out + oi, 92); oi = oi + 1; i = i + 1; }
        }
    }
    store8(out + oi, 0);
    return str_new_a(a, out, oi);
}

# Default-allocator wrapper for _toml_unescape_span_a.
fn _toml_unescape_span(buf, n, ml): Str {
    return _toml_unescape_span_a(default_alloc(), buf, n, ml);
}

# 1.5.3 — Allocator-as-first-arg variant of bayan_toml_unescape. Returns 0 when
# `a` refuses an allocation (1.5.11; it returned an empty string, from the
# default allocator, as if the input had decoded to nothing).
fn bayan_toml_unescape_a(a, s): Str {
    if (s == 0) { return str_from(""); }
    return _toml_unescape_span_a(a, str_data(s), str_len(s), 0);
}

# 1.5.3 — Resolve TOML basic-string escapes in `s` and return the decoded
# bytes. Single-line semantics: `\"` `\\` `\b` `\t` `\n` `\f` `\r` `\uXXXX`  #skip-lint: escape notation, not a deferral
# `\UXXXXXXXX`, with unknown escapes preserved verbatim. The multi-line  #skip-lint: escape notation, not a deferral
# line-ending backslash is NOT applied — that is a property of how a `"""`
# string was delimited, which a bare Str no longer records.
#
# Values from `bayan_toml_get` are ALREADY decoded as of 1.5.3; do not apply
# this to them. It is for callers holding TOML text of their own — the mirror
# of bayan_toml_escape below, so a consumer writing a TOML file by hand has
# both halves and does not hand-roll them (mneme's `_cfg_toml_esc` /
# `_cfg_toml_unesc` are the case this replaces).
# Returns 0 when the allocator refuses (1.5.11).
fn bayan_toml_unescape(s): Str {
    return bayan_toml_unescape_a(default_alloc(), s);
}

# 1.5.3 — Allocator-as-first-arg variant of bayan_toml_escape. Returns 0 when
# `a` refuses the output buffer or the Str header (1.5.13; a refused buffer
# came back as an EMPTY string from the default allocator — a caller writing
# a TOML file wrote `key = ""` and reported success).
fn bayan_toml_escape_a(a, s): Str {
    if (s == 0) { return str_from(""); }
    var n = str_len(s);
    var src = str_data(s);
    # 6 bytes is the worst case per input byte (`\u00XX`), and the +8 covers
    # the NUL with room to spare.
    var out = alloc_via(a, (n * 6) + 8);
    if (out == 0) { return 0; }
    var oi = 0;
    var i = 0;
    while (i < n) {
        var c = load8(src + i);
        if   (c == 34) { store8(out + oi, 92); store8(out + oi + 1,  34); oi = oi + 2; }
        elif (c == 92) { store8(out + oi, 92); store8(out + oi + 1,  92); oi = oi + 2; }
        elif (c ==  8) { store8(out + oi, 92); store8(out + oi + 1,  98); oi = oi + 2; }
        elif (c ==  9) { store8(out + oi, 92); store8(out + oi + 1, 116); oi = oi + 2; }
        elif (c == 10) { store8(out + oi, 92); store8(out + oi + 1, 110); oi = oi + 2; }
        elif (c == 12) { store8(out + oi, 92); store8(out + oi + 1, 102); oi = oi + 2; }
        elif (c == 13) { store8(out + oi, 92); store8(out + oi + 1, 114); oi = oi + 2; }
        elif (c < 32 || c == 127) {
            store8(out + oi, 92);
            store8(out + oi + 1, 117);
            store8(out + oi + 2, 48);
            store8(out + oi + 3, 48);
            store8(out + oi + 4, _toml_hexdig((c >> 4) & 15));
            store8(out + oi + 5, _toml_hexdig(c & 15));
            oi = oi + 6;
        }
        else { store8(out + oi, c); oi = oi + 1; }
        i = i + 1;
    }
    store8(out + oi, 0);
    return str_new_a(a, out, oi);
}

# 1.5.3 — Escape `s` for use as the BODY of a TOML basic string (the caller
# supplies the surrounding `"`). Emits `\"` `\\` `\b` `\t` `\n` `\f` `\r` and  #skip-lint: escape notation, not a deferral
# `\u00XX` for every other C0 control byte and DEL, which is exactly the set
# TOML requires escaped. Bytes >= 128 pass through untouched: TOML strings are
# UTF-8 and a multi-byte sequence must not be split into `\u00XX` per byte.
#
# `load8` is unsigned here (verified), so a continuation byte does not fall
# into the `c < 32` arm.
# Returns 0 when the allocator refuses (1.5.13).
fn bayan_toml_escape(s): Str {
    return bayan_toml_escape_a(default_alloc(), s);
}

# --- String value parsers -------------------------------------------------

# Parse a single-line basic string: "value" — returns Str, advances pos
#
# STOPS AT A NEWLINE (fixed in 1.5.1 — this silently deleted keys). The scan
# used to run to the end of the DOCUMENT looking for a closing quote, so an
# unterminated string absorbed every following line until some later line
# happened to contain a quote. Measured:
#
#     a = "oops
#     admin = false
#     b = "x"
#     c = 1
#
# parsed as TWO pairs instead of four, with `a` holding the 23-byte value
# `oops\nadmin = false\nb = ` — and `admin` and `b` simply absent. For a
# format used to carry configuration, a malformed line silently removing a
# security-relevant key two lines later is the worst shape this can take.
#
# A TOML basic string may not contain a literal newline, so the newline is the
# correct terminator. `_toml_str_end` below applies the identical rule; the two
# MUST agree or the parser's cursor desynchronises from the value it just read.
#
# 1.5.3 closes the remaining hole in that rule: a BACKSLASH-ESCAPED newline
# used to be stepped over as "the escaped byte", so `a = "oops\` + newline
# crossed the line after all. An escaped newline is not legal in a single-line
# basic string, so it now terminates the scan exactly as a bare one does.
#
# 1.5.3 also DECODES the escapes (see the block above). A string with no
# backslash still returns a zero-copy view of the source.
fn _toml_parse_str_a(a, buf, pos, end): Str {
    # Skip opening quote
    pos = pos + 1;
    var start = pos;
    while (pos < end) {
        var c = load8(buf + pos);
        if (c == 34) {
            # Closing quote
            var n = pos - start;
            if (_toml_has_bs(buf + start, n) == 0) { return str_new_a(a, buf + start, n); }
            return _toml_unescape_span_a(a, buf + start, n, 0);
        }
        if (c == 10) { return str_from(""); }   # unterminated: do not cross the line
        if (c == 92) {
            if (pos + 1 >= end) { return str_from(""); }
            if (load8(buf + pos + 1) == 10) { return str_from(""); }
            pos = pos + 1;
        }
        pos = pos + 1;
    }
    return str_from("");
}

# Default-allocator wrapper for _toml_parse_str_a.
fn _toml_parse_str(buf, pos, end): Str {
    return _toml_parse_str_a(default_alloc(), buf, pos, end);
}

# Get the end position after a single-line basic string parse
fn _toml_str_end(buf, pos, end): i64 {
    pos = pos + 1;
    while (pos < end) {
        var c = load8(buf + pos);
        if (c == 34) { return pos + 1; }
        # Same newline rules as _toml_parse_str — these two must agree exactly,
        # or the cursor lands somewhere the value scan did not stop. That
        # includes the escaped newline (1.5.3).
        if (c == 10) { return pos; }
        if (c == 92) {
            if (pos + 1 >= end) { return end; }
            if (load8(buf + pos + 1) == 10) { return pos + 1; }
            pos = pos + 1;
        }
        pos = pos + 1;
    }
    return pos;
}

# 1.5.3 — Parse a single-line LITERAL string: 'value'.
#
# There was no such branch before: `key = 'hello'` fell through to the
# "unquoted value, read to end of line" arm and the value came back as
# `'hello'` WITH ITS QUOTES — 7 bytes where the spec says 5. Every literal
# string in every TOML file bayan has ever parsed carried two stray bytes, and
# `'C:\tmp'` (the form literal strings exist FOR) was doubly wrong.
#
# A literal string contains NO escapes — the body is exactly the bytes between
# the quotes, so there is no decode step and the result is always a zero-copy
# view. Like a basic string it may not span a line.
fn _toml_parse_lit_a(a, buf, pos, end): Str {
    pos = pos + 1;
    var start = pos;
    while (pos < end) {
        var c = load8(buf + pos);
        if (c == 39) { return str_new_a(a, buf + start, pos - start); }
        if (c == 10) { return str_from(""); }
        pos = pos + 1;
    }
    return str_from("");
}

# Default-allocator wrapper for _toml_parse_lit_a.
fn _toml_parse_lit(buf, pos, end): Str {
    return _toml_parse_lit_a(default_alloc(), buf, pos, end);
}

# Get the end position after a single-line literal string parse. Must agree
# with _toml_parse_lit exactly, for the same cursor reason as the basic pair.
fn _toml_lit_end(buf, pos, end): i64 {
    pos = pos + 1;
    while (pos < end) {
        var c = load8(buf + pos);
        if (c == 39) { return pos + 1; }
        if (c == 10) { return pos; }
        pos = pos + 1;
    }
    return pos;
}

# --- Multi-line strings ---------------------------------------------------

# Position where a multi-line body starts: past the 3-byte opening delimiter,
# and past ONE immediately-following newline if there is one.
#
# 1.5.3 accepts CRLF there, not only LF. `"""\r\nbody"""` written on Windows
# used to keep a stray leading `\r`.
fn _toml_ml_body_start(buf, pos, end): i64 {
    pos = pos + 3;
    if (pos < end) {
        var c = load8(buf + pos);
        if (c == 10) { pos = pos + 1; }
        elif (c == 13) {
            if (pos + 1 < end) { if (load8(buf + pos + 1) == 10) { pos = pos + 2; } }
        }
    }
    return pos;
}

# Find the closing delimiter RUN for a multi-line body starting at `start`.
# Returns the position of the first delimiter byte of the first run of three,
# or `end` if the string is unterminated.
#
# 1.5.3 — for a BASIC body (`q` == 34) a backslash escapes the next byte, so
# an escaped quote does not contribute to the run. Without this the scan on
# `"""he said \"hi\""""` found "three quotes" starting at the quote of the
# escaped `\"` and stopped ONE BYTE EARLY, so the value came back as
# `he said \"hi\` — a dropped character, not merely an undecoded one.
# A literal body (`q` == 39) has no escapes, so no backslash rule applies.
fn _toml_ml_scan(buf, start, end, q): i64 {
    var p = start;
    while (p < end) {
        var c = load8(buf + p);
        if (c == 92 && q == 34) { p = p + 2; }
        elif (c == q) {
            if (p + 2 < end) {
                if (load8(buf + p + 1) == q && load8(buf + p + 2) == q) { return p; }
            }
            p = p + 1;
        }
        else { p = p + 1; }
    }
    return end;
}

# Length of the run of `q` bytes starting at p.
fn _toml_ml_runlen(buf, p, end, q): i64 {
    var n = 0;
    while (p + n < end) {
        if (load8(buf + p + n) != q) { return n; }
        n = n + 1;
    }
    return n;
}

# Number of run bytes that belong to the BODY rather than the closer. TOML
# lets a multi-line string end in one or two delimiter chars without escaping
# them — the closer is the LAST three of the run — so `"""a""""` is `a"` and
# `'''a''''` is `a'`. bayan used to take the FIRST three, dropping the byte.
fn _toml_ml_extra(buf, r, end, q): i64 {
    var extra = _toml_ml_runlen(buf, r, end, q) - 3;
    if (extra > 2) { extra = 2; }
    if (extra < 0) { extra = 0; }
    return extra;
}

# Parse a triple-quoted multi-line string delimited by `q` — 39 (`'''`,
# literal) or 34 (`"""`, basic). Per TOML, one optional newline immediately
# after the opening delimiter is skipped. Returns Str. (Historically only
# `'''` was handled — a `"""` value fell through to the single-line `"` parser
# and parsed to an empty string, silently dropping the body. Parameterizing by
# `q` fixes that data loss.)
#
# 1.5.3 changed three things here, all of them conformance fixes measured
# against Python's `tomllib`:
#
#   * A TRAILING newline before the closer is no longer trimmed. The spec
#     trims the newline AFTER the opening delimiter and says nothing about the
#     one before the closer, so the classic
#         s = """
#         line1
#         """
#     is `line1\n`, not `line1`. bayan dropped that byte on every such value.
#   * A basic (`"""`) body now has its escapes decoded, including the
#     line-ending backslash.
#   * The closing-delimiter run is handled per spec (see _toml_ml_extra).
#
# A literal (`'''`) body is still captured verbatim — that is what the spec
# says, not an approximation — and stays zero-copy.
fn _toml_parse_multiline_q_a(a, buf, pos, end, q): Str {
    var start = _toml_ml_body_start(buf, pos, end);
    var r = _toml_ml_scan(buf, start, end, q);
    var n = end - start;
    if (r < end) { n = (r - start) + _toml_ml_extra(buf, r, end, q); }
    if (n <= 0) { return str_from(""); }
    if (q == 34) {
        if (_toml_has_bs(buf + start, n) == 1) { return _toml_unescape_span_a(a, buf + start, n, 1); }
    }
    if (_toml_has_crlf(buf + start, n) == 1) { return _toml_crlf_copy_a(a, buf + start, n); }
    return str_new_a(a, buf + start, n);
}

# Default-allocator wrapper for _toml_parse_multiline_q_a.
fn _toml_parse_multiline_q(buf, pos, end, q): Str {
    return _toml_parse_multiline_q_a(default_alloc(), buf, pos, end, q);
}

# Get end position after a triple-quoted string delimited by `q` (39 or 34).
# Must agree with _toml_parse_multiline_q on where the body stops.
fn _toml_multiline_end_q(buf, pos, end, q): i64 {
    var start = _toml_ml_body_start(buf, pos, end);
    var r = _toml_ml_scan(buf, start, end, q);
    if (r >= end) { return end; }
    return r + _toml_ml_extra(buf, r, end, q) + 3;
}

# Back-compat wrappers for the original `'''`-only entry points.
fn _toml_parse_multiline(buf, pos, end): Str { return _toml_parse_multiline_q(buf, pos, end, 39); }
fn _toml_multiline_end(buf, pos, end): i64 { return _toml_multiline_end_q(buf, pos, end, 39); }

# --- The value dispatch, extracted (1.5.4) ---------------------------------
#
# ONE implementation, called by both the top-level parser and
# bayan_toml_inline_parse. It was inline in bayan_toml_parse until 1.5.4; the
# inline-table accessor needed the identical logic, and this module's history
# is a list of two scanners that had to agree and stopped agreeing —
# _toml_parse_str / _toml_str_end, and the three array quote-trackers, each of
# which cost a release. Copying it would have been the third.
#
# Parses the value starting at `pos`. Returns the value Str, stores its
# TOML_K_* kind through `out_kind` and the position just after it through
# `out_pos`. Returns 0 when `a` refuses the value's Str or its decoded copy —
# never an empty string in its place (1.5.11); the callers stop on it. The
# empty value at end of input is allocated through `a` too (1.5.13; it came
# from the DEFAULT allocator, on every call, and was overwritten on all but
# that one path).
fn _toml_parse_value_a(a, buf, pos, end, out_kind, out_pos): Str {
    var value = 0;
    var vkind = TOML_K_BARE;
    if (pos >= end) {
        store64(out_kind, vkind);
        store64(out_pos, pos);
        return str_from_a(a, "");
    }
    var vc = load8(buf + pos);
    # Triple-quoted literal string '''...'''
    var is_tri = vc == 39 && pos + 2 < end;
    if (is_tri == 1) { is_tri = load8(buf + pos + 1) == 39; }
    if (is_tri == 1) { is_tri = load8(buf + pos + 2) == 39; }
    # Triple-quoted basic string """...""" — MUST be checked
    # before the single-line `"` branch below, or the first `"`
    # of `"""` would be read as an empty `"..."` (body dropped).
    var is_tri_d = vc == 34 && pos + 2 < end;
    if (is_tri_d == 1) { is_tri_d = load8(buf + pos + 1) == 34; }
    if (is_tri_d == 1) { is_tri_d = load8(buf + pos + 2) == 34; }
    if (is_tri == 1) {
        value = _toml_parse_multiline_q_a(a, buf, pos, end, 39);
        pos = _toml_multiline_end_q(buf, pos, end, 39);
        vkind = TOML_K_ML_LIT;
    }
    elif (is_tri_d == 1) {
        value = _toml_parse_multiline_q_a(a, buf, pos, end, 34);
        pos = _toml_multiline_end_q(buf, pos, end, 34);
        vkind = TOML_K_ML_BASIC;
    }
    # Double-quoted basic string "..."
    elif (vc == 34) {
        value = _toml_parse_str_a(a, buf, pos, end);
        pos = _toml_str_end(buf, pos, end);
        vkind = TOML_K_BASIC;
    }
    # Single-quoted literal string '...' — 1.5.3. Before this
    # branch existed a literal string fell through to the
    # unquoted arm below and kept its surrounding quotes.
    # It must sit AFTER the `is_tri` check above, or the first
    # `'` of `'''` would be read as an empty `'...'`.
    elif (vc == 39) {
        value = _toml_parse_lit_a(a, buf, pos, end);
        pos = _toml_lit_end(buf, pos, end);
        vkind = TOML_K_LITERAL;
    }
    # Array "[ ... ]" — may span multiple lines (v5.4.17).
    # Walk forward tracking string state and bracket depth so
    # `\n` inside the array body doesn't terminate the value.
    # v1.1.0: track BOTH quote chars, remembering which opened
    # so the other is a literal byte, and skip `#`-to-EOL
    # comments. 1.5.3: escaped quotes, and triple-quoted
    # elements. 1.5.4: brace depth, so an array of inline
    # tables is captured whole.
    elif (vc == 91) {
        var astart = pos;
        var depth = 1;
        var in_quote = 0;
        var in_tri = 0;
        pos = pos + 1;
        while (pos < end && depth > 0) {
            var ch = load8(buf + pos);
            if (in_tri == 1) {
                var tri_end = 0;
                if (ch == in_quote && (pos + 2) < end) {
                    tri_end = load8(buf + pos + 1) == in_quote;
                    if (tri_end == 1) { tri_end = load8(buf + pos + 2) == in_quote; }
                }
                if (tri_end == 1) {
                    pos = pos + 2;
                    in_quote = 0;
                    in_tri = 0;
                }
                elif (ch == 92 && in_quote == 34 && (pos + 1) < end) { pos = pos + 1; }
            }
            elif (in_quote != 0) {
                if (ch == 92 && in_quote == 34 && (pos + 1) < end) { pos = pos + 1; }
                elif (ch == in_quote) { in_quote = 0; }
                elif (ch == 10) {
                    # A raw newline inside a SINGLE-quoted
                    # element means the string is
                    # unterminated. Arrays may span lines,
                    # strings may not. Without this,
                    # `a = ["oops` swallowed the rest of the
                    # document. `break` rather than clearing
                    # depth: the loop tail advances pos
                    # unconditionally, and leaving the cursor
                    # past the newline let the outer
                    # skip-to-EOL eat the whole next line.
                    break;
                }
            }
            else {
                if (ch == 34 || ch == 39) {
                    in_quote = ch;
                    var tri_open = (pos + 2) < end;
                    if (tri_open == 1) { tri_open = load8(buf + pos + 1) == ch; }
                    if (tri_open == 1) { tri_open = load8(buf + pos + 2) == ch; }
                    if (tri_open == 1) {
                        in_tri = 1;
                        pos = pos + 2;
                    }
                }
                elif (ch == 35) {
                    while (pos + 1 < end && load8(buf + pos + 1) != 10) { pos = pos + 1; }
                }
                elif (ch == 91) { depth = depth + 1; }
                elif (ch == 93) { depth = depth - 1; }
            }
            pos = pos + 1;
        }
        if (pos > end) { pos = end; }
        value = str_new_a(a, buf + astart, pos - astart);
        vkind = TOML_K_ARRAY;
    }
    # Inline table "{ ... }" — 1.5.4. It used to fall into
    # the unquoted arm below, where the inline-comment rule
    # truncated it at a `#` inside a quoted string and a
    # newline ended it mid-table. Captured verbatim here,
    # brace-depth and quote aware; decompose with
    # bayan_toml_inline_parse.
    elif (vc == 123) {
        var istart = pos;
        var bdepth = 1;
        var iq = 0;
        pos = pos + 1;
        while (pos < end && bdepth > 0) {
            var ic = load8(buf + pos);
            if (iq != 0) {
                if (ic == 92 && iq == 34 && (pos + 1) < end) { pos = pos + 1; }
                elif (ic == iq) { iq = 0; }
                elif (ic == 10) { break; }
            }
            elif (ic == 34 || ic == 39) { iq = ic; }
            elif (ic == 35) {
                while (pos + 1 < end && load8(buf + pos + 1) != 10) { pos = pos + 1; }
            }
            elif (ic == 123) { bdepth = bdepth + 1; }
            elif (ic == 125) { bdepth = bdepth - 1; }
            elif (ic == 10) {
                # An inline table is single-line per the
                # spec. Stopping here keeps an unclosed one
                # from eating the rest of the document.
                break;
            }
            pos = pos + 1;
        }
        if (pos > end) { pos = end; }
        value = str_new_a(a, buf + istart, pos - istart);
        vkind = TOML_K_INLINE;
    }
    # Unquoted value (number, boolean, date) — read to the
    # end of the line, or to an inline comment.
    #
    # The `#` break is quote-aware. A first cut of this rule
    # broke unconditionally, justified by "a `#` cannot
    # occur inside an unquoted value" — an enumeration that
    # omitted the inline table, which then had its own
    # branch added above. The quote tracking stays: a bare
    # value with a stray quote must not lose its tail.
    else {
        var vstart = pos;
        var uq = 0;
        while (pos < end) {
            var uc = load8(buf + pos);
            if (uc == 10) { break; }
            if (uq != 0) {
                if (uc == 92 && uq == 34 && (pos + 1) < end) { pos = pos + 1; }
                elif (uc == uq) { uq = 0; }
            }
            elif (uc == 35) { break; }
            # `,` and `}` end a bare value too (1.5.4). Nothing bare can contain
            # either — numbers, booleans and dates are made of digits, letters,
            # `_ . + - :` — and this same function parses the values INSIDE an
            # inline table, where there is no newline to stop at. Without it,
            # `{ x = 3, y = 4 }` gave x the value `3, y = 4 }`.
            elif (uc == 44 || uc == 125) { break; }
            elif (uc == 34 || uc == 39) { uq = uc; }
            pos = pos + 1;
        }
        # Trim trailing spaces, tabs and a CR. The trim used
        # to remove spaces only, so every unquoted value in
        # a CRLF-authored file carried a stray CR.
        var vend = pos;
        while (vend > vstart) {
            var tc = load8(buf + vend - 1);
            if (tc != 32 && tc != 9 && tc != 13) { break; }
            vend = vend - 1;
        }
        value = str_new_a(a, buf + vstart, vend - vstart);
        vkind = TOML_K_BARE;
    }
    store64(out_kind, vkind);
    store64(out_pos, pos);
    return value;
}

# --- Key paths and table headers (1.5.4) -----------------------------------
#
# Until 1.5.4 a key was "the bytes up to `=`, a space or a tab". That is not
# what a TOML key is, and three separate defects came out of it:
#
#   * `"key one" = 1` was DROPPED ENTIRELY — the scan stopped at the space
#     inside the quotes, the next byte was not `=`, and there is no `else` on
#     that test. `"key" = 1` survived but kept its quotes, so a lookup missed.
#   * `a . b = 1` was dropped for the same reason.
#   * `[ a ]` named the section " a ", spaces included, so
#     bayan_toml_get_sections("a") silently returned nothing.
#
# One scanner now serves keys and headers alike: segments separated by `.`,
# each either bare or quoted, with whitespace around the dots ignored. A `"`
# segment is decoded like a basic string; a `'` segment is verbatim.

# Scan ONE key segment at `pos`. Stores the segment Str through `out_seg` and
# returns the position just after it, -1 if there is no segment here, or -2
# when the allocator refused the segment's Str (1.5.11: a refused quoted key
# came back as an empty segment, so `"a\tb" = 1` could land as key ``).
fn _toml_key_seg_a(a, buf, pos, end, out_seg): i64 {
    if (pos >= end) { return 0 - 1; }
    var c = load8(buf + pos);
    if (c == 34) {
        var qs = _toml_parse_str_a(a, buf, pos, end);
        var qe = _toml_str_end(buf, pos, end);
        if (qe <= pos) { return 0 - 1; }
        if (qs == 0) { return 0 - 2; }
        store64(out_seg, qs);
        return qe;
    }
    if (c == 39) {
        var ls = _toml_parse_lit_a(a, buf, pos, end);
        var le = _toml_lit_end(buf, pos, end);
        if (le <= pos) { return 0 - 1; }
        if (ls == 0) { return 0 - 2; }
        store64(out_seg, ls);
        return le;
    }
    # Bare segment. Stops at anything that cannot be part of one, which is what
    # makes `a.b`, `a]`, `a =` and `a # c` all terminate correctly here rather
    # than in the caller.
    var bstart = pos;
    while (pos < end) {
        var b = load8(buf + pos);
        if (b == 61 || b == 32 || b == 9 || b == 10 || b == 13) { break; }
        if (b == 46 || b == 93 || b == 35) { break; }
        pos = pos + 1;
    }
    if (pos == bstart) { return 0 - 1; }
    var bs = str_new_a(a, buf + bstart, pos - bstart);
    if (bs == 0) { return 0 - 2; }
    store64(out_seg, bs);
    return pos;
}

# Default-allocator wrapper for _toml_key_seg_a.
fn _toml_key_seg(buf, pos, end, out_seg): i64 {
    return _toml_key_seg_a(default_alloc(), buf, pos, end, out_seg);
}

# Scan a full dotted key path, pushing each segment onto `parts`. Returns the
# position after the last segment, or -1 if there is no key here at all — which
# is how a line beginning with `=` or `]` produces no pair instead of a
# zero-length-key phantom — or -2 when the allocator refused a segment or its
# push (1.5.11), which every caller treats as a failed parse, not a missing key.
fn _toml_scan_key_a(a, buf, pos, end, parts): i64 {
    loop {
        pos = _toml_skip_ws(buf, pos, end);
        var seg[8];
        var np = _toml_key_seg_a(a, buf, pos, end, &seg);
        if (np < 0) { return np; }
        if (vec_push_a(a, parts, load64(&seg)) < 0) { return 0 - 2; }
        pos = np;
        var after = _toml_skip_ws(buf, pos, end);
        if (after < end && load8(buf + after) == 46) { pos = after + 1; }
        else { pos = after; break; }
    }
    return pos;
}

# Join parts[from..to) with `.` — the canonical name of a table. Returns 0 when
# `a` refuses the builder, a grow or the result (1.5.13: the builder came from
# `a` but every append and the result went through the DEFAULT allocator's
# builder fns, which end the process on a refusal, and a refused builder was
# appended to at address 0).
fn _toml_join_parts_a(a, parts, from, to): Str {
    var sb = str_builder_new_a(a);
    if (sb == 0) { return 0; }
    var ji = from;
    while (ji < to) {
        if (ji > from) {
            if (str_builder_add_cstr_a(a, sb, ".") < 0) { return 0; }
        }
        if (str_builder_add_a(a, sb, vec_get(parts, ji)) < 0) { return 0; }
        ji = ji + 1;
    }
    return str_builder_build_a(a, sb);
}

# Append a new section named `name`, with an empty pairs vec, to `sections`.
# Returns the section, or 0 when `name` is 0 (a refused join) or `a` refuses
# the pairs vec, the section or the push (1.5.13).
fn _toml_section_push_a(a, sections, name): i64 {
    if (name == 0) { return 0; }
    var pairs = vec_new_a(a);
    if (pairs == 0) { return 0; }
    var s = bayan_toml_section_new_a(a, name, pairs);
    if (s == 0) { return 0; }
    if (vec_push_a(a, sections, s) < 0) { return 0; }
    return s;
}

# Find a section named `name` among sections[from..). 0 if absent.
#
# `from` is not decoration. A dotted key may only join a table created since
# the CURRENT header opened — otherwise `[[t]] a.b = 1` on the second `[[t]]`
# would merge into the first one's `t.a` sub-table, silently combining two
# array-of-table entries.
fn _toml_section_find(sections, from, name): i64 {
    var si = from;
    var sn = vec_len(sections);
    while (si < sn) {
        var s = vec_get(sections, si);
        if (str_eq(bayan_toml_section_name(s), name) == 1) { return s; }
        si = si + 1;
    }
    return 0;
}

# --- The dotted-key table index (1.11.1) ------------------------------------
#
# A dotted key finds its table among the sections opened since the current
# header: _toml_section_find, a str_eq walk of all of them, once per dotted key.
# A header with n distinct dotted prefixes under it cost O(n^2): 20,000 keys (300
# KB) took 4.0 s where the tree parser takes 0.03 s. The walk stays for the first
# _TOML_DOT_WALK tables of a header (every document bayan had seen, allocating
# nothing new); past that the tables since the header are indexed by name in an
# open-addressing table, dropped when the next header moves the scope.
#   ix: +0 slots (0 while walking; then cap slots of {hash, section})  +8 cap  +16 n
const _TOML_DOT_WALK = 8;

# FNV-1a over the name from a basis seeded per process, then hashseed's finalizer, so every bit of
# the slot depends on the whole name AND the seed. The names are a peer's dotted keys: with
# published constants alone (1.11.1 as first written) a peer precomputed, offline and once, names
# sharing a slot, and each dotted key's lookup walked every table before it — the O(n^2) this
# index replaced. json's key set had the same hash and the same fix. CHANGELOG [1.11.1]
fn _toml_name_hash(name: Str): i64 {
    var p = str_data(name);
    var n = str_len(name);
    var h = 0xCBF29CE484222325 ^ _hm_seed_get();
    var i = 0;
    while (i < n) {
        h = (h ^ load8(p + i)) * 0x100000001B3;
        i = i + 1;
    }
    return _hm_mix(h);
}

fn _toml_dot_put(slots, mask, h, sec): i64 {
    var i = h & mask;
    while (load64(slots + i * 16 + 8) != 0) { i = (i + 1) & mask; }
    store64(slots + i * 16, h);
    store64(slots + i * 16 + 8, sec);
    return 0;
}

# Index the sections[from..) by name into a fresh table of `cap` slots, replacing
# ix's. 0, or -1 when the allocation is refused.
fn _toml_dot_build_a(a, ix, sections, from, cap): i64 {
    var t = alloc_via(a, cap * 16);
    if (t == 0) { return 0 - 1; }
    memset(t, 0, cap * 16);
    var i = from;
    var sn = vec_len(sections);
    while (i < sn) {
        var sec = vec_get(sections, i);
        _toml_dot_put(t, cap - 1, _toml_name_hash(bayan_toml_section_name(sec)), sec);
        i = i + 1;
    }
    if (load64(ix) != 0) { free_via(a, load64(ix)); }
    store64(ix, t);
    store64(ix + 8, cap);
    store64(ix + 16, sn - from);
    return 0;
}

# Forget the index: the next header has moved the scope.
fn _toml_dot_reset_a(a, ix): i64 {
    if (load64(ix) != 0) { free_via(a, load64(ix)); }
    store64(ix, 0);
    store64(ix + 8, 0);
    store64(ix + 16, 0);
    return 0;
}

# The section named `name` among sections[from..), or 0 if absent; -1 when the
# index's allocation is refused.
fn _toml_dot_find_a(a, ix, sections, from, name): i64 {
    if (load64(ix) == 0) {
        if (vec_len(sections) - from <= _TOML_DOT_WALK) { return _toml_section_find(sections, from, name); }
        if (_toml_dot_build_a(a, ix, sections, from, _TOML_DOT_WALK * 8) < 0) { return 0 - 1; }
    }
    var slots = load64(ix);
    var mask = load64(ix + 8) - 1;
    var h = _toml_name_hash(name);
    var i = h & mask;
    while (load64(slots + i * 16 + 8) != 0) {
        var sec = load64(slots + i * 16 + 8);
        if (load64(slots + i * 16) == h) {
            if (str_eq(bayan_toml_section_name(sec), name) == 1) { return sec; }
        }
        i = (i + 1) & mask;
    }
    return 0;
}

# Add the section just pushed at the end of sections[from..) to the index, if
# there is one, doubling it at half full. 0, or -1 when refused.
fn _toml_dot_add_a(a, ix, sections, from): i64 {
    if (load64(ix) == 0) { return 0; }
    var cap = load64(ix + 8);
    var n = load64(ix + 16);
    if ((n + 1) * 2 > cap) { return _toml_dot_build_a(a, ix, sections, from, cap * 2); }
    var sec = vec_get(sections, vec_len(sections) - 1);
    _toml_dot_put(load64(ix), cap - 1, _toml_name_hash(bayan_toml_section_name(sec)), sec);
    store64(ix + 16, n + 1);
    return 0;
}

# Parse a TOML file into a vec of sections.
# Each section has a name and a pairs vec; the ROOT table is always
# sections[0], named "".
#
# 1.5.4 changed the shape of this result in three ways, all of them fixing
# something that was silently wrong:
#
#   * THE ROOT SECTION IS ALWAYS PRESENT, even with no pairs. It used to be
#     emitted only if it had some, so a file beginning with `[a]` made
#     sections[0] the section `a` — and every consumer reading sections[0] as
#     "the root pairs" got `a`'s instead, with no way to tell.
#   * AN EMPTY TABLE IS EMITTED. `[a]` with nothing under it used to vanish,
#     which shifted the index of every later `[[array-of-table]]` entry: three
#     `[[s]]` blocks with an empty middle one returned two sections, so `s[1]`
#     was the third record.
#   * A DOTTED KEY NAMES A TABLE. `a.b.c = 1` now lands in section `a.b` as
#     key `c`, which is what `[a.b]` + `c = 1` has always produced — the two
#     spellings finally agree. Inside `[t]`, `a.b = 1` lands in `t.a`.
#
# All three change vec_len(sections) and can move indices, in the direction
# that makes them correct. See the CHANGELOG for 1.5.4.
#
# Returns 0 when the allocator refuses a key or a value (1.5.11). A refused
# escaped string used to come back as an EMPTY value and the parse reported
# success. bayan_toml_parse_file passes the 0 on; bayan_toml_parse_file_r
# reports it as Err(TomlIoErr). toml_parse is an alias of this function.
#
# 1.5.13: so does EVERY other refusal — the sections and pairs vecs, a
# section, a pair, a push, a joined table name. They went through the default
# wrappers, which end the process on a refused push or join, and a refused vec
# or section was used at address 0 (SIGSEGV).
fn bayan_toml_parse(src): i64 {
    var a = default_alloc();
    var sections = vec_new_a(a);
    if (sections == 0) { return 0; }
    var data = str_data(src);
    var slen = str_len(src);
    var pos = 0;

    var cur = _toml_section_push_a(a, sections, str_from_a(a, ""));
    if (cur == 0) { return 0; }
    # Dotted sub-tables of the current header live at index >= scope, indexed
    # by name in `ix` once there are more than _TOML_DOT_WALK of them.
    var scope = 1;
    # A local array starts as whatever the stack held, so it is zeroed here, not
    # reset: a reset frees a non-0 slots word, and that was a free of stack
    # garbage under any allocator that frees. CHANGELOG [1.11.1]
    var ix: i64[3];
    memset(&ix, 0, 24);

    while (pos < slen) {
        var c = load8(data + pos);

        # Skip blank lines and whitespace
        if (c == 10 || c == 13) { pos = pos + 1; }
        elif (c == 32 || c == 9) { pos = pos + 1; }

        # Comment line
        elif (c == 35) {
            while (pos < slen && load8(data + pos) != 10) { pos = pos + 1; }
        }

        # Array of tables: [[name]]
        elif (c == 91 && pos + 1 < slen && load8(data + pos + 1) == 91) {
            pos = pos + 2;
            var aparts = vec_new_a(a);
            if (aparts == 0) { return 0; }
            var ap = _toml_scan_key_a(a, data, pos, slen, aparts);
            if (ap == 0 - 2) { return 0; }
            if (ap > 0) { pos = ap; }
            cur = _toml_section_push_a(a, sections, _toml_join_parts_a(a, aparts, 0, vec_len(aparts)));
            if (cur == 0) { return 0; }
            scope = vec_len(sections);
            _toml_dot_reset_a(a, &ix);
            # Skip to end of line (past `]]` and any trailing comment).
            while (pos < slen && load8(data + pos) != 10) { pos = pos + 1; }
        }

        # Table header: [section]  (single bracket — v6.0.62). The [[name]]
        # array-of-tables case is checked above, so a bare `[` reaches here
        # only as a single-bracket table header.
        elif (c == 91) {
            pos = pos + 1;
            var hparts = vec_new_a(a);
            if (hparts == 0) { return 0; }
            var hp = _toml_scan_key_a(a, data, pos, slen, hparts);
            if (hp == 0 - 2) { return 0; }
            if (hp > 0) { pos = hp; }
            cur = _toml_section_push_a(a, sections, _toml_join_parts_a(a, hparts, 0, vec_len(hparts)));
            if (cur == 0) { return 0; }
            scope = vec_len(sections);
            _toml_dot_reset_a(a, &ix);
            while (pos < slen && load8(data + pos) != 10) { pos = pos + 1; }
        }

        # Key = value
        else {
            var kparts = vec_new_a(a);
            if (kparts == 0) { return 0; }
            var kend = _toml_scan_key_a(a, data, pos, slen, kparts);
            if (kend == 0 - 2) { return 0; }
            if (kend < 0) {
                # No key here at all — a line beginning with `=` or `]`. It
                # used to push a phantom pair with a ZERO-LENGTH key that every
                # later lookup had to walk past.
                while (pos < slen && load8(data + pos) != 10) { pos = pos + 1; }
            } else {
                pos = _toml_skip_ws(data, kend, slen);
                if (pos < slen && load8(data + pos) == 61) {
                    pos = pos + 1;
                    pos = _toml_skip_ws(data, pos, slen);

                    # Parse the value, recording WHICH FORM produced it (1.5.4).
                    # The kind is the parser's own answer, so bayan_toml_pair_is_array
                    # cannot be fooled by a string whose content starts with `[`.
                    var vk[8];
                    var vp[8];
                    var value = _toml_parse_value_a(a, data, pos, slen, &vk, &vp);
                    if (value == 0) { return 0; }
                    var vkind = load64(&vk);
                    pos = load64(&vp);

                    # Route the pair. A dotted key names a table (1.5.4), which
                    # is created on first use if no header declared it.
                    var target = cur;
                    var nparts = vec_len(kparts);
                    if (nparts > 1) {
                        var suffix = _toml_join_parts_a(a, kparts, 0, nparts - 1);
                        if (suffix == 0) { return 0; }
                        var full = suffix;
                        if (str_len(bayan_toml_section_name(cur)) > 0) {
                            var jb = str_builder_new_a(a);
                            if (jb == 0) { return 0; }
                            if (str_builder_add_a(a, jb, bayan_toml_section_name(cur)) < 0) { return 0; }
                            if (str_builder_add_cstr_a(a, jb, ".") < 0) { return 0; }
                            if (str_builder_add_a(a, jb, suffix) < 0) { return 0; }
                            full = str_builder_build_a(a, jb);
                            if (full == 0) { return 0; }
                        }
                        target = _toml_dot_find_a(a, &ix, sections, scope, full);
                        if (target < 0) { return 0; }
                        if (target == 0) {
                            target = _toml_section_push_a(a, sections, full);
                            if (target == 0) { return 0; }
                            if (_toml_dot_add_a(a, &ix, sections, scope) < 0) { return 0; }
                        }
                    }
                    var pr = bayan_toml_pair_new_kind_a(a, vec_get(kparts, nparts - 1), value, vkind);
                    if (pr == 0) { return 0; }
                    if (vec_push_a(a, bayan_toml_section_pairs(target), pr) < 0) { return 0; }
                }
                # Skip to end of line
                while (pos < slen && load8(data + pos) != 10) { pos = pos + 1; }
            }
        }
    }
    # The index is the parse's scratch: the last header's goes back too, not
    # only those a later header dropped. CHANGELOG [1.11.1]
    _toml_dot_reset_a(a, &ix);
    return sections;
}

# Parse a TOML file from disk. NO SIZE CAP — the 256 KiB one was removed in
# 1.5.1 and the stale "Reads up to 256KB" line survived above the very block
# that explains its removal until 1.5.3. It was the first line a caller read.
# v5.11.61: heap-alloc the read buffer instead of declaring it on-fn-scope.
# The previous `var buf[262144]` landed 256 KB in every consumer's `.bss`
# regardless of whether this fn was ever called (DCE drops the fn body but
# the static survives). Mirrors `bayan_toml_parse_file_r` (v5.8.30, already
# heap-allocs). See CHANGELOG [5.11.61].
# Read a whole file into a Str, however large. 0 on open failure.
#
# The fixed 256 KiB buffer this replaces truncated silently and reported
# SUCCESS: a 300 KB / 15,000-key manifest parsed to 13,107 pairs with
# is_err_result() == 0 — 1,893 keys gone, and the cut landing mid-line so the
# boundary pair was a fragment. A str_builder grows; there is no cap left.
fn _toml_slurp(path): Str {
    var fd = file_open(path, 0, 0);
    if (fd < 0) { return 0; }
    var sb = str_builder_new();
    var chunk = alloc(65536);
    if (chunk == 0) { file_close(fd); return 0; }
    var err = 0;
    loop {
        var n = file_read(fd, chunk, 65536);
        # 1.5.3: `n <= 0` folded a mid-file read ERROR into clean EOF, so a
        # truncated read was reported as SUCCESS with a short document — the
        # same silent-truncation-reported-as-success shape the fixed 256 KiB
        # buffer had, arriving by a different route. file_read is a passthrough
        # for the raw syscall, so a negative return is an errno.
        if (n < 0) { err = 1; break; }
        elif (n == 0) { break; }
        else { str_builder_add(sb, str_new(chunk, n)); }
    }
    file_close(fd);
    if (err == 1) { return 0; }
    return str_builder_build(sb);
}

fn bayan_toml_parse_file(path): i64 {
    var src = _toml_slurp(path);
    if (src == 0) { return vec_new(); }
    if (str_len(src) == 0) { return vec_new(); }
    return bayan_toml_parse(src);
}

# v5.8.30 — Result variant of bayan_toml_parse_file. Surfaces underlying
# I/O errors as Err(TomlIoErr) instead of silently converting to an
# empty vec (the back-compat behavior of `bayan_toml_parse_file`).
# A refused allocation — the read chunk, or a key or value the parse could not
# decode (1.5.11) — is also Err(TomlIoErr): the document was not loaded.
fn bayan_toml_parse_file_r(path) : Result {
    var fd_r_tag, fd_r = file_open_r(path, 0, 0);
    if (is_err_result(fd_r_tag) == 1) { return Err(TomlIoErr); }
    var fd = fd_r;
    var sb = str_builder_new();
    var chunk = alloc(65536);
    if (chunk == 0) { sys_close(fd); return Err(TomlIoErr); }
    var total = 0;
    loop {
        var rd_r_tag, rd_r = file_read_r(fd, chunk, 65536);
        if (is_err_result(rd_r_tag) == 1) { sys_close(fd); return Err(TomlIoErr); }
        var n = rd_r;
        if (n <= 0) { break; }
        else {
            str_builder_add(sb, str_new(chunk, n));
            total = total + n;
        }
    }
    sys_close(fd);
    # 1.5.3: an EMPTY file is a legal TOML document with no pairs. Reporting it
    # as Err(TomlIoErr) made it indistinguishable from a file that does not
    # exist or cannot be read — the exact distinction this Result variant was
    # added to draw. A caller that wants to reject an empty config can check
    # vec_len; a caller that cannot tell "absent" from "empty" has no recourse.
    if (total == 0) { return Ok(vec_new()); }
    # A refused allocation is an Err, like the refused chunk above — never Ok(0),
    # which a caller matching Ok would hand to vec_len (1.5.11).
    var src = str_builder_build(sb);
    if (src == 0) { return Err(TomlIoErr); }
    var doc = bayan_toml_parse(src);
    if (doc == 0) { return Err(TomlIoErr); }
    return Ok(doc);
}

# --- Lookups: the key type named (1.11.0) -----------------------------------
#
# Until 1.11.0 these took a C string without saying so, and bayan_json_get took a Str: each
# answered the other's key type with a silent "not found" (Known gap 7, ADR 0014). Each lookup now
# comes in two, named for its key, as bayan_json_v_obj_get_by_cstr / _by_str have since 1.5.10:
#   _by_cstr  a C string or a literal. `key: cstring` makes cyrius warn at a call that passes a Str
#             (a named local, a global, a call's result: measured on 6.7.16);
#   _by_str   a Str, compared by its length, so a Str that is not NUL-terminated (a str_sub, a
#             str_split part) is read correctly.
# The bare names are deprecated forwarders to _by_cstr with the same answers. Every form returns
# 0 (an empty vec for the sections lookup) for a null pairs or key, where the bare names faulted.
#
# LAST WINS (1.5.4). The value lookups returned the FIRST match until 1.5.4, which no other TOML
# implementation does: tomllib, toml-rs, go-toml and tomlkit all either error on a duplicate or
# take the last, and an editing tool that appends a corrected line assumes the last. The direction
# matters — with first-wins,
#     secure = true
#     secure = false
# returned `true` for a file whose last word is `false`, which is the wrong way round for a
# security-relevant override.

# True if the Str k equals key: a Str when isstr is 1, a C string when it is 0.
fn _toml_key_eq(k, key, isstr): i64 {
    if (isstr == 1) { return str_eq(k, key); }
    return str_eq_cstr(k, key);
}

# The LAST pair of `pairs` whose key is `key`, or 0.
fn _toml_find_pair(pairs, key, isstr): i64 {
    if (pairs == 0 || key == 0) { return 0; }
    var gi = 0;
    var glen = vec_len(pairs);
    var gp = 0;
    while (gi < glen) {
        var q = vec_get(pairs, gi);
        if (_toml_key_eq(bayan_toml_pair_key(q), key, isstr) == 1) { gp = q; }
        gi = gi + 1;
    }
    return gp;
}

# The value Str of the last pair named `key`, or 0.
fn _toml_find_value(pairs, key, isstr): i64 {
    var p = _toml_find_pair(pairs, key, isstr);
    if (p == 0) { return 0; }
    return bayan_toml_pair_value(p);
}

# How many pairs of `pairs` are named `key`.
fn _toml_find_count(pairs, key, isstr): i64 {
    if (pairs == 0 || key == 0) { return 0; }
    var ci = 0;
    var clen = vec_len(pairs);
    var n = 0;
    while (ci < clen) {
        if (_toml_key_eq(bayan_toml_pair_key(vec_get(pairs, ci)), key, isstr) == 1) { n = n + 1; }
        ci = ci + 1;
    }
    return n;
}

# A new vec of every section named `name`, in document order (empty when none is).
fn _toml_find_sections(sections, name, isstr): i64 {
    var result = vec_new();
    if (sections == 0 || name == 0) { return result; }
    var i = 0;
    var len = vec_len(sections);
    while (i < len) {
        var s = vec_get(sections, i);
        if (_toml_key_eq(bayan_toml_section_name(s), name, isstr) == 1) {
            vec_push(result, s);
        }
        i = i + 1;
    }
    return result;
}

# The value for `key` in a pairs vec: a Str, or 0 if the key is absent. Last occurrence wins.
fn bayan_toml_get_by_cstr(pairs, key: cstring): i64 { return _toml_find_value(pairs, key, 0); }

# bayan_toml_get_by_cstr's twin for a Str key.
fn bayan_toml_get_by_str(pairs, key: Str): i64 { return _toml_find_value(pairs, key, 1); }

# The pre-1.11.0 name. Forwards to _by_cstr; same answers.
#
# DEPRECATED (1.11.0): use bayan_toml_get_by_cstr (C-string key) or bayan_toml_get_by_str (Str key).
#deprecated("use bayan_toml_get_by_cstr (C-string/literal key) or bayan_toml_get_by_str (Str key)")
fn bayan_toml_get(pairs, key: cstring): i64 { return bayan_toml_get_by_cstr(pairs, key); }

# 1.5.4 — The PAIR for `key`, not just its value, so a caller can reach the value kind
# (bayan_toml_pair_is_array and friends). Last occurrence wins. 0 if the key is absent.
fn bayan_toml_get_pair_by_cstr(pairs, key: cstring): i64 { return _toml_find_pair(pairs, key, 0); }

# bayan_toml_get_pair_by_cstr's twin for a Str key.
fn bayan_toml_get_pair_by_str(pairs, key: Str): i64 { return _toml_find_pair(pairs, key, 1); }

# The pre-1.11.0 name. Forwards to _by_cstr; same answers.
#
# DEPRECATED (1.11.0): use bayan_toml_get_pair_by_cstr (C-string key) or bayan_toml_get_pair_by_str (Str key).
#deprecated("use bayan_toml_get_pair_by_cstr (C-string/literal key) or bayan_toml_get_pair_by_str (Str key)")
fn bayan_toml_get_pair(pairs, key: cstring): i64 { return bayan_toml_get_pair_by_cstr(pairs, key); }

# 1.5.4 — How many times `key` appears in `pairs`. The spec makes a duplicate key an ERROR, and the
# flat parser has no error channel; this lets a caller that cares reject the document itself.
# (bayan_toml_v_parse refuses a duplicate, as tomllib does.)
fn bayan_toml_count_by_cstr(pairs, key: cstring): i64 { return _toml_find_count(pairs, key, 0); }

# bayan_toml_count_by_cstr's twin for a Str key.
fn bayan_toml_count_by_str(pairs, key: Str): i64 { return _toml_find_count(pairs, key, 1); }

# The pre-1.11.0 name. Forwards to _by_cstr; same answers.
#
# DEPRECATED (1.11.0): use bayan_toml_count_by_cstr (C-string key) or bayan_toml_count_by_str (Str key).
#deprecated("use bayan_toml_count_by_cstr (C-string/literal key) or bayan_toml_count_by_str (Str key)")
fn bayan_toml_count(pairs, key: cstring): i64 { return bayan_toml_count_by_cstr(pairs, key); }

# Every section named `name` (for [[entries]] etc.), as a new vec in document order. Until 1.11.0
# the name was a C string the function's name did not state, and a Str got a silent EMPTY vec.
fn bayan_toml_get_sections_by_cstr(sections, name: cstring): i64 { return _toml_find_sections(sections, name, 0); }

# bayan_toml_get_sections_by_cstr's twin for a Str name.
fn bayan_toml_get_sections_by_str(sections, name: Str): i64 { return _toml_find_sections(sections, name, 1); }

# The pre-1.11.0 name. Forwards to _by_cstr; same answers.
#
# DEPRECATED (1.11.0): use bayan_toml_get_sections_by_cstr (C-string name) or bayan_toml_get_sections_by_str (Str name).
#deprecated("use bayan_toml_get_sections_by_cstr (C-string/literal key) or bayan_toml_get_sections_by_str (Str key)")
fn bayan_toml_get_sections(sections, name: cstring): i64 { return bayan_toml_get_sections_by_cstr(sections, name); }

# --- Array VALUE element access (v1.1.0) ---
#
# `bayan_toml_parse` stores an array value `key = [a, b, c]` VERBATIM as one
# Str (brackets included, spanning newlines/comments). These helpers decompose
# that raw value into its TOP-LEVEL elements so callers don't hand-roll a
# comma splitter. The result is a plain vec — iterate with `vec_len`/`vec_get`.
#
# Element semantics:
#   * surrounding whitespace / newlines are trimmed;
#   * a single layer of matching quotes (`"` basic or `'` literal) is stripped;
#     a `"` (basic) body has its escapes DECODED as of 1.5.3, matching the
#     scalar string parser, while a `'` (literal) body stays verbatim;
#   * a nested array element `[...]` is returned WHOLE, so it can be re-parsed
#     recursively with `bayan_toml_array_parse`;
#   * a trailing comma yields no empty element;
#   * `#` comments (leading full-line or trailing inline, outside strings) are
#     skipped.
# Element Strs SHARE the value's buffer (no copy), like the rest of the parser
# — they stay valid as long as the parsed source does. The one exception is a
# basic-string element that actually contains a backslash: decoding needs a
# destination, so that element (and only that one) is a fresh copy, which
# outlives the source rather than aliasing it.
#
# Known limit (documented, not a bug): a multi-line (triple-quoted) string as
# an array element is not specially unwrapped.

# Skip spaces, tabs, newlines and carriage returns. Returns new position.
fn _toml_arr_skip_ws(buf, pos, end): i64 {
    while (pos < end) {
        var c = load8(buf + pos);
        if (c != 32 && c != 9 && c != 10 && c != 13) { return pos; }
        pos = pos + 1;
    }
    return pos;
}

# Trim [start,end) of surrounding whitespace and comments, strip one layer of
# matching quotes if present, and push the resulting element Str (sharing
# `buf`) onto `out` via allocator `a`. Empty/blank spans are skipped (no push).
# Returns 0, or -1 when the allocator refused the element Str or the push
# (1.5.9: both were ignored, so a refusal silently dropped the element).
fn _toml_arr_flush_a(a, out, buf, start, end): i64 {
    # Skip leading whitespace and any full-line `#` comments.
    var s = start;
    var scanning = 1;
    while (scanning == 1) {
        while (s < end) {
            var wc = load8(buf + s);
            if (wc != 32 && wc != 9 && wc != 10 && wc != 13) { break; }
            s = s + 1;
        }
        if (s < end && load8(buf + s) == 35) {
            while (s < end && load8(buf + s) != 10) { s = s + 1; }
        } else { scanning = 0; }
    }
    if (s >= end) { return 0; }
    # Walk to content end: honor quote state, stop at an unquoted `#`, and track
    # the position one past the last non-whitespace content byte (`last`).
    var last = s;
    var q = 0;
    var p = s;
    while (p < end) {
        var c = load8(buf + p);
        if (q != 0) {
            # Same escaped-quote rule again (1.5.3). Here it also keeps `last`
            # past the escaped quote, so the element does not lose its tail.
            if (c == 92 && q == 34 && (p + 1) < end) { last = p + 2; p = p + 2; }
            else {
                if (c == q) { q = 0; }
                last = p + 1;
                p = p + 1;
            }
        }
        elif (c == 34 || c == 39) { q = c; last = p + 1; p = p + 1; }
        elif (c == 35) {
            # `#` starts a comment that runs to end-of-line ONLY — skip to the
            # newline and keep scanning (content may resume on the next line, as
            # in a nested `[...]` element spanning lines). `last` is NOT advanced
            # over the comment bytes, so a trailing inline comment is trimmed
            # while a mid-span comment inside a whole-captured nested array is
            # preserved as part of the contiguous slice for recursive re-parse.
            while (p < end && load8(buf + p) != 10) { p = p + 1; }
        }
        elif (c == 32 || c == 9 || c == 10 || c == 13) { p = p + 1; }
        else { last = p + 1; p = p + 1; }
    }
    if (last <= s) { return 0; }
    # An inline-table element keeps its braces — it is decomposed with
    # bayan_toml_inline_parse, not by stripping (1.5.4).
    # Strip one layer of matching quotes. 1.5.3: a `"`-quoted (basic) element
    # additionally has its escapes decoded, so `["a\"b"]` yields `a"b` rather
    # than `a\"b`. A `'`-quoted (literal) element is still verbatim, which is
    # what the spec says — and an element with no backslash stays zero-copy
    # either way, so the shared-buffer property below still holds for it.
    var c0 = load8(buf + s);
    if ((c0 == 34 || c0 == 39) && (last - s) >= 2 && load8(buf + last - 1) == c0) {
        var bn = last - s - 2;
        if (c0 == 34) {
            if (_toml_has_bs(buf + s + 1, bn) == 1) {
                # 0 is a refusal of either of the unescape's allocations (1.5.11; the
                # first one used to come back as an empty Str, which this test had to
                # recognise by its length).
                var ue = _toml_unescape_span_a(a, buf + s + 1, bn, 0);
                if (ue == 0) { return 0 - 1; }
                return _toml_arr_push_a(a, out, ue);
            }
        }
        return _toml_arr_push_a(a, out, str_new_a(a, buf + s + 1, bn));
    }
    return _toml_arr_push_a(a, out, str_new_a(a, buf + s, last - s));
}

# Push one element Str made by the caller: -1 if the Str was refused (0) or the
# push was, else 0.
fn _toml_arr_push_a(a, out, el): i64 {
    if (el == 0) { return 0 - 1; }
    if (vec_push_a(a, out, el) < 0) { return 0 - 1; }
    return 0;
}

# v1.1.0 — Allocator-as-first-arg variant of bayan_toml_array_parse. Parses an
# array VALUE Str into a vec (allocated via `a`) of top-level element Strs.
# A non-array value (no leading `[` after whitespace) yields an EMPTY vec.
# Returns 0 when `a` refuses any allocation (1.5.9: the vec itself was used
# unchecked, and a refused element was dropped, so a short vec came back as
# success) — never a partial result.
fn bayan_toml_array_parse_a(a, value): i64 {
    var out = vec_new_a(a);
    if (out == 0) { return 0; }
    if (value == 0) { return out; }
    var buf = str_data(value);
    var n = str_len(value);
    var pos = _toml_arr_skip_ws(buf, 0, n);
    if (pos >= n || load8(buf + pos) != 91) { return out; }
    pos = pos + 1;                 # past the opening '['
    var estart = pos;              # start of the current element span
    var depth = 1;
    var bdepth = 0;                # brace depth — inline tables (1.5.4)
    var q = 0;                     # 0 = outside a string; else opening quote char
    while (pos < n && depth > 0) {
        var c = load8(buf + pos);
        if (q != 0) {
            # Same escaped-quote rule as the capture loop above (1.5.3) — the
            # two must agree or the splitter re-derives different element
            # boundaries from the value the capture produced.
            if (c == 92 && q == 34 && (pos + 1) < n) { pos = pos + 2; }
            else {
                if (c == q) { q = 0; }
                pos = pos + 1;
            }
        }
        elif (c == 34 || c == 39) { q = c; pos = pos + 1; }
        elif (c == 35) {
            while (pos < n && load8(buf + pos) != 10) { pos = pos + 1; }
        }
        elif (c == 91) { depth = depth + 1; pos = pos + 1; }
        elif (c == 123) { bdepth = bdepth + 1; pos = pos + 1; }
        elif (c == 125) {
            if (bdepth > 0) { bdepth = bdepth - 1; }
            pos = pos + 1;
        }
        elif (c == 93) {
            depth = depth - 1;
            if (depth == 0) {
                if (_toml_arr_flush_a(a, out, buf, estart, pos) < 0) { return 0; }
                return out;
            }
            pos = pos + 1;
        }
        # A comma only ends an element OUTSIDE any inline table (1.5.4). Brace
        # depth was not tracked before, so `[ {x=1,y=2}, {x=3,y=4} ]` split on
        # every comma and returned FOUR syntactic fragments — `{ x = 1`,
        # `y = 2 }`, … — that look structured and are not.
        elif (c == 44 && depth == 1 && bdepth == 0) {
            if (_toml_arr_flush_a(a, out, buf, estart, pos) < 0) { return 0; }
            pos = pos + 1;
            estart = pos;
        }
        else { pos = pos + 1; }
    }
    # Unterminated array (no closing ']'): flush whatever content remains.
    if (_toml_arr_flush_a(a, out, buf, estart, n) < 0) { return 0; }
    return out;
}

# Parse an array VALUE Str into a vec of top-level element Strs. v1.1.0 wrapper.
fn bayan_toml_array_parse(value): i64 {
    return bayan_toml_array_parse_a(default_alloc(), value);
}

# 1 if `value`'s first non-whitespace byte is `[`, else 0.
#
# ⚠ THIS IS A BYTE HEURISTIC, NOT A TYPE TEST. It inspects the stored value,
# by which point the quotes are gone — so a STRING whose content starts with
# `[` is indistinguishable from an array. `k = "[a]"` has always classified
# as an array, and as of 1.5.3 `k = '[a]'` does too, because the new literal
# string branch correctly strips the quotes that used to hide it. The case
# that actually hits this is a format template: `format = '[ $host ]($style)'`
# returned 0 before 1.5.3 and returns 1 now.
#
# Fixing it properly means recording the value's kind on the pair, which
# changes the struct every consumer reads — filed with the other structural
# gaps in docs/development/issues/archived/2026-08-28-toml-structural-subset-gaps.md.
fn bayan_toml_is_array(value): bool {
    if (value == 0) { return false; }
    var buf = str_data(value);
    var n = str_len(value);
    var pos = _toml_arr_skip_ws(buf, 0, n);
    if (pos < n && load8(buf + pos) == 91) { return true; }
    return false;
}

# --- Inline tables (1.5.4) --------------------------------------------------
#
# `k = { a = 1, b = "x" }` was captured verbatim with no way to decompose it,
# and it was not listed as a subset limit anywhere a caller reads — so a
# consumer needing one had to hand-roll a splitter, which is the outcome bayan
# exists to prevent.
#
# Element semantics match bayan_toml_parse exactly, because they ARE
# bayan_toml_parse's: keys go through the same _toml_scan_key and values
# through the same _toml_parse_value_a, so an escape, a quoted key or a nested
# array decodes identically inside an inline table and outside one. A dotted
# key inside an inline table is joined into a single dotted key rather than
# creating a sub-table — an inline table has no section to hang one on.
#
# Returns a vec of PAIRS (bayan_toml_pair_key / _value / _kind), not a vec of
# sections. A non-inline value yields an EMPTY vec, mirroring
# bayan_toml_array_parse's behaviour on a non-array. Returns 0 when the
# allocator refuses a key or a value (1.5.11: a refused escaped value came back
# as an empty string in a vec reported as success), and on every other refusal
# — the result vec, a key-parts vec, a joined key, a pair, a push (1.5.13: each
# was used unchecked, so a refused vec was loaded through at address 0).

# 1.5.4 — Allocator-as-first-arg variant of bayan_toml_inline_parse.
fn bayan_toml_inline_parse_a(a, value): i64 {
    var out = vec_new_a(a);
    if (out == 0) { return 0; }
    if (value == 0) { return out; }
    var buf = str_data(value);
    var n = str_len(value);
    var pos = _toml_arr_skip_ws(buf, 0, n);
    if (pos >= n) { return out; }
    if (load8(buf + pos) != 123) { return out; }
    pos = pos + 1;
    loop {
        pos = _toml_arr_skip_ws(buf, pos, n);
        if (pos >= n) { break; }
        elif (load8(buf + pos) == 125) { break; }
        elif (load8(buf + pos) == 44) { pos = pos + 1; }
        elif (load8(buf + pos) == 35) {
            while (pos < n && load8(buf + pos) != 10) { pos = pos + 1; }
        }
        else {
            var kp = vec_new_a(a);
            if (kp == 0) { return 0; }
            var kend = _toml_scan_key_a(a, buf, pos, n, kp);
            if (kend == 0 - 2) { return 0; }
            if (kend < 0) { break; }
            else {
                pos = _toml_skip_ws(buf, kend, n);
                if (pos < n && load8(buf + pos) == 61) {
                    pos = _toml_skip_ws(buf, pos + 1, n);
                    var ik[8];
                    var ip[8];
                    var iv = _toml_parse_value_a(a, buf, pos, n, &ik, &ip);
                    if (iv == 0) { return 0; }
                    pos = load64(&ip);
                    var ikey = _toml_join_parts_a(a, kp, 0, vec_len(kp));
                    if (ikey == 0) { return 0; }
                    var ipr = bayan_toml_pair_new_kind_a(a, ikey, iv, load64(&ik));
                    if (ipr == 0) { return 0; }
                    if (vec_push_a(a, out, ipr) < 0) { return 0; }
                } else {
                    # A key with no `=`. Stop rather than spin: the cursor has
                    # not moved past anything consumable.
                    break;
                }
            }
        }
    }
    return out;
}

# 1.5.4 — Decompose an inline-table VALUE `{ ... }` into a vec of pairs.
# See the block above. Wrapper over the allocator-threaded form.
# Returns 0 when the allocator refuses a key or a value (1.5.11).
fn bayan_toml_inline_parse(value): i64 {
    return bayan_toml_inline_parse_a(default_alloc(), value);
}

# 1.5.4 — true if `value`'s first non-whitespace byte is `{`.
#
# Like bayan_toml_is_array this is a byte heuristic and can be fooled by a
# STRING whose content starts with `{`. Prefer bayan_toml_pair_is_inline, which
# reads the kind the parser recorded and cannot be.
fn bayan_toml_is_inline(value): bool {
    if (value == 0) { return false; }
    var buf = str_data(value);
    var n = str_len(value);
    var pos = _toml_arr_skip_ws(buf, 0, n);
    if (pos < n && load8(buf + pos) == 123) { return true; }
    return false;
}

# 1.5.4 — Look up `key` and decompose its value as an inline table.
# 0 if the key is absent (or an allocation was refused, 1.5.11); otherwise a (possibly empty) vec
# of pairs. 1.11.0: _by_cstr and _by_str, as bayan_toml_get_by_* above.
fn bayan_toml_get_inline_by_cstr(pairs, key: cstring): i64 {
    var v = bayan_toml_get_by_cstr(pairs, key);
    if (v == 0) { return 0; }
    return bayan_toml_inline_parse(v);
}

# bayan_toml_get_inline_by_cstr's twin for a Str key.
fn bayan_toml_get_inline_by_str(pairs, key: Str): i64 {
    var v = bayan_toml_get_by_str(pairs, key);
    if (v == 0) { return 0; }
    return bayan_toml_inline_parse(v);
}

# The pre-1.11.0 name. Forwards to _by_cstr; same answers.
#
# DEPRECATED (1.11.0): use bayan_toml_get_inline_by_cstr (C-string key) or bayan_toml_get_inline_by_str (Str key).
#deprecated("use bayan_toml_get_inline_by_cstr (C-string/literal key) or bayan_toml_get_inline_by_str (Str key)")
fn bayan_toml_get_inline(pairs, key: cstring): i64 { return bayan_toml_get_inline_by_cstr(pairs, key); }

# Convenience: look up `key` in a pairs vec and parse its value as an array. Returns 0 if the key
# is absent; otherwise a (possibly empty) vec of element Strs. 1.11.0: _by_cstr and _by_str. (The
# bare name's key was a C string the name did not state: 1.5.1 corrected the same wrong claim on
# bayan_toml_get and missed the copy of it here.)
fn bayan_toml_get_array_by_cstr(pairs, key: cstring): i64 {
    var v = bayan_toml_get_by_cstr(pairs, key);
    if (v == 0) { return 0; }
    return bayan_toml_array_parse(v);
}

# bayan_toml_get_array_by_cstr's twin for a Str key.
fn bayan_toml_get_array_by_str(pairs, key: Str): i64 {
    var v = bayan_toml_get_by_str(pairs, key);
    if (v == 0) { return 0; }
    return bayan_toml_array_parse(v);
}

# The pre-1.11.0 name. Forwards to _by_cstr; same answers.
#
# DEPRECATED (1.11.0): use bayan_toml_get_array_by_cstr (C-string key) or bayan_toml_get_array_by_str (Str key).
#deprecated("use bayan_toml_get_array_by_cstr (C-string/literal key) or bayan_toml_get_array_by_str (Str key)")
fn bayan_toml_get_array(pairs, key: cstring): i64 { return bayan_toml_get_array_by_cstr(pairs, key); }

# --- cyml.cyr ---

# cyml.cyr — CYML parser (TOML header + markdown body)
# Usage: include "lib/bayan.cyr" (full bundle) or "lib/bayan-cyml.cyr" (sublib).
#        `lib/cyml.cyr` was the pre-carve stdlib module and no longer ships —
#        this content moved into bayan at 1.0.0 / cyrius 6.1.25.
# Requires: string.cyr, alloc.cyr
#
# CYML is TOML above `---`, markdown below.
# Single-entry: one header, one body.
# Multi-entry: file-level TOML, then [[entries]] with per-entry header+body.
# Parser returns zero-copy pointers into the input buffer.
#
# LINES (1.7.0). A marker is a line that is exactly `[[entries]]`, and a
# delimiter a line that is exactly `---`. Each begins the input or follows a
# `\n`, and ends at a `\n` or at the end of the input; a delimiter may also
# end at the end of its entry, where the next marker's line begins. Two marker
# lines in a row are two entries, the first one empty. Until 1.7.0 a marker
# right after a marker, a `---` after a blank first line or right after its
# marker or right before the next one, and either line as the last line with
# no newline after it, were all read as text (CHANGELOG [1.7.0]). A `\r` does
# not end a line on its own: CRLF does (1.8.0), a lone CR before the end of
# the input or region does, and a CR anywhere else is text. Until 1.8.0 a CR
# ended nothing, so `[[entries]]\r\n` and `---\r\n` were text, and a file
# saved with CRLF line endings parsed to no entries and one block of header.

# v5.8.30 — Result-returning *_r variant for the file-loading
# parser (`bayan_cyml_parse_file_r`). Bare `bayan_cyml_parse(data, len)` keeps
# its current shape — it cannot fail on any INPUT (any byte string yields a
# doc with entry_count >= 0), so no Result variant was added.
#
# That claim is about input, not about memory: bayan_cyml_parse returns 0 when
# an allocation is refused (1.6.1; until then it faulted, as this note said
# from 1.5.3), and bayan_cyml_parse_file_r turns that 0 into an Err.

# v5.8.30 — CymlError variants. Same shape as Json/TomlError:
# `CymlIoErr` for any IoError raised while reading the source
# file; `CymlOther` is the catch-all. Variant-name prefix `Cyml`
# to keep these out of the `Io*` / `Json*` / `Toml*` namespace.
enum CymlError {
    CymlIoErr;
    CymlOther;
}

# v5.8.36 — Allocator-as-first-arg variant of bayan_cyml_entry_new.
# Allocates the 32-byte entry header via `a`. Returns 0 on OOM.
fn bayan_cyml_entry_new_a(a, hp, hl, bp, bl): i64 {
    var e = alloc_via(a, 32);
    if (e == 0) { return 0; }
    store64(e, hp);
    store64(e + 8, hl);
    store64(e + 16, bp);
    store64(e + 24, bl);
    return e;
}

# CymlEntry: { header_ptr, header_len, body_ptr, body_len }
# 32 bytes per entry. v5.8.36 wrapper.
fn bayan_cyml_entry_new(hp, hl, bp, bl): i64 {
    return bayan_cyml_entry_new_a(default_alloc(), hp, hl, bp, bl);
}

# Get TOML header pointer from a CymlEntry
fn bayan_cyml_entry_header(e) : i64 { if (e == 0) { return 0; } return load64(e); }
# Get TOML header byte length from a CymlEntry
fn bayan_cyml_entry_header_len(e) : i64 { if (e == 0) { return 0; } return load64(e + 8); }
# Get markdown body pointer from a CymlEntry
fn bayan_cyml_entry_body(e) : i64 { if (e == 0) { return 0; } return load64(e + 16); }
# Get markdown body byte length from a CymlEntry
fn bayan_cyml_entry_body_len(e) : i64 { if (e == 0) { return 0; } return load64(e + 24); }

# v5.8.36 — Allocator-as-first-arg variant of bayan_cyml_doc_new.
# Allocates the 32-byte doc struct via `a`. Returns 0 on OOM.
fn bayan_cyml_doc_new_a(a): i64 {
    var d = alloc_via(a, 32);
    if (d == 0) { return 0; }
    store64(d, 0);
    store64(d + 8, 0);
    store64(d + 16, 0);
    store64(d + 24, 0);
    return d;
}

# CymlDoc: { file_header_ptr, file_header_len, entries_ptr, entry_count }
# 32 bytes. v5.8.36 wrapper.
fn bayan_cyml_doc_new(): i64 {
    return bayan_cyml_doc_new_a(default_alloc());
}

# Get file-level TOML header pointer from a CymlDoc
fn bayan_cyml_doc_header(d) : i64 { if (d == 0) { return 0; } return load64(d); }
# Get file-level TOML header byte length from a CymlDoc
fn bayan_cyml_doc_header_len(d) : i64 { if (d == 0) { return 0; } return load64(d + 8); }
# Get entries array pointer from a CymlDoc
fn bayan_cyml_doc_entries(d) : i64 { if (d == 0) { return 0; } return load64(d + 16); }
# Get number of entries in a CymlDoc
fn bayan_cyml_doc_entry_count(d) : i64 { if (d == 0) { return 0; } return load64(d + 24); }

# Get entry N from a doc (returns CymlEntry pointer)
# BOUNDS (fixed in 1.5.1 — this was an out-of-bounds read). The body was bare
# pointer arithmetic, `load64(load64(d + 16) + n * 8)`, with no check on `d`
# and none on `n`. A negative index read BEFORE the entry array and a large one
# read past it, and because this does raw loads rather than `vec_get` it does
# not abort — it returns whatever those bytes hold as a CymlEntry pointer,
# which the caller then dereferences. Found by writing the module's first test:
# `bayan_cyml_doc_entry(d, 0 - 1)` returned a live-looking pointer.
fn bayan_cyml_doc_entry(d, n): i64 {
    if (d == 0) { return 0; }
    if (n < 0)  { return 0; }
    if (n >= load64(d + 24)) { return 0; }
    var entries = load64(d + 16);
    if (entries == 0) { return 0; }
    return load64(entries + n * 8);
}

# Where the line whose content stops at `pos` ends: the index of its `\n`, or
# len when the content runs to the end of data[0..len). The terminator is
# `\n`, `\r\n` (1.8.0; CR LF ends a line as LF does), or a `\r` just before
# the end. -1 when `pos` is not the end of a line: some other byte follows.
fn _cyml_eol(data, len, pos): i64 {
    if (pos >= len) { return len; }
    var c = load8(data + pos);
    if (c == 10) { return pos; }
    if (c == 13) {
        if (pos + 1 >= len) { return len; }
        if (load8(data + pos + 1) == 10) { return pos + 1; }
    }
    return 0 - 1;
}

# 1 when `---` sits at `at` and ends its line (_cyml_eol): a `\n` or CR LF
# follows, or the end of the searched region (the input, or the entry's end).
# Whether `at` begins a line is the caller's test.
fn _cyml_delim_at(data, len, at): i64 {
    if (at + 3 > len) { return 0; }
    if (load8(data + at)     != 45) { return 0; }   # -
    if (load8(data + at + 1) != 45) { return 0; }   # -
    if (load8(data + at + 2) != 45) { return 0; }   # -
    if (_cyml_eol(data, len, at + 3) < 0) { return 0; }
    return 1;
}

# The start of the first `---` line at or after i, or len if there is none. A
# `---` line begins at byte 0 or after a `\n`, and ends at a `\n` or at the end
# of data[0..len): an entry's search passes the entry's end as `len`, and its
# start (just past its marker's newline) as `i`. The body follows the line's
# newline, or is empty when the line ends the region (_cyml_body_at).
#
# ONE CALL PER DELIMITER, NOT PER BYTE (1.6.1). This replaced
# `_cyml_is_delim(data, len, pos)`, a yes/no test that the single-entry search,
# each entry's search and bayan_cyml_split called at every byte offset: the
# shape 1.6.0 removed from the marker scan (_cyml_next_entries, below). It
# walks to the next newline in a tight loop and runs the compare only there.
#
# A WHOLE LINE, WHEREVER IT IS (1.7.0 — four places missed it). To 1.6.2 the
# test was "\n---\n" (or "---\n" at byte 0), with the whole of it inside the
# region, so a `---` line was not a delimiter when it
#   - followed a blank first line: "\n---\nbody", where byte 0 was tested for
#     the flush form only, and the whole text became the header;
#   - came straight after its entry's marker: "[[entries]]\n---\nA", where the
#     search began past the marker's newline, so the header was `---\nA`;
#   - came just before the next marker, whose newline it shares: the entry's
#     header kept the `---`, and its body was lost;
#   - was the input's last line, with no newline after it.
# 1.5.1 fixed the first shape in the marker scan; the rest are this one rule
# applied at the region's two ends. tests/bayan.tcyr pins each. A scratch
# reference written line by line from the rule agreed with this module on all
# 1,960,742 prefixes of 30,000 random documents (parse and split each), on
# x86_64 and on aarch64.
fn _cyml_next_delim(data, len, i): i64 {
    if (i == 0) {
        if (_cyml_delim_at(data, len, 0) == 1) { return 0; }
    }
    # A newline at p makes p + 1 a line start; walk from i - 1, so that i
    # itself counts when the byte before it is a newline.
    var p = i - 1;
    if (p < 0) { p = 0; }
    while (p < len) {
        if (load8(data + p) == 10) {
            if (_cyml_delim_at(data, len, p + 1) == 1) { return p + 1; }
        }
        p = p + 1;
    }
    return len;
}

# Where the body after the `---` line at q begins, in data[0..len): past the
# line's newline (LF or CR LF), or len when the line ends the region. For
# CR LF, q + 4 would land on the LF instead, which the trim removes, so the
# two agree on every output (a 1.8.0 mutation pass sees q + 4 survive; that is
# not a gap in the tests). The header start after a CRLF marker is the same.
fn _cyml_body_at(data, q, len): i64 {
    var e = _cyml_eol(data, len, q + 3);
    if (e >= len) { return len; }
    return e + 1;
}

# 1 when the marker line `[[entries]]` starts at `at`: the 11 bytes, then the
# end of the line (_cyml_eol: `\n`, CR LF from 1.8.0, or the end of the
# input). The end of the input counts from 1.7.0: a file's last line need not
# end in a newline, and `x\n[[entries]]` used to be a single entry whose body
# held the marker as text.
fn _cyml_marker_at(data, len, at): i64 {
    if (at + 11 > len) { return 0; }
    if (load8(data + at)      != 91)  { return 0; }   # [
    if (load8(data + at + 1)  != 91)  { return 0; }   # [
    if (load8(data + at + 2)  != 101) { return 0; }   # e
    if (load8(data + at + 3)  != 110) { return 0; }   # n
    if (load8(data + at + 4)  != 116) { return 0; }   # t
    if (load8(data + at + 5)  != 114) { return 0; }   # r
    if (load8(data + at + 6)  != 105) { return 0; }   # i
    if (load8(data + at + 7)  != 101) { return 0; }   # e
    if (load8(data + at + 8)  != 115) { return 0; }   # s
    if (load8(data + at + 9)  != 93)  { return 0; }   # ]
    if (load8(data + at + 10) != 93)  { return 0; }   # ]
    if (_cyml_eol(data, len, at + 11) < 0) { return 0; }
    return 1;
}

# The first marker position p >= i, or len if there is none. A marker
# position is 0 for a marker line flush against the start of the document,
# and otherwise the offset of the "\n" that ends the line before it.
#
# ONE CALL PER MARKER, NOT PER BYTE (1.6.0 — this doubled the parse time).
# This replaces `_cyml_is_entries(data, len, pos)`, a yes/no test that
# bayan_cyml_parse called at every byte offset, in each of its two passes.
# Nearly every call answered "not a newline", so the parse was a function
# call per input byte, twice: since 1.5.1 it took about twice as long as
# 1.4.0's one pass did (bannermanor measured `font_load_file` ~45% slower).
# A marker can only begin a line, so this walks to the next newline in a
# tight loop and runs the 12-byte compare only there. It answers what the
# old test answered at every byte from i on; tests/bayan.tcyr checks that
# against a copy of the old test, at every offset of 12 documents.
#
# OFFSET 0 (fixed in 1.5.1 — this dropped an entry). The test at byte 0 used
# to look ONLY for the marker at byte 0, so a document beginning with a
# newline never matched: the marker at byte 1 needed the newline form, but
# that form was only tried at offsets after 0, and the newline was at 0.
# Measured: "\n[[entries]]\nid=1\n---\nA\n[[entries]]\nid=2\n---\nB\n" gave
# entry_count 1, against 2 for the identical text without the leading newline —
# and the lost entry's 22 bytes were silently folded into the file header.
# A leading blank line is not a syntax error in any format, so it must not
# change what parses. Hence the flush test first, then the loop from 0.
fn _cyml_next_entries(data, len, i): i64 {
    if (i == 0) {
        # A marker flush against the start of the document.
        if (_cyml_marker_at(data, len, 0) == 1) { return 0; }
        # Otherwise fall through: byte 0 may itself be the preceding newline.
    }
    var p = i;
    while (p < len) {
        if (load8(data + p) == 10) {
            # _cyml_marker_at's own bound means a marker cut off by the end
            # of the input is not one; one that ends there is.
            if (_cyml_marker_at(data, len, p + 1) == 1) { return p; }
        }
        p = p + 1;
    }
    return len;
}

# Where the marker text `[[entries]]` begins, for a marker position p from
# _cyml_next_entries: p itself for a marker flush at byte 0, else p + 1 (p is
# the newline before it). Position 0 is both a marker at byte 0 and a newline
# at byte 0 before one; the byte there tells them apart.
fn _cyml_marker_text(data, p): i64 {
    if (load8(data + p) == 10) { return p + 1; }
    return p;
}

# Trim leading/trailing whitespace from a (ptr, len) pair.
# Returns new length (ptr adjusted in-place via out params).
fn _cyml_trim(ptr, len, out_ptr, out_len): i64 {
    var s = 0;
    while (s < len) {
        var c = load8(ptr + s);
        if (c == 32 || c == 10 || c == 13 || c == 9) {
            s = s + 1;
        } else { break; }
    }
    var e = len;
    while (e > s) {
        var c = load8(ptr + e - 1);
        if (c == 32 || c == 10 || c == 13 || c == 9) {
            e = e - 1;
        } else { break; }
    }
    store64(out_ptr, ptr + s);
    store64(out_len, e - s);
    return 0;
}

# Parse a CYML buffer. Returns a CymlDoc pointer, or 0 when an allocation is
# refused.
# data = pointer to buffer, len = byte length.
#
# A REFUSED ALLOCATION IS 0 (1.6.1 — this faulted). The doc, the single-entry
# array, each entry and the multi-entry array were stored through unchecked,
# so under allocator exhaustion the parse wrote to address 0. The entry-offset
# array was checked, but it answered with the doc built so far: no header and
# no entries, which a caller cannot tell from an empty document. Each of the
# five is checked now and a refusal returns 0. All of them come from the
# default allocator (the global bump allocator, as before; the three arrays
# called bare `alloc`, the doc and entries went through default_alloc()), so
# tests/bayan.tcyr can refuse each allocation point of a parse alone.
fn bayan_cyml_parse(data, len): i64 {
    var doc = bayan_cyml_doc_new();
    if (doc == 0) { return 0; }

    # Entry offsets, in TWO PASSES (1.5.1 — this was a silent truncation).
    #
    # The previous form used a 2048-byte stack array holding 256 eight-byte
    # slots and stopped scanning at the 256th marker, so a document with more
    # entries than that parsed "successfully" and simply lost the rest: 300
    # blocks in, 256 reported, 44 gone with no error. Raising the constant
    # would only move the cliff, so the cap is removed instead — count the
    # markers first, allocate exactly that many slots, then fill them. Memory
    # is now proportional to the document rather than fixed, and there is no
    # silent boundary left to fall off.
    #
    # (The stack array it replaces has its own history: it was declared [256]
    # when it needed to be [2048], because a function-local `var X[N]` is N
    # BYTES and not N slots, which made it a 1,792-byte out-of-bounds stack
    # write from untrusted input. See CHANGELOG [6.0.79]. Heap-allocating an
    # exact count retires that trap along with the truncation.)
    #
    # Each pass hops from marker to marker with _cyml_next_entries (1.6.0)
    # rather than testing every byte. Two passes stay: one pass into a
    # doubling array would be faster again, but alloc is a bump allocator, so
    # every outgrown array would stay behind, which the exact count avoids.
    # After a match the scan resumes just past `[[entries]]` (1.7.0 — this
    # merged two entries), on the marker's own newline, or its CR.
    # It used to resume past that newline, and a marker can only follow one,
    # so a second marker right after the first was not seen: `[[entries]]\n
    # [[entries]]\nid=2` was one entry whose header began with the second
    # marker, from 1.5.1 to 1.6.2. Two marker lines are two entries, the first
    # one empty, as two `[[t]]` lines are two tables in TOML (and bayan's TOML
    # parser has kept an empty one since 1.5.4).
    var entry_count = 0;
    var i = _cyml_next_entries(data, len, 0);
    while (i < len) {
        entry_count = entry_count + 1;
        i = _cyml_marker_text(data, i) + 11;
        i = _cyml_next_entries(data, len, i);
    }

    var entry_starts = 0;
    if (entry_count > 0) {
        entry_starts = alloc_via(default_alloc(), entry_count * 8);
        if (entry_starts == 0) { return 0; }
        var w = 0;
        i = _cyml_next_entries(data, len, 0);
        while (i < len && w < entry_count) {
            store64(entry_starts + w * 8, i);
            w = w + 1;
            i = _cyml_marker_text(data, i) + 11;
            i = _cyml_next_entries(data, len, i);
        }
    }

    if (entry_count == 0) {
        # Single-entry file: find --- delimiter
        var delim_pos = _cyml_next_delim(data, len, 0);
        if (delim_pos >= len) {
            # No delimiter — entire file is header, no body
            store64(doc, data);
            store64(doc + 8, len);
            store64(doc + 24, 0);
            return doc;
        }
        # Header = data[0..delim_pos], body = the text after the `---` line
        var hp = 0; var hl = 0; var bp = 0; var bl = 0;
        _cyml_trim(data, delim_pos, &hp, &hl);
        var body_start = _cyml_body_at(data, delim_pos, len);
        _cyml_trim(data + body_start, len - body_start, &bp, &bl);

        store64(doc, hp);
        store64(doc + 8, hl);
        # Single entry stored as entries[0]
        var entries = alloc_via(default_alloc(), 8);
        if (entries == 0) { return 0; }
        var one = bayan_cyml_entry_new(hp, hl, bp, bl);
        if (one == 0) { return 0; }
        store64(entries, one);
        store64(doc + 16, entries);
        store64(doc + 24, 1);
        return doc;
    }

    # Multi-entry file
    # File header = data[0..first_entry_start]
    var first_entry = load64(entry_starts);
    if (first_entry > 0) {
        var fhp = 0; var fhl = 0;
        _cyml_trim(data, first_entry, &fhp, &fhl);
        store64(doc, fhp);
        store64(doc + 8, fhl);
    }

    var entries = alloc_via(default_alloc(), entry_count * 8);
    if (entries == 0) { return 0; }
    var ei = 0;
    while (ei < entry_count) {
        var estart = load64(entry_starts + ei * 8);
        var eend = len;
        if (ei + 1 < entry_count) { eend = load64(entry_starts + (ei + 1) * 8); }

        # The entry's header starts after the marker line and its newline. An
        # empty entry (a marker straight after a marker), or a marker that
        # ends the input, has no header: its next marker, or the end, comes
        # first, and the start is held there.
        # The header starts past the marker line's LF or CR LF.
        var hdr_start = _cyml_eol(data, len, _cyml_marker_text(data, estart) + 11) + 1;
        if (hdr_start > eend) { hdr_start = eend; }

        # Find the `---` line within this entry. hdr_start follows the marker's
        # newline, so a `---` flush against the marker counts (1.7.0).
        var edelim = _cyml_next_delim(data, eend, hdr_start);

        var e = 0;
        if (edelim >= eend) {
            # No body — entry is header only
            var ehp = 0; var ehl = 0;
            _cyml_trim(data + hdr_start, eend - hdr_start, &ehp, &ehl);
            e = bayan_cyml_entry_new(ehp, ehl, 0, 0);
        } else {
            var ehp = 0; var ehl = 0; var ebp = 0; var ebl = 0;
            _cyml_trim(data + hdr_start, edelim - hdr_start, &ehp, &ehl);
            var ebody_start = _cyml_body_at(data, edelim, eend);
            _cyml_trim(data + ebody_start, eend - ebody_start, &ebp, &ebl);
            e = bayan_cyml_entry_new(ehp, ehl, ebp, ebl);
        }
        if (e == 0) { return 0; }
        store64(entries + ei * 8, e);
        ei = ei + 1;
    }

    store64(doc + 16, entries);
    store64(doc + 24, entry_count);
    return doc;
}

# ================================================================
# Value expansion — resolve ${file:PATH} and ${env:NAME} references
# ================================================================
# ${file:VERSION} → reads file "VERSION", trims whitespace
# ${env:HOME}     → reads environment variable HOME
# Plain strings without ${...} returned as-is.

fn _cyml_read_file_trimmed(path): i64 {
    # NO SIZE CAP (1.5.4). This read into `var buf[4096]` with a 4095-byte
    # read and no short-read signal, so a `${file:PATH}` expansion of anything
    # larger silently yielded a PREFIX and reported nothing — the same
    # silent-truncation-reported-as-success shape 1.5.1 removed from toml's
    # loader, at a smaller size and in the one path whose whole job is to
    # substitute a file's contents verbatim. A version file is small; a
    # licence header or an embedded key is not.
    #
    # PORTABLE WRAPPERS, not raw syscall numbers (fixed in 1.5.1). This used
    # `syscall(2, ...)` / `syscall(0, ...)` / `syscall(3, ...)` — the x86_64
    # Linux numbers for open/read/close, hardcoded. On another target those
    # numbers are different calls entirely: on agnos the "open" returned the
    # process's own pid, the `fd < 0` guard did not fire because a pid is
    # positive, and the following "read" terminated the process (measured exit
    # status 102 = pid mod 256). lib/io.cyr resolves the right number per
    # target, and bayan already depends on it.
    var fd = file_open(path, 0, 0);
    if (fd < 0) { return 0; }
    var chunk = alloc(65536);
    if (chunk == 0) { file_close(fd); return 0; }
    var sb = str_builder_new();
    var err = 0;
    loop {
        var rn = file_read(fd, chunk, 65536);
        # A read ERROR is not EOF — folding the two reports a truncated read
        # as success, which is the defect this rewrite exists to remove.
        if (rn < 0) { err = 1; break; }
        elif (rn == 0) { break; }
        else { str_builder_add(sb, str_new(chunk, rn)); }
    }
    file_close(fd);
    if (err == 1) { return 0; }
    var whole = str_builder_build(sb);
    var n = str_len(whole);
    var data = str_data(whole);
    if (n <= 0) { return 0; }
    # Trim trailing whitespace/newlines
    while (n > 0) {
        var c = load8(data + n - 1);
        if (c == 10 || c == 13 || c == 32 || c == 9) { n = n - 1; }
        else { break; }
    }
    var out = alloc(n + 1);
    if (out == 0) { return 0; }
    memcpy(out, data, n);
    store8(out + n, 0);
    return out;
}

fn _cyml_read_env(name, name_len): i64 {
    var ebuf[8192];
    # Same portability fix as _cyml_read_file_trimmed above. (The path itself
    # is Linux-specific; a target without /proc simply fails the open, which is
    # a clean "not found" rather than a process kill.)
    var fd = file_open("/proc/self/environ", 0, 0);
    if (fd < 0) { return 0; }
    var n = file_read(fd, &ebuf, 8191);
    file_close(fd);
    if (n <= 0) { return 0; }
    store8(&ebuf + n, 0);
    var pos = 0;
    while (pos < n) {
        var end = pos;
        while (end < n && load8(&ebuf + end) != 0) { end = end + 1; }
        # Check if this entry starts with name=
        if (end - pos > name_len) {
            if (load8(&ebuf + pos + name_len) == 61) {
                var matched = 1;
                var k = 0;
                while (k < name_len) {
                    if (load8(&ebuf + pos + k) != load8(name + k)) { matched = 0; break; }
                    k = k + 1;
                }
                if (matched == 1) {
                    var vstart = pos + name_len + 1;
                    var vlen = end - vstart;
                    var out = alloc(vlen + 1);
                    memcpy(out, &ebuf + vstart, vlen);
                    store8(out + vlen, 0);
                    return out;
                }
            }
        }
        pos = end + 1;
    }
    return 0;
}

# Expand ${file:PATH} and ${env:NAME} in a value string.
# Returns expanded cstring (allocated). Returns input unchanged if no expansion.
# Expand every `${file:PATH}` / `${env:NAME}` reference in `val`, returning a
# NUL-terminated cstring. Text outside the references is preserved.
#
# SUBSTITUTION (fixed in 1.5.1 — this used to discard the rest of the value).
# The previous body found the FIRST `${...}`, returned the expansion alone, and
# threw away everything before and after it. Measured:
#
#   "v${file:VERSION}-beta"   -> "1.5.0"        (16 of 21 bytes dropped)
#   "${env:HOME}:${env:USER}" -> "/home/macro"  (12 dropped, second ref ignored)
#   "https://${env:HOST}/api" -> the host alone, scheme and path gone
#
# A caller building a URL or a path out of a manifest value got a silently
# truncated string, which is the shape that turns a config typo into a request
# to the wrong place.
#
# Expanded text is deliberately NOT re-scanned: substitution happens once, so a
# file or environment variable that itself contains `${...}` cannot drive an
# expansion loop.
fn bayan_cyml_expand_value(val): i64 {
    if (val == 0) { return 0; }
    var len = strlen(val);
    if (len < 4) { return val; }

    # First pass: is there anything to expand? Avoids allocating for the
    # overwhelmingly common case of a plain value.
    var seen = 0;
    var q = 0;
    while (q < len - 1) {
        if (load8(val + q) == 36 && load8(val + q + 1) == 123) { seen = 1; q = len; }
        else { q = q + 1; }
    }
    if (seen == 0) { return val; }

    var sb = str_builder_new();
    var i = 0;
    while (i < len) {
        var isref = 0;
        if (i + 1 < len) {
            if (load8(val + i) == 36 && load8(val + i + 1) == 123) { isref = 1; }
        }
        if (isref == 0) {
            str_builder_putc(sb, load8(val + i));
            i = i + 1;
        } else {
            var start = i + 2;
            var end = start;
            while (end < len && load8(val + end) != 125) { end = end + 1; }
            if (end >= len) {
                # Unterminated `${` — emit it literally rather than dropping
                # the remainder of the value.
                str_builder_putc(sb, load8(val + i));
                i = i + 1;
            } else {
                var expanded = 0;
                if (end - start > 5 && memeq(val + start, "file:", 5) == 1) {
                    var plen = end - start - 5;
                    var path = alloc(plen + 1);
                    if (path != 0) {
                        memcpy(path, val + start + 5, plen);
                        store8(path + plen, 0);
                        expanded = _cyml_read_file_trimmed(path);
                    }
                } elif (end - start > 4 && memeq(val + start, "env:", 4) == 1) {
                    expanded = _cyml_read_env(val + start + 4, end - start - 4);
                }
                if (expanded != 0) {
                    str_builder_add(sb, str_new(expanded, strlen(expanded)));
                } else {
                    # Unknown scheme, or the file/variable did not resolve:
                    # keep the reference verbatim so the caller can see what
                    # failed instead of receiving a value with a hole in it.
                    var k = i;
                    while (k <= end) { str_builder_putc(sb, load8(val + k)); k = k + 1; }
                }
                i = end + 1;
            }
        }
    }
    var out = str_builder_build(sb);
    var olen = str_len(out);
    var cstr = alloc(olen + 1);
    if (cstr == 0) { return val; }
    memcpy(cstr, str_data(out), olen);
    store8(cstr + olen, 0);
    return cstr;
}

# Convenience: split a single-entry CYML buffer into header + body.
# Returns 1 on success, 0 if no delimiter found.
fn bayan_cyml_split(data, len, out_hdr, out_hdr_len, out_body, out_body_len): i64 {
    var i = _cyml_next_delim(data, len, 0);
    if (i >= len) { return 0; }
    _cyml_trim(data, i, out_hdr, out_hdr_len);
    var body_start = _cyml_body_at(data, i, len);
    _cyml_trim(data + body_start, len - body_start, out_body, out_body_len);
    return 1;
}

# v5.8.30 — Result variant of file-loading parser. Reads the file
# via file_open_r / file_read_r, wraps any IoError as Err(CymlIoErr).
# NO CAP AS OF 1.5.4. Both of this module's fixed read buffers are gone — the
# 256 KiB one here and the 4 KiB one in `_cyml_read_file_trimmed` above — and
# both now slurp into a growing str_builder, matching toml (1.5.1) and json.
#
# The history is worth keeping because it is a small lesson twice over. The
# comment here claimed the cap "matches the conservative 256KB used elsewhere"
# long after that convention had gone; 1.5.3 corrected it to "the last fixed
# cap in the project", which was ALSO false — an adversarial review found the
# 4 KiB one 173 lines up. Two drafts of a comment, both wrong, in a module
# whose code was not read while either was written. Historically, a larger file was
# TRUNCATED and still returned as Ok(...), with the cut landing mid-line —
# the same silent-truncation-reported-as-success shape 1.5.1 removed from
# toml, where it had lost 1,893 keys from a 300 KB file. Converting this to
# the str_builder slurp is its own change; the cap is documented, not fixed.
# Original note follows: vidya's
# largest current .cyml entries fit comfortably.
fn bayan_cyml_parse_file_r(path): i64 {
    var fd_r_tag, fd_r = file_open_r(path, 0, 0);
    if (is_err_result(fd_r_tag) == 1) { return Err(CymlIoErr); }
    var fd = fd_r;
    # NO SIZE CAP (1.5.4). The fixed 256 KiB buffer stopped reading at the cap
    # and returned Ok(...) over a document cut mid-line — a silent truncation
    # reported as SUCCESS, which is exactly what 1.5.1 removed from toml's
    # loader after it lost 1,893 keys from a 300 KB file. A str_builder grows;
    # there is no cap left in this module.
    var chunk = alloc_via(default_alloc(), 65536);
    if (chunk == 0) { sys_close(fd); return Err(CymlIoErr); }
    var sb = str_builder_new();
    if (sb == 0) { sys_close(fd); return Err(CymlIoErr); }
    var total = 0;
    loop {
        var rd_r_tag, rd_r = file_read_r(fd, chunk, 65536);
        if (is_err_result(rd_r_tag) == 1) { sys_close(fd); return Err(CymlIoErr); }
        var n = rd_r;
        if (n <= 0) { break; }
        else {
            var piece = str_new(chunk, n);
            if (piece == 0) { sys_close(fd); return Err(CymlIoErr); }
            if (str_builder_add_a(default_alloc(), sb, piece) < 0) { sys_close(fd); return Err(CymlIoErr); }
            total = total + n;
        }
    }
    sys_close(fd);
    # An EMPTY file is a legal document with no entries (1.5.4), the same
    # correction toml's loader got: reporting it as Err made it
    # indistinguishable from a file that does not exist, which is the one
    # distinction this Result variant exists to draw.
    #
    # A REFUSED ALLOCATION IS AN Err, NEVER Ok(0) (1.6.1, as toml's loader
    # since 1.5.11): every accessor answers 0 for a 0 doc, so Ok(0) would read
    # as an empty document. Until 1.6.1 only the chunk was checked; a refused
    # builder or chunk Str faulted, a refused grow ended the process (the
    # default str_builder_add does), and a refused result or parse faulted.
    # tests/bayan.tcyr refuses each allocation point of a load alone.
    var whole = str_builder_build(sb);
    if (whole == 0) { return Err(CymlIoErr); }
    var doc = bayan_cyml_parse(str_data(whole), total);
    if (doc == 0) { return Err(CymlIoErr); }
    return Ok(doc);
}

# --- dtoa.cyr ---

# dtoa.cyr — round-trip-correct f64 <-> decimal conversion for bayan.
# Usage: included by the json profile. Requires: alloc.cyr, string.cyr, atomic.cyr,
# math.cyr (alloc.cyr includes atomic.cyr; it is named because _d_init_tables uses
# it; math.cyr is the stdlib's f64_parse_n, which bayan_f64_parse delegates to).
#
# WHY: the old path formatted every f64 as fmt_float_buf(v, buf, 6) — a fixed
# 6-decimal cap that (a) loses ~9 mantissa bits on values like 1/3, (b) flushes
# |x|<5e-7 to 0, and (c) overflowed i64 on |x|>=2^63 / Inf / NaN, emitting the
# NON-JSON token "-.00000-". Parsing used two divergent, both-imprecise atofs
# that disagreed by 1 ULP on identical text, and the exponent apply looped once
# per unit of the exponent VALUE — an algorithmic-complexity DoS.
#
# Replaces all of that:
#   bayan_f64_to_json(bits, buf) — Grisu2 (Loitsch; the miloyip/rapidjson port):
#     integer-only, ALWAYS succeeds (no Dragon4 fallback), output is guaranteed
#     to round-trip and is shortest-or-near-shortest. Non-finite -> "null".
#   bayan_f64_parse(s, n) / bayan_f64_from_json(cstr) — CORRECTLY ROUNDED for
#     every input, exponent clamped during scanning (no DoS): the stdlib's
#     f64_parse_n behind bayan's lenient NaN / Inf front. Details at "Parsing".
# CHANGELOG bayan [1.2.1]; folded into cyrius CHANGELOG [6.4.69]. The parser was
# made correctly rounded in bayan [1.5.7] (issue 2026-09-22), and delegates to
# cyrius's f64_parse_n from bayan [1.5.14].

# ================================================================
# Cached powers of ten as DiyFp significands (u64, bit63 set): sig*2^binexp ==
# 10^decexp correctly rounded to 64 bits, decexp = -348,-340,..,340 (step 8),
# 87 entries. Values 0.5-ULP validated against double-conversion; the binary and
# decimal exponents are closed-form (validated), so only the significands are
# stored. See scratchpad/gen_pow10.py.
# ================================================================
var _D_POW10_SIG: i64[87];
var _D_TABLES_INIT = 0;   # 0 not built / 1 being built / 2 published (_d_once_*, 1.5.11)
var _D_MASK32 = 0xFFFFFFFF;
var _D_BIT63  = 0x8000000000000000;

# ---- one-time table build, race-free (1.5.11) ----
# The table is built on first use, by bayan_f64_to_json (from 1.5.14 the parser
# reads no bayan table, and the 10^0..10^22 table went with it). Until 1.5.11 that
# was a plain check-then-set with the flag stored LAST and no barrier: two threads
# making their first call at once both built, which is harmless (the same
# constants), but on aarch64 nothing ordered the table stores before the flag store
# or the table loads after the flag load, so a second thread could see the flag set
# and then read zero significands — a wrong parse or format with no error. The
# same shape sigil 3.13.6 removed from its own initialisers (cyrius issue
# 2026-09-30-tls-first-use-thread-race).
#
# The flag moves 0 -> 1 (one thread claims the build by CAS) -> 2 (published after
# a fence). A caller that loses the claim spins until 2 and then fences; a caller
# that sees 2 on the fast path fences on aarch64 (x86 never reorders loads with
# loads). ⚠ Nothing between the claim and the publish may `return`: the flag would
# stay 1 and every later caller would spin forever.

# The fast path's acquire half. Returns 0.
fn _d_once_acquired(): i64 {
    #ifdef CYRIUS_ARCH_AARCH64
    atomic_fence();
    #endif
    return 0;
}

# Claim the build (0 -> 1). 1 if the caller won and must build and then publish;
# 0 once another thread has published (it spins until then).
fn _d_once_claim(flag): i64 {
    if (atomic_cas(flag, 0, 1) == 1) { return 1; }
    while (atomic_load(flag) != 2) { }
    atomic_fence();
    return 0;
}

# Publish (-> 2): every table store is made visible before the flag. Returns 0.
fn _d_once_publish(flag): i64 {
    atomic_fence();
    atomic_store(flag, 2);
    return 0;
}

fn _d_init_tables(): i64 {
    if (atomic_load(&_D_TABLES_INIT) == 2) { return _d_once_acquired(); }
    if (_d_once_claim(&_D_TABLES_INIT) == 0) { return 0; }
    store64(&_D_POW10_SIG + 0, 0xfa8fd5a0081c0288);
    store64(&_D_POW10_SIG + 8, 0xbaaee17fa23ebf76);
    store64(&_D_POW10_SIG + 16, 0x8b16fb203055ac76);
    store64(&_D_POW10_SIG + 24, 0xcf42894a5dce35ea);
    store64(&_D_POW10_SIG + 32, 0x9a6bb0aa55653b2d);
    store64(&_D_POW10_SIG + 40, 0xe61acf033d1a45df);
    store64(&_D_POW10_SIG + 48, 0xab70fe17c79ac6ca);
    store64(&_D_POW10_SIG + 56, 0xff77b1fcbebcdc4f);
    store64(&_D_POW10_SIG + 64, 0xbe5691ef416bd60c);
    store64(&_D_POW10_SIG + 72, 0x8dd01fad907ffc3c);
    store64(&_D_POW10_SIG + 80, 0xd3515c2831559a83);
    store64(&_D_POW10_SIG + 88, 0x9d71ac8fada6c9b5);
    store64(&_D_POW10_SIG + 96, 0xea9c227723ee8bcb);
    store64(&_D_POW10_SIG + 104, 0xaecc49914078536d);
    store64(&_D_POW10_SIG + 112, 0x823c12795db6ce57);
    store64(&_D_POW10_SIG + 120, 0xc21094364dfb5637);
    store64(&_D_POW10_SIG + 128, 0x9096ea6f3848984f);
    store64(&_D_POW10_SIG + 136, 0xd77485cb25823ac7);
    store64(&_D_POW10_SIG + 144, 0xa086cfcd97bf97f4);
    store64(&_D_POW10_SIG + 152, 0xef340a98172aace5);
    store64(&_D_POW10_SIG + 160, 0xb23867fb2a35b28e);
    store64(&_D_POW10_SIG + 168, 0x84c8d4dfd2c63f3b);
    store64(&_D_POW10_SIG + 176, 0xc5dd44271ad3cdba);
    store64(&_D_POW10_SIG + 184, 0x936b9fcebb25c996);
    store64(&_D_POW10_SIG + 192, 0xdbac6c247d62a584);
    store64(&_D_POW10_SIG + 200, 0xa3ab66580d5fdaf6);
    store64(&_D_POW10_SIG + 208, 0xf3e2f893dec3f126);
    store64(&_D_POW10_SIG + 216, 0xb5b5ada8aaff80b8);
    store64(&_D_POW10_SIG + 224, 0x87625f056c7c4a8b);
    store64(&_D_POW10_SIG + 232, 0xc9bcff6034c13053);
    store64(&_D_POW10_SIG + 240, 0x964e858c91ba2655);
    store64(&_D_POW10_SIG + 248, 0xdff9772470297ebd);
    store64(&_D_POW10_SIG + 256, 0xa6dfbd9fb8e5b88f);
    store64(&_D_POW10_SIG + 264, 0xf8a95fcf88747d94);
    store64(&_D_POW10_SIG + 272, 0xb94470938fa89bcf);
    store64(&_D_POW10_SIG + 280, 0x8a08f0f8bf0f156b);
    store64(&_D_POW10_SIG + 288, 0xcdb02555653131b6);
    store64(&_D_POW10_SIG + 296, 0x993fe2c6d07b7fac);
    store64(&_D_POW10_SIG + 304, 0xe45c10c42a2b3b06);
    store64(&_D_POW10_SIG + 312, 0xaa242499697392d3);
    store64(&_D_POW10_SIG + 320, 0xfd87b5f28300ca0e);
    store64(&_D_POW10_SIG + 328, 0xbce5086492111aeb);
    store64(&_D_POW10_SIG + 336, 0x8cbccc096f5088cc);
    store64(&_D_POW10_SIG + 344, 0xd1b71758e219652c);
    store64(&_D_POW10_SIG + 352, 0x9c40000000000000);
    store64(&_D_POW10_SIG + 360, 0xe8d4a51000000000);
    store64(&_D_POW10_SIG + 368, 0xad78ebc5ac620000);
    store64(&_D_POW10_SIG + 376, 0x813f3978f8940984);
    store64(&_D_POW10_SIG + 384, 0xc097ce7bc90715b3);
    store64(&_D_POW10_SIG + 392, 0x8f7e32ce7bea5c70);
    store64(&_D_POW10_SIG + 400, 0xd5d238a4abe98068);
    store64(&_D_POW10_SIG + 408, 0x9f4f2726179a2245);
    store64(&_D_POW10_SIG + 416, 0xed63a231d4c4fb27);
    store64(&_D_POW10_SIG + 424, 0xb0de65388cc8ada8);
    store64(&_D_POW10_SIG + 432, 0x83c7088e1aab65db);
    store64(&_D_POW10_SIG + 440, 0xc45d1df942711d9a);
    store64(&_D_POW10_SIG + 448, 0x924d692ca61be758);
    store64(&_D_POW10_SIG + 456, 0xda01ee641a708dea);
    store64(&_D_POW10_SIG + 464, 0xa26da3999aef774a);
    store64(&_D_POW10_SIG + 472, 0xf209787bb47d6b85);
    store64(&_D_POW10_SIG + 480, 0xb454e4a179dd1877);
    store64(&_D_POW10_SIG + 488, 0x865b86925b9bc5c2);
    store64(&_D_POW10_SIG + 496, 0xc83553c5c8965d3d);
    store64(&_D_POW10_SIG + 504, 0x952ab45cfa97a0b3);
    store64(&_D_POW10_SIG + 512, 0xde469fbd99a05fe3);
    store64(&_D_POW10_SIG + 520, 0xa59bc234db398c25);
    store64(&_D_POW10_SIG + 528, 0xf6c69a72a3989f5c);
    store64(&_D_POW10_SIG + 536, 0xb7dcbf5354e9bece);
    store64(&_D_POW10_SIG + 544, 0x88fcf317f22241e2);
    store64(&_D_POW10_SIG + 552, 0xcc20ce9bd35c78a5);
    store64(&_D_POW10_SIG + 560, 0x98165af37b2153df);

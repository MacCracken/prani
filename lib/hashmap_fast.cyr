# hashmap_fast.cyr — SIMD-accelerated hash table (Swiss table inspired)
# Usage: include "lib/hashmap_fast.cyr"
# Includes its own definers: alloc.cyr, string.cyr, vec.cyr, fnptr.cyr, hashseed.cyr.
#
# **Status (v5.8.62 audit): experimental, zero consumers.** Not in
# cyrius.cyml's `[deps].stdlib` auto-prepend, not included by any
# tcyr / program / sibling-distfile. Production code uses
# `lib/hashmap.cyr` (open-addressing, 3 key-type surfaces). Kept in
# tree as a future optimization candidate — promote to stdlib only
# once a consumer benchmarks a measurable win over hashmap.cyr;
# pinned for re-evaluation in the pre-v6.0 hardening sweep.
#
# Layout: separate metadata array (1 byte per slot) + key/value
# arrays (8 bytes each). Header (48 B): { meta, keys, vals, cap, count, tombs }.
# Metadata byte: 0x00 = empty, 0xFF = tombstone, 0x01-0xFE = H2
# hash (top 7 bits + 1).
# Probe: load 16 metadata bytes → SSE2 pcmpeqb → pmovmskb →
# bitmask of matches.
# Group size: 16 (one SSE2 register). Linear probing within group,
# then next group.

include "lib/fnptr.cyr"
include "lib/hashseed.cyr"   # v6.5.39: shared seed — do NOT re-copy the hash here
# 6.6.9: memset / streq / vec_* were called and not included. CHANGELOG [6.6.9]
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/vec.cyr"

# FNV-1a hash for null-terminated string (same as hashmap.cyr)
# v6.5.39: seeded + finalized, like its twin. ⚠ This was a VERBATIM second copy of the
# unseeded hash and the flooding filing did not mention it at all — measured, it floods too
# (N=4096: 22.4 ms colliding vs 1.16 ms distinct). Both copies now draw from lib/hashseed.cyr
# rather than each carrying their own constant, so they cannot drift apart again.
fn _fhm_hash(s): i64 {
    if (s == 0) { return 0; }
    var h = 0xCBF29CE484222325 ^ _hm_seed_get();
    var hi = 0;
    while (load8(s + hi) != 0) {
        h = h ^ load8(s + hi);
        h = h * 0x100000001B3;
        hi = hi + 1;
    }
    return _hm_mix(h);
}

var _FHM_EMPTY = 0;
var _FHM_TOMB = 255;

# Compute H2 (metadata hash): top 7 bits of hash, +1 to avoid 0x00
fn _fhm_h2(h): i64 { return ((h >> 57) & 0x7F) + 1; }

# Create a new fast hashmap (capacity must be multiple of 16, minimum 16).
# Returns 0 when an allocation is refused (6.6.7 — it stored through them unchecked).
fn fhm_new(): i64 {
    var m = alloc(48);
    if (m == 0) { return 0; }
    var cap = 16;
    var meta = alloc(cap);
    if (meta == 0) { return 0; }
    var keys = alloc(cap * 8);
    if (keys == 0) { return 0; }
    var vals = alloc(cap * 8);
    if (vals == 0) { return 0; }
    memset(meta, 0, cap);
    store64(m, meta);
    store64(m + 8, keys);
    store64(m + 16, vals);
    store64(m + 24, cap);
    store64(m + 32, 0);
    store64(m + 40, 0);   # tombstones
    return m;
}

# Return the current capacity
fn fhm_cap(m): i64 { return load64(m + 24); }
# Return the number of occupied entries
fn fhm_count(m): i64 { return load64(m + 32); }

# SIMD probe: find slot matching h2 byte in a 16-byte group at meta+offset.
# Uses SSE2: movdqu → pcmpeqb → pmovmskb → bitmask.
# Returns bitmask (each bit = 1 if meta byte matches h2).
fn _fhm_probe16(meta, offset, h2): i64 {
    var result = 0;
    #ifdef CYRIUS_ARCH_X86
    # SSE2 fast path: load 16 metadata bytes into xmm0, broadcast h2
    # into xmm1, pcmpeqb, pmovmskb → bitmask of matching slots.
    asm {
        # movdqu xmm0, [rdi]  — rdi = meta + offset (1st arg)
        # We need meta+offset in a register. It's param 0 + param 1.
        # Params: meta=[rbp-8], offset=[rbp-16], h2=[rbp-24], result=[rbp-32]

        # mov rax, [rbp-8]    ; meta
        0x48; 0x8B; 0x45; 0xF8;
        # add rax, [rbp-16]   ; + offset
        0x48; 0x03; 0x45; 0xF0;
        # movdqu xmm0, [rax]
        0xF3; 0x0F; 0x6F; 0x00;

        # movd xmm1, [rbp-24] ; h2 (low byte)
        0x66; 0x0F; 0x6E; 0x4D; 0xE8;
        # punpcklbw xmm1, xmm1  (broadcast byte 0 to all 16)
        0x66; 0x0F; 0x60; 0xC9;
        # punpcklwd xmm1, xmm1
        0x66; 0x0F; 0x61; 0xC9;
        # pshufd xmm1, xmm1, 0x00
        0x66; 0x0F; 0x70; 0xC9; 0x00;

        # pcmpeqb xmm0, xmm1
        0x66; 0x0F; 0x74; 0xC1;
        # pmovmskb eax, xmm0
        0x66; 0x0F; 0xD7; 0xC0;
        # mov [rbp-32], rax    ; result
        0x48; 0x89; 0x45; 0xE0;
    }
    #endif
    #ifndef CYRIUS_ARCH_X86
    # Portable scalar fallback: bit i set iff meta[offset+i] == h2.
    # Identical bitmask semantics to the SSE2 pcmpeqb/pmovmskb path.
    var i = 0;
    while (i < 16) {
        if (load8(meta + offset + i) == h2) { result = result | (1 << i); }
        i = i + 1;
    }
    #endif
    return result;
}

# Find empty slot bitmask in 16-byte group
fn _fhm_empty16(meta, offset): i64 {
    return _fhm_probe16(meta, offset, 0);
}

# Find index of lowest set bit in bitmask
fn _fhm_ctz(mask): i64 {
    var bit = 0;
    var tmp = mask;
    while ((tmp & 1) == 0) { bit = bit + 1; tmp = tmp >> 1; }
    return bit;
}

# Get value by key. Returns value or 0 if not found.
fn fhm_get(m, key): i64 {
    var meta = load64(m);
    var keys = load64(m + 8);
    var vals = load64(m + 16);
    var cap = load64(m + 24);
    var h = _fhm_hash(key);
    var h2 = _fhm_h2(h);
    var idx = (h & (cap - 1)) & (0 - 16);
    var probes = 0;
    while (probes < cap) {
        # SIMD probe: check 16 slots at once
        var mask = _fhm_probe16(meta, idx, h2);
        while (mask != 0) {
            var si = idx + _fhm_ctz(mask);
            if (streq(load64(keys + si * 8), key) == 1) {
                return load64(vals + si * 8);
            }
            mask = mask & (mask - 1);
        }
        # Check if group has any empty slots (no point continuing if so)
        var empty = _fhm_empty16(meta, idx);
        if (empty != 0) { return 0; }
        idx = (idx + 16) & (cap - 1);
        probes = probes + 16;
    }
    return 0;
}

# Get value with default. Returns value or default_val if not found.
fn fhm_get_or(m, key, default_val): i64 {
    var meta = load64(m);
    var keys = load64(m + 8);
    var vals = load64(m + 16);
    var cap = load64(m + 24);
    var h = _fhm_hash(key);
    var h2 = _fhm_h2(h);
    var idx = (h & (cap - 1)) & (0 - 16);
    var probes = 0;
    while (probes < cap) {
        var mask = _fhm_probe16(meta, idx, h2);
        while (mask != 0) {
            var si = idx + _fhm_ctz(mask);
            if (streq(load64(keys + si * 8), key) == 1) {
                return load64(vals + si * 8);
            }
            mask = mask & (mask - 1);
        }
        var empty = _fhm_empty16(meta, idx);
        if (empty != 0) { return default_val; }
        idx = (idx + 16) & (cap - 1);
        probes = probes + 16;
    }
    return default_val;
}

# Alias for fhm_count
fn fhm_size(m): i64 { return load64(m + 32); }

# Set key-value pair. Returns 0, or -1 when the table had to grow and the grow's allocation
# was refused — the map is then UNCHANGED (the old table stays live). CHANGELOG [6.6.7]
#
# ⛔ TOMBSTONES COUNT AS OCCUPIED (v6.6.8). The rehash trigger counted only LIVE entries while
# fhm_delete leaves a 255 tombstone in every slot it frees, and an insert only ever took an
# EMPTY slot. After enough delete/insert churn no group had an empty slot: the probe walked
# the whole table, fell out of the loop and returned 0 — success — WITHOUT inserting, and
# every get/has on a missing key scanned the whole table. Now:
#   * the trigger is (live + tombstones) at 87.5%; it DOUBLES only when the live load alone
#     is past 43.75%, otherwise it rehashes at the same capacity, which drops the tombstones —
#     so churn at a steady size does not grow the table without bound;
#   * a new key reuses the FIRST tombstone on its probe path (once the key is known absent);
#   * the trigger keeps at least one empty slot, so the probe always ends; the fall-through is
#     a -1, never a silent 0. CHANGELOG [6.6.8]
fn fhm_set(m, key, val): i64 {
    var cap = load64(m + 24);
    var count = load64(m + 32);
    if ((count + load64(m + 40)) * 8 >= cap * 7) {
        var nc = cap;
        if (count * 16 >= cap * 7) { nc = cap * 2; }
        if (_fhm_rehash(m, nc) < 0) { return 0 - 1; }
    }
    return _fhm_insert(m, key, val);
}

# The probe-and-place half of fhm_set, on a table the caller has already made room in.
fn _fhm_insert(m, key, val): i64 {
    var meta = load64(m);
    var keys = load64(m + 8);
    var vals = load64(m + 16);
    var cap = load64(m + 24);
    var h = _fhm_hash(key);
    var h2 = _fhm_h2(h);
    var idx = (h & (cap - 1)) & (0 - 16);
    var tomb = 0 - 1;   # first tombstone on the probe path
    var probes = 0;
    while (probes < cap) {
        # Check for existing key
        var mask = _fhm_probe16(meta, idx, h2);
        while (mask != 0) {
            var si = idx + _fhm_ctz(mask);
            if (streq(load64(keys + si * 8), key) == 1) {
                store64(vals + si * 8, val);
                return 0;
            }
            mask = mask & (mask - 1);
        }
        if (tomb < 0) {
            var tm = _fhm_probe16(meta, idx, _FHM_TOMB);
            if (tm != 0) { tomb = idx + _fhm_ctz(tm); }
        }
        # An empty slot ends the probe: the key is absent.
        var empty = _fhm_empty16(meta, idx);
        if (empty != 0) {
            if (tomb >= 0) { return _fhm_place(m, tomb, h2, key, val, 1); }
            return _fhm_place(m, idx + _fhm_ctz(empty), h2, key, val, 0);
        }
        idx = (idx + 16) & (cap - 1);
        probes = probes + 16;
    }
    if (tomb >= 0) { return _fhm_place(m, tomb, h2, key, val, 1); }
    return 0 - 1;   # no free slot at all — unreachable while the trigger above holds
}

# Write a new entry into slot `si`; `was_tomb` = 1 when that slot held a tombstone.
fn _fhm_place(m, si, h2, key, val, was_tomb): i64 {
    store8(load64(m) + si, h2);
    store64(load64(m + 8) + si * 8, key);
    store64(load64(m + 16) + si * 8, val);
    store64(m + 32, load64(m + 32) + 1);
    if (was_tomb == 1) { store64(m + 40, load64(m + 40) - 1); }
    return 0;
}

# Grow the table (double capacity). Returns 0, or -1 when an allocation is refused.
fn _fhm_grow(m): i64 {
    return _fhm_rehash(m, load64(m + 24) * 2);
}

# Rebuild the table at `new_cap` slots (live entries only, so every tombstone is dropped).
# Returns 0, or -1 when an allocation is refused.
# ⚠ All three arrays are allocated and CHECKED before `m` is touched, so a refused grow
# leaves the old table fully intact. They were unchecked, so a refusal memset through 0.
# CHANGELOG [6.6.7]
fn _fhm_rehash(m, new_cap): i64 {
    var old_meta = load64(m);
    var old_keys = load64(m + 8);
    var old_vals = load64(m + 16);
    var old_cap = load64(m + 24);
    var new_meta = alloc(new_cap);
    if (new_meta == 0) { return 0 - 1; }
    var new_keys = alloc(new_cap * 8);
    if (new_keys == 0) { return 0 - 1; }
    var new_vals = alloc(new_cap * 8);
    if (new_vals == 0) { return 0 - 1; }
    memset(new_meta, 0, new_cap);
    store64(m, new_meta);
    store64(m + 8, new_keys);
    store64(m + 16, new_vals);
    store64(m + 24, new_cap);
    store64(m + 32, 0);
    store64(m + 40, 0);
    # Reinsert all entries (no trigger check: the new table holds them with room to spare)
    var oi = 0;
    while (oi < old_cap) {
        var st = load8(old_meta + oi);
        if (st != 0) {
            if (st != 255) {
                _fhm_insert(m, load64(old_keys + oi * 8), load64(old_vals + oi * 8));
            }
        }
        oi = oi + 1;
    }
    return 0;
}

# Check if key exists. Returns 1 or 0.
fn fhm_has(m, key): i64 {
    var meta = load64(m);
    var keys = load64(m + 8);
    var cap = load64(m + 24);
    var h = _fhm_hash(key);
    var h2 = _fhm_h2(h);
    var idx = (h & (cap - 1)) & (0 - 16);
    var probes = 0;
    while (probes < cap) {
        var mask = _fhm_probe16(meta, idx, h2);
        while (mask != 0) {
            var si = idx + _fhm_ctz(mask);
            if (streq(load64(keys + si * 8), key) == 1) { return 1; }
            mask = mask & (mask - 1);
        }
        var empty = _fhm_empty16(meta, idx);
        if (empty != 0) { return 0; }
        idx = (idx + 16) & (cap - 1);
        probes = probes + 16;
    }
    return 0;
}

# Delete key. Returns 1 if found, 0 if not.
fn fhm_delete(m, key): i64 {
    var meta = load64(m);
    var keys = load64(m + 8);
    var cap = load64(m + 24);
    var h = _fhm_hash(key);
    var h2 = _fhm_h2(h);
    var idx = (h & (cap - 1)) & (0 - 16);
    var probes = 0;
    while (probes < cap) {
        var mask = _fhm_probe16(meta, idx, h2);
        while (mask != 0) {
            var si = idx + _fhm_ctz(mask);
            if (streq(load64(keys + si * 8), key) == 1) {
                store64(m + 32, load64(m + 32) - 1);
                # A group that still has an empty slot ends every probe that reaches it, so
                # nothing lies "past" this slot and it can go back to EMPTY. Only a full
                # group needs the tombstone. (Groups are 16-aligned, and a group that was
                # full when a later key was placed can never regain an empty — so this
                # cannot strand an entry.) CHANGELOG [6.6.8]
                if (_fhm_empty16(meta, idx) != 0) {
                    store8(meta + si, _FHM_EMPTY);
                } else {
                    store8(meta + si, _FHM_TOMB);
                    store64(m + 40, load64(m + 40) + 1);
                }
                return 1;
            }
            mask = mask & (mask - 1);
        }
        var empty = _fhm_empty16(meta, idx);
        if (empty != 0) { return 0; }
        idx = (idx + 16) & (cap - 1);
        probes = probes + 16;
    }
    return 0;
}

# Get all keys as a vec
fn fhm_keys(m): i64 {
    var result = vec_new();
    var meta = load64(m);
    var keys = load64(m + 8);
    var cap = load64(m + 24);
    var i = 0;
    while (i < cap) {
        var st = load8(meta + i);
        if (st != 0) { if (st != 255) { vec_push(result, load64(keys + i * 8)); } }
        i = i + 1;
    }
    return result;
}

# Get all values as a vec
fn fhm_values(m): i64 {
    var result = vec_new();
    var meta = load64(m);
    var vals = load64(m + 16);
    var cap = load64(m + 24);
    var i = 0;
    while (i < cap) {
        var st = load8(meta + i);
        if (st != 0) { if (st != 255) { vec_push(result, load64(vals + i * 8)); } }
        i = i + 1;
    }
    return result;
}

# Clear all entries
fn fhm_clear(m): i64 {
    memset(load64(m), 0, load64(m + 24));
    store64(m + 32, 0);
    store64(m + 40, 0);
    return 0;
}

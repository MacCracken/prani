# chrono.cyr — time and duration utilities
# Usage: include "lib/chrono.cyr"
# Includes its own definers (6.6.9): syscalls.cyr (clock_gettime; the agnos uptime/sleep
# wrappers), alloc.cyr + string.cyr (the formatters), atomic.cyr (the init fence).
# v6.5.39: atomic.cyr, for the aarch64 release fence on the lazy-init publish below.
# ⚠ MEASURED ZERO COST: alloc.cyr already pulls atomic.cyr and includes are once-only, so
# adding this changed NOTHING — A/B on tests/tcyr/stdlib/chrono.tcyr is byte-identical on
# x86-linux, PE and the bare-metal kernel fixture. The proposal listed the include cost as
# part of the decision; it is not.
include "lib/atomic.cyr"
# 6.6.9: the syscall peer (sys_uptime_us / sys_time_unix / sys_sleep_ms on agnos), alloc and
# string were all called and none included. CHANGELOG [6.6.9]
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"

var CLOCK_REALTIME = 0;
var CLOCK_MONOTONIC = 1;

# Windows monotonic nanoseconds from QueryPerformanceCounter.
#
# ⛔ v6.6.5 — THE TWO ROUTES ARE SPELLED RAW HERE ON PURPOSE. The first cut of this bite
# called `sys_qpc_ns()` from lib/syscalls_windows.cyr, which made chrono.cyr STOP BEING
# SELF-SUFFICIENT: this file includes only atomic.cyr, every other clock arm in it is a
# bare `syscall(...)` builtin, and a consumer whose `[deps] stdlib` lists "chrono" without
# "syscalls" therefore stopped building for PE with `undefined function 'sys_qpc_ns'`.
# Nothing in-repo caught it (every in-repo consumer pulls lib/syscalls.cyr) and the
# vendoring closure cannot rescue it either — it derives its edges from
# literal `include "lib/X.cyr"` lines, and there is no chrono→syscalls edge. Pinned by
# tests/gates/toolchain/bench_timer_floor_measured.sh axis E, which
# cross-builds a chrono-only consumer for PE. CHANGELOG [6.6.5].
#
# 0xF038 = 61496 → kernel32!QueryPerformanceCounter(LARGE_INTEGER*)
# 0xF039 = 61497 → kernel32!QueryPerformanceFrequency(LARGE_INTEGER*)
# Both return the Win32 BOOL and write a 64-bit count at the pointer argument.
#
# The ns conversion is SPLIT so it cannot overflow: a raw `count * 1e9` wraps i64 after
# ~29 years of uptime at a 10 MHz counter. A non-positive frequency (impossible on any
# supported Windows) falls back to GetTickCount64 × 1e6 — coarse beats wrong-scaled and
# silent. Mirrors lib/syscalls_windows.cyr's sys_qpc_ns; the two are pinned to agree by
# the same gate axis.
var _chrono_qpf_hz = 0;
#ifdef CYRIUS_TARGET_AGNOS
var _chrono_agnos_ms40 = 0;   # 1 once #95 has answered < 0 — see clock_now_ns
#endif
fn _chrono_qpc_ns(): i64 {
    #ifdef CYRIUS_TARGET_WIN
    var c[16];
    if (_chrono_qpf_hz == 0) {
        store64(&c, 0);
        syscall(61497, &c);                  # QueryPerformanceFrequency(&hz)
        _chrono_qpf_hz = load64(&c);
    }
    if (_chrono_qpf_hz <= 0) {
        return syscall(228, 1, &c) * 1000000;    # GetTickCount64 ms -> ns
    }
    store64(&c, 0);
    syscall(61496, &c);                      # QueryPerformanceCounter(&count)
    var t = load64(&c);
    return (t / _chrono_qpf_hz) * 1000000000 + ((t % _chrono_qpf_hz) * 1000000000) / _chrono_qpf_hz;
    #endif
    return 0;
}

# Get current time in nanoseconds (monotonic clock).
#
# ⛔ v6.6.1 — AGNOS NOW READS #95 (uptime_us, rdtsc), NOT #40 (uptime_ms, timer_ticks).
# A foreground `run` program on AGNOS executes with IF CLEARED — only /bin/agnsh gets IF=1 —
# so the 100 Hz timer ISR never fires, `timer_ticks` never advances, and #40 is FROZEN for
# that program's entire run. Anything timing itself with it measured exactly zero, forever,
# with no error. #95 is read via rdtsc and needs no interrupts, so it is the only correct
# monotonic source on that path.
#
# ⚠ The trap was already documented TWO FILES AWAY, above the wrapper this function did not
# call (`lib/syscalls_x86_64_agnos.cyr`, sys_uptime_us): "*#95 is the only correct clock
# there*". AGNOS's own ABI note records that it cost two iron burns on the 3D arc's rung-10
# gate before it was understood. The general-purpose clock still walked into it for four
# minors. Filed 2026-09-07 from sakshi's 2.5.0 P(-1) audit.
#
# v6.2.6 bound it to #40 and that was correct WHEN WRITTEN — #95 did not exist yet.
# Resolution improves as a side effect: µs rather than the 10 ms tick.
#
# ⛔ #95 ANSWERS -1 WHEN TSC CALIBRATION WAS REFUSED, and that is PERMANENT for the boot (and
# ALWAYS under mirshi, which does not emulate #95). Multiplying the sentinel gave -1000 ns and
# clock_now_ms truncated it to exactly 0 — a clock that stood still, so every
# `while (clock_now_ms() - t0 < N)` wait on such a boot spun forever. So: #95 first, and on
# the first negative answer LATCH to #40 (since agnos 1.57.7 #40 rides the calibrated TSC and
# on a refused boot it is ticks x10, degraded but advancing). The latch, not a per-call retry:
# one ENOSYS line under mirshi instead of one per read, one syscall per read instead of two,
# and it cannot jump BACKWARDS from ms-since-boot to µs-since-calibration on a TSC_SELFTEST
# kernel where #95 can turn valid mid-run. An idempotent scalar every thread computes the
# same way, like _chrono_qpf_hz above. ⚠ On agnos <= 1.57.6 a foreground program on a
# refused boot has NO working clock at all (#40 is frozen at IF=0). CHANGELOG [6.6.7]
fn clock_now_ns(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    if (_chrono_agnos_ms40 == 0) {
        var us = sys_uptime_us();
        if (us >= 0) { return us * 1000; }
        _chrono_agnos_ms40 = 1;
    }
    return sys_uptime_ms() * 1000000;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var ts[16];
    #ifdef CYRIUS_TARGET_MACOS
    # v6.2.13 (issue 2026-06-16): the **arm64** Mach-O backend routes syscall(228)
    # to libSystem `_clock_gettime_nsec_np(clock_id)`, which RETURNS the ns count
    # in the return register — it does NOT fill the `&ts` timespec. So take the
    # return value (ns) with the Darwin id; `&ts` is just the 3rd-arg placeholder
    # the route expects.
    # x86-macOS takes this SAME arm and is not "dead": since v6.5.16 EMACHO_CLOCK_X86 issues
    # BSD gettimeofday and returns ns in rax — the same return-value contract. For clock id 0
    # it is the timeval composed to ns (wall time, µs resolution); for EVERY other id, since
    # 6.6.12, it is the mach_absolute_time gettimeofday copies out through its third argument,
    # which is ns at Intel's 1:1 timebase — so this id-4 read is monotonic there too (until
    # 6.6.12 the id was ignored and it was the REALTIME clock). It ALSO writes a timeval into
    # `&ts` for every id, which is why nothing may read the buffer. This line read "x86-macOS
    # does not route 228 → clock stays dead there; HELD" until 6.6.8; lib/bench.cyr's twin was
    # corrected at 6.6.5.
    # ⚠ The raw-228 contract across the reroutes is "returns the value; the buffer is
    # unspecified": ns in the return register on both Macs (ms on PE, GetTickCount64), with
    # arm64-macOS and PE never touching the buffer and x86-macOS filling a timeval. Portable
    # code calls clock_now_ns() rather than spelling 228. CHANGELOG [6.6.8]
    #
    # ⚠ v6.6.5: id **4** (CLOCK_MONOTONIC_RAW → mach_continuous_time), not 6. Darwin's
    # CLOCK_MONOTONIC (6) is `gettimeofday - boottime` in Apple's Libc
    # (gen/clock_gettime.c) and its `clock_getres` is NSEC_PER_USEC — MICROSECOND
    # resolution, which is the 1,000 ns tick measured on ecb and ach. lib/sakshi.cyr and
    # src/backend/common/runtime.cyr `_prof_clock_ns` already passed 4. CHANGELOG [6.6.5].
    return syscall(228, 4, &ts);
    #endif
    #ifdef CYRIUS_TARGET_WIN
    # v6.6.5: QueryPerformanceCounter (PE reroutes 0xF038/0xF039), ~100 ns tick.
    # v6.2.13 bound this to syscall(228) → kernel32!GetTickCount64, whose counter
    # advances in **15 ms** steps — so every duration under 15 ms measured as 0 or as
    # one whole tick, on every cyrius program on Windows. QPC is the monotonic source
    # (since system start; never wraps in practice). Spelled raw in `_chrono_qpc_ns`
    # above so this module stays self-sufficient — see the note there.
    return _chrono_qpc_ns();
    #endif
    #ifndef CYRIUS_TARGET_MACOS
    #ifndef CYRIUS_TARGET_WIN
    syscall(228, CLOCK_MONOTONIC, &ts);
    return load64(&ts) * 1000000000 + load64(&ts + 8);
    #endif
    #endif
    #endif
}

# Get current time in milliseconds (monotonic)
fn clock_now_ms(): i64 {
    return clock_now_ns() / 1000000;
}

# Get current epoch seconds (wall clock). v6.2.3: agnos now has a real
# wall clock via time_unix(#46, RTC-derived) — returns whole Unix seconds
# (no sub-second), or 0 if the RTC is mid-update/unreadable (callers treat
# 0 as "unknown", not epoch; sigil's _x509_in_window skips the cert window
# when now==0). This is what tls_native's cert-validity check binds to.
fn clock_epoch_secs(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_time_unix();
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var ts[16];
    #ifdef CYRIUS_TARGET_MACOS
    # v6.2.13: Darwin CLOCK_REALTIME=0; _clock_gettime_nsec_np RETURNS ns since
    # epoch → /1e9 = whole seconds (see clock_now_ns for the return-vs-buffer note).
    return syscall(228, 0, &ts) / 1000000000;
    #endif
    #ifdef CYRIUS_TARGET_WIN
    # v6.2.13: Windows has no clock_gettime — GetSystemTimeAsFileTime (PE reroute
    # 0xF01B) fills a FILETIME (100ns ticks since 1601-01-01 UTC) at &ts; convert
    # to Unix epoch seconds: /1e7 (100ns→s) minus the 1601→1970 gap (11644473600 s).
    syscall(0xF01B, &ts);
    return load64(&ts) / 10000000 - 11644473600;
    #endif
    #ifndef CYRIUS_TARGET_MACOS
    #ifndef CYRIUS_TARGET_WIN
    syscall(228, CLOCK_REALTIME, &ts);
    return load64(&ts);
    #endif
    #endif
    #endif
}

# Get current epoch nanoseconds (wall clock). v6.2.3: agnos derives ns from
# the whole-second time_unix(#46) — sub-second resolution is unavailable
# (RTC granularity), so the low 9 digits are always zero. 0 stays "unknown".
fn clock_epoch_ns(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_time_unix() * 1000000000;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var ts[16];
    #ifdef CYRIUS_TARGET_MACOS
    # v6.2.13: Darwin CLOCK_REALTIME=0; _clock_gettime_nsec_np RETURNS ns since
    # epoch directly (see clock_now_ns for the return-vs-buffer note).
    return syscall(228, 0, &ts);
    #endif
    #ifdef CYRIUS_TARGET_WIN
    # v6.2.13: GetSystemTimeAsFileTime (0xF01B) fills a FILETIME (100ns ticks since
    # 1601) at &ts; shift to the 1970 epoch (116444736000000000 ticks) and ×100 → ns.
    syscall(0xF01B, &ts);
    return (load64(&ts) - 116444736000000000) * 100;
    #endif
    #ifndef CYRIUS_TARGET_MACOS
    #ifndef CYRIUS_TARGET_WIN
    syscall(228, CLOCK_REALTIME, &ts);
    return load64(&ts) * 1000000000 + load64(&ts + 8);
    #endif
    #endif
    #endif
}

# Duration struct: {secs: i64, nsecs: i64} = 16 bytes
fn dur_new(secs, nsecs): i64 {
    var d = alloc(16);
    if (d == 0) { return 0; }
    store64(d, secs);
    store64(d + 8, nsecs);
    return d;
}

# Get seconds component of a duration
fn dur_secs(d): i64 { return load64(d); }
# Get nanoseconds component of a duration
fn dur_nsecs(d): i64 { return load64(d + 8); }

# Convert duration to total milliseconds
fn dur_to_ms(d): i64 {
    return load64(d) * 1000 + load64(d + 8) / 1000000;
}

# Convert duration to total nanoseconds
fn dur_to_ns(d): i64 {
    return load64(d) * 1000000000 + load64(d + 8);
}

# Measure elapsed time between two ns timestamps
fn dur_between(start_ns, end_ns): i64 {
    var diff = end_ns - start_ns;
    return dur_new(diff / 1000000000, diff % 1000000000);
}

# Sleep for ms milliseconds (blocking). Portable across targets — v6.0.65
# replaced the raw `syscall(35)` (Linux nanosleep) that faulted off Linux:
# Darwin has NO plain `nanosleep` BSD syscall (XNU implements it over
# semaphore primitives) and PE never routed 35, so on macOS/Windows the old
# body emitted a bad `svc`/illegal-instruction. `poll(NULL, 0, ms)` is the
# portable ms-granular sleep — `poll` (syscall 7 → Darwin 230) is already
# rerouted on both Mach-O backends and works on Linux; Windows uses kernel32
# `Sleep`. v6.2.6: agnos binds the real sleep_ms (#41, since kernel 1.43.x;
# was a no-op fall-through through v6.2.5 under the obsolete "no sleep in the
# frozen 0-33 surface" note, which made every agnos poll loop busy-spin).
# See CHANGELOG [6.0.65]/[6.2.6], issues 2026-06-04-macos-nanosleep-syscall-35-not-in-esysxlat,
# 2026-06-14-chrono-agnos-monotonic-sleep-stale-stubs.
# `ms` < 0 sleeps 0 and `ms` > INT_MAX sleeps INT_MAX (~24.8 days), on EVERY arm. ⛔ Until 6.6.20
# only agnos guarded it: poll's timeout is a C int where a negative value means "no limit", and
# Sleep's is a DWORD, so a computed `sleep_ms(deadline - now)` that had gone negative hung for
# ever on Linux and macOS (~49.7 days on Windows), and 2^32 + 5 slept 5 ms. CHANGELOG [6.6.20]
fn sleep_ms(ms): i64 {
    var t = ms;
    if (t < 0) { t = 0; }
    if (t > 0x7FFFFFFF) { t = 0x7FFFFFFF; }
    #ifdef CYRIUS_TARGET_AGNOS
    if (t <= 0) { return 0; }
    sys_sleep_ms(t);                # sleep_ms(ms) — #41, blocks ~ms
    return 0;
    #endif
    #ifdef CYRIUS_TARGET_WIN
    # Sleep(ms) via kernel32 (PE reroute 0xF00F). nanosleep(35) was never routed
    # on PE, and WaitForSingleObject on the current process/thread pseudo-handle
    # returns immediately (doesn't block) — verified on cass — so a real Sleep
    # reroute is the correct path.
    syscall(0xF00F, t);             # Sleep(ms)
    return 0;
    #endif
    #ifdef CYRIUS_TARGET_MACOS
    syscall(7, 0, 0, t);            # poll(NULL, 0, ms) — 7→230 on Darwin
    return 0;
    #endif
    #ifdef CYRIUS_TARGET_LINUX
    syscall(7, 0, 0, t);            # poll(NULL, 0, ms)
    return 0;
    #endif
    # cx + any other target: no-op (agnos handled above)
    return 0;
}

# ================================================================
# ISO-8601 formatting and parsing
# ================================================================

# Days in each month (non-leap)
var _chrono_mdays = 0;
fn _chrono_init_mdays(): i64 {
    if (_chrono_mdays != 0) { return 0; }
    # ⛔ v6.5.37 — FILL A LOCAL, PUBLISH LAST. The global used to be assigned the
    # alloc() result on the FIRST statement, so between that assignment and the twelfth
    # store64 the table was reachable by another thread and READ AS ZEROS. A concurrent
    # `epoch_to_date` then divided by a zero month length and returned **month 13** —
    # silent, wrong, and only under threads. Found by a samay v1.0.4 concurrency audit
    # (docs/development/proposals/2026-08-30-lazy-init-publish-before-fill.md).
    #
    # ⚠ This is a CLASS, not an incident: the same audit found the identical shape in
    # patra's own `src/pcache.cyr` (fixed upstream at patra 1.13.11, folded here at
    # v6.5.37). ⚠ The proposal originally also named `lib/patra.cyr:453` — that was
    # misfiled: patra.cyr is a GENERATED bundle and a fix there evaporates on the next
    # `cyrius distlib`. Fix the source repo, never the fold.
    #
    # A tree-wide sweep for `if (_g != 0) { return }` followed by `_g = alloc(...)` with
    # stores after the publish found this as the ONLY remaining site in lib/, cbt/ and
    # src/ at 6.5.37.
    #
    # Single-threaded callers see no behaviour change: the table is fully built before
    # anything can observe a non-zero pointer, which is what the guard already promised.
    var t = alloc(96);
    if (t == 0) { return 0 - 1; }
    store64(t, 31);       # Jan
    store64(t + 8, 28);   # Feb
    store64(t + 16, 31);  # Mar
    store64(t + 24, 30);  # Apr
    store64(t + 32, 31);  # May
    store64(t + 40, 30);  # Jun
    store64(t + 48, 31);  # Jul
    store64(t + 56, 31);  # Aug
    store64(t + 64, 30);  # Sep
    store64(t + 72, 31);  # Oct
    store64(t + 80, 30);  # Nov
    store64(t + 88, 31);  # Dec
    # v6.5.39 — RELEASE FENCE before the publishing store. Filling a local and publishing
    # last (v6.5.37) fixes the PROGRAM-ORDER race and is mutation-proven on x86: 0 of 400
    # threaded runs go wrong on the live tree, against 29 of 400 with the pre-.37
    # publish-first shape restored. It does NOT fix the MEMORY-ORDER race. cyrius emits no
    # ordering whatsoever for ordinary global access on aarch64 — disassembling a threaded
    # aarch64 binary built from this file shows the guard read as a plain `ldr`, this
    # publish as a plain `str`, and the whole binary containing zero `stlr`, zero `ldar`
    # and exactly one `dmb` (inside atomic_fence's own body). So on a weak model another
    # thread can observe `_chrono_mdays` non-null before the twelve `store64`s that filled
    # it — the same month-13 bug, one level down.
    #
    # ⚠ AARCH64 ONLY, and the precedent matters. The proposal said to copy
    # `lib/alloc.cyr:89-98`, which fences on BOTH arches. That is the OLD shape: x86-TSO
    # already orders store-store, so the fence there is pure tax — measured ~22 ns, 83 % of
    # the lock cost — and the project deliberately removed it in `lib/freelist.cyr:128-134`
    # (CHANGELOG [6.5.x]: "a correction, not an omission... the aarch64 release fence is
    # REQUIRED and is kept"). This copies freelist, not alloc.
    #
    # ⚠ The reader is safe with a writer-side fence ONLY because it has an address
    # dependency on the published pointer (it loads `_chrono_mdays`, then loads through
    # it), which aarch64 honours. A flag publish with no such dependency needs an acquire
    # on the reader too — which is why `lib/regex.cyr` is deliberately NOT fenced here.
    #ifdef CYRIUS_ARCH_AARCH64
    atomic_fence();
    #endif
    _chrono_mdays = t;    # publish only once the table is complete

    return 0;
}

# Check leap year
fn is_leap_year(y): i64 {
    if (y % 4 != 0) { return 0; }
    if (y % 100 != 0) { return 1; }
    if (y % 400 != 0) { return 0; }
    return 1;
}

# Decode epoch seconds into the 48-byte {year, month, day, hour, min, sec} at `r`, which
# the caller owns (a stack buffer is fine). Allocates nothing once the month table exists.
# Returns r, or 0 when the month table could not be allocated (its first use, under a
# refused alloc). CHANGELOG [6.6.12]
fn _epoch_to_date_into(epoch, r): i64 {
    _chrono_init_mdays();
    if (_chrono_mdays == 0) { return 0; }     # 6.6.10: the month table could not be allocated
    var secs = epoch;
    var days = secs / 86400;
    var rem = secs % 86400;
    store64(r + 24, rem / 3600);          # hour
    rem = rem % 3600;
    store64(r + 32, rem / 60);            # min
    store64(r + 40, rem % 60);            # sec
    # Civil date from day count (days since 1970-01-01)
    var y = 1970;
    var yd = 365;
    while (days >= yd) {
        days = days - yd;
        y = y + 1;
        yd = 365;
        if (is_leap_year(y) == 1) { yd = 366; }
    }
    store64(r, y);                         # year
    var m = 0;
    while (m < 12) {
        var md = load64(_chrono_mdays + m * 8);
        if (m == 1) { if (is_leap_year(y) == 1) { md = 29; } }
        if (days < md) { break; }
        days = days - md;
        m = m + 1;
    }
    store64(r + 8, m + 1);                # month (1-indexed)
    store64(r + 16, days + 1);            # day (1-indexed)
    return r;
}

# Convert epoch seconds to date components {year, month, day, hour, min, sec}
# Returns alloc'd 48-byte struct, or 0 when an allocation is refused.
fn epoch_to_date(epoch): i64 {
    _chrono_init_mdays();
    if (_chrono_mdays == 0) { return 0; }     # 6.6.10: the month table could not be allocated
    var r = alloc(48);
    if (r == 0) { return 0; }
    return _epoch_to_date_into(epoch, r);
}

# Write 2-digit zero-padded number to buffer
fn _chrono_w2(buf, pos, val): i64 {
    store8(buf + pos, 48 + val / 10);
    store8(buf + pos + 1, 48 + val % 10);
    return 0;
}

# Write 4-digit year to buffer
fn _chrono_w4(buf, pos, val): i64 {
    store8(buf + pos, 48 + val / 1000);
    store8(buf + pos + 1, 48 + (val / 100) % 10);
    store8(buf + pos + 2, 48 + (val / 10) % 10);
    store8(buf + pos + 3, 48 + val % 10);
    return 0;
}

# Format epoch seconds as ISO-8601: "2026-04-09T15:30:00Z"
# Returns null-terminated string (alloc'd)
fn iso8601(epoch): i64 {
    var d = epoch_to_date(epoch);
    if (d == 0) { return 0; }
    var buf = alloc(24);
    if (buf == 0) { return 0; }
    _chrono_w4(buf, 0, load64(d));       # year
    store8(buf + 4, 45);                  # -
    _chrono_w2(buf, 5, load64(d + 8));   # month
    store8(buf + 7, 45);                  # -
    _chrono_w2(buf, 8, load64(d + 16));  # day
    store8(buf + 10, 84);                 # T
    _chrono_w2(buf, 11, load64(d + 24)); # hour
    store8(buf + 13, 58);                 # :
    _chrono_w2(buf, 14, load64(d + 32)); # min
    store8(buf + 16, 58);                 # :
    _chrono_w2(buf, 17, load64(d + 40)); # sec
    store8(buf + 19, 90);                 # Z
    store8(buf + 20, 0);
    return buf;
}

# Format current time as ISO-8601
fn iso8601_now(): i64 {
    return iso8601(clock_epoch_secs());
}

# Parse ISO-8601 string "YYYY-MM-DDTHH:MM:SSZ" to epoch seconds
# Returns epoch seconds or -1 on parse error
fn iso8601_parse(s): i64 {
    var len = strlen(s);
    if (len < 19) { return 0 - 1; }
    # Parse digits
    var yr = (load8(s) - 48) * 1000 + (load8(s + 1) - 48) * 100 +
    (load8(s + 2) - 48) * 10 + (load8(s + 3) - 48);
    var mo = (load8(s + 5) - 48) * 10 + (load8(s + 6) - 48);
    var dy = (load8(s + 8) - 48) * 10 + (load8(s + 9) - 48);
    var hr = (load8(s + 11) - 48) * 10 + (load8(s + 12) - 48);
    var mn = (load8(s + 14) - 48) * 10 + (load8(s + 15) - 48);
    var sc = (load8(s + 17) - 48) * 10 + (load8(s + 18) - 48);
    # Validate ranges
    if (mo < 1) { return 0 - 1; }
    if (mo > 12) { return 0 - 1; }
    if (dy < 1) { return 0 - 1; }
    if (hr > 23) { return 0 - 1; }
    if (mn > 59) { return 0 - 1; }
    if (sc > 59) { return 0 - 1; }
    # Convert to epoch: days from 1970
    _chrono_init_mdays();
    var days = 0;
    var y = 1970;
    while (y < yr) {
        days = days + 365;
        if (is_leap_year(y) == 1) { days = days + 1; }
        y = y + 1;
    }
    var m = 1;
    while (m < mo) {
        days = days + load64(_chrono_mdays + (m - 1) * 8);
        if (m == 2) { if (is_leap_year(yr) == 1) { days = days + 1; } }
        m = m + 1;
    }
    days = days + dy - 1;
    return days * 86400 + hr * 3600 + mn * 60 + sc;
}

# ================================================================
# DateTime / Duration / strftime format() — the 2026-07-18 proposal
# (docs/development/proposals/2026-07-18-chrono-datetime-duration-format.md).
# All additive, UTC only, all i64 math. A DateTime is a bare epoch-NANOSECOND
# i64 handle (consistent with clock_epoch_ns; i64 ns overflows ~year 2262).
# ================================================================

# --- DateTime: a wall-clock instant (epoch nanoseconds) ---
# Current wall-clock instant (Utc::now()).
fn dt_now(): i64 { return clock_epoch_ns(); }
# Build a DateTime from epoch seconds.
fn dt_from_epoch_secs(s): i64 { return s * 1000000000; }
# Build a DateTime from epoch nanoseconds.
fn dt_from_epoch_ns(ns): i64 { return ns; }
# Epoch seconds of a DateTime.
fn dt_epoch_secs(dt): i64 { return dt / 1000000000; }
# Epoch nanoseconds of a DateTime.
fn dt_epoch_ns(dt): i64 { return dt; }

# One field of a DateTime, decoded into a STACK buffer. -1 only when the month table could
# never be allocated (0 cannot be the sentinel: it is a valid hour, minute and second).
#
# ⛔ Through 6.6.11 each accessor was `load64(epoch_to_date(..) + off)`: an alloc(48) per
# call that was never freed (48 B leaked per field read), and a SIGSEGV once 6.6.10 taught
# epoch_to_date to return 0 on a refused allocation. CHANGELOG [6.6.12]
fn _dt_field(dt, off): i64 {
    var d[48];
    if (_epoch_to_date_into(dt / 1000000000, &d) == 0) { return 0 - 1; }
    return load64(&d + off);
}

# Year (UTC), or -1 when the month table could not be allocated.
fn dt_year(dt): i64   { return _dt_field(dt, 0); }
# Month 1-12 (UTC), or -1 when the month table could not be allocated.
fn dt_month(dt): i64  { return _dt_field(dt, 8); }
# Day of month 1-31 (UTC), or -1 when the month table could not be allocated.
fn dt_day(dt): i64    { return _dt_field(dt, 16); }
# Hour 0-23 (UTC), or -1 when the month table could not be allocated.
fn dt_hour(dt): i64   { return _dt_field(dt, 24); }
# Minute 0-59 (UTC), or -1 when the month table could not be allocated.
fn dt_minute(dt): i64 { return _dt_field(dt, 32); }
# Second 0-59 (UTC), or -1 when the month table could not be allocated.
fn dt_second(dt): i64 { return _dt_field(dt, 40); }

# --- Duration: Rust-chrono-style unit constructors (reuse the {secs,nsecs} dur_new) ---
# Duration of n seconds (Duration::seconds).
fn dur_seconds(n): i64 { return dur_new(n, 0); }
# Duration of n minutes (Duration::minutes).
fn dur_minutes(n): i64 { return dur_new(n * 60, 0); }
# Duration of n hours (Duration::hours).
fn dur_hours(n): i64   { return dur_new(n * 3600, 0); }
# Duration of n days (Duration::days).
fn dur_days(n): i64    { return dur_new(n * 86400, 0); }
# Duration of n weeks.
fn dur_weeks(n): i64   { return dur_new(n * 604800, 0); }
# Duration of n milliseconds.
fn dur_millis(n): i64  { return dur_new(n / 1000, (n % 1000) * 1000000); }
# Duration of n nanoseconds.
fn dur_nanos(n): i64   { return dur_new(n / 1000000000, n % 1000000000); }

# Whole seconds in a Duration (Rust num_seconds()).
fn dur_num_seconds(d): i64 { return dur_secs(d); }
# Whole minutes in a Duration.
fn dur_num_minutes(d): i64 { return dur_secs(d) / 60; }
# Whole hours in a Duration.
fn dur_num_hours(d): i64   { return dur_secs(d) / 3600; }
# Whole days in a Duration.
fn dur_num_days(d): i64    { return dur_secs(d) / 86400; }
# Total milliseconds in a Duration.
fn dur_num_millis(d): i64  { return dur_to_ms(d); }
# Total nanoseconds in a Duration.
fn dur_num_nanos(d): i64   { return dur_to_ns(d); }

# Sum of two Durations.
fn dur_add(a, b): i64 { return dur_nanos(dur_to_ns(a) + dur_to_ns(b)); }
# Difference of two Durations (a - b).
fn dur_sub(a, b): i64 { return dur_nanos(dur_to_ns(a) - dur_to_ns(b)); }

# --- DateTime +/- Duration ---
# DateTime shifted forward by a Duration.
fn dt_add(dt, dur): i64 { return dt + dur_to_ns(dur); }
# DateTime shifted backward by a Duration.
fn dt_sub(dt, dur): i64 { return dt - dur_to_ns(dur); }
# Duration between two DateTimes (a - b).
fn dt_diff(a, b): i64   { return dur_nanos(a - b); }

# --- strftime-style format() ---

# Day-of-year (1-366) for a civil date.
fn _chrono_day_of_year(year, month, day): i64 {
    _chrono_init_mdays();
    var doy = day;
    var m = 1;
    while (m < month) {
        doy = doy + load64(_chrono_mdays + (m - 1) * 8);
        if (m == 2) { if (is_leap_year(year) == 1) { doy = doy + 1; } }
        m = m + 1;
    }
    return doy;
}

# Emit one strftime specifier `s` at out+op; returns chars written. Numeric subset
# (%% %Y %y %m %d %e %H %M %S %j); names (%A %a %B %b %p) are a documented Tier-2
# extension. An unknown specifier is emitted verbatim as "%<c>".
fn _chrono_emit_spec(out, op, s, year, month, day, hour, minute, second): i64 {
    if (s == 89)   { _chrono_w4(out, op, year); return 4; }            # %Y
    elif (s == 121) { _chrono_w2(out, op, year % 100); return 2; }     # %y
    elif (s == 109) { _chrono_w2(out, op, month); return 2; }          # %m
    elif (s == 100) { _chrono_w2(out, op, day); return 2; }            # %d
    elif (s == 101) {                                                  # %e (space-padded day)
        var tens = 32;                                                 # ' '
        if (day >= 10) { tens = 48 + day / 10; }
        store8(out + op, tens);
        store8(out + op + 1, 48 + day % 10);
        return 2;
    }
    elif (s == 72)  { _chrono_w2(out, op, hour); return 2; }           # %H
    elif (s == 77)  { _chrono_w2(out, op, minute); return 2; }         # %M
    elif (s == 83)  { _chrono_w2(out, op, second); return 2; }         # %S
    elif (s == 106) {                                                  # %j (day-of-year 001-366)
        var doy = _chrono_day_of_year(year, month, day);
        store8(out + op, 48 + doy / 100);
        store8(out + op + 1, 48 + (doy / 10) % 10);
        store8(out + op + 2, 48 + doy % 10);
        return 3;
    }
    elif (s == 37)  { store8(out + op, 37); return 1; }               # %%
    store8(out + op, 37);                                              # unknown -> "%<c>"
    store8(out + op + 1, s);
    return 2;
}

# Format a DateTime with a strftime string -> alloc'd null-terminated Str.
# Generalizes iso8601(); iso8601() is kept as the fast fixed-form path.
fn dt_format(dt, fmt): i64 {
    var d = epoch_to_date(dt / 1000000000);
    if (d == 0) { return 0; }
    var year = load64(d);
    var month = load64(d + 8);
    var day = load64(d + 16);
    var hour = load64(d + 24);
    var minute = load64(d + 32);
    var second = load64(d + 40);
    var flen = strlen(fmt);
    var out = alloc(flen * 4 + 16);              # each spec expands to <= 4 chars
    if (out == 0) { return 0; }
    var op = 0;
    var i = 0;
    while (i < flen) {
        var c = load8(fmt + i);
        if (c == 37) {                            # '%'
            if (i + 1 < flen) {
                op = op + _chrono_emit_spec(out, op, load8(fmt + i + 1), year, month, day, hour, minute, second);
                i = i + 2;
            } else {
                store8(out + op, 37);             # trailing '%'
                op = op + 1;
                i = i + 1;
            }
        } else {
            store8(out + op, c);
            op = op + 1;
            i = i + 1;
        }
    }
    store8(out + op, 0);
    return out;
}

# Read `n` decimal digits from s+pos as an integer, or -1 if any char is not a digit.
fn _chrono_rd(s, pos, n): i64 {
    var v = 0;
    var k = 0;
    while (k < n) {
        var ch = load8(s + pos + k);
        if (ch < 48) { return 0 - 1; }
        if (ch > 57) { return 0 - 1; }
        v = v * 10 + (ch - 48);
        k = k + 1;
    }
    return v;
}

# Civil {y,mo,dy,hr,mn,sc} -> epoch SECONDS (UTC). Mirrors iso8601_parse's
# conversion, kept separate so iso8601_parse stays byte-identical.
fn _chrono_ymd_to_epoch_secs(yr, mo, dy, hr, mn, sc): i64 {
    _chrono_init_mdays();
    var days = 0;
    var y = 1970;
    while (y < yr) {
        days = days + 365;
        if (is_leap_year(y) == 1) { days = days + 1; }
        y = y + 1;
    }
    var m = 1;
    while (m < mo) {
        days = days + load64(_chrono_mdays + (m - 1) * 8);
        if (m == 2) { if (is_leap_year(yr) == 1) { days = days + 1; } }
        m = m + 1;
    }
    days = days + dy - 1;
    return days * 86400 + hr * 3600 + mn * 60 + sc;
}

# Parse a string per a strftime format -> epoch NANOSECONDS, or -1 on mismatch.
# Numeric specifiers read a fixed-width field (%Y=4; %y/%m/%d/%e/%H/%M/%S=2; %j=3);
# non-`%` format chars must match the input literally. Mirrors iso8601_parse's contract.
fn dt_strptime(s, fmt): i64 {
    var slen = strlen(s);
    var flen = strlen(fmt);
    var year = 1970;
    var month = 1;
    var day = 1;
    var hour = 0;
    var minute = 0;
    var second = 0;
    var doy = 0;
    var fi = 0;
    var si = 0;
    while (fi < flen) {
        var c = load8(fmt + fi);
        if (c == 37) {                            # '%'
            if (fi + 1 >= flen) { return 0 - 1; }
            var spec = load8(fmt + fi + 1);
            fi = fi + 2;
            if (spec == 37) {                     # %% -> literal '%'
                if (si >= slen) { return 0 - 1; }
                if (load8(s + si) != 37) { return 0 - 1; }
                si = si + 1;
            } elif (spec == 89) {                 # %Y
                if (si + 4 > slen) { return 0 - 1; }
                year = _chrono_rd(s, si, 4);
                if (year < 0) { return 0 - 1; }
                si = si + 4;
            } elif (spec == 121) {                # %y (2-digit -> 2000+)
                if (si + 2 > slen) { return 0 - 1; }
                var gy = _chrono_rd(s, si, 2);
                if (gy < 0) { return 0 - 1; }
                year = 2000 + gy;
                si = si + 2;
            } elif (spec == 109) {                # %m
                if (si + 2 > slen) { return 0 - 1; }
                month = _chrono_rd(s, si, 2);
                if (month < 0) { return 0 - 1; }
                si = si + 2;
            } elif (spec == 100) {                # %d
                if (si + 2 > slen) { return 0 - 1; }
                day = _chrono_rd(s, si, 2);
                if (day < 0) { return 0 - 1; }
                si = si + 2;
            } elif (spec == 101) {                # %e (space- or zero-padded day)
                if (si + 2 > slen) { return 0 - 1; }
                var c1 = load8(s + si + 1);
                if (c1 < 48) { return 0 - 1; }
                if (c1 > 57) { return 0 - 1; }
                var tens = 0;
                if (load8(s + si) != 32) {
                    if (load8(s + si) < 48) { return 0 - 1; }
                    if (load8(s + si) > 57) { return 0 - 1; }
                    tens = (load8(s + si) - 48) * 10;
                }
                day = tens + (c1 - 48);
                si = si + 2;
            } elif (spec == 72) {                 # %H
                if (si + 2 > slen) { return 0 - 1; }
                hour = _chrono_rd(s, si, 2);
                if (hour < 0) { return 0 - 1; }
                si = si + 2;
            } elif (spec == 77) {                 # %M
                if (si + 2 > slen) { return 0 - 1; }
                minute = _chrono_rd(s, si, 2);
                if (minute < 0) { return 0 - 1; }
                si = si + 2;
            } elif (spec == 83) {                 # %S
                if (si + 2 > slen) { return 0 - 1; }
                second = _chrono_rd(s, si, 2);
                if (second < 0) { return 0 - 1; }
                si = si + 2;
            } elif (spec == 106) {                # %j (day-of-year; resolved below)
                if (si + 3 > slen) { return 0 - 1; }
                doy = _chrono_rd(s, si, 3);
                if (doy < 0) { return 0 - 1; }
                si = si + 3;
            } else {                              # unknown spec: require literal "%<c>"
                if (si + 2 > slen) { return 0 - 1; }
                if (load8(s + si) != 37) { return 0 - 1; }
                if (load8(s + si + 1) != spec) { return 0 - 1; }
                si = si + 2;
            }
        } else {
            if (si >= slen) { return 0 - 1; }
            if (load8(s + si) != c) { return 0 - 1; }
            si = si + 1;
            fi = fi + 1;
        }
    }
    # Resolve %j (day-of-year) to month/day if it was the source of the date.
    if (doy > 0) {
        _chrono_init_mdays();
        var rem = doy;
        var mm = 0;
        while (mm < 12) {
            var md = load64(_chrono_mdays + mm * 8);
            if (mm == 1) { if (is_leap_year(year) == 1) { md = 29; } }
            if (rem <= md) { break; }
            rem = rem - md;
            mm = mm + 1;
        }
        month = mm + 1;
        day = rem;
    }
    # Range validation (same guards as iso8601_parse).
    if (month < 1) { return 0 - 1; }
    if (month > 12) { return 0 - 1; }
    if (day < 1) { return 0 - 1; }
    if (hour > 23) { return 0 - 1; }
    if (minute > 59) { return 0 - 1; }
    if (second > 59) { return 0 - 1; }
    return _chrono_ymd_to_epoch_secs(year, month, day, hour, minute, second) * 1000000000;
}

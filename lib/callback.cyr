# callback.cyr — closure-like patterns via function pointers
# Usage: include "lib/callback.cyr"
# Includes its own definers: syscalls.cyr, fnptr.cyr, vec.cyr (6.6.9 added the last two — the
# vec_* calls were undefined in a bare include). CHANGELOG [6.6.9]
include "lib/syscalls.cyr"
include "lib/fnptr.cyr"
include "lib/vec.cyr"
#
# Cyrius doesn't have closures. This library provides callback patterns
# that replace common closure uses: for_each, filter, map, pre_exec.

# Apply fn(item) to each element of a vec.
# Speculative iterator-style API; no current downstream consumer
# claims it (audited v5.11.21). Revisit at v5.12.x agent-runtime
# work; v6.0.0 dead-code sweep is the deprecation window if
# unclaimed. See docs/audit/2026-05-11-zero-call-stdlib.md.
fn for_each(v, fp): i64 {
    var len = vec_len(v);
    var fi = 0;
    while (fi < len) {
        fncall1(fp, vec_get(v, fi));
        fi = fi + 1;
    }
    return 0;
}

# Filter: return new vec containing items where fn(item) returns 1
fn vec_filter(v, fp): i64 {
    var out = vec_new();
    var len = vec_len(v);
    var fi = 0;
    while (fi < len) {
        var item = vec_get(v, fi);
        if (fncall1(fp, item) == 1) {
            vec_push(out, item);
        }
        fi = fi + 1;
    }
    return out;
}

# Map: return new vec with fn(item) applied to each element
fn vec_map(v, fp): i64 {
    var out = vec_new();
    var len = vec_len(v);
    var fi = 0;
    while (fi < len) {
        vec_push(out, fncall1(fp, vec_get(v, fi)));
        fi = fi + 1;
    }
    return out;
}

# Fold/reduce: accumulate with fn(acc, item)
fn vec_fold(v, init, fp): i64 {
    var acc = init;
    var len = vec_len(v);
    var fi = 0;
    while (fi < len) {
        acc = fncall2(fp, acc, vec_get(v, fi));
        fi = fi + 1;
    }
    return acc;
}

# Any: return 1 if fn(item) returns 1 for any element
fn vec_any(v, fp): i64 {
    var len = vec_len(v);
    var fi = 0;
    while (fi < len) {
        if (fncall1(fp, vec_get(v, fi)) == 1) { return 1; }
        fi = fi + 1;
    }
    return 0;
}

# All: return 1 if fn(item) returns 1 for all elements
fn vec_all(v, fp): i64 {
    var len = vec_len(v);
    var fi = 0;
    while (fi < len) {
        if (fncall1(fp, vec_get(v, fi)) == 0) { return 0; }
        fi = fi + 1;
    }
    return 1;
}

# Find: return first item where fn(item) returns 1, or 0 (not found)
fn vec_find_by(v, fp): i64 {
    var len = vec_len(v);
    var fi = 0;
    while (fi < len) {
        var item = vec_get(v, fi);
        if (fncall1(fp, item) == 1) { return item; }
        fi = fi + 1;
    }
    return 0;
}

# Pre-exec pattern: fork, run callback in child, then exec
# cb_fn(cb_data) is called in the child process before exec.
# Returns pid of child to parent, or -1 on fork error.
#
# v6.3.24: guarded out on agnos. agnos has fork#96 (1.56.55) but NO execve: a process cannot
# replace its own image, and a program is started from disk only by the PARENT, through
# spawn_path#43 — so there is no "between fork and exec" moment for a pre-exec callback to run
# in, and no peer to write. sys_execve is undefined there, and because a consumer that lists
# `callback` in cyrius.cyml `stdlib` pulls the WHOLE module, an unguarded fork_with_pre_exec
# stayed reachable-undefined and hard-failed EVERY `--agnos` build (bit phylax, which uses only
# the pure vec_* helpers). The higher-order helpers above are pure fnptr code and stay available
# on every target; only this fork/exec entry is absent on agnos. (This read "no fork/execve ...
# agnos's in-memory-ELF spawn" until 6.6.10; fork was minted at v6.5.37 and lib/process_agnos
# spawns from disk since 6.6.8. CHANGELOG [6.6.10])
# See issues/archived/2026-07-01-callback-fork-with-pre-exec-unguarded-agnos.md.
#ifndef CYRIUS_TARGET_AGNOS
fn fork_with_pre_exec(cmd, argv, envp, cb_fn, cb_data): i64 {
    var pid = sys_fork();
    if (pid < 0) { return pid; }
    if (pid == 0) {
        # Child: run pre_exec callback
        if (cb_fn != 0) {
            fncall1(cb_fn, cb_data);
        }
        sys_execve(cmd, argv, envp);
        sys_exit(127);
    }
    return pid;
}
#endif

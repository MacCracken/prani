# assert.cyr — test assertion library
# Usage: include "lib/assert.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
# v5.8.34: failing-allocator test harness (`fail_after_n_allocs`)
# is layered on top of v5.8.33's test_allocator. Transitively
# pulled in here so test consumers get the full assertion +
# OOM-driving stack from a single include.
include "lib/alloc.cyr"
# v6.2.38: syscalls peer for the portable `sys_exit` used by panic() /
# assert_fatal() below (arch-dispatched: SYS_EXIT 60/93/0, Win ExitProcess).
# Double-include-safe; pulls only DCE-dead wrappers into test consumers.
include "lib/syscalls.cyr"
# v6.6.6: fmt.cyr's fmt_sprintf/fmt_printf take a Vec of args and call vec_get,
# but fmt.cyr does not include its definer (its contract is "the consumer
# includes my deps" — same as strlen from string.cyr above). Nothing caught the
# gap on x86/aarch64, where an uncalled fmt_sprintf makes vec_get merely
# UNREACHABLE and the dangling call a warning. The cx backend has no DCE, so the
# call site is emitted and its undefined-call gate hard-errors: `include
# "lib/assert.cyr"` alone did not compile for cx, so NO .tcyr could run on cxvm.
# alloc.cyr is already included above, which is what vec_new/vec_push need.
include "lib/vec.cyr"
#
# Now that comparisons work in function arguments, assert(x == 42, "name") works.

var _assert_pass = 0;
var _assert_fail = 0;
var _assert_total = 0;

# Assert condition is true, print FAIL with name if not
fn assert(cond, name): i64 {
    _assert_total = _assert_total + 1;
    if (cond == 1) {
        _assert_pass = _assert_pass + 1;
    } else {
        _assert_fail = _assert_fail + 1;
        syscall(1, 2, "  FAIL: ", 8);
        syscall(1, 2, name, strlen(name));
        syscall(1, 2, "\n", 1);
    }
    return 0;
}

# Fail-loud runtime panic — print `msg` to stderr (fd 2), then ABORT.
# Unlike assert() (a test-harness check: print-and-continue, tallied by
# assert_summary), panic() STOPS the process. Use it for runtime
# precondition guards in library/runtime code, where continuing past a
# violated invariant would corrupt memory in a no-bounds-checking
# language. Portable: sys_exit dispatches per target (incl. Windows
# ExitProcess). Filed by tarka 0.8.0; see CHANGELOG [6.2.38].
fn panic(msg): i64 {
    syscall(1, 2, "panic: ", 7);
    syscall(1, 2, msg, strlen(msg));
    syscall(1, 2, "\n", 1);
    sys_exit(1);
    return 0;                 # unreachable — keeps the i64 return well-formed
}

# Fail-loud assertion: like assert() but ABORTS on a violated condition
# instead of tallying it. Keeps the test/runtime distinction explicit at
# the call site — reach for this (not assert) in non-test guard code.
fn assert_fatal(cond, msg): i64 {
    if (cond == 0) { panic(msg); }
    return 0;
}

# Assert a equals b, print expected vs got on failure
fn assert_eq(a, b, name): i64 {
    _assert_total = _assert_total + 1;
    if (a == b) {
        _assert_pass = _assert_pass + 1;
    } else {
        _assert_fail = _assert_fail + 1;
        syscall(1, 2, "  FAIL: ", 8);
        syscall(1, 2, name, strlen(name));
        # ⚠ efmt_int, NOT fmt_int (v6.5.19). fmt_int writes to fd 1 while every other
        # byte of this message goes to fd 2, so any harness that captures the two
        # streams separately — scripts/cross-os-libtest-runner.sh, every cross-OS ssh
        # probe, `2> err` in the gates — saw `FAIL: name (got , expected )` with the
        # two numbers orphaned in stdout, unattached to the assertion that produced
        # them. It cost real time diagnosing the ecb/ach bench_timer_floor failure.
        syscall(1, 2, " (got ", 6);
        efmt_int(a);
        syscall(1, 2, ", expected ", 11);
        efmt_int(b);
        syscall(1, 2, ")\n", 2);
    }
    return 0;
}

# Assert a does not equal b
fn assert_neq(a, b, name): i64 {
    assert(a != b, name);
    return 0;
}

# Assert a is greater than b
fn assert_gt(a, b, name): i64 {
    assert(a > b, name);
    return 0;
}

# Assert a < b
fn assert_lt(a, b, name): i64 {
    assert(a < b, name);
    return 0;
}

# Assert a >= b
fn assert_gte(a, b, name): i64 {
    assert(a >= b, name);
    return 0;
}

# Assert a <= b
fn assert_lte(a, b, name): i64 {
    assert(a <= b, name);
    return 0;
}

# Assert pointer is not null (0)
fn assert_nonnull(p, name): i64 {
    _assert_total = _assert_total + 1;
    if (p != 0) {
        _assert_pass = _assert_pass + 1;
    } else {
        _assert_fail = _assert_fail + 1;
        syscall(1, 2, "  FAIL: ", 8);
        syscall(1, 2, name, strlen(name));
        syscall(1, 2, " (got null)\n", 12);
    }
    return 0;
}

# Assert string equals expected (cstr comparison)
fn assert_streq(a, b, name): i64 {
    _assert_total = _assert_total + 1;
    if (streq(a, b) == 1) {
        _assert_pass = _assert_pass + 1;
    } else {
        _assert_fail = _assert_fail + 1;
        syscall(1, 2, "  FAIL: ", 8);
        syscall(1, 2, name, strlen(name));
        syscall(1, 2, " (strings differ)\n", 18);
    }
    return 0;
}

# Print test group header
fn test_group(name): i64 {
    syscall(1, 1, "=== ", 4);
    syscall(1, 1, name, strlen(name));
    syscall(1, 1, " ===\n", 5);
    return 0;
}

# ================================================================
# v5.8.34 — Failing-allocator test harness
# ================================================================
# Returns an Allocator (from lib/alloc.cyr's `test_allocator()`)
# configured to fail after `n` successful alloc_via calls. Drives
# OOM-handling tcyr coverage for any consumer that takes an
# Allocator parameter. Pinned at roadmap §v5.8.34; the v5.8.35-37
# stdlib migration threads Allocator through vec/str/hashmap and
# json/toml/cyml/http/sandhi so this harness drives their OOM
# tests directly.
#
# Semantics (matches `test_allocator_fail_after`):
#   alloc 1   .. alloc N    succeed (return non-zero ptrs)
#   alloc N+1 ..             return 0
# Pass `n = 0` to fail every alloc; pass `n = -1` to never fail
# (same as bare test_allocator()). `test_allocator_alloc_count(a)`
# reads the running counter (includes failed allocs); `reset_via(a)`
# clears the counter without touching the global bump.

# Build a test_allocator that fails after `n` successful allocs.
# Use with `alloc_via(a, size)` from lib/alloc.cyr; the (n+1)-th
# call returns 0 instead of a real pointer.
fn fail_after_n_allocs(n): i64 {
    var a = test_allocator();
    if (a == 0) { return 0; }
    test_allocator_fail_after(a, n);
    return a;
}

# ── v6.6.6: a per-process scratch path for a test fixture. CHANGELOG [6.6.6]
#
# ⛔ WHY. `tests/tcyr/crossos/{atomic_write,syscalls_meta,uid_identity}.tcyr` created
# `cyrius_atomic_test.txt`, `_vr01_mdir`, `_uid_identity_probe.bin` and friends at FIXED,
# CWD-RELATIVE names — and the check driver's cwd is the REPO ROOT (and `~/_cyaud` on
# ecb/ach/cass/pi). Two check.sh runs in one checkout therefore raced over the same files, and
# a killed run left them in the tree. The paths are cwd-relative on purpose — `/tmp` does not
# exist on Windows, where the cross-OS leg runs in `C:\cyrius-tests` — and the runner cannot
# simply chdir the children, because other tests in the same corpus read TREE-relative paths.
#
# ⭐ So the fix is in the NAME, not the directory: `<base>.<pid>` is unique to the process, so
# concurrent runs cannot collide on any target, and it stays a cwd-relative path with no `/`.
# The test still removes it; the pid only means a killed run cannot poison the next one.
# ⚠ Use it for EVERY fixture a test creates. tests/gates/toolchain/gates_never_write_tree.sh
# axis 8 refuses a bare relative literal at a creating call in tests/.
fn _assert_pid(): i64 {
    #ifdef CYRIUS_TARGET_WIN
    return syscall(0xF01C);          # kernel32!GetCurrentProcessId
    #endif
    #ifndef CYRIUS_TARGET_WIN
    return sys_getpid();
    #endif
}

# Returns `base` with this process's pid appended ("<base>.<pid>"), as a fresh NUL-terminated
# cstring — the name a test should give any fixture it creates. Still cwd-relative and free of
# "/", so it works on every target including PE; see the note above for why that matters.
# A refused allocation PANICS by name (exit 1): a test has no fixture name to fall back to,
# and the unchecked store it replaced was a SIGSEGV natively and a silent write to guest
# offset 0 on cx. CHANGELOG [6.6.10]
fn test_scratch(base): i64 {
    var bl = strlen(base);
    var buf = alloc(bl + 32);
    if (buf == 0) { panic("test_scratch: alloc refused the fixture name"); }
    memcpy(buf, base, bl);
    store8(buf + bl, 46);            # '.'
    var digits[24];
    fmt_int_buf(_assert_pid(), &digits);
    var dl = strlen(&digits);
    memcpy(buf + bl + 1, &digits, dl);
    store8(buf + bl + 1 + dl, 0);
    return buf;
}

# Print pass/fail summary and return number of failures
fn assert_summary(): i64 {
    # 6.6.18: under CYRIUS_POISON the summary sweeps every poisoned block first, so an
    # overwrite nothing else looked at still fails the run. Counted (not a pass) only when bad.
    #ifdef CYRIUS_POISON
    var pz = poison_sweep();
    if (pz > 0) { assert_eq(pz, 0, "poison_sweep(): blocks with a changed redzone"); }
    #endif
    syscall(1, 1, "\n", 1);
    fmt_int(_assert_pass);
    syscall(1, 1, " passed, ", 9);
    fmt_int(_assert_fail);
    syscall(1, 1, " failed (", 9);
    fmt_int(_assert_total);
    syscall(1, 1, " total)\n", 8);
    return _assert_fail;
}

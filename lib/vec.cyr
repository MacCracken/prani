# vec.cyr — dynamic array (vector)
# Usage: include "lib/alloc.cyr" then include "lib/vec.cyr"
# Requires alloc_init() called first.
#
# A Vec is a heap-allocated struct: { data_ptr, len, cap }
# Elements are 8 bytes each (i64).
#
# v5.8.12 §4: a vec's FIRST 16 BYTES are byte-identical to
# lib/slice.cyr's slice convention (`data` at offset 0, `len`
# at offset 8). Consequence: a vec value passes directly to
# slice_ptr / slice_len / slice_is_empty / slice_is_null /
# slice_eq without conversion. The `cap` field at offset 16 is
# vec-only (slice helpers never touch offset 16+). Use
# `vec_as_slice(dst, v)` (lib/slice.cyr) to copy the slice-
# prefix into a stack slot — useful for snapshotting v's
# current view before a possible vec_push reallocation.
#
# >>> include "lib/alloc.cyr"
# >>> include "lib/vec.cyr"
# >>> alloc_init(); var v = vec_new();
# >>> vec_push(v, 10); vec_push(v, 20); vec_push(v, 12);
# >>> var r = vec_len(v);
# === 3

# v5.8.35 — Allocator-as-first-arg variant of vec_new.
# Allocates the 24-byte vec header + 16-slot data buffer through
# the supplied Allocator. Returns 0 if either allocation fails
# (caller must check). Pair with `vec_push_a(a, v, val)` to keep
# the same allocator threaded through grows.
fn vec_new_a(a): i64 {
    var v = alloc_via(a, 24);
    if (v == 0) { return 0; }
    var cap = 16;
    var data = alloc_via(a, cap * 8);
    if (data == 0) { return 0; }
    store64(v, data);
    store64(v + 8, 0);
    store64(v + 16, cap);
    return v;
}

# Create a new empty vector with initial capacity 16. v5.8.35
# wrapper — delegates to vec_new_a with the process-wide
# default_alloc(). Aborts on OOM via vec_new_a's caller protocol
# (returns 0; this back-compat wrapper mirrors the pre-v5.8.35
# behavior of trusting the global bump to never run out).
fn vec_new(): i64 {
    return vec_new_a(default_alloc());
}

# Return the number of elements in the vector
fn vec_len(v): i64 {
    return load64(v + 8);
}

# Return the current capacity of the vector
fn vec_cap(v): i64 {
    return load64(v + 16);
}

# v6.0.56: target-aware fatal exit. agnos exit is syscall(0), not Linux's
# syscall(60) (out of agnos's 0-33 range → a no-op that lets a fatal error
# path keep running). Kept raw — vec.cyr is deliberately syscalls.cyr-free.
fn _vec_die(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    syscall(0, 1);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # CVE-22 (v6.1.34): exit(1) — the backend translates 60 to the per-target
    # exit (Darwin/PE/aarch64). v6.0.56 regressed this to `_vec_die()` (infinite
    # self-recursion → stack-overflow SIGSEGV instead of a clean abort).
    syscall(60, 1);
    #endif
    return 0;
}

# Get element at index, abort if out of bounds
fn vec_get(v, idx): i64 {
    if (idx < 0) { syscall(1, 2, "vec: index < 0\n", 15); _vec_die(); }
    if (idx >= load64(v + 8)) { syscall(1, 2, "vec: index out of bounds\n", 25); _vec_die(); }
    var data = load64(v);
    return load64(data + idx * 8);
}

# Set element at index, abort if out of bounds
fn vec_set(v, idx, val): i64 {
    if (idx < 0) { syscall(1, 2, "vec: index < 0\n", 15); _vec_die(); }
    if (idx >= load64(v + 8)) { syscall(1, 2, "vec: index out of bounds\n", 25); _vec_die(); }
    var data = load64(v);
    store64(data + idx * 8, val);
    return 0;
}

# Maximum vec capacity (2^28 = 268M elements, 2GB data)
var VEC_CAP_MAX = 0x10000000;

# v5.8.35 — Allocator-as-first-arg variant of vec_push. Routes the
# 2x grow allocation through `a`. Returns 0 on success, -1 on
# grow OOM (the back-compat `vec_push` aborts the process instead;
# new code should prefer this variant + the OOM-handling pattern).
# Mixing allocators across pushes on the same vec is permitted but
# scatters allocations — for arena-scoped vecs, use the same arena
# Allocator across all pushes.
fn vec_push_a(a, v, val): i64 {
    var len = load64(v + 8);
    var cap = load64(v + 16);
    if (len >= cap) {
        var old_data = load64(v);
        var new_cap = cap * 2;
        if (new_cap > VEC_CAP_MAX) {
            syscall(1, 2, "vec: capacity overflow\n", 23);
            _vec_die();
        }
        var new_data = alloc_via(a, new_cap * 8);
        if (new_data == 0) { return 0 - 1; }
        for (var ci = 0; ci < len; ci = ci + 1) {
            store64(new_data + ci * 8, load64(old_data + ci * 8));
        }
        store64(v, new_data);
        store64(v + 16, new_cap);
    }
    var data = load64(v);
    store64(data + len * 8, val);
    store64(v + 8, len + 1);
    return 0;
}

# Append a value to the end, growing if needed. v5.8.35 wrapper —
# delegates to vec_push_a with default_alloc(). Aborts on grow
# OOM (matching pre-v5.8.35 behavior). New code should prefer
# vec_push_a for graceful OOM handling.
fn vec_push(v, val): i64 {
    var rc = vec_push_a(default_alloc(), v, val);
    if (rc < 0) {
        syscall(1, 2, "vec: alloc failed\n", 18);
        _vec_die();
    }
    return 0;
}

# Remove and return the last element, or 0 if empty
fn vec_pop(v): i64 {
    var len = load64(v + 8);
    if (len == 0) { return 0; }
    len = len - 1;
    store64(v + 8, len);
    var data = load64(v);
    return load64(data + len * 8);
}

# Shrink the vector to `new_len` (a no-op if new_len >= current len).
# The underlying capacity + data slots are preserved — subsequent
# vec_push reuses the existing buffer, so this is the bounded-memory
# save/restore primitive for per-fn / per-scope reset patterns where
# vec_new + free would leak under a bump allocator.
fn vec_truncate(v, new_len): i64 {
    if (new_len < 0) { return 0; }
    var cur_len = load64(v + 8);
    if (new_len >= cur_len) { return 0; }
    store64(v + 8, new_len);
    return 0;
}

# Find first occurrence of val, return index or -1
fn vec_find(v, val): i64 {
    var len = load64(v + 8);
    for (var fi = 0; fi < len; fi = fi + 1) {
        if (vec_get(v, fi) == val) { return fi; }
    }
    return 0 - 1;
}

# Remove element at index, shift remaining left
fn vec_remove(v, idx): i64 {
    var len = load64(v + 8);
    if (idx < 0) { return 0 - 1; }
    if (idx >= len) { return 0 - 1; }
    var data = load64(v);
    for (var ri = idx; ri < len - 1; ri = ri + 1) {
        store64(data + ri * 8, load64(data + (ri + 1) * 8));
    }
    store64(v + 8, len - 1);
    return 0;
}

# v6.5.4 — ordering primitives. Closes the agnosai filing
# (2026-07-28-agnosai-no-nlogn-sort-in-stdlib): until now lib/ carried NO
# general-purpose comparator-driven ordering routine at all, so ~26 first-party
# repos each hand-rolled one and two independently built a full O(n log n).
#
# `cmp(a, b)` returns <0 if a orders before b, 0 if equivalent, >0 if after —
# the sign is all that is read, so a plain `a - b` works for i64 keys. It is
# invoked through fncall2 (lib/fnptr.cyr, pulled in by lib/alloc.cyr:380), NOT
# through the `callptr` builtin: callptr is a hard compile error on the cx
# backend (src/backend/cx/emit.cyr ECALLIND), and because lib/vec.cyr is
# auto-prepended into every build a callptr here would break every cx program
# — even one that never sorts, since the error fires when the *uncalled* body
# is emitted. fncall2 is what lib/alloc.cyr and lib/hashmap.cyr already use.
#
# All helpers below take the raw data pointer with lo/hi INCLUSIVE, and index
# `data + i * 8` directly rather than going through vec_get/vec_set — those pay
# two bounds branches per access, which on an O(n log n) comparison count is the
# dominant cost. The public entry points do the bounds checking once.
include "lib/fnptr.cyr"

# Swap the elements at slots i and j (raw data pointer, no bounds check)
fn _vec_swap(data, i, j): i64 {
    var t = load64(data + i * 8);
    store64(data + i * 8, load64(data + j * 8));
    store64(data + j * 8, t);
    return 0;
}

# Insertion sort of data[lo..hi] inclusive — O(n) on already-ordered input,
# which is why it is also the small-range cutoff for the introsort below
fn _vec_insertion(data, lo, hi, cmp): i64 {
    for (var ii = lo + 1; ii <= hi; ii = ii + 1) {
        var x = load64(data + ii * 8);
        var ij = ii - 1;
        while (ij >= lo) {
            var c = fncall2(cmp, load64(data + ij * 8), x);
            if (c <= 0) { break; }
            store64(data + (ij + 1) * 8, load64(data + ij * 8));
            ij = ij - 1;
        }
        store64(data + (ij + 1) * 8, x);
    }
    return 0;
}

# Index of the median of data[a], data[b], data[c] — the pivot choice that keeps
# quicksort out of its O(n^2) case on sorted and reverse-sorted input
fn _vec_med3(data, a, b, c, cmp): i64 {
    var va = load64(data + a * 8);
    var vb = load64(data + b * 8);
    var vc = load64(data + c * 8);
    if (fncall2(cmp, va, vb) < 0) {
        if (fncall2(cmp, vb, vc) < 0) { return b; }
        if (fncall2(cmp, va, vc) < 0) { return c; }
        return a;
    }
    if (fncall2(cmp, va, vc) < 0) { return a; }
    if (fncall2(cmp, vb, vc) < 0) { return c; }
    return b;
}

# Hoare partition of data[lo..hi] around a median-of-3 pivot VALUE; returns the
# split point j, so the halves are [lo..j] and [j+1..hi]. Hoare (not Lomuto) is
# deliberate: on all-identical keys both scans advance, giving an even split,
# where Lomuto degenerates to O(n^2) and a naive variant spins forever.
fn _vec_hoare(data, lo, hi, cmp): i64 {
    var m = _vec_med3(data, lo, lo + (hi - lo) / 2, hi, cmp);
    var pivot = load64(data + m * 8);
    var pi = lo - 1;
    var pj = hi + 1;
    while (1 == 1) {
        pi = pi + 1;
        while (fncall2(cmp, load64(data + pi * 8), pivot) < 0) { pi = pi + 1; }
        pj = pj - 1;
        while (fncall2(cmp, load64(data + pj * 8), pivot) > 0) { pj = pj - 1; }
        if (pi >= pj) { return pj; }
        _vec_swap(data, pi, pj);
    }
    return pj;
}

# Sift data[lo + root] down through a max-heap of n elements based at data[lo]
fn _vec_sift(data, lo, n, root, cmp): i64 {
    var r = root;
    while (1 == 1) {
        var child = 2 * r + 1;
        if (child >= n) { return 0; }
        if (child + 1 < n) {
            var cl = load64(data + (lo + child) * 8);
            var cr = load64(data + (lo + child + 1) * 8);
            if (fncall2(cmp, cl, cr) < 0) { child = child + 1; }
        }
        var pv = load64(data + (lo + r) * 8);
        var cv = load64(data + (lo + child) * 8);
        if (fncall2(cmp, pv, cv) >= 0) { return 0; }
        _vec_swap(data, lo + r, lo + child);
        r = child;
    }
    return 0;
}

# Heapsort data[lo..hi] — O(n log n) WORST case with O(1) extra memory and no
# recursion; the introsort depth-limit fallback, so a hostile input degrades to
# heapsort rather than to quicksort's quadratic case
fn _vec_heapsort(data, lo, hi, cmp): i64 {
    var n = hi - lo + 1;
    for (var hi2 = n / 2 - 1; hi2 >= 0; hi2 = hi2 - 1) { _vec_sift(data, lo, n, hi2, cmp); }
    for (var he = n - 1; he > 0; he = he - 1) {
        _vec_swap(data, lo, lo + he);
        _vec_sift(data, lo, he, 0, cmp);
    }
    return 0;
}

# Floor of log2(n) for n >= 1 (`>>` is LOGICAL in cyrius; n is always positive)
fn _vec_log2(n): i64 {
    var r = 0;
    var x = n;
    while (x > 1) { x = x >> 1; r = r + 1; }
    return r;
}

# Introsort of data[lo..hi]: median-of-3 quicksort, falling back to heapsort at
# the depth limit and to insertion sort below the 16-element cutoff. Recurses
# into the SMALLER side and loops on the larger, which bounds stack depth to
# O(log n) rather than O(n) on an adversarial input.
fn _vec_introsort(data, lo, hi, depth, cmp): i64 {
    var l = lo;
    var h = hi;
    var d = depth;
    while (h - l > 16) {
        if (d <= 0) { _vec_heapsort(data, l, h, cmp); return 0; }
        d = d - 1;
        var p = _vec_hoare(data, l, h, cmp);
        if (p - l < h - p - 1) {
            _vec_introsort(data, l, p, d, cmp);
            l = p + 1;
        } else {
            _vec_introsort(data, p + 1, h, d, cmp);
            h = p;
        }
    }
    _vec_insertion(data, l, h, cmp);
    return 0;
}

# Sort the vector in place using `cmp` (a fn pointer from `&name`, called as
# cmp(a, b) → <0 / 0 / >0). O(n log n) worst case, O(1) extra memory — nothing
# is allocated, which matters under the default bump allocator where a merge
# sort's n-slot scratch would be leaked on every call. An O(n) pre-scan returns
# immediately when the input is already ordered, so the nearly-sorted inputs
# consumers feed it (directory listings, ascending ids) stay cheap. NOT named
# bare `vec_sort` — that is occupied by itihas/src/util.cyr:57 in cyrius's flat
# namespace, and last-definition-wins would silently displace it. Returns 0.
fn vec_sort_by(v, cmp): i64 {
    var len = load64(v + 8);
    if (len < 2) { return 0; }
    var data = load64(v);
    var ordered = 1;
    for (var si = 1; si < len; si = si + 1) {
        var c = fncall2(cmp, load64(data + (si - 1) * 8), load64(data + si * 8));
        if (c > 0) { ordered = 0; break; }
    }
    if (ordered == 1) { return 0; }
    _vec_introsort(data, 0, len - 1, 2 * _vec_log2(len), cmp);
    return 0;
}

# Return the element that would sit at index k if the vector were sorted by
# `cmp`, partitioning the vector in place around it (Hoare quickselect,
# median-of-3). O(n) expected — the reason percentiles never needed a full sort.
# Aborts on an out-of-range k, matching vec_get/vec_set rather than returning an
# in-band sentinel that a valid element could equal.
fn vec_select_nth(v, k, cmp): i64 {
    var len = load64(v + 8);
    if (k < 0) { syscall(1, 2, "vec: select_nth k < 0\n", 22); _vec_die(); }
    if (k >= len) { syscall(1, 2, "vec: select_nth out of bounds\n", 30); _vec_die(); }
    var data = load64(v);
    var l = 0;
    var h = len - 1;
    while (l < h) {
        var p = _vec_hoare(data, l, h, cmp);
        if (k <= p) { h = p; } else { l = p + 1; }
    }
    return load64(data + k * 8);
}

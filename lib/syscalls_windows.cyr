fn sys_setxattr(path, name, value, size, flags): i64 { return 0 - 38; }
# Set an extended attribute on a symlink itself. Declines, same reason as sys_setxattr.
fn sys_lsetxattr(path, name, value, size, flags): i64 { return 0 - 38; }
# Set an extended attribute by descriptor. Declines, same reason as sys_setxattr.
fn sys_fsetxattr(fd, name, value, size, flags): i64 { return 0 - 38; }
# Read an extended attribute. Declines, same reason as sys_setxattr.
fn sys_getxattr(path, name, value, size): i64 { return 0 - 38; }
# Read an extended attribute of a symlink itself. Declines, same reason as sys_setxattr.

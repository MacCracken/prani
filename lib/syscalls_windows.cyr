# syscalls_windows.cyr — Win32 API wrappers for Cyrius PE targets.
# Usage: include "lib/syscalls.cyr" (selector picks this peer when
#        CYRIUS_TARGET_WIN is defined by cycc_win.cyr; do NOT include
#        this file directly).
#
# Shipped v5.5.0 as the Windows-side counterpart to
# lib/syscalls_x86_64_linux.cyr and lib/syscalls_aarch64_linux.cyr.
# Covers the syscall surface that the cyrius PE backend reroutes at
# parse time (syscall(N, ...) → WriteFile / ReadFile / VirtualAlloc
# / ExitProcess etc. via the IAT).
#
# DESIGN NOTE: the SysNr constants below match the LINUX x86_64
# syscall numbers, not Win32 ordinals. This is intentional — the
# cyrius PE backend reroutes `syscall(N, ...)` calls based on N,
# mapping them to the appropriate kernel32.dll / ntdll.dll / etc.
# import at emit time. Keeping the numbers Linux-compatible means
# user code written to the `sys_write(fd, buf, len)` surface
# compiles on both Linux ELF and Windows PE without source changes.
#
# Syscalls WITHOUT a Win32 equivalent (fork, clone, futex, epoll,
# signalfd, etc.) are deliberately omitted — attempting to use
# them on Windows produces an undefined-syscall warning at compile
# time (escalatable to a hard error via `cycc_win --strict`).

# ================================================================
# Syscall numbers — cyrius cross-platform convention
# ================================================================
# These match Linux x86_64 numbers so cross-platform stdlib code
# can use a single constant name. The PE backend reroutes at emit.
enum SysNr {
    SYS_READ = 0;       # → ReadFile (via GetStdHandle for fd 0)
    SYS_WRITE = 1;      # → WriteFile (via GetStdHandle for fd 1/2)
    SYS_OPEN = 2;       # → CreateFileW
    SYS_CLOSE = 3;      # → CloseHandle
    SYS_LSEEK = 8;      # → SetFilePointerEx
    SYS_MMAP = 9;       # → VirtualAlloc(MEM_COMMIT|MEM_RESERVE)
    SYS_BRK = 12;       # NOT rerouted: -38 (-ENOSYS). The PE heap is mmap → VirtualAlloc
    SYS_MUNMAP = 11;    # → VirtualFree(addr, 0, MEM_RELEASE) since 6.6.20 (before: unrouted, -38)
    SYS_EXIT = 60;      # → ExitProcess
    SYS_EXIT_GROUP = 231; # NOT rerouted — call sys_exit_group(), never syscall(231)
    # v6.5.25 — NOT rerouted (Windows has no ioctl; DeviceIoControl is a different
    # contract and the request codes are Linux device numbers regardless). The constant
    # exists so cross-platform stdlib code that names it can COMPILE for PE: without it,
    # `lib/yukti.cyr`'s CD-ROM eject path made `undefined variable 'SYS_IOCTL'` a HARD
    # ERROR that blocked a PE build of yukti, vani and mabda — measured: rc=1 with 4 error
    # lines, clean rc=0 on Linux. Adding the constant is only safe as of v6.5.25, which
    # made an unrouted LITERAL syscall number return -38/-ENOSYS instead of emitting a raw
    # `0F 05` that traps as STATUS_ILLEGAL_INSTRUCTION (0xC000001D) on Windows; before
    # that, defining this would have swapped a loud compile error for a runtime crash.
    # Callers already handle the failure — yukti checks `if (r < 0)` and reports it.
    SYS_IOCTL = 16;
    # v6.6.5 — same "constant exists so cross-platform source COMPILES" contract as
    # SYS_IOCTL above, and safe for the same reason: since v6.5.25 an unrouted literal
    # syscall number returns -38/-ENOSYS instead of emitting a raw `0F 05` that traps as
    # STATUS_ILLEGAL_INSTRUCTION. NOT rerouted: Windows has no sendmsg/sendto (ws2_32's
    # WSASendMsg is a different contract and takes an OVERLAPPED) and no memfd (a named
    # section object is a different object model); the stub wrappers below decline explicitly
    # rather than issuing them. truncate/ftruncate are REAL since 6.6.9, built on SetEndOfFile
    # (0xF03F) + a seek — the numbers themselves stay unrouted, use the wrappers.
    # ⚠ SYS_NANOSLEEP is the exception — the PE backend HAS rerouted 35 to kernel32 Sleep
    # since v6.1.17 (ENANOSLEEP_PE), so sys_nanosleep issues it for real.
    SYS_SENDTO = 44;
    SYS_SENDMSG = 46;
    SYS_TRUNCATE = 76;
    SYS_FTRUNCATE = 77;
    SYS_MEMFD_CREATE = 319;
    SYS_NANOSLEEP = 35;
    SYS_SCHED_YIELD = 24;
    # v6.6.6 — the statfs pair, same "the constant exists so cross-platform source COMPILES"
    # contract, and NOT rerouted: Windows has no statfs. GetDiskFreeSpaceExW answers the same
    # question but is a kernel32 import with a different shape (three out-params, no struct,
    # wide path), so a row would be a lie; the stubs below decline explicitly. CHANGELOG [6.6.6]
    SYS_STATFS = 137;
    SYS_FSTATFS = 138;
    # v6.6.8 — namespaces, root, capabilities, cross-process memory, mknodat: the same
    # "the constant exists so cross-platform source COMPILES" contract, NOT rerouted — Windows
    # has none of these as a syscall. The stubs below decline explicitly. CHANGELOG [6.6.8]
    SYS_UNSHARE = 272;
    SYS_CHROOT = 161;
    SYS_PIVOT_ROOT = 155;
    SYS_CAPGET = 125;
    SYS_CAPSET = 126;
    SYS_PROCESS_VM_READV = 310;
    SYS_PROCESS_VM_WRITEV = 311;
    SYS_MKNODAT = 259;
    # 6.6.12 — the xattr family, fchown, statx and getrlimit: the same "the constant exists so
    # cross-platform source COMPILES" contract, NOT rerouted — Windows has no extended-attribute,
    # POSIX-owner, statx or rlimit syscall. The stubs below decline explicitly. CHANGELOG [6.6.12]
    SYS_SETXATTR = 188;
    SYS_LSETXATTR = 189;
    SYS_FSETXATTR = 190;
    SYS_GETXATTR = 191;
    SYS_LGETXATTR = 192;
    SYS_FGETXATTR = 193;
    SYS_LISTXATTR = 194;
    SYS_LLISTXATTR = 195;
    SYS_FLISTXATTR = 196;
    SYS_REMOVEXATTR = 197;
    SYS_LREMOVEXATTR = 198;
    SYS_FREMOVEXATTR = 199;
    SYS_FCHOWN = 93;
    SYS_STATX = 332;
    SYS_GETRLIMIT = 97;
}

# File descriptors mirror Linux convention. GetStdHandle maps
# STD_INPUT_HANDLE (-10) / STD_OUTPUT_HANDLE (-11) / STD_ERROR_HANDLE
# (-12) to these inside the PE reroute.
enum FdNr {
    STDIN_FD = 0;
    STDOUT_FD = 1;
    STDERR_FD = 2;
}

# Standard open flags (Linux-shaped; PE backend maps to Win32).
# Full fcntl.h subset — arithmetic on these is preserved in the
# reroute so `O_WRONLY | O_CREAT | O_TRUNC` computes correctly
# before translation to CreateFileW's dwDesiredAccess /
# dwCreationDisposition pair.
enum OFlags {
    O_RDONLY = 0;
    O_WRONLY = 1;
    O_RDWR = 2;
    O_CREAT = 64;       # 0100
    O_EXCL = 128;       # 0200
    O_TRUNC = 512;      # 01000
    O_APPEND = 1024;    # 02000
    # ⛔ v6.6.6 — the note that stood here said O_TRUNC and the access mode "are not
    # decoded", filed as a cosmetic gap alongside O_DIRECTORY/O_NOFOLLOW. It was not
    # cosmetic: an undecoded O_TRUNC means `open(p, O_WRONLY|O_CREAT|O_TRUNC)` SUCCEEDS
    # and then leaves the old tail of the file behind, and an undecoded O_APPEND
    # overwrites from offset 0. Silent data loss on every Windows rewrite. EOPEN_PE now
    # decodes the access mode, O_CREAT, O_EXCL, O_TRUNC and O_APPEND (`_pe_open_flags`,
    # src/backend/x86/emit.cyr); pinned by tests/tcyr/crossos/open_flag_translation.tcyr
    # on real cass. CHANGELOG [6.6.6]
    #
    # ⚠ TWO RESIDUAL DIVERGENCES, both from ONE Win32 rule: TRUNCATE_EXISTING is REFUSED
    # (ERROR_INVALID_PARAMETER) unless dwDesiredAccess carries GENERIC_WRITE — measured on
    # real cass; FILE_WRITE_DATA and FILE_APPEND_DATA do NOT satisfy it, and wine does not
    # enforce the rule at all. `_pe_open_flags` therefore adds GENERIC_WRITE whenever it
    # selects that disposition, which buys the POSIX-visible behaviour (the file IS
    # truncated) at the cost of:
    #   · `open(p, O_RDONLY|O_TRUNC)` — the Windows handle can also be written; Linux
    #     returns EBADF for a write on it. No caller in the ecosystem passes that pair.
    #   · `open(p, O_TRUNC|O_APPEND)` WITHOUT O_CREAT — the handle carries GENERIC_WRITE
    #     beside FILE_APPEND_DATA, so NT writes at the file pointer rather than at EOF. The
    #     file has just been truncated, so a single writer sees no difference; a concurrent
    #     appender would. (With O_CREAT the disposition is CREATE_ALWAYS, which needs no
    #     extra access, so the real append survives there.)
    #
    # ⭐ 6.6.9 — O_NOFOLLOW, O_DIRECTORY and O_EXCL HAVE THEIR POSIX MEANING ON PE. The note
    # that stood here called the first two a "semantic decision" and left them ignored; the
    # cost was measured on real cass: CreateFileW resolves a final reparse point for EVERY
    # disposition, so `O_CREAT|O_EXCL` over a DANGLING symlink created the symlink's TARGET
    # (with or without O_NOFOLLOW), and `O_WRONLY|O_TRUNC|O_NOFOLLOW` on a symlink truncated
    # the file it named. The map now (EOPEN_PE's `_pe_open_attr_flags` + `sys_open` below):
    #   · O_CREAT|O_EXCL → CREATE_NEW + FILE_FLAG_OPEN_REPARSE_POINT. CREATE_NEW never opens
    #     an existing object, so the flag cannot make it open a link; the name exists, so the
    #     create fails. Race-free, no check. (The raw syscall gets this too.)
    #   · O_NOFOLLOW → FILE_FLAG_OPEN_REPARSE_POINT, then `sys_open` asks the OPENED HANDLE
    #     (GetFileInformationByHandleEx, FileAttributeTagInfo): a NAME-SURROGATE reparse point
    #     (symlink, junction) is closed and refused with -ELOOP (-40). A junction or a link to a
    #     DIRECTORY is a directory object that CreateFileW refuses without BACKUP_SEMANTICS —
    #     before there is a handle to ask — so a FAILED O_NOFOLLOW open asks the name why, with a
    #     read-only O_DIRECTORY|O_NOFOLLOW probe that only picks the errno (-40 for a surrogate,
    #     -21 for a real directory under write access, else the original -1). Any OTHER reparse
    #     point (OneDrive placeholder, dedup) is reopened normally, as the default taken
    #     2026-09-27 says — those are files, not redirections — and that reopen by name must be
    #     the SAME FILE as the verified handle (file id), or it is refused. With O_TRUNC the open
    #     is made WITHOUT the truncation and the verified handle is truncated afterwards
    #     (SetEndOfFile), so a link object is never clobbered by the refusal either.
    #   · O_DIRECTORY → FILE_FLAG_BACKUP_SEMANTICS (the only way CreateFileW opens a directory)
    #     plus the handle check: a non-directory is -ENOTDIR (-20), a directory opened for
    #     writing (or with O_CREAT/O_TRUNC) is -EISDIR (-21). BACKUP_SEMANTICS is NEVER set
    #     without O_DIRECTORY: it would let O_WRONLY open a directory, so a plain open() of a
    #     directory stays -1 on Windows (fail-closed; Linux answers a read fd).
    # ⚠ The refusals live in `sys_open` (every stdlib open funnels through it). A RAW
    # `syscall(2, p, O_NOFOLLOW, 0)` still never follows a link — the attribute word is the
    # emitter's — but it hands back the LINK's handle instead of -40, and O_TRUNC on it
    # truncates the link object, not the target. CHANGELOG [6.6.9]
    O_DIRECTORY = 65536;
    O_NOFOLLOW = 131072;
}

# ================================================================
# Wrapper fns — the public surface
# ================================================================
# Thin wrappers around `syscall(N, ...)`. Parse-time rerouting in
# src/backend/pe/emit.cyr picks up each SYS_* and emits the Win32
# equivalent through the IAT.

# Write `count` bytes from `buf` to descriptor `fd`. Rerouted to
# kernel32!WriteFile via the PE IAT at emit time (v5.4.7 reroute).
# For fd 1/2 the PE backend inserts a GetStdHandle(-11/-12) call
# first so the WriteFile `hFile` arg is a real Windows handle.
fn sys_write(fd, buf, count) {
    return syscall(SYS_WRITE, fd, buf, count);
}

# Read up to `count` bytes from `fd` into `buf`. Rerouted to
# kernel32!ReadFile by the PE backend. GetStdHandle(-10) is
# inserted for fd 0 (stdin). Returns bytes read or -1 on error.
fn sys_read(fd, buf, count) {
    return syscall(SYS_READ, fd, buf, count);
}

# Open a file and return a descriptor. Rerouted to
# kernel32!CreateFileW; `flags` (Linux-shaped) is decomposed into
# Win32 `dwDesiredAccess` + `dwCreationDisposition` +
# `dwFlagsAndAttributes` inside the reroute. `mode` has no Win32
# equivalent and is dropped. Returns a handle usable by
# sys_read/write/close, or a negative value: -1 for a Win32 failure,
# -40 (-ELOOP) for O_NOFOLLOW on a symlink or junction (to a file or a
# directory), -20 (-ENOTDIR) / -21 (-EISDIR) for O_DIRECTORY, and -21 for
# O_NOFOLLOW with write access / O_CREAT / O_TRUNC on a real directory
# (O_DIRECTORY|O_NOFOLLOW on a link is -ENOTDIR, as on Linux and Darwin).
# See the OFlags note. CHANGELOG [6.6.9]
fn sys_open(path, flags, mode) {
    # Neither O_NOFOLLOW nor O_DIRECTORY; or O_CREAT|O_EXCL, whose CREATE_NEW never follows.
    if ((flags & 196608) == 0) { return syscall(SYS_OPEN, path, flags, mode); }
    if ((flags & 192) == 192) { return syscall(SYS_OPEN, path, flags, mode); }
    return _win_open_checked(path, flags, mode);
}

# Attributes (low dword) and reparse tag (high dword) of an OPEN handle, via
# GetFileInformationByHandleEx(FileAttributeTagInfo = 9) — reroute 0xF03D. -1 if the query
# fails. Asking the handle, not the path, is what makes the O_NOFOLLOW / O_DIRECTORY checks
# race-free: whatever the name pointed at by then, this is the object we hold. CHANGELOG [6.6.9]
fn _win_handle_tag(h): i64 {
    var ti[16];
    store64(&ti, 0);
    if (syscall(61501, h, 9, &ti, 8) == 0) { return 0 - 1; }
    return load64(&ti);
}

# Is an attribute/tag pair a NAME SURROGATE reparse point (a symlink or a junction — the
# kinds that redirect a name)? FILE_ATTRIBUTE_REPARSE_POINT 0x400 + tag bit 29.
fn _win_is_surrogate(at): i64 {
    if ((at & 1024) == 0) { return 0; }
    if (((at >> 32) & 0x20000000) == 0) { return 0; }
    return 1;
}

# 1 when handles `a` and `b` are the SAME file: GetFileInformationByHandleEx(FileIdInfo = 0x12)
# on each — volume serial + 128-bit file id, 24 bytes — compared whole. 0 when they differ or
# either query fails (fail closed). What lets a second open by NAME be trusted: whatever the
# name points at by then, the two handles are compared, not the name. CHANGELOG [6.6.9]
fn _win_same_file(a, b): i64 {
    var ia[32];
    var ib[32];
    if (syscall(61501, a, 18, &ia, 24) == 0) { return 0; }
    if (syscall(61501, b, 18, &ib, 24) == 0) { return 0; }
    if (load64(&ia) != load64(&ib)) { return 0; }
    if (load64(&ia + 8) != load64(&ib + 8)) { return 0; }
    if (load64(&ia + 16) != load64(&ib + 16)) { return 0; }
    return 1;
}

# Why an O_NOFOLLOW open WITHOUT O_DIRECTORY failed. Such an open carries no
# FILE_FLAG_BACKUP_SEMANTICS, so CreateFileW refuses every DIRECTORY object before sys_open
# holds a handle to ask — and a junction, or a symlink to a directory, IS a directory object:
# the refusal came back as a bare -1 where Linux says -ELOOP. Probe the name read-only with
# O_DIRECTORY|O_NOFOLLOW (BACKUP_SEMANTICS + OPEN_REPARSE_POINT: never follows, never
# truncates, never creates) and ask THAT handle: a name surrogate is -ELOOP (-40); a real
# directory under write access / O_CREAT / O_TRUNC is -EISDIR (-21), as on Linux; anything else
# keeps the original answer `err` — including the documented plain-directory divergence (-1).
# The probe only CHOOSES AN ERRNO; nothing it opens is handed back. CHANGELOG [6.6.9]
fn _win_nofollow_refusal(path, flags, err): i64 {
    var p = syscall(SYS_OPEN, path, 196608, 0);   # O_RDONLY | O_DIRECTORY | O_NOFOLLOW
    if (p < 0) { return err; }
    var at = _win_handle_tag(p);
    syscall(SYS_CLOSE, p);
    if (at == 0 - 1) { return err; }
    if (_win_is_surrogate(at) == 1) { return 0 - 40; }
    if ((at & 16) != 0) {
        if ((flags & 579) != 0) { return 0 - 21; }   # write access, O_CREAT or O_TRUNC
    }
    return err;
}

# The O_NOFOLLOW / O_DIRECTORY half of sys_open. The emitter has already made the open itself
# safe (FILE_FLAG_OPEN_REPARSE_POINT under O_NOFOLLOW, so the TARGET of a link is never
# touched); this decides what the caller is told. See the OFlags note. CHANGELOG [6.6.9]
fn _win_open_checked(path, flags, mode): i64 {
    var nf = flags & 131072;
    var dr = flags & 65536;
    var f = flags;
    var tr = 0;
    if (dr != 0) {
        # A directory handle is a READ handle: the write, create and truncate bits only
        # decide EISDIR below. Opening read-only keeps a mistaken O_DIRECTORY|O_TRUNC on a
        # FILE from truncating it on the way to -ENOTDIR.
        f = flags & (0 - 1 - 1603);   # drop O_ACCMODE(3), O_CREAT(64), O_TRUNC(512), O_APPEND(1024)
    } elif (nf != 0) {
        tr = flags & 512;             # O_TRUNC waits until the handle is verified
        f = flags - tr;
    }
    var h = syscall(SYS_OPEN, path, f, mode);
    if (h < 0) {
        if (nf != 0) { if (dr == 0) { return _win_nofollow_refusal(path, flags, h); } }
        return h;
    }
    var at = _win_handle_tag(h);
    if (at == 0 - 1) { syscall(SYS_CLOSE, h); return 0 - 1; }   # fail closed
    if (nf != 0) {
        if (_win_is_surrogate(at) == 1) {
            syscall(SYS_CLOSE, h);
            # With O_DIRECTORY too, the unfollowed link is simply not a directory: Linux AND
            # Darwin answer -ENOTDIR there, not -ELOOP (measured on both).
            if (dr != 0) { return 0 - 20; }
            return 0 - 40;
        }
        if ((at & 1024) != 0) {
            # A reparse point that is not a redirection (cloud placeholder, dedup): open it
            # the ordinary way, so the filter driver presents the file. That reopen is by NAME
            # and follows links, so it is made WITHOUT O_TRUNC (`f`), the verified handle stays
            # open meanwhile, and the two must be the same file — a name swapped for a link in
            # between is refused (-1) instead of opened, and the truncation below applies only
            # to the checked handle.
            var h2 = syscall(SYS_OPEN, path, f - nf, mode);
            if (h2 < 0) { syscall(SYS_CLOSE, h); return h2; }
            var same = _win_same_file(h, h2);
            syscall(SYS_CLOSE, h);
            if (same != 1) { syscall(SYS_CLOSE, h2); return 0 - 1; }
            h = h2;
        }
    }
    if (dr != 0) {
        if ((at & 16) == 0) { syscall(SYS_CLOSE, h); return 0 - 20; }
        if ((flags & 579) != 0) { syscall(SYS_CLOSE, h); return 0 - 21; }   # write access, O_CREAT or O_TRUNC
    }
    if (tr != 0) {
        if (_win_truncate_verified(h, path) != 0) { syscall(SYS_CLOSE, h); return 0 - 1; }
    }
    return h;
}

# Truncate the file behind a VERIFIED handle to 0 bytes. SetEndOfFile (0xF03F) needs
# FILE_WRITE_DATA, which an O_RDONLY handle lacks and an O_APPEND one deliberately lacks (its
# access is FILE_APPEND_DATA, NT's per-write append), so those truncate through a second
# O_WRONLY handle opened with FILE_FLAG_OPEN_REPARSE_POINT (it can never reach through a link)
# and truncated only when it is the SAME FILE as `h` (`_win_same_file`) — a name swapped in
# between, for a link or for another file, is refused. 0 on success, -1 on failure.
# CHANGELOG [6.6.9]
fn _win_truncate_verified(h, path): i64 {
    if (syscall(61503, h) != 0) { return 0; }
    var t = syscall(SYS_OPEN, path, 131073, 0);   # O_WRONLY | O_NOFOLLOW
    if (t < 0) { return 0 - 1; }
    var r = 0 - 1;
    if (_win_same_file(h, t) == 1) {
        if (syscall(61503, t) != 0) { r = 0; }
    }
    syscall(SYS_CLOSE, t);
    return r;
}

# Close the descriptor `fd`. Rerouted to kernel32!CloseHandle.
# Returns 0 on success, -1 on failure.
fn sys_close(fd) {
    return syscall(SYS_CLOSE, fd);
}

# Seek within `fd`. `whence`: 0=SEEK_SET, 1=SEEK_CUR, 2=SEEK_END.
# Rerouted to kernel32!SetFilePointerEx (the 64-bit-capable form).
# Returns the new offset or -1 on failure.
fn sys_lseek(fd, offset, whence) {
    return syscall(SYS_LSEEK, fd, offset, whence);
}

# Terminate the process with exit code `code`. Rerouted to
# kernel32!ExitProcess (v5.4.4 reroute). Never returns.
fn sys_exit(code) {
    syscall(SYS_EXIT, code);
    return 0;   # unreachable
}

# Terminate every thread in the process — the Linux exit_group(2) peer.
# Routes through SYS_EXIT deliberately: ExitProcess already tears down all
# threads, so on Windows this IS sys_exit. It exists so a portable epilogue
# can call one name on every target. Do NOT issue SYS_EXIT_GROUP here — 231
# has no PE reroute and would emit a raw `0F 05` (illegal instruction).
# CHANGELOG [6.5.6]
fn sys_exit_group(code) {
    syscall(SYS_EXIT, code);
    return 0;   # unreachable
}

# Change the working directory — NOT WIRED on Windows.
#
# There is no SetCurrentDirectoryW reroute, and inventing one is a COMPILER
# change (a new 0xF0xx pseudo-syscall + a PE emitter arm), not a stdlib one.
# Returns -1, the same honest degrade xstat and xrmdir already make on PE.
# Wire the reroute when a consumer actually needs it. CHANGELOG [6.5.7]
fn sys_chdir(path) { return 0 - 1; }

# fchownat — no Windows equivalent (no POSIX uid/gid model). Returns -1, the same
# honest degrade xstat/xrmdir make on PE. CHANGELOG [6.5.7]
fn sys_fchownat(dirfd, path, uid, gid, flags) { return 0 - 1; }

# at-family constants. The Linux values, defined here so the PORTABLE surface is
# complete: this peer is STANDALONE (it does not include syscalls_linux_common.cyr,
# where these live for the Linux/macOS peers), so without them a consumer calling
# sys_fchownat(AT_FDCWD, ...) fails to compile on this target even though the
# wrapper exists. The wrapper is a stub here, so the values are nominal — but
# source portability is the whole point of having the name. CHANGELOG [6.5.7]
var AT_FDCWD = 0 - 100;
var AT_SYMLINK_NOFOLLOW = 256;   # 0x100
var AT_REMOVEDIR = 512;          # 0x200

# VirtualAlloc-backed allocation. The PE reroute intercepts
# syscall(SYS_MMAP, ...) and emits a VirtualAlloc call with
# MEM_COMMIT | MEM_RESERVE + PAGE_READWRITE.
fn sys_mmap(addr, length, prot, flags, fd, offset) {
    return syscall(SYS_MMAP, addr, length, prot, flags, fd, offset);
}

# Release a VirtualAlloc'd region: 0, or a negative errno when VirtualFree refuses. Rerouted
# to kernel32!VirtualFree(addr, 0, MEM_RELEASE) since 6.6.20. `length` is DROPPED — MEM_RELEASE
# requires dwSize 0 and frees the WHOLE reservation — and kept only for source portability.
# ⚠ So a PARTIAL or OFFSET munmap is not supported on PE: an address that is not a
# reservation's base fails harmlessly, but the base with a SHORTER length releases all of it,
# leaving any later use of the tail a use-after-free. Every PE-reachable caller frees a base
# with its full length (lib/freelist.cyr's large blocks). ⛔ Until 6.6.20 this comment claimed
# the reroute while none existed: syscall 11 returned -38 and every large fl_free on Windows
# leaked its mapping (lib/freelist.cyr). CHANGELOG [6.6.20]
fn sys_munmap(addr, length) {
    return syscall(SYS_MUNMAP, addr, length);
}

# brk-shaped allocator anchor — NOT rerouted on PE: syscall 12 returns -38 (-ENOSYS). Nothing
# on Windows needs it: lib/alloc_windows.cyr reserves its heap, and maps each request too large
# for it, through mmap (syscall 9 → VirtualAlloc) — since v6.0.39 found that the brk reroute this
# comment used to promise had never been implemented. Kept so Linux-shaped source still compiles
# for PE. CHANGELOG [6.6.20]
fn sys_brk(addr) {
    return syscall(SYS_BRK, addr);
}

# v6.2.12 (CVE-19 follow-on): real Windows CSPRNG via bcryptprimitives.dll!
# ProcessPrng, reached through the 0xF01A PE reroute (src/backend/pe/emit.cyr +
# x86/emit.cyr). `BOOL ProcessPrng(PBYTE pbData, SIZE_T cbData)` fills `buf` with
# `len` cryptographically-secure bytes and returns nonzero on success; on the
# (practically-never) failure we return -1 so random_bytes() and its
# ws/sandhi/sigil/tls_native consumers fail loudly. NEVER add a weak fallback
# (uninitialised buffer / clock-ns / PID-mix) — a predictable mask/TXID/key is
# worse than a failed op (exactly what CVE-19 closed). `flags` is ignored
# (Linux getrandom flags have no ProcessPrng analog). See
# issues/archived/2026-06-11-windows-entropy-primitive.md.
# The BOOL is masked to 32 bits: EPROCPRNG_PE defines only eax, so a failure whose upper half
# was dirty would read as success and hand back an unfilled buffer. CHANGELOG [6.6.20]
fn sys_getrandom(buf, len, flags): i64 {
    if ((syscall(0xF01A, buf, len) & 0xFFFFFFFF) != 0) { return len; }   # BOOL: only eax is defined
    return 0 - 1;
}

# v6.3.2: POSIX process/wait/fs ops referenced on shared CLI paths that are
# DEAD on Windows (the CLI spawns via CreateProcessW reroutes, not fork/exec/
# wait). Stubbed so the PE cross-build has no undefined-fn reference under the
# v6.3.2 default reachable-undef hard error. Returns degrade safely (better than
# the pre-v6.3.2 ud2 stub, which would SIGILL if ever hit).
# Windows has no fork(); the CLI spawns via CreateProcessW. Returns -1.
fn sys_fork(): i64 { return 0 - 1; }
# No execve on Windows; CreateProcessW is used instead. Returns -1.
fn sys_execve(path, argv, envp): i64 { return 0 - 1; }
# No POSIX waitpid; process exit is read via GetExitCodeProcess. Returns -1.
fn sys_waitpid(pid, status_ptr, options): i64 { return 0 - 1; }
# POSIX wait-status accessor: on Windows the exit code IS the status. Pass-through.
fn WEXITSTATUS(status): i64 { return status; }
# POSIX wait-status predicate: Windows exits are always "exited" (no signals). 1.
fn WIFEXITED(status): i64 { return 1; }
# POSIX wait-status predicate: no POSIX signals on Windows. 0.
fn WIFSIGNALED(status): i64 { return 0; }
# POSIX wait-status accessor: no terminating signal on Windows. 0.
fn WTERMSIG(status): i64 { return 0; }
# v6.5.19: `cyrius test`'s child deadline polls `sys_waitpid(pid, &st, WNOHANG)`
# and SIGKILLs on expiry (cbt/build.cyr `run_binary_timed`). Both names are
# referenced OUTSIDE any target guard so the shared code stays single-path; on
# Windows the loop is unreachable anyway (`sys_fork` above returns -1, so the poll
# takes the `w < 0` exit on its first pass). Same stub contract as the block above:
# degrade safely rather than leave an undefined reference for the PE cross-build.
var WNOHANG = 1;
# No POSIX signals on Windows; a process is terminated via TerminateProcess
# (PE reroute 0xF01D), not kill(2). Returns -1.
fn sys_kill(pid, sig): i64 { return 0 - 1; }
# chmod has no Windows equivalent (ACL model differs); no-op success.
fn sys_chmod(path, mode): i64 { return 0; }
# Best-effort dup2 stub: returns the requested newfd (handle dup is rerouted).
fn sys_dup2(oldfd, newfd): i64 { return newfd; }
# pipe — Windows has no anonymous-pipe syscall on the reroute table. Fail closed with -1 so a
# caller's `< 0` path runs (lib/regression.cyr, lib/pam.cyr's Linux-only body); before this the
# name was UNDEFINED on PE and every call site compiled to a ud2 trap. CHANGELOG [6.6.9] bite 7.
fn sys_pipe(fds): i64 { return 0 - 1; }
# mkdir — routed to kernel32!CreateDirectoryW by the PE backend's syscall(83)
# reroute (src/backend/pe/emit.cyr _pe_ensure_createdir, v5.11.22). Returns 0 on
# success, -1 on failure. (Was a no-op `return 0` stub through v6.3.42 — VR-01
# surfaced that it never actually created the directory on Windows.)
fn sys_mkdir(path, mode): i64 { return syscall(83, path, mode); }
# unlink — routed to kernel32!DeleteFileW by the PE backend's syscall(87) reroute
# (_pe_ensure_deletef, v5.11.22). Returns 0 on success, -1 on failure. (Was a
# no-op `return 0` stub through v6.3.42 — VR-01 surfaced the file was never deleted.)
fn sys_unlink(path): i64 { return syscall(87, path); }
# Remove an empty directory — kernel32!RemoveDirectoryW through the 0xF03B reroute (the one
# lib/io.cyr's xrmdir already uses). Returns 0 on success, -1 on failure. 6.6.10: the reroute
# existed since 6.6.6 but no `sys_rmdir` did, so a portable caller of the POSIX name failed to
# COMPILE for PE (tests/tcyr/platform/fs.tcyr). CHANGELOG [6.6.10]
fn sys_rmdir(path): i64 { return syscall(0xF03B, path); }

# --- v6.5.25: raw floor wrappers this STANDALONE peer never defined ---
# This file includes nothing, so it inherits nothing: a name missing here is missing for
# PE entirely, and under the v6.3.2 reachable-undef hard error that is a build failure, not
# a degrade. All three were roadmap band-D (.25) "cass residual" items, and the premise-check
# found the same thing for each: the 0xF0xx REROUTE was already live and shipped, and the
# only missing piece was the wrapper here. No compiler change, no new band slot.

# getpid — 0xF01C (61468) → kernel32!GetCurrentProcessId, live since v6.3.44 and already
# used by lib/process_win.cyr's portable getpid(). Only this raw-floor name was absent, so
# `sys_getpid()` failed to COMPILE for PE while every other peer defines it.
fn sys_getpid(): i64 { return syscall(61468); }
# No POSIX parent-pid on Windows (a process does not retain its parent). Honest degrade,
# matching lib/process_win.cyr's own documented behaviour.
fn sys_getppid(): i64 { return 0 - 1; }

# ================================================================
# Stat buffer contract — v6.5.30
# ================================================================
#
# ⛔ THESE ARE A COMPILE-TIME CONTRACT, NOT A WINDOWS STAT LAYOUT. `xstat` (lib/io.cyr)
# returns **-1 unconditionally** on `CYRIUS_TARGET_WIN` — GetFileAttributesExW is not wired,
# and every correct caller already bails on `r < 0`. Nothing on Windows ever populates a stat
# buffer, so no byte at these offsets is ever read.
#
# They exist because the OTHER four peers all define a `Stat` enum and consumers reference it
# unconditionally. yukti 2.3.8 does exactly that — `var buf[STAT_BUFSZ]` then
# `load32(&buf + STAT_MODE)` — so without these names a PE build of yukti (and of anything
# including it) failed to COMPILE, with `array size identifier must be an enum constant`
# followed by a run of undefined-variable errors. A build failure, not a runtime one.
#
# ⚠ THE HALF-FIX TRAP THIS AVOIDS, which CLAUDE.md records from v6.5.7: adding `STAT_SIZE`
# alone, or only the names in the first error message, leaves the next consumer hitting the
# next missing member. The full set the peers publish is defined here in one go.
#
# Values mirror the x86_64-Linux peer purely so the buffer SIZE contract (144) matches and the
# offsets stay in range; they carry no Windows meaning. If GetFileAttributesExW is ever wired,
# these offsets must be re-derived from what that fills in — do not assume they are already
# right because the code compiles.
enum Stat {
    STAT_MODE = 24;
    STAT_NLINK = 16;
    STAT_UID = 28;
    STAT_GID = 32;
    STAT_SIZE = 48;
    STAT_MTIME = 88;
    STAT_MTIME_NSEC = 96;
    STAT_BUFSZ = 144;
}

# v6.6.6 — the statfs offsets, on exactly the Stat contract argued above and for exactly the
# same reason: every peer that can statfs publishes a `Statfs` enum — the three Linux/macOS
# peers share one in lib/syscalls_linux_common.cyr and agnos has its own, and this peer is
# STANDALONE (it includes neither), so it needs a copy — and yukti's
# `filesystem_usage` writes `var buf[STATFS_BUFSZ]` then `load64(&buf + STATFS_BLOCKS)`
# unconditionally. Without these names a PE build of yukti fails to COMPILE. `sys_statfs`
# below declines with -38, so no byte at these offsets is ever populated on Windows — the
# values mirror the Linux peer only to keep the buffer-size contract identical.
enum Statfs {
    STATFS_BSIZE = 8;
    STATFS_BLOCKS = 16;
    STATFS_BFREE = 24;
    STATFS_BAVAIL = 32;
    STATFS_BUFSZ = 2176;
}

# access(path, mode) — 0xF019 (61465) → kernel32!GetFileAttributesW, live since v6.1.18.
# The reroute takes the NARROW UTF-8 path and widens it in the emitter — invalid UTF-8 is
# refused, and a path of 248+ units is made absolute and `\\?\`-prefixed. ⛔ 6.6.12: it took a
# path widened HERE with no prefix and a 260-unit cap, so access() of an existing long path was
# -1 on real Windows while open() of the same path worked.
# INVALID_FILE_ATTRIBUTES is 0xFFFFFFFF → the path does not exist (or is unreachable).
# Returns 0 on success and -1 otherwise, the POSIX contract callers expect.
# NOTE: existence only. W_OK is deliberately NOT modelled from FILE_ATTRIBUTE_READONLY —
# a read-only ACL, a directory and a locked file all differ from the DOS attribute bit, and
# a wrong "writable" answer is worse than an unmodelled one. Callers needing write
# permission should attempt the open and handle the failure. CHANGELOG [6.6.12]
fn sys_access(path, mode): i64 {
    var attrs = syscall(61465, path);
    if (attrs == 4294967295) { return 0 - 1; }
    return 0;
}

# socketpair — Windows has NO socketpair primitive, and no blocking-accept reroute to build
# a loopback pair from, so this is an honest degrade rather than an emulation. A real one
# needs a NEW PE pseudo-syscall plus fd↔HANDLE namespace decisions — a design-level task,
# NOT the wrapper-parity item the roadmap bundled it with. Filed separately; this line only
# stops the hard compile error, which is what blocked PE builds.
fn sys_socketpair(domain, type, protocol, fds): i64 { return 0 - 1; }

# ── v6.6.5: PE peers for the new lib/syscalls_linux_common.cyr wrappers.
# This peer is STANDALONE (it does not include linux_common), so a PE build of any
# consumer that NAMES one of these would fail with `undefined variable` without them —
# the v6.5.25 SYS_IOCTL shape, one surface wider. Each returns -38/-ENOSYS so a caller's
# `if (r < 0)` check fires; none of them fakes an emulation.
# Send a message over a socket. Declines on Windows: ws2_32's WSASendMsg is a different
# contract (OVERLAPPED + a WSAMSG layout), not a renumber of this one.
fn sys_sendmsg(fd, msghdr, flags): i64 { return 0 - 38; }
# Send a datagram to an address. Declines on Windows for the same reason as sys_sendmsg.
fn sys_sendto(fd, buf, len, flags, dstaddr, dstaddrlen): i64 { return 0 - 38; }
# Set a file's length by descriptor — REAL since 6.6.9 (it declined with -38 before). Windows
# sets the end of file at the CURRENT file pointer (SetEndOfFile, reroute 0xF03F), so this
# seeks to `length`, sets it, and puts the pointer back where the caller had it, which is what
# ftruncate(2) leaves alone. Growing zero-fills, as POSIX requires. 0 on success, -22
# (-EINVAL) for a negative length, -1 on a Win32 failure (a handle without write access, for
# one). ⚠ That includes an O_APPEND descriptor, where Linux succeeds: the PE open of O_APPEND
# grants FILE_APPEND_DATA WITHOUT FILE_WRITE_DATA (NT's per-write append), and SetEndOfFile
# needs the latter. Truncate by path (sys_truncate), or open without O_APPEND. CHANGELOG [6.6.9]
fn sys_ftruncate(fd, length): i64 {
    if (length < 0) { return 0 - 22; }
    var cur = syscall(SYS_LSEEK, fd, 0, 1);
    if (cur < 0) { return 0 - 1; }
    if (syscall(SYS_LSEEK, fd, length, 0) < 0) { return 0 - 1; }
    var ok = syscall(61503, fd);
    syscall(SYS_LSEEK, fd, cur, 0);
    if (ok == 0) { return 0 - 1; }
    return 0;
}
# Set a file's length by path — REAL since 6.6.9: opens the path for writing (following a
# link, as truncate(2) does), then sys_ftruncate. Same returns. CHANGELOG [6.6.9]
fn sys_truncate(path, length): i64 {
    if (length < 0) { return 0 - 22; }
    var h = syscall(SYS_OPEN, path, 1, 0);   # O_WRONLY
    if (h < 0) { return 0 - 1; }
    var r = sys_ftruncate(h, length);
    syscall(SYS_CLOSE, h);
    return r;
}

# Decode EXACTLY `n` bytes of UTF-8 at `src` into UTF-16LE at `dst` ('/' → '\'), at most
# `cap` - 1 units plus a NUL; a code point past U+FFFF becomes a surrogate pair. Returns the unit
# count, or -1 — and then `dst` must not be used — for an embedded NUL (a NUL inside the bytes
# would silently cut the path), invalid UTF-8 (a stray continuation byte, a truncated or overlong
# sequence, an encoded surrogate, anything past U+10FFFF) or no room. REFUSE, NEVER TRUNCATE: the
# byte-per-unit loops this replaced zero-extended UTF-8 as Latin-1 and cut at their cap, so a
# non-ASCII name was answered as some other name and a long one as its own prefix. It is the ONE
# stdlib decoder, behind `_win_widen` below — which `sys_symlink` uses for CreateSymbolicLinkW
# (0xF03E), the one reroute that still takes wide paths. Since 6.6.12 the stat/list reroutes
# (0xF016 FindFirstFileW, 0xF019 GetFileAttributesW) take narrow paths and are decoded by the
# emitter, like open. CHANGELOG [6.6.11], [6.6.12]
fn _win_widen_n(dst, src, n, cap): i64 {
    var i = 0;
    var o = 0;
    while (i < n) {
        var c = load8(src + i);
        var cp = c;
        var k = 0;
        if (c == 0) { return 0 - 1; }
        if (c >= 0x80) {
            if (c < 0xC2) { return 0 - 1; }             # continuation byte / overlong 2-byte lead
            if (c >= 0xF5) { return 0 - 1; }            # past U+10FFFF
            k = 1;
            cp = c & 0x1F;
            if (c >= 0xE0) { k = 2; cp = c & 0x0F; }
            if (c >= 0xF0) { k = 3; cp = c & 0x07; }
            if (i + k >= n) { return 0 - 1; }           # truncated sequence
            var j = 1;
            while (j <= k) {
                var cc = load8(src + i + j);
                if ((cc & 0xC0) != 0x80) { return 0 - 1; }
                cp = (cp << 6) | (cc & 0x3F);
                j = j + 1;
            }
            if (k == 2) {
                if (cp < 0x800) { return 0 - 1; }       # overlong
                if ((cp & 0xF800) == 0xD800) { return 0 - 1; }   # an encoded surrogate
            }
            if (k == 3) {
                if (cp < 0x10000) { return 0 - 1; }     # overlong
                if (cp > 0x10FFFF) { return 0 - 1; }
            }
        }
        if (cp == 47) { cp = 92; }                      # '/' → '\'
        if (cp >= 0x10000) {
            if (o + 2 >= cap) { return 0 - 1; }
            var v = cp - 0x10000;
            store16(dst + o * 2, 0xD800 | (v >> 10));
            store16(dst + o * 2 + 2, 0xDC00 | (v & 0x3FF));
            o = o + 2;
        } else {
            if (o + 1 >= cap) { return 0 - 1; }
            store16(dst + o * 2, cp);
            o = o + 1;
        }
        i = i + 1 + k;
    }
    store16(dst + o * 2, 0);
    return o;
}

# Widen a NUL-terminated UTF-8 path into `dst` (`cap` units including the NUL) via
# `_win_widen_n`. Returns the unit count, or -1 when the path does not fit or is not valid
# UTF-8 — it never cuts a path to fit (it did until 6.6.11: `sys_symlink` then created its link
# at the path's first 518 units). This peer includes nothing, which is why the one decoder lives
# here for the other modules to call; the stack buffers its callers pass need no allocator.
# CHANGELOG [6.6.9], [6.6.11]
fn _win_widen(dst, src, cap): i64 {
    var n = 0;
    while (load8(src + n) != 0) {
        n = n + 1;
        if (n >= cap * 3) { return 0 - 1; }             # more bytes than `cap` units can hold
    }
    return _win_widen_n(dst, src, n, cap);
}

# symlink(target, linkpath) — REAL since 6.6.9: CreateSymbolicLinkW (reroute 0xF03E). Windows
# has two link kinds and POSIX has one, so the kind is taken from what `target` names NOW,
# resolved the way the link will resolve it (a relative target against the LINK's directory):
# a directory gets SYMBOLIC_LINK_FLAG_DIRECTORY, anything else — including a target that does
# not exist yet, a dangling link — a file link. SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE
# is asked first (Developer Mode lets a normal user create links with it); a Windows too old
# to know the flag refuses it, so the call is retried without. ⚠ Without Developer Mode a
# NON-elevated process cannot create a link at all and this returns -1 — a Windows policy,
# not a missing route. 0 on success, -1 on failure. CHANGELOG [6.6.9]
fn sys_symlink(target, linkpath): i64 {
    var wl[1040];
    var wt[1040];
    var rr[3120];
    if (_win_widen(&wl, linkpath, 519) < 0) { return 0 - 1; }   # 6.6.11: refused, never cut
    var tn = _win_widen(&wt, target, 519);
    if (tn < 0) { return 0 - 1; }
    # Resolve the target as the link will: absolute ('\...', '/...', 'X:...') as-is, else against
    # the link's directory (the part of linkpath up to its last separator). Built NARROW (UTF-8):
    # the GetFileAttributesW reroute takes a narrow path since 6.6.12. Both inputs passed
    # `_win_widen` at 519 units, so each is under 1557 bytes and `rr` holds the two plus a NUL.
    var abs = 0;
    var t0 = load8(target);
    if (t0 == 92) { abs = 1; }
    if (t0 == 47) { abs = 1; }
    if (t0 != 0) {
        if (load8(target + 1) == 58) { abs = 1; }
    }
    var ri = 0;
    if (abs == 0) {
        var ls = 0 - 1;
        var li = 0;
        while (load8(linkpath + li) != 0) {
            var lc = load8(linkpath + li);
            if (lc == 92) { ls = li; }
            if (lc == 47) { ls = li; }
            li = li + 1;
        }
        while (ri <= ls) {
            store8(&rr + ri, load8(linkpath + ri));
            ri = ri + 1;
        }
    }
    var ti = 0;
    while (load8(target + ti) != 0) {
        store8(&rr + ri + ti, load8(target + ti));
        ti = ti + 1;
    }
    store8(&rr + ri + ti, 0);
    var kind = 0;
    var at = syscall(61465, &rr);                 # GetFileAttributesW (narrow; 6.6.12)
    if (at != 4294967295) {
        if ((at & 16) != 0) { kind = 1; }         # SYMBOLIC_LINK_FLAG_DIRECTORY
    }
    if (syscall(61502, &wl, &wt, kind | 2) != 0) { return 0; }
    if (syscall(61502, &wl, &wt, kind) != 0) { return 0; }
    return 0 - 1;
}
# Filesystem statistics by path. Declines on Windows: the nearest peer is GetDiskFreeSpaceExW,
# a kernel32 import with three out-params and a wide path — a different contract, not a
# renumber. Callers already bail on r < 0. v6.6.6.
fn sys_statfs(path, buf): i64 { return 0 - 38; }
# Filesystem statistics by descriptor. Declines on Windows, same reason as sys_statfs.
fn sys_fstatfs(fd, buf): i64 { return 0 - 38; }
# f_bsize accessor — present so cross-platform source compiles for PE. Never reached with a
# populated buffer, because sys_statfs above always declines.
fn statfs_bsize(buf): i64 { return 0; }
# Create an anonymous in-memory file. Declines on Windows: the nearest object is a named
# section (CreateFileMappingW), a different object model with no fd.
fn sys_memfd_create(name, flags): i64 { return 0 - 38; }
# Sleep for a `struct timespec`. REAL on Windows — the PE backend has rerouted syscall(35)
# to kernel32 Sleep since v6.1.17, reading tv_sec/tv_nsec and converting to flat ms.
fn sys_nanosleep(req, rem): i64 { return syscall(SYS_NANOSLEEP, req, rem); }
# Yield the remainder of this thread's timeslice. Declines on Windows: the peer is
# SwitchToThread/Sleep(0), a kernel32 import this backend does not reroute.
fn sys_sched_yield(): i64 { return 0 - 38; }
# ── v6.6.8: PE peers for the namespace / root / capability / cross-process-memory / mknodat
# wrappers in lib/syscalls_linux_common.cyr. Windows has none of these as a syscall (job
# objects, AppContainers, token privileges and ReadProcessMemory are different object
# models, not renumbers), so each declines with -38/-ENOSYS; the caller's `r < 0` fires.
# Present so a portable consumer (kavach, takumi, shakti) BUILDS for PE. CHANGELOG [6.6.8]
# Enter new namespaces. Declines: Windows has no namespaces.
fn sys_unshare(flags): i64 { return 0 - 38; }
# Change the root directory. Declines: Windows has no chroot.
fn sys_chroot(path): i64 { return 0 - 38; }
# Swap the root mount. Declines: Windows has no mount tree to pivot.
fn sys_pivot_root(new_root, put_old): i64 { return 0 - 38; }
# Read capability sets. Declines: Windows privileges live on an access token.
fn sys_capget(hdr, data): i64 { return 0 - 38; }
# Set capability sets. Declines, same reason as sys_capget.
fn sys_capset(hdr, data): i64 { return 0 - 38; }
# Read another process's memory. Declines: ReadProcessMemory takes a process HANDLE.
fn sys_process_vm_readv(pid, local_iov, liovcnt, remote_iov, riovcnt, flags): i64 { return 0 - 38; }
# Write another process's memory. Declines, same reason as sys_process_vm_readv.
fn sys_process_vm_writev(pid, local_iov, liovcnt, remote_iov, riovcnt, flags): i64 { return 0 - 38; }
# Create a filesystem node (FIFO / device). Declines: Windows named pipes live in \\.\pipe\.
fn sys_mknodat(dirfd, path, mode, dev): i64 { return 0 - 38; }

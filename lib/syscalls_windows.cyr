# Change a descriptor's owner and group. Declines: Windows ownership lives in a security descriptor, not a uid/gid pair.
fn sys_fchown(fd, uid, gid): i64 { return 0 - 38; }
# Extended stat. Declines: Windows has no statx.
fn sys_statx(dirfd, path, flags, mask, buf): i64 { return 0 - 38; }
# Read a resource limit. Declines: Windows has no rlimits; per-process limits are job-object settings.
fn sys_getrlimit(resource, rlim): i64 { return 0 - 38; }
# ── v6.6.8: PE peers for the fcntl surface in lib/syscalls_linux_common.cyr. Windows has no
# fcntl (non-blocking I/O is ioctlsocket(FIONBIO) on a SOCKET, or OVERLAPPED on a HANDLE —
# different object models, not a renumber), so all three decline with -38/-ENOSYS. A caller
# that relies on a non-blocking read learns it cannot have one, which a silent `return 0`
# would hide. ⚠ None of them may NAME O_NONBLOCK: this peer declares none, and an undefined
# variable is a hard compile error for every PE consumer. The F_* names exist so portable
# source compiles. CHANGELOG [6.6.8]
enum FcntlCmd {
    F_DUPFD = 0;
    F_GETFD = 1;
    F_SETFD = 2;
    F_GETFL = 3;
    F_SETFL = 4;
}
# The one F_SETFD descriptor flag.
enum FdFlag {
    FD_CLOEXEC = 1;
}
# fcntl(2). Declines on Windows.
fn sys_fcntl(fd, cmd, arg): i64 { return 0 - 38; }
# Make an fd non-blocking. Declines on Windows (no fcntl status flags).
fn fd_set_nonblocking(fd): i64 { return 0 - 38; }
# Restore saved fd status flags. Declines on Windows.
fn fd_restore_flags(fd, saved): i64 { return 0 - 38; }
# The calling thread's last Winsock error, negated: -WSAGetLastError (0xF024). WSAGetLastError
# returns a C `int` and the reroute defines only eax (no extension in the emitter), so the
# value is masked to 32 bits before it is negated. Never 0: a failure must not read as
# success. Same contract as lib/net.cyr's _net_wsa_err, which this file cannot include.
# CHANGELOG [6.6.16]
fn _sw_wsa_err(): i64 {
    var e = syscall(61476) & 0xFFFFFFFF;            # WSAGetLastError (0xF024)
    if (e == 0) { return 0 - 1; }
    return 0 - e;
}
# Wait until SOCKET `fd` is readable (`want_write` == 0) or writable (`want_write` != 0), for at
# most `timeout_ms` ms (< 0 waits indefinitely; clamped to INT_MAX). Returns 1 ready — including
# an error or hang-up, so the next recv/send reports it — 0 on timeout, or -WSAGetLastError
# (-10038 WSAENOTSOCK for something that is not an open socket: WSAPoll flags it POLLNVAL; a
# negative fd — INVALID_SOCKET from a failed socket()/accept() — is refused the same way at once,
# because WSAPoll IGNORES it and would report a timeout, or with timeout_ms < 0 never return).
# ws2_32!WSAPoll (0xF04A, sign-extended) over one WSAPOLLFD { SOCKET; SHORT events, revents },
# with POLLRDNORM 0x100 / POLLWRNORM 0x10 — Windows refuses POLLIN's POLLPRI half. Sockets only:
# WSAPoll knows nothing of file or pipe HANDLEs. Same contract as the POSIX peer. CHANGELOG [6.6.13]
# The error read goes through _sw_wsa_err: WSAGetLastError returns a C `int`, and the 0xF024
# reroute defines only eax, so rax[63:32] is the callee's to leave dirty. CHANGELOG [6.6.16]
fn fd_wait_ready(fd, want_write, timeout_ms): i64 {
    if (fd < 0) { return 0 - 10038; }                   # INVALID_SOCKET → -WSAENOTSOCK
    var ms = timeout_ms;
    if (ms < 0) { ms = 0 - 1; }
    if (ms > 0x7FFFFFFF) { ms = 0x7FFFFFFF; }
    var pfd[16];
    store64(&pfd, fd);
    if (want_write != 0) { store16(&pfd + 8, 0x10); }   # POLLWRNORM
    else { store16(&pfd + 8, 0x100); }                  # POLLRDNORM
    store16(&pfd + 10, 0);
    store32(&pfd + 12, 0);
    var r = syscall(0xF04A, &pfd, 1, ms);               # WSAPoll
    if (r < 0) { return _sw_wsa_err(); }                # -WSAGetLastError (0xF024)
    if (r == 0) { return 0; }
    if ((load16(&pfd + 10) & 0x4) != 0) { return 0 - 10038; }  # POLLNVAL → -WSAENOTSOCK
    return 1;
}

# ── PE peers for the linux_common wrappers a cross-platform consumer names on paths that
# are dead on Windows (yukti's optical / eject / netlink-monitor / network-probe / mount /
# TOCTOU-lstat paths since 2.3.12). Without them a PE build that merely REACHES such a
# path is refused: `refusing to emit binary with N reachable undefined function(s)`.
# Same contract as the block above: each declines with -38/-ENOSYS, so the caller's
# `if (r < 0)` fires; none emulates. ⚠ The socket four still decline ON PURPOSE. Since
# 6.6.11 lib/net.cyr IS the Windows socket surface (tcp_socket … sock_close over ws2_32, a
# SOCKET as the fd, Winsock option constants, closesocket). These raw wrappers are the
# Linux-shaped ABI: their callers pass Linux option numbers (SOL_SOCKET = 1 is not Winsock's
# 0xFFFF) and close with sys_close, which is CloseHandle here and does not close a SOCKET — so
# routing them would turn an honest -38 into wrong options and leaked sockets. Use lib/net.cyr.
# CHANGELOG [6.6.7], [6.6.11]
# Device control. Declines: Windows has no ioctl (DeviceIoControl takes a HANDLE and
# Windows control codes, not Linux device requests).
fn sys_ioctl(fd, request, argp): i64 { return 0 - 38; }
# Create a BSD socket fd. Declines (see the block header).
fn sys_socket(domain, type, protocol): i64 { return 0 - 38; }
# Bind a socket fd. Declines (see the block header).
fn sys_bind(fd, sockaddr, addrlen): i64 { return 0 - 38; }
# Connect a socket fd. Declines (see the block header).
fn sys_connect(fd, sockaddr, addrlen): i64 { return 0 - 38; }
# Set a socket option on a socket fd. Declines (see the block header).
fn sys_setsockopt(fd, level, optname, val, vallen): i64 { return 0 - 38; }
# Receive a datagram with its source address. Declines (see the block header).
fn sys_recvfrom(fd, buf, len, flags, srcaddr, srcaddrlen): i64 { return 0 - 38; }
# stat relative to a directory fd. Declines: Windows has no at-family calls and no
# struct stat; GetFileAttributesExW is a different record.
fn sys_fstatat(dirfd, path, buf, flags): i64 { return 0 - 38; }
# Mount a filesystem. Declines: Windows mounts volumes through the mount manager, not a
# syscall with a filesystem type and flags.
fn sys_mount(source, target, fstype, flags, data): i64 { return 0 - 38; }
# Unmount a filesystem. Declines, same reason as sys_mount.
fn sys_umount2(target, flags): i64 { return 0 - 38; }
# Flush a file (data + metadata) to storage. NOT a decline like the block above: it issues
# the LINUX number 74 — the sys_mkdir/sys_unlink 83/87 shape — so the PE backend owns the
# meaning. With the 6.6.7 route, 74/75 at argc 2 go to kernel32!FlushFileBuffers (0 /
# negative); without it the unrouted literal returns -38/-ENOSYS. Either way a bogus fd reads
# < 0 and no caller is told a flush happened that did not. Consumers (patra's fdatasync sites,
# the write-tmp + fsync + rename pattern) name these, so without them a PE build is refused.
fn sys_fsync(fd): i64 { return syscall(74, fd); }
# Flush file data only. Windows has no data-only flush, so the route is the same
# FlushFileBuffers as sys_fsync — stronger than asked, never weaker. CHANGELOG [6.6.7]
fn sys_fdatasync(fd): i64 { return syscall(75, fd); }

# v6.4.66 — getpeername / getsockname now route to ws2_32 (was a fail-closed -ENOSYS
# stub v6.4.64→.65). The PE syscall router maps 0xF036 → ws2_32!getpeername and
# 0xF037 → ws2_32!getsockname (src/backend/x86/emit.cyr EGETPEERNAME_PE / EGETSOCKNAME_PE),
# 3-arg, same shape as bind — so sandhi's per-IP rate limiting has a real peer address
# on Windows. Winsock returns 0 on success, SOCKET_ERROR (-1) with WSAGetLastError =
# WSAENOTCONN (10057) on an unconnected socket (NOT the POSIX errno space). Consumers
# still treat <0 as "peer unknown" and fail open — sandhi's peer API already does.
# Closes docs/development/issues/archived/2026-07-14-windows-getpeername-reroute-missing.md
#
# Normalize to the POSIX contract consumers check (`r < 0` = failure): ws2_32
# returns 0 on success (peer written) or SOCKET_ERROR (int -1). These reroutes define
# ONLY eax — the emitter does not extend the C `int` — so rax[63:32] is whatever the
# callee left: 0xFFFFFFFF on the builds measured, a POSITIVE value that would defeat a
# `< 0` check and let a caller fabricate a peer (cf. sandhi_server_peer_sockaddr's
# `if (r < 0) return 0`), and in principle dirty upper bits over a 0 that would read a
# success as a failure. So the result is tested masked to 32 bits. On failure return
# `-WSAGetLastError` through _sw_wsa_err (negative, never 0, and it carries the real
# Winsock error, e.g. -10057 WSAENOTCONN). WSAGetLastError is read immediately, before
# any other call can reset the per-thread last-error. CHANGELOG [6.6.16]
fn sys_getpeername(fd, addr, addrlen): i64 {
    var r = syscall(61494, fd, addr, addrlen);
    if ((r & 0xFFFFFFFF) == 0) { return 0; }
    return _sw_wsa_err();           # -WSAGetLastError (0xF024)
}
# getsockname (0xF037 → ws2_32!getsockname): same normalization as getpeername.
fn sys_getsockname(fd, addr, addrlen): i64 {
    var r = syscall(61495, fd, addr, addrlen);
    if ((r & 0xFFFFFFFF) == 0) { return 0; }
    return _sw_wsa_err();
}
# listen (0xF033 → ws2_32!listen): same normalization as getsockname — 0, or -WSAGetLastError.
# 6.6.10: the reroute existed since v6.4.44 but no `sys_listen` did, so a portable caller of
# the POSIX name failed to COMPILE for PE (tests/tcyr/platform/socket_syscalls.tcyr).
# `fd` is a ws2_32 SOCKET (lib/net.cyr's tcp_socket on PE, real since 6.6.11 — until then it
# returned -38 there and this comment described a socket nothing could create). CHANGELOG [6.6.10]
fn sys_listen(fd, backlog): i64 {
    var r = syscall(0xF033, fd, backlog);
    if ((r & 0xFFFFFFFF) == 0) { return 0; }
    return _sw_wsa_err();           # -WSAGetLastError (0xF024)
}

# ================================================================
# QueryPerformanceCounter / QueryPerformanceFrequency (v6.6.5)
# ================================================================
# 0xF038 → kernel32!QueryPerformanceCounter(LARGE_INTEGER*)
# 0xF039 → kernel32!QueryPerformanceFrequency(LARGE_INTEGER*)
# (src/backend/x86/emit.cyr EQPC_PE / EQPF_PE, routed in src/frontend/parse_expr.cyr.)
#
# ⛔ WHY: Windows had NO sub-millisecond clock in cyrius at all. `syscall(228)` reroutes
# to kernel32!GetTickCount64, whose counter advances in **15 ms** steps (measured on
# cass, 2026-08-11) — so lib/chrono.cyr's monotonic clock and lib/bench.cyr's timer both
# quantized every duration under 15 ms to 0 or to one whole tick, and the bench
# framework's floor calibrated to 0 because 1,024 GetTickCount64 calls do not move the
# counter. QPC is the documented high-resolution source (its frequency is typically
# 10 MHz on Win10+, i.e. a 100 ns tick) and is monotonic since system start.
#
# Both return BOOL (nonzero = success) and write a 64-bit count at the pointer arg.
# Filed as part of docs/development/issues/archived/2026-09-16-mabda-lib-bench-min-minus-mean-floor.md
# QueryPerformanceCounter(&count): writes the current 64-bit performance count at `ptr`.
# Returns the Win32 BOOL (nonzero = success). Monotonic since system start.
fn sys_qpc(ptr): i64 {
    return syscall(61496, ptr);
}

# QueryPerformanceFrequency(&hz): writes the counter's ticks-per-second at `ptr`.
# Returns the Win32 BOOL. Fixed at boot, so one call per process is enough.
fn sys_qpf(ptr): i64 {
    return syscall(61497, ptr);
}

# Cached frequency. QPF is fixed at boot and documented not to change while the system
# runs, so one call is enough; 0 means "not read yet".
var _sys_qpf_hz = 0;

# Monotonic nanoseconds from QPC. The conversion is split so it cannot overflow: a raw
# `count * 1e9` wraps i64 after ~29 years of uptime at 10 MHz, and after ~9 seconds if a
# machine ever reports a 1 GHz frequency.
#
# ⚠ Falls back to GetTickCount64 × 1e6 if QPF reports a non-positive frequency — that
# cannot happen on any supported Windows, but returning a wrong-scaled count would be
# silent while a 15 ms clock is merely coarse.
fn sys_qpc_ns(): i64 {
    var c[16];
    if (_sys_qpf_hz == 0) {
        store64(&c, 0);
        sys_qpf(&c);
        _sys_qpf_hz = load64(&c);
    }
    if (_sys_qpf_hz <= 0) {
        return syscall(228, 1, &c) * 1000000;
    }
    store64(&c, 0);
    sys_qpc(&c);
    var t = load64(&c);
    return (t / _sys_qpf_hz) * 1000000000 + ((t % _sys_qpf_hz) * 1000000000) / _sys_qpf_hz;
}

# ================================================================
# v6.6.6 — the two raw-floor names a POSIX tool reaches for path work
# ================================================================
#
# ⛔ This peer INCLUDES NOTHING, so a name missing here is missing for PE entirely, and
# under the v6.3.2 reachable-undef hard error that is a BUILD FAILURE, not a degrade.
# `programs/cyrius-init.cyr` named `sys_readlink` and `sys_rename` unguarded, so it did
# not cross-compile to PE at all and `cyrius init` / `cyrius port` were absent from every
# Windows install — the CLI answered `tool not found`. Same shape as the v6.5.25
# getpid/getppid gap, one surface wider. See
# docs/development/issues/archived/2026-09-18-cyrius-init-does-not-build-for-windows.md.
#
# ⛔ AND `sys_readlink` IS DELIBERATELY NOT ONE OF THEM. The first cut of this fix added a
# third wrapper returning -38/ENOSYS, and it was measured to buy nothing: with the
# scaffolder's readlink call now behind `#ifndef CYRIUS_TARGET_WIN`, deleting the stub
# leaves the PE build byte-for-byte the same (rc=0, MZ, 155,648 B, 0 undefined fns). What
# it cost was the diagnostic. `readlink("/proc/self/exe")` is the ONE shape this filing is
# about, and with a -38 stub present that line COMPILES for PE and then silently falls
# back to argv(0) — which on Windows is whatever the parent typed, so a tool that needs
# its own install root gets the wrong directory and scaffolds nothing. That is exactly the
# half-fix `tests/gates/toolchain/cyrius_init_builds_for_pe.sh` exists to forbid, and a
# stub here would have made it compile. The hard error is the feature: it forces the next
# PE consumer to pick `sys_self_exe_w` (below) or `xreadlink` (lib/io.cyr, which already
# degrades to -1 behind its own `#ifdef`), instead of getting a silent wrong answer.
# A REAL readlink — DeviceIoControl + FSCTL_GET_REPARSE_POINT — would be welcome; a stub
# that only makes the wrong code build is not. CHANGELOG [6.6.6].

# rename(old, new) — REAL, not a degrade: 0xF034 (61492) → kernel32!MoveFileExW with
# MOVEFILE_REPLACE_EXISTING, live since v6.4.57 and already the Windows arm of
# lib/io.cyr's portable `file_rename`. Returns 0 on success / -1 on failure (the BOOL is
# folded to the POSIX contract by the emitter), which is what POSIX callers check.
# ⚠ Unlike rename(2) this CAN move across volumes (MOVEFILE_COPY_ALLOWED is not set, so
# it does not; a cross-volume move fails, as rename(2) does with EXDEV).
fn sys_rename(oldpath, newpath): i64 { return syscall(61492, oldpath, newpath); }

# GetModuleFileNameW(NULL, wbuf, cch) — 0xF03A (61498), the Windows source for the full
# path of THIS executable. `cch` is the buffer capacity in WCHARs (wbuf must hold
# cch * 2 bytes); the result is UTF-16LE, and the return value is the WCHAR count written
# (0 on failure). NOT narrowed here — the caller converts with `_args_w2u8`
# (lib/args.cyr), exactly as lib/args_win.cyr does for GetCommandLineW's raw LPWSTR.
#
# ⚠ argv(0) is NOT a substitute and that is why this reroute exists: on Windows argv[0]
# is whatever the parent wrote on the command line, so it can be relative or a bare name,
# and a tool that derives an install root from its own GRANDPARENT directory (the
# scaffolder's templates dir) gets the wrong answer or none. CHANGELOG [6.6.6].
fn sys_self_exe_w(wbuf, cch): i64 { return syscall(61498, wbuf, cch); }

# ================================================================
# Job objects (6.6.10) — a Windows process TREE
# ================================================================
# Win32 has no process group and no parent-death signal, and a deadline that could only
# TerminateProcess the direct child left the child's own children running — one of them
# holding a capture pipe kept `exec_capture_status` blocked long past its bound (measured on
# cass: a 2000 ms deadline returned after 19,437 ms). A Job object is both missing pieces:
# every process a member starts joins the job too, TerminateJobObject ends all of them, and
# with JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE the kernel ends all of them when the last handle to
# the job closes — including when OUR process dies (the Windows PR_SET_PDEATHSIG). A child is
# created CREATE_SUSPENDED, assigned, and only then resumed, so nothing it starts can be born
# outside the job. Reroutes 0xF040-0xF044 (src/backend/x86/emit.cyr). Used by
# lib/process_win.cyr, lib/async_win.cyr and cbt's `_win_run_timed`. CHANGELOG [6.6.10]

# Set (`on` = 1) or clear (`on` = 0) JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE (0x2000) — the only
# limit these jobs carry. JOBOBJECT_EXTENDED_LIMIT_INFORMATION is 144 bytes on x64 and its
# LimitFlags is the DWORD at offset 16; class 9 = JobObjectExtendedLimitInformation.
# Returns the SetInformationJobObject BOOL (non-zero = success).
fn _win_job_set_kill(job, on): i64 {
    var info[144];
    var z = 0;
    while (z < 144) { store64(&info + z, 0); z = z + 8; }
    if (on == 1) { store32(&info + 16, 0x2000); }
    return syscall(0xF044, job, 9, &info, 144);
}

# 1 iff `r`, a job reroute's answer, is a success: a HANDLE, or a BOOL / DWORD the call reports
# as done. Success is > 0, never merely != 0: a reroute this compiler does not route answers
# -ENOSYS (-38), which is non-zero too — a lib built against a cycc without `_PE_ROUTE_JOB`
# took -38 as a job handle and as a successful assignment. CHANGELOG [6.6.10]
fn _win_ok(r): i64 {
    if (r > 0) { return 1; }
    return 0;
}

# 1 iff ResumeThread's answer `rs` means the thread was resumed: its previous suspend count,
# 0..0xFFFFFFFE. 0xFFFFFFFF ((DWORD)-1) is the Win32 failure and a negative value is an
# unrouted reroute (-ENOSYS) — both leave the child SUSPENDED, so the caller must end it.
# CHANGELOG [6.6.10]
fn _win_resumed(rs): i64 {
    if (rs < 0) { return 0; }
    if (rs == 4294967295) { return 0; }
    return 1;
}

# Create an unnamed job, KILL_ON_JOB_CLOSE when `kill_on_close` is 1. Returns its handle, or 0
# when it could not be created or configured (nothing is left open then).
fn _win_job_new(kill_on_close): i64 {
    var job = syscall(0xF040, 0, 0);                 # CreateJobObjectW(NULL, NULL)
    if (_win_ok(job) == 0) { return 0; }
    if (kill_on_close == 1) {
        if (_win_ok(_win_job_set_kill(job, 1)) == 0) { syscall(3, job); return 0; }
    }
    return job;
}

# Put the CREATE_SUSPENDED process in PROCESS_INFORMATION `pi` into a new job, then resume
# it. Returns the job handle; 0 when the process could not be put in a job (it runs anyway,
# untracked — the caller loses the TREE, never the child); -1 when it could not be RESUMED,
# in which case it has been terminated and the caller must report a failed spawn (a
# suspended child would otherwise wait for ever).
fn _win_job_start(pi, kill_on_close): i64 {
    var job = _win_job_new(kill_on_close);
    if (job != 0) {
        if (_win_ok(syscall(0xF041, job, load64(pi))) == 0) { syscall(3, job); job = 0; }
    }
    var rs = syscall(0xF043, load64(pi + 8));        # ResumeThread(hThread)
    if (_win_resumed(rs) == 0) {
        syscall(61469, load64(pi), 1);               # TerminateProcess — never left suspended
        if (job != 0) { syscall(3, job); }
        return 0 - 1;
    }
    return job;
}

# End every process in `job` with exit code `code` (TerminateJobObject). Returns the BOOL.
fn _win_job_kill(job, code): i64 { return syscall(0xF042, job, code); }

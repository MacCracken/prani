# --- visibility.cyr ---

# visibility.cyr -- the distlib bundle's visibility directive.
#
# `cyrius distlib` concatenates the [lib] modules into ONE file, dist/hisab.cyr, and a
# `private` line in a file makes everything in it file-private except what carries
# `public` (cyrius-guide, Visibility). This module is that line. It is FIRST in [lib] so
# that a toolchain older than 6.6.5 -- where the marker covered only what followed it --
# still sees it ahead of every declaration.
#
# The suites include src/*.cyr one file at a time and never include this file, so they
# keep white-box access to module internals. scripts/check-public-surface.sh flips every
# module `private` in a scratch copy to prove that no module reaches another's internals,
# and checks that the shipped bundle exposes exactly the public surface.
private

# --- error.cyr ---

# error.cyr -- hisab error codes
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/error.cyr" after what it requires
# Requires: no other hisab module (stdlib resolves via cyrius.cyml [deps])
#
# Replaces Rust's HisabError enum with integer error codes.
#
# ⛔ 3.0.0 — THESE ARE NOW THE `E` HALF OF A `Result<T, E>`, NOT A RETURN VALUE.
# The fallible entry points (3.0.0's are listed in docs/guides/migration-3.0.md) return `Ok(0)` / `Err(HSB_ERR_*)` from
# `lib/result.cyr` (the v6.6.0 VALUE form), so a caller binds both halves —
# `var t, v = f(...)` — and tests with `is_err_result(t)`. `var r = f(...)` is a
# hard compile error. The codes below are unchanged in name and value; what
# changed is where they travel. See `docs/guides/migration-3.0.md`.
# ⛔ 3.4.0 — `solve_pgs` AND `svd_compute`, THE TWO ENTRY POINTS THAT STILL
# RETURNED A PLAIN INTEGER, ARE RETIRED. Their replacements return a Result like
# every other fallible entry point:
#   - `solve_pgs_checked`: solve_pgs returned 0 for every outcome -- an
#     unconverged stop, a skipped zero-diagonal row, non-finite input that reached x
#     or was clamped away, and an x passed as b, which it overwrote while reading it
#     (the first 3.4.0 tree added a raw -10 for a null handle). Its Errs are
#     INVALID_INPUT, SINGULAR_PIVOT, NO_CONVERGENCE and ALLOC.
#   - `svd_compute_checked`: svd_compute returned ganita_mat_svd's status
#     vocabulary, 0, -1 or -2, bit-identical to HSB_ERR_INVALID_TRANSFORM and
#     HSB_ERR_SINGULAR_MATRIX but not HsbError values: a 2x3 input returned -2,
#     which read as an HsbError says "singular matrix". Its Errs are the codes
#     svd_truncated already used for the same failures.
# Each function's doc in linalg_ext.cyr has the details.

# ⭐ 2.19.0 — AN ENUM, NOT TWELVE `var` GLOBALS. Call sites are unchanged: the
# names and the values are identical, so nothing outside this block moves (all
# twelve values re-read through a probe and compared against the old `(0 - N)`
# forms — 0 mismatches).
# ⚠ THE PROJECT RULE THAT MOTIVATED THIS NAMES THE WRONG MECHANISM, and
# measuring the conversion is what showed it. CLAUDE.md says "enums for constants
# — zero `gvar_toks` cost vs. var globals"; the saving is NOT in the variable
# table. `CYRIUS_STATS=1` over the whole bundle reads **var_table: 615 on BOTH
# sides**, and cycc's own diagnostic says that table counts
# "too many globals+enums+arrays" — an enum member occupies an entry exactly as a
# global does. What actually moves is RELOCATIONS: a `var` global is a memory
# load needing a fixup per reference, an enum member is an immediate folded at
# compile time. Measured: **fixup_table 3092 → 2933 (−159)** and
# **code_size 748,024 → 747,320 B (−704)** across the 170 non-comment reference
# sites in the bundle — ~94% of sites losing a fixup, at ~4.4 code bytes each.
# The rule is right and the reason written beside it was not.
# [measured: CYRIUS_STATS=1 cyrius check --with-deps dist/hisab.cyr on both trees, 2026-09-10]
# ⚠ THE VALUES HAD TO BECOME LITERALS. Each was written `(0 - N)` because that is
# what a `var` initialiser accepts; an enum member takes a NUMBER, not an
# expression — `E = (0 - 1)` is `expected number, got '('`. Measured on 6.6.2:
# a literal `-1` in a NAMED enum compiles and compares equal to `(0 - 1)`, while
# an ANONYMOUS `enum { ... }` is `expected identifier, got '{'`. Both facts are
# why this could not simply be a search-and-replace.
# [measured: three-way probe on cycc 6.6.2, 2026-09-10]
public enum HsbError {
    HSB_ERR_NONE              = 0;
    HSB_ERR_INVALID_TRANSFORM = -1;
    HSB_ERR_SINGULAR_MATRIX   = -2;
    HSB_ERR_OUT_OF_RANGE      = -3;
    HSB_ERR_DIVISION_BY_ZERO  = -4;
    HSB_ERR_DEGENERATE        = -5;
    HSB_ERR_INVALID_INTERVAL  = -6;
    HSB_ERR_ZERO_STEPS        = -7;
    HSB_ERR_NO_CONVERGENCE    = -8;
    HSB_ERR_SINGULAR_PIVOT    = -9;
    HSB_ERR_INVALID_INPUT     = -10;
    # Allocation failed, or a request was rejected by a dimension cap before it
    # could overflow. Added 2.6.14: solvers that size a working buffer from
    # caller-supplied dimensions previously stored through alloc's null return
    # instead of reporting.
    HSB_ERR_ALLOC             = -11;
}

# Tolerances
public var EPSILON_F64 = 0x3D719799812DEA11;        # 1e-12 as f64 bits

# The smallest MAGNITUDE whose reciprocal is still finite: DBL_MIN.
#
# ⭐ THE THIRD INSTANCE, so by this project's own rule it gets extracted. 2.10.2
# settled the rule this constant exists for — **guard exactly what makes the
# operation fail and nothing more; a threshold that needs a scale chosen for it
# IS the defect** — and three modules then wrote the same value under three
# different names: `_GEO_F64_TINY` (geo, 15 uses), `_AD_F64_TINY` (autodiff, 4)
# and `_QUAT_F64_TINY` (quat, 3). All three were byte-identical
# `0x0010_0000_0000_0000` and became aliases of this one, so the VALUE has a
# single definition and the constant gate has one literal to check instead of
# three. (3.3.7: `_GEO_F64_TINY` is a member of geo.cyr's constant enum, the same
# literal: an enum member is an immediate and cannot name a `var`. The constant gate
# reads enum members, so it checks that literal too.)
# ⚠ `_QUAT_F64_TINY` IS GONE as of 2.17.0 — not renamed, RETIRED. Both of its
# uses were guards on a length or a squared length, and both turned out to be the
# wrong test once the norms below them stopped flushing: DBL_MIN is one binade too
# strict for a reciprocal, so `hquat_normalize` moved onto the overflow test the
# vec family uses, and `hquat_inverse` onto an exact zero. The alias had no
# remaining caller and an unused global is not free.
#
# ⚠ NOT A REPLACEMENT FOR `EPSILON_F64`. This is the right threshold when the
# guard protects a DIVISION and the only thing that can actually fail is a zero
# (or subnormal) denominator. `EPSILON_F64` remains right for a genuinely
# dimensionless, bounded quantity — a normalised cosine, a barycentric weight, a
# parameter in [0,1] — where an absolute tolerance means something.
public var F64_TINY = 0x0010_0000_0000_0000;        # 2.2250738585072014e-308 (DBL_MIN)

# +Infinity, as a bit pattern.
#
# ⭐ THE FIFTH INSTANCE — this one was overdue. `_COL_F64_POS_INF`,
# `_SP_F64_POS_INF`, `_GA_F64_POS_INF` and `_GEO_F64_POS_INF` were byte-identical
# and became aliases of this one, so the value has a single definition and the
# constant gate has one literal to check instead of five. `_SP_` and `_GA_F64_POS_INF`
# are still live aliases; `_COL_F64_POS_INF` was deleted in 3.3.2, because nothing
# read it any more, and `_GEO_F64_POS_INF` became a geo.cyr enum member in 3.3.7, the
# same literal (see `F64_TINY` above).
# ⚠ `interval.cyr` keeps its own `_IVL_F64_POS_INF` literal on purpose: it is one
# of the five fully STANDALONE modules and does not include `error`, so aliasing
# it here would be a dependency, not a de-duplication.
#
# ⭐ Its main use is not a sentinel but a GUARD. When the operation that can fail
# is a RECIPROCAL, `f64_lt(f64_abs(1/x), F64_POS_INF)` is the exact test: it is 1
# for every finite reciprocal and 0 for both +Inf and NaN, so one comparison
# rejects x = 0, any x too small to invert, and a NaN — with no scale chosen for
# it. ⚠ `F64_TINY` is NOT equivalent there and is one binade too strict:
# 1/2^-1023 = 2^1023 is finite, so DBL_MIN refuses inputs that work.
public var F64_POS_INF = 0x7FF0_0000_0000_0000;     # +Infinity

# 1 when `code` is an error code -- any negative integer, which covers every HSB_ERR_*
# but HSB_ERR_NONE -- and 0 for HSB_ERR_NONE and every non-negative value. Infallible;
# reads nothing but its argument. It takes an INTEGER code: the `v` of an Err (`var t, v =
# f(...)`) or the return of a function that still returns a plain code. ⚠ Never a Result
# itself: in argument position a Result is its tag, Ok 0 and Err 1, and neither is
# negative, so the answer is 0 for both. Test a tag with `is_err_result(t)`.
public fn hisab_is_err(code) {
    if (code < 0) { return 1; }
    return 0;
}

# --- f64_util.cyr ---

# f64_util.cyr -- f64 helpers needed by hisab but not in cyrius stdlib
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/f64_util.cyr" after what it requires
# Requires: no other hisab module (stdlib resolves via cyrius.cyml [deps])
#
# Note: `f64_le` / `f64_ge` used to live here. Cyrius 6.2.x put NaN-correct copies in
# the stdlib `math` module, so the local ones were removed to avoid a duplicate
# definition. From cyrius 6.6.13 they (and `f64_trunc`) are compiler builtins and
# reserved names: defining one is a compile error, not a collision. A consumer on
# 6.6.2..6.6.12 still gets them from `math`.
# Transcendentals (`ganita_f64_acos`, `ganita_f64_pow`, `ganita_f64_atan2`,
# `ganita_f64_cosh`, `ganita_f64_sinh`, …) come from the stdlib `ganita` module.
#
# ⚠ CALL THEM BY THEIR `ganita_` NAMES. ganita 1.2.4 marks the bare `f64_*` and
# `mat_*` spellings **deprecated aliases, migration window only**; 2.11.4 moved all
# 536 hisab call sites off them. Comments that name a bare `f64_pow` / `mat_new`
# elsewhere in this tree are deliberate HISTORY -- they describe what a past ganita
# version did, under the name it had then -- and are not call sites.

# ⛔ 3.3.4 — `f64_tan` IS NOT DEFINED HERE ANY MORE. ganita 1.2.11 (cyrius >= 6.6.13)
# defines its own `f64_tan`, an alias of the fdlibm `ganita_f64_tan`, and hisab's
# sin/cos quotient beside it drew `duplicate fn 'f64_tan'` on every build. Last
# definition wins, so hisab's replaced ganita's for the whole program, a consumer's
# own calls included. CI's duplicate gate greps `duplicate symbol` and never saw it.
# The three callers (m4_perspective_rh, m4_perspective_reverse_z, se3_log) inline the
# same quotient, so their bits are unchanged on every pin. They do not call
# `ganita_f64_tan`: it does not exist below cyrius 6.6.13, every consumer pin is below
# that, and a consumer build reaching those three functions is then refused a binary
# (`refusing to emit binary with 1 reachable undefined function(s)`). A consumer
# calling `f64_tan` gets ganita's from 6.6.13. Below it, a reachable call is refused
# the same way, and an unreachable one draws `warning: undefined function 'f64_tan'`.
# [measured: scratch probes pinned to cycc 6.6.2..6.6.14, 2026-10-03]

# fmod(x, y) -- the C99 7.12.10.1 fmod: the remainder of TRUNCATED division, x - n*y for
# the integer n = trunc(x/y), computed EXACTLY (it is always representable). IEEE-754's
# `remainder` is a different operation: it rounds the quotient to nearest. The sign is
# the sign of x, a zero result included: fmod(-6, 3) is -0.
#   fmod(x, ±Inf) = x for finite x;  fmod(±Inf, y) = fmod(x, ±0) = 0xFFF8000000000000,
#   the default NaN x86-64 glibc and the 3.3.3 body return.
#   NaN in, NaN out: x's NaN if x is one, else y's, with the quiet bit (bit 51) set and
#   the sign and payload kept -- the operand and the bits x86-64 glibc returns.
# Every result is glibc's bit for bit, NaNs included: no difference in 279,211 pairs
# spanning every exponent, the subnormals, exact multiples, ±0, ±Inf and NaN payloads,
# under cycc 6.6.3, 6.6.6, 6.6.9, 6.6.10, 6.6.12 and 6.6.14 (y = ±0 excepted, until 3.4.0
# below). The 3.3.4 rows of the f64_fmod group in tests/modules.tcyr pin those values.
# [measured: scratch oracle sweep vs glibc 2.44 fmod, x86-64, 2026-10-03; not reproducible in-tree]
#
# ⛔ 3.4.0 — y = ±0 RETURNED +0 FOR EVERY x, NaN and ±Inf included (roadmap [3.4.0] D069).
# x - n*0 has no integer n that leaves a remainder smaller than |y| = 0, so there is no
# answer; C11 F.10.7.1 (C99 F.9.7.1) and IEEE 754 make it an invalid operation, NaN. +0 was a legal
# result, fmod(6, 3), so a caller could not tell the miss from an exact multiple. y = ±0
# now joins the invalid class beside x = ±Inf: x's NaN quieted when x is one, else the
# default NaN 0xFFF8000000000000, glibc's bits. Against an exact rational oracle and
# glibc 2.44 fmod over 18,400 pairs (15,168 finite with y != 0, 3,040 with y = ±0, the
# rest special values), every result matches both; 3.3.7 differed on exactly the 3,040
# y = ±0 pairs and on no other. The `hy == 0` test stays ahead of the normalisation: on
# my = 0 the y-normalisation loop would never end.
# [measured: scratch differential, python3 Fraction oracle and glibc 2.44, 18,400 pairs, 2026-10-31]
# [measured: tests/hisab.tcyr, group "3.4.0: f64_fmod(x, ±0) is NaN, the rest stays exact"]
#
# Integer bit operations only, in fdlibm's e_fmod shape: unpack both magnitudes,
# shift-subtract once per binade of exponent gap, renormalise. No f64 arithmetic, so the
# bits do not depend on the consumer's cycc pin, stdlib or target. A ±Inf divisor needs
# no branch of its own: every finite |x| is below it, so it returns x.
#
# History: it was x - floor(x/y)*y through 2.6.15, which takes the sign of the DIVISOR
# (fmod(-7, 3) gave +2), and x - trunc(x/y)*y from 2.7.0. That form rounds x/y, so it
# was not fmod either: fmod(1, 0.1) gave +0 where C gives 0x3FB9999999999996, a zero
# result was always +0, fmod(3, +Inf) gave NaN and fmod(DBL_MAX, 3 * 2^-1074) -Inf; it
# differed from glibc in 158,102 of the 279,211 pairs above.
# [measured: CHANGELOG.md 2.7.0; the 3.3.3 body beside this one in that scratch sweep, 2026-10-03]
#
# 2.15.0 replaced the trunc form's |y| < 1e-12 zero guard, which fabricated 0 for small
# divisors, with the exact-zero test kept below (`hy == 0`: it reads the magnitude, so
# -0.0 and +0.0 alike).
# [measured: docs/audit/2026-09-09-epsilon-open.json]
public fn f64_fmod(x, y) {
    var hy = y & 0x7FFF_FFFF_FFFF_FFFF;
    var sx = x & 0x8000_0000_0000_0000;
    var hx = x & 0x7FFF_FFFF_FFFF_FFFF;
    # y = ±0 first, on a branch of its own: folded into the test below as a third term it
    # cost 1 ns of the 22 on tests/hisab.bcyr's f64_fmod row, and this shape costs none.
    # [measured: tests/hisab.bcyr f64_fmod, both shapes against the base tree, 3 interleaved runs, 2026-10-31]
    if (hy == 0) {
        if (hx > 0x7FF0_0000_0000_0000) { return x | 0x0008_0000_0000_0000; }
        return 0xFFF8_0000_0000_0000;
    }
    if (hx >= 0x7FF0_0000_0000_0000 || hy > 0x7FF0_0000_0000_0000) {
        if (hx > 0x7FF0_0000_0000_0000) { return x | 0x0008_0000_0000_0000; }
        if (hy > 0x7FF0_0000_0000_0000) { return y | 0x0008_0000_0000_0000; }
        return 0xFFF8_0000_0000_0000;
    }
    if (hx < hy) { return x; }
    # Each magnitude is m * 2^(e - 1075): the implicit bit joins a normal mantissa, and a
    # subnormal takes e = 1 without it. A subnormal x needs nothing more, since |x| >= |y|
    # makes y subnormal too. y is normalised, so the loop's mx < 2*my holds from the start.
    var ex = hx >> 52;
    var mx = hx & 0x000F_FFFF_FFFF_FFFF;
    if (ex == 0) { ex = 1; } else { mx = mx | 0x0010_0000_0000_0000; }
    var ey = hy >> 52;
    var my = hy & 0x000F_FFFF_FFFF_FFFF;
    if (ey == 0) {
        ey = 1;
        while (my < 0x0010_0000_0000_0000) { my = my << 1; ey = ey - 1; }
    } else { my = my | 0x0010_0000_0000_0000; }
    # One step per binade of exponent gap: subtract my when it fits, then double. The gap
    # is at most 2097 (DBL_MAX's biased exponent 2046 less 2^-1074's normalised -51).
    # Branchless, as `_num_mulmod` is: t's sign bit is the data-dependent choice.
    var n = ex - ey;
    var t = 0;
    while (n > 0) {
        t = mx - my;
        mx = (t + (my & (0 - (t >> 63)))) << 1;
        n = n - 1;
    }
    t = mx - my;
    mx = t + (my & (0 - (t >> 63)));
    # A zero remainder returns here, which also keeps the renormalisation loop finite.
    if (mx == 0) { return sx; }
    # Renormalise. The remainder is a whole multiple of y's quantum, so a result below
    # the normal range drops only zero bits when it is shifted down to a subnormal.
    while (mx < 0x0010_0000_0000_0000) { mx = mx << 1; ey = ey - 1; }
    # `ey >= 1` and `ey > 1` are equivalent mutants: at ey = 1 the subnormal arm returns
    # sx | mx, and mx's bit 52 is exactly the exponent field 1.
    # [measured: scratch mutation run, not reproducible in-tree, 2026-10-03; cycc 6.6.14]
    if (ey >= 1) { return sx | (ey << 52) | (mx & 0x000F_FFFF_FFFF_FFFF); }
    return sx | (mx >> (1 - ey));
}

# copysign(x, y) -- magnitude of x, sign of y.
#
# IEEE-754 defines copysign on the SIGN BIT of y, so it is a bit operation, not a
# comparison. Through 2.6.15 this tested `f64_lt(y, 0)`, an ORDERED comparison,
# which is false for both -0.0 (equal to +0.0) and for a negative NaN (unordered)
# -- so copysign(3, -0.0) returned +3 and the function could never produce -0.0 at
# all. Splicing the bits handles every case including NaN payloads.
public fn f64_copysign(x, y) {
    return (x & 0x7FFF_FFFF_FFFF_FFFF) | (y & 0x8000_0000_0000_0000);
}

# f64_approx_eq(a, b, tol) -- 1 when a and b are within an ABSOLUTE tolerance, |a - b| < tol,
# else 0. The test is strict, so tol <= 0 (or NaN) holds for no pair, equal ones included;
# a NaN operand is never within any tol. Equal operands are 0 apart, two infinities of the
# same sign included (+Inf - +Inf is NaN, so they are tested as equal first). The
# difference is one rounding: a pair whose exact distance is just under tol can round to
# tol and read 0, and a finite pair whose difference overflows reads +Inf apart.
# ⛔ 3.4.1 — f64_approx_eq(+Inf, +Inf, 1) WAS 0 (roadmap [3.4.1], AU2-G7-F11): the difference
# Inf - Inf is NaN, which no `<` holds. -Inf beside -Inf likewise; +Inf beside -Inf, and
# either beside a finite value, stay 0.
# [measured: tests/edge_cases.tcyr, group "3.4.1: f64_approx_eq of two equal infinities"]
public fn f64_approx_eq(a, b, tol) {
    var d = f64_abs(f64_sub(a, b));
    if (f64_eq(a, b) == 1) { d = 0; }
    if (f64_lt(d, tol) == 1) { return 1; }
    return 0;
}

# --- vec2.cyr ---

# vec2.cyr -- 2D f64 vector type
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/vec2.cyr" after what it requires
# Requires: src/error.cyr (stdlib resolves via cyrius.cyml [deps])
#
# Heap-allocated: { x: f64, y: f64 } = 16 bytes

#derive(accessors)
public struct HVec2 { x; y; }

# A new HVec2 (x, y): 16 bytes from the heap, the components stored as given (any doubles).
# Returns the designed 0 where the allocation is refused (3.4.0); every constructor below too.
#must_use
public fn hvec2_new(x, y) {
    var v = alloc(sizeof(HVec2));
    if (v == 0) { return 0; }
    HVec2_set_x(v, x);
    HVec2_set_y(v, y);
    return v;
}

# A new zero vector (+0, +0), exact; the designed 0 where the allocation is refused.
#must_use
public fn hvec2_zero() { return hvec2_new(0, 0); }
# A new vector (1, 1), exact; the designed 0 where the allocation is refused.
#must_use
public fn hvec2_one() { return hvec2_new(F64_ONE, F64_ONE); }
# A new vector (s, s), s stored as given (any double, NaN and -0 kept bit for bit); the
# designed 0 where the allocation is refused.
#must_use
public fn hvec2_splat(s) { return hvec2_new(s, s); }

# ================================================================
# Arithmetic
# ================================================================

# a + b, componentwise: each component one IEEE addition, correctly rounded (overflow to
# +-Inf and NaN as IEEE gives them). Returns a new HVec2, or the designed 0 where the
# allocation is refused; so do `hvec2_sub`, `_mul`, `_scale` and `_neg`.
#must_use
public fn hvec2_add(a, b) {
    return hvec2_new(f64_add(HVec2_x(a), HVec2_x(b)), f64_add(HVec2_y(a), HVec2_y(b)));
}

# a - b, componentwise, each component correctly rounded.
#must_use
public fn hvec2_sub(a, b) {
    return hvec2_new(f64_sub(HVec2_x(a), HVec2_x(b)), f64_sub(HVec2_y(a), HVec2_y(b)));
}

# The componentwise (Hadamard) product (ax bx, ay by), each component correctly rounded.
#must_use
public fn hvec2_mul(a, b) {
    return hvec2_new(f64_mul(HVec2_x(a), HVec2_x(b)), f64_mul(HVec2_y(a), HVec2_y(b)));
}

# v times the scalar s, each component correctly rounded.
#must_use
public fn hvec2_scale(v, s) {
    return hvec2_new(f64_mul(HVec2_x(v), s), f64_mul(HVec2_y(v), s));
}

# -v, each component's sign flipped (`f64_neg`; below cycc 6.6.8 it gave +0 for +0).
#must_use
public fn hvec2_neg(v) {
    return hvec2_new(f64_neg(HVec2_x(v)), f64_neg(HVec2_y(v)));
}

# ================================================================
# Products and norms
# ================================================================

# a . b = ax bx + ay by: two products and one sum, within 2u (|ax bx| + |ay by|) of the exact
# value to first order (u = 2^-53); IEEE's zero sign (-0 exactly when both products are -0).
# Overflow and NaN follow IEEE (a product past DBL_MAX is +-Inf).
#must_use
public fn hvec2_dot(a, b) {
    return f64_add(f64_mul(HVec2_x(a), HVec2_x(b)), f64_mul(HVec2_y(a), HVec2_y(b)));
}

# |v|^2 = x^2 + y^2 (`hvec2_dot(v, v)`): +Inf once a square passes DBL_MAX (|x| >= 2^512), and
# subnormal, losing bits, once both |x| and |y| are below 2^-511 (0 below about 2^-537); use
# `hvec2_length` for the magnitude across the whole range.
#must_use
public fn hvec2_length_sq(v) { return hvec2_dot(v, v); }

# ⭐ TWO LEGS IS THE ONE ARITY THE STDLIB ALREADY COVERS. This was a hand-rolled
# scale-by-the-larger-leg loop until it was measured against `ganita_f64_hypot`
# and found **bit-identical on 6294 comparisons** — every binade from 2^-1074 to
# 2^1023, subnormals included, on equal legs, wildly asymmetric legs and negative
# legs, plus zero and ±Inf. Its one divergence, (Inf, NaN), is unreachable from
# `hvec2_length`: a NaN sum satisfies neither guard below and returns `sqrt(NaN)`
# without ever entering the rescue.
# ⚠ The 3- and 4-component helpers in vec3/vec4/quat/lie stay hand-rolled — there
# is no stdlib function of that arity to delegate to. Two legs is the exception,
# not the start of a pattern.
# [measured: scratch equivalence probe, 2026-09-10]
fn _hvec2_len_scaled(v) {
    return ganita_f64_hypot(HVec2_x(v), HVec2_y(v));
}

# ⛔ 2.17.0 — THIS SQUARED BEFORE SUMMING, AND LOST 537 BINADES AT THE BOTTOM AND
# 512 AT THE TOP. `x*x` underflows to zero for any component below 2^-537 and
# overflows to +Inf above 2^511, so a perfectly ordinary vector got a length of
# exactly 0 or exactly +Inf. ⚠ And it was materially wrong BEFORE it reached
# either: a SUBNORMAL sum has already lost most of its mantissa, so the answer is
# finite, plausible and wrong — measured 11.8% out at 2^-539, with nothing to
# signal it. That silent band is the dangerous third of the class.
# [measured: two-sided binade sweep, 2026-09-10]
#
# ⭐ FAST PATH, NOT UNCONDITIONAL SCALING. The naive sum announces its own failure:
# it is subnormal, zero or +Inf exactly when it cannot be trusted, and exact
# otherwise. So take it when it is NORMAL and rescale only when it is not.
# Measured: unconditional scaling costs **+119%** on this helper; the fast path
# costs **+12%** and is not distinguishable in any of the 72 tracked benchmarks
# (median delta -0.03%, the largest move being a row that never calls it).
# ⚠ The trigger is `< F64_TINY`, NOT `== 0` — measured, an `== 0` trigger leaves
# the subnormal band up to 11.8% wrong.
# ⚠ And the `+Inf` short-circuit inside the helper is REQUIRED: without it
# `Inf/Inf` is NaN and the documented infinity contract regresses.
# [measured: 1106-scale two-sided sweep; naive wrong at 60, guarded at 0]
#must_use
public fn hvec2_length(v) {
    var ls = hvec2_length_sq(v);
    if (f64_lt(ls, F64_TINY) == 1) { return _hvec2_len_scaled(v); }
    if (f64_eq(ls, F64_POS_INF) == 1) { return _hvec2_len_scaled(v); }
    return f64_sqrt(ls);
}

# v / |v|, the unit vector along v, for every finite non-zero v from the subnormals to DBL_MAX
# (the scaled copies below), within a few ulp per component (the comment below has the sample
# maxima). The zero vector gives the zero vector (it has no direction: a sentinel, |v| = 0, not
# a unit vector). A NaN component gives NaN components; an infinite one gives NaN in its own
# slot and zeros in the finite ones. Returns the designed 0 where an allocation is refused.
#must_use
public fn hvec2_normalize(v) {
    var len = hvec2_length(v);
    # ⛔ `len` is a LENGTH — degree one in the caller's units — and this tested it
    # against an absolute 1e-12, so a perfectly good short vector normalised to
    # the ZERO VECTOR: not an error value, just a wrong answer with no length.
    # ⭐ 2.14.0 tested what fails, `1 / len`, and for OVERFLOW ONLY: `f64_eq(|inv|, +Inf)`
    # caught len = 0 and any len too small to invert, and let a NaN fall through.
    # ⛔ The obvious `f64_lt(|inv|, F64_POS_INF) == 0` is wrong and `tests/abuse.tcyr`
    # says so out loud: it is false for NaN too, so it would silently zero a NaN vector,
    # and this API's documented contract is **NaN in, NaN out**.
    # ⚠ F64_TINY would have been one binade too strict for that zero exit: 1/2^-1023 is finite.
    # That guard is gone since 3.3.5 (last paragraph); its replacements, `len < DBL_MIN`,
    # `len == 0` and `1/len < DBL_MIN`, are all false for NaN, so NaN still runs the last line.
    # [measured: tests/foundation.tcyr normalize scale sweep, 2026-09-09]
    #
    # ⛔ 3.3.5 — AND THAT EXIT WAS STILL THE ZERO VECTOR FOR EVERY NON-ZERO LENGTH AT OR BELOW
    # 2^-1024, the class 3.3.4 repaired in `hvec3_normalize` only (audit D087): (2^-k, 0) for
    # k = 1023 .. 1074 normalised to the axis for 1 of 52, and (DBL_MAX, DBL_MAX) to (0, 0).
    # [measured: scratch harness, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
    # ⭐ `hvec3_normalize`'s repair, which says why: len < DBL_MIN normalises v * 2^1023 and
    # 1/len < DBL_MIN normalises v * 2^-600, both exact copies. len = 0 still gives the zero
    # vector and NaN runs the last line. On a sample of 1,500 lengths at or below 2^-1024
    # the largest error falls from 9.0e15 ulp to 1.95, and on 3,000 per band the bands
    # (2^-1024, 2^-1022) and (2^1022, DBL_MAX] from 4.73 and 4.76 ulp to 2.09 and the
    # unit-length 2.14 (sample maxima, not bounds).
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
    if (f64_lt(len, F64_TINY) == 1) {
        if (f64_eq(len, 0) == 1) { return hvec2_zero(); }
        var up = hvec2_scale(v, (1023 + 1023) << 52);   # 2^1023
        if (up == 0) { return 0; }
        return hvec2_scale(up, f64_div(F64_ONE, hvec2_length(up)));
    }
    var inv = f64_div(F64_ONE, len);
    if (f64_lt(inv, F64_TINY) == 1) {
        var dn = hvec2_scale(v, (1023 - 600) << 52);    # 2^-600
        if (dn == 0) { return 0; }
        return hvec2_scale(dn, f64_div(F64_ONE, hvec2_length(dn)));
    }
    return hvec2_scale(v, inv);
}

# |a - b|: `hvec2_length` of the difference, formed as `hvec2_sub` forms it (on the stack), so
# its error is the difference's rounding (u relative per component, u = 2^-53) and then the
# length's; +Inf where |a - b| rounds past DBL_MAX (IEEE's rounding: (DBL_MAX, 2^500) from 0 is
# DBL_MAX though its exact length exceeds it, and (DBL_MAX, DBL_MAX) from 0
# is +Inf with no component of the difference overflowing), and where a component overflows.
#must_use
public fn hvec2_distance(a, b) {
    # The difference is a stack HVec2 (3.4.0): this returns a length, with no value
    # left for a refused allocation, and hvec2_sub's heap copy was read unchecked.
    var d: i64[2];
    store64(&d, f64_sub(HVec2_x(a), HVec2_x(b)));
    store64(&d + 8, f64_sub(HVec2_y(a), HVec2_y(b)));
    return hvec2_length(&d);
}

# ================================================================
# Interpolation
# ================================================================

# a + (b - a) t per component, any real t (t outside [0, 1] extrapolates): three roundings,
# within u |a + (b - a) t| + 2u |(b - a) t| of the exact value to first order (u = 2^-53);
# t = 0 gives a (a -0 may come back +0), and t = 1 gives b only where b - a is exact.
# 3.4.1: where that form overflows for finite input (b - a past DBL_MAX, or its product with
# t), the component is computed at half scale (`_hvec2_lerp_wide`), so it is finite wherever
# the formula's value is: (-DBL_MAX, DBL_MAX) at 1/2 gave +Inf, exact 0. Every other component
# keeps the fast form's bits. Returns the designed 0 where the allocation is refused.
# 3.4.1 — SCALAR PER COMPONENT, the 3.4.0 packed form's operations in its order (sub, scale,
# add per lane), so the same bits; the result is then in hand and one exponent test per
# component sends a non-finite one to the helper. (cycc fuses no scalar f64_mul + f64_add on
# either target; `hvec3_lerp`'s z tail has always relied on that.) It replaced a first 3.4.1
# form that tested the inputs after the packed ops (3.4.1 review S1): identical bits on
# 30,002 random triples (huge, subnormal and ordinary components; t random, extrapolating,
# subnormal and powers of two), 3,375 special-value triples and 100,000 ordinary ones, at
# about half the overhead: against 3.4.0's packed form, vec2 19 -> 22 ns (+16%; the input test
# read 23 to 24, +23%), vec3 23 -> 26 ns (+13%; 28, +22%), 64 varying vec3 calls 1.44 ->
# 1.54 us (+7%; 1.69, +17%). Reading the packed result back costs a store-forwarding stall.
# [measured: scratch lerp sweep and fl2.bcyr, both trees, 3.4.0's form in each binary, 2026-10-31; cycc 6.7.18]
#must_use
public fn hvec2_lerp(a, b, t) {
    var r = alloc(sizeof(HVec2));
    if (r == 0) { return 0; }
    var ax = load64(a);                                              # x, at offset 0
    var ay = load64(a + 8);                                          # y, at offset 8
    var rx = f64_add(ax, f64_mul(f64_sub(load64(b), ax), t));
    var ry = f64_add(ay, f64_mul(f64_sub(load64(b + 8), ay), t));
    store64(r, rx);
    store64(r + 8, ry);
    if ((rx & 0x7FF0_0000_0000_0000) == 0x7FF0_0000_0000_0000) { return _hvec2_lerp_fix(r, a, b, t); }
    if ((ry & 0x7FF0_0000_0000_0000) == 0x7FF0_0000_0000_0000) { return _hvec2_lerp_fix(r, a, b, t); }
    return r;
}

# `hvec2_lerp`'s components through `_hvec2_lerp_wide` (each finite one kept); returns r.
fn _hvec2_lerp_fix(r, a, b, t) {
    HVec2_set_x(r, _hvec2_lerp_wide(HVec2_x(a), HVec2_x(b), t, HVec2_x(r)));
    HVec2_set_y(r, _hvec2_lerp_wide(HVec2_y(a), HVec2_y(b), t, HVec2_y(r)));
    return r;
}

# One component of a lerp whose fast form a + (b - a) t gave r. Where r is not finite while a,
# b and t are, b - a, its product with t or the sum overflowed, and the same formula on a / 2
# and b / 2, doubled, is that formula evaluated in an unbounded exponent range: the halves
# are exact wherever they can reach the answer (|a| and |b| are at least 2^970 when b - a
# overflows; a subnormal beside an overflowing (b - a) t is below half an ulp of the other
# operand), and every non-zero half-scale intermediate is at least 2^-51 in magnitude, so
# nothing rounds on the subnormal grid. The answer is finite wherever that evaluation is:
# (-DBL_MAX, DBL_MAX, 1/2) gives 0, where the fast form gave +Inf, and (DBL_MAX, 0, 3/2) gives
# -2^1023 + 2^971 (the exact -DBL_MAX / 2 is one ulp away: the product rounds), where it gave
# -Inf; it is +-Inf, IEEE's rounding, where the value is beyond DBL_MAX. A finite r is returned
# unchanged (a subnormal beside an overflowing component would not halve exactly), and so is
# the r of a NaN or infinite t (a subnormal halved to 0 times Inf is NaN, where the fast form's
# Inf is IEEE's answer). A NaN or infinite a or b needs no test: halving and doubling leave it
# as it is and a finite partner meets it only in a sum, so the half form gives the fast form's
# bits: on all 3,375 triples of 15 special values (zeros, subnormals, +-1, +-DBL_MAX, +-Inf,
# NaNs) the three functions give the bits that also testing a and b gave, while with no test
# at all 20 move, each with an infinite t.
# transforms.cyr's `hisab_lerp` and vec3.cyr's `_hvec3_lerp_wide` hold the same lines (a
# module cannot call another's `_` fn).
# [measured: scratch special-value sweep, guarded and unguarded builds, lane MAT, 2026-10-31; cycc 6.7.18]
fn _hvec2_lerp_wide(a, b, t, r) {
    if ((r & 0x7FF0_0000_0000_0000) != 0x7FF0_0000_0000_0000) { return r; }
    if ((t & 0x7FF0_0000_0000_0000) == 0x7FF0_0000_0000_0000) { return r; }
    var ha = f64_mul(a, F64_HALF);
    return f64_mul(f64_add(ha, f64_mul(f64_sub(f64_mul(b, F64_HALF), ha), t)), F64_TWO);
}

# --- vec3.cyr ---

# vec3.cyr -- 3D f64 vector type
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/vec3.cyr" after what it requires
# Requires: src/error.cyr (stdlib resolves via cyrius.cyml [deps])
#
# Heap-allocated: { x: f64, y: f64, z: f64 } = 24 bytes
#
# SIMD: HVec3 is 24 bytes = 3 doubles, so a packed op with n=3 would
# over-read one f64 past the allocation (the f64v loop steps 2/iter).
# The over-read-safe pattern is n=2 on the xy pair + a scalar z tail —
# still measurably faster than full scalar (dot ~2.2x, add ~1.6x).
# Intrinsics are global; keep them wrapped in functions (stack align).
# [measured: CHANGELOG.md 2.3.1, Performance: vec3 dot 20 -> 9 ns (~2.2x), vec3 add 35 -> 22 ns (~1.6x)]

#derive(accessors)
public struct HVec3 { x; y; z; }

# A new HVec3 (x, y, z): 24 bytes from the heap, the components stored as given (any doubles).
# Returns the designed 0 where the allocation is refused (3.4.0); so does every function in
# this file that returns an HVec3.
#must_use
public fn hvec3_new(x, y, z) {
    var v = alloc(sizeof(HVec3));
    if (v == 0) { return 0; }
    HVec3_set_x(v, x);
    HVec3_set_y(v, y);
    HVec3_set_z(v, z);
    return v;
}

# A new zero vector (+0, +0, +0), exact; the designed 0 where the allocation is refused.
#must_use
public fn hvec3_zero() { return hvec3_new(0, 0, 0); }
# A new vector (1, 1, 1), exact; the designed 0 where the allocation is refused.
#must_use
public fn hvec3_one() { return hvec3_new(F64_ONE, F64_ONE, F64_ONE); }
# A new vector (s, s, s), s stored as given (any double, NaN and -0 kept bit for bit); the
# designed 0 where the allocation is refused.
#must_use
public fn hvec3_splat(s) { return hvec3_new(s, s, s); }
# A new unit vector along x, (1, +0, +0), exact; the designed 0 where the allocation is refused.
#must_use
public fn hvec3_unit_x() { return hvec3_new(F64_ONE, 0, 0); }
# A new unit vector along y, (+0, 1, +0), exact; the designed 0 where the allocation is refused.
#must_use
public fn hvec3_unit_y() { return hvec3_new(0, F64_ONE, 0); }
# A new unit vector along z, (+0, +0, 1), exact; the designed 0 where the allocation is refused.
#must_use
public fn hvec3_unit_z() { return hvec3_new(0, 0, F64_ONE); }

# ================================================================
# Arithmetic
# ================================================================

# SIMD: xy pair via packed n=2, z scalar tail (over-read-safe).
# a + b, componentwise, each component one IEEE addition, correctly rounded (overflow and NaN
# as IEEE gives them), the same bits on x86 and aarch64 (one operation per lane).
#must_use
public fn hvec3_add(a, b) {
    var r = alloc(sizeof(HVec3));
    if (r == 0) { return 0; }
    f64v_add(r, a, b, 2);
    HVec3_set_z(r, f64_add(HVec3_z(a), HVec3_z(b)));
    return r;
}

# a - b, componentwise, each component correctly rounded (the `hvec3_add` layout).
#must_use
public fn hvec3_sub(a, b) {
    var r = alloc(sizeof(HVec3));
    if (r == 0) { return 0; }
    f64v_sub(r, a, b, 2);
    HVec3_set_z(r, f64_sub(HVec3_z(a), HVec3_z(b)));
    return r;
}

# The componentwise (Hadamard) product (ax bx, ay by, az bz), each correctly rounded.
#must_use
public fn hvec3_mul(a, b) {
    var r = alloc(sizeof(HVec3));
    if (r == 0) { return 0; }
    f64v_mul(r, a, b, 2);
    HVec3_set_z(r, f64_mul(HVec3_z(a), HVec3_z(b)));
    return r;
}

# v times the scalar s, each component correctly rounded.
#must_use
public fn hvec3_scale(v, s) {
    var r = alloc(sizeof(HVec3));
    if (r == 0) { return 0; }
    f64v_scale(r, v, s, 2);
    HVec3_set_z(r, f64_mul(HVec3_z(v), s));
    return r;
}

# -v, each component's sign flipped (`f64_neg`; below cycc 6.6.8 it gave +0 for +0).
#must_use
public fn hvec3_neg(v) {
    return hvec3_new(f64_neg(HVec3_x(v)),
      f64_neg(HVec3_y(v)),
      f64_neg(HVec3_z(v)));
}

# ================================================================
# Products and norms
# ================================================================

# SIMD: dot of xy pair via packed n=2 + scalar z (over-read-safe).
#
# a . b = (ax bx + ay by) + az bz, the natural evaluation order's value (three products, two
# sums: within 3u (|ax bx| + |ay by| + |az bz|) of the exact value to first order, u = 2^-53),
# bit for bit on x86 and aarch64 (the n = 2 packed dot has one lane per product). Overflow and
# NaN follow IEEE.
# ⚠ THE SIGN OF A ZERO IS +0 WHEREVER EVERY PRODUCT IS A ZERO, -0 included (3.4.1 states it;
# audit F-S1 / AU2-G7-F10): `f64v_dot` starts its accumulator at +0 on x86 and aarch64 alike,
# reference BLAS ddot's convention and the stdlib's definition, so (0, 0, 0) . (-1, -1, -1) is
# 0x0 where the natural-order IEEE sum ((0 * -1) + (0 * -1)) + (0 * -1) is 0x8000000000000000
# (`hvec2_dot`, all scalar, gives that -0). The exact value, 0, has no sign. Giving the IEEE -0
# (a zero result reading its products again) cost 5.4 to 8% per call on a 64-call row
# (425 -> 448 / 459 ns, the forms side by side in one binary) and 8 to 11% on the bench's dot
# rows, on the library's most-called primitive, for a sign no hisab caller reads: the two
# divisions by a dot in geo_diff refuse a non-finite reciprocal, and a zero t from a ray routine
# is the miss either way. So the convention is documented, not changed; `hvec4_dot` and
# `hquat_dot` share it.
# [measured: scratch flerp.bcyr and tests/hisab.bcyr, 3.4.0 and the fixed form, 2026-10-31; cycc 6.7.18]
#must_use
public fn hvec3_dot(a, b) {
    return f64_add(f64v_dot(a, b, 2), f64_mul(HVec3_z(a), HVec3_z(b)));
}

# a x b = (ay bz - az by, az bx - ax bz, ax by - ay bx), right-handed: each component two
# products and a difference, within 2u (|p| + |q|) of its exact value to first order (u = 2^-53,
# p and q its two products), so a component that cancels (nearly parallel a and b) carries
# that absolute error, not a relative one. Overflow and NaN follow IEEE.
#must_use
public fn hvec3_cross(a, b) {
    return hvec3_new(
      f64_sub(f64_mul(HVec3_y(a), HVec3_z(b)), f64_mul(HVec3_z(a), HVec3_y(b))),
      f64_sub(f64_mul(HVec3_z(a), HVec3_x(b)), f64_mul(HVec3_x(a), HVec3_z(b))),
      f64_sub(f64_mul(HVec3_x(a), HVec3_y(b)), f64_mul(HVec3_y(a), HVec3_x(b)))
      );
}

# |v|^2 (`hvec3_dot(v, v)`): +Inf once a square passes DBL_MAX (|component| >= 2^512), and
# subnormal, losing bits, once every component is below 2^-511; use `hvec3_length` for the
# magnitude across the whole range.
#must_use
public fn hvec3_length_sq(v) { return hvec3_dot(v, v); }

fn _hvec3_len_scaled(v) {
    var x = HVec3_x(v);
    var y = HVec3_y(v);
    var z = HVec3_z(v);
    var mx = f64_max(f64_max(f64_abs(x), f64_abs(y)), f64_abs(z));
    # ⚠ 3.3.3 — NaN NEVER REACHES HERE, and this exit depends on that. `f64_max` drops a
    # NaN in x or y and `f64_gt(mx, 0) == 0` is TRUE for NaN, so called directly this
    # helper gives (NaN, 0, 0) a length of 0. It is not called: a NaN makes the caller's
    # sum NaN, which is neither `< F64_TINY` nor `+Inf`, so `hvec3_length` returns
    # sqrt(NaN). That routing IS the NaN guard; tests/abuse.tcyr pins it slot by slot.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    if (f64_gt(mx, 0) == 0) { return mx; }
    # ⚠ Inf/Inf is NaN, so the infinity contract needs its own exit here.
    if (f64_eq(mx, F64_POS_INF) == 1) { return mx; }
    var xs = f64_div(x, mx);
    var ys = f64_div(y, mx);
    var zs = f64_div(z, mx);
    return f64_mul(mx, f64_sqrt(f64_add(f64_add(f64_mul(xs, xs), f64_mul(ys, ys)), f64_mul(zs, zs))));
}

# ⛔ 2.17.0 — THIS SQUARED BEFORE SUMMING, AND LOST 537 BINADES AT THE BOTTOM AND
# 512 AT THE TOP. `x*x` underflows to zero for any component below 2^-537 and
# overflows to +Inf above 2^511, so a perfectly ordinary vector got a length of
# exactly 0 or exactly +Inf. ⚠ And it was materially wrong BEFORE it reached
# either: a SUBNORMAL sum has already lost most of its mantissa, so the answer is
# finite, plausible and wrong — measured 11.8% out at 2^-539, with nothing to
# signal it. That silent band is the dangerous third of the class.
# [measured: two-sided binade sweep, 2026-09-10]
#
# ⭐ FAST PATH, NOT UNCONDITIONAL SCALING. The naive sum announces its own failure:
# it is subnormal, zero or +Inf exactly when it cannot be trusted, and exact
# otherwise. So take it when it is NORMAL and rescale only when it is not.
# Measured: unconditional scaling costs **+119%** on this helper; the fast path
# costs **+12%** and is not distinguishable in any of the 72 tracked benchmarks
# (median delta -0.03%, the largest move being a row that never calls it).
# ⚠ The trigger is `< F64_TINY`, NOT `== 0` — measured, an `== 0` trigger leaves
# the subnormal band up to 11.8% wrong.
# ⚠ And the `+Inf` short-circuit inside the helper is REQUIRED: without it
# `Inf/Inf` is NaN and the documented infinity contract regresses.
# [measured: 1106-scale two-sided sweep; naive wrong at 60, guarded at 0]
#must_use
public fn hvec3_length(v) {
    var ls = hvec3_length_sq(v);
    if (f64_lt(ls, F64_TINY) == 1) { return _hvec3_len_scaled(v); }
    if (f64_eq(ls, F64_POS_INF) == 1) { return _hvec3_len_scaled(v); }
    return f64_sqrt(ls);
}

# v / |v|, the unit vector along v, for every finite non-zero v from the subnormals to DBL_MAX
# (the scaled copies below; the comment has the sample maxima, about 2 ulp per component). The
# zero vector gives the zero vector, a sentinel with |v| = 0, not a unit vector (it has no
# direction). A NaN component gives NaN components; an infinite one gives NaN in its own slot
# and zeros in the finite ones. Returns the designed 0 where an allocation is refused.
#must_use
public fn hvec3_normalize(v) {
    var len = hvec3_length(v);
    # ⛔ `len` is a LENGTH — degree one in the caller's units — and this tested it
    # against an absolute 1e-12, so a perfectly good short vector normalised to
    # the ZERO VECTOR: not an error value, just a wrong answer with no length.
    # ⭐ 2.14.0 tested what fails, `1 / len`, and for OVERFLOW ONLY: `f64_eq(|inv|, +Inf)`
    # caught len = 0 and any len too small to invert, and let a NaN fall through.
    # ⛔ The obvious `f64_lt(|inv|, F64_POS_INF) == 0` is wrong and `tests/abuse.tcyr`
    # says so out loud: it is false for NaN too, so it would silently zero a NaN vector,
    # and this API's documented contract is **NaN in, NaN out**.
    # ⚠ F64_TINY would have been one binade too strict for that zero exit: 1/2^-1023 is finite.
    # That guard is gone since 3.3.5 (last paragraph); its replacements, `len < DBL_MIN`,
    # `len == 0` and `1/len < DBL_MIN`, are all false for NaN, so NaN still runs the last line.
    # [measured: tests/foundation.tcyr normalize scale sweep, 2026-09-09]
    #
    # ⛔ 3.3.4 — AND THAT TEST'S EXIT WAS THE ZERO VECTOR FOR EVERY NON-ZERO LENGTH AT OR
    # BELOW 2^-1024: (2^-k, 0, 0) normalised to (0, 0, 0) for 47 of the 48 subnormal k from
    # 1023 to 1070, and only 2^-1023 to the axis. tests/foundation.tcyr called that a
    # "documented tree-wide limit"; no document said so (audit D087). The top end had no
    # test at all: a finite vector whose length passes DBL_MAX got len = +Inf, inv = 0 and
    # the answer (0, 0, 0), for 1500 of 1500 random directions in a sweep.
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-03; cycc 6.6.14]
    # ⭐ Neither end needs a threshold, only an exact copy of v in range: v * 2^1023 where
    # 1/len overflowed (every component subnormal, so exact), v * 2^-600 where it was 0
    # (exact in every component that can reach the result). The answer is the bits this
    # function gives that copy, so the same direction at an ordinary scale.
    #
    # ⛔ 3.3.5 — BETWEEN THOSE ENDS AND THE ORDINARY RANGE TWO BANDS STILL LOST BITS. For a
    # length in (2^-1024, 2^-1022) 1/len is finite but len is rounded on the subnormal grid,
    # and for one in (2^1022, DBL_MAX] 1/len is subnormal; v * inv carried either rounding.
    # On 3,000 random directions per band: up to 4.84 and 5.43 ulp, where the same
    # directions at unit length reach 2.18.
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
    # ⭐ So each copy now starts where its rounding starts: len < DBL_MIN takes the 2^1023
    # copy and 1/len < DBL_MIN (len > 2^1022, or +Inf) the 2^-600 copy. Above, the answer is
    # the unit-length answer for the same direction, bit for bit (3,000 of 3,000), so its
    # sample maximum is the unit-length 2.18; below, it falls to 2.13 (sample maxima, not
    # bounds). Inputs that were within 1 ulp and now are not (183 above, 138 below) carry
    # their direction's unit-length error.
    # Every other input, NaN included, runs the last line unchanged; len = 0 still gives the
    # zero vector, and an infinite component still gives NaN beside zeros: Inf * 2^-600 is
    # Inf, and the copy's 1/len is 0 again.
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
    if (f64_lt(len, F64_TINY) == 1) {
        if (f64_eq(len, 0) == 1) { return hvec3_zero(); }
        var up = hvec3_scale(v, (1023 + 1023) << 52);   # 2^1023
        if (up == 0) { return 0; }
        return hvec3_scale(up, f64_div(F64_ONE, hvec3_length(up)));
    }
    var inv = f64_div(F64_ONE, len);
    if (f64_lt(inv, F64_TINY) == 1) {
        var dn = hvec3_scale(v, (1023 - 600) << 52);    # 2^-600
        if (dn == 0) { return 0; }
        return hvec3_scale(dn, f64_div(F64_ONE, hvec3_length(dn)));
    }
    return hvec3_scale(v, inv);
}

# |a - b|: `hvec3_length` of the difference, formed as `hvec3_sub` forms it (on the stack), so
# its error is the difference's rounding (u relative per component, u = 2^-53) and then the
# length's; +Inf where |a - b| rounds past DBL_MAX (IEEE's rounding: (DBL_MAX, 2^500) from 0 is
# DBL_MAX though its exact length exceeds it, and (DBL_MAX, DBL_MAX) from 0
# is +Inf with no component of the difference overflowing), and where a component overflows.
#must_use
public fn hvec3_distance(a, b) {
    # The difference is a stack HVec3 (3.4.0), formed exactly as hvec3_sub forms it: this
    # returns a length, with no value left for a refused allocation.
    var d: i64[3];
    f64v_sub(&d, a, b, 2);
    HVec3_set_z(&d, f64_sub(HVec3_z(a), HVec3_z(b)));
    return hvec3_length(&d);
}

# ================================================================
# Interpolation
# ================================================================

# a + (b - a) t per component, any real t: `hvec2_lerp`'s contract and accuracy, including
# 3.4.1's half-scale form where the fast form overflows for finite input
# (`_hvec3_lerp_wide`); every other component keeps the fast form's bits. Returns the
# designed 0 where the allocation is refused. `t3d_lerp` takes its position and scale here.
# 3.4.1: scalar per component, the 3.4.0 form's operations in its order (its xy pair was a
# packed sub -> scale -> add, its z tail this same scalar line), so the same bits, then one
# exponent test per component (`hvec2_lerp` says why, and what it replaced). NOT f64v_axpy /
# f64v_fmadd: those fuse on aarch64 (`fmla`), which rounds once where this rounds twice.
#must_use
public fn hvec3_lerp(a, b, t) {
    var r = alloc(sizeof(HVec3));
    if (r == 0) { return 0; }
    var ax = load64(a);                                              # x, at offset 0
    var ay = load64(a + 8);                                          # y, at offset 8
    var az = load64(a + 16);                                         # z, at offset 16
    var rx = f64_add(ax, f64_mul(f64_sub(load64(b), ax), t));
    var ry = f64_add(ay, f64_mul(f64_sub(load64(b + 8), ay), t));
    var rz = f64_add(az, f64_mul(f64_sub(load64(b + 16), az), t));
    store64(r, rx);
    store64(r + 8, ry);
    store64(r + 16, rz);
    if ((rx & 0x7FF0_0000_0000_0000) == 0x7FF0_0000_0000_0000) { return _hvec3_lerp_fix(r, a, b, t); }
    if ((ry & 0x7FF0_0000_0000_0000) == 0x7FF0_0000_0000_0000) { return _hvec3_lerp_fix(r, a, b, t); }
    if ((rz & 0x7FF0_0000_0000_0000) == 0x7FF0_0000_0000_0000) { return _hvec3_lerp_fix(r, a, b, t); }
    return r;
}

# `hvec3_lerp`'s components through `_hvec3_lerp_wide` (each finite one kept); returns r.
fn _hvec3_lerp_fix(r, a, b, t) {
    HVec3_set_x(r, _hvec3_lerp_wide(HVec3_x(a), HVec3_x(b), t, HVec3_x(r)));
    HVec3_set_y(r, _hvec3_lerp_wide(HVec3_y(a), HVec3_y(b), t, HVec3_y(r)));
    HVec3_set_z(r, _hvec3_lerp_wide(HVec3_z(a), HVec3_z(b), t, HVec3_z(r)));
    return r;
}

# vec2.cyr's `_hvec2_lerp_wide`, which has the reasons: the formula at half scale, doubled,
# for a non-finite r and a finite t; any other r unchanged.
fn _hvec3_lerp_wide(a, b, t, r) {
    if ((r & 0x7FF0_0000_0000_0000) != 0x7FF0_0000_0000_0000) { return r; }
    if ((t & 0x7FF0_0000_0000_0000) == 0x7FF0_0000_0000_0000) { return r; }
    var ha = f64_mul(a, F64_HALF);
    return f64_mul(f64_add(ha, f64_mul(f64_sub(f64_mul(b, F64_HALF), ha), t)), F64_TWO);
}

# ================================================================
# Component-wise utilities
# ================================================================

# ⛔ 3.3.3 — STDLIB `f64_min` / `f64_max` ANSWER FOR THE ARGUMENT ORDER, NOT THE
# VALUES. `f64_min(a, b)` is `a < b ? a : b`, so whenever that compare is false it
# returns b: a NaN in a is dropped and a NaN in b is kept, and of two zeros b's sign
# wins. Componentwise, hvec3_min((NaN,0,0), (1,0,0)).x was 1 but
# hvec3_min((1,0,0), (NaN,0,0)).x was NaN, hvec3_max the same, and
# hvec3_min((-0,..), (+0,..)).x was +0 but hvec3_min((+0,..), (-0,..)).x was -0.
# geo_aabb_new applies both to its two corners, so a corner with a NaN x gave the
# finite, degenerate slab [1, 1] in one argument order and NaN in the other.
# [measured: scratch probe on the 3.3.2 bundle, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
#
# ⭐ These are IEEE 754-2019 minimum and maximum, which read the values alone: NaN
# when either operand is NaN (that operand, payload and all; `a` when both are),
# -0 below +0, otherwise the smaller or the larger. Two operands that compare equal
# have identical bits unless they are zeros of opposite sign, so OR-ing them gives -0
# exactly when either is -0 and AND-ing gives +0 exactly when either is +0. The
# second compare is only an early exit: the lines after it return b for that pair too.
#
# ⚠ NOT FREE: a pair whose answer is the second operand now costs a second compare,
# and equal operands a third. On 64 random pairs, 16 interleaved runs a side against
# the tree before this change: one hvec3_min plus one hvec3_max 69.7 -> 71.8 ns
# (+2.9%), one geo_aabb_new 83.0 -> 85.3 ns (+2.8%), its slowest old run faster than
# its fastest new one. No tests/hisab.bcyr row reaches either: bvh_build folds its
# bounds with stdlib f64_min / f64_max directly.
# [measured: scratch interleaved A/B, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
fn _hvec3_min1(a, b) {
    if (f64_lt(a, b) == 1) { return a; }
    if (f64_lt(b, a) == 1) { return b; }
    if (f64_eq(a, b) == 1) { return a | b; }
    if (f64_eq(a, a) == 0) { return a; }
    return b;
}

fn _hvec3_max1(a, b) {
    if (f64_gt(a, b) == 1) { return a; }
    if (f64_gt(b, a) == 1) { return b; }
    if (f64_eq(a, b) == 1) { return a & b; }
    if (f64_eq(a, a) == 0) { return a; }
    return b;
}

# The componentwise IEEE 754-2019 minimum of a and b (`_hvec3_min1` above: NaN when either is
# NaN, -0 below +0).
#must_use
public fn hvec3_min(a, b) {
    return hvec3_new(_hvec3_min1(HVec3_x(a), HVec3_x(b)),
      _hvec3_min1(HVec3_y(a), HVec3_y(b)),
      _hvec3_min1(HVec3_z(a), HVec3_z(b)));
}

# The componentwise IEEE 754-2019 maximum of a and b (`_hvec3_max1`: NaN when either is NaN,
# +0 above -0).
#must_use
public fn hvec3_max(a, b) {
    return hvec3_new(_hvec3_max1(HVec3_x(a), HVec3_x(b)),
      _hvec3_max1(HVec3_y(a), HVec3_y(b)),
      _hvec3_max1(HVec3_z(a), HVec3_z(b)));
}

# (|x|, |y|, |z|), exact (the sign bits cleared; a NaN stays NaN).
#must_use
public fn hvec3_abs(v) {
    return hvec3_new(f64_abs(HVec3_x(v)), f64_abs(HVec3_y(v)), f64_abs(HVec3_z(v)));
}

# Reflect v about normal n (assumes n is normalized)
#must_use
public fn hvec3_reflect(v, n) {
    var d2 = f64_mul(F64_TWO, hvec3_dot(v, n));
    var nd = hvec3_scale(n, d2);
    if (nd == 0) { return 0; }
    return hvec3_sub(v, nd);
}

# Project v onto direction d (assumes d is normalized)
#must_use
public fn hvec3_project(v, d) {
    return hvec3_scale(d, hvec3_dot(v, d));
}

# Reject v from direction d (component perpendicular to d)
#must_use
public fn hvec3_reject(v, d) {
    var pr = hvec3_project(v, d);
    if (pr == 0) { return 0; }
    return hvec3_sub(v, pr);
}

# v times a power of two 2^p that puts its largest |component| in [1, 2), or in
# [2^-51, 1) when that component is subnormal: exact either way, so the direction is
# unchanged bit for bit. Written to o[0..2]; returns max |component| (0 for the zero
# vector). v must be finite. `mx >> 52` is mx's biased exponent, 0 for a subnormal
# (p = 1023 then). 2^p goes on as two normal powers of two, because 2^-1023 is not one.
fn _hvec3_pow2_copy(v, o) {
    var mx = f64_max(f64_max(f64_abs(HVec3_x(v)), f64_abs(HVec3_y(v))), f64_abs(HVec3_z(v)));
    var p = 1023 - (mx >> 52);
    var h = p / 2;
    var f1 = (1023 + h) << 52;
    var f2 = (1023 + p - h) << 52;
    store64(o, f64_mul(f64_mul(HVec3_x(v), f1), f2));
    store64(o + 8, f64_mul(f64_mul(HVec3_y(v), f1), f2));
    store64(o + 16, f64_mul(f64_mul(HVec3_z(v), f1), f2));
    return mx;
}

var _HV3_SPLIT = 0x41A0000002000000;      # 2^27 + 1 = 134217729
var _HV3_PI_LO = 0x3CA1A62633145C07;      # 1.2246467991473532e-16 (the true value minus F64_PI)
var _HV3_PI_2_LO = 0x3C91A62633145C07;    # 6.123233995736766e-17 (the true value minus F64_PI_2)
var _HV3_TWO52 = 0x4330000000000000;      # 2^52

# The e with a * b = p + e exactly, for p = RN(a * b): Dekker's product, split at
# 2^27 + 1 (no FMA). Exact while nothing overflows or reaches the subnormals.
# `hvec3_angle`'s scaled copies (|component| < 2) rule out the overflow; a product below
# about 2^-969 has a subnormal error term that loses its low bits, which matters only for
# angles near DBL_MIN (see `hvec3_angle`).
fn _hvec3_mul_err(a, b, p) {
    var t = f64_mul(a, _HV3_SPLIT);
    var ah = f64_sub(t, f64_sub(t, a));
    var al = f64_sub(a, ah);
    var u = f64_mul(b, _HV3_SPLIT);
    var bh = f64_sub(u, f64_sub(u, b));
    var bl = f64_sub(b, bh);
    return f64_add(f64_add(f64_add(f64_sub(f64_mul(ah, bh), p), f64_mul(ah, bl)), f64_mul(al, bh)),
      f64_mul(al, bl));
}

# The e with a + b = s + e exactly, for s = RN(a + b) (Knuth's two-sum).
fn _hvec3_add_err(a, b, s) {
    var bb = f64_sub(s, a);
    return f64_add(f64_sub(a, f64_sub(s, bb)), f64_sub(b, bb));
}

# a*b - c*d as a double-double: hi to o, lo to o + 8.
fn _hvec3_dd_dp(a, b, c, d, o) {
    var p1 = f64_mul(a, b);
    var p2 = f64_mul(c, d);
    var s = f64_sub(p1, p2);
    var lo = f64_add(_hvec3_add_err(p1, f64_neg(p2), s), f64_sub(_hvec3_mul_err(a, b, p1), _hvec3_mul_err(c, d, p2)));
    var hi = f64_add(s, lo);
    store64(o, hi);
    store64(o + 8, f64_sub(lo, f64_sub(hi, s)));
    return 0;
}

# The dot product of w[0..2] and w[3..5] as a double-double: hi to o, lo to o + 8.
fn _hvec3_dd_dot(w, o) {
    var a0 = load64(w); var a1 = load64(w + 8); var a2 = load64(w + 16);
    var b0 = load64(w + 24); var b1 = load64(w + 32); var b2 = load64(w + 40);
    var p0 = f64_mul(a0, b0);
    var p1 = f64_mul(a1, b1);
    var p2 = f64_mul(a2, b2);
    var s1 = f64_add(p0, p1);
    var s2 = f64_add(s1, p2);
    var lo = f64_add(f64_add(_hvec3_add_err(p0, p1, s1), _hvec3_add_err(s1, p2, s2)),
      f64_add(f64_add(_hvec3_mul_err(a0, b0, p0), _hvec3_mul_err(a1, b1, p1)), _hvec3_mul_err(a2, b2, p2)));
    var hi = f64_add(s2, lo);
    store64(o, hi);
    store64(o + 8, f64_sub(lo, f64_sub(hi, s2)));
    return 0;
}

# The length of the double-double vector at c[0..5] (hi, lo per component) as a
# double-double at r. Scaled by a power of two first, so no square flushes however
# small the vector (a cross product of nearly parallel vectors is), then a square root
# with one Newton correction.
fn _hvec3_dd_norm(c, r) {
    var h0 = load64(c); var h1 = load64(c + 16); var h2 = load64(c + 32);
    var mx = f64_max(f64_max(f64_abs(h0), f64_abs(h1)), f64_abs(h2));
    if (f64_eq(mx, 0) == 1) {
        store64(r, 0);
        store64(r + 8, 0);
        return 0;
    }
    var p = 1023 - (mx >> 52);
    var h = p / 2;
    var f1 = (1023 + h) << 52;
    var f2 = (1023 + p - h) << 52;
    h0 = f64_mul(f64_mul(h0, f1), f2); var l0 = f64_mul(f64_mul(load64(c + 8), f1), f2);
    h1 = f64_mul(f64_mul(h1, f1), f2); var l1 = f64_mul(f64_mul(load64(c + 24), f1), f2);
    h2 = f64_mul(f64_mul(h2, f1), f2); var l2 = f64_mul(f64_mul(load64(c + 40), f1), f2);
    var q0 = f64_mul(h0, h0);
    var q1 = f64_mul(h1, h1);
    var q2 = f64_mul(h2, h2);
    var s1 = f64_add(q0, q1);
    var s2 = f64_add(s1, q2);
    var lo = f64_add(f64_add(_hvec3_add_err(q0, q1, s1), _hvec3_add_err(s1, q2, s2)),
      f64_add(f64_add(_hvec3_mul_err(h0, h0, q0), _hvec3_mul_err(h1, h1, q1)), _hvec3_mul_err(h2, h2, q2)));
    lo = f64_add(lo, f64_mul(F64_TWO, f64_add(f64_add(f64_mul(h0, l0), f64_mul(h1, l1)), f64_mul(h2, l2))));
    var sh = f64_add(s2, lo);
    var sl = f64_sub(lo, f64_sub(sh, s2));
    var yh = f64_sqrt(sh);
    var yy = f64_mul(yh, yh);
    var yl = f64_div(f64_add(f64_sub(f64_sub(sh, yy), _hvec3_mul_err(yh, yh, yy)), sl), f64_mul(F64_TWO, yh));
    var g1 = (1023 - h) << 52;
    var g2 = (1023 - p + h) << 52;
    store64(r, f64_mul(f64_mul(yh, g1), g2));
    store64(r + 8, f64_mul(f64_mul(yl, g1), g2));
    return 0;
}

# (nh + nl) / (dh + dl) as a renormalised double-double at o: o holds the double
# nearest the quotient, o + 8 the rest.
fn _hvec3_dd_div(nh, nl, dh, dl, o) {
    var th = f64_div(nh, dh);
    var pp = f64_mul(th, dh);
    var tl = f64_div(f64_sub(f64_add(f64_sub(f64_sub(nh, pp), _hvec3_mul_err(th, dh, pp)), nl), f64_mul(th, dl)), dh);
    var t = f64_add(th, tl);
    store64(o, t);
    store64(o + 8, f64_sub(tl, f64_sub(t, th)));
    return 0;
}

# atan of the double-double at o, as r + c with r = atan(o[0]) rounded and c the
# first-order correction for o[1]; the caller adds them. Writes c to o + 8.
fn _hvec3_dd_atan(o) {
    var t = load64(o);
    store64(o + 8, f64_div(load64(o + 8), f64_add(F64_ONE, f64_mul(t, t))));
    return f64_atan(t);
}

# (hi + lo) - (r + c), rounded once: hi - r with its two-sum error, then the small terms.
fn _hvec3_dd_sub(hi, lo, r, c) {
    var s = f64_sub(hi, r);
    return f64_add(s, f64_sub(f64_add(_hvec3_add_err(hi, f64_neg(r), s), lo), c));
}

# The angle between w[0..2] and w[3..5], finite and non-zero: atan2(|a x b|, a.b) with
# both operands (y, x) as double-doubles. w has room for 18 words. Which atan:
#   x > 0           atan(y/x), while y/x <= 2^52: atan's one rounding is then the answer's
#   x < 0, y <= |x| pi - atan(y/|x|)
#   otherwise       pi/2 - atan(x/y), whose atan is below pi/4 and so rounds finer than
#                   the answer (x = 0 gives pi/2 exactly)
# x > 0 tests the renormalised quotient, which it needs anyway: y's high word can sit an
# ulp above x's when y = x, and pi/2 - atan(1) is an ulp off at 45 degrees. x < 0 tests the
# high words: there the answer's ulp is at least twice atan's, and deciding on the quotient
# instead changed none of 193,721 answers, 20,000 of them within 3 ulps of 135 degrees.
# [measured: scratch mutant harness and Decimal oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
fn _hvec3_angle_dd(w) {
    var a0 = load64(w); var a1 = load64(w + 8); var a2 = load64(w + 16);
    var b0 = load64(w + 24); var b1 = load64(w + 32); var b2 = load64(w + 40);
    _hvec3_dd_dp(a1, b2, a2, b1, w + 48);
    _hvec3_dd_dp(a2, b0, a0, b2, w + 64);
    _hvec3_dd_dp(a0, b1, a1, b0, w + 80);
    _hvec3_dd_norm(w + 48, w + 96);
    _hvec3_dd_dot(w, w + 112);
    var yh = load64(w + 96); var yl = load64(w + 104);
    var xh = load64(w + 112); var xl = load64(w + 120);
    var q = w + 128;
    if (f64_eq(xh, 0) == 0) {
        if (f64_gt(xh, 0) == 1) {
            _hvec3_dd_div(yh, yl, xh, xl, q);
            if (f64_le(load64(q), _HV3_TWO52) == 1) {
                var r0 = _hvec3_dd_atan(q);
                return f64_add(r0, load64(q + 8));
            }
        } elif (f64_le(yh, f64_neg(xh)) == 1) {
            _hvec3_dd_div(yh, yl, f64_neg(xh), f64_neg(xl), q);
            var r1 = _hvec3_dd_atan(q);
            return _hvec3_dd_sub(F64_PI, _HV3_PI_LO, r1, load64(q + 8));
        }
    }
    _hvec3_dd_div(xh, xl, yh, yl, q);
    var r2 = _hvec3_dd_atan(q);
    return _hvec3_dd_sub(F64_PI_2, _HV3_PI_2_LO, r2, load64(q + 8));
}

# 1 when every component of v is finite: the house non-finite test, once per slot.
fn _hvec3_finite(v) {
    if (f64_lt(f64_abs(HVec3_x(v)), F64_POS_INF) == 0) { return 0; }
    if (f64_lt(f64_abs(HVec3_y(v)), F64_POS_INF) == 0) { return 0; }
    if (f64_lt(f64_abs(HVec3_z(v)), F64_POS_INF) == 0) { return 0; }
    return 1;
}

# Angle between two vectors in radians
#must_use
public fn hvec3_angle(a, b) {
    # ⛔ THIS GUARD READ `denom < EPSILON_F64` AND CALLED PERPENDICULAR VECTORS
    # PARALLEL. `denom` is |a|·|b| — a length SQUARED, so it scales as the square
    # of the caller's units — and it was compared against an absolute 1e-12.
    # Measured: two EXACTLY perpendicular vectors return pi/2 at lengths 1, 1e-3
    # and 1e-6, and **0 rad at 1e-18**. Same geometry, different units, different
    # answer — and 0 is the value that means "parallel", so the function reports
    # the opposite of the truth rather than reporting failure.
    # [measured: probe over 4 scales on the 2.13.0 tree, 2026-09-09]
    #
    # ⭐ GUARD WHAT ACTUALLY FAILS. The only operation at risk is the division
    # `d / denom`, and by Cauchy-Schwarz |d| <= denom always, so the quotient is
    # in [-1, 1] and cannot overflow for ANY denom above zero. The division fails
    # only at a zero or subnormal denominator, which is exactly `F64_TINY`. There
    # is no scale to choose here, which is the point: a threshold that needs one
    # is the defect.
    # ⚠ The `return 0` stays — for a genuinely zero-length vector the angle is
    # undefined and this function has no error channel — but it is now
    # unreachable except for that genuinely degenerate input.
    # [measured: tests/foundation.tcyr scale-covariance sweep, 154 decades]
    #
    # ⛔ 3.3.4 — THE PARAGRAPH ABOVE WAS WRONG ABOUT WHAT FAILS. Below DBL_MIN the division
    # does not degenerate, its operands do: `d` and `denom` flush, and the `return 0` it
    # kept called EXACTLY PERPENDICULAR vectors parallel on 511 of the 1022 binades below
    # 1, and answered 0 for every pair below 2^-511 whatever the angle. tests/foundation.tcyr
    # pinned two of those zeros as "genuinely degenerate" (audit D089). A subnormal |a|
    # beside a normal |b| failed first: |a| is rounded onto the subnormal grid, so for
    # (2^-1074, 2^-1074, 0) against (2^1000, 0, 0) |a| = sqrt(2) * 2^-1074 became 2^-1074,
    # d/denom came out exactly 1, and the answer 0 for pi/4. Past DBL_MAX, (2^512, 0, 0) with itself was NaN, and
    # (2^1000, 0, 0) against (2^23, 2^24, 0), atan(2), was pi/2: a.b finite over denom +Inf.
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-03; cycc 6.6.14]
    # 3.3.4 sent exactly those inputs to atan2(|a' x b'|, a'.b') on power-of-two copies and
    # kept the acos line for the rest.
    #
    # ⛔ 3.3.5 — AND THE ACOS LINE WAS THE LARGER ERROR. acos is ill-conditioned near 0 and
    # pi: (1, 1, 0) with itself came back 2.1e-8 rad at every scale, nearly parallel pairs
    # were up to 1.1e26 ulp off, nearly opposed ones up to 6.7e7 ulp, and (1, 1, 0)
    # against (1, 0, 0) was one ulp above pi/4 on 64,094 of a 90,000-pair grid of scales.
    # Of 173,721 inputs, 30,918 were more than 1 ulp from the oracle. The plain atan2 line on
    # every input is no cure (its cross product cancels near 0; 3.3.4 measured it moving 188
    # of 38,406 answers past 1 ulp), and neither is Kahan's 2 atan2(|lb a - la b|, |lb a +
    # la b|), which is accurate only absolutely: 1.4e18 ulp on nearly parallel pairs and
    # 1,711 of 10,000 exact 45-degree pairs past 1 ulp.
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
    # ⭐ Every finite input now takes atan2(|a x b|, a.b) with both operands carried as
    # double-doubles (Dekker products, two-sums, a Newton-corrected square root) on copies
    # scaled by powers of two, so nothing overflows and the cross product keeps its last bits
    # for nearly parallel pairs. The atan is taken of a renormalised quotient, corrected to
    # first order, with pi and pi/2 as double-doubles (`_hvec3_angle_dd` says which quotient
    # where). What remains is atan's own rounding and one more: on the same 173,721 inputs
    # the largest error is 0.99 ulp, none is past 1 ulp, and 3,133 are not correctly rounded
    # where 113,188 were not. 816 that the acos line happened to round correctly are now
    # within 1 ulp instead, since one rounded atan cannot be correctly rounded everywhere.
    # Parallel, perpendicular and opposed stay 0, pi/2 and pi bit-exact at every scale: their
    # cross or dot product is exactly 0, double-double or not.
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
    # ⚠ Not past 1 ulp for an angle near DBL_MIN. When the copies' components span more than
    # about 2^1000, an angle that small is made of products that are themselves subnormal,
    # and the Dekker error terms lose their low bits. On 40,002 pairs sharing all but one or
    # two tiny components, 172 results were past 1 ulp (up to 2.66), every one below 2^-1020;
    # the 33,993 results at or above 2^-1020 were all within 0.96. (3.3.4 answered every one
    # of those pairs 0, 1.5e-8 or 2.1e-8.)
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
    # ⚠ COST: several times the acos line's arithmetic, not timed here; no tests/hisab.bcyr
    # row calls this function. A zero-length vector still returns 0, and a NaN or infinite
    # component still runs the acos line, unchanged (the finite test is on the components).
    if (_hvec3_finite(a) + _hvec3_finite(b) == 2) {
        var w[144];
        if (f64_eq(_hvec3_pow2_copy(a, &w), 0) == 1) { return 0; }
        if (f64_eq(_hvec3_pow2_copy(b, &w + 24), 0) == 1) { return 0; }
        return _hvec3_angle_dd(&w);
    }
    var d = hvec3_dot(a, b);
    var denom = f64_mul(hvec3_length(a), hvec3_length(b));
    return ganita_f64_acos(f64_clamp(f64_div(d, denom), f64_neg(F64_ONE), F64_ONE));
}

# --- vec4.cyr ---

# vec4.cyr -- 4D f64 vector type
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/vec4.cyr" after what it requires
# Requires: src/error.cyr, src/vec3.cyr (stdlib resolves via cyrius.cyml [deps])
#
# Heap-allocated: { x: f64, y: f64, z: f64, w: f64 } = 32 bytes
#
# SIMD: HVec4 is exactly 4 contiguous f64 (32 bytes), so the packed
# `f64v_*` builtins operate on it directly with n=4 (even — no
# over-read past the allocation). Intrinsics are global (no include).
# They MUST stay wrapped in functions — and since cycc 6.6.2 the
# COMPILER enforces that rather than leaving it to a runtime crash.
# ⭐ The old reason recorded here was wrong: it blamed a misaligned
# stack. The real one is that these intrinsics stash their operands in
# FRAME slots and top-level code has no frame. 6.6.2 refuses with
# `SIMD intrinsics must be called inside a function`; before it the
# same source compiled clean and SIGSEGV'd at run time on every
# release checked. Verified both ways on 6.6.1 (OK, then exit 139)
# and 6.6.2 (compile error). [measured: scratch harness, 2026-09-09]

#derive(accessors)
public struct HVec4 { x; y; z; w; }

# A new HVec4 (x, y, z, w): 32 bytes from the heap, the components stored as given. Returns
# the designed 0 where the allocation is refused (3.4.0); so does every function in this file
# that returns an HVec4 or HVec3.
#must_use
public fn hvec4_new(x, y, z, w) {
    var v = alloc(sizeof(HVec4));
    if (v == 0) { return 0; }
    HVec4_set_x(v, x);
    HVec4_set_y(v, y);
    HVec4_set_z(v, z);
    HVec4_set_w(v, w);
    return v;
}

# A new HVec4 holding (+0, +0, +0, +0), each component the all-zero bit pattern. Exact, no
# input to refuse; the designed 0 where the allocation is refused, as hvec4_new.
#must_use
public fn hvec4_zero() { return hvec4_new(0, 0, 0, 0); }
# A new HVec4 holding (1.0, 1.0, 1.0, 1.0), exact, with no input to refuse; the designed 0 where
# the allocation is refused, as hvec4_new.
#must_use
public fn hvec4_one() { return hvec4_new(F64_ONE, F64_ONE, F64_ONE, F64_ONE); }
# A new HVec4 holding (s, s, s, s). Any 64-bit s: it is stored as given, with no arithmetic, so a
# NaN, an infinity or a -0 is copied bit for bit. The designed 0 where the allocation is refused,
# as hvec4_new.
#must_use
public fn hvec4_splat(s) { return hvec4_new(s, s, s, s); }

# (v.x, v.y, v.z, w): an HVec3 extended by w (w = 1 a point, w = 0 a direction), bits copied.
#must_use
public fn hvec4_from_vec3(v, w) {
    return hvec4_new(HVec3_x(v), HVec3_y(v), HVec3_z(v), w);
}

# (x, y, z) of v as a new HVec3, w dropped (no division by w), bits copied.
#must_use
public fn hvec4_xyz(v) {
    return hvec3_new(HVec4_x(v), HVec4_y(v), HVec4_z(v));
}

# ================================================================
# Arithmetic
# ================================================================

# SIMD: packed add/sub over all 4 lanes (n=4, no over-read).
# a + b, componentwise, each component one IEEE addition, correctly rounded, the same bits on
# x86 and aarch64.
#must_use
public fn hvec4_add(a, b) {
    var r = alloc(sizeof(HVec4));
    if (r == 0) { return 0; }
    f64v_add(r, a, b, 4);
    return r;
}

# a - b, componentwise, each component correctly rounded.
#must_use
public fn hvec4_sub(a, b) {
    var r = alloc(sizeof(HVec4));
    if (r == 0) { return 0; }
    f64v_sub(r, a, b, 4);
    return r;
}

# SIMD: packed scale by scalar s (f64 bit pattern) over 4 lanes.
# v times s, each component correctly rounded.
#must_use
public fn hvec4_scale(v, s) {
    var r = alloc(sizeof(HVec4));
    if (r == 0) { return 0; }
    f64v_scale(r, v, s, 4);
    return r;
}

# -v, each component's sign flipped (`f64_neg`; below cycc 6.6.8 it gave +0 for +0).
#must_use
public fn hvec4_neg(v) {
    return hvec4_new(f64_neg(HVec4_x(v)),
      f64_neg(HVec4_y(v)),
      f64_neg(HVec4_z(v)),
      f64_neg(HVec4_w(v)));
}

# ================================================================
# Products and norms
# ================================================================

# SIMD: packed dot over all 4 lanes (no alloc — the biggest win).
#
# a . b, summed as the packed dot sums it: on x86 (ax bx + az bz) + (ay by + aw bw), each
# product and each sum rounded (within 3u of the sum of |a_i b_i| to first order, u = 2^-53).
# ⚠ NOT BIT-IDENTICAL ACROSS TARGETS: on aarch64 `f64v_dot` accumulates with a fused `fmla`,
# so each lane's second product is fused into its sum, fma(az, bz, ax bx) rounded once where
# x86 rounds the product first; the same bound holds and the last bits can differ. (CLAUDE.md's
# Language rule names `f64v_axpy` / `f64v_fmadd`; this is the same mechanism in `f64v_dot`,
# from the 6.7.18 emitters, and no test here runs on aarch64.) `hvec4_length_sq` and
# `hvec4_length` inherit it.
# ⚠ A ZERO IS +0 WHEREVER EVERY PRODUCT IS A ZERO, -0 included: `f64v_dot`'s accumulator
# starts at +0 (BLAS ddot's convention), so (-0, -0, -0, -0) . (1, 1, 1, 1) is 0x0 where the
# IEEE sum of the products is -0. Documented, not changed (3.4.1): the fix cost 8 to 11% on the
# dot rows; vec3.cyr's `hvec3_dot` has the reasons.
# [measured: scratch flerp.bcyr and tests/hisab.bcyr, 3.4.0 and the fixed form, 2026-10-31; cycc 6.7.18]
#must_use
public fn hvec4_dot(a, b) {
    return f64v_dot(a, b, 4);
}

# |v|^2 (`hvec4_dot(v, v)`, its summation order and its aarch64 caveat): +Inf once a square
# passes DBL_MAX (|component| >= 2^512), subnormal and losing bits once every component is
# below 2^-511; use `hvec4_length` for the magnitude across the whole range.
#must_use
public fn hvec4_length_sq(v) { return hvec4_dot(v, v); }
fn _hvec4_len_scaled(v) {
    var x = HVec4_x(v);
    var y = HVec4_y(v);
    var z = HVec4_z(v);
    var w = HVec4_w(v);
    var mx = f64_max(f64_max(f64_max(f64_abs(x), f64_abs(y)), f64_abs(z)), f64_abs(w));
    # ⚠ 3.3.3 — NaN never reaches here; see `_hvec3_len_scaled`. Called directly, this
    # max drops a NaN in x, y or z and the exit returns 0; `hvec4_length` routes a NaN
    # to its sqrt(NaN) fast path instead, and tests/abuse.tcyr pins that per slot.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    if (f64_gt(mx, 0) == 0) { return mx; }
    # ⚠ Inf/Inf is NaN, so the infinity contract needs its own exit here.
    if (f64_eq(mx, F64_POS_INF) == 1) { return mx; }
    var xs = f64_div(x, mx);
    var ys = f64_div(y, mx);
    var zs = f64_div(z, mx);
    var ws = f64_div(w, mx);
    var acc = f64_add(f64_mul(xs, xs), f64_mul(ys, ys));
    acc = f64_add(acc, f64_add(f64_mul(zs, zs), f64_mul(ws, ws)));
    return f64_mul(mx, f64_sqrt(acc));
}

# ⛔ 2.17.0 — THIS SQUARED BEFORE SUMMING, AND LOST 537 BINADES AT THE BOTTOM AND
# 512 AT THE TOP. `x*x` underflows to zero for any component below 2^-537 and
# overflows to +Inf above 2^511, so a perfectly ordinary vector got a length of
# exactly 0 or exactly +Inf. ⚠ And it was materially wrong BEFORE it reached
# either: a SUBNORMAL sum has already lost most of its mantissa, so the answer is
# finite, plausible and wrong — measured 11.8% out at 2^-539, with nothing to
# signal it. That silent band is the dangerous third of the class.
# [measured: two-sided binade sweep, 2026-09-10]
#
# ⭐ FAST PATH, NOT UNCONDITIONAL SCALING. The naive sum announces its own failure:
# it is subnormal, zero or +Inf exactly when it cannot be trusted, and exact
# otherwise. So take it when it is NORMAL and rescale only when it is not.
# Measured: unconditional scaling costs **+119%** on this helper; the fast path
# costs **+12%** and is not distinguishable in any of the 72 tracked benchmarks
# (median delta -0.03%, the largest move being a row that never calls it).
# ⚠ The trigger is `< F64_TINY`, NOT `== 0` — measured, an `== 0` trigger leaves
# the subnormal band up to 11.8% wrong.
# ⚠ And the `+Inf` short-circuit inside the helper is REQUIRED: without it
# `Inf/Inf` is NaN and the documented infinity contract regresses.
# [measured: 1106-scale two-sided sweep; naive wrong at 60, guarded at 0]
#must_use
public fn hvec4_length(v) {
    var ls = hvec4_length_sq(v);
    if (f64_lt(ls, F64_TINY) == 1) { return _hvec4_len_scaled(v); }
    if (f64_eq(ls, F64_POS_INF) == 1) { return _hvec4_len_scaled(v); }
    return f64_sqrt(ls);
}

# v / |v|, the unit vector along v, for every finite non-zero v from the subnormals to DBL_MAX
# (the scaled copies below; the comment has the sample maxima, about 2 ulp per component). The
# zero vector gives the zero vector, a sentinel with |v| = 0 (it has no direction). A NaN
# component gives NaN components; an infinite one gives NaN in its own slot and zeros in the
# finite ones. Returns the designed 0 where an allocation is refused.
#must_use
public fn hvec4_normalize(v) {
    var len = hvec4_length(v);
    # ⛔ `len` is a LENGTH — degree one in the caller's units — and this tested it
    # against an absolute 1e-12, so a perfectly good short vector normalised to
    # the ZERO VECTOR: not an error value, just a wrong answer with no length.
    # ⭐ 2.14.0 tested what fails, `1 / len`, and for OVERFLOW ONLY: `f64_eq(|inv|, +Inf)`
    # caught len = 0 and any len too small to invert, and let a NaN fall through.
    # ⛔ The obvious `f64_lt(|inv|, F64_POS_INF) == 0` is wrong and `tests/abuse.tcyr`
    # says so out loud: it is false for NaN too, so it would silently zero a NaN vector,
    # and this API's documented contract is **NaN in, NaN out**.
    # ⚠ F64_TINY would have been one binade too strict for that zero exit: 1/2^-1023 is finite.
    # That guard is gone since 3.3.5 (last paragraph); its replacements, `len < DBL_MIN`,
    # `len == 0` and `1/len < DBL_MIN`, are all false for NaN, so NaN still runs the last line.
    # [measured: tests/foundation.tcyr normalize scale sweep, 2026-09-09]
    #
    # ⛔ 3.3.5 — AND THAT EXIT WAS STILL THE ZERO VECTOR FOR EVERY NON-ZERO LENGTH AT OR BELOW
    # 2^-1024, the class 3.3.4 repaired in `hvec3_normalize` only (audit D087): (2^-k, 0, 0, 0)
    # for k = 1023 .. 1074 normalised to the axis for 1 of 52, and (DBL_MAX, DBL_MAX, 0, 0) to
    # the zero vector.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
    # ⭐ `hvec3_normalize`'s repair, which says why: len < DBL_MIN normalises v * 2^1023 and
    # 1/len < DBL_MIN normalises v * 2^-600, both exact copies. len = 0 still gives the zero
    # vector and NaN runs the last line. On a sample of 1,500 lengths at or below 2^-1024
    # the largest error falls from 9.0e15 ulp to 2.21, and on 3,000 per band the bands
    # (2^-1024, 2^-1022) and (2^1022, DBL_MAX] from 4.49 and 4.73 ulp to 2.06 and the
    # unit-length 1.98 (sample maxima, not bounds).
    # [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
    if (f64_lt(len, F64_TINY) == 1) {
        if (f64_eq(len, 0) == 1) { return hvec4_zero(); }
        var up = hvec4_scale(v, (1023 + 1023) << 52);   # 2^1023
        if (up == 0) { return 0; }
        return hvec4_scale(up, f64_div(F64_ONE, hvec4_length(up)));
    }
    var inv = f64_div(F64_ONE, len);
    if (f64_lt(inv, F64_TINY) == 1) {
        var dn = hvec4_scale(v, (1023 - 600) << 52);    # 2^-600
        if (dn == 0) { return 0; }
        return hvec4_scale(dn, f64_div(F64_ONE, hvec4_length(dn)));
    }
    return hvec4_scale(v, inv);
}

# --- quat.cyr ---

# quat.cyr -- quaternion type for 3D rotations
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/quat.cyr" after what it requires
# Requires: src/error.cyr, src/vec3.cyr (stdlib resolves via cyrius.cyml [deps])
#
# Heap-allocated: { x: f64, y: f64, z: f64, w: f64 } = 32 bytes
# Convention: w is the scalar part, (x, y, z) is the vector part.

# No module-local threshold. From 2.11.1 a `_QUAT_F64_TINY` (DBL_MIN: a literal through
# 2.13.0, an alias of error.cyr's F64_TINY from 2.14.0) stood here, and `hquat_normalize`
# (on |q|) and `hquat_inverse` (on |q|²) returned the identity below it; 2.17.0 removed
# it. From 2.17.0 to 3.3.3 `hquat_normalize` returned the identity wherever 1/|q|
# overflows (|q| = 0, or |q| <= 2^-1024); since 3.3.4 only at |q| = 0. `hquat_length`,
# `hquat_normalize` (since 3.3.5) and `hquat_inverse` use F64_TINY directly, to choose
# between their direct and rescaled paths. 3.4.0 retired both for `_checked` forms that
# return `Err` for the zero quaternion, which has no inverse and no direction (they returned
# the identity), and for a NaN or infinite component.

enum _QuatF64 {
    _QUAT_NAN  = 0x7FF8_0000_0000_0000;   # NaN: `hquat_slerp` where its interpolant has no direction
    _QUAT_N_LO = 0x3FD0_0000_0000_0000;   # 0.25
    _QUAT_N_HI = 0x4030_0000_0000_0000;   # 16.0
    _QUAT_D_HI = 0x3FEF_FBE7_6C8B_4396;   # 0.9995
}

#derive(accessors)
public struct HQuat { x; y; z; w; }

# 3.4.0 (the [3.3.8] allocation row): every function here that allocates returns the designed 0
# when the allocation is refused (an exhausted heap), and every Result returns Err(HSB_ERR_ALLOC);
# none stores through a 0 handle. A 0 handle passed IN is the caller's.

# A new HQuat (x, y, z, w), w the scalar part: 32 bytes from the heap, the components stored
# as given. Returns the designed 0 where the allocation is refused (3.4.0).
#must_use
public fn hquat_new(x, y, z, w) {
    var q = alloc(sizeof(HQuat));
    if (q == 0) { return 0; }
    HQuat_set_x(q, x);
    HQuat_set_y(q, y);
    HQuat_set_z(q, z);
    HQuat_set_w(q, w);
    return q;
}

# (0, 0, 0, 1), the rotation by nothing.
#must_use
public fn hquat_identity() { return hquat_new(0, 0, 0, F64_ONE); }

# The quaternion (axis sin(angle / 2), cos(angle / 2)) of the right-handed rotation by `angle`
# radians about `axis` (counterclockwise seen from the axis tip), angle / 2 exact (a halving)
# and its sine and cosine as `f64_sin` / `f64_cos` round them, each product rounded once.
# `axis` must be a unit vector for q to be the rotation by `angle`: otherwise q is not unit, and
# the rotation it represents (q / |q|, as `hquat_rotate_vec3` applies it) is about axis's
# direction by 2 atan2(|axis| sin(angle / 2), cos(angle / 2)), not by `angle`; a zero axis gives
# (0, 0, 0, cos(angle / 2)). Returns the designed 0 where the allocation is refused.
#must_use
public fn hquat_from_axis_angle(axis, angle) {
    var half = f64_mul(angle, F64_HALF);
    var s = f64_sin(half);
    var c = f64_cos(half);
    return hquat_new(f64_mul(HVec3_x(axis), s),
      f64_mul(HVec3_y(axis), s),
      f64_mul(HVec3_z(axis), s), c);
}

# The unit quaternion (sin(angle / 2), 0, 0, cos(angle / 2)) of the right-handed rotation by
# `angle` radians about X; `_y` and `_z` below likewise about Y and Z. angle / 2 is exact and its
# sine and cosine are `f64_sin` / `f64_cos`'s. Returns the designed 0 where the allocation is
# refused.
#must_use
public fn hquat_from_rotation_x(angle) {
    var half = f64_mul(angle, F64_HALF);
    return hquat_new(f64_sin(half), 0, 0, f64_cos(half));
}

# (0, sin(angle / 2), 0, cos(angle / 2)): the rotation by `angle` radians about Y.
#must_use
public fn hquat_from_rotation_y(angle) {
    var half = f64_mul(angle, F64_HALF);
    return hquat_new(0, f64_sin(half), 0, f64_cos(half));
}

# (0, 0, sin(angle / 2), cos(angle / 2)): the rotation by `angle` radians about Z.
#must_use
public fn hquat_from_rotation_z(angle) {
    var half = f64_mul(angle, F64_HALF);
    return hquat_new(0, 0, f64_sin(half), f64_cos(half));
}

# ================================================================
# Arithmetic -- Hamilton product: q * r
# ================================================================

# The Hamilton product q r (w the scalar part). As rotations q r applies r first, then q:
# rotating v by q r is rotating it by r and the result by q. Each component is a sum of four
# products, within 4u of the sum of their magnitudes to first order (u = 2^-53); |q r| = |q| |r|
# in exact arithmetic, so unit inputs give a product unit to a few u. Overflow and NaN follow
# IEEE. Returns the designed 0 where the allocation is refused.
#must_use
public fn hquat_mul(q, r) {
    var qx = HQuat_x(q); var qy = HQuat_y(q); var qz = HQuat_z(q); var qw = HQuat_w(q);
    var rx = HQuat_x(r); var ry = HQuat_y(r); var rz = HQuat_z(r); var rw = HQuat_w(r);
    return hquat_new(
      f64_add(f64_add(f64_mul(qw, rx), f64_mul(qx, rw)),
        f64_sub(f64_mul(qy, rz), f64_mul(qz, ry))),
      f64_add(f64_add(f64_mul(qw, ry), f64_mul(qy, rw)),
        f64_sub(f64_mul(qz, rx), f64_mul(qx, rz))),
      f64_add(f64_add(f64_mul(qw, rz), f64_mul(qz, rw)),
        f64_sub(f64_mul(qx, ry), f64_mul(qy, rx))),
      f64_sub(f64_mul(qw, rw),
        f64_add(f64_add(f64_mul(qx, rx), f64_mul(qy, ry)), f64_mul(qz, rz)))
      );
}

# The conjugate (-x, -y, -z, w), exact (`f64_neg`; below cycc 6.6.8 it gave +0 for +0): the
# inverse of a unit q, the reverse rotation. Returns the designed 0 where the allocation is
# refused.
#must_use
public fn hquat_conjugate(q) {
    return hquat_new(f64_neg(HQuat_x(q)), f64_neg(HQuat_y(q)),
      f64_neg(HQuat_z(q)), HQuat_w(q));
}

# SIMD: quat is 4 contiguous f64 (32 bytes), packed dot at n=4 (no over-read).
#
# The 4-vector dot product of a and b (x, y, z, w), summed as `hvec4_dot` sums it, with its
# accuracy and its zero convention (+0 wherever every product is a zero, -0 included; vec3.cyr's
# `hvec3_dot` says why that is documented rather than changed).
# ⚠ NOT BIT-IDENTICAL ACROSS TARGETS (vec4.cyr's `hvec4_dot` says why: aarch64 fuses each
# lane's second product), and through it `hquat_length_sq`, `hquat_length`,
# `hquat_normalize_checked`, `hquat_inverse_checked` and `hquat_slerp` may differ in their
# last bits between x86 and aarch64.
#must_use
public fn hquat_dot(a, b) {
    return f64v_dot(a, b, 4);
}

# |q|^2 (`hquat_dot(q, q)`, its summation order and its aarch64 caveat): +Inf once a square
# passes DBL_MAX (|component| >= 2^512), subnormal and losing bits once every component is
# below 2^-511; `hquat_length` holds the whole range.
#must_use
public fn hquat_length_sq(q) { return hquat_dot(q, q); }
#must_use
fn _hquat_len_scaled(q) {
    var x = HQuat_x(q); var y = HQuat_y(q); var z = HQuat_z(q); var w = HQuat_w(q);
    var mx = f64_max(f64_max(f64_abs(x), f64_abs(y)), f64_max(f64_abs(z), f64_abs(w)));
    # ⚠ 3.3.3 — NaN never reaches here; see `_hvec3_len_scaled`. Called directly, this
    # max drops a NaN in x, y or z and the exit returns 0; `hquat_length` routes a NaN
    # to its sqrt(NaN) fast path instead, and tests/abuse.tcyr pins that per slot.
    # [measured: scratch harness, not reproducible in-tree, 2026-10-01; cycc 6.6.12]
    if (f64_gt(mx, 0) == 0) { return mx; }
    # ⚠ Inf/Inf is NaN, so the infinity contract needs its own exit here.
    if (f64_eq(mx, F64_POS_INF) == 1) { return mx; }
    var xs = f64_div(x, mx); var ys = f64_div(y, mx);
    var zs = f64_div(z, mx); var ws = f64_div(w, mx);
    var acc = f64_add(f64_mul(xs, xs), f64_mul(ys, ys));
    acc = f64_add(acc, f64_add(f64_mul(zs, zs), f64_mul(ws, ws)));
    return f64_mul(mx, f64_sqrt(acc));
}

# ⛔ 2.17.0 — same class as `hvec3_length`: squaring before summing loses 537
# binades below and 512 above, and is silently wrong in the subnormal band
# between. ⚠ This one matters beyond its own module: `hquat_normalize` and
# `hquat_inverse` are what 2.11.1 repaired for returning a fabricated IDENTITY —
# the guard was fixed then, the norm was not.
# ⛔ AND AN EARLIER DRAFT OF THIS VERY COMMENT SAID BOTH OF THEM "route through
# it", WHICH WAS FALSE FOR `hquat_inverse` — it reads `hquat_length_sq` directly
# and so kept the whole defect, 1018 of 2041 binades, 507 of them the fabricated
# identity this file has now claimed to have fixed twice. A comment asserting a
# call graph is a claim like any other and this one was never checked.
# [measured: 2041-binade two-sided sweep on q*q^-1, 2026-09-10]
public fn hquat_length(q) {
    var ls = hquat_length_sq(q);
    if (f64_lt(ls, F64_TINY) == 1) { return _hquat_len_scaled(q); }
    if (f64_eq(ls, F64_POS_INF) == 1) { return _hquat_len_scaled(q); }
    return f64_sqrt(ls);
}

# q * s normalised, for an exact power of two s: `hquat_normalize`'s two ends (3.3.4).
fn _hquat_scaled_unit(q, s) {
    var t = alloc(sizeof(HQuat));
    if (t == 0) { return 0; }
    f64v_scale(t, q, s, 4);
    var r = alloc(sizeof(HQuat));
    if (r == 0) { return 0; }
    f64v_scale(r, t, f64_div(F64_ONE, hquat_length(t)), 4);
    return r;
}

#must_use
# 2.11.1: threshold was EPSILON_F64 (1e-12), which fabricated the identity for
# any quaternion shorter than that even though the division is well-defined far
# below it. `len` is unsquared so the units were at least right -- unlike
# hquat_inverse below, which was out by the square.
# ⛔ 2.17.0 — AND THE THRESHOLD WAS STILL WRONG AFTER 2.11.1, in the direction
# `src/error.cyr` already names out loud: DBL_MIN is one binade too strict for a
# RECIPROCAL, because `1 / 2^-1023` is finite. That was harmless while the norm
# itself flushed at 2^-537 — the band was unreachable — and repairing
# `hquat_length` above made it reachable, so this guard began fabricating the
# identity for a quaternion that normalises perfectly well.
# ⚠ Measured: **48 of 48** subnormal magnitudes returned the identity here while
# the already-repaired `hvec3_normalize` returned the unit vector for the same
# input. ⭐ The vec family was moved onto the reciprocal-overflow test in 2.14.0;
# this one was not, and repairing the norm without repairing the guard is a NET
# REGRESSION over those 52 binades.
# ⚠ `f64_eq(|inv|, +Inf)` and not the tempting `f64_lt(|inv|, +Inf) == 0`: the
# latter is false for NaN too, and this API's contract is NaN in, NaN out.
# [measured: 48-binade subnormal sweep against the vec3 control, 2026-09-10]
# ⛔ 3.3.4 — AND THE TWO THEN AGREED ON THE WRONG ANSWER: both returned their fallback,
# here the IDENTITY, for 47 of those 48 magnitudes, every non-zero |q| <= 2^-1024. A
# finite quaternion whose norm passes DBL_MAX came back as the ZERO quaternion
# (inv = 1/Inf = 0), which is not a unit at all. Audit D087.
# [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-03; cycc 6.6.14]
# ⭐ The `hvec3_normalize` repair: normalise an exactly scaled copy, by 2^1023 where
# 1/|q| overflows and by 2^-600 where it is 0, and return that copy's bits. `|q| = 0`
# kept the documented identity until 3.4.0 (below); NaN ran the last lines.
# ⛔ 3.3.5 — and, as there, the two bands beside those ends still carried a subnormal
# rounding: |q| in (2^-1024, 2^-1022), where |q| itself is subnormal, and |q| in (2^1022,
# DBL_MAX], where 1/|q| is. Up to 4.65 and 5.23 ulp on 3,000 random quaternions per band,
# against 2.04 for the same directions at unit length. The copies now start at |q| < DBL_MIN
# and 1/|q| < DBL_MIN: the low band's sample maximum falls to 2.07 (a reviewer's
# independent sample found 2.51; neither is a bound), and the high band is the
# unit-length answer bit for bit (3,000 of 3,000). 139 and 222 inputs that were within 1 ulp
# now carry their direction's unit-length error instead.
# [measured: scratch harness and Decimal oracle, not reproducible in-tree, 2026-10-11; 2.51: the review's sample]
# ⛔ 3.4.0 — `hquat_normalize` RETURNED THE IDENTITY FOR q = 0 (audit D088): the zero
# quaternion has no direction, and the identity is a unit quaternion, a legal answer, with no
# error channel. `hquat_normalize_checked` returns `Err(HSB_ERR_DIVISION_BY_ZERO)` there and
# `Err(HSB_ERR_INVALID_INPUT)` for a NaN or infinite component (which gave a NaN quaternion);
# every other q gets the bits `hquat_normalize` gave it. The fast-path test is written
# positively, so a NaN length leaves it. `hquat_normalize` is retired, not redefined.
#must_use
public fn hquat_normalize_checked(q) {
    var len = hquat_length(q);
    var inv = f64_div(F64_ONE, len);
    if (f64_ge(len, F64_TINY) == 1 && f64_ge(inv, F64_TINY) == 1) {
        var r = alloc(sizeof(HQuat));
        if (r == 0) { return Err(HSB_ERR_ALLOC); }
        f64v_scale(r, q, inv, 4);
        return Ok(r);
    }
    if (_hquat_finite(q) == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    var su = 0;
    if (f64_lt(len, F64_TINY) == 1) {
        if (f64_eq(len, 0) == 1) { return Err(HSB_ERR_DIVISION_BY_ZERO); }
        su = _hquat_scaled_unit(q, (1023 + 1023) << 52);   # 2^1023
    } else {
        su = _hquat_scaled_unit(q, (1023 - 600) << 52);    # 2^-600
    }
    if (su == 0) { return Err(HSB_ERR_ALLOC); }
    return Ok(su);
}

# 1 when every component of q is finite.
fn _hquat_finite(q) {
    var i = 0;
    while (i < 4) {
        if ((load64(q + i * 8) & 0x7FFF_FFFF_FFFF_FFFF) >= 0x7FF0_0000_0000_0000) { return 0; }
        i = i + 1;
    }
    return 1;
}

# 1 when every component of q is a zero of either sign.
fn _hquat_is_zero(q) {
    var o = HQuat_x(q) | HQuat_y(q) | HQuat_z(q) | HQuat_w(q);
    if ((o & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return 1; }
    return 0;
}

#must_use
# 2.11.1: `len_sq` is a SQUARED magnitude and was compared against the UNSQUARED
# EPSILON_F64, so the effective threshold was |q| < 1e-6 -- six orders of
# magnitude coarser than intended, and the seventh instance of a class first
# recorded in complex.cyr in 2.6.14.
#
# It did not return a wrong number, it returned the IDENTITY: measured, q*q^-1
# stopped equalling the identity at |q| ~ 1e-7, where the error jumps from 0 to
# 1.0 because the "inverse" is the identity and q is nearly zero. A quaternion of
# magnitude 1.4e-7 has an inverse of magnitude 7e6 -- finite, representable, and
# silently replaced by a rotation of zero.
# [measured: tests/foundation.tcyr "2.11.1 quat: inverse and normalize are scale-covariant"]
# ⛔ 2.17.0 — THIS IS THE SITE THE RELEASE MISSED ON ITS FIRST PASS. It reads
# `hquat_length_sq` DIRECTLY, so repairing `hquat_length` above did nothing for
# it: measured, **1018 of 2041 binades wrong**, and **507 of them returned the
# fabricated IDENTITY** — the exact failure the 2.11.1 note below says it fixed.
# 2.11.1 moved the threshold from 1e-6 to DBL_MIN; the fabrication simply moved
# with it, to |q| ~ 1.5e-155. At the other end `|q|² = +Inf` made `inv` 0 and the
# inverse came back as the ZERO quaternion. ⚠ It surfaced from a regression sweep
# asking "what did the repair miss", not from the census — the census listed the
# module as done. [measured: 2041-binade two-sided sweep on q*q^-1, 2026-09-10]
#
# ⭐ FAST PATH, AND THE FAST PATH IS THE SHIPPED ARITHMETIC UNCHANGED. `1/|q|²` is
# ONE rounding; the rescue below divides twice and pays two. Measured against
# exact rational truth over 180 components of 45 ordinary quaternions: the direct
# form is mean 0.309 ulp / worst 1.101, the two-division form mean 0.655 / worst
# 2.115 — **2.12x the error**, and the two disagree on 97 of the 180. So the
# direct form is kept wherever it is exact and the rescue runs only where the
# direct form would otherwise fabricate.
# ⚠ Replacing the whole function with the two-division form would therefore be a
# precision REGRESSION on every ordinary quaternion, which is why this is a fast
# path and not a rewrite.
# [measured: scratch harness, exact Fraction truth vs both f64 pipelines, 2026-09-10]
# ⚠ The fast-path test needs BOTH ends: `ls` subnormal or +Inf means the sum of
# squares lost the value on the way in, and `1/ls` subnormal means the reciprocal
# lost it on the way back — a fixture that only goes down would have missed the
# second, which fails at 2^509 alone.
# ⚠ NaN satisfies neither test, so it takes the fast path and propagates, which
# is what `tests/abuse.tcyr` pins for this family.
#
# ⭐ THE RESCUE DIVIDES TWICE BY |q| AND NEVER ONCE BY |q|². A quaternion at
# 2^-600 has an inverse at 2^600 — perfectly representable — but |q|² is not, so
# the squared form cannot get there by any threshold. ⚠ And it must be `f64_div`,
# not a multiply by `1/|q|`: for a subnormal |q| the reciprocal is +Inf and the
# zero components would come back as `0 * Inf` = NaN, the rule
# `src/linalg_precision.cyr:78` states verbatim.
#
# ⛔ 3.3.5 — AND THAT RESCUE PAID FOR ITS ROUNDINGS. Two divisions by a rounded |q| (a
# subnormal one below 2^-1022) put full-mantissa quaternions up to 4.58 ulp off in the
# rescued bands and 48.8 ulp off for a subnormal |q|, where the fast path stays within
# 2.75; and past DBL_MAX |q| was +Inf, so the inverse came back as the zero quaternion.
# The 2041-binade sweep in tests/foundation.tcyr could not see any of it: its (3s, 4s,
# 0, 0) has |q| = 5s exactly, and both forms give the same bits there.
# [measured: scratch harness and Fraction oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
# ⭐ The rescue is now the fast path on an exact copy of the conjugate: t = (-x, -y, -z, w) *
# 2^p, with p from the largest component's exponent so that component is in [1, 2) (or
# [2^-51, 1) when subnormal), then t / |t|^2 * 2^p, both scalings as two normal powers of
# two. That is the fast path's answer for the same direction at unit scale, bit for bit
# wherever the result is normal, and the top band's zero quaternion becomes the inverse. On
# a 14,629-quaternion sample (8,392 random full-mantissa ones, 4 per binade from 2^-1074
# to 2^1023, plus the axis and (3s, 4s) shapes) the largest errors were 2.35 and 2.48 ulp in
# the rescued bands and 1.36 for a subnormal |q| — sample maxima, not bounds: a reviewer's
# independent sample found 2.67 for a subnormal |q|. A zero component stays zero (0 * 2^p
# is 0, never 0 * Inf), and an overflowing inverse still overflows honestly to +-Inf.
# ⚠ Not every rescued answer improved: of 7,472, 452 that were within 1 ulp now are not and
# 1,894 went the other way; each now carries the error the fast path makes on the same
# quaternion at unit scale. 32 of the 452 are single-component q, where the two divisions
# had been exact to half an ulp and the fast path rounds three times (now within 1.57).
# [measured: scratch harness and Fraction oracle, not reproducible in-tree, 2026-10-11; 2.67: the review's sample]
# ⚠ THE NEGATION GOES ON BEFORE THE SCALING. Below cycc 6.6.8 `f64_neg(+0)` is +0, and a
# component far below the largest flushes to zero in the copy; negated after it, that zero
# came back +0 where -x is -0. The first draft did that: on 30,562 random and tuple inputs
# it changed 10,451 result slots only in a zero's sign under cycc 6.6.3 and 6.6.6, none
# under 6.6.14. Negating first, the result differs from 3.3.4's on the same 8,127 slots under
# 6.6.3, 6.6.6 and 6.6.14 (none in a zero's sign), and on 6.6.14 it is the first draft's to the
# bit. An infinite component needs no branch of its own: Inf * 2^p is Inf, so |t|^2 is Inf,
# its reciprocal 0, and the answer NaN beside signed zeros, the bits the two divisions gave,
# under each of those three pins, on all 6,457 infinite-component inputs of that sample.
# [measured: scratch trees pinned to cycc 6.6.3, 6.6.6, 6.6.14, not reproducible in-tree, 2026-10-11]
# ⛔ 3.4.0 — AND |q| = 0 RETURNED THE IDENTITY (audit D088): zero has no inverse, and the
# identity is a legal one. `hquat_inverse_checked` returns `Err(HSB_ERR_DIVISION_BY_ZERO)` for
# it and `Err(HSB_ERR_INVALID_INPUT)` for a NaN or infinite component (which gave NaN beside
# signed zeros, above); every other q gets the bits `hquat_inverse` gave it. `hquat_inverse`
# is retired, not redefined.
#must_use
public fn hquat_inverse_checked(q) {
    var ls = hquat_length_sq(q);
    var inv = f64_div(F64_ONE, ls);
    if (f64_ge(ls, F64_TINY) == 1 && f64_ge(inv, F64_TINY) == 1) {
        var qi = hquat_new(f64_mul(f64_neg(HQuat_x(q)), inv),
          f64_mul(f64_neg(HQuat_y(q)), inv),
          f64_mul(f64_neg(HQuat_z(q)), inv),
          f64_mul(HQuat_w(q), inv));
        if (qi == 0) { return Err(HSB_ERR_ALLOC); }
        return Ok(qi);
    }
    if (_hquat_finite(q) == 0) { return Err(HSB_ERR_INVALID_INPUT); }
    var mx = f64_max(f64_max(f64_abs(HQuat_x(q)), f64_abs(HQuat_y(q))),
      f64_max(f64_abs(HQuat_z(q)), f64_abs(HQuat_w(q))));
    if (f64_eq(mx, 0) == 1) { return Err(HSB_ERR_DIVISION_BY_ZERO); }
    var p = 1023 - (mx >> 52);
    var h = p / 2;
    var f1 = (1023 + h) << 52;
    var f2 = (1023 + p - h) << 52;
    var t = hquat_new(f64_neg(HQuat_x(q)), f64_neg(HQuat_y(q)), f64_neg(HQuat_z(q)), HQuat_w(q));
    if (t == 0) { return Err(HSB_ERR_ALLOC); }
    f64v_scale(t, t, f1, 4);
    f64v_scale(t, t, f2, 4);
    var r = alloc(sizeof(HQuat));
    if (r == 0) { return Err(HSB_ERR_ALLOC); }
    f64v_scale(r, t, f64_div(F64_ONE, hquat_length_sq(t)), 4);
    f64v_scale(r, r, f1, 4);
    f64v_scale(r, r, f2, 4);
    return Ok(r);
}

# ================================================================
# Rotate a Vec3 by the rotation q represents: q v q^-1, the rotation by q / |q|, for every
# finite non-zero q, computed as v + w t' + u x t' with u = q.xyz and t' = 2 (u x v) / |q|^2.
# ================================================================

# x * 2^k, rounded once, for |k| <= 2096. Upward every step is exact or overflows. Downward
# the remainder goes first, so each step before the last is exact, or is subnormal and the
# steps after it end at a zero, as x * 2^k rounds to.
fn _hquat_ldexp(x, k) {
    while (k > 1023) { x = f64_mul(x, (1023 + 1023) << 52); k = k - 1023; }
    if (k >= 0) { return f64_mul(x, (1023 + k) << 52); }
    var m = (0 - k) / 1022;
    x = f64_mul(x, (1023 - ((0 - k) - m * 1022)) << 52);
    while (m > 0) { x = f64_mul(x, 0x0010000000000000); m = m - 1; }   # 2^-1022
    return x;
}

# `hquat_rotate_vec3` after an intermediate overflowed: rotate v * 2^-k, scale back by 2^k.
# NaN and Inf inputs return the fast path's answer, as through 3.3.5. With every |q_i| below
# Q = 2^(eq + 1) and every |v_i| below V, each intermediate of the formula is below
# V + 12 Q^2 V, at most 16 Q^2 V once Q >= 1/2, so V <= 2^(1017 - 2 eq) keeps all of them at
# or under 2^1023, a factor 2 below overflow; a q whose largest component is under 1/4 is
# bounded as eq = -2. An overflow means v broke that bound, so k >= 1 and the copy cannot
# overflow: the call below recurses exactly once.
# The copy is exact unless a component of v falls below 2^(k - 1022), where it loses its low
# bits or all of them: under a half turn about z (|q| = 1, k = 7) a subnormal v.z beside
# 2^1023 keeps its bits only with seven trailing zero bits (4 of the 11,338 sweep inputs that
# took this path, outside the formula's own error bound; 3.3.5: NaN for all 4), and with
# q's components spanning 2^256 or more, k passes 1022 plus the exponent of ordinary
# components, which vanish from the copy. Only the components the fast path made non-finite
# are taken from the copy, and only when what the copy lost cannot reach its answer (below).
# [measured: scratch harness and Fraction oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
# 3.4.0: the formula divides t by n = |q|^2, and `hquat_rotate_vec3` runs it for n in [1/4, 16].
# For n >= 1 that division only shrinks t, so the bounds below hold as written; a q with
# n < 1 is doubled first (2q is the same rotation, and n becomes 4n >= 1), so they hold for it
# too. A q with n = 1 runs exactly as through 3.3.7.
fn _hquat_rotate_wide(q, v, rx, ry, rz) {
    var qx = HQuat_x(q); var qy = HQuat_y(q); var qz = HQuat_z(q); var qw = HQuat_w(q);
    var vx = HVec3_x(v); var vy = HVec3_y(v); var vz = HVec3_z(v);
    if (f64_lt(f64_abs(qx), F64_POS_INF) == 0 || f64_lt(f64_abs(qy), F64_POS_INF) == 0
      || f64_lt(f64_abs(qz), F64_POS_INF) == 0 || f64_lt(f64_abs(qw), F64_POS_INF) == 0
      || f64_lt(f64_abs(vx), F64_POS_INF) == 0 || f64_lt(f64_abs(vy), F64_POS_INF) == 0
      || f64_lt(f64_abs(vz), F64_POS_INF) == 0) {
        return hvec3_new(rx, ry, rz);
    }
    var nn = f64_add(f64_add(f64_mul(qx, qx), f64_mul(qy, qy)), f64_add(f64_mul(qz, qz), f64_mul(qw, qw)));
    if (f64_lt(nn, F64_ONE) == 1) {
        qx = f64_mul(qx, F64_TWO); qy = f64_mul(qy, F64_TWO);
        qz = f64_mul(qz, F64_TWO); qw = f64_mul(qw, F64_TWO);
        q = hquat_new(qx, qy, qz, qw);
        if (q == 0) { return 0; }
    }
    var mv = f64_abs(vx);
    if (f64_abs(vy) > mv) { mv = f64_abs(vy); }
    if (f64_abs(vz) > mv) { mv = f64_abs(vz); }
    var mq = f64_abs(qx);
    if (f64_abs(qy) > mq) { mq = f64_abs(qy); }
    if (f64_abs(qz) > mq) { mq = f64_abs(qz); }
    if (f64_abs(qw) > mq) { mq = f64_abs(qw); }
    var eq = (mq >> 52) - 1023;
    if (eq < 0 - 2) { eq = 0 - 2; }
    var k = (mv >> 52) - 1023 - 1016 + 2 * eq;
    var wx = _hquat_ldexp(vx, 0 - k);
    var wy = _hquat_ldexp(vy, 0 - k);
    var wz = _hquat_ldexp(vz, 0 - k);
    var wv = hvec3_new(wx, wy, wz);
    if (wv == 0) { return 0; }
    var s = hquat_rotate_vec3(q, wv);
    if (s == 0) { return 0; }
    var cx = _hquat_ldexp(HVec3_x(s), k);
    var cy = _hquat_ldexp(HVec3_y(s), k);
    var cz = _hquat_ldexp(HVec3_z(s), k);
    # The copy is trusted only where what it lost cannot reach its answer: l = v - (v 2^-k) 2^k,
    # the bits of v the scaling dropped (exact), reaches at most 2^(e(max |l|) + 2 eq + 10)
    # through the formula, and the copy's own subnormal rounding 2^(k - 1074 + eq + 4); its
    # components are taken only when the larger of the two sits more than 56 binades below
    # the copy's largest component. Otherwise the fast path's +-Inf stands (a NaN from it is
    # replaced either way). Through round 2 of 3.3.6 the copy's components were taken
    # whenever the fast path's were not finite, and on q whose components span 2^256 or more
    # (largest nonzero over smallest nonzero) a component whose exact value overflows read
    # finite from a copy that had lost v's smaller components, or an infinity of the wrong
    # sign: q = (0, 1.59, -1.4e289, 0.377), v = (1.4e-226, 1, -0) has x near -2^1226, which
    # 3.3.5 gave as -Inf and round 2 as 1.1e296. (The test is the round-2 review's, checked
    # against its Python model on 360,000 inputs.)
    # [measured: review rotation family (rot_T4norm), C2 seeds 301/302, 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
    var ml = f64_abs(f64_sub(vx, _hquat_ldexp(wx, k)));
    var l2 = f64_abs(f64_sub(vy, _hquat_ldexp(wy, k)));
    if (l2 > ml) { ml = l2; }
    var l3 = f64_abs(f64_sub(vz, _hquat_ldexp(wz, k)));
    if (l3 > ml) { ml = l3; }
    var lim = k - 1074 + eq + 4;
    if (ml != 0) {
        var ll = (ml >> 52) - 1023 + 2 * eq + 10;
        if (ll > lim) { lim = ll; }
    }
    var en = f64_abs(cx);
    if (f64_abs(cy) > en) { en = f64_abs(cy); }
    if (f64_abs(cz) > en) { en = f64_abs(cz); }
    var take = 0;
    if ((en >> 52) - 1023 - 56 > lim) { take = 1; }
    # A component the fast path formed finite is kept: only the non-finite ones are replaced.
    var sx = rx;
    var sy = ry;
    var sz = rz;
    if (f64_lt(f64_abs(rx), F64_POS_INF) == 0) { if (take == 1 || f64_eq(rx, rx) == 0) { sx = cx; } }
    if (f64_lt(f64_abs(ry), F64_POS_INF) == 0) { if (take == 1 || f64_eq(ry, ry) == 0) { sy = cy; } }
    if (f64_lt(f64_abs(rz), F64_POS_INF) == 0) { if (take == 1 || f64_eq(rz, rz) == 0) { sz = cz; } }
    return hvec3_new(sx, sy, sz);
}

# ⛔ 3.3.5 — t = 2 q x v AND THE SUMS AFTER IT OVERFLOWED FOR |v| NEAR DBL_MAX. t is about
# 2 |q| |v| and q x t about 2 |q|^2 |v|, so the formula needs headroom its answer does not: a
# half turn about z of (2^1023, 0, 0) came back (-Inf, NaN, NaN), not (-2^1023, 0, 0). On
# 131,405 sweep inputs (unit, axis, near-identity and non-unit q; v at every binade, the top
# ones densely) 3.3.5 put an Inf or NaN in 11,338 answers for finite input. 10,583 were wrong
# and are now right; 747 overflow honestly and keep their bits; 4 had an exact component of
# +-DBL_MAX that came back +-Inf (now 1 ulp inside); 4 are in `_hquat_rotate_wide`'s comment.
# ⭐ Only an overflow makes an Inf or NaN from finite input, and every t component reaches
# every answer component, so the test below sees any of them; only then does
# `_hquat_rotate_wide` rerun the formula on v * 2^-k, and only the components that came out
# non-finite are replaced. Every answer that was finite keeps the fast path and its bits
# (117,067 of 117,067), NaN and Inf inputs keep theirs (3,000 of 3,000), none of the sweep's
# inputs went from right to wrong, and a rerun gives 3.3.5's answer at v * 2^-8 times 2^8 on
# all 29,766 sweep inputs where that answer is finite (3,154 of them overflowed at v in 3.3.5).
# (Those counts are sub-lane A's sweep; an answer is right when each component is within 8 ulp
# of the exact formula's largest finite component.)
# [measured: scratch harness and Fraction oracle, not reproducible in-tree, 2026-10-11; cycc 6.6.14]
# ⚠ AND WHERE q's COMPONENTS SPAN 2^256 OR MORE (largest nonzero over smallest nonzero). On a
# broader family (150,000 inputs per seed: unit, axis, random and non-unit q, |q| from 2^-600
# to 2^500 times a unit one, v at every scale), with a component right when it is within 8
# ulp of the largest finite exact component, or is the +-Inf of its sign (+-DBL_MAX within
# 2^970) where its exact value overflows, round 2 of 3.3.6 took 1,874 answers from right to
# wrong, every one in that class: a component whose exact value overflows read finite, or an
# infinity of the wrong sign, from the copy that had lost v's smaller components. With the
# trust test in `_hquat_rotate_wide` none goes from right to wrong on seeds 301 and 302,
# against 22,591 and 22,247 wrong -> right.
# [measured: C2 review rotation family (rotm4, rotrw), seeds 301, 302; 3.3.5 vs this tree, 2026-10-11; cycc 6.6.14]
# ⛔ 3.4.0 — THROUGH 3.3.7 THIS WAS A ROTATION ONLY FOR A UNIT q. It computed v + w t + u x t
# with t = 2 u x v, which is q v q* for |q| = 1 and for any other q is neither q v q^-1 nor
# q v q* at any scale: q = (0.154, 3.32, 3.86, -15.2) took (1, 1, -1) to (166.8, -175.5,
# 144.2), where q v q^-1 = (1.65, 0.31, -0.43). A q one ulp off unit length carried that ulp
# into the answer, and q = 0 returned v unchanged, a rotation by nothing.
# ⭐ q v q^-1 = ((w^2 - |u|^2) v + 2 (u . v) u + 2 w u x v) / n, n = |q|^2, which is the 3.3.7
# formula with t divided by n: v + w (t/n) + u x (t/n). Dividing t, not the sum, keeps every
# operation the 3.3.7 one where n = 1.0 exactly, so a q whose |q|^2 rounds to 1 rotates
# bit for bit as before (t/1 is t). n is used directly in [1/4, 16]; any other finite non-zero
# q is first scaled by a power of two to put its largest component in [1, 2), the same
# rotation (`_hquat_rotate_qscaled`), so neither n nor t/n can overflow or flush because of
# |q|. q = 0 gives the formula's own answer, 0/0 = NaN: it represents no rotation.
# The error, derived to first order in u = 2^-53 (a = |q.xyz|, so 2 |w| a <= n and a^2 <= n):
# |n~ - n| <= 3u n; |t~ - t| <= 4 sqrt(2) u a |v| (two products and a difference per
# component, each bounded through Cauchy-Schwarz) and |t| <= 2 a |v|, so the computed t' is
# within (4 sqrt(2) + 8) u a |v| / n of t / n; the map t' -> w t' + u x t' has norm sqrt(n),
# which carries that to 13.7 u |v| in the answer; and the final products and sums add at most
# 8 u |v| per component (each term is at most 2 |v|). So every component is within 22 u |v| of
# the exact rotation (where the computed |q|^2 is 1.0 and t is not divided, the 3u of n moves
# to t's term, and the same 22 holds). The first 3.4.0 review found 8.43 u |v| over 180,000
# components, against the 5.2 u |v| this comment then claimed as a bound from a smaller sample:
# 5.80, 5.76, 6.35 and 6.44 u |v| for |q| <= 2, (2, 16], (16, 2^500] and v near 2^1000, p99
# about 3. Those are measured maxima, not bounds.
# For subnormal v the products' own rounding adds absolute error on the 2^-1074 grid (within
# 4.69 units of it on the review's family).
# [measured: REV-FB t11.py / t11b.py / t11c.py, exact Fraction rotation, the first 3.4.0 review of lane FB, 2026-10-31]
# ⚠ The bound is absolute, the same 22 u |v| for every component, and that is the contract: a
# component the rotation makes far smaller than |v| keeps no relative accuracy. With v the
# exact inverse image of (1, 0, 0) rounded to doubles, under 2,000 random unit q, 4,000 of the
# 6,000 answer components were more than 8 ulp from their own exact values (up to 5.9e20 ulp:
# 2^-54 for an exact 4.58e-22), while all 6,000 were within 7.39 u |v|. A componentwise answer
# would need every product and sum compensated (the arithmetic of `m3_normal_matrix_cof`'s
# compensated tier, whose cost mat3.cyr states); it is not done here.
# [measured: scratch rot.py / ord.in, exact Fraction rotation, lane MAT4, 2026-11-01; cycc 6.7.18]
# On 3,000 normalised q the p99 falls from 3.6 to 2.7 u|v|, and the 1,681 whose |q|^2 is 1.0
# keep 3.3.7's bits.
# [measured: scratch rot_acc.py, exact Fraction rotation, 3.3.7 and lane FB, 2026-10-31; cycc 6.7.9]
# t * (1 / n) instead of t / n is less accurate (p99 3.2) and was slower (60 against 57 ns).
# [measured: scratch rot_acc.py, exact Fraction rotation, 3.3.7 and lane FB, 2026-10-31; cycc 6.7.9]
# ⚠ Cost: |q|^2 and three divisions. A q with |q|^2 = 1.0 exactly skips the divisions (the
# same bits on 60,000 inputs, 18,542 of them such q): per call 43 -> 47 ns there, 43 -> 53 ns
# for the others (hisab.bcyr's q has |q|^2 = 1 - 2^-53), and 44 -> 51 ns over a set where half
# have |q|^2 = 1. It reaches every rotation through this function (t3d_compose, the OBB rays).
# [measured: scratch focus2.bcyr and rot_ident.py, merged tree vs 3.4.0 integration snapshot, 3 runs, 2026-10-31]
#must_use
public fn hquat_rotate_vec3(q, v) {
    var qx = HQuat_x(q); var qy = HQuat_y(q); var qz = HQuat_z(q); var qw = HQuat_w(q);
    var vx = HVec3_x(v); var vy = HVec3_y(v); var vz = HVec3_z(v);
    var n = f64_add(f64_add(f64_mul(qx, qx), f64_mul(qy, qy)), f64_add(f64_mul(qz, qz), f64_mul(qw, qw)));
    var wide = 1;
    # n is +0 or positive (or NaN), so its bits order as it does: an integer range test.
    if (n < _QUAT_N_LO || n > _QUAT_N_HI) {
        var mq = qx & 0x7FFF_FFFF_FFFF_FFFF;
        if ((qy & 0x7FFF_FFFF_FFFF_FFFF) > mq) { mq = qy & 0x7FFF_FFFF_FFFF_FFFF; }
        if ((qz & 0x7FFF_FFFF_FFFF_FFFF) > mq) { mq = qz & 0x7FFF_FFFF_FFFF_FFFF; }
        if ((qw & 0x7FFF_FFFF_FFFF_FFFF) > mq) { mq = qw & 0x7FFF_FFFF_FFFF_FFFF; }
        if (mq != 0 && mq < 0x7FF0_0000_0000_0000) { return _hquat_rotate_qscaled(q, v, mq); }
        wide = 0;   # q = 0 or not finite: the formula's IEEE answer, as it stands
    }
    # t' = 2 * cross(q.xyz, v) / n; for n = 1.0 exactly the division is skipped, which is the
    # same bits (t / 1 is t) and the 3.3.7 arithmetic.
    var tx = f64_mul(F64_TWO, f64_sub(f64_mul(qy, vz), f64_mul(qz, vy)));
    var ty = f64_mul(F64_TWO, f64_sub(f64_mul(qz, vx), f64_mul(qx, vz)));
    var tz = f64_mul(F64_TWO, f64_sub(f64_mul(qx, vy), f64_mul(qy, vx)));
    if (n != 0x3FF0_0000_0000_0000) { tx = f64_div(tx, n); ty = f64_div(ty, n); tz = f64_div(tz, n); }
    # result = v + w*t' + cross(q.xyz, t')
    var rx = f64_add(f64_add(vx, f64_mul(qw, tx)), f64_sub(f64_mul(qy, tz), f64_mul(qz, ty)));
    var ry = f64_add(f64_add(vy, f64_mul(qw, ty)), f64_sub(f64_mul(qz, tx), f64_mul(qx, tz)));
    var rz = f64_add(f64_add(vz, f64_mul(qw, tz)), f64_sub(f64_mul(qx, ty), f64_mul(qy, tx)));
    # One test on rx + ry + rz, non-finite whenever a component is (a finite sum that
    # overflows only sends the three finite components to _hquat_rotate_wide, which keeps
    # them), in place of a test per component on the fast path; an integer test of the bits
    # (+-Inf and NaN are the patterns from 0x7FF0... up, sign cleared).
    if ((f64_add(f64_add(rx, ry), rz) & 0x7FFF_FFFF_FFFF_FFFF) >= 0x7FF0_0000_0000_0000) {
        if (wide == 1) { return _hquat_rotate_wide(q, v, rx, ry, rz); }
    }
    return hvec3_new(rx, ry, rz);
}

# `hquat_rotate_vec3` for a finite non-zero q with |q|^2 outside [1/4, 16]: q * 2^-e, e the
# exponent of its largest component mq (bits), which is the same rotation with that component
# in [1, 2) and so |q|^2 in [1, 16). Exact unless a component lies more than 2^1021 below the
# largest, where it flushes: it moves the rotation by under 2^-1000 radians, so the answer by
# under 2^-1000 |v|, normwise. A component that the flushed one dominates is lost with it:
# q = (2^-1024, about 2^497, about -1.2, about -2^-803) and v about (2^1004, -2^-71, -2^-400)
# give z = -v.z, about 2^-400, where the exact z is 1.62e-89, almost all of it w's term
# (2^-1299 |v|; tests/modules_c.tcyr `_r3_qc` pins it as the normwise contract's answer).
# [measured: scratch rot.py, exact Fraction rotation q v q* / |q|^2, 3.4.1 lane MAT4, 2026-11-01; cycc 6.7.18]
fn _hquat_rotate_qscaled(q, v, mq) {
    var e = (mq >> 52) - 1023;
    if ((mq >> 52) == 0) { e = ((f64_mul(mq, 0x43F0_0000_0000_0000) >> 52) - 1023) - 64; }   # 2^64
    var s = hquat_new(_hquat_ldexp(HQuat_x(q), 0 - e), _hquat_ldexp(HQuat_y(q), 0 - e),
      _hquat_ldexp(HQuat_z(q), 0 - e), _hquat_ldexp(HQuat_w(q), 0 - e));
    if (s == 0) { return 0; }
    return hquat_rotate_vec3(s, v);
}

# ================================================================
# Spherical linear interpolation
# ================================================================

# Spherical linear interpolation from a (t = 0) to b (t = 1) along the shorter arc: with b' = b
# or -b, whichever has d = a . b' >= 0 (the same rotation), and theta the angle between a and
# b', the answer is (sin((1 - t) theta) a + sin(t theta) b') / sin(theta), for any real t
# (outside [0, 1] it extrapolates along the same great circle). theta is acos(d) for d <= 0.9995
# and 2 atan2(|a - b'|, |a + b'|) above, which keeps its relative accuracy at any small angle;
# where d >= 1 (theta below about 2^-26) or |a - b'| is 0 (or below 2^-537, where its squares
# flush) the answer is the normalised lerp of a and b', whose angle error, at most about
# theta^3 / 62 for t in [0, 1], is far below rounding there. a and b must be unit quaternions:
# for others the answer is the formula's, neither unit nor an interpolation of their rotations
# (a non-unit pair with d >= 1 takes the normalised lerp, as through 3.4.0). A zero quaternion,
# a or b, gives NaN (it represents no rotation, `_QUAT_NAN`), as does a NaN or infinite
# component; the designed 0 where an allocation is refused. ⚠ Through `hquat_dot` the last
# bits can differ on aarch64.
# [measured: theta^3 / 62, the 3.4.1 review (RV-MAT S2(d)), mpmath over t in [0, 1], 2026-10-31]
# Accuracy, the largest error MEASURED on random unit pairs, not a bound: normwise, in ulp of
# the largest component, against a binary128 slerp of the exact inputs (theta = 2 atan2(|a -
# b'|, |a + b'|); it agrees with a 60-digit mpmath one to 5e-7 ulp on 64,590 of the pairs),
# 1,000,000 pairs per band of theta (log-uniform over [1e-9, 1e-6), [1e-6, 1e-3), [1e-3,
# 0.0316), [0.025, 0.0316), [0.0316, 0.04), [0.0316, 0.1) and [0.1, pi/2], and over [1e-9,
# 0.0316) and [0.0316, pi/2] once more through `t3d_lerp`): for t in [0, 1], 3.73 ulp for theta
# below 0.0316 (the atan2 form) and 4.0 above (acos); for t in [-1.5, 2.5], 9.33 below and 18.13
# above, the acos form's own extrapolation error, unchanged since 3.4.0; for identical or
# antipodal pairs, 4 ulp of a for t in [0, 1], -1 and 2, and 8.5 at t = 10 and -9. The error
# grows with |t| outside [0, 1]. Those pairs were normalised by a division; pairs built as cos
# theta a + sin theta w with b not renormalised (|b|^2 - 1 up to 54 2^-53) reach 25.15 ulp in the
# acos band (theta = 0.396, t = -1.18) and 9.58 below the switch.
# [measured: scratch slgen.c / slorc.c (binary128) / mpval.py, 25,000,000 pairs, 2026-10-31; cycc 6.7.18]
# [measured: round-3 review sl/bands1.log, binary128 oracle, 300,000 pairs, 2026-10-31; cycc 6.7.18]
# ⛔ 3.4.1 — FOR d ABOVE 0.9995 THIS WAS THE NORMALISED LERP, whose angle error grows as theta^3
# (at most about theta^3 / 62 for t in [0, 1]): the audit's pair at d = 0.99975, t = 1/4, was
# 3.7e-7 off (1.7e9 ulp) against a 60-digit slerp, and on 4,000 pairs the band theta in
# [1e-5, 0.032) was up to 5.3e10 ulp off. The first 3.4.1 repair kept acos(d) up to d < 1, which
# put a spurious theta of about 2^-26 on a pair whose d rounding alone left a few ulp below 1:
# slerp(a, a, 10) came back 244 ulp off a (review S2). The atan2 form has neither defect; every
# pair with d <= 0.9995 keeps its 3.4.0 bits (50,057 of 50,057 random pairs, t extrapolating
# included). And 3.4.0 gave the zero quaternion with itself (0, 0, 0, 0) from the formula, where
# the lerp branch gives a zero interpolant NaN (REV-FB N4).
# [measured: scratch slerp_orc.py / sl3.py, Decimal slerp, 3.4.0, first repair, this tree, 2026-10-31; cycc 6.7.18]
# Cost: a pair above 0.9995 now pays the formula and the atan2, 79 -> 193 ns for the audit's
# pair (3.4.0's normalised lerp; acos's form read 174); the ordinary pair 175 -> 181 ns medians
# against the first repair, the same arithmetic behind one more branch.
# [measured: scratch fm4.bcyr, the first repair and this tree interleaved x 6, 2026-10-31; cycc 6.7.18]
#must_use
public fn hquat_slerp(a, b, t) {
    var d = hquat_dot(a, b);
    var bx = HQuat_x(b); var by = HQuat_y(b); var bz = HQuat_z(b); var bw = HQuat_w(b);
    # Shortest path: negate b if dot < 0
    if (f64_lt(d, 0) == 1) {
        bx = f64_neg(bx); by = f64_neg(by);
        bz = f64_neg(bz); bw = f64_neg(bw);
        d = f64_neg(d);
    }
    # A zero quaternion represents no rotation and has no direction to interpolate from or to:
    # NaN. Its dot with anything is a zero, so the test costs the ordinary path one compare.
    if ((d & 0x7FFF_FFFF_FFFF_FFFF) == 0) {
        if (_hquat_is_zero(a) == 1 || _hquat_is_zero(b) == 1) {
            return hquat_new(_QUAT_NAN, _QUAT_NAN, _QUAT_NAN, _QUAT_NAN);
        }
    }
    # Above d = 0.9995 theta is 2 atan2(|a - b'|, |a + b'|): each difference is one rounding, so
    # theta keeps its relative accuracy however small it is, where acos(d) reads a d that
    # rounding alone put a few ulp below 1 as an angle of about 2^-26 (3.4.1 review S2). d >= 1,
    # and |a - b'| = 0 (or below 2^-537), take the normalised lerp, as d >= 0.9995 did through
    # 3.4.0: no arc, or theta at most about 2^-26 where its error is under 2^-69 at |t| = 10.
    # d <= 0.9995 keeps the acos form, bit for bit.
    var theta = 0;
    if (f64_gt(d, _QUAT_D_HI) == 1) {
        var ux = f64_sub(HQuat_x(a), bx); var uy = f64_sub(HQuat_y(a), by);
        var uz = f64_sub(HQuat_z(a), bz); var uw = f64_sub(HQuat_w(a), bw);
        var nm = f64_sqrt(f64_add(f64_add(f64_mul(ux, ux), f64_mul(uy, uy)),
            f64_add(f64_mul(uz, uz), f64_mul(uw, uw))));
        if (f64_lt(d, F64_ONE) == 0 || f64_eq(nm, 0) == 1) {
            var omt = f64_sub(F64_ONE, t);
            # ⛔ 3.4.0 — `hquat_normalize` gave the IDENTITY for a zero interpolant. For unit a
            # and b it cannot be zero in exact arithmetic: |(1 - t) a + t b|^2 = 1 - 2 t (1 - t)
            # (1 - d) >= 1 - (1 - d) / 2 for every real t, and d >= 1 or a = b' here. A non-unit
            # pair can reach it (b = 2a at t = -1), and a NaN or infinite component cannot be
            # normalised: neither has a direction, and the answer is NaN, not a rotation. In
            # floating point an identical pair past |t| = 2^53 cancels too: t = 2^54 gives NaN
            # and t = 2^53 what the last bits left, where the answer is a.
            var lq = hquat_new(
              f64_add(f64_mul(HQuat_x(a), omt), f64_mul(bx, t)),
              f64_add(f64_mul(HQuat_y(a), omt), f64_mul(by, t)),
              f64_add(f64_mul(HQuat_z(a), omt), f64_mul(bz, t)),
              f64_add(f64_mul(HQuat_w(a), omt), f64_mul(bw, t))
              );
            if (lq == 0) { return 0; }
            var nt, nq = hquat_normalize_checked(lq);
            if (is_err_result(nt) == 1) {
                if (nq == HSB_ERR_ALLOC) { return 0; }
                return hquat_new(_QUAT_NAN, _QUAT_NAN, _QUAT_NAN, _QUAT_NAN);
            }
            return nq;
        }
        var vx = f64_add(HQuat_x(a), bx); var vy = f64_add(HQuat_y(a), by);
        var vz = f64_add(HQuat_z(a), bz); var vw = f64_add(HQuat_w(a), bw);
        var np = f64_sqrt(f64_add(f64_add(f64_mul(vx, vx), f64_mul(vy, vy)),
            f64_add(f64_mul(vz, vz), f64_mul(vw, vw))));
        theta = f64_mul(F64_TWO, ganita_f64_atan2(nm, np));
    } else {
        theta = ganita_f64_acos(d);
    }
    var sin_theta = f64_sin(theta);
    var inv_sin = f64_div(F64_ONE, sin_theta);
    var s0 = f64_mul(f64_sin(f64_mul(f64_sub(F64_ONE, t), theta)), inv_sin);
    var s1 = f64_mul(f64_sin(f64_mul(t, theta)), inv_sin);
    return hquat_new(
      f64_add(f64_mul(HQuat_x(a), s0), f64_mul(bx, s1)),
      f64_add(f64_mul(HQuat_y(a), s0), f64_mul(by, s1)),
      f64_add(f64_mul(HQuat_z(a), s0), f64_mul(bz, s1)),
      f64_add(f64_mul(HQuat_w(a), s0), f64_mul(bw, s1))
      );
}

# --- mat3.cyr ---

# mat3.cyr -- 3x3 f64 matrix type
# Usage: shipped inside dist/hisab.cyr; in-tree, include "src/mat3.cyr" after what it requires
# Requires: src/error.cyr, src/quat.cyr, src/vec3.cyr (stdlib resolves via cyrius.cyml [deps])
#
# Column-major flat allocation: 9 f64 values = 72 bytes.
# Layout: col0[3], col1[3], col2[3]

# Byte size of the column-major 3x3 grid (9 f64). Ties alloc + copy-loop
# bounds to a single named constant instead of a repeated magic literal.
#
# 3.4.0 (the [3.3.8] allocation row): every function here that allocates returns the designed 0
# when the allocation is refused (an exhausted heap), and every Result returns Err(HSB_ERR_ALLOC);
# none stores through a 0 handle. A 0 handle passed IN is the caller's.
public enum Mat3Layout { MAT3_BYTES = 72 }

# A new 3x3 zero matrix (72 bytes from the heap, every entry +0), column-major. Returns the
# designed 0 where the allocation is refused (3.4.0); so does every function here that returns
# a matrix or vector.
#must_use
public fn m3_new() {
    var m = alloc(MAT3_BYTES);
    if (m == 0) { return 0; }
    var i = 0;
    while (i < 9) { store64(m + i * 8, 0); i = i + 1; }
    return m;
}

# The 3x3 identity.
#must_use
public fn m3_identity() {
    var m = m3_new();
    if (m == 0) { return 0; }
    store64(m, F64_ONE);       # [0][0]
    store64(m + 32, F64_ONE);  # [1][1]
    store64(m + 64, F64_ONE);  # [2][2]
    return m;
}

# The entry at (col, row), column-major. RAW ACCESSOR, PRECONDITION NOT GUARD: col and row must
# be in [0, 2]; anything else reads outside the matrix (undefined), and a 0 handle faults.
#must_use
public fn m3_get(m, col, row) { return load64(m + (col * 3 + row) * 8); }
# Stores val at (col, row) and returns 0: `m3_get`'s precondition, and outside [0, 2] it writes
# outside the matrix.
public fn m3_set(m, col, row, val) { store64(m + (col * 3 + row) * 8, val); return 0; }

# A new matrix with src's nine entries, bit for bit.
#must_use
public fn m3_copy(src) {
    var dst = alloc(MAT3_BYTES);
    if (dst == 0) { return 0; }
    var i = 0;
    while (i < MAT3_BYTES) { store64(dst + i, load64(src + i)); i = i + 8; }
    return dst;
}

# The matrix whose columns are the HVec3s c0, c1, c2 (bits copied).
#must_use
public fn m3_from_cols(c0, c1, c2) {
    var m = alloc(MAT3_BYTES);
    if (m == 0) { return 0; }
    store64(m,      HVec3_x(c0)); store64(m + 8,  HVec3_y(c0)); store64(m + 16, HVec3_z(c0));
    store64(m + 24, HVec3_x(c1)); store64(m + 32, HVec3_y(c1)); store64(m + 40, HVec3_z(c1));
    store64(m + 48, HVec3_x(c2)); store64(m + 56, HVec3_y(c2)); store64(m + 64, HVec3_z(c2));
    return m;
}

# Column c (0, 1 or 2; unchecked, `m3_get`'s precondition) as a new HVec3.
#must_use
public fn m3_col(m, c) {
    var off = c * 24;
    return hvec3_new(load64(m + off), load64(m + off + 8), load64(m + off + 16));
}

# ================================================================
# Arithmetic
# ================================================================

# SIMD (column-major): C_col = Σ_k B[k][col]·A_col_k. Columns are 3 f64
# (24 bytes), so the over-read-safe pattern is n=2 on the xy rows + a
# scalar 3rd-row (z) tail per column accumulation.
#must_use
public fn m3_mul(a, b) {
    var c = m3_new();
    if (c == 0) { return 0; }
    var tmp = alloc(24);
    if (tmp == 0) { return 0; }
    var col = 0;
    while (col < 3) {
        var cc = c + col * 24;          # dest column (3 f64)
        var bc = b + col * 24;          # B's column `col`
        var b0 = load64(bc); var b1 = load64(bc + 8); var b2 = load64(bc + 16);
        f64v_scale(cc, a, b0, 2);
        store64(cc + 16, f64_mul(load64(a + 16), b0));
        f64v_scale(tmp, a + 24, b1, 2); f64v_add(cc, cc, tmp, 2);
        store64(cc + 16, f64_add(load64(cc + 16), f64_mul(load64(a + 40), b1)));
        f64v_scale(tmp, a + 48, b2, 2); f64v_add(cc, cc, tmp, 2);
        store64(cc + 16, f64_add(load64(cc + 16), f64_mul(load64(a + 64), b2)));
        col = col + 1;
    }
    return c;
}

# SIMD: result = Σ_k v[k]·M_col_k (xy via n=2, z scalar tail).
#
# The z tail accumulates in a LOCAL and is stored through the derived setter
# ONCE, at the end. ⚠ THIS IS NO LONGER LOAD-BEARING ON THE PINNED TOOLCHAIN --
# FIXED UPSTREAM IN cycc 6.6.5, and hisab's pin crossed it in 3.2.1. The natural
# form -- `HVec3_set_z(r, f64_add(HVec3_z(r), ..))` between the f64v_* calls --
# was WRONG CODE on cycc 6.6.0 through 6.6.4: the register picker rewrote the
# third `f64v_scale`'s destination-slot store into a register move while the
# inline loop still read the frame slot, so the packed store went through
# garbage -- `(1, 4, 3)` for `(4, 5, 3)`, and inside this tree a SIGSEGV. Filed
# 2026-09-14 and repaired in 6.6.5 as a classifier hole in the picker's unsafe
# scan (`_ra_plain_slot_mov`), wider than filed: every batch intrinsic, any
# `#inline`/derived call nested in another inline call's argument, no `#derive`
# needed. Verified here as a PAIR, not read off the changelog: the natural form
# in this file gives foundation 427/429 (x = 1, y = 4) under 6.6.4 and 429/429
# under 6.6.6, modules 2251/2251; the standalone repro exits 1 on 6.6.4 and 0 on
# 6.6.5 and 6.6.6, each from a dir pinned to that version.
# [measured: docs/development/issues/archived/2026-09-14-cyrius-simd-dst-slot-regalloc-picker.md, 2026-09-21]
#
# THE HOISTED FORM IS KEPT, for two stated reasons -- neither of them "it might
# still be broken": (1) consumers compile `dist/hisab.cyr` under their OWN pins,
# and six direct consumers (svara, naad, ghurni, prani, garjan, nidhi) plus three
# that carry the bundle transitively (jalwa, shabda, shabdakosh) pin cycc 6.6.3,
# below the 6.6.5 fix, where the natural form is SILENT wrong code. None of the nine
# takes a 3.x bundle yet: they carry hisab 2.11.2 or 2.22.1, whose raw `store64` z
# tail gives the right answer under 6.6.3 (a natural-form control in the same probe
# does not), so the hoist protects the first that moves to 3.x without bumping cycc.
# [measured: scratch harness, not reproducible in-tree, 2026-09-30; cycc 6.6.3 and 6.6.12]
# Read from their manifests 2026-09-30: prakash (6.6.6, the one consumer on 3.x,
# at 3.2.1), dhvani (6.6.10) and ranga (6.6.9) are past the fix, and goonj and
# attn11 pin 6.6.2, which cannot compile a 3.x bundle at all (hisab >= 3.1.0
# needs cycc >= 6.6.3). `m4_mul_vec4` dropped its hoist in 3.3.4: its inline
# form is not this shape, re-probed on 6.6.3 and 6.6.4 (see there).
# (2) 3.2.0 measured it at -6.5% against the raw `store64`/`load64` z tail it
# replaced (2.517 -> 2.353 us per 64, 3 of 3 pairs) -- fewer memory round trips
# on z. ⚠ That is the raw tail, NOT the natural accessor form, which crashed then
# and was never timed. The accumulation order is the natural form's (m16*vx, then
# +m40*vy, then +m64*vz), so the value is bit-identical. **Do not leave a comment
# claiming a workaround is required after it stops being required** -- this one
# says why it stays.
# [measured: CHANGELOG 3.2.0 "mat3 -- m3_mul_vec3", scratch harness, not reproducible in-tree]
# ⭐ 3.3.7 — THE NATURAL FORM, TIMED (roadmap D141), and the hoist is the faster of the
# three: on cycc 6.6.20 the hoisted tail 39 ns, the natural accessor form 42 (+7.7%) and the
# raw store64 tail 41 (+5.1%); 2,257 / 2,432 / 2,378 ns per 64. All three give the same bits.
# [measured: scratch pfb/focus.bcyr m3_mul_vec3, 3 builds interleaved x 7, 2026-10-31; cycc 6.6.20]
#must_use
public fn m3_mul_vec3(m, v) {
    var r = alloc(sizeof(HVec3));
    if (r == 0) { return 0; }
    var tmp = alloc(24);
    if (tmp == 0) { return 0; }
    var vx = HVec3_x(v); var vy = HVec3_y(v); var vz = HVec3_z(v);
    f64v_scale(r, m, vx, 2);
    var rz = f64_mul(load64(m + 16), vx);
    f64v_scale(tmp, m + 24, vy, 2); f64v_add(r, r, tmp, 2);
    rz = f64_add(rz, f64_mul(load64(m + 40), vy));
    f64v_scale(tmp, m + 48, vz, 2); f64v_add(r, r, tmp, 2);
    rz = f64_add(rz, f64_mul(load64(m + 64), vz));
    HVec3_set_z(r, rz);
    return r;
}

# The transpose, a new matrix, exact.
#must_use
public fn m3_transpose(m) {
    var t = m3_new();
    if (t == 0) { return 0; }
    var c = 0;
    while (c < 3) {
        var r = 0;
        while (r < 3) { m3_set(t, r, c, m3_get(m, c, r)); r = r + 1; }
        c = c + 1;
    }
    return t;
}

# det m by the cofactor expansion along row 0 (the entries m(0, 0), m(1, 0), m(2, 0) as
# (col, row)), in plain double arithmetic: within 5u P of the exact determinant to first
# order (u = 2^-53, P the permanent of |m|, the sum of the six products' magnitudes), so it can
# be far off relative to det for a nearly singular m, and its sign need not be det's.
# Overflow, underflow and NaN follow IEEE. `m3_inverse_checked` decides singularity exactly
# instead; this is the plain value.
#must_use
public fn m3_determinant(m) {
    var m00 = m3_get(m, 0, 0); var m01 = m3_get(m, 0, 1); var m02 = m3_get(m, 0, 2);
    var m10 = m3_get(m, 1, 0); var m11 = m3_get(m, 1, 1); var m12 = m3_get(m, 1, 2);
    var m20 = m3_get(m, 2, 0); var m21 = m3_get(m, 2, 1); var m22 = m3_get(m, 2, 2);
    return f64_add(f64_sub(f64_mul(m00, f64_sub(f64_mul(m11, m22), f64_mul(m21, m12))),
        f64_mul(m10, f64_sub(f64_mul(m01, m22), f64_mul(m21, m02)))),
      f64_mul(m20, f64_sub(f64_mul(m01, m12), f64_mul(m11, m02))));
}

# ================================================================
# Inverse (3.4.0: a Result; `m3_inverse` is retired)
# ================================================================

enum _M3Exact {
    _M3_PM_LO = 0x03F0_0000_0000_0000;   # 2^-960
    _M3_PM_HI = 0x7E70_0000_0000_0000;   # 2^1000
    _M3_CERT  = 0x4090_0000_0000_0000;   # 2^10
    _M3_SIGN  = 0x3CE0_0000_0000_0000;   # 2^-49
    _M3_TWO64 = 0x43F0_0000_0000_0000;   # 2^64
    _M3_FLOOR = 0x0360_0000_0000_0000;   # 2^-969
    _M3_QN_LO = 0x3FD0_0000_0000_0000;   # 0.25
    _M3_QN_HI = 0x4030_0000_0000_0000;   # 16.0
    _M3_LIMB  = 0x7FF_FFFF;              # 2^27 - 1, an integer: `_m3_xsum`'s limb mask
    _M3_SMALL = 0x2000_0000_0000_0000;   # 2^-511
    _M3_SPLIT = 0x41A0_0000_0200_0000;   # 2^27 + 1
    _M3_CERT2 = 0x42A0_0000_0000_0000;   # 2^43
    _M3_DD_LO = 0x07B0_0000_0000_0000;   # 2^-900
    _M3_UFL   = 0x0210_0000_0000_0000;   # 2^-990
    _M3_NCERT = 0x4020_0000_0000_0000;   # 2^3
    _M3_DDCERT = 0x4350_0000_0000_0000;  # 2^54
    _M3_WENT  = 0x7E3F_FFFF_FC00_0000;   # 2^997 - 2^970
    _M3_WPRD  = 0x7FE0_0000_0000_0000;   # 2^1023
    _M3_W51   = 0x3CC0_0000_0000_0000;   # 2^-51
    _M3_WT    = 508;                     # an integer: `_m3_cof_wequil`'s target exponent
    # An integer, -100000: below every exponent, "no entry". Written in hex because an enum
    # expression needs cycc >= 6.7.2 and the bundle compiles from 6.6.3.
    _M3_WNONE = 0xFFFF_FFFF_FFFE_7960;   # an integer sentinel
    _M3_WBAD  = 0x7FFF_FFFF_FFFF_FFFF;   # a NaN's bits, never a result of `_m3_wscale`
}

# x * 2^k, rounded once, for any integer k. Upward every step is exact or overflows; downward
# the remainder goes first, so each step before the last is exact, or is subnormal and the
# steps after it end at a zero, as x * 2^k rounds to.
fn _m3_ldexp(x, k) {
    while (k > 1023) { x = f64_mul(x, (1023 + 1023) << 52); k = k - 1023; }
    if (k >= 0) { return f64_mul(x, (1023 + k) << 52); }
    var m = (0 - k) / 1022;
    x = f64_mul(x, (1023 - ((0 - k) - m * 1022)) << 52);
    while (m > 0) { x = f64_mul(x, 0x0010_0000_0000_0000); m = m - 1; }   # 2^-1022
    return x;
}

# floor(log2 |x|) for a finite non-zero x, subnormals included.
fn _m3_expo(x) {
    var b = x & 0x7FFF_FFFF_FFFF_FFFF;
    if ((b >> 52) != 0) { return (b >> 52) - 1023; }
    return ((f64_mul(b, _M3_TWO64) >> 52) - 1023) - 64;
}

# ----------------------------------------------------------------
# Exact arithmetic over the whole double range (3.4.0)
# ----------------------------------------------------------------
# Every finite double is +-n * 2^e, n an integer below 2^53 and e in [-1074, 971], so a product
# of k entries is an integer below 2^(53 k) times 2^(e_1 + .. + e_k): no rounding, no range
# limit. `_m3_xsum` adds such products, signed, in base-2^27 integer limbs placed from k times
# the entries' least exponent up, so it decides zero exactly and rounds the sum once, to
# nearest with a sticky bit, for every finite input from the subnormals to DBL_MAX. (Through 3.4.0's review this was a
# double-precision expansion on a copy of m scaled row by row and column by column: the scaling
# rounded entries more than 2^1021 below their row's largest, and Dekker's product is inexact
# below 2^-969, so it answered Ok for matrices with two identical rows and refused invertible
# ones.) The engine is the inverse's third tier and the normal matrix's exact sign; its costs
# are theirs (the 4x4 determinant's 24 products of four entries: 1.8 us of mat4.cyr's 2.8 us
# singular refusal).
# [measured: scratch xs.bcyr, this tree, 2026-10-31; cycc 6.7.9]

# x (finite) into d[0..4): its significand n as base-2^27 limbs (low, high; 0 for +-0), its
# exponent e (|x| = n * 2^e) and its sign bit.
fn _m3_xdec(x, d) {
    var b = x & 0x7FFF_FFFF_FFFF_FFFF;
    var n = b & 0x000F_FFFF_FFFF_FFFF;
    var e = 0 - 1074;
    if ((b >> 52) != 0) { n = n | 0x0010_0000_0000_0000; e = (b >> 52) - 1075; }
    store64(d, n & _M3_LIMB);
    store64(d + 8, n >> 27);
    store64(d + 16, e);
    store64(d + 24, x >> 63);
    return 0;
}

# The least and greatest exponent of the non-zero entries among dc[0..ne) into er[0], er[1]
# (er[1] < er[0] when every one is zero): the bounds `_m3_xsum` places its terms by.
fn _m3_xrange(dc, ne, er) {
    var lo = 4096;
    var hi = 0 - 4096;
    var i = 0;
    while (i < ne) {
        var d = dc + i * 32;
        if ((load64(d) | load64(d + 8)) != 0) {
            var e = load64(d + 16);
            if (e < lo) { lo = e; }
            if (e > hi) { hi = e; }
        }
        i = i + 1;
    }
    store64(er, lo);
    store64(er + 8, hi);
    return 0;
}

# The significand product of term base's k entries (k = 2, 3) as base-2^27 limbs into pr, its
# exponent into pr[8] and its sign into pr[9]; returns the limb count, or 0 for a zero term.
# Every limb product is below 2^54 and every column sum below 2^57.
fn _m3_xprod(dc, base, k, pr) {
    var da = dc + load64(base) * 32;
    var db = dc + load64(base + 8) * 32;
    var a0 = load64(da); var a1 = load64(da + 8);
    var b0 = load64(db); var b1 = load64(db + 8);
    if ((a0 | a1) == 0 || (b0 | b1) == 0) { return 0; }
    store64(pr + 64, load64(da + 16) + load64(db + 16));
    store64(pr + 72, load64(da + 24) ^ load64(db + 24) ^ load64(base + k * 8));
    var t0 = a0 * b0;
    var t1 = a0 * b1 + a1 * b0 + (t0 >> 27);
    var t2 = a1 * b1 + (t1 >> 27);
    var p0 = t0 & _M3_LIMB; var p1 = t1 & _M3_LIMB; var p2 = t2 & _M3_LIMB; var p3 = t2 >> 27;
    if (k == 2) {
        store64(pr, p0); store64(pr + 8, p1); store64(pr + 16, p2); store64(pr + 24, p3);
        return 4;
    }
    var dg = dc + load64(base + 16) * 32;
    var c0 = load64(dg); var c1 = load64(dg + 8);
    if ((c0 | c1) == 0) { return 0; }
    store64(pr + 64, load64(pr + 64) + load64(dg + 16));
    store64(pr + 72, load64(pr + 72) ^ load64(dg + 24));
    {
        var u0 = p0 * c0;
        var u1 = p1 * c0 + p0 * c1 + (u0 >> 27);
        var u2 = p2 * c0 + p1 * c1 + (u1 >> 27);
        var u3 = p3 * c0 + p2 * c1 + (u2 >> 27);
        var u4 = p3 * c1 + (u3 >> 27);
        store64(pr, u0 & _M3_LIMB); store64(pr + 8, u1 & _M3_LIMB); store64(pr + 16, u2 & _M3_LIMB);
        store64(pr + 24, u3 & _M3_LIMB); store64(pr + 32, u4 & _M3_LIMB); store64(pr + 40, u4 >> 27);
        return 6;
    }
}

# The exact sum of nt signed products of k entries each: term t is the product of the entries
# dc[tl[t (k+1) + j]], j < k (four slots each, `_m3_xdec`), negated when tl[t (k+1) + k] is 1;
# er holds the entries' exponent bounds (`_m3_xrange`).
# Returns the sum's sign (1, -1, or 0 exactly when it is zero) and, when it is not zero, its
# magnitude rounded once to nearest as out[0] * 2^out[1], out[0] in [1, 2^62]. At most 32
# terms of at most 4 entries.
fn _m3_xsum(dc, er, tl, nt, k, out) {
    var acc: i64[320];
    var pr: i64[10];
    if (load64(er + 8) < load64(er)) { return 0; }   # every entry zero
    # every term is k entries' product: below 2^(53 k) in units of 2^(its exponent), which lies
    # in [k emin, k emax] (er: the entries' least and greatest exponents); a sum of at most 32
    # such terms needs 5 bits more
    var lo = k * load64(er);
    var w = (k * (load64(er + 8) - load64(er)) + 53 * k + 5) / 27 + 2;
    var i = 0;
    while (i < w) { store64(&acc + i * 8, 0); i = i + 1; }
    var t = 0;
    while (t < nt) {
        var n = _m3_xprod(dc, tl + t * (k + 1) * 8, k, &pr);
        if (n != 0) {
            var o = load64(&pr + 64) - lo;
            var ql = o / 27;
            var sh = o - ql * 27;
            var a = &acc + ql * 8;
            var pp = &pr;
            var pe = &pr + n * 8;
            if (load64(&pr + 72) == 0) {
                while (pp < pe) { store64(a, load64(a) + (load64(pp) << sh)); a = a + 8; pp = pp + 8; }
            } else {
                while (pp < pe) { store64(a, load64(a) - (load64(pp) << sh)); a = a + 8; pp = pp + 8; }
            }
        }
        t = t + 1;
    }
    # carries (floor, `>>>`): the top carry is 0 or -1, the sum's sign
    var c = 0;
    i = 0;
    while (i < w) {
        var v2 = load64(&acc + i * 8) + c;
        store64(&acc + i * 8, v2 & _M3_LIMB);
        c = v2 >>> 27;
        i = i + 1;
    }
    var res = 1;
    if (c < 0) {
        res = 0 - 1;
        c = 0;
        i = 0;
        while (i < w) {
            var v3 = c - load64(&acc + i * 8);
            store64(&acc + i * 8, v3 & _M3_LIMB);
            c = v3 >>> 27;
            i = i + 1;
        }
    }
    var h = w - 1;
    while (h >= 0 && load64(&acc + h * 8) == 0) { h = h - 1; }
    if (h < 0) { return 0; }
    # the top 62 bits, the rest folded into bit 0 (sticky): one rounding, to nearest
    var x = load64(&acc + h * 8);
    var nb = 0;
    var tt = x;
    while (tt != 0) { tt = tt >> 1; nb = nb + 1; }
    var pos = h * 27;
    var jb = h - 1;
    while (jb >= 0 && nb + 27 <= 62) {
        x = (x << 27) | load64(&acc + jb * 8);
        nb = nb + 27;
        pos = pos - 27;
        jb = jb - 1;
    }
    if (jb >= 0) {
        var take = 62 - nb;
        var lw = load64(&acc + jb * 8);
        x = (x << take) | (lw >> (27 - take));
        pos = pos - take;
        var st = lw & ((1 << (27 - take)) - 1);
        jb = jb - 1;
        while (jb >= 0) { st = st | load64(&acc + jb * 8); jb = jb - 1; }
        if (st != 0) { x = x | 1; }
    }
    store64(out, f64_from(x));
    store64(out + 8, pos + lo);
    return res;
}

# The two terms of the cofactor (-1)^(r+c) minor(r, c) of a 3x3 (entry (i, j) is index 3j + i)
# from term nt of tl on, each prefixed with the entry (r, c) itself when k is 3 (the terms of
# det along row r). Returns nt + 2.
fn _m3_minor_terms(tl, nt, r, c, k) {
    var r0 = 0;
    if (r == 0) { r0 = 1; }
    var r1 = 2;
    if (r == 2) { r1 = 1; }
    var c0 = 0;
    if (c == 0) { c0 = 1; }
    var c1 = 2;
    if (c == 2) { c1 = 1; }
    var s = (r + c) & 1;
    var p = tl + nt * (k + 1) * 8;
    if (k == 3) { store64(p, c * 3 + r); p = p + 8; }
    store64(p, c0 * 3 + r0);
    store64(p + 8, c1 * 3 + r1);
    store64(p + 16, s);
    p = p + 24;
    if (k == 3) { store64(p, c * 3 + r); p = p + 8; }
    store64(p, c1 * 3 + r0);
    store64(p + 8, c0 * 3 + r1);
    store64(p + 16, 1 - s);
    return nt + 2;
}

# det m's six terms (row 0's cofactor expansion) into tl; returns tl.
fn _m3_det_terms(tl) {
    _m3_minor_terms(tl, 0, 0, 0, 3);
    _m3_minor_terms(tl, 2, 0, 1, 3);
    _m3_minor_terms(tl, 4, 0, 2, 3);
    return tl;
}

# m's nine entries into dc (`_m3_xdec`) and their exponent bounds after them (`_m3_xrange`); 1
# when one is NaN or infinite (dc is then partial).
fn _m3_xload(m, dc) {
    var i = 0;
    while (i < 9) {
        var x = load64(m + i * 8);
        if ((x & 0x7FFF_FFFF_FFFF_FFFF) >= 0x7FF0_0000_0000_0000) { return 1; }
        _m3_xdec(x, dc + i * 32);
        i = i + 1;
    }
    _m3_xrange(dc, 9, dc + 9 * 32);
    return 0;
}

# The sign of det m, exactly: 1, -1, or 0 for a singular m; 1 for a NaN or infinite entry
# (`m3_normal_matrix_cof`'s orientation where its filter cannot certify one).
fn _m3_det_sign_exact(m) {
    var dc: i64[38];
    if (_m3_xload(m, &dc) == 1) { return 1; }
    var tl: i64[24];
    var od: i64[2];
    return _m3_xsum(&dc, &dc + 288, _m3_det_terms(&tl), 6, 3, &od);
}

# 1 when a row or a column of the 3x3 m is zero (`_m3_inverse_exact`'s quick refusal: a zero scale
# is the common singular matrix, and its exact determinant need not be summed).
fn _m3_zero_line(m) {
    var i = 0;
    while (i < 3) {
        var zr = 1;
        var zc = 1;
        var j = 0;
        while (j < 3) {
            if ((load64(m + (j * 3 + i) * 8) & 0x7FFF_FFFF_FFFF_FFFF) != 0) { zr = 0; }
            if ((load64(m + (i * 3 + j) * 8) & 0x7FFF_FFFF_FFFF_FFFF) != 0) { zc = 0; }
            j = j + 1;
        }
        if (zr == 1 || zc == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# `m3_inverse_checked` where its filter cannot certify the cofactor formula: decided and
# answered exactly. Singular exactly when det, summed exactly from its six products, is zero;
# otherwise each entry is C_ji / det, the cofactor and the determinant each summed exactly and
# rounded once, divided once and scaled by a power of two, rounded once more only where the
# entry is subnormal or overflows (to +-Inf, as IEEE rounds a value beyond DBL_MAX). So an
# entry X is within (3u + 3u^2)|X| of the exact one (u = 2^-53), under 3 ulp, plus half a
# subnormal step where it is subnormal; an exact zero entry is +0.
fn _m3_inverse_exact(m) {
    var dc: i64[38];
    if (_m3_xload(m, &dc) == 1) { return Err(HSB_ERR_INVALID_INPUT); }
    if (_m3_zero_line(m) == 1) { return Err(HSB_ERR_SINGULAR_MATRIX); }
    var tl: i64[24];
    var od: i64[2];
    var sd = _m3_xsum(&dc, &dc + 288, _m3_det_terms(&tl), 6, 3, &od);
    if (sd == 0) { return Err(HSB_ERR_SINGULAR_MATRIX); }
    var r = m3_new();
    if (r == 0) { return Err(HSB_ERR_ALLOC); }
    var oc: i64[2];
    var row = 0;
    while (row < 3) {
        var col = 0;
        while (col < 3) {
            _m3_minor_terms(&tl, 0, row, col, 2);
            var sc = _m3_xsum(&dc, &dc + 288, &tl, 2, 2, &oc);
            var v = 0;
            if (sc != 0) {
                v = _m3_ldexp(f64_div(load64(&oc), load64(&od)), load64(&oc + 8) - load64(&od + 8));
                if (sc != sd) { v = v ^ 0x8000000000000000; }   # the sign bit: f64_neg gave +0 for +0 below cycc 6.6.8
            }
            # X = adj(m) / det: X(col, row) = C(row, col) / det, at index 3 row + col
            store64(r + (row * 3 + col) * 8, v);
            col = col + 1;
        }
        row = row + 1;
    }
    return Ok(r);
}

# M^-1 as `Ok(matrix)`, or `Err(HSB_ERR_SINGULAR_MATRIX)` exactly when M -- its nine entries
# taken as the exact rationals they are -- has determinant zero, or `Err(HSB_ERR_INVALID_INPUT)`
# for a NaN or infinite entry: decided exactly over the whole double range, subnormal to
# DBL_MAX. An entry whose exact value lies beyond DBL_MAX comes back +-Inf, IEEE's rounding of
# it, not an error: the matrix has an inverse, the other entries are right, and an Err would
# discard them.
#
# ⛔ 3.4.0 — `m3_inverse` RETURNED THE IDENTITY for a singular or NaN matrix, a full-rank,
# unit-determinant answer with no error channel (audit D088), and the reciprocal test that
# chose it (2.15.0) also misfired on ranges: 2^-400 I got the identity, not 2^400 I, because
# det = 2^-1200 underflows; 2^400 I got the ZERO matrix (det overflows, 1/det = 0). It is
# retired, not redefined.
# ⭐ Singular is decided EXACTLY, never by a threshold on det: no tolerance, absolute or
# relative, separates a singular matrix from a non-singular one ([[1, 1], [1, 1 + 2^-52]] has
# an exactly representable inverse and det/permanent = 2^-53). Three tiers answer, each where
# it is certified, the cheapest first (u = 2^-53, P the permanent of |M|: the expansion's
# products in absolute value):
#  1. The cofactor formula, 3.3.7's arithmetic bit for bit, where its determinant is good to
#     2^-40.7: |det - det~| <= 5u P (first order), and P <= 2^10 |det~|. With it, P in
#     [2^-960, 2^1000] and every non-zero entry at least 2^-511 (no product of two entries
#     flushes), and an answer whose entries are all finite.
#  2. Where 2^10 |det~| < P <= 2^43 |dd|: the formula's cofactors over a double-double
#     determinant dd (Dekker's exact products, TwoSum), within 30 u^2 P of det, so within
#     2^-58 of it before its own rounding. P >= 2^-900 and P >= 2^-960 max|row 0| keep the
#     products' error terms exact.
#  3. Everything else -- |det| below 2^-43 P (singular included), a small entry, a range the
#     products cannot hold, a non-finite answer -- `_m3_inverse_exact`, in exact integers.
# 2^10 and 2^43 are not tolerances; they only choose which tier answers. (Through the first
# 3.4.0 review there was no tier 2, tier 3 was a double-precision expansion that was not exact
# outside a range the contract never stated, and a row-0 clause let diag(2^-600, 2^1000,
# 2^-600) answer diag(2^600, 0, 2^600).)
# Accuracy, derived to first order: in tiers 1 and 2 an entry X_ij = C_ji / det is within
# (2u pC_ji + (e + 2u) |C_ji|) / |det|, pC_ji the permanent of its cofactor's minor and e the
# determinant's relative error (2^-40.7 in tier 1, 2^-58 + u in tier 2): the cofactors carry
# the formula's error relative to their permanents, which only a cancelling cofactor makes
# large beside the entry. Add half a subnormal step (2^-1075) where X_ij is below DBL_MIN: 1/det
# is normal (|det| <= P <= 2^1000) and every product of two entries is at least 2^-1022, so
# only the last product, 1/det times C, rounds on the subnormal grid (3.4.1: this term was not
# stated). In tier 3 X is within (3u + 3u^2) |X| (under 3 ulp), plus half a subnormal step
# where it is subnormal.
# Measured, against exact rational inverses (maxima of the stated samples, not bounds), in ulp of
# the largest exact entry: 2,000 random uniform matrices 230; r2 = r0 + r1 + noise 2^-k (200
# each) 434 at k = 4, 387 at k = 10, 6.1 .. 1.7 for k = 20 .. 50; 3,000 matrices with entries
# anywhere from 2^-1074 to 2^1023 (tier 3), every entry within 2.45 ulp of its own exact value.
# [measured: scratch t_m3acc.py / t_exact.py, Fraction oracle, 3.4.0 lane FB review repairs, 2026-10-31]
# Cost, against integ-snap7 and 3.3.7 (focused rows, the three binaries interleaved x 3): tier 1
# 79 -> 82 ns (3.3.7: 173); rows r2 = r0 + r1 + 2^-30 (tier 2) 2.39 us -> 231 ns (3.3.7: 174,
# with no correct digit); an exactly singular matrix 1.91 us -> 799 ns (3.3.7: 176, the identity).
# [measured: scratch inv_new.bcyr / inv_old.bcyr, 3.3.7 + integ-snap7 + this tree x 3, 2026-10-31; cycc 6.7.9]
# Tier 3 is the slow one, and its cost grows with the range the entries span (its exact sums
# work in 27-bit limbs across it): 13.3-13.7 us medians (runs 12.8-14.1) on a 3x3 whose
# exponents are drawn from 2^-1074 to 2^1023, a fifth of them subnormal (3.4.1; the [3.4.1]
# roadmap row quoted 15.3 us from another session). mat4.cyr's `m4_inverse_checked` states the
# 4x4's.
# [measured: scratch MAT4-i7 bv_same*.bcyr, 3 x 4 runs, load 2.2-2.7, 2026-11-01; cycc 6.7.18]
#must_use
public fn m3_inverse_checked(m) {
    var m00 = load64(m);      var m01 = load64(m + 8);  var m02 = load64(m + 16);
    var m10 = load64(m + 24); var m11 = load64(m + 32); var m12 = load64(m + 40);
    var m20 = load64(m + 48); var m21 = load64(m + 56); var m22 = load64(m + 64);
    var p0 = f64_mul(m11, m22); var p1 = f64_mul(m21, m12);
    var p2 = f64_mul(m01, m22); var p3 = f64_mul(m21, m02);
    var p4 = f64_mul(m01, m12); var p5 = f64_mul(m11, m02);
    var a0 = f64_sub(p0, p1);
    var a2 = f64_sub(p4, p5);
    var det = f64_add(f64_sub(f64_mul(m00, a0), f64_mul(m10, f64_sub(p2, p3))), f64_mul(m20, a2));
    var pm = f64_add(f64_add(f64_mul(f64_abs(m00), f64_add(f64_abs(p0), f64_abs(p1))),
        f64_mul(f64_abs(m10), f64_add(f64_abs(p2), f64_abs(p3)))),
      f64_mul(f64_abs(m20), f64_add(f64_abs(p4), f64_abs(p5))));
    # Every non-zero |entry| at least 2^-511, so no product of two entries flushes; on the bits.
    var small = 0;
    var st = 0;
    st = m00 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M3_SMALL) { if (st != 0) { small = 1; } }
    st = m01 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M3_SMALL) { if (st != 0) { small = 1; } }
    st = m02 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M3_SMALL) { if (st != 0) { small = 1; } }
    st = m10 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M3_SMALL) { if (st != 0) { small = 1; } }
    st = m11 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M3_SMALL) { if (st != 0) { small = 1; } }
    st = m12 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M3_SMALL) { if (st != 0) { small = 1; } }
    st = m20 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M3_SMALL) { if (st != 0) { small = 1; } }
    st = m21 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M3_SMALL) { if (st != 0) { small = 1; } }
    st = m22 & 0x7FFF_FFFF_FFFF_FFFF;
    if (st < _M3_SMALL) { if (st != 0) { small = 1; } }
    var certified = 0;
    if (small == 0 && f64_ge(pm, _M3_PM_LO) == 1 && f64_le(pm, _M3_PM_HI) == 1) {
        if (f64_le(pm, f64_mul(f64_abs(det), _M3_CERT)) == 1) {
            certified = 1;
        }
        if (certified == 0 && f64_ge(pm, _M3_DD_LO) == 1
          && f64_ge(pm, f64_mul(f64_max(f64_max(f64_abs(m00), f64_abs(m10)), f64_abs(m20)), _M3_PM_LO)) == 1) {
            # Every entry split into halves of at most 26 significant bits (Dekker), x = xh + xl.
            var t00 = f64_mul(m00, _M3_SPLIT); var h00 = f64_sub(t00, f64_sub(t00, m00)); var l00 = f64_sub(m00, h00);
            var t01 = f64_mul(m01, _M3_SPLIT); var h01 = f64_sub(t01, f64_sub(t01, m01)); var l01 = f64_sub(m01, h01);
            var t02 = f64_mul(m02, _M3_SPLIT); var h02 = f64_sub(t02, f64_sub(t02, m02)); var l02 = f64_sub(m02, h02);
            var t10 = f64_mul(m10, _M3_SPLIT); var h10 = f64_sub(t10, f64_sub(t10, m10)); var l10 = f64_sub(m10, h10);
            var t11 = f64_mul(m11, _M3_SPLIT); var h11 = f64_sub(t11, f64_sub(t11, m11)); var l11 = f64_sub(m11, h11);
            var t12 = f64_mul(m12, _M3_SPLIT); var h12 = f64_sub(t12, f64_sub(t12, m12)); var l12 = f64_sub(m12, h12);
            var t20 = f64_mul(m20, _M3_SPLIT); var h20 = f64_sub(t20, f64_sub(t20, m20)); var l20 = f64_sub(m20, h20);
            var t21 = f64_mul(m21, _M3_SPLIT); var h21 = f64_sub(t21, f64_sub(t21, m21)); var l21 = f64_sub(m21, h21);
            var t22 = f64_mul(m22, _M3_SPLIT); var h22 = f64_sub(t22, f64_sub(t22, m22)); var l22 = f64_sub(m22, h22);
            # The six products' rounding errors, exactly: x y = p + e.
            var ep0 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h11, h22), p0), f64_mul(h11, l22)),
                f64_mul(l11, h22)), f64_mul(l11, l22));
            var ep1 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h21, h12), p1), f64_mul(h21, l12)),
                f64_mul(l21, h12)), f64_mul(l21, l12));
            var ep2 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h01, h22), p2), f64_mul(h01, l22)),
                f64_mul(l01, h22)), f64_mul(l01, l22));
            var ep3 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h21, h02), p3), f64_mul(h21, l02)),
                f64_mul(l21, h02)), f64_mul(l21, l02));
            var ep4 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h01, h12), p4), f64_mul(h01, l12)),
                f64_mul(l01, h12)), f64_mul(l01, l12));
            var ep5 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h11, h02), p5), f64_mul(h11, l02)),
                f64_mul(l11, h02)), f64_mul(l11, l02));
            # Each 2x2 minor as hi + lo: hi the rounded difference, lo its TwoSum error plus the
            # products' errors.
            var a1 = f64_sub(p2, p3);
            var za0 = f64_sub(a0, p0);
            var xa0 = f64_add(f64_sub(f64_sub(p0, f64_sub(a0, za0)), f64_add(p1, za0)), f64_sub(ep0, ep1));
            var za1 = f64_sub(a1, p2);
            var xa1 = f64_add(f64_sub(f64_sub(p2, f64_sub(a1, za1)), f64_add(p3, za1)), f64_sub(ep2, ep3));
            var za2 = f64_sub(a2, p4);
            var xa2 = f64_add(f64_sub(f64_sub(p4, f64_sub(a2, za2)), f64_add(p5, za2)), f64_sub(ep4, ep5));
            # The three products m a of the expansion, each as q + r: q rounded, r its exact error plus
            # m a.lo.
            var va0 = f64_mul(a0, _M3_SPLIT); var ya0 = f64_sub(va0, f64_sub(va0, a0)); var wa0 = f64_sub(a0, ya0);
            var qa0 = f64_mul(m00, a0);
            var ra0 = f64_add(f64_add(f64_add(f64_add(f64_sub(f64_mul(h00, ya0), qa0), f64_mul(h00, wa0)),
                  f64_mul(l00, ya0)), f64_mul(l00, wa0)), f64_mul(m00, xa0));
            var va1 = f64_mul(a1, _M3_SPLIT); var ya1 = f64_sub(va1, f64_sub(va1, a1)); var wa1 = f64_sub(a1, ya1);
            var qa1 = f64_mul(m10, a1);
            var ra1 = f64_add(f64_add(f64_add(f64_add(f64_sub(f64_mul(h10, ya1), qa1), f64_mul(h10, wa1)),
                  f64_mul(l10, ya1)), f64_mul(l10, wa1)), f64_mul(m10, xa1));
            var va2 = f64_mul(a2, _M3_SPLIT); var ya2 = f64_sub(va2, f64_sub(va2, a2)); var wa2 = f64_sub(a2, ya2);
            var qa2 = f64_mul(m20, a2);
            var ra2 = f64_add(f64_add(f64_add(f64_add(f64_sub(f64_mul(h20, ya2), qa2), f64_mul(h20, wa2)),
                  f64_mul(l20, ya2)), f64_mul(l20, wa2)), f64_mul(m20, xa2));
            # det = q0 - q1 + q2 (as det~ orders them): the q summed by TwoSum, their errors and the r
            # in plain arithmetic, then the two rounded together.
            var dh = qa0;
            var dl = ra0;
            var na1 = f64_sub(dh, qa1);
            var oa1 = f64_sub(na1, dh);
            dl = f64_sub(f64_add(dl, f64_sub(f64_sub(dh, f64_sub(na1, oa1)), f64_add(qa1, oa1))), ra1);
            dh = na1;
            var na2 = f64_add(dh, qa2);
            var oa2 = f64_sub(na2, dh);
            dl = f64_add(f64_add(dl, f64_add(f64_sub(dh, f64_sub(na2, oa2)), f64_sub(qa2, oa2))), ra2);
            dh = na2;
            var dd = f64_add(dh, dl);
            # |dd - det| <= 30 u^2 P (the derivation is in the comment above), so P <= 2^43 |dd| puts
            # dd within 2^-58 of det, relative, before its own rounding.
            if (f64_le(pm, f64_mul(f64_abs(dd), _M3_CERT2)) == 1) {
                det = dd;
                certified = 1;
            }
        }
    }
    if (certified == 1) {
        var inv_det = f64_div(F64_ONE, det);
        var r = alloc(MAT3_BYTES);
        if (r == 0) { return Err(HSB_ERR_ALLOC); }
        var r0 = f64_mul(inv_det, a0);
        var r1 = f64_mul(inv_det, f64_sub(p3, p2));
        var r2 = f64_mul(inv_det, a2);
        var r3 = f64_mul(inv_det, f64_sub(f64_mul(m20, m12), f64_mul(m10, m22)));
        var r4 = f64_mul(inv_det, f64_sub(f64_mul(m00, m22), f64_mul(m20, m02)));
        var r5 = f64_mul(inv_det, f64_sub(f64_mul(m10, m02), f64_mul(m00, m12)));
        var r6 = f64_mul(inv_det, f64_sub(f64_mul(m10, m21), f64_mul(m20, m11)));
        var r7 = f64_mul(inv_det, f64_sub(f64_mul(m20, m01), f64_mul(m00, m21)));
        var r8 = f64_mul(inv_det, f64_sub(f64_mul(m00, m11), f64_mul(m10, m01)));
        store64(r, r0); store64(r + 8, r1); store64(r + 16, r2);
        store64(r + 24, r3); store64(r + 32, r4); store64(r + 40, r5);
        store64(r + 48, r6); store64(r + 56, r7); store64(r + 64, r8);
        # One test on the sum, non-finite whenever an entry is (an overflowing finite sum only
        # sends a finite answer to the exact path, which gives it again).
        var sm = f64_add(f64_add(f64_add(r0, r1), f64_add(r2, r3)),
          f64_add(f64_add(r4, r5), f64_add(f64_add(r6, r7), r8)));
        if ((sm & 0x7FFF_FFFF_FFFF_FFFF) < 0x7FF0_0000_0000_0000) { return Ok(r); }
    }
    return _m3_inverse_exact(m);
}

# a + b, entrywise, each entry correctly rounded.
#must_use
public fn m3_add(a, b) {
    var r = m3_new();
    if (r == 0) { return 0; }
    var i = 0;
    while (i < 9) {
        store64(r + i * 8, f64_add(load64(a + i * 8), load64(b + i * 8)));
        i = i + 1;
    }
    return r;
}

# m times the scalar s, each entry correctly rounded.
#must_use
public fn m3_scale(m, s) {
    var r = m3_new();
    if (r == 0) { return 0; }
    var i = 0;
    while (i < 9) {
        store64(r + i * 8, f64_mul(load64(m + i * 8), s));
        i = i + 1;
    }
    return r;
}

# The rotation matrix of q: R(q / |q|), the rotation q represents (q v q^-1), for every finite
# non-zero q, as `hquat_rotate_vec3` rotates by it. With s = 2 / |q|^2 the entries are the unit
# formula's with s for its 2 (1 - s (y^2 + z^2), s (xy + wz), ...), the standard form for a
# non-unit q. |q|^2 is used directly in [1/4, 16]; any other finite non-zero q is first scaled
# by a power of two to put its largest component in [1, 2) (the same rotation), so neither
# |q|^2 nor s can overflow or flush because of |q|. Where |q|^2 = 1.0 exactly, s = 2 and the
# arithmetic is 3.3.7's, bit for bit. A zero or non-finite q represents no rotation: the matrix
# is NaN (s = 2 / 0 = Inf, times 0), as `hquat_rotate_vec3` gives NaN.
# ⛔ 3.4.0 — THROUGH THE FIRST 3.4.0 REVIEW THIS WAS THE UNIT FORMULA FOR EVERY q, after
# `hquat_rotate_vec3` had moved to q / |q|: q = (0.154, 3.32, 3.86, -15.2) took (1, 1, -1) to
# (167.26, -175.48, 144.16) here and in `m4_from_srt` (so `t3d_to_matrix`) where `t3d_apply`
# gave (1.647, 0.313, -0.435), and q = 0 gave the identity, a rotation by nothing.
#must_use
public fn m3_from_quat(q) {
    var qx = HQuat_x(q); var qy = HQuat_y(q); var qz = HQuat_z(q); var qw = HQuat_w(q);
    var n = f64_add(f64_add(f64_mul(qx, qx), f64_mul(qy, qy)), f64_add(f64_mul(qz, qz), f64_mul(qw, qw)));
    # n is +0, positive or NaN, so its bits order as it does (quat.cyr's range test)
    if (n < _M3_QN_LO || n > _M3_QN_HI) {
        var mq = qx & 0x7FFF_FFFF_FFFF_FFFF;
        if ((qy & 0x7FFF_FFFF_FFFF_FFFF) > mq) { mq = qy & 0x7FFF_FFFF_FFFF_FFFF; }
        if ((qz & 0x7FFF_FFFF_FFFF_FFFF) > mq) { mq = qz & 0x7FFF_FFFF_FFFF_FFFF; }
        if ((qw & 0x7FFF_FFFF_FFFF_FFFF) > mq) { mq = qw & 0x7FFF_FFFF_FFFF_FFFF; }
        # A non-finite component: no rotation, so every entry is NaN. Without this an infinite
        # q gave n = +Inf, 2 / n = 0, and the diagonal entry whose products held no infinity
        # came back 1.0 (q = (Inf, 0, 0, 1): entry (0, 0)).
        if (mq >= 0x7FF0_0000_0000_0000) { n = 0x7FF8_0000_0000_0000; }
        if (mq != 0 && mq < 0x7FF0_0000_0000_0000) {
            var e = _m3_expo(mq);
            qx = _m3_ldexp(qx, 0 - e); qy = _m3_ldexp(qy, 0 - e);
            qz = _m3_ldexp(qz, 0 - e); qw = _m3_ldexp(qw, 0 - e);
            n = f64_add(f64_add(f64_mul(qx, qx), f64_mul(qy, qy)), f64_add(f64_mul(qz, qz), f64_mul(qw, qw)));
        }
    }
    var tw = F64_TWO;
    if (n != 0x3FF0_0000_0000_0000) { tw = f64_div(F64_TWO, n); }
    var xx = f64_mul(qx, qx); var yy = f64_mul(qy, qy); var zz = f64_mul(qz, qz);
    var xy = f64_mul(qx, qy); var xz = f64_mul(qx, qz); var yz = f64_mul(qy, qz);
    var wx = f64_mul(qw, qx); var wy = f64_mul(qw, qy); var wz = f64_mul(qw, qz);
    var m = m3_new();
    if (m == 0) { return 0; }
    m3_set(m, 0, 0, f64_sub(F64_ONE, f64_mul(tw, f64_add(yy, zz))));
    m3_set(m, 0, 1, f64_mul(tw, f64_add(xy, wz)));
    m3_set(m, 0, 2, f64_mul(tw, f64_sub(xz, wy)));
    m3_set(m, 1, 0, f64_mul(tw, f64_sub(xy, wz)));
    m3_set(m, 1, 1, f64_sub(F64_ONE, f64_mul(tw, f64_add(xx, zz))));
    m3_set(m, 1, 2, f64_mul(tw, f64_add(yz, wx)));
    m3_set(m, 2, 0, f64_mul(tw, f64_add(xz, wy)));
    m3_set(m, 2, 1, f64_mul(tw, f64_sub(yz, wx)));
    m3_set(m, 2, 2, f64_sub(F64_ONE, f64_mul(tw, f64_add(xx, yy))));
    return m;
}

# The signed cofactor matrix of m (`m3_normal_matrix_cof`'s body without its range rescue),
# negated when sg < 0, into a new matrix; returns it.
fn _m3_cof_signed(m, sg) {
    var m00 = load64(m);      var m01 = load64(m + 8);  var m02 = load64(m + 16);
    var m10 = load64(m + 24); var m11 = load64(m + 32); var m12 = load64(m + 40);
    var m20 = load64(m + 48); var m21 = load64(m + 56); var m22 = load64(m + 64);
    var r = alloc(MAT3_BYTES);
    if (r == 0) { return 0; }
    # N[i][j] = C[i][j], the (i, j) cofactor; column-major, so N at (col j, row i).
    store64(r,      f64_sub(f64_mul(m11, m22), f64_mul(m21, m12)));
    store64(r + 24, f64_sub(f64_mul(m21, m02), f64_mul(m01, m22)));
    store64(r + 48, f64_sub(f64_mul(m01, m12), f64_mul(m11, m02)));
    store64(r + 8,  f64_sub(f64_mul(m20, m12), f64_mul(m10, m22)));
    store64(r + 32, f64_sub(f64_mul(m00, m22), f64_mul(m20, m02)));
    store64(r + 56, f64_sub(f64_mul(m10, m02), f64_mul(m00, m12)));
    store64(r + 16, f64_sub(f64_mul(m10, m21), f64_mul(m20, m11)));
    store64(r + 40, f64_sub(f64_mul(m20, m01), f64_mul(m00, m21)));
    store64(r + 64, f64_sub(f64_mul(m00, m11), f64_mul(m10, m01)));
    if (sg < 0) {
        var i = 0;
        while (i < 9) { store64(r + i * 8, load64(r + i * 8) ^ 0x8000000000000000); i = i + 1; }
    }
    return r;
}

# The larger of a b, a c and b c for a, b, c >= 0 (as bits): the product of the two largest.
fn _m3_top2(a, b, c) {
    if (a < b) { var t = a; a = b; b = t; }
    if (b < c) { b = c; }
    return f64_mul(a, b);
}

# 1 when m's cofactor matrix r (computed, its largest |entry| mx as bits) is certified within
# 17u max of the exact one (u = 2^-53), replacing r by compensated minors where the plain ones
# are not: each plain minor a d - b c is within u (|a d| + |b c|) + u |c_ij| <= 2u G + u |c_ij|
# of its own value, G the largest |product| in any minor, so G <= 8 mx suffices. Every product
# in a minor takes its two entries from two different columns and two different rows, so G is
# at most the product of the two largest column maxima, and of the two largest row maxima:
# `m3_normal_matrix_cof` tries the columns (a matrix times a scale, R S) before calling this;
# here the rows (S R), then `_m3_cof_comp` forms G itself and, past 8 mx, the compensated
# minors. With mx at or above 2^-969, a subnormal product's 2^-1075 is below 2^-105 mx.
fn _m3_cof_certified(m, mx, sg, r) {
    var lim = f64_mul(mx, _M3_NCERT);
    var r0 = 0; var r1 = 0; var r2 = 0;
    var j = 0;
    while (j < 3) {
        var x0 = load64(m + j * 24) & 0x7FFF_FFFF_FFFF_FFFF;
        var x1 = load64(m + j * 24 + 8) & 0x7FFF_FFFF_FFFF_FFFF;
        var x2 = load64(m + j * 24 + 16) & 0x7FFF_FFFF_FFFF_FFFF;
        if (x0 > r0) { r0 = x0; }
        if (x1 > r1) { r1 = x1; }
        if (x2 > r2) { r2 = x2; }
        j = j + 1;
    }
    if (f64_le(_m3_top2(r0, r1, r2), lim) == 1) { return 1; }
    if (r1 > r0) { r0 = r1; }
    if (r2 > r0) { r0 = r2; }
    return _m3_cof_comp(m, sg, r, mx, r0);
}

# The products' half of `_m3_cof_certified` and `m3_normal_matrix_cof`'s middle tier (3.4.1
# review M1). G, the largest |product| of the eighteen in the nine minors a d - b c (rounded,
# as bits), first decides the plain minors in r: certified when G <= 8 mx (mx the largest
# |plain entry|). Otherwise every minor is recomputed compensated, both products split exactly
# (Dekker: x y = p + e, no FMA) and the difference summed with TwoSum, c~ = s + ((p - (s - z))
# - (q + z) + (ep - eq)) with s = p - q rounded: within u |c~| + 6u^2 G of the exact minor
# (first order). So G <= 2^54 max|c~| puts the matrix within 13u max|c~| of the exact one,
# normwise (15u with the subnormal losses below), inside the 17u the plain tier promises; it is
# written into r with sg applied (as `_m3_cof_signed` does). Returns 1 when r is certified, 0
# when the caller must take the exact path. me is m's largest |entry| (as bits).
# Its own steps overflow exactly where an entry is at or above 2^997 - 2^970 (x (2^27 + 1) past
# DBL_MAX) or where a product of two splits, which round up by up to 2^-26 of the entry, passes
# DBL_MAX (only for a product at or above 2^1023, `_m3_cof_hhovf`): those m go to
# `_m3_cof_wide` (3.4.1 round-2 review S1; the first form made such minors non-finite and
# declined them, so the exact path answered, at 50 to 94 times 3.4.0's time). Everywhere else
# nothing here overflows: |s| < 2^1021 past G > 8 mx. An error term of a product below 2^-969
# can lose bits, at most 2^-1072 a minor; this tier runs only past G > 8 mx >= 2^-966 (the
# callers' floor on mx) and certifies only max|c~| >= 2^-54 G > 2^-1020, so those losses add
# under 2u. (A floor test on max|c~| moved no answer under mutation and was dropped.)
fn _m3_cof_comp(m, sg, r, mx, me) {
    var m00 = load64(m + 0);
    var m01 = load64(m + 8);
    var m02 = load64(m + 16);
    var m10 = load64(m + 24);
    var m11 = load64(m + 32);
    var m12 = load64(m + 40);
    var m20 = load64(m + 48);
    var m21 = load64(m + 56);
    var m22 = load64(m + 64);
    var p0 = f64_mul(m11, m22); var q0 = f64_mul(m21, m12);
    var p1 = f64_mul(m21, m02); var q1 = f64_mul(m01, m22);
    var p2 = f64_mul(m01, m12); var q2 = f64_mul(m11, m02);
    var p3 = f64_mul(m20, m12); var q3 = f64_mul(m10, m22);
    var p4 = f64_mul(m00, m22); var q4 = f64_mul(m20, m02);
    var p5 = f64_mul(m10, m02); var q5 = f64_mul(m00, m12);
    var p6 = f64_mul(m10, m21); var q6 = f64_mul(m20, m11);
    var p7 = f64_mul(m20, m01); var q7 = f64_mul(m00, m21);
    var p8 = f64_mul(m00, m11); var q8 = f64_mul(m10, m01);
    var g = p0 & 0x7FFF_FFFF_FFFF_FFFF;
    var gq0 = q0 & 0x7FFF_FFFF_FFFF_FFFF; if (gq0 > g) { g = gq0; }
    var gp1 = p1 & 0x7FFF_FFFF_FFFF_FFFF; if (gp1 > g) { g = gp1; }
    var gq1 = q1 & 0x7FFF_FFFF_FFFF_FFFF; if (gq1 > g) { g = gq1; }
    var gp2 = p2 & 0x7FFF_FFFF_FFFF_FFFF; if (gp2 > g) { g = gp2; }
    var gq2 = q2 & 0x7FFF_FFFF_FFFF_FFFF; if (gq2 > g) { g = gq2; }
    var gp3 = p3 & 0x7FFF_FFFF_FFFF_FFFF; if (gp3 > g) { g = gp3; }
    var gq3 = q3 & 0x7FFF_FFFF_FFFF_FFFF; if (gq3 > g) { g = gq3; }
    var gp4 = p4 & 0x7FFF_FFFF_FFFF_FFFF; if (gp4 > g) { g = gp4; }
    var gq4 = q4 & 0x7FFF_FFFF_FFFF_FFFF; if (gq4 > g) { g = gq4; }
    var gp5 = p5 & 0x7FFF_FFFF_FFFF_FFFF; if (gp5 > g) { g = gp5; }
    var gq5 = q5 & 0x7FFF_FFFF_FFFF_FFFF; if (gq5 > g) { g = gq5; }
    var gp6 = p6 & 0x7FFF_FFFF_FFFF_FFFF; if (gp6 > g) { g = gp6; }
    var gq6 = q6 & 0x7FFF_FFFF_FFFF_FFFF; if (gq6 > g) { g = gq6; }
    var gp7 = p7 & 0x7FFF_FFFF_FFFF_FFFF; if (gp7 > g) { g = gp7; }
    var gq7 = q7 & 0x7FFF_FFFF_FFFF_FFFF; if (gq7 > g) { g = gq7; }
    var gp8 = p8 & 0x7FFF_FFFF_FFFF_FFFF; if (gp8 > g) { g = gp8; }
    var gq8 = q8 & 0x7FFF_FFFF_FFFF_FFFF; if (gq8 > g) { g = gq8; }
    if (f64_le(g, f64_mul(mx, _M3_NCERT)) == 1) { return 1; }
    if (me >= _M3_WENT) { return _m3_cof_wide(m, sg, r); }
    if (g >= _M3_WPRD) {
        if (_m3_cof_hhovf(m) == 1) { return _m3_cof_wide(m, sg, r); }
    }
    var t00 = f64_mul(m00, _M3_SPLIT); var h00 = f64_sub(t00, f64_sub(t00, m00)); var l00 = f64_sub(m00, h00);
    var t01 = f64_mul(m01, _M3_SPLIT); var h01 = f64_sub(t01, f64_sub(t01, m01)); var l01 = f64_sub(m01, h01);
    var t02 = f64_mul(m02, _M3_SPLIT); var h02 = f64_sub(t02, f64_sub(t02, m02)); var l02 = f64_sub(m02, h02);
    var t10 = f64_mul(m10, _M3_SPLIT); var h10 = f64_sub(t10, f64_sub(t10, m10)); var l10 = f64_sub(m10, h10);
    var t11 = f64_mul(m11, _M3_SPLIT); var h11 = f64_sub(t11, f64_sub(t11, m11)); var l11 = f64_sub(m11, h11);
    var t12 = f64_mul(m12, _M3_SPLIT); var h12 = f64_sub(t12, f64_sub(t12, m12)); var l12 = f64_sub(m12, h12);
    var t20 = f64_mul(m20, _M3_SPLIT); var h20 = f64_sub(t20, f64_sub(t20, m20)); var l20 = f64_sub(m20, h20);
    var t21 = f64_mul(m21, _M3_SPLIT); var h21 = f64_sub(t21, f64_sub(t21, m21)); var l21 = f64_sub(m21, h21);
    var t22 = f64_mul(m22, _M3_SPLIT); var h22 = f64_sub(t22, f64_sub(t22, m22)); var l22 = f64_sub(m22, h22);
    var cm = 0;
    var ep0 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h11, h22), p0), f64_mul(h11, l22)), f64_mul(l11, h22)),
      f64_mul(l11, l22));
    var eq0 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h21, h12), q0), f64_mul(h21, l12)), f64_mul(l21, h12)),
      f64_mul(l21, l12));
    var s0 = f64_sub(p0, q0); var z0 = f64_sub(s0, p0);
    var c0 = f64_add(s0, f64_add(f64_sub(f64_sub(p0, f64_sub(s0, z0)), f64_add(q0, z0)), f64_sub(ep0, eq0)));
    if ((c0 & 0x7FFF_FFFF_FFFF_FFFF) > cm) { cm = c0 & 0x7FFF_FFFF_FFFF_FFFF; }
    store64(r + 0, c0);
    var ep1 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h21, h02), p1), f64_mul(h21, l02)), f64_mul(l21, h02)),
      f64_mul(l21, l02));
    var eq1 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h01, h22), q1), f64_mul(h01, l22)), f64_mul(l01, h22)),
      f64_mul(l01, l22));
    var s1 = f64_sub(p1, q1); var z1 = f64_sub(s1, p1);
    var c1 = f64_add(s1, f64_add(f64_sub(f64_sub(p1, f64_sub(s1, z1)), f64_add(q1, z1)), f64_sub(ep1, eq1)));
    if ((c1 & 0x7FFF_FFFF_FFFF_FFFF) > cm) { cm = c1 & 0x7FFF_FFFF_FFFF_FFFF; }
    store64(r + 24, c1);
    var ep2 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h01, h12), p2), f64_mul(h01, l12)), f64_mul(l01, h12)),
      f64_mul(l01, l12));
    var eq2 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h11, h02), q2), f64_mul(h11, l02)), f64_mul(l11, h02)),
      f64_mul(l11, l02));
    var s2 = f64_sub(p2, q2); var z2 = f64_sub(s2, p2);
    var c2 = f64_add(s2, f64_add(f64_sub(f64_sub(p2, f64_sub(s2, z2)), f64_add(q2, z2)), f64_sub(ep2, eq2)));
    if ((c2 & 0x7FFF_FFFF_FFFF_FFFF) > cm) { cm = c2 & 0x7FFF_FFFF_FFFF_FFFF; }
    store64(r + 48, c2);
    var ep3 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h20, h12), p3), f64_mul(h20, l12)), f64_mul(l20, h12)),
      f64_mul(l20, l12));
    var eq3 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h10, h22), q3), f64_mul(h10, l22)), f64_mul(l10, h22)),
      f64_mul(l10, l22));
    var s3 = f64_sub(p3, q3); var z3 = f64_sub(s3, p3);
    var c3 = f64_add(s3, f64_add(f64_sub(f64_sub(p3, f64_sub(s3, z3)), f64_add(q3, z3)), f64_sub(ep3, eq3)));
    if ((c3 & 0x7FFF_FFFF_FFFF_FFFF) > cm) { cm = c3 & 0x7FFF_FFFF_FFFF_FFFF; }
    store64(r + 8, c3);
    var ep4 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h00, h22), p4), f64_mul(h00, l22)), f64_mul(l00, h22)),
      f64_mul(l00, l22));
    var eq4 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h20, h02), q4), f64_mul(h20, l02)), f64_mul(l20, h02)),
      f64_mul(l20, l02));
    var s4 = f64_sub(p4, q4); var z4 = f64_sub(s4, p4);
    var c4 = f64_add(s4, f64_add(f64_sub(f64_sub(p4, f64_sub(s4, z4)), f64_add(q4, z4)), f64_sub(ep4, eq4)));
    if ((c4 & 0x7FFF_FFFF_FFFF_FFFF) > cm) { cm = c4 & 0x7FFF_FFFF_FFFF_FFFF; }
    store64(r + 32, c4);
    var ep5 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h10, h02), p5), f64_mul(h10, l02)), f64_mul(l10, h02)),
      f64_mul(l10, l02));
    var eq5 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h00, h12), q5), f64_mul(h00, l12)), f64_mul(l00, h12)),
      f64_mul(l00, l12));
    var s5 = f64_sub(p5, q5); var z5 = f64_sub(s5, p5);
    var c5 = f64_add(s5, f64_add(f64_sub(f64_sub(p5, f64_sub(s5, z5)), f64_add(q5, z5)), f64_sub(ep5, eq5)));
    if ((c5 & 0x7FFF_FFFF_FFFF_FFFF) > cm) { cm = c5 & 0x7FFF_FFFF_FFFF_FFFF; }
    store64(r + 56, c5);
    var ep6 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h10, h21), p6), f64_mul(h10, l21)), f64_mul(l10, h21)),
      f64_mul(l10, l21));
    var eq6 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h20, h11), q6), f64_mul(h20, l11)), f64_mul(l20, h11)),
      f64_mul(l20, l11));
    var s6 = f64_sub(p6, q6); var z6 = f64_sub(s6, p6);
    var c6 = f64_add(s6, f64_add(f64_sub(f64_sub(p6, f64_sub(s6, z6)), f64_add(q6, z6)), f64_sub(ep6, eq6)));
    if ((c6 & 0x7FFF_FFFF_FFFF_FFFF) > cm) { cm = c6 & 0x7FFF_FFFF_FFFF_FFFF; }
    store64(r + 16, c6);
    var ep7 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h20, h01), p7), f64_mul(h20, l01)), f64_mul(l20, h01)),
      f64_mul(l20, l01));
    var eq7 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h00, h21), q7), f64_mul(h00, l21)), f64_mul(l00, h21)),
      f64_mul(l00, l21));
    var s7 = f64_sub(p7, q7); var z7 = f64_sub(s7, p7);
    var c7 = f64_add(s7, f64_add(f64_sub(f64_sub(p7, f64_sub(s7, z7)), f64_add(q7, z7)), f64_sub(ep7, eq7)));
    if ((c7 & 0x7FFF_FFFF_FFFF_FFFF) > cm) { cm = c7 & 0x7FFF_FFFF_FFFF_FFFF; }
    store64(r + 40, c7);
    var ep8 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h00, h11), p8), f64_mul(h00, l11)), f64_mul(l00, h11)),
      f64_mul(l00, l11));
    var eq8 = f64_add(f64_add(f64_add(f64_sub(f64_mul(h10, h01), q8), f64_mul(h10, l01)), f64_mul(l10, h01)),
      f64_mul(l10, l01));
    var s8 = f64_sub(p8, q8); var z8 = f64_sub(s8, p8);
    var c8 = f64_add(s8, f64_add(f64_sub(f64_sub(p8, f64_sub(s8, z8)), f64_add(q8, z8)), f64_sub(ep8, eq8)));
    if ((c8 & 0x7FFF_FFFF_FFFF_FFFF) > cm) { cm = c8 & 0x7FFF_FFFF_FFFF_FFFF; }
    store64(r + 64, c8);
    if (f64_le(g, f64_mul(cm, _M3_DDCERT)) == 0) { return 0; }
    if (sg < 0) {
        var i = 0;
        while (i < 9) { store64(r + i * 8, load64(r + i * 8) ^ 0x8000000000000000); i = i + 1; }
    }
    return 1;
}

# True where some product x y of two entries of m in the minors (different rows and columns),
# at or above 2^1023, has a product of `_m3_cof_comp`'s splits that overflows (the splits round up
# by up to 2^-26 of the entry). Every entry below 2^997 - 2^970 (the caller's test), so each
# split is finite.
fn _m3_cof_hhovf(m) {
    var r1 = 0;
    while (r1 < 2) {
        var r2 = r1 + 1;
        while (r2 < 3) {
            var c1 = 0;
            while (c1 < 3) {
                var x = load64(m + (r1 * 3 + c1) * 8);
                var c2 = 0;
                while (c2 < 3) {
                    if (c2 != c1) {
                        var y = load64(m + (r2 * 3 + c2) * 8);
                        if ((f64_mul(x, y) & 0x7FFF_FFFF_FFFF_FFFF) >= _M3_WPRD) {
                            var tx = f64_mul(x, _M3_SPLIT);
                            var ty = f64_mul(y, _M3_SPLIT);
                            var hh = f64_mul(f64_sub(tx, f64_sub(tx, x)), f64_sub(ty, f64_sub(ty, y)));
                            if ((hh & 0x7FFF_FFFF_FFFF_FFFF) >= 0x7FF0_0000_0000_0000) { return 1; }
                        }
                    }
                    c2 = c2 + 1;
                }
                c1 = c1 + 1;
            }
            r2 = r2 + 1;
        }
        r1 = r1 + 1;
    }
    return 0;
}

# `_m3_cof_comp`'s compensated tier where its own steps overflow (3.4.1 round-2 review S1): an
# entry at or above 2^997 - 2^970, whose split x (2^27 + 1) passes DBL_MAX, or a product within
# about 2^-25 of DBL_MAX whose splits' product does (`_m3_cof_hhovf`). The first 3.4.1 form made
# those minors non-finite and declined, so the exact path answered, at 50 to 94 times 3.4.0's
# time; an answer is therefore kept here only where every entry is PROVED the exact cofactor's
# nearest double, which is the exact path's answer bit for bit.
# Two scalings, each by exact powers of two (3.4.1 round-3 review S1): the uniform m 2^-28, and
# where that pass declines for range (returns 2) `_m3_cof_wequil`'s, which puts every group's and
# then every position's largest entry at exponent 508. The second is what lets m with a row at
# 2^1000 and another at 2^-430 through: under the uniform scaling alone a product of two entries
# fell below the error-term floor and the exact path answered, at 92 to 109 times 3.4.0's time.
# Where a pass declines any other way the other cannot help: the same arithmetic on the same
# numbers. Returns 1 when r holds the answer, 0 when the caller must take the exact path.
fn _m3_cof_wide(m, sg, r) {
    var kv: i64[10];
    var i = 0;
    while (i < 9) { store64(&kv + i * 8, 0 - 28); i = i + 1; }
    store64(&kv + 72, 0 - 84);
    var rc = _m3_cof_wpass(m, sg, r, &kv);
    if (rc != 2) { return rc; }
    _m3_cof_wequil(m, &kv);
    return _m3_cof_wpass(m, sg, r, &kv) & 1;
}

# kv[i] = g(i / 3) + h(i % 3), the exponents of m's equilibrating powers of two, and kv[9] their
# sum over the three groups and three positions: g(X) puts group X's largest entry at exponent
# `_M3_WT`, then h(Y) does the same for position Y of the scaled matrix (0 for an all-zero group
# or position). Every h is then at least 0 and every scaled entry below 2^(`_M3_WT` + 1).
fn _m3_cof_wequil(m, kv) {
    var e: i64[9];
    var g: i64[3];
    var k = 0;
    var i = 0;
    while (i < 3) {
        var top = _M3_WNONE;
        var j = 0;
        while (j < 3) {
            var b = load64(m + (i * 3 + j) * 8);
            var ex = _M3_WNONE;
            if ((b & 0x7FFF_FFFF_FFFF_FFFF) != 0) { ex = _m3_expo(b); }
            store64(&e + (i * 3 + j) * 8, ex);
            if (ex > top) { top = ex; }
            j = j + 1;
        }
        var gi = 0;
        if (top != _M3_WNONE) { gi = _M3_WT - top; }
        store64(&g + i * 8, gi);
        k = k + gi;
        i = i + 1;
    }
    var y = 0;
    while (y < 3) {
        var ty = _M3_WNONE;
        var x = 0;
        while (x < 3) {
            var v = load64(&e + (x * 3 + y) * 8);
            if (v != _M3_WNONE) {
                v = v + load64(&g + x * 8);
                if (v > ty) { ty = v; }
            }
            x = x + 1;
        }
        var hy = 0;
        if (ty != _M3_WNONE) { hy = _M3_WT - ty; }
        k = k + hy;
        x = 0;
        while (x < 3) {
            store64(kv + (x * 3 + y) * 8, load64(&g + x * 8) + hy);
            x = x + 1;
        }
        y = y + 1;
    }
    store64(kv + 72, k);
    return 0;
}

# x 2^k where a double holds it exactly, `_M3_WBAD` otherwise (x finite, k >= -515, so 2^(ne - 1)
# and 2^(1 - ne) below are normal). Never rounds: a result that lands below DBL_MIN is formed
# by one multiplication and read back.
fn _m3_wscale(x, k) {
    if ((x & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return x; }
    var b = x;
    var e = (x & 0x7FFF_FFFF_FFFF_FFFF) >> 52;
    if (e == 0) {
        b = f64_mul(x, _M3_TWO64);
        e = (b & 0x7FFF_FFFF_FFFF_FFFF) >> 52;
        k = k - 64;
    }
    var ne = e + k;
    if (ne >= 1) { return b + (k << 52); }
    var c = b + ((1 - e) << 52);
    var t = f64_mul(c, (1022 + ne) << 52);
    if (f64_mul(t, (1024 - ne) << 52) != c) { return _M3_WBAD; }
    return t;
}

# c 2^s rounded once (c finite, the result at most DBL_MAX). Below DBL_MIN the multiplication by
# 2^(ne - 1) is that one rounding; past 2^-64 the factor stays 2^-64, whose product with a value
# below 2^-1021 already rounds to a zero of c's sign.
fn _m3_wout(c, s) {
    if ((c & 0x7FFF_FFFF_FFFF_FFFF) == 0) { return c; }
    var b = c;
    var e = (c & 0x7FFF_FFFF_FFFF_FFFF) >> 52;
    if (e == 0) {
        b = f64_mul(c, _M3_TWO64);
        e = (b & 0x7FFF_FFFF_FFFF_FFFF) >> 52;
        s = s - 64;
    }
    var ne = e + s;
    if (ne >= 1) { return b + (s << 52); }
    var sh = ne - 1;
    if (sh < 0 - 64) { sh = 0 - 64; }
    return f64_mul(b + ((1 - e) << 52), (1023 + sh) << 52);
}

# One pass of `_m3_cof_wide`: t, each entry of m scaled by its own kv[i] (i in memory order), so
# that t's cofactor at slot i is m's times 2^(kv[9] - kv[i]) (cof(D1 m D2) is cof(m) with each
# entry scaled by the other two groups' and positions' powers). kv[i] is g(X) + h(Y) with sum
# kv[9], and t's entries are below 2^509 (`_m3_cof_wequil`) or 2^996 (the uniform 2^-28): neither
# a split nor a product of splits can overflow. It returns 2 (the range declined it) where t is
# not m's scaling exactly, or where a product of two non-zero entries of t falls below 2^-969,
# whose error term can lose bits (Dekker's product is exact when the exponents sum to -970 or
# more); otherwise every error term is exact and the exact minor is c = s + es + ep - eq, a
# multiple of 2^-1074, so a c below 2^-1021 is exact in a double. With w = ep - eq and u = es + w
# rounded, c = s + u + e where e, the two roundings' error, is at most 2^-53 (|u| + |w|) (each is
# 0 where its result is below 2^-1021: such a sum is exact). With d = 2^-51 (|u| + |w|), rounded,
# u + d and u - d rounded still bracket u + e; so where s + (u + d) and s + (u - d) both round to
# c~ = s + u rounded, every value between them does (rounding is monotone), c included: c~ is c
# rounded to 53 bits. Then the answer is c~ 2^(kv[i] - kv[9]) rounded once (`_m3_wout`), with sg
# applied, and it is the exact path's bits in every entry: that path rounds each cofactor to 53
# bits and then once more into range. c~ is never -0 (its last sum is -0 only from two -0, and
# Dekker's error of a product never is: hh - p is +0 where both are zeros of one sign). The exact
# path's own scaling cannot apply. It scales where the largest cofactor passes 2^1023, but the
# caller is past G > 8 mx, so every plain minor is below 2^1021 and every c within 2^-52 G of its
# plain minor. And it scales where the largest is below 2^-969, but m holds a large entry (at
# or above 2^997 - 2^970, or the larger factor, at least 2^511, of a product at or above 2^1023),
# and each of the four minors holding it is a multiple of its grid (at least 2^459) times 2^-1074:
# 0 or at least 2^-615; and where all four are 0 the matrix has rank 1, every cofactor 0.
# It returns 0 where the bracket fails.
fn _m3_cof_wpass(m, sg, r, kv) {
    var x00 = _m3_wscale(load64(m + 0), load64(kv + 0));
    if (x00 == _M3_WBAD) { return 2; }
    var x01 = _m3_wscale(load64(m + 8), load64(kv + 8));
    if (x01 == _M3_WBAD) { return 2; }
    var x02 = _m3_wscale(load64(m + 16), load64(kv + 16));
    if (x02 == _M3_WBAD) { return 2; }
    var x10 = _m3_wscale(load64(m + 24), load64(kv + 24));
    if (x10 == _M3_WBAD) { return 2; }
    var x11 = _m3_wscale(load64(m + 32), load64(kv + 32));
    if (x11 == _M3_WBAD) { return 2; }
    var x12 = _m3_wscale(load64(m + 40), load64(kv + 40));
    if (x12 == _M3_WBAD) { return 2; }
    var x20 = _m3_wscale(load64(m + 48), load64(kv + 48));
    if (x20 == _M3_WBAD) { return 2; }
    var x21 = _m3_wscale(load64(m + 56), load64(kv + 56));
    if (x21 == _M3_WBAD) { return 2; }
    var x22 = _m3_wscale(load64(m + 64), load64(kv + 64));
    if (x22 == _M3_WBAD) { return 2; }
    var t00 = f64_mul(x00, _M3_SPLIT); var h00 = f64_sub(t00, f64_sub(t00, x00)); var l00 = f64_sub(x00, h00);
    var t01 = f64_mul(x01, _M3_SPLIT); var h01 = f64_sub(t01, f64_sub(t01, x01)); var l01 = f64_sub(x01, h01);
    var t02 = f64_mul(x02, _M3_SPLIT); var h02 = f64_sub(t02, f64_sub(t02, x02)); var l02 = f64_sub(x02, h02);
    var t10 = f64_mul(x10, _M3_SPLIT); var h10 = f64_sub(t10, f64_sub(t10, x10)); var l10 = f64_sub(x10, h10);
    var t11 = f64_mul(x11, _M3_SPLIT); var h11 = f64_sub(t11, f64_sub(t11, x11)); var l11 = f64_sub(x11, h11);
    var t12 = f64_mul(x12, _M3_SPLIT); var h12 = f64_sub(t12, f64_sub(t12, x12)); var l12 = f64_sub(x12, h12);
    var t20 = f64_mul(x20, _M3_SPLIT); var h20 = f64_sub(t20, f64_sub(t20, x20)); var l20 = f64_sub(x20, h20);
    var t21 = f64_mul(x21, _M3_SPLIT); var h21 = f64_sub(t21, f64_sub(t21, x21)); var l21 = f64_sub(x21, h21);
    var t22 = f64_mul(x22, _M3_SPLIT); var h22 = f64_sub(t22, f64_sub(t22, x22)); var l22 = f64_sub(x22, h22);
    var ok = 1;
    var p0 = f64_mul(x11, x22); var q0 = f64_mul(x21, x12);
    if ((p0 & 0x7FFF_FFFF_FFFF_FFFF) < _M3_FLOOR && (x11 & 0x7FFF_FFFF_FFFF_FFFF) != 0

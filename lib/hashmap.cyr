# hashmap.cyr — hash table, choose-your-key-type at construction
# Usage: include "lib/hashmap.cyr"
# Includes its own definers: alloc.cyr, string.cyr, str.cyr, vec.cyr, fmt.cyr, fnptr.cyr, hashseed.cyr.
#
# Open addressing with linear probing. Three key-type surfaces
# coexist — pick at construction time:
#
#   var m = map_new();        # keys are cstr (NUL-terminated char*) — legacy
#   var m = map_new_str();    # keys are Str struct (data+len fat pointer)
#   var m = map_u64_new();    # keys are u64 inline (v5.5.20)
#
# All values are i64. Automatically grows at 70% load.
#
# >>> include "lib/string.cyr"
# >>> include "lib/alloc.cyr"
# >>> include "lib/vec.cyr"
# >>> include "lib/hashmap.cyr"
# >>> fn main() { alloc_init(); var m = map_new(); map_set(m, "x", 42); return map_get(m, "x"); }
# >>> var r = main(); syscall(60, r);
# === 42
#
# Layout — cstr / Str variants (key_type 0 / 1):
#   slot { key_ptr: i64, value: i64, state: i64 } = 24 bytes
#   state: 0=empty, 1=occupied, 2=tombstone
#
# Layout — u64 variant (key_type 2, added v5.5.20):
#   slot { key: u64, value: i64 } = 16 bytes
#   sentinels in key: 0=empty, 0xFFFFFFFFFFFFFFFF=tombstone
#   (removes the state field — saves 33% slot size + one load
#   per probe, which is the point of the u64 surface)
#
# Map header: { entries_ptr, capacity, count, key_type } = 32 bytes
#   key_type: 0 = cstr (hash via hash_str, compare via streq)
#             1 = Str  (hash via hash_str_v, compare via str_eq)
#             2 = u64  (hash via hash_u64, equality via ==, v5.5.20)
#
# Entries array: `capacity` slots, then ONE trailing word — the tombstone count (6.6.20).
#   It lives after the slots, not in the header, so the 32-byte header and every slot offset
#   stay exactly what consumers already read (map_entries/map_cap walks never reach it).
#
# The cstr/Str helpers (map_keys / map_values / map_iter / map_print)
# assume the 24-byte slot layout and do NOT work on u64 maps. The
# u64 surface stays minimal (new/set/get/has/delete/size/clear)
# per the v5.5.20 scope — all consumers today are cache hot-paths
# that don't need iteration.
#
# v5.4.14 added key_type to fix the Str-struct key collision bug
# surfaced by majra's soak test (hash_str was byte-walking a Str
# struct's raw bytes until NUL, producing address-derived hashes
# with ~3% entry loss). At v6.0.0 the map collapses to Str-only
# and this branching goes away (see docs/development/roadmap.md).
#
# v5.5.20 added u64 keys (mabda cache hot-path). Benchmark target:
# `shader_cache_hit` 553 → ≤ 50 ns (was 15× Rust). Implementation
# walks a separate `_map_u64_find` / `_map_u64_grow` pair because
# the slot size differs from cstr/Str (16 vs 24) and the state
# encoding moves into the key field.

include "lib/fnptr.cyr"
include "lib/hashseed.cyr"   # v6.5.39: per-process seed + finalizer (hash-flooding DoS)
# 6.6.9: the Str-keyed surface (str_*), memset/streq/strlen, map_keys (vec_*) and map_print
# (fmt_int) were all called, none included. CHANGELOG [6.6.9]
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/fmt.cyr"

# v5.8.26 — key_type symbolic constants. Replaces raw 0/1/2
# integer literals at the 6 read/write sites in this file.
# Stored at map header offset 24 (`m + 24`); auto-incremented
# tags 0/1/2 match the prior raw-int values exactly so all
# pre-migration call shapes keep working without churn.
enum KeyType {
    KeyTypeCstr;
    KeyTypeStr;
    KeyTypeU64;
}

# FNV-1a hash for null-terminated string (cstr keys).
fn hash_str(s): i64 {
    if (s == 0) { return 0; }
    # v6.5.39: seeded basis + finalizer — see lib/hashseed.cyr for why both are needed.
    var h = 0xCBF29CE484222325 ^ _hm_seed_get();
    var hi = 0;
    while (load8(s + hi) != 0) {
        h = h ^ load8(s + hi);
        h = h * 0x100000001B3;
        hi = hi + 1;
    }
    return _hm_mix(h);
}

# FNV-1a hash for Str struct (fat pointer keys).
# Walks str_data for str_len bytes — content-derived, not address-derived.
# Added v5.4.14 as part of the majra-surfaced Str-key map fix.
fn hash_str_v(s): i64 {
    if (s == 0) { return 0; }
    var data = str_data(s);
    var len = str_len(s);
    var h = 0xCBF29CE484222325 ^ _hm_seed_get();   # v6.5.39
    var hi = 0;
    while (hi < len) {
        h = h ^ load8(data + hi);
        h = h * 0x100000001B3;
        hi = hi + 1;
    }
    return _hm_mix(h);
}

# Internal: pick hash based on map's key_type.
fn _map_hash(m, key): i64 {
    if (load64(m + 24) == KeyTypeStr) { return hash_str_v(key); }
    return hash_str(key);
}

# Internal: pick equality based on map's key_type.
fn _map_key_eq(m, a, b): i64 {
    if (load64(m + 24) == KeyTypeStr) { return str_eq(a, b); }
    return streq(a, b);
}

# v5.8.35 — Allocator-as-first-arg variant of map_new. Allocates
# the 32-byte map header + initial 16-slot entries array via `a`.
# Returns 0 on OOM. Pair with map_set_a / _map_grow_a (called
# transitively) to keep the same allocator threaded through grows.
fn map_new_a(a): i64 {
    var m = alloc_via(a, 32);
    if (m == 0) { return 0; }
    var cap = 16;
    var entries = alloc_via(a, cap * 24 + 8);   # + the tombstone-count word
    if (entries == 0) { return 0; }
    memset(entries, 0, cap * 24 + 8);
    store64(m, entries);
    store64(m + 8, cap);
    store64(m + 16, 0);
    store64(m + 24, KeyTypeCstr);
    return m;
}

# Create a new cstr-keyed hash map (initial capacity 16).
# Keys passed to map_set / map_get / etc. are char* (NUL-terminated).
# v5.8.35 wrapper — delegates to map_new_a with default_alloc().
fn map_new(): i64 {
    return map_new_a(default_alloc());
}

# Create a new Str-keyed hash map (initial capacity 16).
# Keys passed to map_set / map_get / etc. are Str struct pointers
# (from str_from / str_from_int / str_new / ...).
#
# v5.4.14. Use this for any map whose keys are built via
# `str_from_int(n)` or similar — the previous default map_new() with
# Str-typed keys silently loses ~3% of entries due to the hash_str
# byte-walk mishandling struct layouts.
# v5.8.35 — Allocator-as-first-arg variant of map_new_str.
# Same shape as map_new_a but with KeyTypeStr discriminant.
fn map_new_str_a(a): i64 {
    var m = alloc_via(a, 32);
    if (m == 0) { return 0; }
    var cap = 16;
    var entries = alloc_via(a, cap * 24 + 8);   # + the tombstone-count word
    if (entries == 0) { return 0; }
    memset(entries, 0, cap * 24 + 8);
    store64(m, entries);
    store64(m + 8, cap);
    store64(m + 16, 0);
    store64(m + 24, KeyTypeStr);
    return m;
}

# Create a new Str-keyed hash map (initial capacity 16). v5.8.35
# wrapper — delegates to map_new_str_a with default_alloc(). Use
# this for any map whose keys are built via str_from_int(n) or
# similar (the cstr-keyed map_new variant silently loses ~3% of
# entries due to hash_str byte-walk mishandling struct layouts).
fn map_new_str(): i64 {
    return map_new_str_a(default_alloc());
}

# Return pointer to the entries array
fn map_entries(m): i64 { return load64(m); }
# Return the current capacity
fn map_cap(m): i64 { return load64(m + 8); }
# Return the number of occupied entries
fn map_count(m): i64 { return load64(m + 16); }

# ⛔ TOMBSTONES COUNT TOWARD THE REBUILD (6.6.20). map_delete / map_u64_delete leave a tombstone
# and the trigger counted only LIVE entries, while _map_find / _map_u64_find stop only at an
# EMPTY slot. A map held at a steady size by delete+insert churn ran out of EMPTY slots after
# ~3x turnover of its live size, and from then on every miss and every new-key insert walked the
# whole table (measured: 2000 misses 76 us -> 58,544 us at 5000 live). Now each delete counts its
# tombstone in the word after the slots, and a NEW-key insert rebuilds when live + tombstones
# reach 70%: doubling only when live alone is past 35%, otherwise at the same capacity — which
# drops every tombstone without growing. What does NOT change, because consumers walk
# map_entries/map_cap and depend on it: a delete never moves an entry, and neither does an
# overwrite of a key already present (the rebuild check runs only once the key is known new).
# lib/hashmap_fast.cyr had the same tombstone defect and fixed it at 6.6.8.
# ⚠ THE SAME-CAPACITY REBUILD IS IN PLACE AND ALLOCATES NOTHING (_map_rebuild_in_place). The
# default allocator is a bump whose free is a no-op, so a rebuild into a fresh array leaked the
# old one on every rebuild — ~27 B per churned key, without bound (27.5 MB over 1M rounds at
# 5000 live) — and made a steady-size insert fallible where it had needed no memory at all.
# Only doubling allocates, and a map that has reached its steady size never doubles again
# (the one exception is a table with no EMPTY slot at all — see _map_rebuild_in_place).
# lib/hashmap_fast.cyr's same-capacity rebuild is in place too (_fhm_rebuild_in_place, a group
# walk of the same shape — CHANGELOG [6.7.3]). CHANGELOG [6.6.20]
fn _map_tombp(m): i64 { return load64(m) + load64(m + 8) * 24; }
fn _map_u64_tombp(m): i64 { return load64(m) + load64(m + 8) * 16; }

# The tombstone count, for either slot layout.
fn _map_tomb_count(m): i64 {
    if (load64(m + 24) == KeyTypeU64) { return load64(_map_u64_tombp(m)); }
    return load64(_map_tombp(m));
}

# One tombstone was reused. ⚠ CLAMPED at 0: a consumer may tombstone a slot by hand without
# counting it (majra relay.cyr writes state 2 + live-1 directly); reusing that slot must not
# drive the count negative, or the trigger undercounts and the live load can reach the table.
fn _map_tomb_dec(tp): i64 {
    var t = load64(tp);
    if (t > 0) { store64(tp, t - 1); }
    return 0;
}

# 0 when the table has room for a new key; otherwise the capacity to rebuild it at.
# With no tombstones this is exactly the old trigger: double at 70% live.
fn _map_rebuild_cap(m, tombs): i64 {
    var live = load64(m + 16);
    var cap = load64(m + 8);
    if ((live + tombs) * 10 < cap * 7) { return 0; }
    if (live * 20 >= cap * 7) { return cap * 2; }
    return cap;
}

# Rebuilds done by any map in this process, in place or into a fresh array. Diagnostic only, not
# API: tests/tcyr/stdlib/hashmap_tombstones.tcyr reads it to bound the rebuild work churn costs
# (an in-place rebuild changes neither map_entries nor alloc_used). Unsynchronised: maps used on
# different threads can lose a count, never anything else.
var _map_rebuilds = 0;

# Same-capacity rebuild of a 24-byte-slot table, IN PLACE, allocating nothing. Returns 0 when
# done, 1 when there is no EMPTY slot to anchor the walk (the caller then rebuilds into a fresh
# array; only reachable when tombstones were written outside this API — majra relay.cyr).
#   1. s = a slot that was EMPTY before the rebuild. A probe chain never crosses an EMPTY slot,
#      so no live entry's chain crosses s.
#   2. Every tombstone becomes EMPTY.
#   3. Walk once from s+1 round to s-1. Each live entry moves to the first EMPTY slot on its
#      probe path from its home bucket, when that slot lies before it. Its home lies after s in
#      walk order (step 1), so that path covers only slots already walked, and a walked slot is
#      only ever filled afterwards, never emptied — so every entry stays reachable.
# Entries move only here, on the NEW-key insert path; deletes and overwrites never move one.
fn _map_rebuild_in_place(m): i64 {
    var entries = load64(m);
    var cap = load64(m + 8);
    var mask = cap - 1;
    var s = 0;
    while (s < cap) {
        if (load64(entries + s * 24 + 16) == 0) { break; }
        s = s + 1;
    }
    if (s == cap) { return 1; }
    var i = 0;
    while (i < cap) {
        var tp = entries + i * 24;
        if (load64(tp + 16) == 2) {
            store64(tp, 0);
            store64(tp + 8, 0);
            store64(tp + 16, 0);
        }
        i = i + 1;
    }
    var n = 1;
    while (n < cap) {
        var j = (s + n) & mask;
        var jp = entries + j * 24;
        if (load64(jp + 16) == 1) {
            var t = _map_hash(m, load64(jp)) & mask;
            while (t != j) {
                var dp = entries + t * 24;
                if (load64(dp + 16) == 0) {
                    store64(dp, load64(jp));
                    store64(dp + 8, load64(jp + 8));
                    store64(dp + 16, 1);
                    store64(jp, 0);
                    store64(jp + 8, 0);
                    store64(jp + 16, 0);
                    break;
                }
                t = (t + 1) & mask;
            }
        }
        n = n + 1;
    }
    store64(entries + cap * 24, 0);
    _map_rebuilds = _map_rebuilds + 1;
    return 0;
}

# Find slot for key. Returns entry pointer or 0.
# Hash + equality are dispatched through _map_hash / _map_key_eq so
# the same _map_find serves both cstr and Str key-type maps.
fn _map_find(m, key): i64 {
    var entries = load64(m);
    var cap = load64(m + 8);
    var idx = _map_hash(m, key) & (cap - 1);
    var probes = 0;
    var first_tomb = 0;
    while (probes < cap) {
        var ep = entries + idx * 24;
        var st = load64(ep + 16);
        if (st == 0) {
            if (first_tomb != 0) { return first_tomb; }
            return ep;
        }
        elif (st == 2) {
            if (first_tomb == 0) { first_tomb = ep; }
        }
        elif (_map_key_eq(m, load64(ep), key) == 1) { return ep; }
        idx = (idx + 1) & (cap - 1);
        probes = probes + 1;
    }
    if (first_tomb != 0) { return first_tomb; }
    return 0;
}

# Lookup occupied entry. Returns entry pointer or 0.
fn _map_lookup(m, key): i64 {
    var ep = _map_find(m, key);
    if (ep == 0) { return 0; }
    if (load64(ep + 16) != 1) { return 0; }
    return ep;
}

# Maximum map capacity (2^26 = ~67M entries, 1.5GB data)
var MAP_CAP_MAX = 0x4000000;

# v5.8.35 — Allocator-as-first-arg internal grow. Returns 0 on
# success, -1 on grow OOM (the back-compat _map_grow aborts the
# process; map_set_a propagates the -1 to its caller).
# v6.0.56: target-aware fatal exit (agnos exit = syscall(0), not Linux's
# syscall(60) which is out of agnos's 0-33 range). Kept raw — hashmap.cyr is
# syscalls.cyr-free.
fn _hm_die(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    syscall(0, 1);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # the vec_die recursion bug (v6.1.34): exit(1) — backend translates 60 per target. v6.0.56
    # regressed this to `_hm_die()` (infinite self-recursion → SIGSEGV instead
    # of a clean abort).
    syscall(60, 1);
    #endif
    return 0;
}

fn _map_grow_a(a, m): i64 {
    return _map_rehash_a(a, m, load64(m + 8) * 2);
}

# Rebuild the table into a fresh `new_cap`-slot array from its live entries only, which drops
# every tombstone (the fresh array's count word is zero). Allocates before touching the map, so a
# refused allocation returns -1 with the map unchanged. Used to double, and at the same capacity
# only when _map_rebuild_in_place finds no EMPTY slot. 6.6.20: split out of _map_grow_a.
fn _map_rehash_a(a, m, new_cap): i64 {
    var old_entries = load64(m);
    var old_cap = load64(m + 8);
    if (new_cap > MAP_CAP_MAX) {
        syscall(1, 2, "map: capacity overflow\n", 23);
        _hm_die();
    }
    var new_entries = alloc_via(a, new_cap * 24 + 8);
    if (new_entries == 0) { return 0 - 1; }
    memset(new_entries, 0, new_cap * 24 + 8);
    store64(m, new_entries);
    store64(m + 8, new_cap);
    store64(m + 16, 0);
    _map_rebuilds = _map_rebuilds + 1;
    var gi = 0;
    while (gi < old_cap) {
        var oep = old_entries + gi * 24;
        if (load64(oep + 16) == 1) {
            map_set_a(a, m, load64(oep), load64(oep + 8));
        }
        gi = gi + 1;
    }
    return 0;
}

# Grow the map (double capacity, rehash). v5.8.35 wrapper —
# aborts on OOM (matching pre-v5.8.35 behavior).
fn _map_grow(m): i64 {
    var rc = _map_grow_a(default_alloc(), m);
    if (rc < 0) {
        syscall(1, 2, "map: alloc failed\n", 18);
        _hm_die();
    }
    return 0;
}

# v5.8.35 — Allocator-as-first-arg variant of map_set. Routes any
# grow through `a`. Returns 0 on success, -1 when a doubling's allocation
# is refused (caller must check; back-compat map_set aborts instead). A
# same-capacity rebuild allocates nothing, so it cannot fail (unless
# hand-written tombstones left no EMPTY slot — _map_rebuild_in_place).
fn map_set_a(a, m, key, value): i64 {
    var ep = _map_find(m, key);
    if (ep != 0) {
        if (load64(ep + 16) == 1) {
            # an overwrite: never rebuilds, so a walk that overwrites as it goes stays valid
            store64(ep, key);
            store64(ep + 8, value);
            return 0;
        }
    }
    var nc = _map_rebuild_cap(m, load64(_map_tombp(m)));
    if (nc != 0) {
        var rc = 1;
        if (nc == load64(m + 8)) { rc = _map_rebuild_in_place(m); }
        if (rc != 0) {
            if (_map_rehash_a(a, m, nc) < 0) { return 0 - 1; }
        }
        ep = _map_find(m, key);
    }
    if (ep == 0) { return 0 - 1; }
    if (load64(ep + 16) == 2) { _map_tomb_dec(_map_tombp(m)); }
    store64(ep, key);
    store64(ep + 8, value);
    store64(ep + 16, 1);
    store64(m + 16, load64(m + 16) + 1);
    return 0;
}

# Set key=value. Overwrites if key exists. v5.8.35 wrapper —
# aborts on grow OOM (matching pre-v5.8.35 behavior). New code
# should prefer map_set_a for graceful OOM handling.
fn map_set(m, key, value): i64 {
    var rc = map_set_a(default_alloc(), m, key, value);
    if (rc < 0) {
        syscall(1, 2, "map: alloc failed\n", 18);
        _hm_die();
    }
    return 0;
}

# Get value for key. Returns value or 0 if not found.
fn map_get(m, key): i64 {
    var ep = _map_lookup(m, key);
    if (ep == 0) { return 0; }
    return load64(ep + 8);
}

# Get value for key with default. Returns value or default_val if not found.
fn map_get_or(m, key, default_val): i64 {
    var ep = _map_lookup(m, key);
    if (ep == 0) { return default_val; }
    return load64(ep + 8);
}

# Alias for map_count
fn map_size(m): i64 { return load64(m + 16); }

# Check if key exists. Returns 1 or 0.
fn map_has(m, key): i64 {
    if (_map_lookup(m, key) != 0) { return 1; }
    return 0;
}

# Delete key. Returns 1 if found, 0 if not.
fn map_delete(m, key): i64 {
    var ep = _map_lookup(m, key);
    if (ep == 0) { return 0; }
    store64(ep + 16, 2);
    store64(m + 16, load64(m + 16) - 1);
    var tp = _map_tombp(m);
    store64(tp, load64(tp) + 1);
    return 1;
}

# Get all keys as a vec
fn map_keys(m): i64 {
    var result = vec_new();
    var entries = load64(m);
    var cap = load64(m + 8);
    var ki = 0;
    while (ki < cap) {
        var ep = entries + ki * 24;
        if (load64(ep + 16) == 1) { vec_push(result, load64(ep)); }
        ki = ki + 1;
    }
    return result;
}

# Get all values as a vec
fn map_values(m): i64 {
    var result = vec_new();
    var entries = load64(m);
    var cap = load64(m + 8);
    var vi = 0;
    while (vi < cap) {
        var ep = entries + vi * 24;
        if (load64(ep + 16) == 1) { vec_push(result, load64(ep + 8)); }
        vi = vi + 1;
    }
    return result;
}

# Clear all entries (reset to empty, keep capacity)
fn map_clear(m): i64 {
    memset(load64(m), 0, load64(m + 8) * 24 + 8);   # slots + the tombstone count
    store64(m + 16, 0);
    return 0;
}

# Iterate entries. Calls fn(key, value) for each occupied entry.
fn map_iter(m, fp): i64 {
    var entries = load64(m);
    var cap = load64(m + 8);
    var ii = 0;
    while (ii < cap) {
        var ep = entries + ii * 24;
        if (load64(ep + 16) == 1) { fncall2(fp, load64(ep), load64(ep + 8)); }
        ii = ii + 1;
    }
    return 0;
}

# ================================================================
# u64-keyed hash map (v5.5.20)
# ================================================================
# Motivated by mabda's shader/bind-group cache hot loops — 15-16×
# Rust on Criterion because every lookup boxed a decimal string
# for the Str-keyed map_get. u64 keys let consumers with pre-
# computed hashes (FNV/xxhash/identity) skip the boxing entirely
# and hit zero allocations on the hot path.
#
# Slot layout: { key: u64, value: i64 } = 16 bytes.
# Sentinel encoding uses the key field itself — no separate state
# slot, so loads + probes stay in-line:
#   key == MAP_U64_EMPTY (0)                    → empty slot
#   key == MAP_U64_TOMB  (0xFFFFFFFFFFFFFFFF)   → tombstone
#   otherwise                                    → occupied
#
# ⛔ CORRECTED v6.6.2 — this said "No real-world consumer hits this today" and that was FALSE;
# six do, and four had already written their own key-remap workarounds. It is also the shape
# CLAUDE.md calls out as an antipattern: a DEFECT written down as a rule for consumers to comply
# with. chakshu paid for it — it keys a per-process CPU baseline by pid with -1 meaning "no
# baseline". Linux has no pid 0 so it was invisible for releases; AGNOS has a pid 0 (`kmain`), the
# lookup returned 0 instead of -1, and the monitor rendered 59% CPU for an idle kernel thread.
# Nothing failed: a plausible number, in a column where numbers belong.
#
# ⭐ THE ROOT CAUSE IS THE IN-BAND ENCODING, NOT ONE MISSING GUARD. Slot state lives IN the key
# field, while every public path validated a slot with `load64(ep) != key`. When the caller's key
# IS a sentinel that comparison is a tautology and the occupancy check evaporates. Measured on
# 6.6.1 before the fix: `map_u64_has(m, 0)` = 1 on an EMPTY map; `map_u64_delete(m, 0)` returned
# 1, planted a tombstone in a virgin slot and drove the count to -1; and 2000 writes of key 0 to
# a one-entry map reported size 574 and grew without bound toward `_hm_die()`.
# All five public paths now consult `_map_u64_key_reserved` FIRST. Key 0 and key -1 remain
# unstorable — that part is a real design constraint — but the answers are now truthful.
# Consumers that need those keys still pre-shift (`k + 1`); the difference is that failing to is
# no longer silent. Pinned by tests/tcyr/stdlib/hashmap_u64_sentinel_keys.tcyr.
#
# Header layout shares the Str-keyed shape so `map_size` reads
# cleanly against either; `key_type` at offset 24 is set to 2 for
# u64 maps. The u64-specific API is NOT wired into `_map_hash` /
# `_map_key_eq` / `_map_find` — it runs through a dedicated
# `_map_u64_find` / `_map_u64_grow` pair below because the slot
# size (16 vs 24) and sentinel-encoded state preclude sharing.

# SplitMix64 — fast, bijective, passes BigCrush. Applied to the
# raw u64 key before masking to capacity-1. Without mixing, keys
# that happen to cluster in low bits (e.g. pointer addresses
# modulo page size) pile up in the same bucket and probe chains
# degenerate to linear scans.
fn hash_u64(k): i64 {
    # v6.5.39: splitmix64 is INVERTIBLE, so with published constants an attacker computes
    # preimages for any target bucket directly — no brute force at all. The seed removes that.
    var h = k ^ _hm_seed_get();
    h = h ^ (h >> 30);
    h = h * 0xBF58476D1CE4E5B9;
    h = h ^ (h >> 27);
    h = h * 0x94D049BB133111EB;
    h = h ^ (h >> 31);
    return h;
}

# Sentinel keys. Users must not store these directly — document in
# the header.
var MAP_U64_EMPTY = 0;
var MAP_U64_TOMB = 0xFFFFFFFFFFFFFFFF;

# Is this key one the slot encoding has taken for itself?
# ⚠ ONE predicate, consulted by every public path. Written as a helper rather than an inline
# comparison in five places precisely because the previous shape — the same check open-coded per
# function — is what let `map_u64_has` and `map_u64_delete` be missed while `get_or` was filed.
fn _map_u64_key_reserved(key): i64 {
    if (key == MAP_U64_EMPTY) { return 1; }
    if (key == MAP_U64_TOMB) { return 1; }
    return 0;
}

# v5.8.43 — Allocator-as-first-arg variant of map_u64_new.
# Allocates the 32-byte map header + initial 16-slot entries
# array (16 bytes per slot) via `a`. Returns 0 on OOM.
fn map_u64_new_a(a): i64 {
    var m = alloc_via(a, 32);
    if (m == 0) { return 0; }
    var cap = 16;
    var entries = alloc_via(a, cap * 16 + 8);   # + the tombstone-count word
    if (entries == 0) { return 0; }
    memset(entries, 0, cap * 16 + 8);
    store64(m, entries);
    store64(m + 8, cap);
    store64(m + 16, 0);
    store64(m + 24, KeyTypeU64);
    return m;
}

# Create a new u64-keyed hash map (initial capacity 16). v5.8.43
# wrapper — delegates to map_u64_new_a with default_alloc().
fn map_u64_new(): i64 {
    return map_u64_new_a(default_alloc());
}

# Find slot for key. Returns entry pointer (empty slot, tombstone
# with no earlier tombstone seen, or occupied-with-matching-key)
# or 0 if the probe chain went full-circle.
fn _map_u64_find(m, key): i64 {
    var entries = load64(m);
    var cap = load64(m + 8);
    var idx = hash_u64(key) & (cap - 1);
    var probes = 0;
    var first_tomb = 0;
    while (probes < cap) {
        var ep = entries + idx * 16;
        var k = load64(ep);
        if (k == MAP_U64_EMPTY) {
            if (first_tomb != 0) { return first_tomb; }
            return ep;
        }
        elif (k == MAP_U64_TOMB) {
            if (first_tomb == 0) { first_tomb = ep; }
        }
        elif (k == key) { return ep; }
        idx = (idx + 1) & (cap - 1);
        probes = probes + 1;
    }
    if (first_tomb != 0) { return first_tomb; }
    return 0;
}

# v5.8.43 — Allocator-as-first-arg internal grow. Returns 0 on
# success, -1 on grow OOM (vs back-compat _map_u64_grow which
# aborts).
fn _map_u64_grow_a(a, m): i64 {
    return _map_u64_rehash_a(a, m, load64(m + 8) * 2);
}

# Same-capacity rebuild of a u64 table, IN PLACE, allocating nothing — the 16-byte-slot twin of
# _map_rebuild_in_place (read its steps there). Returns 1 when there is no EMPTY slot.
fn _map_u64_rebuild_in_place(m): i64 {
    var entries = load64(m);
    var cap = load64(m + 8);
    var mask = cap - 1;
    var s = 0;
    while (s < cap) {
        if (load64(entries + s * 16) == MAP_U64_EMPTY) { break; }
        s = s + 1;
    }
    if (s == cap) { return 1; }
    var i = 0;
    while (i < cap) {
        var tp = entries + i * 16;
        if (load64(tp) == MAP_U64_TOMB) {
            store64(tp, MAP_U64_EMPTY);
            store64(tp + 8, 0);
        }
        i = i + 1;
    }
    var n = 1;
    while (n < cap) {
        var j = (s + n) & mask;
        var jp = entries + j * 16;
        var k = load64(jp);
        if (k != MAP_U64_EMPTY) {
            var t = hash_u64(k) & mask;
            while (t != j) {
                var dp = entries + t * 16;
                if (load64(dp) == MAP_U64_EMPTY) {
                    store64(dp, k);
                    store64(dp + 8, load64(jp + 8));
                    store64(jp, MAP_U64_EMPTY);
                    store64(jp + 8, 0);
                    break;
                }
                t = (t + 1) & mask;
            }
        }
        n = n + 1;
    }
    store64(entries + cap * 16, 0);
    _map_rebuilds = _map_rebuilds + 1;
    return 0;
}

# Rebuild into a fresh `new_cap`-slot array from the live entries only (drops every tombstone).
# Allocates first: a refused allocation returns -1 with the map unchanged. Used to double, and at
# the same capacity only when _map_u64_rebuild_in_place finds no EMPTY slot. 6.6.20 — see the
# tombstone note above _map_tombp.
fn _map_u64_rehash_a(a, m, new_cap): i64 {
    var old_entries = load64(m);
    var old_cap = load64(m + 8);
    if (new_cap > MAP_CAP_MAX) {
        syscall(1, 2, "map_u64: capacity overflow\n", 27);
        _hm_die();
    }
    var new_entries = alloc_via(a, new_cap * 16 + 8);
    if (new_entries == 0) { return 0 - 1; }
    memset(new_entries, 0, new_cap * 16 + 8);
    store64(m, new_entries);
    store64(m + 8, new_cap);
    store64(m + 16, 0);
    _map_rebuilds = _map_rebuilds + 1;
    var gi = 0;
    while (gi < old_cap) {
        var oep = old_entries + gi * 16;
        var ok = load64(oep);
        if (ok != MAP_U64_EMPTY) {
            if (ok != MAP_U64_TOMB) {
                map_u64_set_a(a, m, ok, load64(oep + 8));
            }
        }
        gi = gi + 1;
    }
    return 0;
}

# Grow backing store (double capacity, rehash). v5.8.43 wrapper —
# aborts on OOM (matching pre-v5.8.43 behavior).
fn _map_u64_grow(m): i64 {
    var rc = _map_u64_grow_a(default_alloc(), m);
    if (rc < 0) {
        syscall(1, 2, "map_u64: alloc failed\n", 22);
        _hm_die();
    }
    return 0;
}

# v5.8.43 — Allocator-as-first-arg variant of map_u64_set. Routes
# any grow through `a`. Returns 0 on success, -1 when a doubling's
# allocation is refused (caller must check). A same-capacity rebuild
# allocates nothing, so it cannot fail (unless hand-written tombstones
# left no EMPTY slot — _map_rebuild_in_place).
fn map_u64_set_a(a, m, key, value): i64 {
    # ⛔ REFUSE rather than pretend. Measured before the fix: 2000 writes of key 0 to a one-entry
    # map reported a size of 574 and kept growing — each write stored a key the encoding reads
    # back as "empty", so nothing was retrievable and the load factor climbed until `_hm_die()`.
    # ⚠ RETURNS -2, NOT -1, AND THAT IS LOAD-BEARING. -1 already means "probe chain full / grow
    # OOM", and tests/tcyr/memory/alloc_str_extras.tcyr asserts -1 from a loop that STARTS AT
    # KEY 0 — returning -1 here would make that existing test pass on its first iteration for
    # entirely the wrong reason. Callers testing `rc < 0` still see an error, as they should.
    if (_map_u64_key_reserved(key) == 1) { return 0 - 2; }
    var ep = _map_u64_find(m, key);
    if (ep != 0) {
        # the key is not a sentinel (refused above), so a match here is the live entry:
        # an overwrite, which never rebuilds
        if (load64(ep) == key) {
            store64(ep + 8, value);
            return 0;
        }
    }
    var nc = _map_rebuild_cap(m, load64(_map_u64_tombp(m)));
    if (nc != 0) {
        var rc = 1;
        if (nc == load64(m + 8)) { rc = _map_u64_rebuild_in_place(m); }
        if (rc != 0) {
            if (_map_u64_rehash_a(a, m, nc) < 0) { return 0 - 1; }
        }
        ep = _map_u64_find(m, key);
    }
    if (ep == 0) { return 0 - 1; }
    if (load64(ep) == MAP_U64_TOMB) { _map_tomb_dec(_map_u64_tombp(m)); }
    store64(ep, key);
    store64(ep + 8, value);
    store64(m + 16, load64(m + 16) + 1);
    return 0;
}

# Set key=value. Overwrites if key exists. Returns 0 on success,
# -1 if the probe chain was full (shouldn't happen — grow fires
# at 70% load before the chain saturates). v5.8.43 wrapper —
# aborts on grow OOM.
fn map_u64_set(m, key, value): i64 {
    var rc = map_u64_set_a(default_alloc(), m, key, value);
    if (rc < 0) { return rc; }
    return 0;
}

# Get value for key. Returns value or 0 if not found.
fn map_u64_get(m, key): i64 {
    # A reserved key can never have been stored, so "absent" is the only truthful answer.
    if (_map_u64_key_reserved(key) == 1) { return 0; }
    var ep = _map_u64_find(m, key);
    if (ep == 0) { return 0; }
    if (load64(ep) != key) { return 0; }
    return load64(ep + 8);
}

# Get value with default if key not found.
fn map_u64_get_or(m, key, default_val): i64 {
    # THE FILED DEFECT (chakshu, 2026-09-08): without this the `load64(ep) != key` guard below
    # is `0 != 0` for key 0, so the function fell through and returned the EMPTY slot's value —
    # 0 — instead of the caller's sentinel. The whole point of the third argument is to tell
    # absent from present, and for exactly the reserved keys it silently did not.
    if (_map_u64_key_reserved(key) == 1) { return default_val; }
    var ep = _map_u64_find(m, key);
    if (ep == 0) { return default_val; }
    if (load64(ep) != key) { return default_val; }
    return load64(ep + 8);
}

# Check if key exists. Returns 1 or 0.
fn map_u64_has(m, key): i64 {
    # ⚠ The filing called this one "accidentally correct". It is not: measured `map_u64_has(m, 0)`
    # = 1 on an EMPTY map, because the empty slot's key field IS 0 and matches the caller's.
    if (_map_u64_key_reserved(key) == 1) { return 0; }
    var ep = _map_u64_find(m, key);
    if (ep == 0) { return 0; }
    if (load64(ep) != key) { return 0; }
    return 1;
}

# Delete key. Returns 1 if found, 0 if not.
fn map_u64_delete(m, key): i64 {
    # ⛔ The worst of the five: measured `map_u64_delete(m, 0)` on an empty map returned 1,
    # wrote a TOMBSTONE into a slot that had never been occupied, and decremented the count to
    # -1 — corrupting both the probe chain and the size for every subsequent operation.
    # Guarded BEFORE _map_u64_find so no slot is touched.
    if (_map_u64_key_reserved(key) == 1) { return 0; }
    var ep = _map_u64_find(m, key);
    if (ep == 0) { return 0; }
    if (load64(ep) != key) { return 0; }
    store64(ep, MAP_U64_TOMB);
    store64(m + 16, load64(m + 16) - 1);
    var tp = _map_u64_tombp(m);
    store64(tp, load64(tp) + 1);
    return 1;
}

# Occupied-entry count.
fn map_u64_size(m): i64 { return load64(m + 16); }

# Reset to empty; keep capacity.
fn map_u64_clear(m): i64 {
    memset(load64(m), 0, load64(m + 8) * 16 + 8);   # slots + the tombstone count
    store64(m + 16, 0);
    return 0;
}

# Print map contents as {key: value, ...}.
# Key rendering branches on the map's key_type: cstr uses strlen,
# Str uses str_data + str_len.
fn map_print(m): i64 {
    var entries = load64(m);
    var cap = load64(m + 8);
    var is_str = load64(m + 24);
    syscall(1, 1, "{", 1);
    var first = 1;
    var pi = 0;
    while (pi < cap) {
        var ep = entries + pi * 24;
        if (load64(ep + 16) == 1) {
            if (first == 0) { syscall(1, 1, ", ", 2); }
            var pk = load64(ep);
            if (is_str == KeyTypeStr) {
                syscall(1, 1, str_data(pk), str_len(pk));
            } else {
                syscall(1, 1, pk, strlen(pk));
            }
            syscall(1, 1, ": ", 2);
            fmt_int(load64(ep + 8));
            first = 0;
        }
        pi = pi + 1;
    }
    syscall(1, 1, "}", 1);
    return 0;
}

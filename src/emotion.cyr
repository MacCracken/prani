# emotion.cyr -- creature emotion state machine (valence/arousal model).
# Ports 2.0.3:rust-old/src/emotion.rs: EmotionState (valence x arousal x
# smoothing) + EmotionOutput (the synthesis params derived from a state). Maps
# the 2D emotion space to a Vocalization + CallIntent + continuous modulation
# (vocal effort, pitch scale, breathiness delta).
#
# Requires (from the build/test unit, in order): error.cyr, vocalization.cyr
# (PRANI_VOC_* / PRANI_INTENT_* consts) + stdlib alloc/math. This file has no
# `include` lines.
#
# f32 -> f64 throughout. Non-integer literals -> module-top hex constants
# (IEEE-754 bit patterns, decimals in comments). Zone enums (ValenceZone,
# ArousalZone) were private Rust enums -> local integer var consts. serde
# RESTORED on PrEmotion + PrEmotionOut via #derive(Serialize) (i64 bit-pattern
# fields, lossless roundtrip). Display tests dropped (no Display in Cyrius).

# ================================================================
# Float constants (IEEE-754 hex bit patterns; decimals in comments).
# ================================================================
var PRE_NEG_1_0  = 0xbff0000000000000;   # -1.0  (valence clamp lo)
var PRE_1_0      = 0x3ff0000000000000;   #  1.0  (valence/arousal clamp hi; pitch base)
var PRE_0_0      = 0x0000000000000000;   #  0.0  (arousal clamp lo; neutral valence; no breath)
var PRE_0_95     = 0x3fee666666666666;   #  0.95 (smoothing clamp hi)
var PRE_0_2      = 0x3fc999999999999a;   #  0.2  (default arousal; effort base; breath lo thresh)
var PRE_0_1      = 0x3fb999999999999a;   #  0.1  (default smoothing)
var PRE_0_7      = 0x3fe6666666666666;   #  0.7  (arousal->effort gain)
var PRE_0_15     = 0x3fc3333333333333;   #  0.15 (valence->pitch gain)
var PRE_0_8      = 0x3fe999999999999a;   #  0.8  (breath hi thresh)
var PRE_0_75     = 0x3fe8000000000000;   #  0.75 (breath hi gain)
var PRE_0_5      = 0x3fe0000000000000;   #  0.5  (breath lo gain; zone bound +/-0.5)
var PRE_0_33     = 0x3fd51eb851eb851f;   #  0.33 (arousal Low<->Mid bound)
var PRE_0_66     = 0x3fe51eb851eb851f;   #  0.66 (arousal Mid<->High bound)
var PRE_NEG_0_2  = 0xbfc999999999999a;   # -0.2  (valence Negative<->Neutral bound)
var PRE_NEG_0_5  = 0xbfe0000000000000;   # -0.5  (screech vs bark bound)
var PRE_NEG_0_7  = 0xbfe6666666666666;   # -0.7  (distress vs alarm bound)

# ================================================================
# ValenceZone / ArousalZone -- private Rust enums used only inside the
# select_* match arms. Discriminant == declaration order (0-based).
# ================================================================
var PRE_VZ_NEGATIVE = 0;
var PRE_VZ_NEUTRAL  = 1;
var PRE_VZ_POSITIVE = 2;

var PRE_AZ_LOW  = 0;
var PRE_AZ_MID  = 1;
var PRE_AZ_HIGH = 2;

# ================================================================
# EmotionState -- a creature's emotional state in valence/arousal space.
#   valence   : -1.0 (aversive) .. +1.0 (appetitive)
#   arousal   :  0.0 (calm)     .. 1.0 (excited)
#   smoothing : transition smoothing factor (0.0 instant .. 0.95 sluggish)
# Distinct struct name (PrEmotion) so accessors don't collide with svara/naad.
# ================================================================
# Fields TYPED i64 for #derive(Serialize): each f64 is stored as an i64 bit
# pattern, serialized as an int → the exact 64-bit value roundtrips (lossless).
# Typing them f64 would use the derive's 6-decimal float writer (lossy). Auto-
# generates PrEmotion_to_json / _from_json_str, restoring the Rust
# `#[derive(Serialize, Deserialize)]` on EmotionState.
#derive(accessors)
#derive(Serialize)
struct PrEmotion {
    valence: i64;
    arousal: i64;
    smoothing: i64;
}

# new() -- neutral point (idle, calm): valence 0.0, arousal 0.2, smoothing 0.1.
# Also serves as Default (impl Default -> Self::new()).
#must_use
fn emotion_new() {
    var self = alloc(sizeof(PrEmotion));
    PrEmotion_set_valence(self, PRE_0_0);
    PrEmotion_set_arousal(self, PRE_0_2);
    PrEmotion_set_smoothing(self, PRE_0_1);
    return self;
}

# with_values(valence, arousal) -- specific initial values, clamped; smoothing 0.1.
#must_use
fn emotion_with_values(valence, arousal) {
    var self = alloc(sizeof(PrEmotion));
    PrEmotion_set_valence(self, f64_clamp(valence, PRE_NEG_1_0, PRE_1_0));
    PrEmotion_set_arousal(self, f64_clamp(arousal, PRE_0_0, PRE_1_0));
    PrEmotion_set_smoothing(self, PRE_0_1);
    return self;
}

# with_smoothing(self, smoothing) -- sets smoothing clamped to [0.0, 0.95].
# Rust consumed+returned self (builder); the Cyrius port mutates in place and
# returns the same handle.
#must_use
fn emotion_with_smoothing(self, smoothing) {
    PrEmotion_set_smoothing(self, f64_clamp(smoothing, PRE_0_0, PRE_0_95));
    return self;
}

# valence(self) -- current valence.
#must_use
fn emotion_valence(self) {
    return PrEmotion_valence(self);
}

# arousal(self) -- current arousal.
#must_use
fn emotion_arousal(self) {
    return PrEmotion_arousal(self);
}

# update(self, target_valence, target_arousal) -- exponential decay toward the
# clamped target at rate `smoothing`. Call once per frame/tick.
#   valence = valence*s + tv*(1-s);  arousal = arousal*s + ta*(1-s)
fn emotion_update(self, target_valence, target_arousal) {
    var tv = f64_clamp(target_valence, PRE_NEG_1_0, PRE_1_0);
    var ta = f64_clamp(target_arousal, PRE_0_0, PRE_1_0);
    var s = PrEmotion_smoothing(self);
    var one_minus_s = f64_sub(PRE_1_0, s);
    PrEmotion_set_valence(self, f64_add(f64_mul(PrEmotion_valence(self), s), f64_mul(tv, one_minus_s)));
    PrEmotion_set_arousal(self, f64_add(f64_mul(PrEmotion_arousal(self), s), f64_mul(ta, one_minus_s)));
}

# set(self, valence, arousal) -- direct (no smoothing), clamped.
fn emotion_set(self, valence, arousal) {
    PrEmotion_set_valence(self, f64_clamp(valence, PRE_NEG_1_0, PRE_1_0));
    PrEmotion_set_arousal(self, f64_clamp(arousal, PRE_0_0, PRE_1_0));
}

# ================================================================
# Input-range guards (2.0.5; audit finding F11).
#
# Every setter in this module clamps, and f64_clamp(NaN, lo, hi) -> NaN
# (measured, pinned in tests/error.tcyr), so a NaN valence/arousal/smoothing
# passes every clamp here and is STORED. Nothing downstream notices: the zone
# classifiers below compare NaN against their bounds, both comparisons are
# false, and the state silently reads as Neutral/Mid while evaluate() hands a
# NaN vocal_effort, pitch_scale and breathiness_delta to whatever drives
# synthesis. That is a fabricated plausible answer -- exactly what ADR-0001
# rejected -- with no way for the caller to tell.
#
# with_values / with_smoothing / set / update return the struct or nothing, so
# they have no error channel and are left alone (the constructor contract is
# roadmap 2.1.0). The guard therefore sits at the point of USE: every function
# here that already returns "value or negative code" -- the two zone
# classifiers, the two selectors, evaluate -- checks the state before deriving
# anything from it. That covers every way a bad value can arrive (a clamped
# NaN, a raw PrEmotion_set_*, a PrEmotion_from_json_str document) with no
# signature change.
#
# Ranges, as documented on PrEmotion above and already enforced by its clamps:
#   valence    [-1.0, 1.0 ]   PRE_NEG_1_0 .. PRE_1_0
#   arousal    [ 0.0, 1.0 ]   PRE_0_0     .. PRE_1_0
#   smoothing  [ 0.0, 0.95]   PRE_0_0     .. PRE_0_95
# These are the module's own clamp bounds, not new numbers, and the test is
# EXACT (no tolerance) because nothing this module produces can land outside
# them: update() is a convex blend of two in-range values, and 748800 update
# steps -- smoothing k/64 for k = 0..64, a 9x5 grid of start states, all four
# target corners, 64 steps each -- never left [-1,1] x [0,1], landing exactly on
# +/-1.0, 0.0 and 1.0 at the extremes (measured 2026-08-31, pinned in
# tests/emotion.tcyr). Out-of-range values reach a PrEmotion only through
# PrEmotion_from_json_str (derive-generated, so unguardable from here) or a raw
# PrEmotion_set_* -- i.e. only from a document prani did not write.
#
# All five sites report PRANI_ERR_INVALID_VOCALIZATION: everything this module
# produces is a Vocalization, a CallIntent, or their modulation, and the
# oracle's PraniError::InvalidVocalization is "a vocalization parameter is
# invalid".
#
# DIVERGENCE from the oracle: EmotionState::evaluate() returns EmotionOutput,
# not Result, and the oracle stores a NaN just as happily (Rust's f32::clamp
# propagates NaN) while serde's derived Deserialize accepts any float for any
# field. Rejecting is deliberate, and the same call the port already made in
# ADR-0001 for crtract_new: report the failure, never fabricate an answer.
#
# ---- CHECKED / UNCHECKED SPLIT (2.0.10) ----
# As first written, every one of the five public entry points validated for
# itself -- and because evaluate reaches both zone classifiers through BOTH
# selectors, one evaluate() ran prani_in_range FIVE times, range-checking the
# same valence and the same arousal four times over. Measured cost: 69 ns ->
# 154 ns, a 2.2x regression on a per-frame game-AI path (docs/benchmarks.md).
#
# So each classifier and each selector is now split in two:
#
#   emotion_<name>            public, checked   -- validates, then delegates
#   emotion_<name>_unchecked  internal, no check -- classification only
#
# The public wrappers are unchanged in behaviour: they still reject exactly what
# they rejected before, with the same code. Only the INTERNAL path skips the
# re-check, and it is entered solely by a caller that has already validated the
# very fields it reads -- evaluate validates all three up front, then calls the
# unchecked selectors; each unchecked selector calls the unchecked classifiers.
# That is the same shape 2.0.3 used for species_params / species_params_into:
# one copy of the logic, an allocating/validating wrapper over it.
#
# The invariant that keeps this honest: an `_unchecked` function must never be
# reachable from outside this module, and every internal call to one must sit
# below a validation of the fields it reads. There are exactly three such call
# sites, all in this file -- evaluate -> the two unchecked selectors, and each
# unchecked selector -> the two unchecked classifiers.
# ================================================================

# emotion_state_in_range(self) -- 1 iff valence AND arousal are both inside
# their documented ranges, 0 otherwise. The precondition of the `_unchecked`
# classifiers, in one place, so the two checked selectors and evaluate cannot
# drift apart on what "validated" means. Does NOT cover smoothing: nothing that
# reads a zone reads smoothing, and evaluate checks it separately for its own
# stated reason (see below).
#must_use
fn emotion_state_in_range(self) {
    if (prani_in_range(PrEmotion_valence(self), PRE_NEG_1_0, PRE_1_0) == 0) { return 0; }
    return prani_in_range(PrEmotion_arousal(self), PRE_0_0, PRE_1_0);
}

# valence_zone_unchecked(self) -- the classification alone, verbatim from the
# Rust match arms. INTERNAL: the caller must have established that valence is in
# [-1.0, 1.0] (emotion_state_in_range). Never returns an error code, so callers
# do not test one. On an unvalidated NaN this would answer Neutral -- which is
# precisely the fabricated answer the guards exist to prevent, hence the
# precondition.
#must_use
fn emotion_valence_zone_unchecked(self) {
    var v = PrEmotion_valence(self);
    if (f64_lt(v, PRE_NEG_0_2)) { return PRE_VZ_NEGATIVE; }
    if (f64_gt(v, PRE_0_2))     { return PRE_VZ_POSITIVE; }
    return PRE_VZ_NEUTRAL;
}

# valence_zone(self) -- Negative if valence < -0.2, Positive if > 0.2, else Neutral.
# PRANI_ERR_INVALID_VOCALIZATION if valence is not in [-1.0, 1.0] (NaN included).
# Public checked wrapper over emotion_valence_zone_unchecked.
#must_use
fn emotion_valence_zone(self) {
    if (prani_in_range(PrEmotion_valence(self), PRE_NEG_1_0, PRE_1_0) == 0) {
        return PRANI_ERR_INVALID_VOCALIZATION;
    }
    return emotion_valence_zone_unchecked(self);
}

# arousal_zone_unchecked(self) -- the classification alone. INTERNAL: the caller
# must have established that arousal is in [0.0, 1.0] (emotion_state_in_range).
# Never returns an error code.
#must_use
fn emotion_arousal_zone_unchecked(self) {
    var a = PrEmotion_arousal(self);
    if (f64_lt(a, PRE_0_33)) { return PRE_AZ_LOW; }
    if (f64_gt(a, PRE_0_66)) { return PRE_AZ_HIGH; }
    return PRE_AZ_MID;
}

# arousal_zone(self) -- Low if arousal < 0.33, High if > 0.66, else Mid.
# PRANI_ERR_INVALID_VOCALIZATION if arousal is not in [0.0, 1.0] (NaN included).
# Public checked wrapper over emotion_arousal_zone_unchecked.
#must_use
fn emotion_arousal_zone(self) {
    if (prani_in_range(PrEmotion_arousal(self), PRE_0_0, PRE_1_0) == 0) {
        return PRANI_ERR_INVALID_VOCALIZATION;
    }
    return emotion_arousal_zone_unchecked(self);
}

# select_vocalization_unchecked(self) -- the match arms alone, verbatim from the
# Rust. INTERNAL: the caller must have established emotion_state_in_range(self)
# == 1. Never returns an error code, so callers do not test one.
#must_use
fn emotion_select_vocalization_unchecked(self) {
    var vz = emotion_valence_zone_unchecked(self);
    var az = emotion_arousal_zone_unchecked(self);
    var v = PrEmotion_valence(self);

    # High arousal, negative valence -> alarm/threat sounds
    if (vz == PRE_VZ_NEGATIVE) {
        if (az == PRE_AZ_HIGH) {
            if (f64_lt(v, PRE_NEG_0_5)) { return PRANI_VOC_SCREECH; }
            return PRANI_VOC_BARK;
        }
        # Low arousal, negative -> sullen; Mid arousal, negative -> threat
        return PRANI_VOC_GROWL;
    }
    if (vz == PRE_VZ_POSITIVE) {
        # High arousal, positive valence -> excited sounds
        if (az == PRE_AZ_HIGH) {
            if (f64_gt(v, PRE_0_5)) { return PRANI_VOC_TRILL; }
            return PRANI_VOC_CHIRP;
        }
        # Low arousal, positive -> content
        if (az == PRE_AZ_LOW) { return PRANI_VOC_PURR; }
        # Mid arousal, positive -> social
        return PRANI_VOC_HOWL;
    }
    # Neutral valence
    if (az == PRE_AZ_HIGH) { return PRANI_VOC_BARK; }    # high arousal, neutral -> alert
    if (az == PRE_AZ_LOW)  { return PRANI_VOC_RUMBLE; }  # low arousal, neutral -> idle rumble
    return PRANI_VOC_WHINE;                              # mid arousal, neutral -> idle
}

# select_vocalization(self) -- most appropriate Vocalization for the current
# (valence_zone, arousal_zone).
# PRANI_ERR_INVALID_VOCALIZATION if valence or arousal is out of range. Public
# checked wrapper: it validates both fields ONCE and then runs the unchecked
# match arms, instead of reaching them through two checked zone calls. Same
# inputs rejected, same code, one range check per field instead of one per read.
#must_use
fn emotion_select_vocalization(self) {
    if (emotion_state_in_range(self) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    return emotion_select_vocalization_unchecked(self);
}

# select_intent_unchecked(self) -- the match arms alone, verbatim from the Rust.
# INTERNAL: same precondition as select_vocalization_unchecked above. Never
# returns an error code.
#must_use
fn emotion_select_intent_unchecked(self) {
    var vz = emotion_valence_zone_unchecked(self);
    var az = emotion_arousal_zone_unchecked(self);
    var v = PrEmotion_valence(self);

    if (vz == PRE_VZ_NEGATIVE) {
        if (az == PRE_AZ_HIGH) {
            if (f64_lt(v, PRE_NEG_0_7)) { return PRANI_INTENT_DISTRESS; }
            return PRANI_INTENT_ALARM;
        }
        # Low arousal, negative -> Threat; Mid arousal, negative -> Threat
        return PRANI_INTENT_THREAT;
    }
    if (vz == PRE_VZ_POSITIVE) {
        if (az == PRE_AZ_HIGH) { return PRANI_INTENT_MATING; }  # high, positive -> Mating
        if (az == PRE_AZ_LOW)  { return PRANI_INTENT_IDLE; }    # low, positive -> Idle
        return PRANI_INTENT_SOCIAL;                             # mid, positive -> Social
    }
    # Neutral valence
    if (az == PRE_AZ_HIGH) { return PRANI_INTENT_ALARM; }  # high, neutral -> Alarm
    if (az == PRE_AZ_LOW)  { return PRANI_INTENT_IDLE; }   # low, neutral -> Idle
    return PRANI_INTENT_SOCIAL;                            # mid, neutral -> Social
}

# select_intent(self) -- CallIntent for the current (valence_zone, arousal_zone).
# PRANI_ERR_INVALID_VOCALIZATION if valence or arousal is out of range. Public
# checked wrapper, same shape as select_vocalization above.
#must_use
fn emotion_select_intent(self) {
    if (emotion_state_in_range(self) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    return emotion_select_intent_unchecked(self);
}

# ================================================================
# EmotionOutput -- synthesis params derived from an EmotionState.
#   vocalization      : suggested Vocalization (PRANI_VOC_* code)
#   intent            : behavioral CallIntent (PRANI_INTENT_* code)
#   vocal_effort      : 0.0-1.0, from arousal
#   pitch_scale       : pitch multiplier, from valence
#   breathiness_delta : additive breathiness, from arousal extremes
# Distinct struct name (PrEmotionOut) to avoid accessor collisions.
# ================================================================
# Fields TYPED for #derive(Serialize): vocalization/intent are enum-const codes
# (i64), the three modulation params are f64. Untyped fields would serialize as
# raw bit patterns and fail to roundtrip. Auto-generates PrEmotionOut_to_json /
# PrEmotionOut_from_json_str, restoring the Rust `#[derive(Serialize,
# Deserialize)]` on EmotionOutput.
#derive(accessors)
#derive(Serialize)
struct PrEmotionOut {
    vocalization: i64;
    intent: i64;
    vocal_effort: i64;
    pitch_scale: i64;
    breathiness_delta: i64;
}

# evaluate(self) -- core mapping from the 2D emotion space to concrete
# vocalization choices and parameter values. Returns a fresh PrEmotionOut, or
# PRANI_ERR_INVALID_VOCALIZATION if the state is out of contract.
#
# This is the module's outermost entry point -- the one a PrEmotion that came
# from PrEmotion_from_json_str reaches -- so it checks all THREE fields, not
# just the two it reads. smoothing does not affect the output, but a smoothing
# outside [0.0, 0.95] cannot have come from with_smoothing (which clamps), only
# from a foreign document, and it turns update() from a convex blend into a
# divergence (s = 3.0 gives v' = 3v - 2*tv): the state is then guaranteed to
# leave contract on the next tick. Reporting it at the one checkable point
# beats letting it surface a tick later as an out-of-range valence.
#
# Validation happens BEFORE the allocation: a rejected state costs no arena.
#
# It also happens ONCE (2.0.10). This is the entry point, so it validates all
# three fields here and then takes the `_unchecked` path -- the two selectors
# read only valence and arousal, both of which emotion_state_in_range has just
# established, so re-checking them inside each selector and again inside each
# zone call was four redundant range checks per call and a measured 2.2x
# regression. The unchecked selectors cannot return an error code, so there is
# nothing to propagate and no prani_is_err test on their results.
#must_use
fn emotion_evaluate(self) {
    if (prani_in_range(PrEmotion_smoothing(self), PRE_0_0, PRE_0_95) == 0) {
        return PRANI_ERR_INVALID_VOCALIZATION;
    }
    if (emotion_state_in_range(self) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var voc = emotion_select_vocalization_unchecked(self);
    var intent = emotion_select_intent_unchecked(self);

    var out = alloc(sizeof(PrEmotionOut));
    PrEmotionOut_set_vocalization(out, voc);
    PrEmotionOut_set_intent(out, intent);

    var arousal = PrEmotion_arousal(self);
    var valence = PrEmotion_valence(self);

    # Vocal effort driven primarily by arousal: 0.2 + arousal*0.7
    PrEmotionOut_set_vocal_effort(out, f64_add(PRE_0_2, f64_mul(arousal, PRE_0_7)));

    # Pitch scale from valence: 1.0 + valence*0.15
    PrEmotionOut_set_pitch_scale(out, f64_add(PRE_1_0, f64_mul(valence, PRE_0_15)));

    # Breathiness rises at arousal extremes.
    var breath = PRE_0_0;
    if (f64_gt(arousal, PRE_0_8)) {
        # up to +0.15 at max arousal: (arousal - 0.8) * 0.75
        breath = f64_mul(f64_sub(arousal, PRE_0_8), PRE_0_75);
    } else {
        if (f64_lt(arousal, PRE_0_2)) {
            # up to +0.1 at min arousal: (0.2 - arousal) * 0.5
            breath = f64_mul(f64_sub(PRE_0_2, arousal), PRE_0_5);
        }
    }
    PrEmotionOut_set_breathiness_delta(out, breath);
    return out;
}

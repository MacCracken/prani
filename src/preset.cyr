# preset.cyr -- named voice presets: specific individuals within a species.
# Ports 2.0.3:rust-old/src/preset.rs. A VoicePreset is a ready-made
# CreatureVoice configuration for a recognizable individual character (e.g. a
# large alpha wolf vs. a small pup). preset_build() turns a preset into a
# CreatureVoice via the crvoice_* builder chain (new -> with_size ->
# with_f0_offset -> with_breathiness), matching the oracle's builder order
# exactly.
#
# Requires (from the build/test unit, in dependency order): stdlib alloc/vec,
# error.cyr, rng.cyr, dsp.cyr, vocalization.cyr, sequence.cyr, species.cyr,
# bridge.cyr, tract.cyr, voice.cyr (svara/naad/hisab dep bundles first). Module
# files carry no `include` lines -- the entry orders them.
#
# NAMING (flat-namespace prefix): struct VoicePreset, every top-level fn is
# `preset_`-prefixed. The 11 Rust `const` presets become zero-arg constructor
# fns (Cyrius has no compile-time struct consts), each allocating and filling a
# fresh VoicePreset with the oracle's verbatim field values.
#
# FLOATS: prani's Rust was f32; this port is f64 (svara/naad/hisab are f64-only,
# widening is forced). Integer literals via f64_from(n) (negatives via
# f64_neg(f64_from(n))); non-integer literals via the module-top IEEE-754 hex
# constants below (decimals in comments), one constant per distinct value.
#
# NAME FIELD: Rust's `name: Cow<'static, str>` is a display string, RESTORED as
# a cstring stored in the `name` field (e.g. "Alpha Wolf"). preset_build ignores
# it (matching the oracle). serde RESTORED — see preset_to_json below.
#
# RANGES (2.0.5): preset_from_json_str is the only entry point in this module
# that can report a failure, and it validates every field of an untrusted
# document — see its comment for the range per field and why that range. The 11
# built-ins are trusted input and sit inside every range; the codec is not
# trusted. preset_make / preset_build hand back a struct with no error channel
# and are deliberately left unguarded (roadmap 2.1.0's constructor contract).

# ================================================================
# Non-integer literal constants (IEEE-754 hex; decimals in comments).
# One constant per distinct preset field value.
# ================================================================
# size values (non-integer)
var PR_P_1_4  = 0x3ff6666666666666;   # 1.4  Alpha Wolf size
var PR_P_0_4  = 0x3fd999999999999a;   # 0.4  Wolf Pup / Kitten size
var PR_P_1_3  = 0x3ff4cccccccccccd;   # 1.3  Male Lion / Raven size
var PR_P_0_8  = 0x3fe999999999999a;   # 0.8  Young Dragon size
var PR_P_1_2  = 0x3ff3333333333333;   # 1.2  Bald Eagle size
var PR_P_1_5  = 0x3ff8000000000000;   # 1.5  American Alligator size

# breathiness values (non-integer)
var PR_P_0_03 = 0x3f9eb851eb851eb8;   # 0.03  Alpha Wolf breathiness
var PR_P_0_12 = 0x3fbeb851eb851eb8;   # 0.12  Wolf Pup / Male Lion breathiness
var PR_P_0_08 = 0x3fb47ae147ae147b;   # 0.08  House Cat breathiness
var PR_P_0_15 = 0x3fc3333333333333;   # 0.15  Kitten / Young Dragon breathiness
var PR_P_0_25 = 0x3fd0000000000000;   # 0.25  Ancient Dragon breathiness
var PR_P_0_1  = 0x3fb999999999999a;   # 0.1   Bald Eagle breathiness; size floor
var PR_P_0_2  = 0x3fc999999999999a;   # 0.2   Raven breathiness
var PR_P_0_18 = 0x3fc70a3d70a3d70a;   # 0.18  American Alligator breathiness

# ================================================================
# VoicePreset -- a named creature voice preset.
#   name        : display name cstring (e.g. "Alpha Wolf")
#   species     : PRANI_SP_* constant
#   size        : size scale
#   f0_offset   : f0 offset from species default (Hz)
#   breathiness : breathiness override
# serde RESTORED via preset_to_json / preset_from_json_str (name + scalars).
# ================================================================
#derive(accessors)
struct VoicePreset {
    name; species; size; f0_offset; breathiness;
}

# Internal builder -- fills every field in declaration order. `name` is the
# display string (a cstring literal), restoring the Rust `name: Cow<str>` field.
#
# DELIBERATELY UNVALIDATED (2.0.5): this returns a VoicePreset with no error
# channel, exactly like the crvoice_with_* builders it feeds, so a guard here
# would have to invent one -- the constructor-contract change is roadmap 2.1.0.
# The two ways a caller's number becomes a preset are ranged instead where an
# error CAN be reported: preset_from_json_str above validates every field of an
# untrusted document, and a NaN handed straight to preset_make survives into
# preset_build (see there).
#must_use
fn preset_make(name, species, size, f0_offset, breathiness) {
    var self = alloc(sizeof(VoicePreset));
    VoicePreset_set_name(self, name);
    VoicePreset_set_species(self, species);
    VoicePreset_set_size(self, size);
    VoicePreset_set_f0_offset(self, f0_offset);
    VoicePreset_set_breathiness(self, breathiness);
    return self;
}

# VoicePreset serde -- restores the Rust `#[derive(Serialize, Deserialize)]`.
# Built manually with str_builder (proven path) and read with bayan's parser
# (the garjan voice_pool pattern). The f64 fields (size/f0_offset/breathiness)
# are emitted as their exact i64 BIT PATTERNS (str_builder_add_int) so they
# roundtrip LOSSLESS — the derive/value-tree float writers are 6-digit lossy.
# `name` is a plain display string with no JSON-special characters, so it is
# emitted between literal quotes. Roundtrip is idempotent (fixed key order).
fn preset_to_json(self, sb) {
    str_builder_add_cstr(sb, "{\"name\":\"");
    str_builder_add_cstr(sb, VoicePreset_name(self));
    str_builder_add_cstr(sb, "\",\"species\":");
    str_builder_add_int(sb, VoicePreset_species(self));
    str_builder_add_cstr(sb, ",\"size\":");
    str_builder_add_int(sb, VoicePreset_size(self));
    str_builder_add_cstr(sb, ",\"f0_offset\":");
    str_builder_add_int(sb, VoicePreset_f0_offset(self));
    str_builder_add_cstr(sb, ",\"breathiness\":");
    str_builder_add_int(sb, VoicePreset_breathiness(self));
    str_builder_add_cstr(sb, "}");
    return 0;
}

# from_json_str(json) -- rebuild a VoicePreset from preset_to_json output.
# `json` is a NUL-terminated cstring; the display `name` is restored as a real
# string and the f64 fields as exact i64 bit patterns.
#
# Returns the VoicePreset ptr, or a NEGATIVE PRANI_ERR_INVALID_SPECIES if the
# document is not a valid preset. ONE code for the whole codec, matching
# ADR-0002's table: a VoicePreset *is* a voice configuration, so every rejection
# says the same thing -- "this is not a species/voice config prani can build".
#
# WHAT IS REJECTED (2.0.5 -- the field-level half ADR-0002 left open):
#   json == 0, or the document does not parse                        (2.0.3)
#   `name` missing or not a JSON string. This was a LIVE SIGSEGV, not a range
#     question: bayan_json_v_obj_get returns 0 for a missing key and
#     bayan_json_v_str returns 0 for a non-string node, and str_data(0) then
#     dereferences address 0 (measured 2026-08-31: `{"species":0,...}` with no
#     "name" key exits 139). An array root reaches it the same way.
#   any of the four scalars missing or not a JSON integer. A missing key and a
#     wrong-typed key are one rejection -- obj_get gives 0 and is_int(0) is 0.
#     The oracle required every field too: no `#[serde(default)]` anywhere on
#     VoicePreset, so serde failed on a missing field. Reading the scalars with
#     bayan_json_v_int alone could not tell an absent field from a present 0,
#     and 0 is a legal bit pattern (+0.0) for f0_offset and breathiness.
#   `species` outside [0, PRANI_SP_COUNT). species_params falls THROUGH to the
#     Fantasy row for an unknown discriminant, so an unnamed species would come
#     back as a plausible creature instead of an error.
#   `size` outside [0.1, 10.0]         -- crvoice_with_size's clamp domain
#   `f0_offset` outside +/-(f0_max - f0_min) FOR THIS SPECIES
#                                      -- crvoice_with_f0_offset's clamp domain
#   `breathiness` outside [0.0, 1.0]   -- crvoice_with_breathiness's clamp domain
#
# Each numeric range is exactly the domain the builder that consumes the field
# PRESERVES, so an accepted document reaches the voice unchanged. Outside it,
# preset_build would silently substitute the clamp bound (ADR-0001: never
# fabricate a plausible answer) -- and a NaN would pass the clamp untouched
# (audit F11) into svara. The 11 built-in presets all sit inside these ranges,
# so prani's own preset_to_json output always roundtrips (asserted per-preset in
# tests/preset.tcyr); only documents prani did not write can be rejected.
fn preset_from_json_str(json) {
    if (json == 0) { return PRANI_ERR_INVALID_SPECIES; }
    var root = bayan_json_v_parse_buf(json, strlen(json));
    if (root == 0) { return PRANI_ERR_INVALID_SPECIES; }
    var name = bayan_json_v_str(bayan_json_v_obj_get(root, "name"));
    if (name == 0) { return PRANI_ERR_INVALID_SPECIES; }
    var n_species = bayan_json_v_obj_get(root, "species");
    var n_size = bayan_json_v_obj_get(root, "size");
    var n_f0 = bayan_json_v_obj_get(root, "f0_offset");
    var n_br = bayan_json_v_obj_get(root, "breathiness");
    if (bayan_json_v_is_int(n_species) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    if (bayan_json_v_is_int(n_size) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    if (bayan_json_v_is_int(n_f0) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    if (bayan_json_v_is_int(n_br) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    var species = bayan_json_v_int(n_species);
    if (species < 0) { return PRANI_ERR_INVALID_SPECIES; }
    if (species >= PRANI_SP_COUNT) { return PRANI_ERR_INVALID_SPECIES; }
    var size = bayan_json_v_int(n_size);
    if (prani_in_range(size, PR_P_0_1, f64_from(10)) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    # f0_offset's bound is species-dependent because with_f0_offset's clamp is.
    var params = species_params(species);
    var f0_span = f64_sub(SpeciesParams_f0_max(params), SpeciesParams_f0_min(params));
    var f0_offset = bayan_json_v_int(n_f0);
    if (prani_in_range(f0_offset, f64_neg(f0_span), f0_span) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    var breathiness = bayan_json_v_int(n_br);
    if (prani_in_range(breathiness, 0, F64_ONE) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    return preset_make(str_data(name), species, size, f0_offset, breathiness);
}

# build(self) -- VoicePreset::build. Creates a CreatureVoice from this preset via
# the crvoice_* builder chain, matching the oracle order:
#   new(species).with_size(size).with_f0_offset(f0_offset).with_breathiness(br)
#
# NOT a validation point (2.0.5). It returns a CreatureVoice and nothing else --
# the same shape as the three builders it chains -- so it has no channel to
# report a bad field on, and giving it one is the 2.1.0 constructor-contract
# work, not this milestone. A preset built by preset_from_json_str cannot carry
# an out-of-range field (that codec rejects them); a preset assembled by hand
# through preset_make can, and a NaN there passes every f64_clamp in the chain
# (audit F11). It is caught at the fallible point of use downstream --
# crvoice_vocalize and the tract constructor, which return PRANI_ERR_* -- which
# covers every path to svara without changing this signature.
#must_use
fn preset_build(self) {
    return crvoice_with_breathiness(
      crvoice_with_f0_offset(
        crvoice_with_size(
          crvoice_new(VoicePreset_species(self)),
          VoicePreset_size(self)),
        VoicePreset_f0_offset(self)),
      VoicePreset_breathiness(self));
}

# ================================================================
# Built-in voice presets (Rust `const`s -> zero-arg constructor fns). Field
# values transcribed VERBATIM from the oracle static table.
# ================================================================

# Large alpha wolf -- deep, resonant howl. (Wolf, 1.4, -80.0, 0.03)
#must_use
fn preset_alpha_wolf() {
    return preset_make("Alpha Wolf", PRANI_SP_WOLF, PR_P_1_4, f64_neg(f64_from(80)), PR_P_0_03);
}

# Wolf pup -- high-pitched, breathy. (Wolf, 0.4, 200.0, 0.12)
#must_use
fn preset_wolf_pup() {
    return preset_make("Wolf Pup", PRANI_SP_WOLF, PR_P_0_4, f64_from(200), PR_P_0_12);
}

# House cat -- typical domestic cat. (Cat, 1.0, 0.0, 0.08)
#must_use
fn preset_house_cat() {
    return preset_make("House Cat", PRANI_SP_CAT, F64_ONE, 0, PR_P_0_08);
}

# Kitten -- small, high-pitched. (Cat, 0.4, 150.0, 0.15)
#must_use
fn preset_kitten() {
    return preset_make("Kitten", PRANI_SP_CAT, PR_P_0_4, f64_from(150), PR_P_0_15);
}

# Male lion -- deep, powerful roar. (Lion, 1.3, -15.0, 0.12)
#must_use
fn preset_male_lion() {
    return preset_make("Male Lion", PRANI_SP_LION, PR_P_1_3, f64_neg(f64_from(15)), PR_P_0_12);
}

# Ancient dragon -- massive, earth-shaking. (Dragon, 4.0, -30.0, 0.25)
#must_use
fn preset_ancient_dragon() {
    return preset_make("Ancient Dragon", PRANI_SP_DRAGON, f64_from(4), f64_neg(f64_from(30)), PR_P_0_25);
}

# Young dragon -- smaller, higher. (Dragon, 0.8, 50.0, 0.15)
#must_use
fn preset_young_dragon() {
    return preset_make("Young Dragon", PRANI_SP_DRAGON, PR_P_0_8, f64_from(50), PR_P_0_15);
}

# Bald eagle -- piercing screech. (Raptor, 1.2, -200.0, 0.1)
#must_use
fn preset_bald_eagle() {
    return preset_make("Bald Eagle", PRANI_SP_RAPTOR, PR_P_1_2, f64_neg(f64_from(200)), PR_P_0_1);
}

# Raven -- deep, rough croak. (Crow, 1.3, -100.0, 0.2)
#must_use
fn preset_raven() {
    return preset_make("Raven", PRANI_SP_CROW, PR_P_1_3, f64_neg(f64_from(100)), PR_P_0_2);
}

# Field cricket -- steady chirping. (Cricket, 1.0, 0.0, 0.0)
#must_use
fn preset_field_cricket() {
    return preset_make("Field Cricket", PRANI_SP_CRICKET, F64_ONE, 0, 0);
}

# American alligator -- deep bellow. (Crocodilian, 1.5, -10.0, 0.18)
#must_use
fn preset_alligator() {
    return preset_make("American Alligator", PRANI_SP_CROCODILIAN, PR_P_1_5, f64_neg(f64_from(10)), PR_P_0_18);
}

# all() -- returns a vec of all 11 built-in presets, in oracle order.
#must_use
fn preset_all() {
    var v = vec_new();
    vec_push(v, preset_alpha_wolf());
    vec_push(v, preset_wolf_pup());
    vec_push(v, preset_house_cat());
    vec_push(v, preset_kitten());
    vec_push(v, preset_male_lion());
    vec_push(v, preset_ancient_dragon());
    vec_push(v, preset_young_dragon());
    vec_push(v, preset_bald_eagle());
    vec_push(v, preset_raven());
    vec_push(v, preset_field_cricket());
    vec_push(v, preset_alligator());
    return v;
}

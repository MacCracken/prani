# error.cyr -- prani error codes + shared DSP tolerances and base helpers.
# L0 base module: included FIRST by every build/test entry. Modules never
# `include` each other -- the entry file orders them.
#
# Ports 2.0.3:rust-old/src/error.rs (the `PraniError` enum +
# `From<SvaraError>`). Rust carried a String payload per variant; the Cyrius
# port uses integer codes -- fallible functions return PRANI_ERR_NONE (0) on
# success or a negative code on failure; diagnostic text via prani_err_name().
#
# NAMING: every prani top-level symbol is `prani_`/`PRANI_`/`Pr`-prefixed so
# the prani distlib coexists with svara + naad bundles in one flat namespace
# (svara exports svara_*, naad exports validate_*/flush_denormal/ERR_NONE).
#
# FLOATS: prani's Rust was f32; the Cyrius port is f64 throughout (svara/naad/
# hisab are f64-only, widening is forced and improves precision). PRANI_EPSILON
# preserves the f32::EPSILON (2^-23) tolerance the Rust tests used, promoted to
# f64. Test tolerances loosened vs the f32 oracle where bit-exactness isn't
# meaningful.

# ================================================================
# Error codes (was `enum PraniError`). One per Rust variant, in order.
# ================================================================
var PRANI_ERR_NONE                 = 0;
var PRANI_ERR_INVALID_TRACT        = (0 - 1);   # vocal tract parameter out of range
var PRANI_ERR_INVALID_VOCALIZATION = (0 - 2);   # vocalization parameter invalid
var PRANI_ERR_INVALID_SPECIES      = (0 - 3);   # species configuration invalid
var PRANI_ERR_SYNTHESIS_FAILED     = (0 - 4);   # a synthesis step failed
var PRANI_ERR_SVARA                = (0 - 5);   # underlying svara operation failed

# ================================================================
# Shared f64 tolerances / sentinels (IEEE-754 bit patterns). Exported for
# consumers (tract clamps, tests). PRANI_EPSILON = f32::EPSILON promoted.
# ================================================================
var PRANI_EPSILON = 0x3E80000000000000;   # f32::EPSILON = 2^-23 ~ 1.192e-7
var PRANI_POS_INF = 0x7FF0000000000000;   # +inf
var PRANI_NEG_INF = 0xFFF0000000000000;   # -inf

# 1 if `code` is an error (negative), 0 otherwise.
#must_use
fn prani_is_err(code) {
    if (code < 0) { return 1; }
    return 0;
}

# Static name for an error code (diagnostics / logging).
#must_use
fn prani_err_name(code) {
    if (code == PRANI_ERR_NONE) { return "none"; }
    if (code == PRANI_ERR_INVALID_TRACT) { return "invalid tract parameter"; }
    if (code == PRANI_ERR_INVALID_VOCALIZATION) { return "invalid vocalization"; }
    if (code == PRANI_ERR_INVALID_SPECIES) { return "invalid species"; }
    if (code == PRANI_ERR_SYNTHESIS_FAILED) { return "synthesis failed"; }
    if (code == PRANI_ERR_SVARA) { return "svara error"; }
    return "unknown error";
}

# Map a svara error code (svara's own SVARA_ERR_* are negative) to
# PRANI_ERR_SVARA. Ports `impl From<svara::error::SvaraError> for PraniError`.
# Any nonzero svara code becomes the wrapping prani code; 0 (none) passes.
#must_use
fn prani_from_svara(svara_code) {
    if (svara_code == 0) { return PRANI_ERR_NONE; }
    return PRANI_ERR_SVARA;
}

# Finite test: 1 iff x is neither +/-inf nor NaN. abs(x) < +inf holds for
# finite x, fails for infinities (inf < inf is false) and NaN (any NaN
# compare is false). Mirrors Rust `f32::is_finite`.
#must_use
fn prani_is_finite(x) {
    return f64_lt(f64_abs(x), PRANI_POS_INF);
}

# ================================================================
# Input-range guards (2.0.5). Why these exist, measured 2026-08-31 and
# re-measured 2026-11-07 on cyrius 6.6.20:
#
#   f64_clamp(NaN, lo, hi) -> NaN          NaN passes every clamp in the tree
#   f64_clamp(+inf, lo, hi) -> hi          infinities ARE bounded by clamp
#   f64_clamp(-inf, lo, hi) -> lo
#   f64_to(NaN)     -> 0                   a legal count
#   f64_to(>= 2^63) -> i64::MAX            +inf included
#   f64_to(< -2^63) -> i64::MIN            -inf included
#
# So the hazard at a clamp site is NaN specifically, not non-finiteness in
# general. A count has two hazards and neither is negative: NaN lands on 0 and
# renders a silently EMPTY buffer (audit finding F11), and an overflow lands on
# i64::MAX and pushes samples until the vec aborts the process. Before cyrius
# 6.6.8 all of them gave i64::MIN, so a floor check caught them by accident. It
# catches neither now: a count is ranged in f64, BEFORE the cast, with
# prani_sample_count_ok or, where the count becomes one buffer,
# prani_buffer_count_ok.
#
# These return 1 for "acceptable" and 0 for "reject", so a call site reads
#   if (prani_is_finite(x) == 0) { return PRANI_ERR_INVALID_TRACT; }
# and the error code stays the caller's choice -- there is no generic
# "bad parameter" code, deliberately: the oracle's five variants already carry
# the range meaning by category (PraniError::InvalidTract is documented as
# "a vocal tract parameter is out of valid range").
# ================================================================

# 1 iff both are finite.
#must_use
fn prani_finite2(a, b) {
    if (prani_is_finite(a) == 0) { return 0; }
    return prani_is_finite(b);
}

# 1 iff all three are finite.
#must_use
fn prani_finite3(a, b, c) {
    if (prani_is_finite(a) == 0) { return 0; }
    return prani_finite2(b, c);
}

# 1 iff x is finite and lo <= x <= hi. Rejects NaN (every comparison against
# NaN is false, so the two f64_ge/f64_le tests both fail).
#must_use
fn prani_in_range(x, lo, hi) {
    if (prani_is_finite(x) == 0) { return 0; }
    if (f64_ge(x, lo) == 0) { return 0; }
    return f64_le(x, hi);
}

# 1 iff x is finite and strictly greater than 0. The common case for a
# duration, a sample rate, a distance or a scale factor used as a divisor.
#must_use
fn prani_is_positive(x) {
    if (prani_is_finite(x) == 0) { return 0; }
    return f64_gt(x, 0);
}

# 1 iff x is finite and >= 0 (a duration of exactly 0 is legal -- the oracle's
# test_zero_duration_synthesis asserts an empty buffer, not an error).
#must_use
fn prani_is_non_negative(x) {
    if (prani_is_finite(x) == 0) { return 0; }
    return f64_ge(x, 0);
}

# 2^53 == 9007199254740992: the largest sample count an f64 represents exactly.
# At 44.1 kHz that is ~6470 years of audio.
var PRANI_MAX_SAMPLE_COUNT = 0x4340000000000000;

# 1 iff `raw`, a sample count still in f64, may be cast with f64_to: finite and
# within [0, PRANI_MAX_SAMPLE_COUNT]. Call it BEFORE the cast -- after it, NaN is
# a legal 0 and an overflow is i64::MAX (see the block above). This is a limit
# on what a count can MEAN, not on what fits in memory; sequence.cyr's
# prani_seq_samples_ok is the allocation ceiling for its multi-call entry points.
#must_use
fn prani_sample_count_ok(raw) {
    return prani_in_range(raw, 0, PRANI_MAX_SAMPLE_COUNT);
}

# 1 iff `raw`, a sample count still in f64, can be ONE buffer: finite and within
# [0, VEC_CAP_MAX]. Any path that hands back a whole buffer uses this rather than
# prani_sample_count_ok, because growing a vec past VEC_CAP_MAX is "vec: capacity
# overflow" and a process exit no caller can catch, so the refusal has to come
# before the first push. A stream needs only the wider check: it renders block by
# block, so its total is not a buffer.
#
# The limit is lib/vec.cyr's own constant, not a copy of it, so this refuses
# exactly what could never have succeeded. It is not a memory estimate: a buffer
# at the limit costs ~4 GiB of bump arena, and an allocation refused below it is
# still a process exit (roadmap 2.2.0 Lane B).
#must_use
fn prani_buffer_count_ok(raw) {
    return prani_in_range(raw, 0, f64_from(VEC_CAP_MAX));
}

# prani_buffer_count_ok for a count that is already an integer.
#must_use
fn prani_buffer_len_ok(n) {
    if (n < 0) { return 0; }
    if (n > VEC_CAP_MAX) { return 0; }
    return 1;
}

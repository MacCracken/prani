# sequence.cyr -- call sequencing: bouts, phrases, and chorus synthesis.
# Ports rust-old/src/sequence.rs. Higher-level patterns above individual
# vocalizations: repeated call bouts, ordered phrases, and multi-voice chorus.
#
# Defines the CallElement / CallBout / CallPhrase data structs. species.cyr's
# bout_template constructs a CallBout, so this module's structs must be present
# in species' test unit (species does NOT call the synthesize methods, so their
# forward references to crvoice_* are unreachable there = warnings only).
#
# Requires (in the build/test unit): error.cyr (PRANI_ERR_*, prani_is_err),
# rng.cyr (prani_rng_*), and -- for the synthesize methods only -- voice.cyr
# (crvoice_vocalize_with_intent). The module file has no `include` lines.
#
# RESULT convention: synthesize* return a heap vec pointer on success or a
# negative PRANI_ERR_* on failure (propagated from crvoice_vocalize_with_intent).
# Callers check prani_is_err(result). serde RESTORED: CallElement/CallBout via
# #derive(Serialize); CallPhrase's element vec hand-rolled (see below). Display
# tests dropped (no Display in Cyrius).

var PRANI_CHORUS_PRIME = 7919;   # seed multiplier for chorus RNG (voices.len * 7919)

# ================================================================
# CallElement -- one element in a phrase.
#   vocalization : PRANI_VOC_* constant
#   duration     : f64 seconds
#   gap          : f64 seconds of silence after this call
# ================================================================
# TYPED i64 for #derive(Serialize) → auto CallElement_to_json / _from_json_str.
# f64 fields (duration/gap) are typed i64 so their exact bit patterns serialize
# losslessly (the derive's 6-digit float writer would lose precision).
#derive(accessors)
#derive(Serialize)
struct CallElement {
    vocalization: i64;
    duration: i64;
    gap: i64;
}

# call_element_new(vocalization, duration, gap) -- one element of a CallPhrase:
# which vocalization to utter, for how long, and how much silence follows it.
# `duration` and `gap` are f64 SECONDS held in i64 slots as exact bit patterns
# (see the struct comment). Returns the CallElement ptr.
#must_use
fn sequence_call_element_new(vocalization, duration, gap) {
    var e = alloc(sizeof(CallElement));
    CallElement_set_vocalization(e, vocalization);
    CallElement_set_duration(e, duration);
    CallElement_set_gap(e, gap);
    return e;
}

# ================================================================
# CallBout -- repeated instances of the same vocalization.
#   vocalization  : PRANI_VOC_* constant
#   count         : u32 repetitions
#   call_duration : f64 seconds per call
#   interval      : f64 inter-call interval (seconds)
#   intent        : PRANI_INTENT_* constant
# ================================================================
# TYPED i64 for #derive(Serialize) → auto CallBout_to_json / _from_json_str.
# f64 fields (call_duration/interval) typed i64 → exact bit-pattern serialization.
#derive(accessors)
#derive(Serialize)
struct CallBout {
    vocalization: i64;
    count: i64;
    call_duration: i64;
    interval: i64;
    intent: i64;
}

# call_bout_new(vocalization, count, call_duration, interval, intent) -- a bout
# is the same vocalization repeated `count` times with `interval` seconds of
# silence between calls (not after the last). `call_duration` and `interval` are
# f64 seconds as exact bit patterns. Returns the CallBout ptr; render it with
# sequence_call_bout_synthesize.
#must_use
fn sequence_call_bout_new(vocalization, count, call_duration, interval, intent) {
    var b = alloc(sizeof(CallBout));
    CallBout_set_vocalization(b, vocalization);
    CallBout_set_count(b, count);
    CallBout_set_call_duration(b, call_duration);
    CallBout_set_interval(b, interval);
    CallBout_set_intent(b, intent);
    return b;
}

# CallBout::synthesize -- render the whole bout to one buffer. For each of
# `count` calls: synthesize via the voice, then (except after the last) append
# `interval * sample_rate` samples of silence. Returns a vec or a negative error.
fn sequence_call_bout_synthesize(self, voice, sample_rate) {
    var gap_samples = f64_to(f64_mul(CallBout_interval(self), sample_rate));
    var output = vec_new();
    var count = CallBout_count(self);
    var i = 0;
    while (i < count) {
        var call = crvoice_vocalize_with_intent(voice, CallBout_vocalization(self),
          CallBout_intent(self), sample_rate, CallBout_call_duration(self));
        if (prani_is_err(call) == 1) { return call; }
        prani_vec_extend(output, call);
        if (i < (count - 1)) { prani_vec_push_zeros(output, gap_samples); }
        i = i + 1;
    }
    return output;
}

# ================================================================
# CallPhrase -- ordered sequence of different vocalizations.
#   elements : vec of CallElement pointers
#   intent   : PRANI_INTENT_* applied to all elements
# ================================================================
#derive(accessors)
struct CallPhrase { elements; intent; }

# call_phrase_new(elements, intent) -- a phrase is an ordered sequence of
# DIFFERENT vocalizations, each with its own duration and trailing gap.
# `elements` is a vec of CallElement pointers; `intent` applies to all of them.
# Returns the CallPhrase ptr; render it with sequence_call_phrase_synthesize.
#must_use
fn sequence_call_phrase_new(elements, intent) {
    var p = alloc(sizeof(CallPhrase));
    CallPhrase_set_elements(p, elements);
    CallPhrase_set_intent(p, intent);
    return p;
}

# CallPhrase serde -- restores the Rust `#[derive(Serialize, Deserialize)]`.
# `elements` is a vec of CallElement, which #derive(Serialize) can't express, so
# the codec is hand-rolled: emit {"intent":N,"elements":[<CallElement json>,…]}
# (delegating each element to its auto CallElement_to_json), and parse with
# bayan's value-tree, rebuilding each element via CallElement_from_json_str
# (re-serializing the array-element node). Roundtrip is idempotent.
fn sequence_call_phrase_to_json(self, sb) {
    str_builder_add_cstr(sb, "{\"intent\":");
    str_builder_add_int(sb, CallPhrase_intent(self));
    str_builder_add_cstr(sb, ",\"elements\":[");
    var elems = CallPhrase_elements(self);
    var n = vec_len(elems);
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        CallElement_to_json(vec_get(elems, i), sb);
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    return 0;
}

# call_phrase_from_json_str(json) -- rebuild a CallPhrase from
# sequence_call_phrase_to_json output. `json` is a NUL-terminated cstring; each
# array element is read field-by-field straight from the parsed node.
# Returns the CallPhrase ptr, or a NEGATIVE PRANI_ERR_INVALID_VOCALIZATION if
# `json` is 0 or does not parse.
fn sequence_call_phrase_from_json_str(json) {
    if (json == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var root = bayan_json_v_parse_buf(json, strlen(json));
    if (root == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var intent = bayan_json_v_int(bayan_json_v_obj_get(root, "intent"));
    var elems_val = bayan_json_v_obj_get(root, "elements");
    var n = bayan_json_v_arr_len(elems_val);
    var elems = vec_new();
    var i = 0;
    while (i < n) {
        # Read each element's fields DIRECTLY from the parsed array-element node
        # (duration/gap are i64 bit patterns). Avoids re-serializing the node.
        var ev = bayan_json_v_arr_get(elems_val, i);
        var e = alloc(sizeof(CallElement));
        CallElement_set_vocalization(e, bayan_json_v_int(bayan_json_v_obj_get(ev, "vocalization")));
        CallElement_set_duration(e, bayan_json_v_int(bayan_json_v_obj_get(ev, "duration")));
        CallElement_set_gap(e, bayan_json_v_int(bayan_json_v_obj_get(ev, "gap")));
        vec_push(elems, e);
        i = i + 1;
    }
    return sequence_call_phrase_new(elems, intent);
}

# CallPhrase::synthesize -- render each element then append `gap * sr` silence.
# Returns a vec or a negative error.
fn sequence_call_phrase_synthesize(self, voice, sample_rate) {
    var output = vec_new();
    var elements = CallPhrase_elements(self);
    var n = vec_len(elements);
    var i = 0;
    while (i < n) {
        var element = vec_get(elements, i);
        var call = crvoice_vocalize_with_intent(voice, CallElement_vocalization(element),
          CallPhrase_intent(self), sample_rate, CallElement_duration(element));
        if (prani_is_err(call) == 1) { return call; }
        prani_vec_extend(output, call);
        prani_vec_push_zeros(output, f64_to(f64_mul(CallElement_gap(element), sample_rate)));
        i = i + 1;
    }
    return output;
}

# ================================================================
# synthesize_chorus -- multiple voices with timing variation, summed and
# normalized. `voices` is a vec of CreatureVoice pointers. Returns a vec or a
# negative error (empty vec if `voices` is empty).
# ================================================================
fn sequence_synthesize_chorus(voices, vocalization, intent, sample_rate, duration, timing_spread) {
    var voice_count = vec_len(voices);
    if (voice_count == 0) { return vec_new(); }

    var max_offset_samples = f64_to(f64_mul(timing_spread, sample_rate));
    var base_samples = f64_to(f64_mul(duration, sample_rate));
    # total length includes the spread for late-starting voices
    var total_len = base_samples + max_offset_samples * 2;

    # mix = vec of total_len zeros
    var mix = vec_new();
    prani_vec_push_zeros(mix, total_len);

    var rng = prani_rng_new(voice_count * PRANI_CHORUS_PRIME);

    # modulo divisor: max(max_offset_samples, 1) * 2
    var mo = max_offset_samples;
    if (mo < 1) { mo = 1; }
    var divisor = mo * 2;

    var vi = 0;
    while (vi < voice_count) {
        var voice = vec_get(voices, vi);
        var call = crvoice_vocalize_with_intent(voice, vocalization, intent, sample_rate, duration);
        if (prani_is_err(call) == 1) { return call; }
        # random offset within timing_spread
        var offset = prani_rng_next_u32(rng) % divisor;
        var m = vec_len(call);
        var i = 0;
        while (i < m) {
            var idx = offset + i;
            if (idx < total_len) {
                vec_set(mix, idx, f64_add(vec_get(mix, idx), vec_get(call, i)));
            }
            i = i + 1;
        }
        vi = vi + 1;
    }

    # normalize by 1/sqrt(voice_count) to prevent clipping
    var scale = f64_div(F64_ONE, f64_sqrt(f64_from(voice_count)));
    var s = 0;
    while (s < total_len) {
        vec_set(mix, s, f64_mul(vec_get(mix, s), scale));
        s = s + 1;
    }
    return mix;
}

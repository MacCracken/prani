# stream.cyr -- pull-based streaming synthesis.
# Ports 2.0.3:rust-old/src/stream.rs. A SynthStream wraps a CreatureVoice and
# yields audio blocks on demand, avoiding the full-buffer allocation of
# crvoice_vocalize. Suitable for real-time audio callbacks where the block size
# is determined by the host (Wwise, FMOD, Godot, JACK).
#
# Requires (from the build/test unit, in dependency order): stdlib alloc/vec/
# math, hisab, goonj, naad, svara, error.cyr, rng.cyr, dsp.cyr, vocalization.cyr,
# sequence.cyr, species.cyr, bridge.cyr, tract.cyr, voice.cyr. Module files carry
# no `include` lines -- the entry orders them.
#
# NAMING (flat-namespace prefix): every top-level fn here is `stream_`-prefixed.
# The spectral-offset helper is REUSED from voice.cyr
# (crvoice_vocalization_spectral_offset) -- NOT redefined here (Rust duplicated
# it as a private fn to keep stream.rs self-contained; the flat-namespace port
# shares the single definition).
#
# FLOATS: prani's Rust was f32; this port is f64 (svara/naad/hisab are f64-only,
# widening is forced). Integer literals via f64_from(n); non-integer literals via
# the module-top IEEE-754 hex constants below (decimals in comments).
#
# RESULT convention: stream_new returns a SynthStream heap ptr (large positive)
# on success, or a NEGATIVE PRANI_ERR_* -- INVALID_VOCALIZATION when the species
# cannot produce the requested vocalization, plus the input-range codes below.
#
# INPUT RANGES (2.0.5; audit findings F10/F11). Every range is stated as
# "accepted", and anything outside it is REPORTED, never clamped -- clamping a
# value the caller did not ask for hides the caller's bug (ADR-0001).
#
#   stream_new(voice, ...)      voice must be a live handle (> 0). A negative
#                               argument is an UNCHECKED deserializer code
#                               (crvoice_from_json_str returns -3), which would
#                               otherwise be dereferenced.  -> INVALID_SPECIES
#   stream_new sample_rate      finite and > 0. NO floor of prani's own: svara
#                               owns the real threshold (~1000 Hz until svara
#                               3.5.4, >1200 Hz since) and ADR-0001
#                               forbids restating it, so a 10 Hz stream still
#                               CONSTRUCTS and fails at the first fill under
#                               ADR-0003.                    -> INVALID_TRACT
#   stream_new duration         finite and >= 0 seconds. Zero is VALID -- the
#                               oracle's test_zero_duration_synthesis asserts an
#                               empty buffer, not an error. Negative is rejected
#                               (DIVERGENCE: Rust's `as usize` saturated it to 0
#                               and returned a silent empty stream).
#                                                            -> INVALID_VOCALIZATION
#   stream_new total samples    duration * duration_scale * sample_rate must land
#                               in [0, 2^53]. 2^53 is the largest count an f64
#                               holds exactly; past i64's range f64_to saturates
#                               to i64::MIN (measured), so an unguarded huge or
#                               non-finite product yielded a NEGATIVE
#                               total_samples and a stream that reported
#                               is_finished == 1 with no error. At 44.1 kHz the
#                               bound is ~6470 years of audio.
#                                                            -> INVALID_VOCALIZATION
#   stream_new voice snapshot   f0, effort_amp and spectral_tilt must be finite.
#                               f64_clamp passes NaN through (measured), so
#                               crvoice_with_size(v, NaN) / with_vocal_effort
#                               smuggle a NaN into the voice; the builders return
#                               `self` and have no error channel (roadmap 2.1.0),
#                               so the guard lands here, where the stream
#                               SNAPSHOTS them -- upstream of every svara call
#                               this module makes.            -> INVALID_SPECIES
#   stream_next_block block_size >= 0; no upper bound (it is clamped to the
#                               remaining samples, itself bounded above).
#                                                            -> INVALID_VOCALIZATION
#   stream_fill_buffer          takes no numeric parameter. A null/negative
#                               stream or buffer handle returns 0 written and
#                               does NOT retire the stream: it is a caller
#                               mistake, not a property of the stream (ADR-0003
#                               settles the same question for a zero-length
#                               buffer).
#   stream_pitch_contour_at     returns an f64, NOT a "value or negative code"
#                               (PRANI_ERR_INVALID_TRACT is -1, which is itself a
#                               NaN bit pattern), so it has no error channel. A
#                               NaN t propagates as NaN instead of fabricating an
#                               f0; the stream's own call site is guarded in
#                               stream_fill_buffer.
#
# tract field: lazily initialized. Starts as 0 (== None sentinel); the first
# stream_fill_buffer builds it via crtract_new (Option::get_or_insert_with).
#
# EQUIVALENT-RESULT SIMPLIFICATION (fill_buffer): the Rust code copies the fresh
# synthesized block into buffer[..to_render], THEN applies the spectral-tilt
# lowpass and per-sample amplitude to buffer[..to_render]. Since the tilt filter
# and amplitude scale are pointwise/sequential over exactly the same to_render
# fresh samples (buffer beyond to_render is untouched by both, and the block's
# leading to_render samples are identical to what gets copied), applying tilt+amp
# to the BLOCK vec first and then copying block[0..to_render] into
# buffer[0..to_render] yields bit-identical results. The port does the latter so
# the tilt/amp helpers operate on the whole block vec (crtract_apply_spectral_tilt
# runs over the full vec, but only the first to_render slots are copied out).
#
# PARITY: exact svara-internal bit parity vs the f32 oracle is not attainable
# (f32->f64 diverges through svara's DSP reached via crtract_synthesize). Tests
# assert structural + parity-meaningful properties (total_samples / rejection /
# fill_buffer accounting / is_finished flip / next_block sizes exact;
# finiteness for the svara-dependent output; pitch_contour_at exact where
# closed-form). SynthStream carries no serde — the Rust oracle did not derive
# Serialize on it (transient per-call synth state). Display tests dropped.

# ================================================================
# Non-integer literal constants (IEEE-754 hex; decimals in comments).
# ================================================================
var PR_ST_0_3   = 0x3fd3333333333333;   # 0.3   effort_amp base
var PR_ST_1_2   = 0x3ff3333333333333;   # 1.2   effort_amp multiplier
var PR_ST_0_5   = 0x3fe0000000000000;   # 0.5   effort_tilt center / boundary boost gain
var PR_ST_6_0   = 0x4018000000000000;   # 6.0   effort_tilt multiplier
var PR_ST_0_1   = 0x3fb999999999999a;   # 0.1   attack boundary fraction
var PR_ST_0_85  = 0x3feb333333333333;   # 0.85  release boundary fraction
var PR_ST_0_15  = 0x3fc3333333333333;   # 0.15  release boundary span
# purr f0 clamp: purr_f0 = clamp(27.0 / 1.0, 20.0, 35.0)
var PR_ST_27_0  = 0x403b000000000000;   # 27.0  purr laryngeal cycle f0
var PR_ST_20_0  = 0x4034000000000000;   # 20.0  purr clamp low
var PR_ST_35_0  = 0x4041800000000000;   # 35.0  purr clamp high
# pitch-contour table multipliers (transcribed verbatim from the oracle).
var PR_ST_0_8   = 0x3fe999999999999a;   # 0.8
var PR_ST_1_3   = 0x3ff4cccccccccccd;   # 1.3
var PR_ST_0_6   = 0x3fe3333333333333;   # 0.6
var PR_ST_0_7   = 0x3fe6666666666666;   # 0.7
var PR_ST_0_9   = 0x3feccccccccccccd;   # 0.9
var PR_ST_1_4   = 0x3ff6666666666666;   # 1.4
var PR_ST_1_6   = 0x3ff999999999999a;   # 1.6
var PR_ST_1_5   = 0x3ff8000000000000;   # 1.5
var PR_ST_0_25  = 0x3fd0000000000000;   # 0.25
var PR_ST_1_1   = 0x3ff199999999999a;   # 1.1
var PR_ST_0_75  = 0x3fe8000000000000;   # 0.75
# 2^53 == 9007199254740992: the largest sample count an f64 represents exactly,
# and the ceiling stream_new accepts for duration * duration_scale * sample_rate.
var PR_ST_MAX_SAMPLES = 0x4340000000000000;   # 9007199254740992.0 == 2^53

# ================================================================
# SynthStream -- a pull-based streaming synthesizer. Produces audio block-by-
# block without allocating the full output buffer up front.
#   voice           : CreatureVoice ptr producing this stream
#   vocalization    : PRANI_VOC_* being synthesized
#   intent          : PRANI_INTENT_* behavioral intent
#   sample_rate     : sample rate (Hz)
#   total_samples   : total samples to produce
#   samples_rendered: samples produced so far
#   tract           : CreatureTract ptr, or 0 (== None; lazily built)
#   f0              : pitch-contour base f0 (after intent modifiers)
#   amplitude_scale : intent amplitude multiplier snapshot
#   effort_amp      : vocal-effort amplitude scale
#   spectral_tilt   : combined spectral tilt (species + voc + effort)
#   is_cat_purr     : 1 if this is a cat purr (special path), else 0
#   urgency         : intent urgency snapshot (perturbation_scale addend)
#   options         : one reusable SynthesisOptions, re-armed per fill
#   contour_pts     : one reusable contour-point vec, refilled per fill
#   block           : one reusable synthesis block vec, rewritten per fill
# No serde: the Rust `SynthStream` did not derive Serialize (transient state).
#
# The last three fields exist ONLY so stream_fill_buffer allocates nothing --
# see that function's ALLOCATION note (2.0.9). They are per-stream scratch, not
# state the stream reports: `urgency` is a pure function of `intent`, and `options` /
# `contour_pts` are storage whose contents are rewritten on every fill. Nothing
# reads them between calls, so hoisting them here cannot change what a fill
# produces -- it only moves where the bytes come from.
# ================================================================
#derive(accessors)
struct SynthStream {
    voice; vocalization; intent; sample_rate; total_samples;
    samples_rendered; tract; f0; amplitude_scale; effort_amp;
    spectral_tilt; is_cat_purr; urgency; options; contour_pts; block;
}

# new(voice, voc, intent, sample_rate, duration) -- SynthStream::new. Does not
# allocate the full output; audio is produced incrementally via
# stream_fill_buffer / stream_next_block.
#
# Returns a SynthStream ptr on success, or a NEGATIVE PRANI_ERR_* -- see the
# module header's INPUT RANGES table for every rejection and its code.
#must_use
fn stream_new(voice, voc, intent, sample_rate, duration) {
    # A live voice handle is a heap pointer. 0 is null and a NEGATIVE argument is
    # an unchecked crvoice_from_json_str failure code (-3): both would be
    # dereferenced by crvoice_species below, which is F1's crash class.
    if (voice <= 0) { return PRANI_ERR_INVALID_SPECIES; }
    var species = crvoice_species(voice);
    # Same enum-erasure guard as crvoice_vocalize_with_intent: species_params
    # falls through to the FANTASY defaults for an unknown tag, so a voice built
    # with crvoice_new(99) streams happily. Found by 2.0.6's error_handling
    # example; crvoice_new has no error channel, so this is the point of use.
    if (species < 0) { return PRANI_ERR_INVALID_SPECIES; }
    if (species >= PRANI_SP_COUNT) { return PRANI_ERR_INVALID_SPECIES; }
    if (species_supports_vocalization(species, voc) == 0) {
        return PRANI_ERR_INVALID_VOCALIZATION;
    }
    # sample_rate: finite and > 0. Deliberately NO lower bound of prani's own --
    # svara owns the real threshold and ADR-0001 forbids duplicating it, so
    # 10 Hz still constructs here and is rejected at the first fill (ADR-0003).
    if (prani_is_positive(sample_rate) == 0) { return PRANI_ERR_INVALID_TRACT; }
    # duration: finite and >= 0. Zero is VALID (the oracle's
    # test_zero_duration_synthesis asserts an empty buffer, not an error).
    if (prani_is_non_negative(duration) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }

    var modifiers = prani_intent_modifiers(intent);
    var f0 = f64_mul(crvoice_effective_f0(voice), IntentModifiers_pitch_scale(modifiers));
    var effective_duration = f64_mul(duration, IntentModifiers_duration_scale(modifiers));
    # total_samples = (effective_duration * sample_rate) as usize -- but f64_to
    # saturates to i64::MIN for every value outside i64's range, non-finite or
    # merely huge (measured 2026-08-31), so the product is ranged BEFORE the
    # conversion. The intent's duration_scale is inside the check because it is
    # what can push an accepted duration over the edge (Mating doubles it).
    var raw_samples = f64_mul(effective_duration, sample_rate);
    if (prani_in_range(raw_samples, 0, PR_ST_MAX_SAMPLES) == 0) {
        return PRANI_ERR_INVALID_VOCALIZATION;
    }
    var total_samples = f64_to(raw_samples);

    var effort = crvoice_vocal_effort(voice);
    var effort_amp = f64_add(PR_ST_0_3, f64_mul(effort, PR_ST_1_2));
    var effort_tilt_offset = f64_mul(f64_sub(effort, PR_ST_0_5), PR_ST_6_0);
    var vocalization_tilt = crvoice_vocalization_spectral_offset(voc);
    var species_params = species_params(species);
    var spectral_tilt = f64_add(
      f64_add(SpeciesParams_spectral_tilt(species_params), vocalization_tilt),
      effort_tilt_offset);

    # F11, at the point of use: these three are SNAPSHOTS of the voice, and
    # f64_clamp(NaN, lo, hi) is NaN (measured), so every builder that clamps --
    # crvoice_with_size, crvoice_with_vocal_effort, crvoice_with_f0_offset --
    # will hand a NaN straight through. The builders return `self` and cannot
    # report it (roadmap 2.1.0's constructor contract), so it is caught here,
    # before the snapshot is stored and long before it reaches svara as a
    # contour f0, a tilt coefficient or an output gain.
    if (prani_finite3(f0, effort_amp, spectral_tilt) == 0) {
        return PRANI_ERR_INVALID_SPECIES;
    }

    var is_cat_purr = 0;
    if (voc == PRANI_VOC_PURR) {
        if (species == PRANI_SP_CAT) { is_cat_purr = 1; }
    }

    var self = alloc(sizeof(SynthStream));
    SynthStream_set_voice(self, voice);
    SynthStream_set_vocalization(self, voc);
    SynthStream_set_intent(self, intent);
    SynthStream_set_sample_rate(self, sample_rate);
    SynthStream_set_total_samples(self, total_samples);
    SynthStream_set_samples_rendered(self, 0);
    SynthStream_set_tract(self, 0);
    SynthStream_set_f0(self, f0);
    SynthStream_set_amplitude_scale(self, IntentModifiers_amplitude_scale(modifiers));
    SynthStream_set_effort_amp(self, effort_amp);
    SynthStream_set_spectral_tilt(self, spectral_tilt);
    SynthStream_set_is_cat_purr(self, is_cat_purr);
    # 2.0.9 per-stream scratch, allocated ONCE here so the fill path allocates
    # nothing. `urgency` is a snapshot for the same reason f0 and effort_amp are:
    # `intent` cannot change after construction, so prani_intent_modifiers(intent)
    # returns the same four numbers on every fill, and the fill only ever read
    # this one of them. The other two are storage, not values -- see the struct
    # header. Neither return is checked, exactly as the `alloc` two lines above
    # is not: F9's arena-exhaustion class is library-wide and accepted (roadmap
    # 2.1.0), and this adds no new exposure to it.
    SynthStream_set_urgency(self, IntentModifiers_urgency(modifiers));
    SynthStream_set_options(self, crtract_options_default());
    SynthStream_set_contour_pts(self, vec_new());
    SynthStream_set_block(self, vec_new());   # 2.0.9: reused by every fill
    return self;
}

# is_finished(self) -- 1 when all samples have been produced, else 0.
#must_use
fn stream_is_finished(self) {
    if (SynthStream_samples_rendered(self) >= SynthStream_total_samples(self)) { return 1; }
    return 0;
}

# total_samples(self) -- total samples the stream will produce.
#must_use
fn stream_total_samples(self) {
    return SynthStream_total_samples(self);
}

# samples_rendered(self) -- samples produced so far.
#must_use
fn stream_samples_rendered(self) {
    return SynthStream_samples_rendered(self);
}

# fill_buffer(self, buffer) -- fill the provided vec with audio samples. Returns
# the number of samples actually written (may be < vec_len at end of stream).
#
# `buffer` is a vec handle (mutated in place). See the module header's
# EQUIVALENT-RESULT SIMPLIFICATION note: tilt+amp are applied to the freshly
# synthesized BLOCK vec, then block[0..to_render] is copied into
# buffer[0..to_render] -- bit-identical to Rust's copy-then-process-buffer.
#
# ALLOCATION (2.0.9). This is the module's real-time entry point -- the header
# advertises it for host audio callbacks -- and `alloc()` is a bump arena that
# never frees, so a per-call allocation here is retained for the life of the
# process. Measured at 44100 Hz with a 512-sample buffer (Wolf/HOWL/Idle),
# steady state, with alloc_used() around ten fills:
#
#   crtract_synthesize's block vec   8088 B   (24 B header + six geometric
#                                              grows 16->512 slots: 128+256+
#                                              512+1024+2048+4096)
#   svara_glottal_new, per block      512 B   (inside crtract_synthesize_
#                                              laryngeal)
#   stream_pitch_contour_at's vec     152 B   <- removed here
#   prani_intent_modifiers             32 B   <- removed here
#   crtract_options_new                16 B   <- removed here
#                                    ------
#                                    8800 B
#
# The 200 B this module owns are now 0: `options` and `contour_pts` are hoisted
# into SynthStream and reused (2.0.3's F7/F8 technique -- hoist the storage into
# the owning struct), and the contour writes through
# stream_pitch_contour_at_into (the species_params / species_params_into shape).
# The remaining 8600 B are allocated inside src/tract.cyr and svara, not here;
# reaching them needs a `crtract_synthesize_into` writing into a caller-owned
# vec, and a glottal source cached on the CreatureTract. Both are tract.cyr
# changes with a second caller (voice.cyr's block loop) and are NOT done here.
fn stream_fill_buffer(self, buffer) {
    # Handle guards. The function's only failure channel is "0 samples written",
    # so neither can be reported as a code -- but both are dereferences today (a
    # negative argument is an unchecked stream_new / crvoice_vocalize code). Per
    # ADR-0003 these do NOT retire the stream: a bad handle is a caller mistake,
    # not a property of the stream, exactly like the zero-length buffer below.
    if (self <= 0) { return 0; }
    if (buffer <= 0) { return 0; }
    if (stream_is_finished(self) == 1) { return 0; }

    var total = SynthStream_total_samples(self);
    var rendered = SynthStream_samples_rendered(self);
    var remaining = total - rendered;
    var to_render = vec_len(buffer);
    if (remaining < to_render) { to_render = remaining; }   # buffer.len().min(remaining)
    # A zero-length buffer can never advance the stream; returning early keeps a
    # caller's `while (stream_is_finished(s) == 0) { fill(s, buf); }` from
    # spinning on tract setup it will only discard.
    if (to_render <= 0) { return 0; }

    # ensure the tract is initialized (Option::get_or_insert_with)
    var tract = SynthStream_tract(self);
    if (tract == 0) {
        var params = species_params(crvoice_species(SynthStream_voice(self)));
        tract = crtract_new(params, SynthStream_sample_rate(self));
        # crtract_new returns a negative PRANI_ERR_* when svara rejects the
        # sample rate. Do NOT cache an error code as the tract -- a later call
        # would see a non-zero `tract` field and use the code as a pointer.
        # Retire the stream and report 0 written: the failure is a property of
        # the stream's own sample_rate, so it will repeat on every call, and a
        # caller draining `while (stream_is_finished(s) == 0)` has to be able to
        # leave the loop.
        if (prani_is_err(tract) == 1) {
            SynthStream_set_samples_rendered(self, total);
            return 0;
        }
        SynthStream_set_tract(self, tract);
    }

    var block = 0;
    var have_block = 0;
    if (SynthStream_is_cat_purr(self) == 1) {
        # cat purr special path. purr_f0 = clamp(27/1.0, 20, 35) (size baked in).
        var purr_f0 = f64_clamp(PR_ST_27_0, PR_ST_20_0, PR_ST_35_0);
        block = crtract_synthesize_purr(tract, to_render, purr_f0);
        # 2.0.5 made this fallible (it now guards purr_f0 and num_samples), so
        # it takes the same arm as the standard path below rather than being
        # assumed to succeed -- ADR-0003 then reports 0 written and retires.
        if (prani_is_err(block) == 0) { have_block = 1; }
    } else {
        # standard synthesis with pitch contour
        var total_max = total;
        if (total_max < 1) { total_max = 1; }   # total_samples.max(1)
        var t = f64_div(f64_from(rendered), f64_from(total_max));
        # into the stream's own reusable point vec rather than a fresh one per
        # fill (152 B/call). The table is rewritten from scratch every call, so
        # the reuse is invisible to the result -- see stream_pitch_contour_at_into.
        var contour = stream_pitch_contour_at_into(SynthStream_contour_pts(self),
          SynthStream_vocalization(self), SynthStream_f0(self), t);
        # POINT OF USE: stream_new proved f0 finite, but the contour MULTIPLIES
        # it (BARK opens at 1.2x, WHINE closes at 1.6x), so an f0 near f64::MAX
        # can still overflow to +inf on the way to svara. Treat it as a synthesis
        # failure and take ADR-0003's arm verbatim -- 0 written, stream retired --
        # rather than handing svara a frequency that is not a number.
        if (prani_is_finite(contour) == 0) {
            SynthStream_set_samples_rendered(self, total);
            return 0;
        }

        # `urgency` was snapshotted in stream_new. It used to be re-derived here
        # as prani_intent_modifiers(intent), which allocates an IntentModifiers
        # (32 B) per fill to read one of its four fields -- and `intent` is
        # immutable for the stream's life, so the lookup returned the same number
        # every time.
        var boundary_boost = F64_ONE;
        if (f64_lt(t, PR_ST_0_1) == 1) {
            # 1 + (1 - t/0.1) * 0.5
            boundary_boost = f64_add(F64_ONE,
              f64_mul(f64_sub(F64_ONE, f64_div(t, PR_ST_0_1)), PR_ST_0_5));
        } elif (f64_gt(t, PR_ST_0_85) == 1) {
            # 1 + (t - 0.85)/0.15 * 0.5
            boundary_boost = f64_add(F64_ONE,
              f64_mul(f64_div(f64_sub(t, PR_ST_0_85), PR_ST_0_15), PR_ST_0_5));
        }
        var perturbation_scale = f64_add(boundary_boost, SynthStream_urgency(self));

        # `options` is allocated ONCE in stream_new and re-armed per fill, the
        # same repair 2.0.3's F8 made to voice.cyr's block loop -- one
        # permanently retained SynthesisOptions per host callback under a bump
        # allocator that never frees. Both fields are written every call, so the
        # reused struct carries nothing forward.
        var options = SynthStream_options(self);
        SynthesisOptions_set_subharmonic_amp(options, 0);
        SynthesisOptions_set_perturbation_scale(options, perturbation_scale);
        # 2.0.9: write into the stream's own reused vec. crtract_synthesize
        # allocated a fresh one per fill -- 8,088 of the 8,800 bytes this call
        # retained, being 24 B of header plus six geometric grows to reach 512
        # slots. The block is COPIED into the caller's buffer below, so nothing
        # reads it afterwards and reuse is safe.
        block = crtract_synthesize_into(tract, contour, to_render, options,
          SynthStream_block(self));
        # Rust used `if let Ok(block)` -- skip the copy on synthesis error.
        if (prani_is_err(block) == 0) { have_block = 1; }
    }

    # A synthesis failure must not be reported as a successful fill. The
    # oracle (2.0.3:rust-old/src/stream.rs:184) wraps only the COPY in
    # `if let Ok(block)`, then unconditionally runs
    # `self.samples_rendered += to_render; to_render` -- so a failed block
    # returns "I wrote N samples" while the caller's buffer still holds
    # whatever it held before, and that stale audio is played. DIVERGENCE
    # (ADR-0003): report 0 written, and retire the stream so a caller draining
    # `while (stream_is_finished(s) == 0)` terminates instead of spinning on a
    # failure that will repeat every call.
    if (have_block == 0) {
        SynthStream_set_samples_rendered(self, total);
        return 0;
    }

    if (have_block == 1) {
        # apply spectral tilt to the block (in place over the full block vec).
        # 2.0.5 made this fallible; a rejected tilt must take ADR-0003's arm
        # rather than silently returning an untilted block as a good fill.
        var e_tilt = crtract_apply_spectral_tilt(block, SynthStream_spectral_tilt(self),
          SynthStream_sample_rate(self));
        if (prani_is_err(e_tilt) == 1) { have_block = 0; }
        # apply amplitude: amp = amplitude_scale * effort_amp.
        var amp = f64_mul(SynthStream_amplitude_scale(self), SynthStream_effort_amp(self));
        var bi = 0;
        while (bi < to_render) {
            var y = f64_mul(vec_get(block, bi), amp);
            vec_set(block, bi, y);
            # copy block[bi] into buffer[bi]
            vec_set(buffer, bi, y);
            bi = bi + 1;
        }
    }

    SynthStream_set_samples_rendered(self, rendered + to_render);
    return to_render;
}

# next_block(self, block_size) -- produce the next block of audio as an owned
# vec. block_size is clamped to the remaining samples; returns an empty vec when
# nothing remains, or a NEGATIVE PRANI_ERR_INVALID_VOCALIZATION on a bad handle
# or a negative block_size (the "vec handle or negative code" convention
# crvoice_vocalize already uses). Check with prani_is_err before vec_len.
fn stream_next_block(self, block_size) {
    # Same handle class as stream_fill_buffer, but this one CAN report it: a
    # negative return is distinguishable from the empty vec that means "done".
    if (self <= 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    # block_size >= 0. A negative one used to fall through `remaining < actual`
    # (remaining is never negative), skip the `actual == 0` early return, push
    # zero samples, and hand fill_buffer an empty vec -- so it returned an EMPTY
    # VEC, indistinguishable from a finished stream. That silent-empty result is
    # exactly what 2.0.5 exists to replace. No upper bound: block_size is
    # clamped to `remaining`, which stream_new already bounded at 2^53.
    if (block_size < 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var total = SynthStream_total_samples(self);
    var rendered = SynthStream_samples_rendered(self);
    # remaining = total.saturating_sub(rendered)
    var remaining = 0;
    if (total > rendered) { remaining = total - rendered; }
    var actual = block_size;
    if (remaining < actual) { actual = remaining; }
    if (actual == 0) { return vec_new(); }
    var buf = vec_new();
    prani_vec_push_zeros(buf, actual);
    stream_fill_buffer(self, buf);
    return buf;
}

# ---- pitch_contour_at (f0-returning helper) ---------------------------------

# pitch_contour_at(voc, base_f0, t) -- the f0 at normalized time t for a
# vocalization. Distinct from voice's struct-returning contour: this is the
# free-function form the stream uses per-block. Static tables (FLAT/HOWL/BARK/
# ROAR/WHINE/SCREECH/TRILL) transcribed verbatim from the oracle. t is clamped to
# [0,1]; the point pairs are walked and the interpolated multiplier applied to
# base_f0.
#
# This is the ALLOCATING wrapper. The table and the walk live in
# stream_pitch_contour_at_into, so there is exactly one copy of them while both
# an allocating and a non-allocating entry point exist -- the same split
# `species_params` / `species_params_into` uses, and for the same reason: the
# per-block caller (stream_fill_buffer) must not allocate.
#must_use
fn stream_pitch_contour_at(voc, base_f0, t) {
    return stream_pitch_contour_at_into(vec_new(), voc, base_f0, t);
}

# pitch_contour_at_into(points, voc, base_f0, t) -- the table + the walk,
# building the contour in CALLER-OWNED storage. `points` is a vec handle; it is
# TRUNCATED TO EMPTY first and then refilled, so a reused vec cannot carry a
# previous call's points into this one and the result depends only on the
# arguments. vec_truncate preserves capacity (lib/vec.cyr), and the largest
# table is TRILL's 5 points == 10 slots, under vec_new's 16-slot initial
# capacity -- so a vec reused across calls never grows and never allocates again.
#must_use
fn stream_pitch_contour_at_into(points, voc, base_f0, t) {
    vec_truncate(points, 0);
    if (voc == PRANI_VOC_HOWL) {
        # HOWL: (0.0,0.8),(0.3,1.3),(0.7,1.2),(1.0,0.6)
        stream_contour_push(points, 0, PR_ST_0_8);
        stream_contour_push(points, PR_ST_0_3, PR_ST_1_3);
        stream_contour_push(points, PR_ST_0_7, PR_ST_1_2);
        stream_contour_push(points, F64_ONE, PR_ST_0_6);
    } elif (voc == PRANI_VOC_BARK) {
        stream_contour_bark(points);
    } elif (voc == PRANI_VOC_YELP) {
        stream_contour_bark(points);
    } elif (voc == PRANI_VOC_ROAR) {
        stream_contour_roar(points);
    } elif (voc == PRANI_VOC_RUMBLE) {
        stream_contour_roar(points);
    } elif (voc == PRANI_VOC_WHINE) {
        # WHINE: (0.0,1.0),(0.5,1.4),(1.0,1.6)
        stream_contour_push(points, 0, F64_ONE);
        stream_contour_push(points, PR_ST_0_5, PR_ST_1_4);
        stream_contour_push(points, F64_ONE, PR_ST_1_6);
    } elif (voc == PRANI_VOC_SCREECH) {
        # SCREECH: (0.0,1.5),(0.3,1.2),(1.0,0.7)
        stream_contour_push(points, 0, PR_ST_1_5);
        stream_contour_push(points, PR_ST_0_3, PR_ST_1_2);
        stream_contour_push(points, F64_ONE, PR_ST_0_7);
    } elif (voc == PRANI_VOC_TRILL) {
        # TRILL: (0.0,1.0),(0.25,1.1),(0.5,0.9),(0.75,1.1),(1.0,1.0)
        stream_contour_push(points, 0, F64_ONE);
        stream_contour_push(points, PR_ST_0_25, PR_ST_1_1);
        stream_contour_push(points, PR_ST_0_5, PR_ST_0_9);
        stream_contour_push(points, PR_ST_0_75, PR_ST_1_1);
        stream_contour_push(points, F64_ONE, F64_ONE);
    } else {
        # FLAT: (0.0,1.0),(1.0,1.0)
        stream_contour_push(points, 0, F64_ONE);
        stream_contour_push(points, F64_ONE, F64_ONE);
    }

    var n = vec_len(points);           # total slots (2 per point)
    var tc = f64_clamp(t, 0, F64_ONE);
    # A NaN t survives the clamp (measured: f64_clamp(NaN, lo, hi) -> NaN), every
    # comparison in the walk below is then false, and the fallthrough returned
    # base_f0 * <last multiplier> -- 240 Hz for HOWL at base 400. That is a
    # fabricated plausible f0 for an input that means nothing (F11). This
    # function returns an f64, not a "value or negative code" (-1 IS a NaN bit
    # pattern), so there is no code to return: propagate the NaN, which every
    # finiteness check downstream already catches. Only NaN escapes the clamp --
    # +/-inf are bounded to 1/0 and keep the oracle's behaviour untouched.
    if (prani_in_range(tc, 0, F64_ONE) == 0) { return f64_mul(base_f0, tc); }
    if (n == 0) { return base_f0; }
    var num_points = n / 2;
    var i = 0;
    while (i < num_points - 1) {
        var t0 = vec_get(points, i * 2);
        var v0 = vec_get(points, i * 2 + 1);
        var t1 = vec_get(points, (i + 1) * 2);
        var v1 = vec_get(points, (i + 1) * 2 + 1);
        if (f64_ge(tc, t0) == 1) {
            if (f64_le(tc, t1) == 1) {
                var frac = 0;
                if (f64_ge(f64_abs(f64_sub(t1, t0)), PRANI_EPSILON) == 1) {
                    frac = f64_div(f64_sub(tc, t0), f64_sub(t1, t0));
                }
                # base_f0 * (v0 + (v1 - v0) * frac)
                return f64_mul(base_f0, f64_add(v0, f64_mul(f64_sub(v1, v0), frac)));
            }
        }
        i = i + 1;
    }
    # past the last point: base_f0 * last multiplier
    return f64_mul(base_f0, vec_get(points, n - 1));
}

# push a (time, multiplier) point onto a flat contour vec.
fn stream_contour_push(v, t, mult) {
    vec_push(v, t);
    vec_push(v, mult);
}

# BARK/YELP: (0.0,1.2),(0.1,1.0),(1.0,0.8)
fn stream_contour_bark(points) {
    stream_contour_push(points, 0, PR_ST_1_2);
    stream_contour_push(points, PR_ST_0_1, F64_ONE);
    stream_contour_push(points, F64_ONE, PR_ST_0_8);
}

# ROAR/RUMBLE: (0.0,0.9),(0.15,1.2),(0.5,1.0),(1.0,0.7)
fn stream_contour_roar(points) {
    stream_contour_push(points, 0, PR_ST_0_9);
    stream_contour_push(points, PR_ST_0_15, PR_ST_1_2);
    stream_contour_push(points, PR_ST_0_5, F64_ONE);
    stream_contour_push(points, F64_ONE, PR_ST_0_7);
}

var PR_V_1_3   = 0x3FA66666;           # 1.3
var PR_V_0_7   = 0x3F333333;           # 0.7
var PR_V_1_4   = 0x3FB33333;           # 1.4
var PR_V_1_6   = 0x3FCCCCCD;           # 1.6
var PR_V_1_5   = 0x3FC00000;           # 1.5
var PR_V_0_9   = 0x3F666666;           # 0.9

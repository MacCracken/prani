# voice.cyr -- creature voice: species + individual variation + synthesis.
# Ports rust-old/src/voice.rs (the largest prani module, 705 lines). A
# CreatureVoice is an instance of a Species with individual characteristics
# (f0 offset, size, breathiness/jitter/shimmer, vocal effort) and the big
# vocalize_with_intent orchestration that drives the CreatureTract through a
# per-block synthesis loop plus a chain of post-processing effects.
#
# Requires (from the build/test unit, in dependency order): stdlib alloc/vec/
# math, hisab (ease_in_out_smooth), goonj, naad, svara, error.cyr, rng.cyr,
# dsp.cyr, vocalization.cyr, sequence.cyr, species.cyr, bridge.cyr, tract.cyr.
# Module files carry no `include` lines -- the entry orders them.
#
# NAMING (flat-namespace prefix): EVERY top-level fn here is `crvoice_`-prefixed
# (including the private helpers), because the dist bundle shares one flat
# namespace and a later module (stream) reuses some of them. Rust `voice::*`
# would collide with naad's `voice_*`, so the audit's naming contract fixes the
# `crvoice_` prefix. The struct names PitchContour / FormantTransitionContour /
# FormantBlend are distinct and collision-free.
#
# FLOATS: prani's Rust was f32; this port is f64 (svara/naad/hisab are f64-only,
# widening is forced). Integer literals via f64_from(n) (negatives via
# f64_neg(f64_from(n))); non-integer literals via the module-top IEEE-754 hex
# constants below (decimals in comments), one constant per distinct value.
#
# MUTATION / NO MOVE SEMANTICS: Rust's builder methods take `mut self` by value
# and return Self. Cyrius has no move semantics -- CreatureVoice is a heap ptr,
# so the builders mutate the struct in place (the breathiness/jitter/shimmer
# builders mutate the *params* ptr the voice holds) and return the same self ptr.
# Callers chain `v = crvoice_with_size(crvoice_new(...), s)` exactly as in Rust.
# vocalize_with_intent must NOT mutate the voice's own params, so it allocates a
# FRESH SpeciesParams copy (crvoice_clone_params) before adjusting breathiness.
#
# RESULT convention: crvoice_vocalize / crvoice_vocalize_with_intent return a
# heap vec ptr (large positive) on success, or a NEGATIVE PRANI_ERR_* on failure.
# supports-check failure -> PRANI_ERR_INVALID_VOCALIZATION. crtract_synthesize
# errors propagate (if prani_is_err(block)==1 return block).
#
# PARITY: exact svara-internal bit parity vs the f32 oracle is not attainable
# (f32->f64 diverges through svara's DSP), so tests assert structural +
# parity-meaningful properties (effective_f0 / contour interp / clamps / lombard
# exact; finiteness / length / determinism for the full synthesis paths). serde
# and tracing::trace! dropped.

# ================================================================
# Non-integer literal constants (IEEE-754 hex; decimals in comments).
# ================================================================
var PR_V_0_3   = 0x3fd3333333333333;   # 0.3
var PR_V_1_2   = 0x3ff3333333333333;   # 1.2
var PR_V_0_5   = 0x3fe0000000000000;   # 0.5
var PR_V_6_0   = 0x4018000000000000;   # 6.0
var PR_V_0_15  = 0x3fc3333333333333;   # 0.15
var PR_V_0_1   = 0x3fb999999999999a;   # 0.1
var PR_V_0_85  = 0x3feb333333333333;   # 0.85
var PR_V_0_8   = 0x3fe999999999999a;   # 0.8
var PR_V_1_3   = 0x3ff4cccccccccccd;   # 1.3
var PR_V_0_7   = 0x3fe6666666666666;   # 0.7
var PR_V_1_4   = 0x3ff6666666666666;   # 1.4
var PR_V_1_6   = 0x3ff999999999999a;   # 1.6
var PR_V_1_5   = 0x3ff8000000000000;   # 1.5
var PR_V_0_9   = 0x3feccccccccccccd;   # 0.9
var PR_V_0_25  = 0x3fd0000000000000;   # 0.25
var PR_V_0_75  = 0x3fe8000000000000;   # 0.75
var PR_V_1_1   = 0x3ff199999999999a;   # 1.1
var PR_V_0_4   = 0x3fd999999999999a;   # 0.4
var PR_V_0_2   = 0x3fc999999999999a;   # 0.2
var PR_V_0_6   = 0x3fe3333333333333;   # 0.6
var PR_V_1_78  = 0x3ffc7ae147ae147b;   # 1.78  canid biphonation interval (~minor 7th)
var PR_V_250_0 = 0x406f400000000000;   # 250.0 nasal anti-formant notch freq (Hz)
var PR_V_80_0  = 0x4054000000000000;   # 80.0  nasal notch bandwidth (Hz)
var PR_V_NEG_2 = 0xc000000000000000;   # -2.0  growl/rumble spectral offset
var PR_V_NEG_1 = 0xbff0000000000000;   # -1.0  roar spectral offset
var PR_V_2_0   = 0x4000000000000000;   # 2.0   hiss spectral offset
var PR_V_0_65  = 0x3fe4cccccccccccd;   # 0.65  trill AM base
var PR_V_0_35  = 0x3fd6666666666666;   # 0.35  trill AM depth
var PR_V_0_999 = 0x3feff7ced916872b;   # 0.999 notch pole-radius clamp ceiling
var PR_V_20_0  = 0x4034000000000000;   # 20.0  trill AM rate (Hz)
var PR_V_0_08  = 0x3fb47ae147ae147b;   # 0.08  roar envelope attack fraction
var PR_V_0_03  = 0x3f9eb851eb851eb8;   # 0.03  screech envelope attack fraction
var PR_V_0_05  = 0x3fa999999999999a;   # 0.05  jitter clamp ceiling / short-call attack+release
var PR_V_0_02  = 0x3f947ae147ae147b;   # 0.02  synthesis block duration (20ms)

# ================================================================
# CreatureVoice -- a creature's voice: species + individual variation.
#   species      : PRANI_SP_* constant
#   params       : SpeciesParams ptr (may be individually modified)
#   f0_offset    : individual f0 offset from species default (Hz)
#   size_scale   : individual size scaling (tract length + f0)
#   vocal_effort : 0.0 = whisper, 0.5 = normal, 1.0 = shout
# serde RESTORED via crvoice_to_json / crvoice_from_json_str (below): scalars as
# bit patterns + nested SpeciesParams (individual overrides preserved).
# ================================================================
#derive(accessors)
struct CreatureVoice {
    species; params; f0_offset; size_scale; vocal_effort;
}

# new(species) -- CreatureVoice::new. Default individual params: f0_offset 0,
# size_scale 1, vocal_effort 0.5, with the species' default vocal parameters.
#must_use
fn crvoice_new(species) {
    var self = alloc(sizeof(CreatureVoice));
    CreatureVoice_set_species(self, species);
    CreatureVoice_set_params(self, species_params(species));
    CreatureVoice_set_f0_offset(self, 0);
    CreatureVoice_set_size_scale(self, F64_ONE);
    CreatureVoice_set_vocal_effort(self, PR_V_0_5);
    return self;
}

# CreatureVoice serde -- restores the Rust `#[derive(Serialize, Deserialize)]`.
# f64 scalars (f0_offset/size_scale/vocal_effort) emitted as exact i64 BIT
# PATTERNS (lossless); `params` nested as a sub-object via the auto
# SpeciesParams_to_json and rebuilt with species_params_from_node (so individual
# breathiness/jitter/shimmer overrides survive the roundtrip). Idempotent.
fn crvoice_to_json(self, sb) {
    str_builder_add_cstr(sb, "{\"species\":");
    str_builder_add_int(sb, CreatureVoice_species(self));
    str_builder_add_cstr(sb, ",\"f0_offset\":");
    str_builder_add_int(sb, CreatureVoice_f0_offset(self));
    str_builder_add_cstr(sb, ",\"size_scale\":");
    str_builder_add_int(sb, CreatureVoice_size_scale(self));
    str_builder_add_cstr(sb, ",\"vocal_effort\":");
    str_builder_add_int(sb, CreatureVoice_vocal_effort(self));
    str_builder_add_cstr(sb, ",\"params\":");
    SpeciesParams_to_json(CreatureVoice_params(self), sb);
    str_builder_add_cstr(sb, "}");
    return 0;
}

fn crvoice_from_json_str(json) {
    var root = bayan_json_v_parse_str(json, strlen(json));
    var self = alloc(sizeof(CreatureVoice));
    CreatureVoice_set_species(self, bayan_json_v_int(bayan_json_v_obj_get(root, "species")));
    CreatureVoice_set_f0_offset(self, bayan_json_v_int(bayan_json_v_obj_get(root, "f0_offset")));
    CreatureVoice_set_size_scale(self, bayan_json_v_int(bayan_json_v_obj_get(root, "size_scale")));
    CreatureVoice_set_vocal_effort(self, bayan_json_v_int(bayan_json_v_obj_get(root, "vocal_effort")));
    CreatureVoice_set_params(self, species_params_from_node(bayan_json_v_obj_get(root, "params")));
    return self;
}

# with_f0_offset(self, offset) -- clamps offset to +/-(f0_max - f0_min) so the
# effective f0 stays within the species range. Mutates self, returns self.
#must_use
fn crvoice_with_f0_offset(self, offset) {
    var params = CreatureVoice_params(self);
    var range = f64_sub(SpeciesParams_f0_max(params), SpeciesParams_f0_min(params));
    CreatureVoice_set_f0_offset(self, f64_clamp(offset, f64_neg(range), range));
    return self;
}

# with_size(self, scale) -- clamps size scale to [0.1, 10.0]. >1 = larger
# creature (lower pitch, longer tract). Mutates self, returns self.
#must_use
fn crvoice_with_size(self, scale) {
    CreatureVoice_set_size_scale(self, f64_clamp(scale, PR_V_0_1, f64_from(10)));
    return self;
}

# with_breathiness(self, breathiness) -- clamps to [0, 1]; mutates the voice's
# params ptr in place (no move semantics). Returns self.
#must_use
fn crvoice_with_breathiness(self, breathiness) {
    SpeciesParams_set_breathiness(CreatureVoice_params(self), f64_clamp(breathiness, 0, F64_ONE));
    return self;
}

# with_jitter(self, jitter) -- clamps to [0, 0.05]; mutates params in place.
#must_use
fn crvoice_with_jitter(self, jitter) {
    SpeciesParams_set_jitter(CreatureVoice_params(self), f64_clamp(jitter, 0, PR_V_0_05));
    return self;
}

# with_shimmer(self, shimmer) -- clamps to [0, 0.1]; mutates params in place.
#must_use
fn crvoice_with_shimmer(self, shimmer) {
    SpeciesParams_set_shimmer(CreatureVoice_params(self), f64_clamp(shimmer, 0, PR_V_0_1));
    return self;
}

# with_vocal_effort(self, effort) -- clamps to [0, 1]. Mutates self, returns self.
#must_use
fn crvoice_with_vocal_effort(self, effort) {
    CreatureVoice_set_vocal_effort(self, f64_clamp(effort, 0, F64_ONE));
    return self;
}

# set_vocal_effort(self, effort) -- mutable effort update (real-time RTPC).
fn crvoice_set_vocal_effort(self, effort) {
    CreatureVoice_set_vocal_effort(self, f64_clamp(effort, 0, F64_ONE));
}

# vocal_effort(self) -- current vocal effort.
#must_use
fn crvoice_vocal_effort(self) {
    return CreatureVoice_vocal_effort(self);
}

# apply_lombard_effect(self, ambient_spl_db) -- involuntary effort increase in
# ambient noise (bridge_lombard_effort_boost), additive, clamped to [0, 1].
fn crvoice_apply_lombard_effect(self, ambient_spl_db) {
    var boost = bridge_lombard_effort_boost(ambient_spl_db);
    CreatureVoice_set_vocal_effort(self,
        f64_clamp(f64_add(CreatureVoice_vocal_effort(self), boost), 0, F64_ONE));
}

# species(self) -- the species constant.
#must_use
fn crvoice_species(self) {
    return CreatureVoice_species(self);
}

# effective_f0(self) -- (f0_default + f0_offset) / size_scale, clamped to the
# species [f0_min, f0_max]. Larger creatures have lower pitch.
#must_use
fn crvoice_effective_f0(self) {
    var params = CreatureVoice_params(self);
    var base = f64_add(SpeciesParams_f0_default(params), CreatureVoice_f0_offset(self));
    var scaled = f64_div(base, CreatureVoice_size_scale(self));
    return f64_clamp(scaled, SpeciesParams_f0_min(params), SpeciesParams_f0_max(params));
}

# effective_tract_scale(self) -- tract_scale * size_scale.
#must_use
fn crvoice_effective_tract_scale(self) {
    return f64_mul(SpeciesParams_tract_scale(CreatureVoice_params(self)), CreatureVoice_size_scale(self));
}

# ---- params copy helper -----------------------------------------------------

# clone_params(src) -- allocate a fresh SpeciesParams copy (deep field copy), so
# vocalize_with_intent's effort-adjusted breathiness does not mutate the voice's
# own params (Rust used `self.params.clone()`).
#must_use
fn crvoice_clone_params(src) {
    return species_params_make(
        SpeciesParams_apparatus(src),
        SpeciesParams_f0_min(src), SpeciesParams_f0_max(src), SpeciesParams_f0_default(src),
        SpeciesParams_tract_scale(src),
        SpeciesParams_formant0(src), SpeciesParams_formant1(src), SpeciesParams_formant2(src),
        SpeciesParams_bandwidth0(src), SpeciesParams_bandwidth1(src), SpeciesParams_bandwidth2(src),
        SpeciesParams_breathiness(src), SpeciesParams_jitter(src), SpeciesParams_shimmer(src),
        SpeciesParams_spectral_tilt(src), SpeciesParams_resonance_seed(src));
}

# ================================================================
# PitchContour -- how f0 varies over a call (base f0 * time-varying multiplier).
#   base   : base f0 (Hz)
#   points : flat vec [t0,v0, t1,v1, ...] of (normalized_time, f0_multiplier).
#            Rust used a static &[(f32,f32)]; the port builds a flat f64 vec per
#            vocalization inside crvoice_pitch_contour.
# ================================================================
#derive(accessors)
struct PitchContour { base; points; }

# ================================================================
# FormantBlend -- the (formants, bandwidths, blend) triple that
# FormantTransitionContour::at() returns. Rust returned ([f32;3],[f32;3],f32);
# the port wraps it in this 7-field struct (Cyrius fns return one value).
# ================================================================
#derive(accessors)
struct FormantBlend { f0; f1; f2; b0; b1; b2; blend; }

# ================================================================
# FormantTransitionContour -- how formants change during a vocalization (cat
# meow, wolf howl). keyframes is a flat vec of 8 f64 per keyframe:
#   [t, f0,f1,f2, b0,b1,b2, blend]
# indexed as base = k*8. Rust used a static &[(f32,[f32;3],[f32;3],f32)].
# ================================================================
#derive(accessors)
struct FormantTransitionContour { keyframes; }

# ---- PitchContour::f0_at ----------------------------------------------------

# PitchContour_f0_at(self, t) -- f0 at normalized time t (clamped [0,1]).
# Linear interpolation between contour points; empty -> base; past the last
# point -> base * last_multiplier.
#must_use
fn crvoice_pitch_contour_f0_at(self, t) {
    var base = PitchContour_base(self);
    var points = PitchContour_points(self);
    var n = vec_len(points);   # total slots (2 per point)
    var tc = f64_clamp(t, 0, F64_ONE);
    if (n == 0) { return base; }
    var num_points = n / 2;
    # iterate segments [i, i+1] for i in 0..num_points-1
    var i = 0;
    while (i < num_points - 1) {
        var t0 = vec_get(points, i * 2);
        var v0 = vec_get(points, i * 2 + 1);
        var t1 = vec_get(points, (i + 1) * 2);
        var v1 = vec_get(points, (i + 1) * 2 + 1);
        if (f64_ge(tc, t0) == 1) {
            if (f64_le(tc, t1) == 1) {
                var frac = 0;
                if (f64_ge(f64_abs(f64_sub(t1, t0)), PRANI_EPSILON) == 1) {
                    frac = f64_div(f64_sub(tc, t0), f64_sub(t1, t0));
                }
                # base * (v0 + (v1 - v0) * frac)
                return f64_mul(base, f64_add(v0, f64_mul(f64_sub(v1, v0), frac)));
            }
        }
        i = i + 1;
    }
    # past the last point: base * last multiplier
    return f64_mul(base, vec_get(points, n - 1));
}

# ---- pitch_contour ----------------------------------------------------------

# push a (time, multiplier) point onto a flat contour vec.
fn crvoice_contour_push(v, t, mult) {
    vec_push(v, t);
    vec_push(v, mult);
}

# pitch_contour(voc, base_f0) -- the vocalization's pitch contour. Builds the
# flat point vec from the static per-vocalization tables (transcribed verbatim
# from the oracle). Returns a PitchContour ptr.
#must_use
fn crvoice_pitch_contour(voc, base_f0) {
    var points = vec_new();
    if (voc == PRANI_VOC_HOWL) {
        # HOWL: (0.0,0.8),(0.3,1.3),(0.7,1.2),(1.0,0.6)
        crvoice_contour_push(points, 0, PR_V_0_8);
        crvoice_contour_push(points, PR_V_0_3, PR_V_1_3);
        crvoice_contour_push(points, PR_V_0_7, PR_V_1_2);
        crvoice_contour_push(points, F64_ONE, PR_V_0_6);
    } elif (voc == PRANI_VOC_BARK) {
        crvoice_pitch_contour_bark(points);
    } elif (voc == PRANI_VOC_YELP) {
        crvoice_pitch_contour_bark(points);
    } elif (voc == PRANI_VOC_ROAR) {
        crvoice_pitch_contour_roar(points);
    } elif (voc == PRANI_VOC_RUMBLE) {
        crvoice_pitch_contour_roar(points);
    } elif (voc == PRANI_VOC_WHINE) {
        # WHINE: (0.0,1.0),(0.5,1.4),(1.0,1.6)
        crvoice_contour_push(points, 0, F64_ONE);
        crvoice_contour_push(points, PR_V_0_5, PR_V_1_4);
        crvoice_contour_push(points, F64_ONE, PR_V_1_6);
    } elif (voc == PRANI_VOC_SCREECH) {
        # SCREECH: (0.0,1.5),(0.3,1.2),(1.0,0.7)
        crvoice_contour_push(points, 0, PR_V_1_5);
        crvoice_contour_push(points, PR_V_0_3, PR_V_1_2);
        crvoice_contour_push(points, F64_ONE, PR_V_0_7);
    } elif (voc == PRANI_VOC_TRILL) {
        # TRILL: (0.0,1.0),(0.25,1.1),(0.5,0.9),(0.75,1.1),(1.0,1.0)
        crvoice_contour_push(points, 0, F64_ONE);
        crvoice_contour_push(points, PR_V_0_25, PR_V_1_1);
        crvoice_contour_push(points, PR_V_0_5, PR_V_0_9);
        crvoice_contour_push(points, PR_V_0_75, PR_V_1_1);
        crvoice_contour_push(points, F64_ONE, F64_ONE);
    } else {
        # FLAT: (0.0,1.0),(1.0,1.0)
        crvoice_contour_push(points, 0, F64_ONE);
        crvoice_contour_push(points, F64_ONE, F64_ONE);
    }
    var self = alloc(sizeof(PitchContour));
    PitchContour_set_base(self, base_f0);
    PitchContour_set_points(self, points);
    return self;
}

# BARK/YELP: (0.0,1.2),(0.1,1.0),(1.0,0.8)
fn crvoice_pitch_contour_bark(points) {
    crvoice_contour_push(points, 0, PR_V_1_2);
    crvoice_contour_push(points, PR_V_0_1, F64_ONE);
    crvoice_contour_push(points, F64_ONE, PR_V_0_8);
}

# ROAR/RUMBLE: (0.0,0.9),(0.15,1.2),(0.5,1.0),(1.0,0.7)
fn crvoice_pitch_contour_roar(points) {
    crvoice_contour_push(points, 0, PR_V_0_9);
    crvoice_contour_push(points, PR_V_0_15, PR_V_1_2);
    crvoice_contour_push(points, PR_V_0_5, F64_ONE);
    crvoice_contour_push(points, F64_ONE, PR_V_0_7);
}

# ---- FormantTransitionContour::at -------------------------------------------

# push an 8-slot keyframe [t, f0,f1,f2, b0,b1,b2, blend] onto the flat vec.
fn crvoice_keyframe_push(v, t, f0, f1, f2, b0, b1, b2, blend) {
    vec_push(v, t);
    vec_push(v, f0);  vec_push(v, f1);  vec_push(v, f2);
    vec_push(v, b0);  vec_push(v, b1);  vec_push(v, b2);
    vec_push(v, blend);
}

# formant_transition_at(self, t) -- FormantTransitionContour::at. Interpolated
# (formants, bandwidths, blend) at normalized t, returned in a FormantBlend
# struct. Empty keyframes -> all-zero blend. Past the last keyframe -> the last
# keyframe's values.
#must_use
fn crvoice_formant_transition_at(self, t) {
    var kf = FormantTransitionContour_keyframes(self);
    var slots = vec_len(kf);          # 8 per keyframe
    var tc = f64_clamp(t, 0, F64_ONE);
    var out = alloc(sizeof(FormantBlend));
    if (slots == 0) {
        FormantBlend_set_f0(out, 0);  FormantBlend_set_f1(out, 0);  FormantBlend_set_f2(out, 0);
        FormantBlend_set_b0(out, 0);  FormantBlend_set_b1(out, 0);  FormantBlend_set_b2(out, 0);
        FormantBlend_set_blend(out, 0);
        return out;
    }
    var num_kf = slots / 8;
    var i = 0;
    while (i < num_kf - 1) {
        var a = i * 8;
        var b = (i + 1) * 8;
        var t0 = vec_get(kf, a);
        var t1 = vec_get(kf, b);
        if (f64_ge(tc, t0) == 1) {
            if (f64_le(tc, t1) == 1) {
                var frac = 0;
                if (f64_ge(f64_abs(f64_sub(t1, t0)), PRANI_EPSILON) == 1) {
                    frac = f64_div(f64_sub(tc, t0), f64_sub(t1, t0));
                }
                # linear interp of each of the 7 fields (offsets 1..8 within a keyframe)
                FormantBlend_set_f0(out, crvoice_lerp_kf(kf, a + 1, b + 1, frac));
                FormantBlend_set_f1(out, crvoice_lerp_kf(kf, a + 2, b + 2, frac));
                FormantBlend_set_f2(out, crvoice_lerp_kf(kf, a + 3, b + 3, frac));
                FormantBlend_set_b0(out, crvoice_lerp_kf(kf, a + 4, b + 4, frac));
                FormantBlend_set_b1(out, crvoice_lerp_kf(kf, a + 5, b + 5, frac));
                FormantBlend_set_b2(out, crvoice_lerp_kf(kf, a + 6, b + 6, frac));
                FormantBlend_set_blend(out, crvoice_lerp_kf(kf, a + 7, b + 7, frac));
                return out;
            }
        }
        i = i + 1;
    }
    # past the last keyframe: return its stored values
    var last = (num_kf - 1) * 8;
    FormantBlend_set_f0(out, vec_get(kf, last + 1));
    FormantBlend_set_f1(out, vec_get(kf, last + 2));
    FormantBlend_set_f2(out, vec_get(kf, last + 3));
    FormantBlend_set_b0(out, vec_get(kf, last + 4));
    FormantBlend_set_b1(out, vec_get(kf, last + 5));
    FormantBlend_set_b2(out, vec_get(kf, last + 6));
    FormantBlend_set_blend(out, vec_get(kf, last + 7));
    return out;
}

# lerp two flat-vec slots: v[ia] + (v[ib] - v[ia]) * frac.
#must_use
fn crvoice_lerp_kf(v, ia, ib, frac) {
    var x0 = vec_get(v, ia);
    var x1 = vec_get(v, ib);
    return f64_add(x0, f64_mul(f64_sub(x1, x0), frac));
}

# ---- formant_transition_contour ---------------------------------------------

# formant_transition_contour(voc, species) -- a FormantTransitionContour ptr for
# vocalizations with dynamic mouth shape, or 0 (== None) otherwise.
#   Cat Howl/Whine  -> CAT_MEOW_HOWL keyframes
#   Wolf/Dog Howl   -> WOLF_HOWL keyframes
#must_use
fn crvoice_formant_transition_contour(voc, species) {
    # Cat meow/howl: "m" (nasal, closed) -> "e"/"a" (open) -> "ow" (closing)
    if (species == PRANI_SP_CAT) {
        if (voc == PRANI_VOC_HOWL) { return crvoice_make_cat_meow_howl(); }
        if (voc == PRANI_VOC_WHINE) { return crvoice_make_cat_meow_howl(); }
        return 0;
    }
    # Wolf/Dog howl: gradual mouth opening then closing, subtle formant shift
    if (species == PRANI_SP_WOLF) {
        if (voc == PRANI_VOC_HOWL) { return crvoice_make_wolf_howl(); }
        return 0;
    }
    if (species == PRANI_SP_DOG) {
        if (voc == PRANI_VOC_HOWL) { return crvoice_make_wolf_howl(); }
        return 0;
    }
    return 0;
}

# CAT_MEOW_HOWL keyframes (verbatim from the oracle static table).
#must_use
fn crvoice_make_cat_meow_howl() {
    var kf = vec_new();
    # (0.0, [400,2000,3500], [150,200,250], 0.8)
    crvoice_keyframe_push(kf, 0,
        f64_from(400), f64_from(2000), f64_from(3500),
        f64_from(150), f64_from(200), f64_from(250), PR_V_0_8);
    # (0.4, [1000,2800,4500], [100,130,180], 1.0)
    crvoice_keyframe_push(kf, PR_V_0_4,
        f64_from(1000), f64_from(2800), f64_from(4500),
        f64_from(100), f64_from(130), f64_from(180), F64_ONE);
    # (1.0, [500,1800,3800], [140,180,220], 0.6)
    crvoice_keyframe_push(kf, F64_ONE,
        f64_from(500), f64_from(1800), f64_from(3800),
        f64_from(140), f64_from(180), f64_from(220), PR_V_0_6);
    var self = alloc(sizeof(FormantTransitionContour));
    FormantTransitionContour_set_keyframes(self, kf);
    return self;
}

# WOLF_HOWL keyframes (verbatim from the oracle static table).
#must_use
fn crvoice_make_wolf_howl() {
    var kf = vec_new();
    # (0.0, [420,1250,2100], [100,120,150], 0.0)
    crvoice_keyframe_push(kf, 0,
        f64_from(420), f64_from(1250), f64_from(2100),
        f64_from(100), f64_from(120), f64_from(150), 0);
    # (0.3, [500,1400,2300], [90,110,140], 0.6)
    crvoice_keyframe_push(kf, PR_V_0_3,
        f64_from(500), f64_from(1400), f64_from(2300),
        f64_from(90), f64_from(110), f64_from(140), PR_V_0_6);
    # (0.7, [480,1350,2200], [95,115,145], 0.4)
    crvoice_keyframe_push(kf, PR_V_0_7,
        f64_from(480), f64_from(1350), f64_from(2200),
        f64_from(95), f64_from(115), f64_from(145), PR_V_0_4);
    # (1.0, [400,1200,2000], [110,130,160], 0.3)
    crvoice_keyframe_push(kf, F64_ONE,
        f64_from(400), f64_from(1200), f64_from(2000),
        f64_from(110), f64_from(130), f64_from(160), PR_V_0_3);
    var self = alloc(sizeof(FormantTransitionContour));
    FormantTransitionContour_set_keyframes(self, kf);
    return self;
}

# ---- nasal_phase_fraction ---------------------------------------------------

# nasal_phase_fraction(voc, species) -- fraction of the call that is nasal from
# the start, or a NEGATIVE sentinel (-1) for None (valid fractions are >= 0).
#   Cat Howl/Whine  -> 0.2
#   Wolf/Dog Howl   -> 0.1
#must_use
fn crvoice_nasal_phase_fraction(voc, species) {
    if (species == PRANI_SP_CAT) {
        if (voc == PRANI_VOC_HOWL) { return PR_V_0_2; }
        if (voc == PRANI_VOC_WHINE) { return PR_V_0_2; }
        return f64_neg(F64_ONE);
    }
    if (species == PRANI_SP_WOLF) {
        if (voc == PRANI_VOC_HOWL) { return PR_V_0_1; }
        return f64_neg(F64_ONE);
    }
    if (species == PRANI_SP_DOG) {
        if (voc == PRANI_VOC_HOWL) { return PR_V_0_1; }
        return f64_neg(F64_ONE);
    }
    return f64_neg(F64_ONE);
}

# ---- apply_nasal_antiformant ------------------------------------------------

# apply_nasal_antiformant(samples, sample_rate, nasal_fraction) -- second-order
# IIR notch at ~250 Hz applied to the first nasal_fraction of the buffer, faded
# from full at the start to 0 by the end of the nasal phase. Mutates in place.
# cos(theta) computed via sin(pi/2 - theta) -- the oracle's cos-via-sin trick.
fn crvoice_apply_nasal_antiformant(samples, sample_rate, nasal_fraction) {
    var len = vec_len(samples);
    # nasal_len = (len as f32 * nasal_fraction) as usize
    var nasal_len = f64_to(f64_mul(f64_from(len), nasal_fraction));
    if (nasal_len == 0) { return 0; }

    var notch_freq = PR_V_250_0;
    var notch_bw = PR_V_80_0;
    # r = clamp(1 - (pi * notch_bw / sr), 0.5, 0.999)
    var r = f64_sub(F64_ONE, f64_div(f64_mul(F64_PI, notch_bw), sample_rate));
    r = f64_clamp(r, PR_V_0_5, PR_V_0_999);
    var theta = f64_div(f64_mul(F64_TAU, notch_freq), sample_rate);
    # cos_theta = sin(pi/2 - theta)
    var cos_theta = f64_sin(f64_sub(f64_div(F64_PI, F64_TWO), theta));

    # H(z) = (1 - 2cos z^-1 + z^-2) / (1 - 2r cos z^-1 + r^2 z^-2)
    var a1 = f64_mul(f64_mul(f64_neg(F64_TWO), r), cos_theta);
    var a2 = f64_mul(r, r);
    var b1 = f64_mul(f64_neg(F64_TWO), cos_theta);

    var x1 = 0;
    var x2 = 0;
    var y1 = 0;
    var y2 = 0;

    var i = 0;
    while (i < nasal_len) {
        var x0 = vec_get(samples, i);
        # y0 = x0 + b1*x1 + x2 - a1*y1 - a2*y2
        var y0 = f64_sub(
            f64_sub(f64_add(f64_add(x0, f64_mul(b1, x1)), x2), f64_mul(a1, y1)),
            f64_mul(a2, y2));
        x2 = x1;
        x1 = x0;
        y2 = y1;
        y1 = y0;
        # fade = 1 - i/nasal_len ; sample = sample*(1-fade) + y0*fade
        var fade = f64_sub(F64_ONE, f64_div(f64_from(i), f64_from(nasal_len)));
        var blended = f64_add(f64_mul(x0, f64_sub(F64_ONE, fade)), f64_mul(y0, fade));
        vec_set(samples, i, blended);
        i = i + 1;
    }
    return 0;
}

# ---- vocalization_spectral_offset -------------------------------------------

# vocalization_spectral_offset(voc) -- spectral tilt offset (dB/octave) layered
# on top of the species tilt. Negative = darker.
#must_use
fn crvoice_vocalization_spectral_offset(voc) {
    if (voc == PRANI_VOC_GROWL) { return PR_V_NEG_2; }
    if (voc == PRANI_VOC_RUMBLE) { return PR_V_NEG_2; }
    if (voc == PRANI_VOC_ROAR) { return PR_V_NEG_1; }
    if (voc == PRANI_VOC_SCREECH) { return PR_V_1_5; }
    if (voc == PRANI_VOC_CHIRP) { return PR_V_1_5; }
    if (voc == PRANI_VOC_HISS) { return PR_V_2_0; }
    if (voc == PRANI_VOC_TRILL) { return PR_V_0_5; }
    return 0;
}

# ---- apply_am_pattern -------------------------------------------------------

# apply_am_pattern(samples, voc, sample_rate) -- vocalization-specific AM.
# Bird trills get 20 Hz sinusoidal AM modulating between 0.3 and 1.0
# (0.65 + 0.35*sin). No-op for other vocalizations. Mutates in place.
fn crvoice_apply_am_pattern(samples, voc, sample_rate) {
    if (voc != PRANI_VOC_TRILL) { return 0; }
    var am_rate = PR_V_20_0;
    var n = vec_len(samples);
    var i = 0;
    while (i < n) {
        var t = f64_div(f64_from(i), sample_rate);
        var modulator = f64_add(PR_V_0_65,
            f64_mul(PR_V_0_35, f64_sin(f64_mul(f64_mul(F64_TAU, am_rate), t))));
        vec_set(samples, i, f64_mul(vec_get(samples, i), modulator));
        i = i + 1;
    }
    return 0;
}

# ---- apply_vocalization_envelope --------------------------------------------

# apply_vocalization_envelope(samples, voc, sample_rate) -- per-vocalization
# attack/release amplitude ramps (ease_in_out_smooth). sample_rate unused (kept
# for signature parity). Mutates in place.
#inline
fn crvoice_apply_vocalization_envelope(samples, voc, sample_rate) {
    var len = vec_len(samples);
    if (len == 0) { return 0; }

    # (attack_frac, release_frac) per vocalization type.
    var attack_frac = PR_V_0_1;
    var release_frac = PR_V_0_1;
    if (voc == PRANI_VOC_BARK) {
        attack_frac = PR_V_0_05;  release_frac = PR_V_0_1;
    } elif (voc == PRANI_VOC_YELP) {
        attack_frac = PR_V_0_05;  release_frac = PR_V_0_1;
    } elif (voc == PRANI_VOC_CHIRP) {
        attack_frac = PR_V_0_05;  release_frac = PR_V_0_1;
    } elif (voc == PRANI_VOC_HOWL) {
        attack_frac = PR_V_0_15;  release_frac = PR_V_0_3;
    } elif (voc == PRANI_VOC_GROWL) {
        attack_frac = PR_V_0_1;   release_frac = PR_V_0_1;
    } elif (voc == PRANI_VOC_RUMBLE) {
        attack_frac = PR_V_0_1;   release_frac = PR_V_0_1;
    } elif (voc == PRANI_VOC_PURR) {
        attack_frac = PR_V_0_1;   release_frac = PR_V_0_1;
    } elif (voc == PRANI_VOC_ROAR) {
        attack_frac = PR_V_0_08;  release_frac = PR_V_0_2;
    } elif (voc == PRANI_VOC_HISS) {
        attack_frac = PR_V_0_2;   release_frac = PR_V_0_3;
    } elif (voc == PRANI_VOC_TRILL) {
        attack_frac = PR_V_0_05;  release_frac = PR_V_0_05;
    } elif (voc == PRANI_VOC_STRIDULATE) {
        attack_frac = PR_V_0_05;  release_frac = PR_V_0_05;
    } elif (voc == PRANI_VOC_BUZZ) {
        attack_frac = PR_V_0_05;  release_frac = PR_V_0_05;
    } elif (voc == PRANI_VOC_WHINE) {
        attack_frac = PR_V_0_1;   release_frac = PR_V_0_2;
    } elif (voc == PRANI_VOC_SCREECH) {
        attack_frac = PR_V_0_03;  release_frac = PR_V_0_15;
    }

    # attack_len = (len as f32 * attack_frac) as usize; same for release.
    var attack_len = f64_to(f64_mul(f64_from(len), attack_frac));
    var release_len = f64_to(f64_mul(f64_from(len), release_frac));

    # attack ramp over take(min(attack_len, len))
    var a_lim = attack_len;
    if (len < a_lim) { a_lim = len; }
    var a_denom = attack_len;
    if (a_denom < 1) { a_denom = 1; }   # attack_len.max(1)
    var i = 0;
    while (i < a_lim) {
        var t = f64_div(f64_from(i), f64_from(a_denom));
        vec_set(samples, i, f64_mul(vec_get(samples, i), ease_in_out_smooth(t)));
        i = i + 1;
    }

    # release ramp: idx = len-1-i for i in 0..min(release_len, len)
    var r_lim = release_len;
    if (len < r_lim) { r_lim = len; }
    var r_denom = release_len;
    if (r_denom < 1) { r_denom = 1; }   # release_len.max(1)
    var j = 0;
    while (j < r_lim) {
        var idx = len - 1 - j;
        var tr = f64_div(f64_from(j), f64_from(r_denom));
        vec_set(samples, idx, f64_mul(vec_get(samples, idx), ease_in_out_smooth(tr)));
        j = j + 1;
    }
    return 0;
}

# ---- synthesize_cat_purr ----------------------------------------------------

# synthesize_cat_purr(self, sample_rate, num_samples, modifiers) -- special
# 25-30 Hz laryngeal-muscle-cycling purr path. purr_f0 = clamp(27/size_scale,
# 20, 35). Amplitude = amplitude_scale * effort_amp; then the purr envelope.
# Returns a vec ptr (crtract_synthesize_purr never fails).
fn crvoice_synthesize_cat_purr(self, sample_rate, num_samples, modifiers) {
    var tract = crtract_new(CreatureVoice_params(self), sample_rate);
    # purr f0 25-30 Hz, size-scaled; larger cat = slightly lower purr.
    var purr_f0 = f64_clamp(f64_div(f64_from(27), CreatureVoice_size_scale(self)),
        f64_from(20), f64_from(35));
    var samples = crtract_synthesize_purr(tract, num_samples, purr_f0);
    # amplitude scaling from intent x vocal effort
    var effort_amp = f64_add(PR_V_0_3, f64_mul(CreatureVoice_vocal_effort(self), PR_V_1_2));
    var amp = f64_mul(IntentModifiers_amplitude_scale(modifiers), effort_amp);
    var n = vec_len(samples);
    var i = 0;
    while (i < n) {
        vec_set(samples, i, f64_mul(vec_get(samples, i), amp));
        i = i + 1;
    }
    # purr envelope: gentle fade-in/fade-out
    crvoice_apply_vocalization_envelope(samples, PRANI_VOC_PURR, sample_rate);
    return samples;
}

# ---- vocalize / vocalize_with_intent ----------------------------------------

# vocalize(self, voc, sample_rate, duration) -- synthesize with Idle intent.
# Returns a vec ptr on success or a negative PRANI_ERR_* on failure.
fn crvoice_vocalize(self, voc, sample_rate, duration) {
    return crvoice_vocalize_with_intent(self, voc, PRANI_INTENT_IDLE, sample_rate, duration);
}

# vocalize_with_intent(self, voc, intent, sample_rate, duration) -- the big
# orchestration. Validates the species can produce the vocalization, applies
# intent + vocal-effort modulations, runs the per-block tract synthesis loop,
# then the post-processing effect chain (subharmonics/chaos, fire-breath,
# biphonation, nasal anti-formant, AM, spectral tilt, amplitude, envelope).
# Returns a vec ptr on success or a negative PRANI_ERR_* on failure.
fn crvoice_vocalize_with_intent(self, voc, intent, sample_rate, duration) {
    var species = CreatureVoice_species(self);
    var params = CreatureVoice_params(self);

    # validate the species can produce this vocalization
    if (species_supports_vocalization(species, voc) == 0) {
        return PRANI_ERR_INVALID_VOCALIZATION;
    }

    var modifiers = prani_intent_modifiers(intent);
    var f0 = f64_mul(crvoice_effective_f0(self), IntentModifiers_pitch_scale(modifiers));
    var effective_duration = f64_mul(duration, IntentModifiers_duration_scale(modifiers));
    # num_samples = (effective_duration * sample_rate) as usize
    var num_samples = f64_to(f64_mul(effective_duration, sample_rate));

    # vocal effort modulations
    var effort = CreatureVoice_vocal_effort(self);
    var effort_amp = f64_add(PR_V_0_3, f64_mul(effort, PR_V_1_2));
    var effort_tilt_offset = f64_mul(f64_sub(effort, PR_V_0_5), PR_V_6_0);        # -3..+3
    var effort_breathiness_delta = f64_mul(f64_abs(f64_sub(effort, PR_V_0_5)), PR_V_0_3);

    # Ports voice.rs `trace!(... "synthesizing creature vocalization")` → sakshi.
    prani_log_debug("prani: synthesizing creature vocalization");

    # cat purr special path (25-30 Hz laryngeal muscle cycling)
    if (voc == PRANI_VOC_PURR) {
        if (species == PRANI_SP_CAT) {
            return crvoice_synthesize_cat_purr(self, sample_rate, num_samples, modifiers);
        }
    }

    # working copy of params with effort-adjusted breathiness (do NOT mutate the
    # voice's own params -- Rust cloned; here we allocate a fresh copy).
    var effort_params = crvoice_clone_params(params);
    SpeciesParams_set_breathiness(effort_params,
        f64_clamp(f64_add(SpeciesParams_breathiness(effort_params), effort_breathiness_delta), 0, F64_ONE));

    var tract = crtract_new(effort_params, sample_rate);

    # formant transition contour (0 == None)
    var formant_contour = crvoice_formant_transition_contour(voc, species);

    # vocalization-specific pitch contour
    var contour = crvoice_pitch_contour(voc, f0);
    # block_size = (sample_rate * 0.02) as usize -- 20ms blocks
    var block_size = f64_to(f64_mul(sample_rate, PR_V_0_02));
    var samples = vec_new();

    # syringeal source-filter coupling precomputes (species F1..F3 / B1..B3)
    var is_syringeal = 0;
    if (SpeciesParams_apparatus(params) == PRANI_APP_SYRINGEAL) { is_syringeal = 1; }
    var sf0 = SpeciesParams_formant0(params);
    var sf1 = SpeciesParams_formant1(params);
    var sf2 = SpeciesParams_formant2(params);
    var sb0 = SpeciesParams_bandwidth0(params);
    var sb1 = SpeciesParams_bandwidth1(params);
    var sb2 = SpeciesParams_bandwidth2(params);

    var num_samples_max = num_samples;
    if (num_samples_max < 1) { num_samples_max = 1; }   # num_samples.max(1)

    var rendered = 0;
    while (rendered < num_samples) {
        var remaining = num_samples - rendered;
        var block_len = block_size;
        if (remaining < block_len) { block_len = remaining; }   # block_size.min(remaining)
        var t = f64_div(f64_from(rendered), f64_from(num_samples_max));
        var block_f0 = crvoice_pitch_contour_f0_at(contour, t);

        # formant transition if this vocalization has one
        if (formant_contour != 0) {
            var fb = crvoice_formant_transition_at(formant_contour, t);
            var tf = vec_new();
            vec_push(tf, FormantBlend_f0(fb));
            vec_push(tf, FormantBlend_f1(fb));
            vec_push(tf, FormantBlend_f2(fb));
            var tb = vec_new();
            vec_push(tb, FormantBlend_b0(fb));
            vec_push(tb, FormantBlend_b1(fb));
            vec_push(tb, FormantBlend_b2(fb));
            crtract_set_formant_blend(tract, tf, tb, FormantBlend_blend(fb));
        }

        # syringeal source-filter coupling: nudge F1 toward block_f0 (40%).
        if (is_syringeal == 1) {
            var coupled_f1 = f64_add(sf0, f64_mul(f64_sub(block_f0, sf0), PR_V_0_4));
            var ctf = vec_new();
            vec_push(ctf, coupled_f1);
            vec_push(ctf, sf1);
            vec_push(ctf, sf2);
            var ctb = vec_new();
            vec_push(ctb, sb0);
            vec_push(ctb, sb1);
            vec_push(ctb, sb2);
            crtract_set_formant_blend(tract, ctf, ctb, F64_ONE);
        }

        # non-stationary perturbation: jitter/shimmer boost at boundaries + urgency
        var boundary_boost = F64_ONE;
        if (f64_lt(t, PR_V_0_1) == 1) {
            # 1 + (1 - t/0.1) * 0.5
            boundary_boost = f64_add(F64_ONE,
                f64_mul(f64_sub(F64_ONE, f64_div(t, PR_V_0_1)), PR_V_0_5));
        } elif (f64_gt(t, PR_V_0_85) == 1) {
            # 1 + (t - 0.85)/0.15 * 0.5
            boundary_boost = f64_add(F64_ONE,
                f64_mul(f64_div(f64_sub(t, PR_V_0_85), PR_V_0_15), PR_V_0_5));
        }
        var perturbation_scale = f64_add(boundary_boost, IntentModifiers_urgency(modifiers));

        var options = crtract_options_new(0, perturbation_scale);
        var block = crtract_synthesize(tract, block_f0, block_len, options);
        if (prani_is_err(block) == 1) { return block; }
        # samples.extend_from_slice(&block)
        var bn = vec_len(block);
        var bi = 0;
        while (bi < bn) {
            vec_push(samples, vec_get(block, bi));
            bi = bi + 1;
        }
        rendered = rendered + block_len;
    }

    # ---- post-processing effect chain (order matters) -----------------------
    var total = vec_len(samples);

    # 1. subharmonics + deterministic chaos (Lion / Dragon / Crocodilian).
    if (crvoice_species_has_subharmonics(species) == 1) {
        var sub_f0 = f64_mul(f0, PR_V_0_5);
        var chaos_rng = prani_rng_new(species_params_resonance_seed(params) + 0xCA05);
        var i = 0;
        while (i < total) {
            var t_norm = f64_div(f64_from(i), f64_from(num_samples_max));
            var t_sec = f64_div(f64_from(i), sample_rate);
            # subharmonic envelope: peaks 0.3-0.7 of the call
            var sub_env = F64_ONE;
            if (f64_lt(t_norm, PR_V_0_15) == 1) {
                sub_env = f64_div(t_norm, PR_V_0_15);
            } elif (f64_gt(t_norm, PR_V_0_8) == 1) {
                sub_env = f64_div(f64_sub(F64_ONE, t_norm), PR_V_0_2);
            }
            var sub_amp = f64_mul(PR_V_0_4, sub_env);
            var s = f64_add(vec_get(samples, i),
                f64_mul(f64_sin(f64_mul(f64_mul(F64_TAU, sub_f0), t_sec)), sub_amp));
            # deterministic chaos during peak (sub_env > 0.6)
            if (f64_gt(sub_env, PR_V_0_6) == 1) {
                var chaos_intensity = f64_div(f64_sub(sub_env, PR_V_0_6), PR_V_0_4);
                var chaos_noise = f64_mul(f64_mul(prani_rng_next_f32(chaos_rng), PR_V_0_15), chaos_intensity);
                s = f64_add(s, chaos_noise);
            }
            vec_set(samples, i, s);
            i = i + 1;
        }
    }

    # 2. dragon fire-breath: broadband turbulent noise mixed in.
    if (species == PRANI_SP_DRAGON) {
        var fire_rng = prani_rng_new(species_params_resonance_seed(params) + 0xF12E);
        var fire_amp = f64_mul(SpeciesParams_breathiness(params), PR_V_0_4);
        var i2 = 0;
        while (i2 < total) {
            var tf2 = f64_div(f64_from(i2), f64_from(num_samples_max));
            var fire_env = F64_ONE;
            if (f64_lt(tf2, PR_V_0_2) == 1) {
                fire_env = f64_div(tf2, PR_V_0_2);
            } elif (f64_gt(tf2, PR_V_0_8) == 1) {
                fire_env = f64_div(f64_sub(F64_ONE, tf2), PR_V_0_2);
            }
            var noise = prani_rng_next_f32(fire_rng);
            vec_set(samples, i2,
                f64_add(vec_get(samples, i2), f64_mul(f64_mul(noise, fire_amp), fire_env)));
            i2 = i2 + 1;
        }
    }

    # 3. biphonation for canids (Wolf/Dog Howl/Whine): second independent pitch.
    if (crvoice_species_is_canid(species) == 1) {
        if (crvoice_voc_is_howl_or_whine(voc) == 1) {
            var bipho_f0 = f64_mul(f0, PR_V_1_78);   # ~minor seventh
            var bipho_amp = PR_V_0_15;
            var i3 = 0;
            while (i3 < total) {
                var t_sec3 = f64_div(f64_from(i3), sample_rate);
                var t_norm3 = f64_div(f64_from(i3), f64_from(num_samples_max));
                # biphonation appears in the middle: t_norm in [0.3, 0.8]
                var bipho_env = 0;
                if (f64_ge(t_norm3, PR_V_0_3) == 1) {
                    if (f64_le(t_norm3, PR_V_0_8) == 1) {
                        var mid = f64_div(f64_sub(t_norm3, PR_V_0_3), PR_V_0_5);
                        if (f64_lt(mid, PR_V_0_3) == 1) {
                            bipho_env = f64_div(mid, PR_V_0_3);
                        } elif (f64_gt(mid, PR_V_0_7) == 1) {
                            bipho_env = f64_div(f64_sub(F64_ONE, mid), PR_V_0_3);
                        } else {
                            bipho_env = F64_ONE;
                        }
                    }
                }
                vec_set(samples, i3, f64_add(vec_get(samples, i3),
                    f64_mul(f64_mul(f64_sin(f64_mul(f64_mul(F64_TAU, bipho_f0), t_sec3)), bipho_amp), bipho_env)));
                i3 = i3 + 1;
            }
        }
    }

    # 4. nasal anti-formant (spectral notch) during nasal phases (>= 0 sentinel).
    var nasal_phase = crvoice_nasal_phase_fraction(voc, species);
    if (f64_ge(nasal_phase, 0) == 1) {
        crvoice_apply_nasal_antiformant(samples, sample_rate, nasal_phase);
    }

    # 5. vocalization-specific AM patterns (bird trills).
    crvoice_apply_am_pattern(samples, voc, sample_rate);

    # 6. spectral tilt: species base + vocalization + vocal effort.
    var vocalization_tilt = crvoice_vocalization_spectral_offset(voc);
    var total_tilt = f64_add(f64_add(SpeciesParams_spectral_tilt(params), vocalization_tilt), effort_tilt_offset);
    crtract_apply_spectral_tilt(samples, total_tilt, sample_rate);

    # 7. amplitude scaling from intent x vocal effort.
    var amp = f64_mul(IntentModifiers_amplitude_scale(modifiers), effort_amp);
    var ai = 0;
    while (ai < total) {
        vec_set(samples, ai, f64_mul(vec_get(samples, ai), amp));
        ai = ai + 1;
    }

    # 8. amplitude envelope based on vocalization shape.
    crvoice_apply_vocalization_envelope(samples, voc, sample_rate);

    return samples;
}

# ---- small predicate helpers (matches! arms) --------------------------------

# species produces subharmonics (Lion / Dragon / Crocodilian).
#must_use
fn crvoice_species_has_subharmonics(species) {
    if (species == PRANI_SP_LION) { return 1; }
    if (species == PRANI_SP_DRAGON) { return 1; }
    if (species == PRANI_SP_CROCODILIAN) { return 1; }
    return 0;
}

# canid species (Wolf / Dog).
#must_use
fn crvoice_species_is_canid(species) {
    if (species == PRANI_SP_WOLF) { return 1; }
    if (species == PRANI_SP_DOG) { return 1; }
    return 0;
}

# vocalization is Howl or Whine.
#must_use
fn crvoice_voc_is_howl_or_whine(voc) {
    if (voc == PRANI_VOC_HOWL) { return 1; }
    if (voc == PRANI_VOC_WHINE) { return 1; }
    return 0;
}

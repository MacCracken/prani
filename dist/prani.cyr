var PR_V_1_78  = 0x3FE3D70A;           # 1.78  canid biphonation interval (~minor 7th)
var PR_V_250_0 = 0x437A0000;           # 250.0 nasal anti-formant notch freq (Hz)
var PR_V_80_0  = 0x42A00000;           # 80.0  nasal notch bandwidth (Hz)
var PR_V_NEG_2 = 0xC0000000;           # -2.0  growl/rumble spectral offset
var PR_V_NEG_1 = 0xBF800000;           # -1.0  roar spectral offset

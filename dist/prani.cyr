# prani.cyr -- bundled distribution
# Version: 2.0.8
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# --- error.cyr ---

# error.cyr -- prani error codes + shared DSP tolerances and base helpers.
# L0 base module: included FIRST by every build/test entry. Modules never
# `include` each other -- the entry file orders them.
#
# Ports 2.0.3:rust-old/src/error.rs (the `PraniError` enum +
# `From<SvaraError>`). Rust carried a String payload per variant; the Cyrius
# port uses integer codes -- fallible functions return PRANI_ERR_NONE (0) on
# success or a negative code on failure; diagnostic text via prani_err_name().
#
# NAMING: every prani top-level symbol is `prani_`/`PRANI_`/`Pr`-prefixed so
# the prani distlib coexists with svara + naad bundles in one flat namespace
# (svara exports svara_*, naad exports validate_*/flush_denormal/ERR_NONE).
#
# FLOATS: prani's Rust was f32; the Cyrius port is f64 throughout (svara/naad/
# hisab are f64-only, widening is forced and improves precision). PRANI_EPSILON
# preserves the f32::EPSILON (2^-23) tolerance the Rust tests used, promoted to
# f64. Test tolerances loosened vs the f32 oracle where bit-exactness isn't
# meaningful.

# ================================================================
# Error codes (was `enum PraniError`). One per Rust variant, in order.
# ================================================================
var PRANI_ERR_NONE                 = 0;
var PRANI_ERR_INVALID_TRACT        = (0 - 1);   # vocal tract parameter out of range
var PRANI_ERR_INVALID_VOCALIZATION = (0 - 2);   # vocalization parameter invalid
var PRANI_ERR_INVALID_SPECIES      = (0 - 3);   # species configuration invalid
var PRANI_ERR_SYNTHESIS_FAILED     = (0 - 4);   # a synthesis step failed
var PRANI_ERR_SVARA                = (0 - 5);   # underlying svara operation failed

# ================================================================
# Shared f64 tolerances / sentinels (IEEE-754 bit patterns). Exported for
# consumers (tract clamps, tests). PRANI_EPSILON = f32::EPSILON promoted.
# ================================================================
var PRANI_EPSILON = 0x3E80000000000000;   # f32::EPSILON = 2^-23 ~ 1.192e-7
var PRANI_POS_INF = 0x7FF0000000000000;   # +inf
var PRANI_NEG_INF = 0xFFF0000000000000;   # -inf

# 1 if `code` is an error (negative), 0 otherwise.
#must_use
fn prani_is_err(code) {
    if (code < 0) { return 1; }
    return 0;
}

# Static name for an error code (diagnostics / logging).
#must_use
fn prani_err_name(code) {
    if (code == PRANI_ERR_NONE) { return "none"; }
    if (code == PRANI_ERR_INVALID_TRACT) { return "invalid tract parameter"; }
    if (code == PRANI_ERR_INVALID_VOCALIZATION) { return "invalid vocalization"; }
    if (code == PRANI_ERR_INVALID_SPECIES) { return "invalid species"; }
    if (code == PRANI_ERR_SYNTHESIS_FAILED) { return "synthesis failed"; }
    if (code == PRANI_ERR_SVARA) { return "svara error"; }
    return "unknown error";
}

# Map a svara error code (svara's own SVARA_ERR_* are negative) to
# PRANI_ERR_SVARA. Ports `impl From<svara::error::SvaraError> for PraniError`.
# Any nonzero svara code becomes the wrapping prani code; 0 (none) passes.
#must_use
fn prani_from_svara(svara_code) {
    if (svara_code == 0) { return PRANI_ERR_NONE; }
    return PRANI_ERR_SVARA;
}

# Finite test: 1 iff x is neither +/-inf nor NaN. abs(x) < +inf holds for
# finite x, fails for infinities (inf < inf is false) and NaN (any NaN
# compare is false). Mirrors Rust `f32::is_finite`.
#must_use
fn prani_is_finite(x) {
    return f64_lt(f64_abs(x), PRANI_POS_INF);
}

# ================================================================
# Input-range guards (2.0.5). Why these exist, measured 2026-08-31:
#
#   f64_clamp(NaN, lo, hi) -> NaN          NaN passes every clamp in the tree
#   f64_clamp(+inf, lo, hi) -> hi          infinities ARE bounded by clamp
#   f64_clamp(-inf, lo, hi) -> lo
#   f64_to(NaN) == f64_to(+inf) == f64_to(-inf) == i64::MIN
#
# So the hazard at a clamp site is NaN specifically, not non-finiteness in
# general -- and any loop bound derived from f64_to(non-finite) goes NEGATIVE,
# which is why the observable symptom is a silently EMPTY buffer rather than a
# crash or a runaway allocation. Audit finding F11.
#
# These return 1 for "acceptable" and 0 for "reject", so a call site reads
#   if (prani_is_finite(x) == 0) { return PRANI_ERR_INVALID_TRACT; }
# and the error code stays the caller's choice -- there is no generic
# "bad parameter" code, deliberately: the oracle's five variants already carry
# the range meaning by category (PraniError::InvalidTract is documented as
# "a vocal tract parameter is out of valid range").
# ================================================================

# 1 iff both are finite.
#must_use
fn prani_finite2(a, b) {
    if (prani_is_finite(a) == 0) { return 0; }
    return prani_is_finite(b);
}

# 1 iff all three are finite.
#must_use
fn prani_finite3(a, b, c) {
    if (prani_is_finite(a) == 0) { return 0; }
    return prani_finite2(b, c);
}

# 1 iff x is finite and lo <= x <= hi. Rejects NaN (every comparison against
# NaN is false, so the two f64_ge/f64_le tests both fail).
#must_use
fn prani_in_range(x, lo, hi) {
    if (prani_is_finite(x) == 0) { return 0; }
    if (f64_ge(x, lo) == 0) { return 0; }
    return f64_le(x, hi);
}

# 1 iff x is finite and strictly greater than 0. The common case for a
# duration, a sample rate, a distance or a scale factor used as a divisor.
#must_use
fn prani_is_positive(x) {
    if (prani_is_finite(x) == 0) { return 0; }
    return f64_gt(x, 0);
}

# 1 iff x is finite and >= 0 (a duration of exactly 0 is legal -- the oracle's
# test_zero_duration_synthesis asserts an empty buffer, not an error).
#must_use
fn prani_is_non_negative(x) {
    if (prani_is_finite(x) == 0) { return 0; }
    return f64_ge(x, 0);
}

# --- logging.cyr ---

# logging.cyr -- structured logging, wired through sakshi.
#
# The Rust crate emitted diagnostics via `tracing` (warn!/error!/trace!, gated
# behind the `logging` feature). The Cyrius port wires them for real via sakshi
# (same pattern garjan/src/logging.cyr and goonj/src/logging.cyr use). Logging is
# always compiled in; verbosity is controlled at runtime with sakshi_set_level.
# These thin wrappers take a NUL-terminated cstring and forward (ptr, len) to
# sakshi. They are called for their side effect (not #must_use); each returns 0.
#
# Requires the sakshi bundle (resolved from cyrius.cyml [deps.sakshi]) + strlen
# (stdlib). The module file has no `include` lines.
#
# Mapping from the Rust oracle's tracing calls:
#   dsp.rs   tracing::error!("naad backend error")            -> prani_log_error
#   tract.rs tracing::warn!("species formants out of range")  -> prani_log_warn
#   voice.rs trace!("synthesizing creature vocalization")     -> prani_log_debug

# The five level wrappers. Each takes a NUL-terminated cstring, forwards
# (ptr, len) to the matching sakshi sink, and returns 0 -- they are called for
# their side effect, so none is #must_use. Verbosity is a RUNTIME choice
# (sakshi_set_level); nothing here is compiled out, which is why the message
# must stay a literal rather than something built per call on a hot path.
# `msg` must not be 0: these forward to strlen.
# fatal -- an unrecoverable condition; prani itself never calls this.
fn prani_log_fatal(msg) { sakshi_fatal(msg, strlen(msg)); return 0; }
# error -- a synthesis step failed and an error code is being returned.
fn prani_log_error(msg) { sakshi_error(msg, strlen(msg)); return 0; }
# warn -- degraded but continuing (ports tract.rs's out-of-range formants).
fn prani_log_warn(msg)  { sakshi_warn(msg, strlen(msg));  return 0; }
# info -- lifecycle notes; prani itself never calls this.
fn prani_log_info(msg)  { sakshi_info(msg, strlen(msg));  return 0; }
# debug -- per-call synthesis trace (ports voice.rs's tracing::trace!).
fn prani_log_debug(msg) { sakshi_debug(msg, strlen(msg)); return 0; }

# --- rng.cyr ---

# rng.cyr -- deterministic PCG32 PRNG for stochastic creature synthesis.
# Ports 2.0.3:rust-old/src/rng.rs (Rng struct + PCG32). Seedable for
# reproducible jitter/shimmer/breathiness across tract turbulence and
# call-pattern timing. There is no seedable float RNG in the Cyrius stdlib,
# so this is hand-ported (same PCG32 svara uses; prani's rng.rs and svara's
# rng.rs are identical).
#
# u64 semantics on i64: wrapping_mul/wrapping_add == plain `*`/`+` (i64 wraps
# two's-complement, bit-identical to u64). `>>` is LOGICAL (zero-fill) == u64
# shift. u32 truncation == `& 0xFFFFFFFF`.
#
# PARITY: next_f32's doc comment claims [-1.0, 1.0] but the Rust CODE yields
# [0.0, 1.0) -- `(next_u32() >> 1) as i32` is always non-negative. The code
# (the oracle) is ported, not the comment. Callers wanting bipolar noise do
# `2*next_f32() - 1` themselves. f32->f64 promotion: Rust used
# `1.0 / i32::MAX as f32` which rounds i32::MAX to 2^31, so the scale is
# exactly 2^-31.
#
# serde: Rng was Serialize/Deserialize (state persistence). RESTORED via
# #derive(Serialize) — PrRng_to_json / _from_json_str; the restored generator
# resumes the exact stream (tested in tests/rng.tcyr).

var PRANI_RNG_DEFAULT_SEED = 42;                    # default deterministic seed

var PRANI_PCG_MULT   = 6_364_136_223_846_793_005;   # PCG32 LCG multiplier
var PRANI_U32_MASK   = 0xFFFFFFFF;                   # low 32 bits
var PRANI_INV_I32MAX = 0x3E00000000000000;          # 2^-31 = 1.0 / (i32::MAX as f32)

# Fields TYPED (i64 u64-slots) for #derive(Serialize) — auto-generates
# PrRng_to_json / PrRng_from_json_str, porting the Rust `#[derive(Serialize,
# Deserialize)]` on Rng (state persistence for reproducible streams).
#derive(accessors)
#derive(Serialize)
struct PrRng {
    state: i64;
    inc: i64;
}

# next_u32 -- PCG32 output function. Defined before its callers (single-pass).
# NOT #must_use: it advances internal state, and prani_rng_new intentionally
# discards two warm-up draws during seeding.
#inline
fn prani_rng_next_u32(self) {
    var old_state = PrRng_state(self);
    # state = old * MULT + inc  (u64 wrapping via i64 wrap)
    PrRng_set_state(self, old_state * PRANI_PCG_MULT + PrRng_inc(self));
    # xor_shifted = (((old >> 18) ^ old) >> 27) as u32
    var xor_shifted = (((old_state >> 18) ^ old_state) >> 27) & PRANI_U32_MASK;
    # rot = (old >> 59) as u32   (top 5 bits -> 0..31)
    var rot = (old_state >> 59) & 31;
    # rotate-right by rot: (x >> rot) | (x << ((-rot) & 31)), masked to u32
    var neg = (0 - rot) & 31;
    return ((xor_shifted >> rot) | (xor_shifted << neg)) & PRANI_U32_MASK;
}

# new(seed) -- PCG32 seeding (prani's exact sequence). Calls next_u32 twice.
#must_use
fn prani_rng_new(seed) {
    var self = alloc(sizeof(PrRng));
    PrRng_set_state(self, 0);
    PrRng_set_inc(self, (seed << 1) | 1);
    prani_rng_next_u32(self);
    PrRng_set_state(self, PrRng_state(self) + seed);   # wrapping_add(seed)
    prani_rng_next_u32(self);
    return self;
}

# next_f32 -- value in [0.0, 1.0). bits = (next_u32() >> 1) in [0, 2^31-1],
# scaled by 2^-31. Matches the Rust code (not its [-1,1] doc comment).
#inline
#must_use
fn prani_rng_next_f32(self) {
    var bits = prani_rng_next_u32(self) >> 1;
    return f64_mul(f64_from(bits), PRANI_INV_I32MAX);
}

# --- dsp.cyr ---

# dsp.cyr -- shared DSP primitives for creature vocal synthesis.
# Ports 2.0.3:rust-old/src/dsp.rs: a single-pole DC blocker (applied to all
# synthesis output) + naad error mapping. Was `pub(crate)`.
#
# Requires (from the build/test unit): error.cyr (PRANI_ERR_*, prani_is_finite)
# + logging.cyr (prani_log_error) + stdlib alloc/vec. The module file itself has
# no `include` lines.
#
# serde: DcBlocker was Serialize/Deserialize in Rust; RESTORED via
# #derive(Serialize) (f64 fields typed i64 so their exact bit patterns
# serialize losslessly). Roundtrip tested in tests/dsp.tcyr.
#
# ================================================================
# INPUT RANGES (2.0.5). dsp is a CRATE-PRIVATE module -- the oracle's
# `pub(crate) struct DcBlocker` -- so nothing here is a public entry point and
# no argument here is ever host-supplied. The ranges are still written down,
# with the guard decision for each:
#
#   dcblocker_process(b, x)        x: any f64, INCLUDING non-finite. NOT guarded
#                                  -- see the note on the function (hot path,
#                                  and x is prani's own synthesis output).
#   dcblocker_process_buffer(b, s) same. Not guarded; detects the latch instead.
#   prani_vec_extend(dst, src)     no numeric range -- copies opaque f64 bit
#                                  patterns without interpreting them.
#   prani_vec_push_zeros(v, n)     n: [0, i64::MAX]. 0 is VALID (nothing to
#                                  append); NEGATIVE is rejected -- guarded.
#   prani_map_naad_error(code)     any i64 -- it is a foreign code, not a range.
# ================================================================

# 0.995 pole radius: R in H(z) = (1 - z^-1) / (1 - R z^-1). Standard DC-block
# corner (~35 Hz @ 44.1 kHz). Non-integer literal -> module-top hex constant.
var PRANI_DCBLOCK_R = 0x3fefd70a3d70a3d7;   # 0.995

# ================================================================
# DcBlocker -- single-pole DC blocker. Removes DC offset that accumulates
# from asymmetric excitation (purr, stridulation, subharmonics).
#   x_prev : previous input sample
#   y_prev : previous output sample
#   r      : pole radius (~0.995)
# ================================================================
# Fields TYPED as i64 for #derive(Serialize): each holds an f64 BIT PATTERN, and
# serializing it as an int emits the exact 64-bit value (lossless). Typing as
# f64 would use the derive's 6-decimal float writer, which loses ~1 ULP on many
# values. Auto-generates DcBlocker_to_json / _from_json_str — ports the Rust
# `#[derive(Serialize, Deserialize)]` on DcBlocker.
#derive(accessors)
#derive(Serialize)
struct DcBlocker {
    x_prev: i64;
    y_prev: i64;
    r: i64;
}

# new() -- zeroed state, standard pole radius.
#must_use
fn dcblocker_new() {
    var b = alloc(sizeof(DcBlocker));
    DcBlocker_set_x_prev(b, 0);
    DcBlocker_set_y_prev(b, 0);
    DcBlocker_set_r(b, PRANI_DCBLOCK_R);
    return b;
}

# process(x) -- one sample. y = x - x_prev + r*y_prev; then shift state.
#
# DELIBERATELY UNGUARDED (2.0.5). This is a RECURSIVE filter, so one non-finite
# input latches non-finite state permanently: a NaN x gives a NaN y, and y_prev
# stays NaN for every later sample even after the input recovers. A +inf x is no
# better -- y0 = +inf, then y1 = 1 - inf + r*inf = NaN (measured, pinned in
# tests/dsp.tcyr). The blocker lives inside CreatureTract and is reused across
# every synthesize call, so the poisoning outlives the buffer that caused it and
# only crtract_reset/dcblocker_reset clears it.
#
# A per-sample finite test is still the wrong fix, for two reasons:
#   1. COST -- this is the module's hot path, benchmarked at 19 ns/sample
#      (docs/benchmarks.md). prani_is_finite is an f64_abs + f64_lt, so the
#      guard would be a large fraction of the work it protects, on every sample
#      of every synthesis.
#   2. PLACE -- x is never host data. It is prani's own tract output, so a
#      non-finite x means a host number (sample_rate, f0, velocity) already got
#      through an entry point upstream. THAT is where the range guard belongs;
#      catching it here would report the symptom at the wrong layer, and this
#      function has no error channel to report it through anyway (returning a
#      negative code is impossible -- every f64 bit pattern is a legal sample).
# What this module does instead is detect the latch once, in process_buffer.
#inline
fn dcblocker_process(b, x) {
    # y = x - x_prev + r * y_prev
    var y = f64_add(f64_sub(x, DcBlocker_x_prev(b)), f64_mul(DcBlocker_r(b), DcBlocker_y_prev(b)));
    DcBlocker_set_x_prev(b, x);
    DcBlocker_set_y_prev(b, y);
    return y;
}

# process_buffer(samples) -- filter a vec of f64 samples in place.
#
# LATCH DETECTOR (2.0.5), not a range guard. The signature is unchanged and so
# is the return: this function never had an error channel, and inventing one
# here would be the signature change 2.0.5 forbids -- the callers that DO have
# one (crtract_synthesize*, which take the host's sample_rate and f0) carry the
# range guards. What is added is O(1) per BUFFER, not per sample: read the
# filter state before and after the loop and report the finite -> non-finite
# transition. That is the only place the latch is visible at all, since y_prev
# is private to the blocker and a poisoned filter is otherwise silent forever.
#
# Gating on `was_finite` means one line per latch EVENT rather than one per
# block for the rest of the process's life. The state is deliberately NOT
# repaired -- ADR-0001's rule is report, do not fabricate; the filter really is
# poisoned and dcblocker_reset is the named cure.
fn dcblocker_process_buffer(b, samples) {
    var was_finite = prani_is_finite(DcBlocker_y_prev(b));
    var n = vec_len(samples);
    var i = 0;
    while (i < n) {
        vec_set(samples, i, dcblocker_process(b, vec_get(samples, i)));
        i = i + 1;
    }
    if (was_finite == 1) {
        if (prani_is_finite(DcBlocker_y_prev(b)) == 0) {
            prani_log_error("prani: dc blocker state went non-finite -- filter latched until reset");
        }
    }
}

# reset() -- clear the filter memory (pole radius preserved).
fn dcblocker_reset(b) {
    DcBlocker_set_x_prev(b, 0);
    DcBlocker_set_y_prev(b, 0);
}

# ================================================================
# Shared vec loop shapes. Both existed verbatim at three call sites each before
# being extracted here, which is the bar CLAUDE.md sets ("wait for the third
# instance"). Neither changes behaviour -- they are the same loops, named.
# ================================================================

# prani_vec_extend(dst, src) -- append every element of `src` to `dst`.
# Was open-coded in sequence_call_bout_synthesize, sequence_call_phrase_synthesize
# and crvoice_vocalize_with_intent's block accumulation.
#
# UNGUARDED (2.0.5), and there is nothing here to guard: this copies opaque f64
# bit patterns and never interprets one as a number, so no element has a range.
# Scanning `src` for non-finite values would add an O(n) pass to the block
# accumulation path to reject a value that the entry point should have refused
# before any of it was synthesized -- the wrong layer, at a cost proportional to
# the audio. (The one hazard that IS real here, `src` being a negative error
# code rather than a vec, is F1's class, not an input range: all three call
# sites check prani_is_err before extending.)
fn prani_vec_extend(dst, src) {
    var n = vec_len(src);
    var i = 0;
    while (i < n) {
        vec_push(dst, vec_get(src, i));
        i = i + 1;
    }
    return 0;
}

# prani_vec_push_zeros(v, n) -- append `n` zero samples (inter-call silence, or a
# zeroed mix/render buffer). Range: n in [0, i64::MAX]; returns 0, or
# PRANI_ERR_INVALID_VOCALIZATION for a negative `n`.
# Was open-coded in the bout gap, the phrase gap, the chorus mix init and
# stream_next_block.
#
# 2.0.5 SPLITS the old "non-positive appends nothing" rule in two, because the
# two halves mean opposite things:
#
#   n == 0  is VALID and stays valid. Every call site legitimately reaches it --
#           a zero gap between calls, a zero-duration chorus (the oracle's
#           test_zero_duration_synthesis asserts an EMPTY BUFFER, not an error),
#           an exhausted stream block. Nothing to append is an answer, not a
#           failure, so this still appends nothing and still returns 0.
#   n < 0   is IMPOSSIBLE as a request and is now REPORTED. A negative count
#           cannot be asked for; it can only be arithmetic that already failed.
#           Both ways it fails are audit findings: f64_to saturates a NaN or
#           out-of-range product to i64::MIN (F11), and `base + max_off * 2` in
#           synthesize_chorus wraps past i64::MAX to a negative (F10, reproduced
#           in tests/dsp.tcyr at timing_spread 1e14). Appending nothing in that
#           case is F11's exact complaint -- "a silent empty result where an
#           error would be better."
#
# The buffer is untouched either way, so no valid input changes behaviour and no
# caller's output changes for ANY input: only the returned code moves, from 0 to
# a negative, on counts that were already broken. The four call sites discard
# the return today; this is the channel that lets them stop.
fn prani_vec_push_zeros(v, n) {
    if (n < 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var i = 0;
    while (i < n) {
        vec_push(v, 0);
        i = i + 1;
    }
    return 0;
}

# map_naad_error -- ports map_naad_error (naad-backend gated). Rust emitted a
# `tracing::error!(... "naad backend error")` and returned
# PraniError::SynthesisFailed; the Cyrius port wires the diagnostic to sakshi
# (prani_log_error) and returns PRANI_ERR_SYNTHESIS_FAILED.
#must_use
fn prani_map_naad_error(naad_code) {
    prani_log_error("prani: naad backend synthesis init failed");
    return PRANI_ERR_SYNTHESIS_FAILED;
}

# --- spatial.cyr ---

# spatial.cyr -- spatial audio effects for creature vocalizations.
# Ports 2.0.3:rust-old/src/spatial.rs: two free functions, no struct, no
# internal deps. Distance-based attenuation with atmospheric HF absorption
# (one-pole lowpass) and Doppler pitch shift (linear-interpolated resampling).
#
# Requires (from the build/test unit): stdlib alloc/vec/math (F64_TAU,
# f64_from, f64_clamp, f64_floor, f64_to) + error.cyr for PRANI_ERR_* and the
# prani_is_* range helpers. The module file itself has no `include` lines.
#
# FLOATS: the Rust oracle was f32 throughout; the Cyrius port is f64. The
# per-sample recurrences (alpha filter, interpolation) are therefore evaluated
# in f64 -- strictly more precise than the f32 oracle. Tests lock parity to the
# f64 result via hand-computed golden values.
#
# `&[f32]` sample buffers -> stdlib vec handles (f64 in each slot); both
# functions build and return a NEW vec (Rust returned `Vec<f32>`).
#
# ================================================================
# INPUT RANGES (2.0.5, audit finding F11). Both functions return "a vec handle
# OR a negative PRANI_ERR_*", the convention the rest of the library already
# uses -- no signature changed. Every rejection below is a value that today
# produces a NaN buffer, a silently EMPTY buffer, silence, or a plausible-
# looking answer for a different input; per ADR-0001 the library reports the
# failure instead of fabricating one.
#
#   parameter          | accepted            | rejected with
#   -------------------|---------------------|--------------------------------
#   samples (both fns) | a live vec handle   | PRANI_ERR_INVALID_VOCALIZATION
#   distance           | finite, >= 0        | PRANI_ERR_INVALID_VOCALIZATION
#   reference_distance | finite, > 0         | PRANI_ERR_INVALID_VOCALIZATION
#   sample_rate (att.) | finite, > 0, and    | PRANI_ERR_INVALID_TRACT
#                      |   1/rate finite     |
#   velocity           | any finite value    | PRANI_ERR_INVALID_VOCALIZATION
#   _sample_rate (dop) | anything -- UNUSED  | (not guarded, see below)
#
# Codes are by category, not by module: a bad sample rate is
# PRANI_ERR_INVALID_TRACT everywhere in prani (the oracle documents that
# variant as "a vocal tract parameter is out of valid range"), and the spatial
# placement of a vocalization buffer is PRANI_ERR_INVALID_VOCALIZATION.
#
# MEASURED, 2026-08-31 (these are what the guards rest on -- not conjecture):
#   f64_max(NaN, b) -> b   and   f64_max(a, NaN) -> NaN
#     (f64_max is `if (f64_gt(a,b)) a else b`, and every NaN compare is false)
#   NaN distance           -> dist = reference -> output == the gain-1.0 result
#   NaN reference_distance -> dist = NaN -> an all-NaN buffer
#   negative distance      -> clamped up to reference -> full-volume audio
#   +inf distance          -> gain 0 -> a digitally silent buffer
#   reference_distance 0   -> gain 0 -> silence;  with distance 0 too: 0/0 = NaN
#   negative reference     -> negative gain -> a phase-inverted buffer
#   sample_rate 0 or NaN   -> dt = inf -> alpha = inf/inf = NaN -> NaN buffer
#   negative sample_rate   -> alpha ~ 1.64 (> 1): an overshooting filter
#   +inf sample_rate       -> alpha 0 -> a digitally silent buffer
#   sample_rate 5e-324     -> dt overflows to +inf -> alpha NaN -> NaN buffer
#   NaN velocity           -> ratio NaN -> out_len = f64_to(NaN) = i64::MIN
#                             -> the loop never runs -> a silently EMPTY buffer
#   +/-inf velocity        -> f64_clamp bounds them to +/-308.7 -- an infinite
#                             velocity renders as 308.7 m/s (a fabricated
#                             answer, NOT an overflow: infinities ARE clamped)
#
# NOT guarded, deliberately:
#   * `_sample_rate` on the Doppler path. The oracle ignores it and so does
#     this port; measured, a NaN there returns the same 15 finite samples as
#     48000 does. A guard would reject input that provably cannot reach the
#     output.
#   * An upper bound on distance / reference_distance / sample_rate. Once the
#     guards above hold, every derived value is finite by construction: the
#     `max` floors dist at reference so gain = ref/dist is in (0, 1] and cannot
#     overflow, and cutoff is floored at 200 Hz so rc <= 8e-4. Only 1/rate can
#     overflow, and it is checked where it is computed.
#   * |velocity| > 343 m/s. The oracle's +/-0.9c clamp is the MODEL, not a
#     repair -- `tests/spatial.tcyr` locks v = +343 to a 15-sample result -- so
#     supersonic velocities stay valid and saturate. See the trace on
#     `spatial_apply_doppler_shift` for what the clamp is protecting.
#
# DELIBERATE DIVERGENCE from the oracle: a negative `distance`, a
# non-positive `reference_distance` and a non-positive `sample_rate` were all
# accepted by `2.0.3:rust-old/src/spatial.rs` because f32 arithmetic gave each
# of them *some* buffer. None of those buffers is the audio the caller asked
# for.
# ================================================================

# ================================================================
# Float constants (IEEE-754 hex bit patterns; decimal in comment).
# ================================================================
var PR_SP_0_02  = 0x3f947ae147ae147b;   # 0.02   air-absorption distance coeff
var PR_SP_0_9   = 0x3feccccccccccccd;   # 0.9    Doppler velocity clamp fraction

# ================================================================
# spatial_apply_distance_attenuation -- inverse-distance amplitude law plus a
# first-order lowpass modeling atmospheric HF absorption that increases with
# distance. Ports `apply_distance_attenuation`.
#
#   samples            : input vec (f64 per slot); read-only, not mutated
#   distance           : meters source->listener (clamped to >= reference)
#   reference_distance : meters at which gain == 1.0 (typically 1.0)
#   sample_rate        : Hz
# Returns a NEW vec of filtered samples (same length as `samples`), or a
# negative PRANI_ERR_* if an argument is out of the range in the header table.
#
# distance = max(distance, reference_distance)
# gain     = reference_distance / distance
# cutoff   = max(20000 / (1 + distance*0.02), 200)
# rc       = 1 / (TAU * cutoff);  dt = 1 / sample_rate
# alpha    = dt / (rc + dt)
# per sample: filtered = prev + alpha*(s*gain - prev); prev = filtered
# ================================================================
#must_use
fn spatial_apply_distance_attenuation(samples, distance, reference_distance, sample_rate) {
    # A null handle -- or an unchecked negative code chained in from a fallible
    # call like crvoice_vocalize -- reaches vec_len as load64(v+8): a SIGSEGV,
    # the same defect class ADR-0001 repaired in crtract_new.
    if (samples < 1) { return PRANI_ERR_INVALID_VOCALIZATION; }
    # distance 0 is VALID: it clamps up to reference, exactly as 0.5 does.
    if (prani_is_non_negative(distance) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    # reference_distance is the numerator of the gain and the floor under dist;
    # at 0 the gain is 0 (silence) or, with distance 0 as well, 0/0 = NaN.
    if (prani_is_positive(reference_distance) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    if (prani_is_positive(sample_rate) == 0) { return PRANI_ERR_INVALID_TRACT; }

    var dist = f64_max(distance, reference_distance);
    var gain = f64_div(reference_distance, dist);

    # cutoff = max(20000 / (1 + distance*0.02), 200)
    var denom = f64_add(F64_ONE, f64_mul(dist, PR_SP_0_02));
    var cutoff = f64_max(f64_div(f64_from(20000), denom), f64_from(200));

    var rc = f64_div(F64_ONE, f64_mul(F64_TAU, cutoff));
    var dt = f64_div(F64_ONE, sample_rate);
    # `> 0` is not sufficient: a subnormal rate overflows the reciprocal
    # (measured, 5e-324 -> dt = +inf -> alpha = inf/inf = NaN -> a NaN buffer).
    # The bar is "1/sample_rate is finite", i.e. sample_rate >~ 5.6e-309;
    # checking the quotient states that without hardcoding the exponent.
    if (prani_is_finite(dt) == 0) { return PRANI_ERR_INVALID_TRACT; }
    var alpha = f64_div(dt, f64_add(rc, dt));

    var output = vec_new();
    var prev = 0;
    var n = vec_len(samples);
    var i = 0;
    while (i < n) {
        var s = vec_get(samples, i);
        # filtered = prev + alpha * (s*gain - prev)
        var filtered = f64_add(prev, f64_mul(alpha, f64_sub(f64_mul(s, gain), prev)));
        prev = filtered;
        vec_push(output, filtered);
        i = i + 1;
    }
    return output;
}

# ================================================================
# spatial_apply_doppler_shift -- Doppler pitch shift for a moving source, via
# linear-interpolated resampling. Ports `apply_doppler_shift`. The 2nd Rust
# arg (`_sample_rate`) is unused in the body but retained for signature parity.
#
#   samples      : input vec (f64 per slot); read-only, not mutated
#   velocity     : radial m/s (positive = moving away, negative = approaching)
#   _sample_rate : Hz -- UNUSED (kept for signature parity with the oracle)
# Returns a NEW vec of length out_len = (len / ratio) truncated, or a negative
# PRANI_ERR_* if `samples` is not a handle or `velocity` is not finite.
#
# SPEED_OF_SOUND = 343
# v     = clamp(velocity, -343*0.9, +343*0.9)
# ratio = 343 / (343 + v)
# out_len = (len / ratio) as usize   (truncate toward zero)
# for i in 0..out_len:
#   src = i * ratio;  idx = src as usize;  frac = src - idx
#   s0 = samples[idx]   if idx   < len else 0
#   s1 = samples[idx+1] if idx+1 < len else 0
#   push s0 + (s1 - s0)*frac
#
# Approaching (v<0) -> ratio>1 -> out_len < len (shorter, higher pitch).
# Moving away (v>0) -> ratio<1 -> out_len > len (longer, lower pitch).
# v == 0 -> ratio == 1 -> out_len == len (identity resample).
#
# AT AND BEYOND THE SPEED OF SOUND -- why `velocity` needs no range beyond
# "finite" (traced, then measured on a 100-sample buffer):
#   without the clamp, v = -343 makes `speed + v` exactly 0, so ratio = +inf
#     and out_len = f64_to(100 / inf) = f64_to(0) = 0  -> an empty buffer;
#   v < -343 makes `speed + v` negative, so ratio is negative and
#     out_len = -45  -> negative, the loop never runs -> an empty buffer.
#   The clamp runs FIRST and saturates every such velocity at -308.7, giving
#     ratio = 9.999999999999996 and out_len = 10 -- measured identical for
#     v = -308.7, -343, -1e6 and -inf. The singularity is unreachable.
# So the clamp is the MODEL (Mach 0.9 saturation), not a repair, and every
# finite velocity keeps ratio inside [0.5264, 10] -- which is what bounds
# out_len at 1.9x the input (audit 2026-08-30, "What was clean").
# ================================================================
#must_use
fn spatial_apply_doppler_shift(samples, velocity, _sample_rate) {
    # See spatial_apply_distance_attenuation for the handle guard.
    if (samples < 1) { return PRANI_ERR_INVALID_VOCALIZATION; }
    # NaN is the live defect: it survives the clamp, so out_len becomes
    # i64::MIN and the caller gets an empty buffer instead of an error.
    # +/-inf ARE clamped (measured) -- they are rejected because rendering an
    # infinite velocity as 308.7 m/s is a fabricated answer, not because they
    # would overflow anything.
    if (prani_is_finite(velocity) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }

    var speed = f64_from(343);
    # clamp bounds computed as the port would: 343 * 0.9 (= 308.7), negated.
    var bound = f64_mul(speed, PR_SP_0_9);
    var v = f64_clamp(velocity, f64_neg(bound), bound);
    var ratio = f64_div(speed, f64_add(speed, v));

    var len = vec_len(samples);
    # out_len = (len / ratio) as usize  -- len as f64, divide, truncate.
    var out_len = f64_to(f64_div(f64_from(len), ratio));

    var output = vec_new();
    var i = 0;
    while (i < out_len) {
        # src = i * ratio;  idx = trunc(src);  frac = src - idx
        var src = f64_mul(f64_from(i), ratio);
        var idx = f64_to(src);
        var frac = f64_sub(src, f64_from(idx));

        var s0 = 0;
        if (idx < len) { s0 = vec_get(samples, idx); }
        var s1 = 0;
        if ((idx + 1) < len) { s1 = vec_get(samples, idx + 1); }

        # s0 + (s1 - s0) * frac
        vec_push(output, f64_add(s0, f64_mul(f64_sub(s1, s0), frac)));
        i = i + 1;
    }
    return output;
}

# --- vocalization.cyr ---

# vocalization.cyr -- vocalization patterns + call-intent prosody mapping.
# Ports 2.0.3:rust-old/src/vocalization.rs. Two enums (Vocalization,
# CallIntent) -> integer constants, plus IntentModifiers (a 4-field prosody
# struct) and CallIntent::modifiers() -> a fixed lookup returning that struct.
#
# Keystone base module: emotion, species, voice, sequence, stream, ffi all lean
# on these constants. No internal deps. serde RESTORED on IntentModifiers via
# #derive(Serialize) (i64 bit-pattern fields, lossless). Display tests dropped.

# ================================================================
# Vocalization -- the shape/character of a creature call (was `enum
# Vocalization`, 14 variants). Discriminant == declaration order (0-based),
# matching Rust's default enum layout.
# ================================================================
var PRANI_VOC_HOWL       = 0;    # long sustained, pitch rise then fall (wolves)
var PRANI_VOC_BARK       = 1;    # short sharp burst (dogs, seals)
var PRANI_VOC_GROWL      = 2;    # low-frequency sustained vibration (cats, bears)
var PRANI_VOC_ROAR       = 3;    # loud powerful sustained call (lions, dragons)
var PRANI_VOC_HISS       = 4;    # breathy turbulent noise (snakes, cats)
var PRANI_VOC_CHIRP      = 5;    # high-pitched short call (birds, small mammals)
var PRANI_VOC_TRILL      = 6;    # rapid frequency modulation (songbirds)
var PRANI_VOC_WHINE      = 7;    # ascending pitch call (dogs, wolves)
var PRANI_VOC_RUMBLE     = 8;    # low rumbling (crocodilians, elephants)
var PRANI_VOC_PURR       = 9;    # steady low-freq vibration w/ AM (cats)
var PRANI_VOC_YELP       = 10;   # very short sharp call (small dogs, rodents)
var PRANI_VOC_SCREECH    = 11;   # high-pitched descending scream (raptors)
var PRANI_VOC_STRIDULATE = 12;   # rhythmic stridulation (crickets, cicadas)
var PRANI_VOC_BUZZ       = 13;   # wing-based tonal vibration (bees, flies)

var PRANI_VOC_COUNT = 14;        # number of Vocalization variants

# ================================================================
# CallIntent -- behavioral intent behind a vocalization (was `enum CallIntent`,
# 7 variants). Maps to prosodic modifications via prani_intent_modifiers().
# ================================================================
var PRANI_INTENT_ALARM       = 0;   # warning of danger: high urgency, elevated pitch
var PRANI_INTENT_TERRITORIAL = 1;   # claiming territory: loud, sustained
var PRANI_INTENT_MATING      = 2;   # attracting a mate: melodic, extended
var PRANI_INTENT_DISTRESS    = 3;   # pain/distress: high pitch, irregular, urgent
var PRANI_INTENT_IDLE        = 4;   # neutral/background: relaxed, low effort
var PRANI_INTENT_THREAT      = 5;   # aggression/threat: loud, low pitch, growling
var PRANI_INTENT_SOCIAL      = 6;   # social bonding: moderate, varied

var PRANI_INTENT_COUNT = 7;         # number of CallIntent variants

# ================================================================
# Intent modifier float constants (IEEE-754 hex; decimals in comments).
# ================================================================
var PR_F_0_0 = 0x0000000000000000;   # 0.0
var PR_F_0_2 = 0x3FC999999999999A;   # 0.2
var PR_F_0_3 = 0x3FD3333333333333;   # 0.3
var PR_F_0_5 = 0x3FE0000000000000;   # 0.5
var PR_F_0_7 = 0x3FE6666666666666;   # 0.7
var PR_F_0_8 = 0x3FE999999999999A;   # 0.8
var PR_F_0_9 = 0x3FECCCCCCCCCCCCD;   # 0.9
var PR_F_1_0 = 0x3FF0000000000000;   # 1.0
var PR_F_1_1 = 0x3FF199999999999A;   # 1.1
var PR_F_1_2 = 0x3FF3333333333333;   # 1.2
var PR_F_1_3 = 0x3FF4CCCCCCCCCCCD;   # 1.3
var PR_F_1_4 = 0x3FF6666666666666;   # 1.4
var PR_F_1_5 = 0x3FF8000000000000;   # 1.5
var PR_F_2_0 = 0x4000000000000000;   # 2.0

# ================================================================
# IntentModifiers -- prosodic modifiers applied to synthesis for an intent.
#   pitch_scale     : pitch multiplier (1.0 = species default)
#   amplitude_scale : amplitude multiplier
#   duration_scale  : duration multiplier
#   urgency         : jitter/onset-sharpness in [0,1]
# ================================================================
# Fields TYPED i64 for #derive(Serialize): each f64 is an i64 bit pattern,
# serialized as an int → exact 64-bit lossless roundtrip (f64 typing would use
# the derive's 6-decimal float writer, which is lossy). Auto-generates
# IntentModifiers_to_json(self, sb) + IntentModifiers_from_json_str(json),
# restoring the Rust `#[derive(Serialize, Deserialize)]` on IntentModifiers.
#derive(accessors)
#derive(Serialize)
struct IntentModifiers {
    pitch_scale: i64;
    amplitude_scale: i64;
    duration_scale: i64;
    urgency: i64;
}

# intent_modifiers_make(pitch_scale, urgency, duration_scale, amplitude_scale)
# -- construct an IntentModifiers. Ports the Rust struct literal in
# `CallIntent::modifiers`. Values are multiplicative against the base call
# (urgency additionally drives jitter/shimmer perturbation in the tract), and a
# neutral set is (1.0, 1.0, 1.0, 0.0). prani_intent_modifiers() is the mapping
# from an intent; this is the constructor it and the tests build with.
#must_use
fn prani_intent_modifiers_make(pitch_scale, amplitude_scale, duration_scale, urgency) {
    var m = alloc(sizeof(IntentModifiers));
    IntentModifiers_set_pitch_scale(m, pitch_scale);
    IntentModifiers_set_amplitude_scale(m, amplitude_scale);
    IntentModifiers_set_duration_scale(m, duration_scale);
    IntentModifiers_set_urgency(m, urgency);
    return m;
}

# prani_intent_modifiers -- CallIntent::modifiers(). Fixed lookup per intent
# (values verbatim from the Rust match arms). Unknown intent -> neutral (Idle-
# like 1.0/1.0/1.0/0.0), preserving totality (the Rust enum is #[non_exhaustive]).
#must_use
fn prani_intent_modifiers(intent) {
    if (intent == PRANI_INTENT_ALARM) {
        return prani_intent_modifiers_make(PR_F_1_4, PR_F_1_5, PR_F_0_7, PR_F_0_9);
    }
    if (intent == PRANI_INTENT_TERRITORIAL) {
        return prani_intent_modifiers_make(PR_F_0_9, PR_F_1_3, PR_F_1_5, PR_F_0_5);
    }
    if (intent == PRANI_INTENT_MATING) {
        return prani_intent_modifiers_make(PR_F_1_1, PR_F_1_0, PR_F_2_0, PR_F_0_2);
    }
    if (intent == PRANI_INTENT_DISTRESS) {
        return prani_intent_modifiers_make(PR_F_1_5, PR_F_1_4, PR_F_0_8, PR_F_1_0);
    }
    if (intent == PRANI_INTENT_IDLE) {
        return prani_intent_modifiers_make(PR_F_1_0, PR_F_0_5, PR_F_1_0, PR_F_0_0);
    }
    if (intent == PRANI_INTENT_THREAT) {
        return prani_intent_modifiers_make(PR_F_0_7, PR_F_1_4, PR_F_1_2, PR_F_0_7);
    }
    if (intent == PRANI_INTENT_SOCIAL) {
        return prani_intent_modifiers_make(PR_F_1_0, PR_F_0_8, PR_F_1_0, PR_F_0_3);
    }
    return prani_intent_modifiers_make(PR_F_1_0, PR_F_1_0, PR_F_1_0, PR_F_0_0);
}

# --- fatigue.cyr ---

# fatigue.cyr -- vocal fatigue + call-habituation system.
# Ports 2.0.3:rust-old/src/fatigue.rs: the `FatigueState` accumulator and its
# derived `FatigueModifiers` (pitch drift, breathiness, amplitude, jitter).
# Tracks a creature's calling history and degrades synthesis realistically:
#   - Fatigue accumulates with calling time, recovers during silence.
#   - Alarm habituation rises with unreinforced alarms ("cried wolf"), decays
#     slowly during rest, and is reset on reinforcement.
#
# Requires (from the build/test unit): error.cyr + logging.cyr + stdlib
# alloc/math. The module file itself has no `include` lines.
#
# FLOATS: prani's Rust was f32; this port is f64 (svara/naad/hisab are f64-only,
# widening is forced and improves precision). Non-integer literals -> module-top
# IEEE-754 hex constants (decimal in comment). Integer floats via f64_from.
# `.clamp(0,1)` -> f64_clamp(x,0,F64_ONE); `.max(0)` -> f64_max(x,0).
#
# serde RESTORED on FatigueState + FatigueModifiers via #derive(Serialize)
# (i64 bit-pattern fields, lossless roundtrip). Display tests dropped.

# ================================================================
# Rate + scale constants (IEEE-754 hex bit patterns; decimals in comments).
# ================================================================
var PR_FAT_FATIGUE_RATE     = 0x3f8eb851eb851eb8;   # 0.015  per second of calling
var PR_FAT_HAB_STEP         = 0x3fb999999999999a;   # 0.1    per unreinforced alarm
var PR_FAT_RECOVERY_RATE    = 0x3fb1eb851eb851ec;   # 0.07   fatigue recovery per second rest
var PR_FAT_HAB_DECAY        = 0x3f978d4fdf3b645a;   # 0.023  habituation decay per second rest
var PR_FAT_HAB_REINFORCE    = 0x3fd3333333333333;   # 0.3    habituation drop on reinforcement
var PR_FAT_BOUT_RESET_SECS  = 0x4014000000000000;   # 5.0    rest > 5s resets bout tracking

var PR_FAT_PITCH_DROP_HZ    = 0x4034000000000000;   # 20.0   max downward pitch drift (Hz)
var PR_FAT_BREATH_MAX       = 0x3fc999999999999a;   # 0.2    max breathiness delta
var PR_FAT_AMP_FATIGUE_MAX  = 0x3fd999999999999a;   # 0.4    fatigue amplitude reduction span
var PR_FAT_AMP_HAB_MAX      = 0x3fe0000000000000;   # 0.5    habituation amplitude reduction span
var PR_FAT_JITTER_SPAN      = 0x3ff8000000000000;   # 1.5    fatigue jitter increase span

# ================================================================
# 2.0.5 input-range validation (audit F11). The accepted duration range for
# BOTH record_call() and rest() is [0.0, 1e9] seconds, inclusive.
#
# Measured on this module 2026-08-31 (pinned in tests/fatigue.tcyr):
#   record_call(NaN, _)  -> fatigue = NaN AND bout_calling_time = NaN. Every
#                           later modifiers() then returns four NaNs, and a
#                           later VALID call cannot heal it (NaN + x = NaN).
#   record_call(+inf, _) -> fatigue clamps to 1.0 (f64_clamp DOES bound the
#                           infinities), but bout_calling_time = +inf.
#   record_call(-1000)   -> fatigue floors at 0, bout_calling_time = -1000.0.
#   rest(NaN)            -> f64_max(NaN, 0) is 0, NOT NaN (f64_max is
#                           asymmetric -- f64_max(0, NaN) IS NaN), so fatigue
#                           and alarm_habituation are silently ZEROED: a
#                           creature mid-bout reported fully rested, exactly
#                           the fabricated-plausible-answer ADR-0001 rejects.
#   rest(-inf)           -> fatigue = +inf, outside its documented [0,1].
#   rest(-1000)          -> fatigue = 70.15, also outside [0,1]. rest() has a
#                           f64_max(_, 0) floor and no ceiling, so a negative
#                           duration is an unbounded ANTI-rest.
#
# Zero is VALID -- an exact no-op on both, and the oracle's
# test_zero_duration_synthesis establishes that a zero duration is not an error.
#
# The UPPER bound exists because bout_calling_time is the one field here with
# no clamp: a finiteness check alone still lets two calls of 1e308 push the
# accumulator to +inf. 1e9 s is ~31.7 years -- seven orders past any creature
# lifespan and eight past anything this model resolves (its own constants
# saturate fatigue in ~67 s, clear it in ~14 s, decay habituation in ~44 s and
# reset a bout after 5 s) -- and it takes ~1.8e299 accepted calls at the bound
# to drive the accumulator to +inf.
# ================================================================
var PR_FAT_MAX_DURATION_S   = 0x41cdcd6500000000;   # 1.0e9  seconds (~31.7 years)

# ================================================================
# FatigueState -- tracks vocal fatigue and call habituation.
#   fatigue           : accumulated fatigue (0.0 fresh .. 1.0 exhausted)
#   alarm_habituation : alarm/threat habituation (0.0 full response .. 1.0 habituated)
#   bout_calling_time : total calling time in the current bout (seconds)
#   alarm_count       : unreinforced alarm calls in the current window (u32)
#   alarm_reinforced  : whether the last alarm was reinforced (0/1 bool)
# ================================================================
# Fields TYPED i64 for #derive(Serialize): the f64 fields (fatigue/
# alarm_habituation/bout_calling_time) are stored as i64 bit patterns and
# serialized as ints → exact 64-bit lossless roundtrip (f64 typing = the derive's
# 6-decimal float writer, lossy). Auto-generates FatigueState_to_json(self, sb) +
# FatigueState_from_json_str(json) — ports the Rust `#[derive(Serialize,
# Deserialize)]` on FatigueState (state persistence).
#derive(accessors)
#derive(Serialize)
struct FatigueState {
    fatigue: i64;
    alarm_habituation: i64;
    bout_calling_time: i64;
    alarm_count: i64;
    alarm_reinforced: i64;
}

# new() -- fresh (non-fatigued) state. Also serves as Default::default().
#must_use
fn fatigue_new() {
    var self = alloc(sizeof(FatigueState));
    FatigueState_set_fatigue(self, 0);
    FatigueState_set_alarm_habituation(self, 0);
    FatigueState_set_bout_calling_time(self, 0);
    FatigueState_set_alarm_count(self, 0);
    FatigueState_set_alarm_reinforced(self, 0);
    return self;
}

# fatigue() -- current fatigue level (0.0-1.0). Accessor-style getter.
#must_use
fn fatigue_fatigue(self) {
    return FatigueState_fatigue(self);
}

# alarm_habituation() -- current alarm habituation level (0.0-1.0).
#must_use
fn fatigue_alarm_habituation(self) {
    return FatigueState_alarm_habituation(self);
}

# record_call(duration, is_alarm) -- record that a call was produced.
#   duration : call duration in seconds (f64)
#   is_alarm : 1 if this was an alarm/threat call, 0 otherwise
# Fatigue accumulates by duration*rate (clamped to [0,1]). Alarm calls bump the
# unreinforced-alarm count and, when not reinforced, raise habituation by 0.1.
# 2.0.5: `duration` must be in [0, 1e9] seconds (see PR_FAT_MAX_DURATION_S).
# record_call has NO error channel -- it returns nothing and adding one would
# be a signature change (roadmap 2.1.0's constructor/mutator-contract work) --
# so a bad duration is REPORTED through prani_log_error and the whole call
# event is dropped, leaving the accumulators exactly as they were. Refusing one
# call is strictly less lossy than admitting a NaN that makes every field, and
# every later modifiers(), permanently meaningless; and it is not a fabricated
# answer in ADR-0001's sense, because no substitute value is invented.
# DIVERGENCE: the f32 oracle accepted all of these and poisoned itself.
fn fatigue_record_call(self, duration, is_alarm) {
    if (prani_in_range(duration, 0, PR_FAT_MAX_DURATION_S) == 0) {
        prani_log_error("prani: fatigue record_call duration out of range, call not recorded");
        return 0;
    }

    # bout_calling_time += duration
    FatigueState_set_bout_calling_time(self, f64_add(FatigueState_bout_calling_time(self), duration));

    # fatigue = (fatigue + duration * fatigue_rate).clamp(0.0, 1.0)
    var f = f64_add(FatigueState_fatigue(self), f64_mul(duration, PR_FAT_FATIGUE_RATE));
    FatigueState_set_fatigue(self, f64_clamp(f, 0, F64_ONE));

    if (is_alarm != 0) {
        # alarm_count += 1
        FatigueState_set_alarm_count(self, FatigueState_alarm_count(self) + 1);
        # if !alarm_reinforced { habituation = (habituation + 0.1).clamp(0,1) }
        if (FatigueState_alarm_reinforced(self) == 0) {
            var h = f64_add(FatigueState_alarm_habituation(self), PR_FAT_HAB_STEP);
            FatigueState_set_alarm_habituation(self, f64_clamp(h, 0, F64_ONE));
        }
    }
}

# rest(duration) -- record a period of rest (silence).
#   duration : rest duration in seconds (f64)
# Fatigue recovers at 0.07/s (floored at 0), habituation decays at 0.023/s
# (floored at 0), and rest longer than 5s resets bout tracking.
# 2.0.5: `duration` must be in [0, 1e9] seconds, same range and same reporting
# path as record_call. rest() is the more dangerous of the two: f64_max(NaN, 0)
# returns 0, so a NaN duration does not visibly poison anything -- it quietly
# reports a mid-bout creature as fully rested and fully de-habituated, and a
# negative duration runs the recovery backwards with no ceiling to stop it.
# DIVERGENCE: the f32 oracle accepted all of these.
fn fatigue_rest(self, duration) {
    if (prani_in_range(duration, 0, PR_FAT_MAX_DURATION_S) == 0) {
        prani_log_error("prani: fatigue rest duration out of range, rest not recorded");
        return 0;
    }

    # fatigue = (fatigue - duration * recovery_rate).max(0.0)
    var f = f64_sub(FatigueState_fatigue(self), f64_mul(duration, PR_FAT_RECOVERY_RATE));
    FatigueState_set_fatigue(self, f64_max(f, 0));

    # alarm_habituation = (alarm_habituation - duration * habituation_decay).max(0.0)
    var h = f64_sub(FatigueState_alarm_habituation(self), f64_mul(duration, PR_FAT_HAB_DECAY));
    FatigueState_set_alarm_habituation(self, f64_max(h, 0));

    # if duration > 5.0 { bout_calling_time = 0.0 }
    if (f64_gt(duration, PR_FAT_BOUT_RESET_SECS) == 1) {
        FatigueState_set_bout_calling_time(self, 0);
    }
}

# reinforce_alarm() -- the last alarm's threat was real. Sets the reinforced
# flag, drops habituation by 0.3 (floored at 0), and resets the alarm count.
fn fatigue_reinforce_alarm(self) {
    FatigueState_set_alarm_reinforced(self, 1);
    var h = f64_sub(FatigueState_alarm_habituation(self), PR_FAT_HAB_REINFORCE);
    FatigueState_set_alarm_habituation(self, f64_max(h, 0));
    FatigueState_set_alarm_count(self, 0);
}

# clear_reinforcement() -- reset the reinforcement flag (start of a new bout).
fn fatigue_clear_reinforcement(self) {
    FatigueState_set_alarm_reinforced(self, 0);
}

# reset() -- clear all fatigue and habituation state (== *self = new()).
fn fatigue_reset(self) {
    FatigueState_set_fatigue(self, 0);
    FatigueState_set_alarm_habituation(self, 0);
    FatigueState_set_bout_calling_time(self, 0);
    FatigueState_set_alarm_count(self, 0);
    FatigueState_set_alarm_reinforced(self, 0);
}

# ================================================================
# FatigueModifiers -- synthesis modifiers derived from the fatigue state.
#   pitch_offset      : pitch drift in Hz (negative = downward from fatigue)
#   breathiness_delta : additive breathiness increase (0.0 = no change)
#   amplitude_scale   : amplitude multiplier (1.0 normal, <1.0 fatigued/habituated)
#   jitter_scale      : jitter multiplier (1.0 normal, >1.0 fatigued)
# ================================================================
# Fields TYPED i64 for #derive(Serialize) (each f64 as an exact bit pattern →
# lossless) — auto-generates FatigueModifiers_to_json / _from_json_str, porting
# the Rust `#[derive(Serialize, Deserialize)]` on FatigueModifiers.
#derive(accessors)
#derive(Serialize)
struct FatigueModifiers {
    pitch_offset: i64;
    breathiness_delta: i64;
    amplitude_scale: i64;
    jitter_scale: i64;
}

# modifiers_make(f0_scale, amplitude_scale, breathiness_add, jitter_add) --
# construct a FatigueModifiers. The four fields are applied multiplicatively
# (f0/amplitude) and additively (breathiness/jitter) to a voice's parameters;
# an unfatigued creature is (1.0, 1.0, 0.0, 0.0). Callers normally get one from
# fatigue_modifiers(), not from here -- this is the explicit constructor the
# table and the tests build with.
#
# 2.0.5: this is the single choke point through which every FatigueModifiers
# prani builds passes, including the one modifiers() derives -- so a non-finite
# field here is the F11 symptom wherever it originated. It CANNOT reject: it
# returns a pointer with no error channel, and giving it one would change the
# return contract (roadmap 2.1.0). It therefore reports and returns the values
# it was given, unaltered: substituting the identity modifiers (0, 0, 1, 1)
# would be precisely the plausible fabrication ADR-0001 rules out. The one
# reachable producer of a non-finite field left in this module is a FatigueState
# rebuilt by the derive-generated FatigueState_from_json_str from a document
# prani did not write -- record_call and rest now refuse to create one.
#must_use
fn fatigue_modifiers_make(pitch_offset, breathiness_delta, amplitude_scale, jitter_scale) {
    var ok = prani_finite2(pitch_offset, breathiness_delta);
    if (ok == 1) { ok = prani_finite2(amplitude_scale, jitter_scale); }
    if (ok == 0) { prani_log_error("prani: fatigue modifiers built from a non-finite value"); }

    var m = alloc(sizeof(FatigueModifiers));
    FatigueModifiers_set_pitch_offset(m, pitch_offset);
    FatigueModifiers_set_breathiness_delta(m, breathiness_delta);
    FatigueModifiers_set_amplitude_scale(m, amplitude_scale);
    FatigueModifiers_set_jitter_scale(m, jitter_scale);
    return m;
}

# modifiers() -- current fatigue/habituation modifiers.
#   pitch_offset      = -fatigue * 20.0            (up to -20 Hz at full fatigue)
#   breathiness_delta =  fatigue * 0.2             (up to +0.2 at full fatigue)
#   amplitude_scale   = (1 - fatigue*0.4) * (1 - habituation*0.5)
#   jitter_scale      = 1 + fatigue * 1.5
#must_use
fn fatigue_modifiers(self) {
    var fat = FatigueState_fatigue(self);
    var hab = FatigueState_alarm_habituation(self);

    # pitch_offset = -fatigue * 20.0
    var pitch_offset = f64_neg(f64_mul(fat, PR_FAT_PITCH_DROP_HZ));

    # breathiness_delta = fatigue * 0.2
    var breathiness_delta = f64_mul(fat, PR_FAT_BREATH_MAX);

    # amplitude_scale = (1 - fatigue*0.4) * (1 - habituation*0.5)
    var fatigue_amp = f64_sub(F64_ONE, f64_mul(fat, PR_FAT_AMP_FATIGUE_MAX));
    var habituation_amp = f64_sub(F64_ONE, f64_mul(hab, PR_FAT_AMP_HAB_MAX));
    var amplitude_scale = f64_mul(fatigue_amp, habituation_amp);

    # jitter_scale = 1 + fatigue * 1.5
    var jitter_scale = f64_add(F64_ONE, f64_mul(fat, PR_FAT_JITTER_SPAN));

    return fatigue_modifiers_make(pitch_offset, breathiness_delta, amplitude_scale, jitter_scale);
}

# --- emotion.cyr ---

# emotion.cyr -- creature emotion state machine (valence/arousal model).
# Ports 2.0.3:rust-old/src/emotion.rs: EmotionState (valence x arousal x
# smoothing) + EmotionOutput (the synthesis params derived from a state). Maps
# the 2D emotion space to a Vocalization + CallIntent + continuous modulation
# (vocal effort, pitch scale, breathiness delta).
#
# Requires (from the build/test unit, in order): error.cyr, vocalization.cyr
# (PRANI_VOC_* / PRANI_INTENT_* consts) + stdlib alloc/math. This file has no
# `include` lines.
#
# f32 -> f64 throughout. Non-integer literals -> module-top hex constants
# (IEEE-754 bit patterns, decimals in comments). Zone enums (ValenceZone,
# ArousalZone) were private Rust enums -> local integer var consts. serde
# RESTORED on PrEmotion + PrEmotionOut via #derive(Serialize) (i64 bit-pattern
# fields, lossless roundtrip). Display tests dropped (no Display in Cyrius).

# ================================================================
# Float constants (IEEE-754 hex bit patterns; decimals in comments).
# ================================================================
var PRE_NEG_1_0  = 0xbff0000000000000;   # -1.0  (valence clamp lo)
var PRE_1_0      = 0x3ff0000000000000;   #  1.0  (valence/arousal clamp hi; pitch base)
var PRE_0_0      = 0x0000000000000000;   #  0.0  (arousal clamp lo; neutral valence; no breath)
var PRE_0_95     = 0x3fee666666666666;   #  0.95 (smoothing clamp hi)
var PRE_0_2      = 0x3fc999999999999a;   #  0.2  (default arousal; effort base; breath lo thresh)
var PRE_0_1      = 0x3fb999999999999a;   #  0.1  (default smoothing)
var PRE_0_7      = 0x3fe6666666666666;   #  0.7  (arousal->effort gain)
var PRE_0_15     = 0x3fc3333333333333;   #  0.15 (valence->pitch gain)
var PRE_0_8      = 0x3fe999999999999a;   #  0.8  (breath hi thresh)
var PRE_0_75     = 0x3fe8000000000000;   #  0.75 (breath hi gain)
var PRE_0_5      = 0x3fe0000000000000;   #  0.5  (breath lo gain; zone bound +/-0.5)
var PRE_0_33     = 0x3fd51eb851eb851f;   #  0.33 (arousal Low<->Mid bound)
var PRE_0_66     = 0x3fe51eb851eb851f;   #  0.66 (arousal Mid<->High bound)
var PRE_NEG_0_2  = 0xbfc999999999999a;   # -0.2  (valence Negative<->Neutral bound)
var PRE_NEG_0_5  = 0xbfe0000000000000;   # -0.5  (screech vs bark bound)
var PRE_NEG_0_7  = 0xbfe6666666666666;   # -0.7  (distress vs alarm bound)

# ================================================================
# ValenceZone / ArousalZone -- private Rust enums used only inside the
# select_* match arms. Discriminant == declaration order (0-based).
# ================================================================
var PRE_VZ_NEGATIVE = 0;
var PRE_VZ_NEUTRAL  = 1;
var PRE_VZ_POSITIVE = 2;

var PRE_AZ_LOW  = 0;
var PRE_AZ_MID  = 1;
var PRE_AZ_HIGH = 2;

# ================================================================
# EmotionState -- a creature's emotional state in valence/arousal space.
#   valence   : -1.0 (aversive) .. +1.0 (appetitive)
#   arousal   :  0.0 (calm)     .. 1.0 (excited)
#   smoothing : transition smoothing factor (0.0 instant .. 0.95 sluggish)
# Distinct struct name (PrEmotion) so accessors don't collide with svara/naad.
# ================================================================
# Fields TYPED i64 for #derive(Serialize): each f64 is stored as an i64 bit
# pattern, serialized as an int → the exact 64-bit value roundtrips (lossless).
# Typing them f64 would use the derive's 6-decimal float writer (lossy). Auto-
# generates PrEmotion_to_json / _from_json_str, restoring the Rust
# `#[derive(Serialize, Deserialize)]` on EmotionState.
#derive(accessors)
#derive(Serialize)
struct PrEmotion {
    valence: i64;
    arousal: i64;
    smoothing: i64;
}

# new() -- neutral point (idle, calm): valence 0.0, arousal 0.2, smoothing 0.1.
# Also serves as Default (impl Default -> Self::new()).
#must_use
fn emotion_new() {
    var self = alloc(sizeof(PrEmotion));
    PrEmotion_set_valence(self, PRE_0_0);
    PrEmotion_set_arousal(self, PRE_0_2);
    PrEmotion_set_smoothing(self, PRE_0_1);
    return self;
}

# with_values(valence, arousal) -- specific initial values, clamped; smoothing 0.1.
#must_use
fn emotion_with_values(valence, arousal) {
    var self = alloc(sizeof(PrEmotion));
    PrEmotion_set_valence(self, f64_clamp(valence, PRE_NEG_1_0, PRE_1_0));
    PrEmotion_set_arousal(self, f64_clamp(arousal, PRE_0_0, PRE_1_0));
    PrEmotion_set_smoothing(self, PRE_0_1);
    return self;
}

# with_smoothing(self, smoothing) -- sets smoothing clamped to [0.0, 0.95].
# Rust consumed+returned self (builder); the Cyrius port mutates in place and
# returns the same handle.
#must_use
fn emotion_with_smoothing(self, smoothing) {
    PrEmotion_set_smoothing(self, f64_clamp(smoothing, PRE_0_0, PRE_0_95));
    return self;
}

# valence(self) -- current valence.
#must_use
fn emotion_valence(self) {
    return PrEmotion_valence(self);
}

# arousal(self) -- current arousal.
#must_use
fn emotion_arousal(self) {
    return PrEmotion_arousal(self);
}

# update(self, target_valence, target_arousal) -- exponential decay toward the
# clamped target at rate `smoothing`. Call once per frame/tick.
#   valence = valence*s + tv*(1-s);  arousal = arousal*s + ta*(1-s)
fn emotion_update(self, target_valence, target_arousal) {
    var tv = f64_clamp(target_valence, PRE_NEG_1_0, PRE_1_0);
    var ta = f64_clamp(target_arousal, PRE_0_0, PRE_1_0);
    var s = PrEmotion_smoothing(self);
    var one_minus_s = f64_sub(PRE_1_0, s);
    PrEmotion_set_valence(self, f64_add(f64_mul(PrEmotion_valence(self), s), f64_mul(tv, one_minus_s)));
    PrEmotion_set_arousal(self, f64_add(f64_mul(PrEmotion_arousal(self), s), f64_mul(ta, one_minus_s)));
}

# set(self, valence, arousal) -- direct (no smoothing), clamped.
fn emotion_set(self, valence, arousal) {
    PrEmotion_set_valence(self, f64_clamp(valence, PRE_NEG_1_0, PRE_1_0));
    PrEmotion_set_arousal(self, f64_clamp(arousal, PRE_0_0, PRE_1_0));
}

# ================================================================
# Input-range guards (2.0.5; audit finding F11).
#
# Every setter in this module clamps, and f64_clamp(NaN, lo, hi) -> NaN
# (measured, pinned in tests/error.tcyr), so a NaN valence/arousal/smoothing
# passes every clamp here and is STORED. Nothing downstream notices: the zone
# classifiers below compare NaN against their bounds, both comparisons are
# false, and the state silently reads as Neutral/Mid while evaluate() hands a
# NaN vocal_effort, pitch_scale and breathiness_delta to whatever drives
# synthesis. That is a fabricated plausible answer -- exactly what ADR-0001
# rejected -- with no way for the caller to tell.
#
# with_values / with_smoothing / set / update return the struct or nothing, so
# they have no error channel and are left alone (the constructor contract is
# roadmap 2.1.0). The guard therefore sits at the point of USE: every function
# here that already returns "value or negative code" -- the two zone
# classifiers, the two selectors, evaluate -- checks the state before deriving
# anything from it. That covers every way a bad value can arrive (a clamped
# NaN, a raw PrEmotion_set_*, a PrEmotion_from_json_str document) with no
# signature change.
#
# Ranges, as documented on PrEmotion above and already enforced by its clamps:
#   valence    [-1.0, 1.0 ]   PRE_NEG_1_0 .. PRE_1_0
#   arousal    [ 0.0, 1.0 ]   PRE_0_0     .. PRE_1_0
#   smoothing  [ 0.0, 0.95]   PRE_0_0     .. PRE_0_95
# These are the module's own clamp bounds, not new numbers, and the test is
# EXACT (no tolerance) because nothing this module produces can land outside
# them: update() is a convex blend of two in-range values, and 748800 update
# steps -- smoothing k/64 for k = 0..64, a 9x5 grid of start states, all four
# target corners, 64 steps each -- never left [-1,1] x [0,1], landing exactly on
# +/-1.0, 0.0 and 1.0 at the extremes (measured 2026-08-31, pinned in
# tests/emotion.tcyr). Out-of-range values reach a PrEmotion only through
# PrEmotion_from_json_str (derive-generated, so unguardable from here) or a raw
# PrEmotion_set_* -- i.e. only from a document prani did not write.
#
# All five sites report PRANI_ERR_INVALID_VOCALIZATION: everything this module
# produces is a Vocalization, a CallIntent, or their modulation, and the
# oracle's PraniError::InvalidVocalization is "a vocalization parameter is
# invalid".
#
# DIVERGENCE from the oracle: EmotionState::evaluate() returns EmotionOutput,
# not Result, and the oracle stores a NaN just as happily (Rust's f32::clamp
# propagates NaN) while serde's derived Deserialize accepts any float for any
# field. Rejecting is deliberate, and the same call the port already made in
# ADR-0001 for crtract_new: report the failure, never fabricate an answer.
# ================================================================

# valence_zone(self) -- Negative if valence < -0.2, Positive if > 0.2, else Neutral.
# PRANI_ERR_INVALID_VOCALIZATION if valence is not in [-1.0, 1.0] (NaN included).
#must_use
fn emotion_valence_zone(self) {
    var v = PrEmotion_valence(self);
    if (prani_in_range(v, PRE_NEG_1_0, PRE_1_0) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    if (f64_lt(v, PRE_NEG_0_2)) { return PRE_VZ_NEGATIVE; }
    if (f64_gt(v, PRE_0_2))     { return PRE_VZ_POSITIVE; }
    return PRE_VZ_NEUTRAL;
}

# arousal_zone(self) -- Low if arousal < 0.33, High if > 0.66, else Mid.
# PRANI_ERR_INVALID_VOCALIZATION if arousal is not in [0.0, 1.0] (NaN included).
#must_use
fn emotion_arousal_zone(self) {
    var a = PrEmotion_arousal(self);
    if (prani_in_range(a, PRE_0_0, PRE_1_0) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    if (f64_lt(a, PRE_0_33)) { return PRE_AZ_LOW; }
    if (f64_gt(a, PRE_0_66)) { return PRE_AZ_HIGH; }
    return PRE_AZ_MID;
}

# select_vocalization(self) -- most appropriate Vocalization for the current
# (valence_zone, arousal_zone). Verbatim from the Rust match arms.
# PRANI_ERR_INVALID_VOCALIZATION if valence or arousal is out of range: the two
# zone calls range-check the field each one reads, so their code propagates
# rather than being re-tested here.
#must_use
fn emotion_select_vocalization(self) {
    var vz = emotion_valence_zone(self);
    if (prani_is_err(vz) == 1) { return vz; }
    var az = emotion_arousal_zone(self);
    if (prani_is_err(az) == 1) { return az; }
    var v = PrEmotion_valence(self);

    # High arousal, negative valence -> alarm/threat sounds
    if (vz == PRE_VZ_NEGATIVE) {
        if (az == PRE_AZ_HIGH) {
            if (f64_lt(v, PRE_NEG_0_5)) { return PRANI_VOC_SCREECH; }
            return PRANI_VOC_BARK;
        }
        # Low arousal, negative -> sullen; Mid arousal, negative -> threat
        return PRANI_VOC_GROWL;
    }
    if (vz == PRE_VZ_POSITIVE) {
        # High arousal, positive valence -> excited sounds
        if (az == PRE_AZ_HIGH) {
            if (f64_gt(v, PRE_0_5)) { return PRANI_VOC_TRILL; }
            return PRANI_VOC_CHIRP;
        }
        # Low arousal, positive -> content
        if (az == PRE_AZ_LOW) { return PRANI_VOC_PURR; }
        # Mid arousal, positive -> social
        return PRANI_VOC_HOWL;
    }
    # Neutral valence
    if (az == PRE_AZ_HIGH) { return PRANI_VOC_BARK; }    # high arousal, neutral -> alert
    if (az == PRE_AZ_LOW)  { return PRANI_VOC_RUMBLE; }  # low arousal, neutral -> idle rumble
    return PRANI_VOC_WHINE;                              # mid arousal, neutral -> idle
}

# select_intent(self) -- CallIntent for the current (valence_zone, arousal_zone).
# Verbatim from the Rust match arms.
# PRANI_ERR_INVALID_VOCALIZATION if valence or arousal is out of range (same
# propagation as select_vocalization above).
#must_use
fn emotion_select_intent(self) {
    var vz = emotion_valence_zone(self);
    if (prani_is_err(vz) == 1) { return vz; }
    var az = emotion_arousal_zone(self);
    if (prani_is_err(az) == 1) { return az; }
    var v = PrEmotion_valence(self);

    if (vz == PRE_VZ_NEGATIVE) {
        if (az == PRE_AZ_HIGH) {
            if (f64_lt(v, PRE_NEG_0_7)) { return PRANI_INTENT_DISTRESS; }
            return PRANI_INTENT_ALARM;
        }
        # Low arousal, negative -> Threat; Mid arousal, negative -> Threat
        return PRANI_INTENT_THREAT;
    }
    if (vz == PRE_VZ_POSITIVE) {
        if (az == PRE_AZ_HIGH) { return PRANI_INTENT_MATING; }  # high, positive -> Mating
        if (az == PRE_AZ_LOW)  { return PRANI_INTENT_IDLE; }    # low, positive -> Idle
        return PRANI_INTENT_SOCIAL;                             # mid, positive -> Social
    }
    # Neutral valence
    if (az == PRE_AZ_HIGH) { return PRANI_INTENT_ALARM; }  # high, neutral -> Alarm
    if (az == PRE_AZ_LOW)  { return PRANI_INTENT_IDLE; }   # low, neutral -> Idle
    return PRANI_INTENT_SOCIAL;                            # mid, neutral -> Social
}

# ================================================================
# EmotionOutput -- synthesis params derived from an EmotionState.
#   vocalization      : suggested Vocalization (PRANI_VOC_* code)
#   intent            : behavioral CallIntent (PRANI_INTENT_* code)
#   vocal_effort      : 0.0-1.0, from arousal
#   pitch_scale       : pitch multiplier, from valence
#   breathiness_delta : additive breathiness, from arousal extremes
# Distinct struct name (PrEmotionOut) to avoid accessor collisions.
# ================================================================
# Fields TYPED for #derive(Serialize): vocalization/intent are enum-const codes
# (i64), the three modulation params are f64. Untyped fields would serialize as
# raw bit patterns and fail to roundtrip. Auto-generates PrEmotionOut_to_json /
# PrEmotionOut_from_json_str, restoring the Rust `#[derive(Serialize,
# Deserialize)]` on EmotionOutput.
#derive(accessors)
#derive(Serialize)
struct PrEmotionOut {
    vocalization: i64;
    intent: i64;
    vocal_effort: i64;
    pitch_scale: i64;
    breathiness_delta: i64;
}

# evaluate(self) -- core mapping from the 2D emotion space to concrete
# vocalization choices and parameter values. Returns a fresh PrEmotionOut, or
# PRANI_ERR_INVALID_VOCALIZATION if the state is out of contract.
#
# This is the module's outermost entry point -- the one a PrEmotion that came
# from PrEmotion_from_json_str reaches -- so it checks all THREE fields, not
# just the two it reads. smoothing does not affect the output, but a smoothing
# outside [0.0, 0.95] cannot have come from with_smoothing (which clamps), only
# from a foreign document, and it turns update() from a convex blend into a
# divergence (s = 3.0 gives v' = 3v - 2*tv): the state is then guaranteed to
# leave contract on the next tick. Reporting it at the one checkable point
# beats letting it surface a tick later as an out-of-range valence.
#
# Validation happens BEFORE the allocation: a rejected state costs no arena.
#must_use
fn emotion_evaluate(self) {
    if (prani_in_range(PrEmotion_smoothing(self), PRE_0_0, PRE_0_95) == 0) {
        return PRANI_ERR_INVALID_VOCALIZATION;
    }
    var voc = emotion_select_vocalization(self);
    if (prani_is_err(voc) == 1) { return voc; }
    var intent = emotion_select_intent(self);
    if (prani_is_err(intent) == 1) { return intent; }

    var out = alloc(sizeof(PrEmotionOut));
    PrEmotionOut_set_vocalization(out, voc);
    PrEmotionOut_set_intent(out, intent);

    var arousal = PrEmotion_arousal(self);
    var valence = PrEmotion_valence(self);

    # Vocal effort driven primarily by arousal: 0.2 + arousal*0.7
    PrEmotionOut_set_vocal_effort(out, f64_add(PRE_0_2, f64_mul(arousal, PRE_0_7)));

    # Pitch scale from valence: 1.0 + valence*0.15
    PrEmotionOut_set_pitch_scale(out, f64_add(PRE_1_0, f64_mul(valence, PRE_0_15)));

    # Breathiness rises at arousal extremes.
    var breath = PRE_0_0;
    if (f64_gt(arousal, PRE_0_8)) {
        # up to +0.15 at max arousal: (arousal - 0.8) * 0.75
        breath = f64_mul(f64_sub(arousal, PRE_0_8), PRE_0_75);
    } else {
        if (f64_lt(arousal, PRE_0_2)) {
            # up to +0.1 at min arousal: (0.2 - arousal) * 0.5
            breath = f64_mul(f64_sub(PRE_0_2, arousal), PRE_0_5);
        }
    }
    PrEmotionOut_set_breathiness_delta(out, breath);
    return out;
}

# --- sequence.cyr ---

# sequence.cyr -- call sequencing: bouts, phrases, and chorus synthesis.
# Ports 2.0.3:rust-old/src/sequence.rs. Higher-level patterns above individual
# vocalizations: repeated call bouts, ordered phrases, and multi-voice chorus.
#
# Defines the CallElement / CallBout / CallPhrase data structs. species.cyr's
# bout_template constructs a CallBout, so this module's structs must be present
# in species' test unit (species does NOT call the synthesize methods, so their
# forward references to crvoice_* are unreachable there = warnings only).
#
# Requires (in the build/test unit): error.cyr (PRANI_ERR_*, prani_is_err, the
# prani_in_range family), vocalization.cyr (PRANI_VOC_COUNT / PRANI_INTENT_COUNT,
# read by the range guards), rng.cyr (prani_rng_*), and -- for the synthesize
# methods only -- voice.cyr (crvoice_vocalize_with_intent). The module file has
# no `include` lines.
#
# RESULT convention: synthesize* return a heap vec pointer on success or a
# negative PRANI_ERR_* on failure (propagated from crvoice_vocalize_with_intent).
# Callers check prani_is_err(result). serde RESTORED: CallElement/CallBout via
# #derive(Serialize); CallPhrase's element vec hand-rolled (see below). Display
# tests dropped (no Display in Cyrius).

var PRANI_CHORUS_PRIME = 7919;   # seed multiplier for chorus RNG (voices.len * 7919)

# ================================================================
# INPUT RANGES (2.0.5). Every entry point below rejects input outside these
# with a negative PRANI_ERR_* rather than returning empty, returning a
# correct-looking buffer, or aborting the process:
#
#   duration / gap / interval / timing_spread   finite, [0, MAX_SECONDS]
#   count, phrase elements, chorus voices       [0, MAX_COUNT] syntheses per call
#   sample_rate                                 finite, > 0 (svara owns the rest)
#   samples requested by one call               [0, MAX_SAMPLES]
#
# ZERO IS VALID everywhere it appears: the oracle's test_zero_duration_synthesis
# asserts an empty buffer rather than an error, and `count: u32` makes 0 a value
# the oracle accepts. Only NEGATIVE, NON-FINITE and ABSURD are rejected.
#
# sample_rate is bounded below by 0 and NOT above: ADR-0001 refuses to restate
# svara's threshold in prani, and the MAX_SAMPLES test below catches an absurd
# rate through the product it actually drives.
#
# WHY A SAMPLE CEILING RATHER THAN AN OVERFLOW CHECK (audit F10) -- measured on
# this tree 2026-08-31:
#   * timing_spread 1e6 s at 44100 Hz gives 4.41e10 offset samples, so the mix
#     alone demands 705.6 GB -- EIGHT ORDERS OF MAGNITUDE below the ~1e14 s the
#     audit names as the i64 overflow point. Exhaustion, not overflow, is what
#     is reachable, so the ALLOCATION is what has to be bounded.
#   * a vec past 2^28 elements dies with "vec: capacity overflow" and exit(1)
#     (lib/vec.cyr's push aborts when alloc fails; ALLOC_MAX is 2 GiB). A
#     library cannot report a process abort, so the check must come first.
#   * a NaN timing_spread gave max_offset_samples = i64::MIN, and i64::MIN * 2
#     WRAPS TO 0 -- so total_len collapsed to base_samples and the chorus
#     returned a correct-LENGTH buffer. That is a silent SUCCESS, not the silent
#     empty F11 describes.
#   * every call in a bout allocates ~2.5 KB of voice/tract state even at
#     duration 0, and the bump allocator never frees it, so `count` drives
#     unbounded allocation entirely on its own.
# ================================================================
# 1 h. The longest species bout_template call is 3 s; past an hour a "duration"
# is a units error, not a call.
var PRANI_SEQ_MAX_SECONDS = 3600;
# 128x the largest bout_template count (cricket, 8) and ~2.6 MB of per-call state.
var PRANI_SEQ_MAX_COUNT = 1024;
# 2^24 samples = 128 MiB of f64: 6m20s at 44.1 kHz, 87 s at 192 kHz, and 16x
# below the 2^28 element count measured to abort the process.
var PRANI_SEQ_MAX_SAMPLES = 16777216;

# 1 iff `x` is a usable span in SECONDS -- finite and within [0, MAX_SECONDS].
# A duration, a gap, an inter-call interval and a timing spread share it.
#must_use
fn prani_seq_seconds_ok(x) {
    return prani_in_range(x, 0, f64_from(PRANI_SEQ_MAX_SECONDS));
}

# 1 iff `samples` -- an f64 SAMPLE COUNT, not seconds -- is within the
# allocation ceiling for one entry-point call. Called on the REQUESTED total
# before anything is pushed, because a failed push is an abort, not a return
# value. The total, not just the longest buffer: the bump allocator never gives
# back the per-call buffers a bout or a chorus leaves behind.
#must_use
fn prani_seq_samples_ok(samples) {
    return prani_in_range(samples, 0, f64_from(PRANI_SEQ_MAX_SAMPLES));
}

# 1 iff `n` syntheses may be driven from one entry-point call: [0, MAX_COUNT].
# Bounds bout repetitions, phrase elements and chorus voices alike -- each is
# one full vocalize_with_intent, and each leaves per-call state behind.
#must_use
fn prani_seq_count_ok(n) {
    if (n < 0) { return 0; }
    if (n > PRANI_SEQ_MAX_COUNT) { return 0; }
    return 1;
}

# ================================================================
# CallElement -- one element in a phrase.
#   vocalization : PRANI_VOC_* constant
#   duration     : f64 seconds
#   gap          : f64 seconds of silence after this call
# ================================================================
# TYPED i64 for #derive(Serialize) → auto CallElement_to_json / _from_json_str.
# f64 fields (duration/gap) are typed i64 so their exact bit patterns serialize
# losslessly (the derive's 6-digit float writer would lose precision).
#derive(accessors)
#derive(Serialize)
struct CallElement {
    vocalization: i64;
    duration: i64;
    gap: i64;
}

# call_element_new(vocalization, duration, gap) -- one element of a CallPhrase:
# which vocalization to utter, for how long, and how much silence follows it.
# `duration` and `gap` are f64 SECONDS held in i64 slots as exact bit patterns
# (see the struct comment). Returns the CallElement ptr, or a NEGATIVE
# PRANI_ERR_INVALID_VOCALIZATION if `duration` or `gap` is non-finite or outside
# [0, PRANI_SEQ_MAX_SECONDS] (2.0.5). No signature change: "pointer or negative
# code" is the convention every fallible fn in the port already returns, and a
# heap pointer is never negative. Left unguarded here: `vocalization`, which
# crvoice_vocalize_with_intent already reports as INVALID_VOCALIZATION when the
# species cannot produce it -- an unknown code is reported, not fabricated.
#must_use
fn sequence_call_element_new(vocalization, duration, gap) {
    if (prani_seq_seconds_ok(duration) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    if (prani_seq_seconds_ok(gap) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var e = alloc(sizeof(CallElement));
    CallElement_set_vocalization(e, vocalization);
    CallElement_set_duration(e, duration);
    CallElement_set_gap(e, gap);
    return e;
}

# ================================================================
# CallBout -- repeated instances of the same vocalization.
#   vocalization  : PRANI_VOC_* constant
#   count         : u32 repetitions
#   call_duration : f64 seconds per call
#   interval      : f64 inter-call interval (seconds)
#   intent        : PRANI_INTENT_* constant
# ================================================================
# TYPED i64 for #derive(Serialize) → auto CallBout_to_json / _from_json_str.
# f64 fields (call_duration/interval) typed i64 → exact bit-pattern serialization.
#derive(accessors)
#derive(Serialize)
struct CallBout {
    vocalization: i64;
    count: i64;
    call_duration: i64;
    interval: i64;
    intent: i64;
}

# call_bout_new(vocalization, count, call_duration, interval, intent) -- a bout
# is the same vocalization repeated `count` times with `interval` seconds of
# silence between calls (not after the last). `call_duration` and `interval` are
# f64 seconds as exact bit patterns. Returns the CallBout ptr; render it with
# sequence_call_bout_synthesize.
#
# 2.0.5: returns a NEGATIVE PRANI_ERR_INVALID_VOCALIZATION if `count` is outside
# [0, PRANI_SEQ_MAX_COUNT] or either span is non-finite or outside
# [0, PRANI_SEQ_MAX_SECONDS]. `count` 0 stays VALID (the oracle's u32 accepts it
# and the bout renders empty); a NEGATIVE count is a state the oracle's u32
# could not represent, and before this guard it rendered an empty buffer as a
# SUCCESS rather than saying so.
#must_use
fn sequence_call_bout_new(vocalization, count, call_duration, interval, intent) {
    if (prani_seq_count_ok(count) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    if (prani_seq_seconds_ok(call_duration) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    if (prani_seq_seconds_ok(interval) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var b = alloc(sizeof(CallBout));
    CallBout_set_vocalization(b, vocalization);
    CallBout_set_count(b, count);
    CallBout_set_call_duration(b, call_duration);
    CallBout_set_interval(b, interval);
    CallBout_set_intent(b, intent);
    return b;
}

# CallBout::synthesize -- render the whole bout to one buffer. For each of
# `count` calls: synthesize via the voice, then (except after the last) append
# `interval * sample_rate` samples of silence. Returns a vec or a negative error.
#
# 2.0.5 guards. The fields are re-checked HERE, not trusted from the
# constructor: CallBout_from_json_str and the #derive(accessors) setters have no
# error channel, so a bout can reach this function without ever passing
# sequence_call_bout_new. `sample_rate` is INVALID_TRACT (a rate is a tract
# parameter, ADR-0001's category); the rest are INVALID_VOCALIZATION.
fn sequence_call_bout_synthesize(self, voice, sample_rate) {
    if (prani_is_positive(sample_rate) == 0) { return PRANI_ERR_INVALID_TRACT; }
    var count = CallBout_count(self);
    if (prani_seq_count_ok(count) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var call_duration = CallBout_call_duration(self);
    var interval = CallBout_interval(self);
    if (prani_seq_seconds_ok(call_duration) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    if (prani_seq_seconds_ok(interval) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    # Bound the ALLOCATION before the first push: count * (call + interval)
    # seconds of samples. The intent's duration_scale (at most 2.0) is left out
    # deliberately -- it can only double the rendered length, which still leaves
    # the true ceiling 8x below the measured abort.
    var want = f64_mul(f64_mul(f64_add(call_duration, interval), f64_from(count)), sample_rate);
    if (prani_seq_samples_ok(want) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }

    var gap_samples = f64_to(f64_mul(interval, sample_rate));
    var output = vec_new();
    var i = 0;
    while (i < count) {
        var call = crvoice_vocalize_with_intent(voice, CallBout_vocalization(self),
          CallBout_intent(self), sample_rate, call_duration);
        if (prani_is_err(call) == 1) { return call; }
        prani_vec_extend(output, call);
        if (i < (count - 1)) {
            # Unreachable after the guards above (interval >= 0 and sample_rate
            # > 0 make gap_samples >= 0); checked anyway so a future path into
            # this loop reports instead of silently appending nothing.
            var gap_rc = prani_vec_push_zeros(output, gap_samples);
            if (prani_is_err(gap_rc) == 1) { return gap_rc; }
        }
        i = i + 1;
    }
    return output;
}

# ================================================================
# CallPhrase -- ordered sequence of different vocalizations.
#   elements : vec of CallElement pointers
#   intent   : PRANI_INTENT_* applied to all elements
# ================================================================
#derive(accessors)
struct CallPhrase { elements; intent; }

# call_phrase_new(elements, intent) -- a phrase is an ordered sequence of
# DIFFERENT vocalizations, each with its own duration and trailing gap.
# `elements` is a vec of CallElement pointers; `intent` applies to all of them.
# Returns the CallPhrase ptr; render it with sequence_call_phrase_synthesize.
#
# Unguarded on purpose (2.0.5): neither parameter is numeric. The elements were
# ranged when they were built and are ranged again by the synthesize pre-pass
# (which is also where the element COUNT is bounded), and an unknown `intent` is
# vocalization.cyr's contract to keep total, not this module's to redefine --
# the one place a nonsense discriminant is rejected is the JSON codec below,
# where the document came from outside prani.
#must_use
fn sequence_call_phrase_new(elements, intent) {
    var p = alloc(sizeof(CallPhrase));
    CallPhrase_set_elements(p, elements);
    CallPhrase_set_intent(p, intent);
    return p;
}

# CallPhrase serde -- restores the Rust `#[derive(Serialize, Deserialize)]`.
# `elements` is a vec of CallElement, which #derive(Serialize) can't express, so
# the codec is hand-rolled: emit {"intent":N,"elements":[<CallElement json>,…]}
# (delegating each element to its auto CallElement_to_json), and parse with
# bayan's value-tree, rebuilding each element via CallElement_from_json_str
# (re-serializing the array-element node). Roundtrip is idempotent.
fn sequence_call_phrase_to_json(self, sb) {
    str_builder_add_cstr(sb, "{\"intent\":");
    str_builder_add_int(sb, CallPhrase_intent(self));
    str_builder_add_cstr(sb, ",\"elements\":[");
    var elems = CallPhrase_elements(self);
    var n = vec_len(elems);
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        CallElement_to_json(vec_get(elems, i), sb);
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    return 0;
}

# call_phrase_from_json_str(json) -- rebuild a CallPhrase from
# sequence_call_phrase_to_json output. `json` is a NUL-terminated cstring; each
# array element is read field-by-field straight from the parsed node.
# Returns the CallPhrase ptr, or a NEGATIVE PRANI_ERR_INVALID_VOCALIZATION if
# `json` is 0, does not parse, or PARSES AND CARRIES OUT-OF-RANGE FIELDS -- the
# half ADR-0002 left to roadmap 2.0.5: intent and each element's vocalization
# must be a real discriminant, each element's duration/gap a span in range, and
# the array no longer than PRANI_SEQ_MAX_COUNT (an untrusted document allocates
# an element per entry before anything looks at it).
#
# A phrase built through the constructors above satisfies all four by
# construction, so it always round-trips; what this rejects is a document prani
# did not write (or one serialized from a struct mutated past its constructor).
fn sequence_call_phrase_from_json_str(json) {
    if (json == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var root = bayan_json_v_parse_buf(json, strlen(json));
    if (root == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var intent = bayan_json_v_int(bayan_json_v_obj_get(root, "intent"));
    if (intent < 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    if (intent >= PRANI_INTENT_COUNT) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var elems_val = bayan_json_v_obj_get(root, "elements");
    var n = bayan_json_v_arr_len(elems_val);
    if (prani_seq_count_ok(n) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var elems = vec_new();
    var i = 0;
    while (i < n) {
        # Read each element's fields DIRECTLY from the parsed array-element node
        # (duration/gap are i64 bit patterns). Avoids re-serializing the node.
        var ev = bayan_json_v_arr_get(elems_val, i);
        var voc = bayan_json_v_int(bayan_json_v_obj_get(ev, "vocalization"));
        if (voc < 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
        if (voc >= PRANI_VOC_COUNT) { return PRANI_ERR_INVALID_VOCALIZATION; }
        # The duration/gap ranges are the constructor's, reused rather than
        # restated, so the codec and the builder can never disagree.
        var e = sequence_call_element_new(voc,
          bayan_json_v_int(bayan_json_v_obj_get(ev, "duration")),
          bayan_json_v_int(bayan_json_v_obj_get(ev, "gap")));
        if (prani_is_err(e) == 1) { return PRANI_ERR_INVALID_VOCALIZATION; }
        vec_push(elems, e);
        i = i + 1;
    }
    return sequence_call_phrase_new(elems, intent);
}

# CallPhrase::synthesize -- render each element then append `gap * sr` silence.
# Returns a vec or a negative error.
#
# 2.0.5 guards. Same point-of-use argument as the bout: the elements can arrive
# from sequence_call_phrase_from_json_str or a setter. The element pre-pass runs
# to completion BEFORE the first synthesis, so a bad element at the end of the
# phrase is reported instead of being reached after most of the buffer is built.
fn sequence_call_phrase_synthesize(self, voice, sample_rate) {
    if (prani_is_positive(sample_rate) == 0) { return PRANI_ERR_INVALID_TRACT; }
    var elements = CallPhrase_elements(self);
    var n = vec_len(elements);
    if (prani_seq_count_ok(n) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var want = 0;
    var k = 0;
    while (k < n) {
        var el = vec_get(elements, k);
        if (prani_seq_seconds_ok(CallElement_duration(el)) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
        if (prani_seq_seconds_ok(CallElement_gap(el)) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
        want = f64_add(want, f64_add(CallElement_duration(el), CallElement_gap(el)));
        k = k + 1;
    }
    if (prani_seq_samples_ok(f64_mul(want, sample_rate)) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }

    var output = vec_new();
    var i = 0;
    while (i < n) {
        var element = vec_get(elements, i);
        var call = crvoice_vocalize_with_intent(voice, CallElement_vocalization(element),
          CallPhrase_intent(self), sample_rate, CallElement_duration(element));
        if (prani_is_err(call) == 1) { return call; }
        prani_vec_extend(output, call);
        # Unreachable after the pre-pass (gap >= 0, sample_rate > 0); checked so
        # a future path in reports rather than appending nothing in silence.
        var gap_rc = prani_vec_push_zeros(output, f64_to(f64_mul(CallElement_gap(element), sample_rate)));
        if (prani_is_err(gap_rc) == 1) { return gap_rc; }
        i = i + 1;
    }
    return output;
}

# ================================================================
# synthesize_chorus -- multiple voices with timing variation, summed and
# normalized. `voices` is a vec of CreatureVoice pointers. Returns a vec or a
# negative error (empty vec if `voices` is empty).
# ================================================================
fn sequence_synthesize_chorus(voices, vocalization, intent, sample_rate, duration, timing_spread) {
    var voice_count = vec_len(voices);
    # The empty-voices short circuit stays FIRST: the oracle returns Ok(vec![])
    # before it reads any number, and no number is used on that path.
    if (voice_count == 0) { return vec_new(); }

    # 2.0.5 / audit F10. Every guard here runs BEFORE the mix is allocated,
    # which is the whole point: prani_vec_push_zeros cannot report a failed
    # alloc, lib/vec.cyr aborts the process instead.
    if (prani_seq_count_ok(voice_count) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    if (prani_is_positive(sample_rate) == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (prani_seq_seconds_ok(duration) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    if (prani_seq_seconds_ok(timing_spread) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    # The mix spans duration + 2 * timing_spread seconds, and every voice also
    # renders its own call buffer that the bump allocator never gives back, so
    # the ceiling is applied to span * voices (an over-estimate that covers both,
    # since span >= duration). Bounding THAT rather than only the i64 sum below
    # is what closes F10: at 44100 Hz a spread of 1e6 s demands 705.6 GB, which
    # no overflow check would ever have caught.
    var span = f64_add(duration, f64_mul(f64_from(2), timing_spread));
    var want = f64_mul(f64_mul(span, f64_from(voice_count)), sample_rate);
    if (prani_seq_samples_ok(want) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }

    var max_offset_samples = f64_to(f64_mul(timing_spread, sample_rate));
    var base_samples = f64_to(f64_mul(duration, sample_rate));
    # total length includes the spread for late-starting voices. Both terms are
    # now non-negative and bounded by MAX_SAMPLES, so the sum cannot overflow.
    var total_len = base_samples + max_offset_samples * 2;

    # mix = vec of total_len zeros
    var mix = vec_new();
    var mix_rc = prani_vec_push_zeros(mix, total_len);
    if (prani_is_err(mix_rc) == 1) { return mix_rc; }

    var rng = prani_rng_new(voice_count * PRANI_CHORUS_PRIME);

    # modulo divisor: max(max_offset_samples, 1) * 2
    var mo = max_offset_samples;
    if (mo < 1) { mo = 1; }
    var divisor = mo * 2;

    var vi = 0;
    while (vi < voice_count) {
        var voice = vec_get(voices, vi);
        var call = crvoice_vocalize_with_intent(voice, vocalization, intent, sample_rate, duration);
        if (prani_is_err(call) == 1) { return call; }
        # random offset within timing_spread
        var offset = prani_rng_next_u32(rng) % divisor;
        var m = vec_len(call);
        var i = 0;
        while (i < m) {
            var idx = offset + i;
            if (idx < total_len) {
                vec_set(mix, idx, f64_add(vec_get(mix, idx), vec_get(call, i)));
            }
            i = i + 1;
        }
        vi = vi + 1;
    }

    # normalize by 1/sqrt(voice_count) to prevent clipping
    var scale = f64_div(F64_ONE, f64_sqrt(f64_from(voice_count)));
    var s = 0;
    while (s < total_len) {
        vec_set(mix, s, f64_mul(vec_get(mix, s), scale));
        s = s + 1;
    }
    return mix;
}

# --- species.cyr ---

# species.cyr -- creature species definitions + per-species vocal parameters.
# Ports 2.0.3:rust-old/src/species.rs. Two enums (Species, VocalApparatus) ->
# integer constants, the SpeciesParams struct, the big per-species params()
# lookup, the supports_vocalization() bioacoustic gate, and bout_template()
# (a CallBout per species). serde RESTORED on SpeciesParams via
# #derive(Serialize) (all fields typed i64 for lossless bit-pattern roundtrip);
# integer codes throughout.
#
# Requires (in the build/test unit): vocalization.cyr (PRANI_VOC_*/PRANI_INTENT_*)
# and sequence.cyr (CallBout struct + sequence_call_bout_new). The module file
# has no `include` lines -- the entry orders the deps.
#
# FLOATS: prani's Rust was f32; this port is f64 (svara/naad/hisab are f64-only).
# Integer-valued params via f64_from(n) (negatives via f64_neg(f64_from(n)));
# non-integer params via module-top IEEE-754 hex constants (decimals in comments),
# one constant per distinct value.
#
# RESONANCE_SEED PARITY (critical): the Rust SpeciesParams::resonance_seed() hashes
# the *f32 bit patterns* of f0_default and tract_scale. Recomputing it from the
# widened f64 fields would use the wrong bits, so the 13 seeds are PRECOMPUTED with
# exact f32 semantics and stored in each species' resonance_seed field. The seeds
# were verified against the oracle's hash (f0_default.to_bits() as u64) ^
# ((tract_scale.to_bits() as u64) << 32), then *6364136223846793005 +1, wrapping.

# ================================================================
# Species -- creature species (was `enum Species`, 13 variants). Discriminant ==
# declaration order (0-based), matching Rust's default enum layout.
# ================================================================
var PRANI_SP_WOLF        = 0;    # long howls, barks, growls, whines. f0 150-1200
var PRANI_SP_DOG         = 1;    # barks, whines, growls, yelps. f0 100-2000
var PRANI_SP_CAT         = 2;    # meow, purr, hiss, yowl. f0 200-1000
var PRANI_SP_LION        = 3;    # roar, growl, grunt. f0 40-200 (infrasonic capable)
var PRANI_SP_SONGBIRD    = 4;    # chirps, trills, warbles. f0 1000-8000 (syrinx)
var PRANI_SP_CROW        = 5;    # caw, croak, rattle. f0 500-2000
var PRANI_SP_RAPTOR      = 6;    # screech, kee. f0 2000-4000
var PRANI_SP_SNAKE       = 7;    # hiss (noise-based, no vocal folds). No f0
var PRANI_SP_CROCODILIAN = 8;    # bellow, hiss, growl. f0 30-200
var PRANI_SP_CRICKET     = 9;    # chirp via stridulation. f0 3000-8000
var PRANI_SP_BEE         = 10;   # buzz via wing vibration. f0 200-500
var PRANI_SP_DRAGON      = 11;   # roar with subharmonics, fire-breath noise
var PRANI_SP_FANTASY     = 12;   # generic fantasy creature (configurable)

var PRANI_SP_COUNT = 13;         # number of Species variants

# ================================================================
# VocalApparatus -- excitation model (was `enum VocalApparatus`, 5 variants).
# Discriminant == declaration order (0-based).
# ================================================================
var PRANI_APP_LARYNGEAL    = 0;   # larynx w/ vocal folds (mammals, reptiles)
var PRANI_APP_SYRINGEAL    = 1;   # syrinx (birds), dual-source, higher f0
var PRANI_APP_STRIDULATORY = 2;   # stridulation (insects), friction-based
var PRANI_APP_VIBRATILE    = 3;   # vibratile (bees, flies), wing vibration
var PRANI_APP_NOISE_ONLY   = 4;   # noise-only (snakes), no periodic source

# ================================================================
# Non-integer parameter constants (IEEE-754 hex; decimals in comments). One
# constant per distinct value; shared across species where equal.
# ================================================================
# tract_scale
var PR_TS_1_2  = 0x3ff3333333333333;   # 1.2
var PR_TS_0_9  = 0x3feccccccccccccd;   # 0.9
var PR_TS_0_5  = 0x3fe0000000000000;   # 0.5
var PR_TS_0_15 = 0x3fc3333333333333;   # 0.15
var PR_TS_0_3  = 0x3fd3333333333333;   # 0.3
var PR_TS_0_2  = 0x3fc999999999999a;   # 0.2
var PR_TS_0_4  = 0x3fd999999999999a;   # 0.4
var PR_TS_2_5  = 0x4004000000000000;   # 2.5
var PR_TS_0_05 = 0x3fa999999999999a;   # 0.05
var PR_TS_0_03 = 0x3f9eb851eb851eb8;   # 0.03

# breathiness
var PR_BR_0_05 = 0x3fa999999999999a;   # 0.05
var PR_BR_0_03 = 0x3f9eb851eb851eb8;   # 0.03
var PR_BR_0_08 = 0x3fb47ae147ae147b;   # 0.08
var PR_BR_0_1  = 0x3fb999999999999a;   # 0.1
var PR_BR_0_02 = 0x3f947ae147ae147b;   # 0.02
var PR_BR_0_18 = 0x3fc70a3d70a3d70a;   # 0.18
var PR_BR_0_15 = 0x3fc3333333333333;   # 0.15
var PR_BR_0_2  = 0x3fc999999999999a;   # 0.2

# jitter
var PR_JI_0_015 = 0x3f8eb851eb851eb8;   # 0.015
var PR_JI_0_012 = 0x3f889374bc6a7efa;   # 0.012
var PR_JI_0_02  = 0x3f947ae147ae147b;   # 0.02
var PR_JI_0_025 = 0x3f9999999999999a;   # 0.025
var PR_JI_0_005 = 0x3f747ae147ae147b;   # 0.005
var PR_JI_0_03  = 0x3f9eb851eb851eb8;   # 0.03
var PR_JI_0_01  = 0x3f847ae147ae147b;   # 0.01
var PR_JI_0_002 = 0x3f60624dd2f1a9fc;   # 0.002
var PR_JI_0_001 = 0x3f50624dd2f1a9fc;   # 0.001
var PR_JI_0_04  = 0x3fa47ae147ae147b;   # 0.04

# shimmer
var PR_SH_0_03  = 0x3f9eb851eb851eb8;   # 0.03
var PR_SH_0_025 = 0x3f9999999999999a;   # 0.025
var PR_SH_0_04  = 0x3fa47ae147ae147b;   # 0.04
var PR_SH_0_05  = 0x3fa999999999999a;   # 0.05
var PR_SH_0_01  = 0x3f847ae147ae147b;   # 0.01
var PR_SH_0_02  = 0x3f947ae147ae147b;   # 0.02
var PR_SH_0_06  = 0x3faeb851eb851eb8;   # 0.06
var PR_SH_0_005 = 0x3f747ae147ae147b;   # 0.005
var PR_SH_0_003 = 0x3f689374bc6a7efa;   # 0.003
var PR_SH_0_08  = 0x3fb47ae147ae147b;   # 0.08

# spectral_tilt (only -1.5 is non-integer; others via f64_neg(f64_from(n)))
var PR_TILT_NEG_1_5 = 0xbff8000000000000;   # -1.5

# bout call_duration / interval (non-integer values)
var PR_DUR_0_15 = 0x3fc3333333333333;   # 0.15
var PR_DUR_0_25 = 0x3fd0000000000000;   # 0.25
var PR_DUR_0_6  = 0x3fe3333333333333;   # 0.6
var PR_DUR_0_3  = 0x3fd3333333333333;   # 0.3
var PR_DUR_0_2  = 0x3fc999999999999a;   # 0.2
var PR_DUR_0_8  = 0x3fe999999999999a;   # 0.8
var PR_DUR_0_5  = 0x3fe0000000000000;   # 0.5
var PR_DUR_1_5  = 0x3ff8000000000000;   # 1.5

# ================================================================
# Precomputed resonance seeds (i64) -- see the RESONANCE_SEED note at file top.
# Each is hash(f32_bits(f0_default) ^ (f32_bits(tract_scale) << 32)) under the
# oracle's PCG-style mix; stored as the exact seed for that species.
# ================================================================
var PR_SEED_WOLF        = 2180968338894094337;
var PR_SEED_DOG         = (0 - 4557473707297210367);
var PR_SEED_CAT         = 7081886529608613889;
var PR_SEED_LION        = (0 - 8498740852407926783);
var PR_SEED_SONGBIRD    = 3639187878752649217;
var PR_SEED_CROW        = 570450708879900673;
var PR_SEED_RAPTOR      = (0 - 8931005506639151103);
var PR_SEED_SNAKE       = (0 - 5554430339172007935);
var PR_SEED_CROCODILIAN = (0 - 6399601664865599487);
var PR_SEED_CRICKET     = (0 - 1841638068586012671);
var PR_SEED_BEE         = 4722345285137596417;
var PR_SEED_DRAGON      = 4739032052804616193;
var PR_SEED_FANTASY     = 3551275586278653953;

# ================================================================
# Input ranges (roadmap 2.0.5; audit finding F11). Every bound below is either
# transcribed from the oracle's own doc comments on `struct SpeciesParams`
# (git show 2.0.3:rust-old/src/species.rs:70-101 -- "Default breathiness
# (0.0-1.0)", "Default jitter (0.0-0.05)", "Default shimmer (0.0-0.1)") or
# derived from the 13-row table in species_params_into below. The whole table
# and every builder-clamped mutation of it satisfy these by construction, so the
# ranges only ever reject a document prani did NOT write.
#
# The two magnitude ceilings that are NOT in the oracle:
#   PR_SP_F0_MAX / PR_SP_FORMANT_MAX / PR_SP_BW_MAX = 20000 Hz -- the top of the
#     audio band. The table's widest is 13500 Hz (cricket F3), so this is ~1.5x
#     headroom over anything prani ships, and above it no partial survives any
#     sample rate prani runs at.
#   PR_SP_TRACT_MAX = 100 -- 100x the human-male reference tract. The table's
#     longest is 3.0 (dragon), so ~33x headroom.
# Both are deliberately loose: their job is to bound nonsense, not to second-
# guess a host that configures a Fantasy creature.
# ================================================================
var PR_SP_F0_MAX      = 0x40d3880000000000;   # 20000.0 Hz
var PR_SP_FORMANT_MAX = 0x40d3880000000000;   # 20000.0 Hz
var PR_SP_BW_MAX      = 0x40d3880000000000;   # 20000.0 Hz
var PR_SP_TRACT_MAX   = 0x4059000000000000;   # 100.0 x human-male reference
var PR_SP_BREATH_MAX  = 0x3ff0000000000000;   # 1.0
var PR_SP_JITTER_MAX  = 0x3fa999999999999a;   # 0.05  (== voice.cyr PR_V_0_05)
var PR_SP_SHIMMER_MAX = 0x3fb999999999999a;   # 0.1   (== voice.cyr PR_V_0_1)

# ================================================================
# SpeciesParams -- species-specific vocal parameters. The Rust `formants: [f32;3]`
# and `bandwidths: [f32;3]` fixed arrays become the three formant0..2 /
# bandwidth0..2 scalar fields (direct parity with the fixed arrays).
#   apparatus     : PRANI_APP_* constant
#   f0_min/max/default : fundamental frequency range (Hz)
#   tract_scale   : vocal-tract length scaling (1.0 = human male reference)
#   formant0..2   : formant frequencies F1-F3 (Hz)
#   bandwidth0..2 : formant bandwidths B1-B3 (Hz)
#   breathiness   : default breathiness (0..1)
#   jitter        : default jitter (0..0.05)
#   shimmer       : default shimmer (0..0.1)
#   spectral_tilt : spectral tilt in dB/octave (negative = darker)
#   resonance_seed: precomputed deterministic seed (f32-bit-pattern parity)
# ================================================================
# Fields TYPED i64 for #derive(Serialize): apparatus + resonance_seed are genuine
# integers; every physical vocal parameter is an f64 bit pattern serialized as an
# int → exact 64-bit lossless roundtrip (f64 typing = the derive's 6-decimal
# float writer, which is lossy). Auto-generates SpeciesParams_to_json(
# self, sb) + SpeciesParams_from_json_str(json) — ports the Rust `#[derive(Serialize,
# Deserialize)]` on SpeciesParams (species-preset persistence).
#derive(accessors)
#derive(Serialize)
struct SpeciesParams {
    apparatus: i64;
    f0_min: i64;
    f0_max: i64;
    f0_default: i64;
    tract_scale: i64;
    formant0: i64;
    formant1: i64;
    formant2: i64;
    bandwidth0: i64;
    bandwidth1: i64;
    bandwidth2: i64;
    breathiness: i64;
    jitter: i64;
    shimmer: i64;
    spectral_tilt: i64;
    resonance_seed: i64;
}

# Internal builder -- fills every field in declaration order.
#must_use
fn species_params_make(apparatus, f0_min, f0_max, f0_default, tract_scale,
  formant0, formant1, formant2, bandwidth0, bandwidth1, bandwidth2,
  breathiness, jitter, shimmer, spectral_tilt, resonance_seed) {
    return species_params_make_into(alloc(sizeof(SpeciesParams)),
      apparatus, f0_min, f0_max, f0_default, tract_scale,
      formant0, formant1, formant2, bandwidth0, bandwidth1, bandwidth2,
      breathiness, jitter, shimmer, spectral_tilt, resonance_seed);
}

# species_params_make_into(p, ...) -- the field writes, into a SpeciesParams the
# caller already owns. Split out of species_params_make so the per-species table
# below can serve both an allocating and a non-allocating entry point from ONE
# copy of the table (see species_params / species_params_into). Returns `p`.
fn species_params_make_into(p, apparatus, f0_min, f0_max, f0_default, tract_scale,
  formant0, formant1, formant2, bandwidth0, bandwidth1, bandwidth2,
  breathiness, jitter, shimmer, spectral_tilt, resonance_seed) {
    SpeciesParams_set_apparatus(p, apparatus);
    SpeciesParams_set_f0_min(p, f0_min);
    SpeciesParams_set_f0_max(p, f0_max);
    SpeciesParams_set_f0_default(p, f0_default);
    SpeciesParams_set_tract_scale(p, tract_scale);
    SpeciesParams_set_formant0(p, formant0);
    SpeciesParams_set_formant1(p, formant1);
    SpeciesParams_set_formant2(p, formant2);
    SpeciesParams_set_bandwidth0(p, bandwidth0);
    SpeciesParams_set_bandwidth1(p, bandwidth1);
    SpeciesParams_set_bandwidth2(p, bandwidth2);
    SpeciesParams_set_breathiness(p, breathiness);
    SpeciesParams_set_jitter(p, jitter);
    SpeciesParams_set_shimmer(p, shimmer);
    SpeciesParams_set_spectral_tilt(p, spectral_tilt);
    SpeciesParams_set_resonance_seed(p, resonance_seed);
    return p;
}

# species_params -- Species::params(). Allocates a SpeciesParams and fills it
# from the per-species table. The table itself lives in species_params_into.
#must_use
fn species_params(species) {
    return species_params_into(alloc(sizeof(SpeciesParams)), species);
}

# species_params_into(dst, species) -- the big per-species lookup, transcribed
# verbatim from the oracle match arms, written into a SpeciesParams the caller
# already owns. Integer params via f64_from; non-integer via the hex constants
# above; negative integer tilts via f64_neg(f64_from(n)). Returns `dst`.
#
# This is the ONLY copy of the table; species_params is the allocating wrapper
# over it. The non-allocating form exists for crvoice_reset_individual, which the
# FFI size RTPC calls and which a host may call every frame -- under a bump
# allocator that never frees, a 128-byte SpeciesParams per call is retained for
# the life of the process.
fn species_params_into(dst, species) {
    if (species == PRANI_SP_WOLF) {
        return species_params_make_into(dst, PRANI_APP_LARYNGEAL,
          f64_from(150), f64_from(1200), f64_from(400), PR_TS_1_2,
          f64_from(420), f64_from(1250), f64_from(2100),
          f64_from(100), f64_from(120), f64_from(150),
          PR_BR_0_05, PR_JI_0_015, PR_SH_0_03, f64_neg(f64_from(3)), PR_SEED_WOLF);
    }
    if (species == PRANI_SP_DOG) {
        return species_params_make_into(dst, PRANI_APP_LARYNGEAL,
          f64_from(100), f64_from(2000), f64_from(300), PR_TS_0_9,
          f64_from(550), f64_from(1650), f64_from(2750),
          f64_from(100), f64_from(130), f64_from(160),
          PR_BR_0_03, PR_JI_0_012, PR_SH_0_025, f64_neg(f64_from(2)), PR_SEED_DOG);
    }
    if (species == PRANI_SP_CAT) {
        return species_params_make_into(dst, PRANI_APP_LARYNGEAL,
          f64_from(200), f64_from(1000), f64_from(500), PR_TS_0_5,
          f64_from(850), f64_from(2500), f64_from(4200),
          f64_from(120), f64_from(150), f64_from(200),
          PR_BR_0_08, PR_JI_0_02, PR_SH_0_04, f64_neg(f64_from(2)), PR_SEED_CAT);
    }
    if (species == PRANI_SP_LION) {
        return species_params_make_into(dst, PRANI_APP_LARYNGEAL,
          f64_from(40), f64_from(200), f64_from(80), f64_from(2),
          f64_from(250), f64_from(750), f64_from(1250),
          f64_from(80), f64_from(100), f64_from(130),
          PR_BR_0_1, PR_JI_0_025, PR_SH_0_05, f64_neg(f64_from(6)), PR_SEED_LION);
    }
    if (species == PRANI_SP_SONGBIRD) {
        return species_params_make_into(dst, PRANI_APP_SYRINGEAL,
          f64_from(1000), f64_from(8000), f64_from(3000), PR_TS_0_15,
          f64_from(3500), f64_from(7000), f64_from(10500),
          f64_from(500), f64_from(800), f64_from(1100),
          PR_BR_0_02, PR_JI_0_005, PR_SH_0_01, f64_neg(f64_from(1)), PR_SEED_SONGBIRD);
    }
    if (species == PRANI_SP_CROW) {
        return species_params_make_into(dst, PRANI_APP_SYRINGEAL,
          f64_from(500), f64_from(2000), f64_from(800), PR_TS_0_3,
          f64_from(1400), f64_from(4200), f64_from(7000),
          f64_from(350), f64_from(500), f64_from(700),
          PR_BR_0_18, PR_JI_0_03, PR_SH_0_05, f64_neg(f64_from(2)), PR_SEED_CROW);
    }
    if (species == PRANI_SP_RAPTOR) {
        return species_params_make_into(dst, PRANI_APP_SYRINGEAL,
          f64_from(2000), f64_from(4000), f64_from(2500), PR_TS_0_2,
          f64_from(2100), f64_from(5500), f64_from(8500),
          f64_from(400), f64_from(600), f64_from(800),
          PR_BR_0_1, PR_JI_0_01, PR_SH_0_02, PR_TILT_NEG_1_5, PR_SEED_RAPTOR);
    }
    if (species == PRANI_SP_SNAKE) {
        return species_params_make_into(dst, PRANI_APP_NOISE_ONLY,
          f64_from(0), f64_from(0), f64_from(0), PR_TS_0_4,
          f64_from(2500), f64_from(5000), f64_from(8000),
          f64_from(1500), f64_from(2000), f64_from(2500),
          f64_from(1), f64_from(0), f64_from(0), f64_from(0), PR_SEED_SNAKE);
    }
    if (species == PRANI_SP_CROCODILIAN) {
        return species_params_make_into(dst, PRANI_APP_LARYNGEAL,
          f64_from(30), f64_from(200), f64_from(60), PR_TS_2_5,
          f64_from(200), f64_from(600), f64_from(1000),
          f64_from(70), f64_from(90), f64_from(120),
          PR_BR_0_15, PR_JI_0_03, PR_SH_0_06, f64_neg(f64_from(5)), PR_SEED_CROCODILIAN);
    }
    if (species == PRANI_SP_CRICKET) {
        return species_params_make_into(dst, PRANI_APP_STRIDULATORY,
          f64_from(3000), f64_from(8000), f64_from(4500), PR_TS_0_05,
          f64_from(4500), f64_from(9000), f64_from(13500),
          f64_from(500), f64_from(800), f64_from(1000),
          f64_from(0), PR_JI_0_002, PR_SH_0_005, f64_neg(f64_from(1)), PR_SEED_CRICKET);
    }
    if (species == PRANI_SP_BEE) {
        return species_params_make_into(dst, PRANI_APP_VIBRATILE,
          f64_from(200), f64_from(500), f64_from(300), PR_TS_0_03,
          f64_from(300), f64_from(600), f64_from(900),
          f64_from(100), f64_from(200), f64_from(300),
          f64_from(0), PR_JI_0_001, PR_SH_0_003, f64_neg(f64_from(1)), PR_SEED_BEE);
    }
    if (species == PRANI_SP_DRAGON) {
        return species_params_make_into(dst, PRANI_APP_LARYNGEAL,
          f64_from(30), f64_from(500), f64_from(70), f64_from(3),
          f64_from(170), f64_from(500), f64_from(850),
          f64_from(60), f64_from(80), f64_from(110),
          PR_BR_0_2, PR_JI_0_04, PR_SH_0_08, f64_neg(f64_from(4)), PR_SEED_DRAGON);
    }
    # PRANI_SP_FANTASY (default / fallthrough -- preserves totality since the
    # Rust enum is #[non_exhaustive]; every valid species maps above).
    return species_params_make_into(dst, PRANI_APP_LARYNGEAL,
      f64_from(50), f64_from(2000), f64_from(200), f64_from(1),
      f64_from(500), f64_from(1500), f64_from(2500),
      f64_from(80), f64_from(100), f64_from(130),
      PR_BR_0_05, PR_JI_0_015, PR_SH_0_03, f64_neg(f64_from(3)), PR_SEED_FANTASY);
}

# species_params_resonance_seed -- SpeciesParams::resonance_seed(). Returns the
# precomputed f32-parity seed stored at construction (NOT recomputed from the
# widened f64 fields, which would hash the wrong bit pattern).
#must_use
fn species_params_resonance_seed(params) {
    return SpeciesParams_resonance_seed(params);
}

# species_supports_vocalization -- Species::supports_vocalization(). Bioacoustic
# gate: some (species, vocalization) pairs are invalid (a snake cannot howl, a
# cricket cannot roar). Dispatches on the species' apparatus. Returns 1/0.
#must_use
fn species_supports_vocalization(species, voc) {
    var apparatus = SpeciesParams_apparatus(species_params(species));
    if (apparatus == PRANI_APP_NOISE_ONLY) {
        if (voc == PRANI_VOC_HISS) { return 1; }
        if (voc == PRANI_VOC_GROWL) { return 1; }
        return 0;
    }
    if (apparatus == PRANI_APP_STRIDULATORY) {
        if (voc == PRANI_VOC_STRIDULATE) { return 1; }
        if (voc == PRANI_VOC_BUZZ) { return 1; }
        if (voc == PRANI_VOC_CHIRP) { return 1; }
        return 0;
    }
    if (apparatus == PRANI_APP_VIBRATILE) {
        if (voc == PRANI_VOC_BUZZ) { return 1; }
        if (voc == PRANI_VOC_CHIRP) { return 1; }
        return 0;
    }
    # Laryngeal / Syringeal: most things EXCEPT stridulate/buzz.
    if (voc == PRANI_VOC_STRIDULATE) { return 0; }
    if (voc == PRANI_VOC_BUZZ) { return 0; }
    return 1;
}

# species_bout_template -- Species::bout_template(). A characteristic calling
# pattern per species: (vocalization, count, call_duration, interval, intent),
# verbatim from the oracle match arms, built via sequence_call_bout_new.
#must_use
fn species_bout_template(species) {
    if (species == PRANI_SP_WOLF) {
        return sequence_call_bout_new(PRANI_VOC_HOWL, 3, f64_from(3), f64_from(2), PRANI_INTENT_SOCIAL);
    }
    if (species == PRANI_SP_DOG) {
        return sequence_call_bout_new(PRANI_VOC_BARK, 5, PR_DUR_0_15, PR_DUR_0_25, PRANI_INTENT_ALARM);
    }
    if (species == PRANI_SP_CAT) {
        return sequence_call_bout_new(PRANI_VOC_HOWL, 2, PR_DUR_0_6, f64_from(1), PRANI_INTENT_SOCIAL);
    }
    if (species == PRANI_SP_LION) {
        return sequence_call_bout_new(PRANI_VOC_ROAR, 4, f64_from(2), PR_DUR_1_5, PRANI_INTENT_TERRITORIAL);
    }
    if (species == PRANI_SP_SONGBIRD) {
        return sequence_call_bout_new(PRANI_VOC_TRILL, 6, PR_DUR_0_3, PR_DUR_0_15, PRANI_INTENT_MATING);
    }
    if (species == PRANI_SP_CROW) {
        return sequence_call_bout_new(PRANI_VOC_SCREECH, 4, PR_DUR_0_2, PR_DUR_0_3, PRANI_INTENT_ALARM);
    }
    if (species == PRANI_SP_RAPTOR) {
        return sequence_call_bout_new(PRANI_VOC_SCREECH, 2, PR_DUR_0_8, PR_DUR_1_5, PRANI_INTENT_TERRITORIAL);
    }
    if (species == PRANI_SP_SNAKE) {
        return sequence_call_bout_new(PRANI_VOC_HISS, 1, PR_DUR_1_5, f64_from(0), PRANI_INTENT_THREAT);
    }
    if (species == PRANI_SP_CROCODILIAN) {
        return sequence_call_bout_new(PRANI_VOC_RUMBLE, 3, PR_TS_2_5, f64_from(2), PRANI_INTENT_TERRITORIAL);
    }
    if (species == PRANI_SP_CRICKET) {
        return sequence_call_bout_new(PRANI_VOC_STRIDULATE, 8, PR_DUR_0_5, PR_DUR_0_3, PRANI_INTENT_MATING);
    }
    if (species == PRANI_SP_BEE) {
        return sequence_call_bout_new(PRANI_VOC_BUZZ, 1, f64_from(2), f64_from(0), PRANI_INTENT_IDLE);
    }
    if (species == PRANI_SP_DRAGON) {
        return sequence_call_bout_new(PRANI_VOC_ROAR, 2, f64_from(3), f64_from(2), PRANI_INTENT_THREAT);
    }
    # PRANI_SP_FANTASY (default / fallthrough).
    return sequence_call_bout_new(PRANI_VOC_GROWL, 3, f64_from(1), f64_from(1), PRANI_INTENT_IDLE);
}

# ================================================================
# Range validation (roadmap 2.0.5). See the PR_SP_*_MAX block at file top for
# where each bound comes from.
# ================================================================

# species_range_positive(x, hi) -- 1 iff x is finite, strictly > 0, and <= hi.
# tract_scale, the three formants and the three bandwidths are all geometry of a
# physical tube: 0 and negative are not small values, they are no tube at all
# (and a zero bandwidth is an infinite-Q pole, i.e. an unstable resonator).
#must_use
fn species_range_positive(x, hi) {
    if (prani_is_positive(x) == 0) { return 0; }
    return f64_le(x, hi);
}

# species_params_in_range(p) -- 1 iff every field of `p` is inside its documented
# range, 0 otherwise. Split from species_params_validate so the predicate and the
# error code stay separate (there is no generic "bad parameter" code; the caller
# picks by category). A p of 0 or a negative PRANI_ERR_* passed in by mistake is
# rejected rather than dereferenced, so
#   species_params_validate(species_params_from_node(node))
# is safe even when from_node itself failed.
#must_use
fn species_params_in_range(p) {
    if (p <= 0) { return 0; }
    var app = SpeciesParams_apparatus(p);
    if (app < PRANI_APP_LARYNGEAL) { return 0; }
    if (app > PRANI_APP_NOISE_ONLY) { return 0; }

    # f0: non-negative Hz (snake is legitimately 0/0/0), ordered min <= default
    # <= max. The ordering matters on its own: f64_clamp with lo > hi returns lo
    # (measured), so an inverted pair silently pins every request to f0_min --
    # where the oracle's f32::clamp panics on min > max instead.
    var f0_min = SpeciesParams_f0_min(p);
    var f0_max = SpeciesParams_f0_max(p);
    var f0_def = SpeciesParams_f0_default(p);
    if (prani_in_range(f0_min, 0, PR_SP_F0_MAX) == 0) { return 0; }
    if (prani_in_range(f0_max, 0, PR_SP_F0_MAX) == 0) { return 0; }
    if (prani_in_range(f0_def, 0, PR_SP_F0_MAX) == 0) { return 0; }
    if (f64_le(f0_min, f0_def) == 0) { return 0; }
    if (f64_le(f0_def, f0_max) == 0) { return 0; }

    if (species_range_positive(SpeciesParams_tract_scale(p), PR_SP_TRACT_MAX) == 0) { return 0; }

    if (species_range_positive(SpeciesParams_formant0(p), PR_SP_FORMANT_MAX) == 0) { return 0; }
    if (species_range_positive(SpeciesParams_formant1(p), PR_SP_FORMANT_MAX) == 0) { return 0; }
    if (species_range_positive(SpeciesParams_formant2(p), PR_SP_FORMANT_MAX) == 0) { return 0; }
    if (species_range_positive(SpeciesParams_bandwidth0(p), PR_SP_BW_MAX) == 0) { return 0; }
    if (species_range_positive(SpeciesParams_bandwidth1(p), PR_SP_BW_MAX) == 0) { return 0; }
    if (species_range_positive(SpeciesParams_bandwidth2(p), PR_SP_BW_MAX) == 0) { return 0; }

    if (prani_in_range(SpeciesParams_breathiness(p), 0, PR_SP_BREATH_MAX) == 0) { return 0; }
    if (prani_in_range(SpeciesParams_jitter(p), 0, PR_SP_JITTER_MAX) == 0) { return 0; }
    if (prani_in_range(SpeciesParams_shimmer(p), 0, PR_SP_SHIMMER_MAX) == 0) { return 0; }

    # spectral_tilt: FINITE ONLY, deliberately unbounded in magnitude. Its sole
    # consumer is crtract_apply_spectral_tilt, which computes
    # f64_clamp(-tilt/12, 0, 0.85) -- already saturating for every finite input,
    # so a huge tilt is harmless and only NaN reaches the coefficient (F11).
    if (prani_is_finite(SpeciesParams_spectral_tilt(p)) == 0) { return 0; }

    # resonance_seed is NOT range-checked: it is a PCG seed, and every one of the
    # 2^64 bit patterns is a legal seed (the table itself carries negative ones).
    return 1;
}

# species_params_validate(p) -- PRANI_ERR_NONE if every field of `p` is in range,
# PRANI_ERR_INVALID_SPECIES otherwise. The category code is the oracle's
# `PraniError::InvalidSpecies` ("species configuration invalid"), which is what a
# SpeciesParams carrying nonsense is.
#must_use
fn species_params_validate(p) {
    if (species_params_in_range(p) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    return PRANI_ERR_NONE;
}

# species_params_from_node -- rebuild a SpeciesParams from a parsed bayan JSON
# object node (all 16 fields are i64: enum consts / f64 bit patterns). Shared by
# the nested-serde reconstruction in voice.cyr (CreatureVoice) and tract.cyr
# (CreatureTract), which embed a SpeciesParams as a sub-object. (SpeciesParams_
# from_json_str parses a top-level string; this reads an already-parsed node.)
#
# RETURN CONTRACT (roadmap 2.0.5): the SpeciesParams pointer, or a NEGATIVE
# PRANI_ERR_INVALID_SPECIES when any field is out of range. This extends
# ADR-0002 ("report the failure, never fabricate") from "the document did not
# parse" to "the document parsed and carries nonsense": bayan's accessors are
# null-safe, so an absent `params` key or an absent field reads back as 0, and an
# all-zero SpeciesParams has tract_scale 0.0 -- no vocal tract at all.
#
# CALLERS MUST CHECK prani_is_err BEFORE USING THE RESULT AS A POINTER. The two
# call sites are crvoice_from_json_str (voice.cyr) and crtract_from_json_str
# (tract.cyr); the latter feeds it straight to crtract_new, which dereferences
# it. species_params_validate rejects a negative p rather than dereferencing it,
# so validating the result again is also safe.
#must_use
fn species_params_from_node(node) {
    var p = alloc(sizeof(SpeciesParams));
    SpeciesParams_set_apparatus(p, bayan_json_v_int(bayan_json_v_obj_get(node, "apparatus")));
    SpeciesParams_set_f0_min(p, bayan_json_v_int(bayan_json_v_obj_get(node, "f0_min")));
    SpeciesParams_set_f0_max(p, bayan_json_v_int(bayan_json_v_obj_get(node, "f0_max")));
    SpeciesParams_set_f0_default(p, bayan_json_v_int(bayan_json_v_obj_get(node, "f0_default")));
    SpeciesParams_set_tract_scale(p, bayan_json_v_int(bayan_json_v_obj_get(node, "tract_scale")));
    SpeciesParams_set_formant0(p, bayan_json_v_int(bayan_json_v_obj_get(node, "formant0")));
    SpeciesParams_set_formant1(p, bayan_json_v_int(bayan_json_v_obj_get(node, "formant1")));
    SpeciesParams_set_formant2(p, bayan_json_v_int(bayan_json_v_obj_get(node, "formant2")));
    SpeciesParams_set_bandwidth0(p, bayan_json_v_int(bayan_json_v_obj_get(node, "bandwidth0")));
    SpeciesParams_set_bandwidth1(p, bayan_json_v_int(bayan_json_v_obj_get(node, "bandwidth1")));
    SpeciesParams_set_bandwidth2(p, bayan_json_v_int(bayan_json_v_obj_get(node, "bandwidth2")));
    SpeciesParams_set_breathiness(p, bayan_json_v_int(bayan_json_v_obj_get(node, "breathiness")));
    SpeciesParams_set_jitter(p, bayan_json_v_int(bayan_json_v_obj_get(node, "jitter")));
    SpeciesParams_set_shimmer(p, bayan_json_v_int(bayan_json_v_obj_get(node, "shimmer")));
    SpeciesParams_set_spectral_tilt(p, bayan_json_v_int(bayan_json_v_obj_get(node, "spectral_tilt")));
    SpeciesParams_set_resonance_seed(p, bayan_json_v_int(bayan_json_v_obj_get(node, "resonance_seed")));
    if (species_params_in_range(p) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    return p;
}

# --- bridge.cyr ---

# bridge.cyr -- science-crate bridge: pure value conversions.
# Ports 2.0.3:rust-old/src/bridge.rs. 13 stateless functions that convert
# bioacoustic measurements + behavioral state into prani synthesis parameters.
# Consumers (kiran, joshua) call these with primitive values, independent of
# which science crates are in their dependency graph.
#
# Requires (in the build/test unit): vocalization.cyr (PRANI_INTENT_*) and
# species.cyr (PRANI_SP_*) for the enum-returning mappers. The module file has no
# `include` lines -- the entry orders the deps.
#
# FLOATS: prani's Rust was f32; this port is f64 (svara/naad/hisab are f64-only).
# Integer literals via f64_from(n); non-integer literals via the module-top
# IEEE-754 hex constants below (decimals in comments). cbrt has no builtin, so
# size_from_body_mass uses f64_pow(x, 1/3) (input is guaranteed positive there).
#
# The one tuple return in the oracle -- perturbation_from_urgency -> (f32, f32) --
# becomes the PrPerturbation #derive(accessors) struct returned by pointer.

# ================================================================
# Non-integer parameter constants (IEEE-754 hex; decimals in comments).
# ================================================================
var PR_B_0_1     = 0x3fb999999999999a;   # 0.1   (min size scale)
var PR_B_30_0    = 0x403e000000000000;   # 30.0  (reference mass, kg)
var PR_B_1_3RD   = 0x3fd5555555555555;   # 0.333333333333... (1/3, cbrt exponent)
var PR_B_0_03    = 0x3f9eb851eb851eb8;   # 0.03  (%/degC f0 sensitivity)
var PR_B_100_0   = 0x4059000000000000;   # 100.0 (Hz-range scale factor)
var PR_B_0_3     = 0x3fd3333333333333;   # 0.3   (arousal->breathiness slope)
var PR_B_0_6     = 0x3fe3333333333333;   # 0.6   (threat->alarm cut)
var PR_B_0_4     = 0x3fd999999999999a;   # 0.4   (threat->threat cut)
var PR_B_0_0     = 0x0000000000000000;   # 0.0
var PR_B_1_0     = 0x3ff0000000000000;   # 1.0
var PR_B_10_0    = 0x4024000000000000;   # 10.0  (amplitude clamp ceiling / pow base)
var PR_B_94_0    = 0x4057800000000000;   # 94.0  (reference SPL, dB)
var PR_B_20_0    = 0x4034000000000000;   # 20.0  (dB->amp divisor; reference temp degC)
var PR_B_0_8     = 0x3fe999999999999a;   # 0.8   (humidity-factor base)
var PR_B_0_2     = 0x3fc999999999999a;   # 0.2   (humidity-factor span)
var PR_B_40_0    = 0x4044000000000000;   # 40.0  (humidity knee %; Lombard baseline dB)
var PR_B_0_005   = 0x3f747ae147ae147b;   # 0.005 (temp-factor slope; Lombard slope)
var PR_B_0_5     = 0x3fe0000000000000;   # 0.5   (absorption low clamp; Lombard cap)
var PR_B_2_0     = 0x4000000000000000;   # 2.0   (absorption high clamp)
var PR_B_0_15    = 0x3fc3333333333333;   # 0.15  (valence->pitch slope)
var PR_B_0_7     = 0x3fe6666666666666;   # 0.7   (pitch-scale low clamp)
var PR_B_1_3     = 0x3ff4cccccccccccd;   # 1.3   (pitch-scale high clamp)
var PR_B_3_0     = 0x4008000000000000;   # 3.0   (smoothstep coefficient)
var PR_B_1_5     = 0x3ff8000000000000;   # 1.5   (jitter urgency slope)
var PR_B_3000_0  = 0x40a7700000000000;   # 3000.0  (cricket f0 threshold)
var PR_B_1000_0  = 0x408f400000000000;   # 1000.0  (songbird f0 threshold)
var PR_B_500_0   = 0x407f400000000000;   # 500.0   (crow f0 threshold)
var PR_B_200_0   = 0x4069000000000000;   # 200.0   (cat f0 threshold)

# ---------------------------------------------------------------------------
# Body-mass / allometry -> voice parameters
# ---------------------------------------------------------------------------

# bridge_size_from_body_mass -- size_from_body_mass. Allometric: vocal-tract
# length scales with body_mass^(1/3), reference 30 kg (wolf-sized). Non-positive
# mass -> min size scale 0.1. No f64_cbrt builtin; the >0 branch guarantees a
# positive base so f64_pow(mass/30, 1/3) matches .cbrt() exactly there.
#must_use
fn bridge_size_from_body_mass(mass_kg) {
    if (f64_le(mass_kg, PR_B_0_0) == 1) {
        return PR_B_0_1;
    }
    return f64_pow(f64_div(mass_kg, PR_B_30_0), PR_B_1_3RD);
}

# bridge_f0_offset_from_temperature -- f0_offset_from_temperature. ~3% f0 change
# per degC (ectotherm Q10 ~1.3), scaled to a Hz-range offset. delta = temp -
# baseline; offset = delta * 0.03 * 100.0.
#must_use
fn bridge_f0_offset_from_temperature(temp_c, baseline_c) {
    var delta = f64_sub(temp_c, baseline_c);
    return f64_mul(f64_mul(delta, PR_B_0_03), PR_B_100_0);
}

# ---------------------------------------------------------------------------
# Behavioral state -> call intent
# ---------------------------------------------------------------------------

# bridge_intent_from_threat_level -- intent_from_threat_level. Maps threat
# (0.0-1.0) to the closest CallIntent via descending thresholds.
#must_use
fn bridge_intent_from_threat_level(threat) {
    if (f64_ge(threat, PR_B_0_8) == 1) { return PRANI_INTENT_DISTRESS; }
    if (f64_ge(threat, PR_B_0_6) == 1) { return PRANI_INTENT_ALARM; }
    if (f64_ge(threat, PR_B_0_4) == 1) { return PRANI_INTENT_THREAT; }
    if (f64_ge(threat, PR_B_0_2) == 1) { return PRANI_INTENT_TERRITORIAL; }
    return PRANI_INTENT_IDLE;
}

# bridge_breathiness_from_arousal -- breathiness_from_arousal. Higher arousal ->
# more breathiness (panting / stressed phonation). clamp(arousal * 0.3, 0, 1).
#must_use
fn bridge_breathiness_from_arousal(arousal) {
    return f64_clamp(f64_mul(arousal, PR_B_0_3), PR_B_0_0, PR_B_1_0);
}

# ---------------------------------------------------------------------------
# Acoustic environment -> spatial parameters
# ---------------------------------------------------------------------------

# bridge_amplitude_from_spl -- amplitude_from_spl. 94 dB SPL ~ 1.0 amplitude
# (1 Pa RMS). amp = 10^((spl - 94)/20), clamped to [0, 10].
#must_use
fn bridge_amplitude_from_spl(spl_db) {
    var diff = f64_sub(spl_db, PR_B_94_0);
    var amp = f64_pow(PR_B_10_0, f64_div(diff, PR_B_20_0));
    return f64_clamp(amp, PR_B_0_0, PR_B_10_0);
}

# bridge_absorption_factor -- absorption_factor. Simplified ISO 9613-1: HF
# absorption decreases with humidity up to ~40% and rises with temperature.
# humidity_factor = humidity < 40 ? 0.8 + (humidity/40)*0.2 : 1.0;
# temp_factor = 1 + (temp - 20)*0.005; clamp(product, 0.5, 2.0).
#must_use
fn bridge_absorption_factor(humidity_pct, temp_c) {
    var humidity_factor = PR_B_1_0;
    if (f64_lt(humidity_pct, PR_B_40_0) == 1) {
        humidity_factor = f64_add(PR_B_0_8,
          f64_mul(f64_div(humidity_pct, PR_B_40_0), PR_B_0_2));
    }
    var temp_factor = f64_add(PR_B_1_0,
      f64_mul(f64_sub(temp_c, PR_B_20_0), PR_B_0_005));
    return f64_clamp(f64_mul(humidity_factor, temp_factor), PR_B_0_5, PR_B_2_0);
}

# ---------------------------------------------------------------------------
# Wind / aerodynamics -> Doppler
# ---------------------------------------------------------------------------

# bridge_doppler_velocity_from_wind -- doppler_velocity_from_wind. Projects wind
# onto the source-listener axis: wind_speed * cos(angle). angle 0 = toward
# listener, pi = away.
#must_use
fn bridge_doppler_velocity_from_wind(wind_speed_ms, angle_rad) {
    return f64_mul(wind_speed_ms, f64_cos(angle_rad));
}

# ---------------------------------------------------------------------------
# RTPC-style continuous parameters (what game AI systems drive)
# ---------------------------------------------------------------------------

# bridge_pitch_scale_from_valence -- pitch_scale_from_valence. +-15% pitch shift
# across the full valence range [-1, +1]. clamp(1 + valence*0.15, 0.7, 1.3).
#must_use
fn bridge_pitch_scale_from_valence(valence) {
    return f64_clamp(f64_add(PR_B_1_0, f64_mul(valence, PR_B_0_15)), PR_B_0_7, PR_B_1_3);
}

# bridge_vocal_effort_from_arousal -- vocal_effort_from_arousal. Smoothstep of
# clamped arousal: 3a^2 - 2a^3 (slow start, fast middle, plateau near 1.0).
#must_use
fn bridge_vocal_effort_from_arousal(arousal) {
    var a = f64_clamp(arousal, PR_B_0_0, PR_B_1_0);
    var aa = f64_mul(a, a);
    var aaa = f64_mul(aa, a);
    return f64_sub(f64_mul(PR_B_3_0, aa), f64_mul(PR_B_2_0, aaa));
}

# ================================================================
# PrPerturbation -- (jitter_scale, shimmer_scale) tuple returned by
# perturbation_from_urgency. Rust returned a bare (f32, f32); the port wraps it
# in this 2-field struct returned by pointer.
# ================================================================
#derive(accessors)
struct PrPerturbation { jitter_scale; shimmer_scale; }

# bridge_perturbation_from_urgency -- perturbation_from_urgency. Maps urgency
# (0.0-1.0) to jitter (1.0-2.5x) and shimmer (1.0-2.0x) scale factors: more
# perturbation = more vocal instability under stress.
#   jitter_scale  = 1 + u*1.5
#   shimmer_scale = 1 + u*1.0
#must_use
fn bridge_perturbation_from_urgency(urgency) {
    var u = f64_clamp(urgency, PR_B_0_0, PR_B_1_0);
    var p = alloc(sizeof(PrPerturbation));
    PrPerturbation_set_jitter_scale(p, f64_add(PR_B_1_0, f64_mul(u, PR_B_1_5)));
    PrPerturbation_set_shimmer_scale(p, f64_add(PR_B_1_0, f64_mul(u, PR_B_1_0)));
    return p;
}

# bridge_lombard_effort_boost -- lombard_effort_boost. Lombard effect: involuntary
# vocal increase in noise. Baseline 40 dB SPL; below/at it -> 0. Above:
# clamp((spl - 40) * 0.005, 0, 0.5) additive effort boost.
#must_use
fn bridge_lombard_effort_boost(ambient_spl_db) {
    if (f64_le(ambient_spl_db, PR_B_40_0) == 1) {
        return PR_B_0_0;
    }
    var excess = f64_sub(ambient_spl_db, PR_B_40_0);
    return f64_clamp(f64_mul(excess, PR_B_0_005), PR_B_0_0, PR_B_0_5);
}

# bridge_species_from_f0 -- species_from_f0. Suggests the closest prani species
# from a fundamental-frequency measurement via descending thresholds. f0 = 0 ->
# Snake (noise-only).
#must_use
fn bridge_species_from_f0(f0_hz) {
    if (f64_ge(f0_hz, PR_B_3000_0) == 1) { return PRANI_SP_CRICKET; }
    if (f64_ge(f0_hz, PR_B_1000_0) == 1) { return PRANI_SP_SONGBIRD; }
    if (f64_ge(f0_hz, PR_B_500_0) == 1)  { return PRANI_SP_CROW; }
    if (f64_ge(f0_hz, PR_B_200_0) == 1)  { return PRANI_SP_CAT; }
    if (f64_ge(f0_hz, PR_B_100_0) == 1)  { return PRANI_SP_WOLF; }
    if (f64_ge(f0_hz, PR_B_40_0) == 1)   { return PRANI_SP_LION; }
    if (f64_gt(f0_hz, PR_B_0_0) == 1)    { return PRANI_SP_CROCODILIAN; }
    return PRANI_SP_SNAKE;
}

# --- tract.cyr ---

# tract.cyr -- creature-specific vocal tract models.
# Ports 2.0.3:rust-old/src/tract.rs. Wraps svara's VocalTract / GlottalSource /
# FormantFilter (+ naad BiquadFilter under naad-backend, the shipped default)
# with species-specific formant targets and vocal-apparatus-driven excitation.
#
# Synthesis strategy depends on the vocal apparatus:
#   Laryngeal / Syringeal : glottal source through the formant-shaping tract
#   NoiseOnly             : filtered broadband noise (naad bandpass) -- snakes
#   Stridulatory          : discrete/continuous AM tone -- insects
#   Vibratile             : continuous wing-beat modulation -- bees/flies
#
# Requires (from the build/test unit, in dependency order): stdlib alloc/vec/
# math, hisab, goonj, naad (filter_biquad_new/process_sample, NAAD_FILTER_BANDPASS),
# svara (svara_tract_*/svara_glottal_*/svara_vowel_target_with_bandwidths,
# svara_is_err), error.cyr, rng.cyr, dsp.cyr, species.cyr. Module files carry
# no `include` lines -- the entry orders them.
#
# FLOATS: prani's Rust was f32; this port is f64 (svara/naad/hisab are f64-only,
# widening is forced). Integer literals via f64_from(n); non-integers via the
# module-top IEEE-754 hex constants below (decimals in comments).
#
# PARITY NOTE (naad-backend default): NoiseOnly always pre-builds a naad bandpass
# filter (default features), so synthesize_noise takes the naad path and the
# svara FormantFilter fallback is dropped (documented deviation). Exact svara-
# internal bit parity vs the f32 oracle is not attainable (f32->f64 diverges
# through svara's own DSP); tests assert structural parity + finiteness +
# determinism instead. See tests/tract.tcyr parity_notes.
#
# INPUT RANGES: every fallible entry point here range-checks its numeric input
# (roadmap 2.0.5, audit F11). The table, the measurements behind it, and what is
# deliberately left unguarded are in the INPUT RANGES block below the constants.

# ================================================================
# Non-integer literal constants (IEEE-754 hex; decimals in comments).
# ================================================================
var PR_TR_1_3   = 0x3ff4cccccccccccd;   # 1.3   F4 estimate multiplier
var PR_TR_1_5   = 0x3ff8000000000000;   # 1.5   F5 estimate multiplier
var PR_TR_1_2   = 0x3ff3333333333333;   # 1.2   B4 estimate multiplier
var PR_TR_1_4   = 0x3ff6666666666666;   # 1.4   B5 estimate multiplier
var PR_TR_0_05  = 0x3fa999999999999a;   # 0.05  jitter clamp ceiling
var PR_TR_0_1   = 0x3fb999999999999a;   # 0.1   shimmer clamp ceiling / tilt abs threshold
var PR_TR_0_5   = 0x3fe0000000000000;   # 0.5   sub_f0 mult / tone mix / mod_rate / env thresholds
var PR_TR_1_498 = 0x3ff7f7ced916872b;   # 1.498 syringeal second-source ratio (~perfect fifth)
var PR_TR_0_6   = 0x3fe3333333333333;   # 0.6   tone2 amplitude
var PR_TR_0_25  = 0x3fd0000000000000;   # 0.25  stridulatory/vibratile signal scale
var PR_TR_0_3   = 0x3fd3333333333333;   # 0.3   second-harmonic amplitude
var PR_TR_2_5   = 0x4004000000000000;   # 2.5   cricket chirp rate (Hz)
var PR_TR_30_0  = 0x403e000000000000;   # 30.0  cricket syllable rate (Hz)
var PR_TR_0_4   = 0x3fd999999999999a;   # 0.4   purr open-phase duty
var PR_TR_0_02  = 0x3f947ae147ae147b;   # 0.02  purr closed-phase noise scale
var PR_TR_0_85  = 0x3feb333333333333;   # 0.85  spectral-tilt coefficient clamp ceiling
var PR_TR_0_01  = 0x3f847ae147ae147b;   # 0.01  spectral-tilt coefficient floor
var PR_TR_12_0  = 0x4028000000000000;   # 12.0  dB/octave -> coefficient divisor

# ================================================================
# INPUT RANGES (2.0.5, audit F11). Every fallible entry point in this module
# rejects input outside the range below with a negative PRANI_ERR_* instead of
# synthesizing from it. The helpers live in error.cyr; the error code is chosen
# by CATEGORY, from the oracle's own five variants -- there is no generic "bad
# parameter" code.
#
#   parameter                                  range      code
#   -------------------------------------------------------------------------
#   f0        (laryngeal/syringeal/            finite     PRANI_ERR_INVALID_TRACT
#              stridulatory/vibratile)
#   purr_f0   (synthesize_purr)                finite     PRANI_ERR_INVALID_TRACT
#   tilt_db   (apply_spectral_tilt)            finite     PRANI_ERR_INVALID_TRACT
#   num_samples (every synthesis path)         >= 0       PRANI_ERR_INVALID_VOCALIZATION
#   subharmonic_amp / perturbation_scale       finite     PRANI_ERR_INVALID_VOCALIZATION
#   from_json_str "phase"                      [0, 1]     PRANI_ERR_INVALID_TRACT
#   from_json_str "dcb_x_prev" / "dcb_y_prev"  finite     PRANI_ERR_INVALID_TRACT
#   from_json_str "dcb_r"                      [0, 1)     PRANI_ERR_INVALID_TRACT
#
# Why FINITE and not a magnitude band for f0 / purr_f0 / tilt_db: every finite
# value is already bounded where it is used. f0 is clamped into the species band
# on the glottal paths and drives a sine elsewhere; tilt_db's coefficient is
# clamped to [0, 0.85]; purr_f0 only sets a phase increment. A band would be a
# number invented here, and ADR-0001 rejected inventing one (it declined to
# restate svara's sample-rate threshold for the same reason). What a finite
# value cannot do is any of the following, all MEASURED 2026-08-31 on the
# pre-guard tree and pinned as assertions in tests/tract.tcyr:
#
#   crtract_synthesize(bee,      +inf, 32) -> SUCCESS, buffer all NaN  (sin(inf))
#   crtract_synthesize(bee,       NaN, 32) -> SUCCESS, buffer all NaN
#   crtract_synthesize(cricket,  +inf, 32) -> SUCCESS, buffer all NaN
#   crtract_synthesize(songbird,  NaN, 32) -> SUCCESS, buffer all NaN  (clamp
#                                             passes NaN; NaN <= 2000 is false,
#                                             so the dual-source arm runs raw)
#   crtract_synthesize(wolf, 220, -5)      -> SUCCESS, EMPTY buffer
#   crtract_synthesize_purr(cat, 32, NaN)  -> finite output, tract phase LATCHED
#                                             non-finite for the tract's life
#   crtract_apply_spectral_tilt(buf, NaN)  -> whole buffer NaN
#   options(NaN, _)                        -> silently takes the NO-subharmonic
#                                             arm (f64_gt(NaN, 0) is false)
#
# The last one is the shape this milestone is really about: not a crash, but a
# plausible-looking answer fabricated from a value the caller never meant.
#
# NOT guarded here, deliberately:
#   * crtract_new's sample_rate -- svara owns that rule and reports it (ADR-0001).
#   * crtract_set_formant_blend's blend / target / target_bw -- MEASURED: svara
#     already rejects a NaN blend AND a NaN target formant (both return an error
#     through prani_from_svara, and the tract is left synthesizing finite audio).
#     A guard here would restate a dependency's rule, which is the thing ADR-0001
#     says goes stale silently.
#   * apply_spectral_tilt's sample_rate -- the function never reads it (the
#     coefficient comes from tilt_db alone; the parameter exists for oracle
#     signature parity). Rejecting a value a function does not read reports a
#     failure that cannot happen.
#   * options on the stridulatory path -- never read there either (the oracle
#     writes `let _ = options`). Same rule.
#   * from_json_str "rng_state" / "rng_inc" -- every 64-bit pattern is a
#     reachable PCG32 state; neither is a number with a range.
# ================================================================

# ================================================================
# SynthesisOptions -- per-block synthesis modifiers passed voice -> tract.
#   subharmonic_amp   : subharmonic amplitude (0.0 = none), injected pre-tract
#   perturbation_scale: jitter/shimmer intensity multiplier (0.0-2.0)
# Default = both 0.0 (see crtract_options_default).
# ================================================================
#derive(accessors)
struct SynthesisOptions { subharmonic_amp; perturbation_scale; }

# options_default -- SynthesisOptions::default() (both fields 0.0).
#must_use
fn crtract_options_default() {
    var o = alloc(sizeof(SynthesisOptions));
    SynthesisOptions_set_subharmonic_amp(o, 0);
    SynthesisOptions_set_perturbation_scale(o, 0);
    return o;
}

# options_new -- explicit constructor for tests / callers.
#must_use
fn crtract_options_new(subharmonic_amp, perturbation_scale) {
    var o = alloc(sizeof(SynthesisOptions));
    SynthesisOptions_set_subharmonic_amp(o, subharmonic_amp);
    SynthesisOptions_set_perturbation_scale(o, perturbation_scale);
    return o;
}

# ================================================================
# CreatureTract -- a creature's vocal tract, configured for one species.
#   tract        : inner svara VocalTract ptr
#   params       : SpeciesParams ptr (species vocal parameters)
#   rng          : PrRng ptr (noise-based synthesis)
#   sample_rate  : sample rate (Hz)
#   phase        : running phase accumulator (sample-accurate across blocks)
#   dc_blocker   : DcBlocker ptr (applied to all synthesis output)
#   noise_filter : naad BiquadFilter ptr for noise shaping, or 0 (== None)
# serde RESTORED via crtract_to_json / crtract_from_json_str (below): the
# reconstructable state roundtrips; the opaque svara tract is rebuilt from params.
# ================================================================
#derive(accessors)
struct CreatureTract {
    tract; params; rng; sample_rate; phase; dc_blocker; noise_filter;
}

# new(params, sample_rate) -- CreatureTract::new. Configures the svara tract
# with species-specific formants (F4/F5 estimated at 1.3x/1.5x F3), pre-builds
# a naad bandpass for NoiseOnly species, seeds the rng from the species'
# resonance seed. Rust only WARNS if set_formants_from_target errors, then
# continues -- so that return is ignored here too.
#
# Returns a CreatureTract ptr on success, or a NEGATIVE PRANI_ERR_* on failure.
#
# The error return is a DIVERGENCE FROM THE ORACLE, and a necessary one
# (ADR-0001). `2.0.3:rust-old/src/tract.rs:CreatureTract::new` returns `Self`,
# because the svara it was written against had an INFALLIBLE `VocalTract::new`.
# svara 3.x hardened that constructor to return a checkable negative code
# instead of panicking (svara's own ADR: "`svara_tract_new` errors where Rust
# panics"), and it rejects every sample_rate <= 1000 Hz as well as negative and
# non-finite ones. The port kept the oracle's shape and used the return AS A
# POINTER regardless -- so `svara_tract_set_formants_from_target(-1, target)`
# dereferenced -1 and the process took SIGSEGV. Checking it is mandatory, and
# the check cannot be hidden inside this function because there is no valid
# tract to return.
#must_use
fn crtract_new(params, sample_rate) {
    var tract = svara_tract_new(sample_rate);
    if (svara_is_err(tract) == 1) {
        prani_log_error("prani: svara vocal tract rejected the sample rate");
        return prani_from_svara(tract);
    }

    var f0 = SpeciesParams_formant0(params);
    var f1 = SpeciesParams_formant1(params);
    var f2 = SpeciesParams_formant2(params);
    var b0 = SpeciesParams_bandwidth0(params);
    var b1 = SpeciesParams_bandwidth1(params);
    var b2 = SpeciesParams_bandwidth2(params);

    # F4/F5 estimated at 1.3x/1.5x F3; B4/B5 at 1.2x/1.4x B3.
    var target = svara_vowel_target_with_bandwidths(
      f0, f1, f2, f64_mul(f2, PR_TR_1_3), f64_mul(f2, PR_TR_1_5),
      b0, b1, b2, f64_mul(b2, PR_TR_1_2), f64_mul(b2, PR_TR_1_4));
    # Rust: `if let Err(e) = ... { warn!(...) }` then continue. Ports the
    # tracing::warn! to sakshi (prani_log_warn), preserving warn-then-continue.
    var _fmt_rc = svara_tract_set_formants_from_target(tract, target);
    if (prani_is_err(_fmt_rc) == 1) {
        prani_log_warn("prani: species formants out of range, using defaults");
    }

    # naad-backend: pre-build a bandpass for NoiseOnly (snakes). Error -> None(0).
    var noise_filter = 0;
    if (SpeciesParams_apparatus(params) == PRANI_APP_NOISE_ONLY) {
        var nf = filter_biquad_new(NAAD_FILTER_BANDPASS, sample_rate, f0, f64_from(2));
        if (prani_is_err(nf) == 0) { noise_filter = nf; }
    }

    var self = alloc(sizeof(CreatureTract));
    CreatureTract_set_tract(self, tract);
    CreatureTract_set_params(self, params);
    CreatureTract_set_rng(self, prani_rng_new(species_params_resonance_seed(params)));
    CreatureTract_set_sample_rate(self, sample_rate);
    CreatureTract_set_phase(self, 0);
    CreatureTract_set_dc_blocker(self, dcblocker_new());
    CreatureTract_set_noise_filter(self, noise_filter);
    return self;
}

# CreatureTract serde -- restores the Rust `#[derive(Serialize, Deserialize)]`.
# The inner svara VocalTract + naad BiquadFilter are opaque (no Cyrius serialize
# surface), so only the RECONSTRUCTABLE state is serialized: sample_rate, phase,
# the rng (state/inc), the dc_blocker (x_prev/y_prev/r), and the SpeciesParams
# (nested). On deserialize, crtract_new(params, sample_rate) rebuilds the svara
# tract + naad filter + a fresh rng/dc_blocker, then the serialized rng/phase/
# dc_blocker state is restored over them. f64 scalars serialize as exact i64 bit
# patterns (lossless).
#
# DEVIATION (documented, not hidden): the Rust derive serialized the svara
# tract's live filter history; the port rebuilds it from params instead (svara
# is f64-opaque here). The species-determined response is bit-identical after
# rebuild; only in-flight filter memory (which decays within a few samples) is
# reset. Same tradeoff garjan makes rebuilding naad from config.
fn crtract_to_json(self, sb) {
    var rng = CreatureTract_rng(self);
    var dc = CreatureTract_dc_blocker(self);
    str_builder_add_cstr(sb, "{\"sample_rate\":");
    str_builder_add_int(sb, CreatureTract_sample_rate(self));
    str_builder_add_cstr(sb, ",\"phase\":");
    str_builder_add_int(sb, CreatureTract_phase(self));
    str_builder_add_cstr(sb, ",\"rng_state\":");
    str_builder_add_int(sb, PrRng_state(rng));
    str_builder_add_cstr(sb, ",\"rng_inc\":");
    str_builder_add_int(sb, PrRng_inc(rng));
    str_builder_add_cstr(sb, ",\"dcb_x_prev\":");
    str_builder_add_int(sb, DcBlocker_x_prev(dc));
    str_builder_add_cstr(sb, ",\"dcb_y_prev\":");
    str_builder_add_int(sb, DcBlocker_y_prev(dc));
    str_builder_add_cstr(sb, ",\"dcb_r\":");
    str_builder_add_int(sb, DcBlocker_r(dc));
    str_builder_add_cstr(sb, ",\"params\":");
    SpeciesParams_to_json(CreatureTract_params(self), sb);
    str_builder_add_cstr(sb, "}");
    return 0;
}

# from_json_str(json) -- rebuild a CreatureTract from crtract_to_json output.
# `json` is a NUL-terminated cstring. The opaque svara tract and naad filter are
# reconstructed from the serialized SpeciesParams (see the DEVIATION note above),
# then the saved rng / phase / dc_blocker state is restored over the rebuild.
# Returns the CreatureTract ptr, or a NEGATIVE PRANI_ERR_INVALID_TRACT if `json`
# is 0, does not parse, carries an out-of-range field, or names a sample rate
# svara rejects.
#
# 2.0.5 (ADR-0002 deferred field ranges to roadmap 2.0.5, docs/development/
# roadmap.md): every scalar below arrives as a RAW f64
# BIT PATTERN named by the document -- `bayan_json_v_int` hands back whatever
# 64-bit integer was written, and the fields are f64s reinterpreted -- so a
# hostile document can spell NaN or inf directly and no amount of parse checking
# will notice. The ranges:
#
#   phase       [0, 1]   the accumulator's own invariant: it is compared against
#                        0.4 and wrapped at 1.0. A NaN phase makes both compares
#                        false forever (permanent closed phase, never wraps);
#                        an out-of-band phase counts down at 1.0 per sample.
#                        KNOWN EDGE, stated rather than hidden: the wrap
#                        subtracts 1.0 at most once per sample, so a purr driven
#                        at purr_f0 > sample_rate (phase_inc > 1) can leave phase
#                        above 1, and such a tract's own json is rejected on
#                        read. purr_f0 is a 25-30 Hz muscle-cycling rate --
#                        voice.cyr clamps it to [20, 35] and stream.cyr passes
#                        the constant 27 -- so no in-tree path reaches it.
#   dcb_x_prev  finite   filter memory. Any finite sample is legal -- these are
#   dcb_y_prev  finite   post-amplitude audio values, so no magnitude band
#                        belongs here -- but a non-finite one poisons every
#                        sample the blocker will ever emit (dsp.cyr reports the
#                        latch; it cannot undo it).
#   dcb_r       [0, 1)   the pole radius, and this one is a STABILITY bound, not
#                        a taste one: y = x - x_prev + r*y_prev diverges for
#                        |r| >= 1. dcblocker_new writes 0.995 and nothing else
#                        ever writes it, so prani's own output always passes.
#
# The checks run BEFORE crtract_new, so a rejected document costs no tract.
# sample_rate is deliberately NOT checked here: svara owns that threshold and
# crtract_new reports its rejection (ADR-0001 -- restating a dependency's
# constant is how it goes stale). rng_state / rng_inc are not checked either:
# every 64-bit pattern is a reachable PCG32 state.
fn crtract_from_json_str(json) {
    if (json == 0) { return PRANI_ERR_INVALID_TRACT; }
    var root = bayan_json_v_parse_buf(json, strlen(json));
    if (root == 0) { return PRANI_ERR_INVALID_TRACT; }

    var phase = bayan_json_v_int(bayan_json_v_obj_get(root, "phase"));
    var dcb_x = bayan_json_v_int(bayan_json_v_obj_get(root, "dcb_x_prev"));
    var dcb_y = bayan_json_v_int(bayan_json_v_obj_get(root, "dcb_y_prev"));
    var dcb_r = bayan_json_v_int(bayan_json_v_obj_get(root, "dcb_r"));
    if (prani_in_range(phase, 0, F64_ONE) == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (prani_finite2(dcb_x, dcb_y) == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (prani_is_non_negative(dcb_r) == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (f64_lt(dcb_r, F64_ONE) == 0) { return PRANI_ERR_INVALID_TRACT; }

    var params = species_params_from_node(bayan_json_v_obj_get(root, "params"));
    # species.cyr ranges the nested params object itself (2.0.5); propagate its
    # code rather than restating it, exactly as the crtract_new check below does.
    if (prani_is_err(params) == 1) { return params; }
    var sample_rate = bayan_json_v_int(bayan_json_v_obj_get(root, "sample_rate"));
    # rebuild the svara tract + naad filter + fresh rng/dc_blocker from params
    var self = crtract_new(params, sample_rate);
    if (prani_is_err(self) == 1) { return self; }
    # then restore the serialized rng / phase / dc_blocker state over the rebuild
    CreatureTract_set_phase(self, phase);
    var rng = CreatureTract_rng(self);
    PrRng_set_state(rng, bayan_json_v_int(bayan_json_v_obj_get(root, "rng_state")));
    PrRng_set_inc(rng, bayan_json_v_int(bayan_json_v_obj_get(root, "rng_inc")));
    var dc = CreatureTract_dc_blocker(self);
    DcBlocker_set_x_prev(dc, dcb_x);
    DcBlocker_set_y_prev(dc, dcb_y);
    DcBlocker_set_r(dc, dcb_r);
    return self;
}

# ---- private synthesis paths ------------------------------------------------

# synthesize_laryngeal -- glottal source through the vocal tract (mammals).
# Returns a vec (heap ptr) on success or a negative PRANI_ERR_* on failure.
#
# 2.0.5 guards: f0 finite, num_samples >= 0, both option fields finite (see the
# INPUT RANGES block). A non-finite f0 was already reported on THIS path -- the
# clamp passes NaN through and svara_glottal_new refuses it (measured: an error,
# not a NaN buffer) -- so the guard changes only which code comes back
# (PRANI_ERR_INVALID_TRACT, prani's own parameter, rather than PRANI_ERR_SVARA)
# and makes the contract the same on all five apparatus paths, four of which had
# no such backstop.
fn crtract_synthesize_laryngeal(self, f0, num_samples, options) {
    if (prani_is_finite(f0) == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (num_samples < 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var sub_amp = SynthesisOptions_subharmonic_amp(options);
    var pert = SynthesisOptions_perturbation_scale(options);
    if (prani_finite2(sub_amp, pert) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }

    var params = CreatureTract_params(self);
    var sr = CreatureTract_sample_rate(self);
    var tract = CreatureTract_tract(self);

    # clamp f0 to [max(f0_min,20), min(f0_max,2000)]
    var lo = f64_max(SpeciesParams_f0_min(params), f64_from(20));
    var hi = f64_min(SpeciesParams_f0_max(params), f64_from(2000));
    var clamped_f0 = f64_clamp(f0, lo, hi);

    var glottal = svara_glottal_new(clamped_f0, sr);
    if (svara_is_err(glottal) == 1) { return prani_from_svara(glottal); }
    svara_glottal_set_breathiness(glottal, SpeciesParams_breathiness(params));
    # non-stationary perturbation: scale jitter/shimmer by block intensity
    var ps = f64_max(pert, 0);
    svara_glottal_set_jitter(glottal, f64_min(f64_mul(SpeciesParams_jitter(params), ps), PR_TR_0_05));
    svara_glottal_set_shimmer(glottal, f64_min(f64_mul(SpeciesParams_shimmer(params), ps), PR_TR_0_1));

    var output = vec_new();
    if (f64_gt(sub_amp, 0) == 1) {
        # inject subharmonics into excitation before tract filtering, so the
        # formant resonances shape the subharmonic energy.
        var sub_f0 = f64_mul(clamped_f0, PR_TR_0_5);
        var phase_inc = f64_div(sub_f0, sr);
        var i = 0;
        while (i < num_samples) {
            var glottal_sample = svara_glottal_next_sample(glottal);
            var sub = f64_mul(f64_sin(f64_mul(F64_TAU, CreatureTract_phase(self))), sub_amp);
            var ph = f64_add(CreatureTract_phase(self), phase_inc);
            if (f64_ge(ph, F64_ONE) == 1) { ph = f64_sub(ph, F64_ONE); }
            CreatureTract_set_phase(self, ph);
            vec_push(output, svara_tract_process_sample(tract, f64_add(glottal_sample, sub)));
            i = i + 1;
        }
    } else {
        # no-subharmonic path: inline svara_tract_synthesize's loop, pushing
        # into the vec directly (avoids the raw-buffer/vec mismatch before DC).
        var i = 0;
        while (i < num_samples) {
            vec_push(output, svara_tract_process_sample(tract, svara_glottal_next_sample(glottal)));
            i = i + 1;
        }
    }
    dcblocker_process_buffer(CreatureTract_dc_blocker(self), output);
    return output;
}

# synthesize_syringeal -- dual-source capable, high-frequency range (birds).
#
# 2.0.5 guards: f0 finite, num_samples >= 0, both option fields finite. The
# option fields are checked at the function's contract level even though the
# dual-source (f0 > 2000) arm discards them, as the oracle does: which arm runs
# depends on the clamped f0, so "the function reads them" is the honest bar.
# A NaN f0 is the sharpest case on this path -- it survives the clamp, and
# `NaN <= 2000` is false, so it fell through to the raw-oscillator arm and
# returned an all-NaN buffer as SUCCESS (measured).
fn crtract_synthesize_syringeal(self, f0, num_samples, options) {
    if (prani_is_finite(f0) == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (num_samples < 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var sub_amp = SynthesisOptions_subharmonic_amp(options);
    var pert = SynthesisOptions_perturbation_scale(options);
    if (prani_finite2(sub_amp, pert) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }

    var params = CreatureTract_params(self);
    var sr = CreatureTract_sample_rate(self);
    var tract = CreatureTract_tract(self);

    # clamp f0 to [max(f0_min,20), f0_max]
    var lo = f64_max(SpeciesParams_f0_min(params), f64_from(20));
    var clamped_f0 = f64_clamp(f0, lo, SpeciesParams_f0_max(params));

    var output = vec_new();
    if (f64_le(clamped_f0, f64_from(2000)) == 1) {
        var glottal = svara_glottal_new(clamped_f0, sr);
        if (svara_is_err(glottal) == 1) { return prani_from_svara(glottal); }
        svara_glottal_set_breathiness(glottal, SpeciesParams_breathiness(params));
        var ps = f64_max(pert, 0);
        svara_glottal_set_jitter(glottal, f64_min(f64_mul(SpeciesParams_jitter(params), ps), PR_TR_0_05));
        svara_glottal_set_shimmer(glottal, f64_min(f64_mul(SpeciesParams_shimmer(params), ps), PR_TR_0_1));
        var i = 0;
        while (i < num_samples) {
            vec_push(output, svara_tract_process_sample(tract, svara_glottal_next_sample(glottal)));
            i = i + 1;
        }
    } else {
        # high-frequency syringeal with dual-source capability: the syrinx has
        # two independent sound sources (left/right bronchus) at different pitches.
        var f0_2 = f64_mul(clamped_f0, PR_TR_1_498);   # ~perfect fifth above
        var breathiness = SpeciesParams_breathiness(params);
        var rng = CreatureTract_rng(self);
        var i = 0;
        while (i < num_samples) {
            var t = f64_div(f64_from(i), sr);
            var tone1 = f64_sin(f64_mul(f64_mul(F64_TAU, clamped_f0), t));
            var tone2 = f64_mul(f64_sin(f64_mul(f64_mul(F64_TAU, f0_2), t)), PR_TR_0_6);
            var noise = f64_mul(prani_rng_next_f32(rng), breathiness);
            # excitation = (tone1+tone2)*0.5*(1-breathiness) + noise
            var excitation = f64_add(
              f64_mul(f64_mul(f64_add(tone1, tone2), PR_TR_0_5), f64_sub(F64_ONE, breathiness)),
              noise);
            vec_push(output, svara_tract_process_sample(tract, excitation));
            i = i + 1;
        }
    }
    dcblocker_process_buffer(CreatureTract_dc_blocker(self), output);
    return output;
}

# synthesize_noise -- filtered broadband noise (snakes). naad-backend path:
# the pre-built bandpass shapes white noise. The svara FormantFilter fallback
# is dropped (naad-backend default).
#
# The filter is NOT unconditionally present, despite what this comment used to
# claim: crtract_new builds it only for PRANI_APP_NOISE_ONLY and only keeps it
# `if (prani_is_err(nf) == 0)`, leaving the field 0 when filter_biquad_new
# rejects the species f0 for the sample rate. Passing that 0 to
# filter_biquad_process_sample is a null dereference, so the invariant the
# comment asserted is checked instead of assumed.
fn crtract_synthesize_noise(self, num_samples) {
    # 2.0.5: num_samples >= 0. No f0 and no options reach this path, so there is
    # nothing else here with a range. The input check comes BEFORE the filter
    # check so a caller learns about its own bad argument first.
    if (num_samples < 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var filter = CreatureTract_noise_filter(self);
    if (filter == 0) {
        prani_log_error("prani: noise-only synthesis has no bandpass filter");
        return PRANI_ERR_SYNTHESIS_FAILED;
    }
    var output = vec_new();
    var rng = CreatureTract_rng(self);
    var i = 0;
    while (i < num_samples) {
        var noise = f64_mul(prani_rng_next_f32(rng), PR_TR_0_5);
        vec_push(output, filter_biquad_process_sample(filter, noise));
        i = i + 1;
    }
    dcblocker_process_buffer(CreatureTract_dc_blocker(self), output);
    return output;
}

# synthesize_stridulatory -- amplitude-modulated tone for insects.
# High-carrier (cricket, f0 > 1000): discrete pulse-train chirps.
# Low-carrier (bee, f0 <= 1000): continuous wing-beat modulation.
fn crtract_synthesize_stridulatory(self, f0, num_samples, options) {
    # 2.0.5: f0 finite, num_samples >= 0. `options` is NOT checked -- this path
    # never reads it (the oracle writes `let _ = options;`), and a function must
    # not reject a value it does not use. f0 here is raw: it multiplies TAU*t
    # inside sin(), and sin(+-inf) is NaN, so a non-finite f0 turned the whole
    # buffer to NaN and returned it as SUCCESS (measured).
    if (prani_is_finite(f0) == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (num_samples < 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var sr = CreatureTract_sample_rate(self);
    var output = vec_new();

    if (f64_gt(f0, f64_from(1000)) == 1) {
        # cricket-style discrete pulse-train chirps.
        var syllable_rate = PR_TR_30_0;   # wing strokes per second within a chirp
        var chirp_rate = PR_TR_2_5;       # chirps per second
        var pulses_per_chirp = 4;         # typical field cricket (u32)
        var chirp_period = f64_div(sr, chirp_rate);
        var syllable_period = f64_div(sr, syllable_rate);
        var chirp_active = f64_mul(syllable_period, f64_from(pulses_per_chirp));

        var i = 0;
        while (i < num_samples) {
            var t = f64_div(f64_from(i), sr);
            # pos_in_chirp = (i as f32) % chirp_period
            var pos_in_chirp = crtract_fmod(f64_from(i), chirp_period);

            var carrier = f64_sin(f64_mul(f64_mul(F64_TAU, f0), t));
            var h2 = f64_mul(f64_sin(f64_mul(f64_mul(f64_mul(F64_TAU, f0), F64_TWO), t)), PR_TR_0_3);
            var signal = f64_mul(f64_add(carrier, h2), PR_TR_0_25);

            if (f64_lt(pos_in_chirp, chirp_active) == 1) {
                # within active chirp: pulse envelope per syllable
                var pos_in_syllable = crtract_fmod(pos_in_chirp, syllable_period);
                var syllable_frac = f64_div(pos_in_syllable, syllable_period);
                # sharp onset, quick decay per pulse (wing-stroke shape)
                var pulse_env = 0;
                if (f64_lt(syllable_frac, PR_TR_0_1) == 1) {
                    pulse_env = f64_div(syllable_frac, PR_TR_0_1);
                } elif (f64_lt(syllable_frac, PR_TR_0_5) == 1) {
                    pulse_env = F64_ONE;
                } else {
                    # 1.0 - (syllable_frac - 0.5) / 0.5
                    pulse_env = f64_sub(F64_ONE, f64_div(f64_sub(syllable_frac, PR_TR_0_5), PR_TR_0_5));
                }
                vec_push(output, f64_mul(signal, pulse_env));
            } else {
                # inter-chirp silence
                vec_push(output, 0);
            }
            i = i + 1;
        }
    } else {
        # bee-style continuous wing-beat modulation
        var mod_rate = f64_mul(f0, PR_TR_0_5);
        var i = 0;
        while (i < num_samples) {
            var t = f64_div(f64_from(i), sr);
            var carrier = f64_sin(f64_mul(f64_mul(F64_TAU, f0), t));
            var h2 = f64_mul(f64_sin(f64_mul(f64_mul(f64_mul(F64_TAU, f0), F64_TWO), t)), PR_TR_0_3);
            # modulator = 0.5 + 0.5*sin(TAU*mod_rate*t)
            var modulator = f64_add(PR_TR_0_5,
              f64_mul(PR_TR_0_5, f64_sin(f64_mul(f64_mul(F64_TAU, mod_rate), t))));
            vec_push(output, f64_mul(f64_mul(f64_add(carrier, h2), modulator), PR_TR_0_25));
            i = i + 1;
        }
    }
    dcblocker_process_buffer(CreatureTract_dc_blocker(self), output);
    return output;
}

# synthesize_vibratile -- continuous wing-beat modulation (bees, flies).
# Thoracic flight-muscle vibration through wings; steady buzz, AM at half the
# wing frequency.
fn crtract_synthesize_vibratile(self, f0, num_samples) {
    # 2.0.5: f0 finite, num_samples >= 0. Same raw-oscillator hazard as the
    # stridulatory path.
    if (prani_is_finite(f0) == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (num_samples < 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var sr = CreatureTract_sample_rate(self);
    var mod_rate = f64_mul(f0, PR_TR_0_5);
    var output = vec_new();
    var i = 0;
    while (i < num_samples) {
        var t = f64_div(f64_from(i), sr);
        var carrier = f64_sin(f64_mul(f64_mul(F64_TAU, f0), t));
        var h2 = f64_mul(f64_sin(f64_mul(f64_mul(f64_mul(F64_TAU, f0), F64_TWO), t)), PR_TR_0_3);
        var modulator = f64_add(PR_TR_0_5,
          f64_mul(PR_TR_0_5, f64_sin(f64_mul(f64_mul(F64_TAU, mod_rate), t))));
        vec_push(output, f64_mul(f64_mul(f64_add(carrier, h2), modulator), PR_TR_0_25));
        i = i + 1;
    }
    dcblocker_process_buffer(CreatureTract_dc_blocker(self), output);
    return output;
}

# fmod helper -- floating remainder a - trunc(a/b)*b (matches Rust f32 `%`
# for the non-negative operands used here: i-index positions and periods).
#must_use
fn crtract_fmod(a, b) {
    var q = f64_trunc(f64_div(a, b));
    return f64_sub(a, f64_mul(q, b));
}

# ---- public API -------------------------------------------------------------

# synthesize(f0, num_samples, options) -- CreatureTract::synthesize. Dispatches
# on the species' vocal apparatus. Returns a vec (heap ptr) on success or a
# negative PRANI_ERR_* on failure.
#
# 2.0.5: the input guards live in the five paths below, not here, because that
# is where each parameter is READ. Dispatch alone cannot say whether `f0` or
# `options` matters -- the NoiseOnly path takes neither -- and a guard here
# would reject, say, a NaN `f0` for a snake, whose synthesis never looks at it.
# Every path guards `num_samples`, so this entry point rejects a negative count
# for every apparatus.
#inline
fn crtract_synthesize(self, f0, num_samples, options) {
    var apparatus = SpeciesParams_apparatus(CreatureTract_params(self));
    if (apparatus == PRANI_APP_LARYNGEAL) {
        return crtract_synthesize_laryngeal(self, f0, num_samples, options);
    }
    if (apparatus == PRANI_APP_SYRINGEAL) {
        return crtract_synthesize_syringeal(self, f0, num_samples, options);
    }
    if (apparatus == PRANI_APP_NOISE_ONLY) {
        return crtract_synthesize_noise(self, num_samples);
    }
    if (apparatus == PRANI_APP_STRIDULATORY) {
        return crtract_synthesize_stridulatory(self, f0, num_samples, options);
    }
    # PRANI_APP_VIBRATILE
    return crtract_synthesize_vibratile(self, f0, num_samples);
}

# synthesize_purr(num_samples, purr_f0) -- 25-30 Hz laryngeal muscle cycling.
# Asymmetric waveform (0.4 open duty): a sharp squared half-sine pulse burst on
# the open phase excites the tract resonances; near-silence + faint noise on the
# closed phase. Returns a vec ptr on success or a negative PRANI_ERR_* on failure.
#
# 2.0.5 CONTRACT CHANGE: this used to be documented as "never fails -- no glottal
# source involved", and it has no glottal source still. What it does have is the
# phase accumulator, which is tract state that OUTLIVES the call: `phase +=
# purr_f0/sample_rate` with a non-finite purr_f0 latches `phase` non-finite for
# the tract's whole life, and every later purr then takes the closed-phase arm
# because `NaN < 0.4` is false. The output of the poisoned call is still finite
# (measured), so nothing downstream reports it -- the tract just quietly stops
# purring. That is the silent-corruption shape 2.0.5 exists to replace with a
# code, and it cannot be caught anywhere but here.
#inline
#must_use
fn crtract_synthesize_purr(self, num_samples, purr_f0) {
    if (prani_is_finite(purr_f0) == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (num_samples < 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var sr = CreatureTract_sample_rate(self);
    var tract = CreatureTract_tract(self);
    var rng = CreatureTract_rng(self);
    var phase_inc = f64_div(purr_f0, sr);
    var output = vec_new();
    var i = 0;
    while (i < num_samples) {
        var phase_frac = CreatureTract_phase(self);
        var excitation = 0;
        if (f64_lt(phase_frac, PR_TR_0_4) == 1) {
            # open phase: sharp glottal-like pulse burst (squared half-sine)
            var t = f64_div(phase_frac, PR_TR_0_4);
            var pulse = f64_sin(f64_mul(F64_PI, t));
            excitation = f64_mul(pulse, pulse);   # squared for a sharper pulse
        } else {
            # closed phase: near silence with slight noise
            excitation = f64_mul(prani_rng_next_f32(rng), PR_TR_0_02);
        }
        var ph = f64_add(CreatureTract_phase(self), phase_inc);
        if (f64_ge(ph, F64_ONE) == 1) { ph = f64_sub(ph, F64_ONE); }
        CreatureTract_set_phase(self, ph);
        # sharp pulse excites the vocal tract -> resonant harmonics
        vec_push(output, svara_tract_process_sample(tract, excitation));
        i = i + 1;
    }
    dcblocker_process_buffer(CreatureTract_dc_blocker(self), output);
    return output;
}

# set_formant_blend(target, target_bw, blend) -- CreatureTract::set_formant_blend.
# Blends species-default formants toward `target` by `blend` (clamped [0,1]);
# `target` / `target_bw` are 3-slot vecs (F1-F3 / B1-B3). At blend=0 uses the
# species defaults, at blend=1 uses `target`. Returns PRANI_ERR_NONE or a
# negative svara error mapped through prani.
fn crtract_set_formant_blend(self, target, target_bw, blend) {
    var params = CreatureTract_params(self);
    var bl = f64_clamp(blend, 0, F64_ONE);

    var f0 = SpeciesParams_formant0(params);
    var f1 = SpeciesParams_formant1(params);
    var f2 = SpeciesParams_formant2(params);
    var b0 = SpeciesParams_bandwidth0(params);
    var b1 = SpeciesParams_bandwidth1(params);
    var b2 = SpeciesParams_bandwidth2(params);

    # blended = base + (target - base) * blend
    var bf0 = f64_add(f0, f64_mul(f64_sub(vec_get(target, 0), f0), bl));
    var bf1 = f64_add(f1, f64_mul(f64_sub(vec_get(target, 1), f1), bl));
    var bf2 = f64_add(f2, f64_mul(f64_sub(vec_get(target, 2), f2), bl));
    var bb0 = f64_add(b0, f64_mul(f64_sub(vec_get(target_bw, 0), b0), bl));
    var bb1 = f64_add(b1, f64_mul(f64_sub(vec_get(target_bw, 1), b1), bl));
    var bb2 = f64_add(b2, f64_mul(f64_sub(vec_get(target_bw, 2), b2), bl));

    var vowel = svara_vowel_target_with_bandwidths(
      bf0, bf1, bf2, f64_mul(bf2, PR_TR_1_3), f64_mul(bf2, PR_TR_1_5),
      bb0, bb1, bb2, f64_mul(bb2, PR_TR_1_2), f64_mul(bb2, PR_TR_1_4));
    # Rust used `.map_err(Into::into)` -- propagate svara error through prani.
    return prani_from_svara(svara_tract_set_formants_from_target(CreatureTract_tract(self), vowel));
}

# apply_spectral_tilt(samples, tilt_db, sample_rate) -- static; first-order
# lowpass applied in place to a vec. tilt_db is dB/octave: negative = darker
# (lowpass), 0 = neutral. y[n] = (1-a)*x[n] + a*y[n-1]. The coefficient is
# derived from tilt_db directly (sample_rate unused, kept for signature parity).
# Returns PRANI_ERR_NONE, or PRANI_ERR_INVALID_TRACT for a non-finite tilt_db.
#
# 2.0.5: all three non-finite tilts were silent, and each was silent in a
# different way (measured). NaN: `|NaN| < 0.1` is false and `a < 0.01` is false,
# so a = NaN multiplied the WHOLE buffer into NaN and returned success. +inf:
# a = clamp(-inf/12) = 0, a no-op. -inf: a = clamp(+inf/12) = 0.85, the maximum
# lowpass this filter can apply -- a real, plausible-sounding filter fabricated
# out of a caller's arithmetic accident. All three now report.
fn crtract_apply_spectral_tilt(samples, tilt_db, sample_rate) {
    if (prani_is_finite(tilt_db) == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (f64_lt(f64_abs(tilt_db), PR_TR_0_1) == 1) { return 0; }
    # dB/octave -> coefficient: a = clamp(-tilt_db/12, 0, 0.85)
    var a = f64_clamp(f64_div(f64_neg(tilt_db), PR_TR_12_0), 0, PR_TR_0_85);
    if (f64_lt(a, PR_TR_0_01) == 1) { return 0; }
    var one_minus_a = f64_sub(F64_ONE, a);
    var prev = 0;
    var n = vec_len(samples);
    var i = 0;
    while (i < n) {
        # *s = (1-a)*x + a*prev; prev = *s
        var y = f64_add(f64_mul(one_minus_a, vec_get(samples, i)), f64_mul(a, prev));
        vec_set(samples, i, y);
        prev = y;
        i = i + 1;
    }
    return 0;
}

# reset -- CreatureTract::reset. Clears the svara tract state, phase, and the
# DC blocker memory.
fn crtract_reset(self) {
    svara_tract_reset(CreatureTract_tract(self));
    CreatureTract_set_phase(self, 0);
    dcblocker_reset(CreatureTract_dc_blocker(self));
}

# --- voice.cyr ---

# voice.cyr -- creature voice: species + individual variation + synthesis.
# Ports 2.0.3:rust-old/src/voice.rs (the largest prani module, 705 lines). A
# CreatureVoice is an instance of a Species with individual characteristics
# (f0 offset, size, breathiness/jitter/shimmer, vocal effort) and the big
# vocalize_with_intent orchestration that drives the CreatureTract through a
# per-block synthesis loop plus a chain of post-processing effects.
#
# Requires (from the build/test unit, in dependency order): stdlib alloc/vec/
# math, hisab (ease_in_out_smooth), goonj, naad, svara, error.cyr, rng.cyr,
# dsp.cyr, vocalization.cyr, sequence.cyr, species.cyr, bridge.cyr, tract.cyr.
# Module files carry no `include` lines -- the entry orders them.
#
# NAMING (flat-namespace prefix): EVERY top-level fn here is `crvoice_`-prefixed
# (including the private helpers), because the dist bundle shares one flat
# namespace and a later module (stream) reuses some of them. Rust `voice::*`
# would collide with naad's `voice_*`, so the audit's naming contract fixes the
# `crvoice_` prefix. The struct names PitchContour / FormantTransitionContour /
# FormantBlend are distinct and collision-free.
#
# FLOATS: prani's Rust was f32; this port is f64 (svara/naad/hisab are f64-only,
# widening is forced). Integer literals via f64_from(n) (negatives via
# f64_neg(f64_from(n))); non-integer literals via the module-top IEEE-754 hex
# constants below (decimals in comments), one constant per distinct value.
#
# MUTATION / NO MOVE SEMANTICS: Rust's builder methods take `mut self` by value
# and return Self. Cyrius has no move semantics -- CreatureVoice is a heap ptr,
# so the builders mutate the struct in place (the breathiness/jitter/shimmer
# builders mutate the *params* ptr the voice holds) and return the same self ptr.
# Callers chain `v = crvoice_with_size(crvoice_new(...), s)` exactly as in Rust.
# vocalize_with_intent must NOT mutate the voice's own params, so it allocates a
# FRESH SpeciesParams copy (crvoice_clone_params) before adjusting breathiness.
#
# RESULT convention: crvoice_vocalize / crvoice_vocalize_with_intent return a
# heap vec ptr (large positive) on success, or a NEGATIVE PRANI_ERR_* on failure.
# supports-check failure -> PRANI_ERR_INVALID_VOCALIZATION. crtract_synthesize
# errors propagate (if prani_is_err(block)==1 return block).
#
# PARITY: exact svara-internal bit parity vs the f32 oracle is not attainable
# (f32->f64 diverges through svara's DSP), so tests assert structural +
# parity-meaningful properties (effective_f0 / contour interp / clamps / lombard
# exact; finiteness / length / determinism for the full synthesis paths). serde
# and tracing::trace! dropped.
#
# ================================================================
# INPUT RANGES (2.0.5). Every fallible entry point here rejects out-of-range
# numeric input with a negative PRANI_ERR_* rather than returning an empty or
# all-NaN buffer as a success. The ranges, and where each one comes from:
#
#   sample_rate    finite, > 0        divisor in this module's OWN post-processing
#                                     (t_sec = i/sample_rate, the nasal notch's
#                                     r/theta, the trill AM clock). NOT a
#                                     threshold: svara stays the sole authority
#                                     on "too low to build a tract" (ADR-0001),
#                                     so nothing here goes stale when it moves.
#   duration       finite, >= 0       0 is VALID -- the oracle's
#                                     test_zero_duration_synthesis asserts an
#                                     EMPTY buffer, not an error.
#   num_samples    >= 0               f64_to of a non-finite or overflowing
#                                     (duration * sample_rate) is i64::MIN, and a
#                                     negative bound renders a silently EMPTY
#                                     buffer (audit F11).
#   voc            [0, PRANI_VOC_COUNT)      the Rust enum could not hold anything
#   intent         [0, PRANI_INTENT_COUNT)   else; the int tags can.
#   size_scale     finite, > 0        divides f0_default (effective_f0) and 27.0
#                                     (purr_f0). with_size clamps to [0.1, 10].
#   breathiness    [0, 1]             exactly what with_breathiness clamps to.
#   jitter         [0, 0.05]          exactly what with_jitter clamps to.
#   shimmer        [0, 0.1]           exactly what with_shimmer clamps to.
#   nasal_fraction finite, >= 0       fraction of the call that is nasal.
#
# The builders (crvoice_with_*) return `self` with no error channel, so a NaN
# handed to one is stored (f64_clamp(NaN, lo, hi) == NaN -- NaN passes every
# clamp) and only reported at the POINT OF USE, at the top of
# crvoice_vocalize_with_intent. Giving the builders an error channel is 2.1.0's
# constructor-contract work; guarding the consumer catches every path to svara
# with zero API change. Measured before the guard: a NaN through with_size or
# with_breathiness produced a full-length ALL-NaN buffer returned as SUCCESS.
# ================================================================

# ================================================================
# Non-integer literal constants (IEEE-754 hex; decimals in comments).
# ================================================================
var PR_V_0_3   = 0x3fd3333333333333;   # 0.3
var PR_V_1_2   = 0x3ff3333333333333;   # 1.2
var PR_V_0_5   = 0x3fe0000000000000;   # 0.5
var PR_V_6_0   = 0x4018000000000000;   # 6.0
var PR_V_0_15  = 0x3fc3333333333333;   # 0.15
var PR_V_0_1   = 0x3fb999999999999a;   # 0.1
var PR_V_0_85  = 0x3feb333333333333;   # 0.85
var PR_V_0_8   = 0x3fe999999999999a;   # 0.8
var PR_V_1_3   = 0x3ff4cccccccccccd;   # 1.3
var PR_V_0_7   = 0x3fe6666666666666;   # 0.7
var PR_V_1_4   = 0x3ff6666666666666;   # 1.4
var PR_V_1_6   = 0x3ff999999999999a;   # 1.6
var PR_V_1_5   = 0x3ff8000000000000;   # 1.5
var PR_V_0_9   = 0x3feccccccccccccd;   # 0.9
var PR_V_0_25  = 0x3fd0000000000000;   # 0.25
var PR_V_0_75  = 0x3fe8000000000000;   # 0.75
var PR_V_1_1   = 0x3ff199999999999a;   # 1.1
var PR_V_0_4   = 0x3fd999999999999a;   # 0.4
var PR_V_0_2   = 0x3fc999999999999a;   # 0.2
var PR_V_0_6   = 0x3fe3333333333333;   # 0.6
var PR_V_1_78  = 0x3ffc7ae147ae147b;   # 1.78  canid biphonation interval (~minor 7th)
var PR_V_250_0 = 0x406f400000000000;   # 250.0 nasal anti-formant notch freq (Hz)
var PR_V_80_0  = 0x4054000000000000;   # 80.0  nasal notch bandwidth (Hz)
var PR_V_NEG_2 = 0xc000000000000000;   # -2.0  growl/rumble spectral offset
var PR_V_NEG_1 = 0xbff0000000000000;   # -1.0  roar spectral offset
var PR_V_2_0   = 0x4000000000000000;   # 2.0   hiss spectral offset
var PR_V_0_65  = 0x3fe4cccccccccccd;   # 0.65  trill AM base
var PR_V_0_35  = 0x3fd6666666666666;   # 0.35  trill AM depth
var PR_V_0_999 = 0x3feff7ced916872b;   # 0.999 notch pole-radius clamp ceiling
var PR_V_20_0  = 0x4034000000000000;   # 20.0  trill AM rate (Hz)
var PR_V_0_08  = 0x3fb47ae147ae147b;   # 0.08  roar envelope attack fraction
var PR_V_0_03  = 0x3f9eb851eb851eb8;   # 0.03  screech envelope attack fraction
var PR_V_0_05  = 0x3fa999999999999a;   # 0.05  jitter clamp ceiling / short-call attack+release
var PR_V_0_02  = 0x3f947ae147ae147b;   # 0.02  synthesis block duration (20ms)

# ================================================================
# CreatureVoice -- a creature's voice: species + individual variation.
#   species      : PRANI_SP_* constant
#   params       : SpeciesParams ptr (may be individually modified)
#   f0_offset    : individual f0 offset from species default (Hz)
#   size_scale   : individual size scaling (tract length + f0)
#   vocal_effort : 0.0 = whisper, 0.5 = normal, 1.0 = shout
# serde RESTORED via crvoice_to_json / crvoice_from_json_str (below): scalars as
# bit patterns + nested SpeciesParams (individual overrides preserved).
# ================================================================
#derive(accessors)
struct CreatureVoice {
    species; params; f0_offset; size_scale; vocal_effort;
}

# new(species) -- CreatureVoice::new. Default individual params: f0_offset 0,
# size_scale 1, vocal_effort 0.5, with the species' default vocal parameters.
#must_use
fn crvoice_new(species) {
    var self = alloc(sizeof(CreatureVoice));
    CreatureVoice_set_species(self, species);
    CreatureVoice_set_params(self, species_params(species));
    CreatureVoice_set_f0_offset(self, 0);
    CreatureVoice_set_size_scale(self, F64_ONE);
    CreatureVoice_set_vocal_effort(self, PR_V_0_5);
    return self;
}

# reset_individual(self) -- restore the species defaults for the four individual
# fields, in place. Exactly what `crvoice_new(crvoice_species(self))` produces,
# without allocating a replacement voice: species is unchanged, params are reset
# to the species table, and f0_offset / size_scale / vocal_effort go back to
# 0 / 1.0 / 0.5. Used by the FFI size RTPC (prani_ffi_voice_set_size), which the
# host may call every frame and which must therefore not allocate.
fn crvoice_reset_individual(self) {
    # species_params_INTO, not species_params: the voice already owns a
    # SpeciesParams, and this path allocates nothing (see species_params_into).
    species_params_into(CreatureVoice_params(self), CreatureVoice_species(self));
    CreatureVoice_set_f0_offset(self, 0);
    CreatureVoice_set_size_scale(self, F64_ONE);
    CreatureVoice_set_vocal_effort(self, PR_V_0_5);
    return self;
}

# CreatureVoice serde -- restores the Rust `#[derive(Serialize, Deserialize)]`.
# f64 scalars (f0_offset/size_scale/vocal_effort) emitted as exact i64 BIT
# PATTERNS (lossless); `params` nested as a sub-object via the auto
# SpeciesParams_to_json and rebuilt with species_params_from_node (so individual
# breathiness/jitter/shimmer overrides survive the roundtrip). Idempotent.
fn crvoice_to_json(self, sb) {
    str_builder_add_cstr(sb, "{\"species\":");
    str_builder_add_int(sb, CreatureVoice_species(self));
    str_builder_add_cstr(sb, ",\"f0_offset\":");
    str_builder_add_int(sb, CreatureVoice_f0_offset(self));
    str_builder_add_cstr(sb, ",\"size_scale\":");
    str_builder_add_int(sb, CreatureVoice_size_scale(self));
    str_builder_add_cstr(sb, ",\"vocal_effort\":");
    str_builder_add_int(sb, CreatureVoice_vocal_effort(self));
    str_builder_add_cstr(sb, ",\"params\":");
    SpeciesParams_to_json(CreatureVoice_params(self), sb);
    str_builder_add_cstr(sb, "}");
    return 0;
}

# ---- SpeciesParams range check (2.0.5) --------------------------------------

# formants_in_range(p) -- 1 iff the six resonator frequencies/bandwidths are
# finite and > 0. Split out of crvoice_params_in_range purely to keep that
# function readable; every species row in the table satisfies it (measured).
#must_use
fn crvoice_formants_in_range(p) {
    if (prani_is_positive(SpeciesParams_formant0(p)) == 0) { return 0; }
    if (prani_is_positive(SpeciesParams_formant1(p)) == 0) { return 0; }
    if (prani_is_positive(SpeciesParams_formant2(p)) == 0) { return 0; }
    if (prani_is_positive(SpeciesParams_bandwidth0(p)) == 0) { return 0; }
    if (prani_is_positive(SpeciesParams_bandwidth1(p)) == 0) { return 0; }
    return prani_is_positive(SpeciesParams_bandwidth2(p));
}

# params_in_range(p) -- 1 iff every SpeciesParams field is a value prani itself
# would write, 0 otherwise (including a null p or a negative error code in p's
# place). Used BOTH as the deserializer's field gate and as the point-of-use
# guard at the top of crvoice_vocalize_with_intent, so the two cannot drift.
#
# The f0 fields are NON-NEGATIVE rather than positive: Snake is noise-only and
# its row is f0_min == f0_max == f0_default == 0.0 (measured). f0_min <= f0_max
# and f0_default within [f0_min, f0_max] hold for all 13 rows, Snake's degenerate
# 0/0/0 included. resonance_seed is NOT range-checked -- it is an RNG seed, and
# every i64 bit pattern is a legal one.
#must_use
fn crvoice_params_in_range(p) {
    if (p == 0) { return 0; }
    if (prani_is_err(p) == 1) { return 0; }
    var app = SpeciesParams_apparatus(p);
    if (app < PRANI_APP_LARYNGEAL) { return 0; }
    if (app > PRANI_APP_NOISE_ONLY) { return 0; }
    var f0_min = SpeciesParams_f0_min(p);
    var f0_max = SpeciesParams_f0_max(p);
    if (prani_is_non_negative(f0_min) == 0) { return 0; }
    if (prani_is_non_negative(f0_max) == 0) { return 0; }
    if (f64_le(f0_min, f0_max) == 0) { return 0; }
    if (prani_in_range(SpeciesParams_f0_default(p), f0_min, f0_max) == 0) { return 0; }
    if (prani_is_positive(SpeciesParams_tract_scale(p)) == 0) { return 0; }
    if (crvoice_formants_in_range(p) == 0) { return 0; }
    if (prani_in_range(SpeciesParams_breathiness(p), 0, F64_ONE) == 0) { return 0; }
    if (prani_in_range(SpeciesParams_jitter(p), 0, PR_V_0_05) == 0) { return 0; }
    if (prani_in_range(SpeciesParams_shimmer(p), 0, PR_V_0_1) == 0) { return 0; }
    return prani_is_finite(SpeciesParams_spectral_tilt(p));
}

# from_json_str(json) -- rebuild a CreatureVoice from crvoice_to_json output.
# `json` is a NUL-terminated cstring. Scalars are read back as exact i64 bit
# patterns and `params` is rebuilt via species_params_from_node, so individual
# breathiness/jitter/shimmer overrides survive the roundtrip.
# Returns the CreatureVoice ptr, or a NEGATIVE PRANI_ERR_INVALID_SPECIES if
# `json` is 0, does not parse, or carries an OUT-OF-RANGE field. Check with
# prani_is_err before using it.
#
# 2.0.5: every field is range-checked (ADR-0002 deferred exactly this). The
# scalars arrive as raw i64 bit patterns, so nothing about the document's syntax
# constrains them -- "size_scale": 0 deserializes to +0.0 and makes
# crvoice_effective_f0 divide by zero. crvoice_to_json's own output always
# satisfies these ranges because the builders clamp to them, so this can only
# ever reject a document prani did not write. The ranges are with_size's
# [0.1, 10.0], with_vocal_effort's [0, 1], with_f0_offset's +/-(f0_max - f0_min)
# and the species table's own field ranges (crvoice_params_in_range).
fn crvoice_from_json_str(json) {
    if (json == 0) { return PRANI_ERR_INVALID_SPECIES; }
    var root = bayan_json_v_parse_buf(json, strlen(json));
    if (root == 0) { return PRANI_ERR_INVALID_SPECIES; }
    var species = bayan_json_v_int(bayan_json_v_obj_get(root, "species"));
    if (species < 0) { return PRANI_ERR_INVALID_SPECIES; }
    if (species >= PRANI_SP_COUNT) { return PRANI_ERR_INVALID_SPECIES; }
    var params = species_params_from_node(bayan_json_v_obj_get(root, "params"));
    if (crvoice_params_in_range(params) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    # with_f0_offset's own clamp range, read off the params just validated.
    var range = f64_sub(SpeciesParams_f0_max(params), SpeciesParams_f0_min(params));
    var f0_offset = bayan_json_v_int(bayan_json_v_obj_get(root, "f0_offset"));
    if (prani_in_range(f0_offset, f64_neg(range), range) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    var size_scale = bayan_json_v_int(bayan_json_v_obj_get(root, "size_scale"));
    if (prani_in_range(size_scale, PR_V_0_1, f64_from(10)) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    var vocal_effort = bayan_json_v_int(bayan_json_v_obj_get(root, "vocal_effort"));
    if (prani_in_range(vocal_effort, 0, F64_ONE) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    var self = alloc(sizeof(CreatureVoice));
    CreatureVoice_set_species(self, species);
    CreatureVoice_set_f0_offset(self, f0_offset);
    CreatureVoice_set_size_scale(self, size_scale);
    CreatureVoice_set_vocal_effort(self, vocal_effort);
    CreatureVoice_set_params(self, params);
    return self;
}

# with_f0_offset(self, offset) -- clamps offset to +/-(f0_max - f0_min) so the
# effective f0 stays within the species range. Mutates self, returns self.
#must_use
fn crvoice_with_f0_offset(self, offset) {
    var params = CreatureVoice_params(self);
    var range = f64_sub(SpeciesParams_f0_max(params), SpeciesParams_f0_min(params));
    CreatureVoice_set_f0_offset(self, f64_clamp(offset, f64_neg(range), range));
    return self;
}

# with_size(self, scale) -- clamps size scale to [0.1, 10.0]. >1 = larger
# creature (lower pitch, longer tract). Mutates self, returns self.
#must_use
fn crvoice_with_size(self, scale) {
    CreatureVoice_set_size_scale(self, f64_clamp(scale, PR_V_0_1, f64_from(10)));
    return self;
}

# with_breathiness(self, breathiness) -- clamps to [0, 1]; mutates the voice's
# params ptr in place (no move semantics). Returns self.
#must_use
fn crvoice_with_breathiness(self, breathiness) {
    SpeciesParams_set_breathiness(CreatureVoice_params(self), f64_clamp(breathiness, 0, F64_ONE));
    return self;
}

# with_jitter(self, jitter) -- clamps to [0, 0.05]; mutates params in place.
#must_use
fn crvoice_with_jitter(self, jitter) {
    SpeciesParams_set_jitter(CreatureVoice_params(self), f64_clamp(jitter, 0, PR_V_0_05));
    return self;
}

# with_shimmer(self, shimmer) -- clamps to [0, 0.1]; mutates params in place.
#must_use
fn crvoice_with_shimmer(self, shimmer) {
    SpeciesParams_set_shimmer(CreatureVoice_params(self), f64_clamp(shimmer, 0, PR_V_0_1));
    return self;
}

# with_vocal_effort(self, effort) -- clamps to [0, 1]. Mutates self, returns self.
#must_use
fn crvoice_with_vocal_effort(self, effort) {
    CreatureVoice_set_vocal_effort(self, f64_clamp(effort, 0, F64_ONE));
    return self;
}

# set_vocal_effort(self, effort) -- mutable effort update (real-time RTPC).
fn crvoice_set_vocal_effort(self, effort) {
    CreatureVoice_set_vocal_effort(self, f64_clamp(effort, 0, F64_ONE));
}

# vocal_effort(self) -- current vocal effort.
#must_use
fn crvoice_vocal_effort(self) {
    return CreatureVoice_vocal_effort(self);
}

# apply_lombard_effect(self, ambient_spl_db) -- involuntary effort increase in
# ambient noise (bridge_lombard_effort_boost), additive, clamped to [0, 1].
fn crvoice_apply_lombard_effect(self, ambient_spl_db) {
    var boost = bridge_lombard_effort_boost(ambient_spl_db);
    CreatureVoice_set_vocal_effort(self,
      f64_clamp(f64_add(CreatureVoice_vocal_effort(self), boost), 0, F64_ONE));
}

# species(self) -- the species constant.
#must_use
fn crvoice_species(self) {
    return CreatureVoice_species(self);
}

# effective_f0(self) -- (f0_default + f0_offset) / size_scale, clamped to the
# species [f0_min, f0_max]. Larger creatures have lower pitch.
#must_use
fn crvoice_effective_f0(self) {
    var params = CreatureVoice_params(self);
    var base = f64_add(SpeciesParams_f0_default(params), CreatureVoice_f0_offset(self));
    var scaled = f64_div(base, CreatureVoice_size_scale(self));
    return f64_clamp(scaled, SpeciesParams_f0_min(params), SpeciesParams_f0_max(params));
}

# effective_tract_scale(self) -- tract_scale * size_scale.
#must_use
fn crvoice_effective_tract_scale(self) {
    return f64_mul(SpeciesParams_tract_scale(CreatureVoice_params(self)), CreatureVoice_size_scale(self));
}

# ---- params copy helper -----------------------------------------------------

# clone_params(src) -- allocate a fresh SpeciesParams copy (deep field copy), so
# vocalize_with_intent's effort-adjusted breathiness does not mutate the voice's
# own params (Rust used `self.params.clone()`).
#must_use
fn crvoice_clone_params(src) {
    return species_params_make(
      SpeciesParams_apparatus(src),
      SpeciesParams_f0_min(src), SpeciesParams_f0_max(src), SpeciesParams_f0_default(src),
      SpeciesParams_tract_scale(src),
      SpeciesParams_formant0(src), SpeciesParams_formant1(src), SpeciesParams_formant2(src),
      SpeciesParams_bandwidth0(src), SpeciesParams_bandwidth1(src), SpeciesParams_bandwidth2(src),
      SpeciesParams_breathiness(src), SpeciesParams_jitter(src), SpeciesParams_shimmer(src),
      SpeciesParams_spectral_tilt(src), SpeciesParams_resonance_seed(src));
}

# ================================================================
# PitchContour -- how f0 varies over a call (base f0 * time-varying multiplier).
#   base   : base f0 (Hz)
#   points : flat vec [t0,v0, t1,v1, ...] of (normalized_time, f0_multiplier).
#            Rust used a static &[(f32,f32)]; the port builds a flat f64 vec per
#            vocalization inside crvoice_pitch_contour.
# ================================================================
#derive(accessors)
struct PitchContour { base; points; }

# ================================================================
# FormantBlend -- the (formants, bandwidths, blend) triple that
# FormantTransitionContour::at() returns. Rust returned ([f32;3],[f32;3],f32);
# the port wraps it in this 7-field struct (Cyrius fns return one value).
# ================================================================
#derive(accessors)
struct FormantBlend { f0; f1; f2; b0; b1; b2; blend; }

# ================================================================
# FormantTransitionContour -- how formants change during a vocalization (cat
# meow, wolf howl). keyframes is a flat vec of 8 f64 per keyframe:
#   [t, f0,f1,f2, b0,b1,b2, blend]
# indexed as base = k*8. Rust used a static &[(f32,[f32;3],[f32;3],f32)].
# ================================================================
#derive(accessors)
struct FormantTransitionContour { keyframes; }

# ---- PitchContour::f0_at ----------------------------------------------------

# PitchContour_f0_at(self, t) -- f0 at normalized time t (clamped [0,1]).
# Linear interpolation between contour points; empty -> base; past the last
# point -> base * last_multiplier.
#must_use
fn crvoice_pitch_contour_f0_at(self, t) {
    var base = PitchContour_base(self);
    var points = PitchContour_points(self);
    var n = vec_len(points);   # total slots (2 per point)
    var tc = f64_clamp(t, 0, F64_ONE);
    if (n == 0) { return base; }
    var num_points = n / 2;
    # iterate segments [i, i+1] for i in 0..num_points-1
    var i = 0;
    while (i < num_points - 1) {
        var t0 = vec_get(points, i * 2);
        var v0 = vec_get(points, i * 2 + 1);
        var t1 = vec_get(points, (i + 1) * 2);
        var v1 = vec_get(points, (i + 1) * 2 + 1);
        if (f64_ge(tc, t0) == 1) {
            if (f64_le(tc, t1) == 1) {
                var frac = 0;
                if (f64_ge(f64_abs(f64_sub(t1, t0)), PRANI_EPSILON) == 1) {
                    frac = f64_div(f64_sub(tc, t0), f64_sub(t1, t0));
                }
                # base * (v0 + (v1 - v0) * frac)
                return f64_mul(base, f64_add(v0, f64_mul(f64_sub(v1, v0), frac)));
            }
        }
        i = i + 1;
    }
    # past the last point: base * last multiplier
    return f64_mul(base, vec_get(points, n - 1));
}

# ---- pitch_contour ----------------------------------------------------------

# push a (time, multiplier) point onto a flat contour vec.
fn crvoice_contour_push(v, t, mult) {
    vec_push(v, t);
    vec_push(v, mult);
}

# pitch_contour(voc, base_f0) -- the vocalization's pitch contour. Builds the
# flat point vec from the static per-vocalization tables (transcribed verbatim
# from the oracle). Returns a PitchContour ptr.
#must_use
fn crvoice_pitch_contour(voc, base_f0) {
    var points = vec_new();
    if (voc == PRANI_VOC_HOWL) {
        # HOWL: (0.0,0.8),(0.3,1.3),(0.7,1.2),(1.0,0.6)
        crvoice_contour_push(points, 0, PR_V_0_8);
        crvoice_contour_push(points, PR_V_0_3, PR_V_1_3);
        crvoice_contour_push(points, PR_V_0_7, PR_V_1_2);
        crvoice_contour_push(points, F64_ONE, PR_V_0_6);
    } elif (voc == PRANI_VOC_BARK) {
        crvoice_pitch_contour_bark(points);
    } elif (voc == PRANI_VOC_YELP) {
        crvoice_pitch_contour_bark(points);
    } elif (voc == PRANI_VOC_ROAR) {
        crvoice_pitch_contour_roar(points);
    } elif (voc == PRANI_VOC_RUMBLE) {
        crvoice_pitch_contour_roar(points);
    } elif (voc == PRANI_VOC_WHINE) {
        # WHINE: (0.0,1.0),(0.5,1.4),(1.0,1.6)
        crvoice_contour_push(points, 0, F64_ONE);
        crvoice_contour_push(points, PR_V_0_5, PR_V_1_4);
        crvoice_contour_push(points, F64_ONE, PR_V_1_6);
    } elif (voc == PRANI_VOC_SCREECH) {
        # SCREECH: (0.0,1.5),(0.3,1.2),(1.0,0.7)
        crvoice_contour_push(points, 0, PR_V_1_5);
        crvoice_contour_push(points, PR_V_0_3, PR_V_1_2);
        crvoice_contour_push(points, F64_ONE, PR_V_0_7);
    } elif (voc == PRANI_VOC_TRILL) {
        # TRILL: (0.0,1.0),(0.25,1.1),(0.5,0.9),(0.75,1.1),(1.0,1.0)
        crvoice_contour_push(points, 0, F64_ONE);
        crvoice_contour_push(points, PR_V_0_25, PR_V_1_1);
        crvoice_contour_push(points, PR_V_0_5, PR_V_0_9);
        crvoice_contour_push(points, PR_V_0_75, PR_V_1_1);
        crvoice_contour_push(points, F64_ONE, F64_ONE);
    } else {
        # FLAT: (0.0,1.0),(1.0,1.0)
        crvoice_contour_push(points, 0, F64_ONE);
        crvoice_contour_push(points, F64_ONE, F64_ONE);
    }
    var self = alloc(sizeof(PitchContour));
    PitchContour_set_base(self, base_f0);
    PitchContour_set_points(self, points);
    return self;
}

# BARK/YELP: (0.0,1.2),(0.1,1.0),(1.0,0.8)
fn crvoice_pitch_contour_bark(points) {
    crvoice_contour_push(points, 0, PR_V_1_2);
    crvoice_contour_push(points, PR_V_0_1, F64_ONE);
    crvoice_contour_push(points, F64_ONE, PR_V_0_8);
}

# ROAR/RUMBLE: (0.0,0.9),(0.15,1.2),(0.5,1.0),(1.0,0.7)
fn crvoice_pitch_contour_roar(points) {
    crvoice_contour_push(points, 0, PR_V_0_9);
    crvoice_contour_push(points, PR_V_0_15, PR_V_1_2);
    crvoice_contour_push(points, PR_V_0_5, F64_ONE);
    crvoice_contour_push(points, F64_ONE, PR_V_0_7);
}

# ---- FormantTransitionContour::at -------------------------------------------

# push an 8-slot keyframe [t, f0,f1,f2, b0,b1,b2, blend] onto the flat vec.
fn crvoice_keyframe_push(v, t, f0, f1, f2, b0, b1, b2, blend) {
    vec_push(v, t);
    vec_push(v, f0);  vec_push(v, f1);  vec_push(v, f2);
    vec_push(v, b0);  vec_push(v, b1);  vec_push(v, b2);
    vec_push(v, blend);
}

# formant_transition_at(self, t) -- FormantTransitionContour::at. Interpolated
# (formants, bandwidths, blend) at normalized t, returned in a FormantBlend
# struct. Empty keyframes -> all-zero blend. Past the last keyframe -> the last
# keyframe's values.
#must_use
fn crvoice_formant_transition_at(self, t) {
    var kf = FormantTransitionContour_keyframes(self);
    var slots = vec_len(kf);          # 8 per keyframe
    var tc = f64_clamp(t, 0, F64_ONE);
    var out = alloc(sizeof(FormantBlend));
    if (slots == 0) {
        FormantBlend_set_f0(out, 0);  FormantBlend_set_f1(out, 0);  FormantBlend_set_f2(out, 0);
        FormantBlend_set_b0(out, 0);  FormantBlend_set_b1(out, 0);  FormantBlend_set_b2(out, 0);
        FormantBlend_set_blend(out, 0);
        return out;
    }
    var num_kf = slots / 8;
    var i = 0;
    while (i < num_kf - 1) {
        var a = i * 8;
        var b = (i + 1) * 8;
        var t0 = vec_get(kf, a);
        var t1 = vec_get(kf, b);
        if (f64_ge(tc, t0) == 1) {
            if (f64_le(tc, t1) == 1) {
                var frac = 0;
                if (f64_ge(f64_abs(f64_sub(t1, t0)), PRANI_EPSILON) == 1) {
                    frac = f64_div(f64_sub(tc, t0), f64_sub(t1, t0));
                }
                # linear interp of each of the 7 fields (offsets 1..8 within a keyframe)
                FormantBlend_set_f0(out, crvoice_lerp_kf(kf, a + 1, b + 1, frac));
                FormantBlend_set_f1(out, crvoice_lerp_kf(kf, a + 2, b + 2, frac));
                FormantBlend_set_f2(out, crvoice_lerp_kf(kf, a + 3, b + 3, frac));
                FormantBlend_set_b0(out, crvoice_lerp_kf(kf, a + 4, b + 4, frac));
                FormantBlend_set_b1(out, crvoice_lerp_kf(kf, a + 5, b + 5, frac));
                FormantBlend_set_b2(out, crvoice_lerp_kf(kf, a + 6, b + 6, frac));
                FormantBlend_set_blend(out, crvoice_lerp_kf(kf, a + 7, b + 7, frac));
                return out;
            }
        }
        i = i + 1;
    }
    # past the last keyframe: return its stored values
    var last = (num_kf - 1) * 8;
    FormantBlend_set_f0(out, vec_get(kf, last + 1));
    FormantBlend_set_f1(out, vec_get(kf, last + 2));
    FormantBlend_set_f2(out, vec_get(kf, last + 3));
    FormantBlend_set_b0(out, vec_get(kf, last + 4));
    FormantBlend_set_b1(out, vec_get(kf, last + 5));
    FormantBlend_set_b2(out, vec_get(kf, last + 6));
    FormantBlend_set_blend(out, vec_get(kf, last + 7));
    return out;
}

# lerp two flat-vec slots: v[ia] + (v[ib] - v[ia]) * frac.
#must_use
fn crvoice_lerp_kf(v, ia, ib, frac) {
    var x0 = vec_get(v, ia);
    var x1 = vec_get(v, ib);
    return f64_add(x0, f64_mul(f64_sub(x1, x0), frac));
}

# ---- formant_transition_contour ---------------------------------------------

# formant_transition_contour(voc, species) -- a FormantTransitionContour ptr for
# vocalizations with dynamic mouth shape, or 0 (== None) otherwise.
#   Cat Howl/Whine  -> CAT_MEOW_HOWL keyframes
#   Wolf/Dog Howl   -> WOLF_HOWL keyframes
#must_use
fn crvoice_formant_transition_contour(voc, species) {
    # Cat meow/howl: "m" (nasal, closed) -> "e"/"a" (open) -> "ow" (closing)
    if (species == PRANI_SP_CAT) {
        if (voc == PRANI_VOC_HOWL) { return crvoice_make_cat_meow_howl(); }
        if (voc == PRANI_VOC_WHINE) { return crvoice_make_cat_meow_howl(); }
        return 0;
    }
    # Wolf/Dog howl: gradual mouth opening then closing, subtle formant shift
    if (species == PRANI_SP_WOLF) {
        if (voc == PRANI_VOC_HOWL) { return crvoice_make_wolf_howl(); }
        return 0;
    }
    if (species == PRANI_SP_DOG) {
        if (voc == PRANI_VOC_HOWL) { return crvoice_make_wolf_howl(); }
        return 0;
    }
    return 0;
}

# CAT_MEOW_HOWL keyframes (verbatim from the oracle static table).
#must_use
fn crvoice_make_cat_meow_howl() {
    var kf = vec_new();
    # (0.0, [400,2000,3500], [150,200,250], 0.8)
    crvoice_keyframe_push(kf, 0,
      f64_from(400), f64_from(2000), f64_from(3500),
      f64_from(150), f64_from(200), f64_from(250), PR_V_0_8);
    # (0.4, [1000,2800,4500], [100,130,180], 1.0)
    crvoice_keyframe_push(kf, PR_V_0_4,
      f64_from(1000), f64_from(2800), f64_from(4500),
      f64_from(100), f64_from(130), f64_from(180), F64_ONE);
    # (1.0, [500,1800,3800], [140,180,220], 0.6)
    crvoice_keyframe_push(kf, F64_ONE,
      f64_from(500), f64_from(1800), f64_from(3800),
      f64_from(140), f64_from(180), f64_from(220), PR_V_0_6);
    var self = alloc(sizeof(FormantTransitionContour));
    FormantTransitionContour_set_keyframes(self, kf);
    return self;
}

# WOLF_HOWL keyframes (verbatim from the oracle static table).
#must_use
fn crvoice_make_wolf_howl() {
    var kf = vec_new();
    # (0.0, [420,1250,2100], [100,120,150], 0.0)
    crvoice_keyframe_push(kf, 0,
      f64_from(420), f64_from(1250), f64_from(2100),
      f64_from(100), f64_from(120), f64_from(150), 0);
    # (0.3, [500,1400,2300], [90,110,140], 0.6)
    crvoice_keyframe_push(kf, PR_V_0_3,
      f64_from(500), f64_from(1400), f64_from(2300),
      f64_from(90), f64_from(110), f64_from(140), PR_V_0_6);
    # (0.7, [480,1350,2200], [95,115,145], 0.4)
    crvoice_keyframe_push(kf, PR_V_0_7,
      f64_from(480), f64_from(1350), f64_from(2200),
      f64_from(95), f64_from(115), f64_from(145), PR_V_0_4);
    # (1.0, [400,1200,2000], [110,130,160], 0.3)
    crvoice_keyframe_push(kf, F64_ONE,
      f64_from(400), f64_from(1200), f64_from(2000),
      f64_from(110), f64_from(130), f64_from(160), PR_V_0_3);
    var self = alloc(sizeof(FormantTransitionContour));
    FormantTransitionContour_set_keyframes(self, kf);
    return self;
}

# ---- nasal_phase_fraction ---------------------------------------------------

# nasal_phase_fraction(voc, species) -- fraction of the call that is nasal from
# the start, or a NEGATIVE sentinel (-1) for None (valid fractions are >= 0).
#   Cat Howl/Whine  -> 0.2
#   Wolf/Dog Howl   -> 0.1
#must_use
fn crvoice_nasal_phase_fraction(voc, species) {
    if (species == PRANI_SP_CAT) {
        if (voc == PRANI_VOC_HOWL) { return PR_V_0_2; }
        if (voc == PRANI_VOC_WHINE) { return PR_V_0_2; }
        return f64_neg(F64_ONE);
    }
    if (species == PRANI_SP_WOLF) {
        if (voc == PRANI_VOC_HOWL) { return PR_V_0_1; }
        return f64_neg(F64_ONE);
    }
    if (species == PRANI_SP_DOG) {
        if (voc == PRANI_VOC_HOWL) { return PR_V_0_1; }
        return f64_neg(F64_ONE);
    }
    return f64_neg(F64_ONE);
}

# ---- apply_nasal_antiformant ------------------------------------------------

# apply_nasal_antiformant(samples, sample_rate, nasal_fraction) -- second-order
# IIR notch at ~250 Hz applied to the first nasal_fraction of the buffer, faded
# from full at the start to 0 by the end of the nasal phase. Mutates in place.
# cos(theta) computed via sin(pi/2 - theta) -- the oracle's cos-via-sin trick.
# Returns 0, or a NEGATIVE PRANI_ERR_* for an unusable sample rate / fraction.
#
# 2.0.5 -- two separate repairs here:
#
#  1. CRASH (parity repair, not a divergence). The oracle iterates
#     `samples.iter_mut().enumerate().take(nasal_len)`
#     (2.0.3:rust-old/src/voice.rs:613), and `.take(n)` STOPS AT THE BUFFER END
#     for any n. The port transcribed it as `while (i < nasal_len)` with no
#     such stop, so a nasal_fraction above 1.0 indexed past the end and
#     terminated the process ("vec: index out of bounds", measured at fraction
#     2.0 on a 100-sample buffer). The iteration bound is now clamped to len --
#     in f64, BEFORE the f64_to, so an overflowing product lands on len the way
#     the oracle's saturating `as usize` does. The FADE DENOMINATOR stays the
#     unclamped nasal_len, which is what the oracle divides by; clamping it too
#     would change the fade curve for fractions above 1.0.
#  2. sample_rate is a divisor of both notch coefficients: at 0 it makes
#     theta = inf, cos_theta = sin(inf) = NaN, and every filtered sample NaN.
#     Reported instead. The internal call site (the post-processing chain in
#     crvoice_vocalize_with_intent) has already validated both arguments, so
#     neither guard can fire from there -- it passes 0.1 or 0.2 and a sample rate
#     that survived the guard at the top of vocalize.
fn crvoice_apply_nasal_antiformant(samples, sample_rate, nasal_fraction) {
    if (prani_is_positive(sample_rate) == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (prani_is_non_negative(nasal_fraction) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var len = vec_len(samples);
    # nasal_len = (len as f32 * nasal_fraction) as usize -- the fade denominator.
    var scaled = f64_mul(f64_from(len), nasal_fraction);
    var nasal_len = f64_to(scaled);
    if (nasal_len == 0) { return 0; }
    # take_len = min(nasal_len, len) -- the oracle's `.take(nasal_len)` bound.
    var take_scaled = scaled;
    if (f64_gt(take_scaled, f64_from(len)) == 1) { take_scaled = f64_from(len); }
    var take_len = f64_to(take_scaled);

    var notch_freq = PR_V_250_0;
    var notch_bw = PR_V_80_0;
    # r = clamp(1 - (pi * notch_bw / sr), 0.5, 0.999)
    var r = f64_sub(F64_ONE, f64_div(f64_mul(F64_PI, notch_bw), sample_rate));
    r = f64_clamp(r, PR_V_0_5, PR_V_0_999);
    var theta = f64_div(f64_mul(F64_TAU, notch_freq), sample_rate);
    # cos_theta = sin(pi/2 - theta)
    var cos_theta = f64_sin(f64_sub(f64_div(F64_PI, F64_TWO), theta));

    # H(z) = (1 - 2cos z^-1 + z^-2) / (1 - 2r cos z^-1 + r^2 z^-2)
    var a1 = f64_mul(f64_mul(f64_neg(F64_TWO), r), cos_theta);
    var a2 = f64_mul(r, r);
    var b1 = f64_mul(f64_neg(F64_TWO), cos_theta);

    var x1 = 0;
    var x2 = 0;
    var y1 = 0;
    var y2 = 0;

    var i = 0;
    while (i < take_len) {
        var x0 = vec_get(samples, i);
        # y0 = x0 + b1*x1 + x2 - a1*y1 - a2*y2
        var y0 = f64_sub(
          f64_sub(f64_add(f64_add(x0, f64_mul(b1, x1)), x2), f64_mul(a1, y1)),
          f64_mul(a2, y2));
        x2 = x1;
        x1 = x0;
        y2 = y1;
        y1 = y0;
        # fade = 1 - i/nasal_len ; sample = sample*(1-fade) + y0*fade
        var fade = f64_sub(F64_ONE, f64_div(f64_from(i), f64_from(nasal_len)));
        var blended = f64_add(f64_mul(x0, f64_sub(F64_ONE, fade)), f64_mul(y0, fade));
        vec_set(samples, i, blended);
        i = i + 1;
    }
    return 0;
}

# ---- vocalization_spectral_offset -------------------------------------------

# vocalization_spectral_offset(voc) -- spectral tilt offset (dB/octave) layered
# on top of the species tilt. Negative = darker.
#must_use
fn crvoice_vocalization_spectral_offset(voc) {
    if (voc == PRANI_VOC_GROWL) { return PR_V_NEG_2; }
    if (voc == PRANI_VOC_RUMBLE) { return PR_V_NEG_2; }
    if (voc == PRANI_VOC_ROAR) { return PR_V_NEG_1; }
    if (voc == PRANI_VOC_SCREECH) { return PR_V_1_5; }
    if (voc == PRANI_VOC_CHIRP) { return PR_V_1_5; }
    if (voc == PRANI_VOC_HISS) { return PR_V_2_0; }
    if (voc == PRANI_VOC_TRILL) { return PR_V_0_5; }
    return 0;
}

# ---- apply_am_pattern -------------------------------------------------------

# apply_am_pattern(samples, voc, sample_rate) -- vocalization-specific AM.
# Bird trills get 20 Hz sinusoidal AM modulating between 0.3 and 1.0
# (0.65 + 0.35*sin). No-op for other vocalizations. Mutates in place.
# Returns 0, or PRANI_ERR_INVALID_TRACT for an unusable sample rate: the AM
# clock is t = i/sample_rate, so a 0 or non-finite rate makes every modulator
# sin(inf) = NaN and NaNs the whole buffer. Unreachable from the internal call
# site, which validates sample_rate at the top of vocalize (2.0.5).
fn crvoice_apply_am_pattern(samples, voc, sample_rate) {
    if (voc != PRANI_VOC_TRILL) { return 0; }
    if (prani_is_positive(sample_rate) == 0) { return PRANI_ERR_INVALID_TRACT; }
    var am_rate = PR_V_20_0;
    var n = vec_len(samples);
    var i = 0;
    while (i < n) {
        var t = f64_div(f64_from(i), sample_rate);
        var modulator = f64_add(PR_V_0_65,
          f64_mul(PR_V_0_35, f64_sin(f64_mul(f64_mul(F64_TAU, am_rate), t))));
        vec_set(samples, i, f64_mul(vec_get(samples, i), modulator));
        i = i + 1;
    }
    return 0;
}

# ---- apply_vocalization_envelope --------------------------------------------

# apply_vocalization_envelope(samples, voc, sample_rate) -- per-vocalization
# attack/release amplitude ramps (ease_in_out_smooth). sample_rate unused (kept
# for signature parity). Mutates in place.
#inline
fn crvoice_apply_vocalization_envelope(samples, voc, sample_rate) {
    var len = vec_len(samples);
    if (len == 0) { return 0; }

    # (attack_frac, release_frac) per vocalization type.
    var attack_frac = PR_V_0_1;
    var release_frac = PR_V_0_1;
    if (voc == PRANI_VOC_BARK) {
        attack_frac = PR_V_0_05;  release_frac = PR_V_0_1;
    } elif (voc == PRANI_VOC_YELP) {
        attack_frac = PR_V_0_05;  release_frac = PR_V_0_1;
    } elif (voc == PRANI_VOC_CHIRP) {
        attack_frac = PR_V_0_05;  release_frac = PR_V_0_1;
    } elif (voc == PRANI_VOC_HOWL) {
        attack_frac = PR_V_0_15;  release_frac = PR_V_0_3;
    } elif (voc == PRANI_VOC_GROWL) {
        attack_frac = PR_V_0_1;   release_frac = PR_V_0_1;
    } elif (voc == PRANI_VOC_RUMBLE) {
        attack_frac = PR_V_0_1;   release_frac = PR_V_0_1;
    } elif (voc == PRANI_VOC_PURR) {
        attack_frac = PR_V_0_1;   release_frac = PR_V_0_1;
    } elif (voc == PRANI_VOC_ROAR) {
        attack_frac = PR_V_0_08;  release_frac = PR_V_0_2;
    } elif (voc == PRANI_VOC_HISS) {
        attack_frac = PR_V_0_2;   release_frac = PR_V_0_3;
    } elif (voc == PRANI_VOC_TRILL) {
        attack_frac = PR_V_0_05;  release_frac = PR_V_0_05;
    } elif (voc == PRANI_VOC_STRIDULATE) {
        attack_frac = PR_V_0_05;  release_frac = PR_V_0_05;
    } elif (voc == PRANI_VOC_BUZZ) {
        attack_frac = PR_V_0_05;  release_frac = PR_V_0_05;
    } elif (voc == PRANI_VOC_WHINE) {
        attack_frac = PR_V_0_1;   release_frac = PR_V_0_2;
    } elif (voc == PRANI_VOC_SCREECH) {
        attack_frac = PR_V_0_03;  release_frac = PR_V_0_15;
    }

    # attack_len = (len as f32 * attack_frac) as usize; same for release.
    var attack_len = f64_to(f64_mul(f64_from(len), attack_frac));
    var release_len = f64_to(f64_mul(f64_from(len), release_frac));

    # attack ramp over take(min(attack_len, len))
    var a_lim = attack_len;
    if (len < a_lim) { a_lim = len; }
    var a_denom = attack_len;
    if (a_denom < 1) { a_denom = 1; }   # attack_len.max(1)
    var i = 0;
    while (i < a_lim) {
        var t = f64_div(f64_from(i), f64_from(a_denom));
        vec_set(samples, i, f64_mul(vec_get(samples, i), ease_in_out_smooth(t)));
        i = i + 1;
    }

    # release ramp: idx = len-1-i for i in 0..min(release_len, len)
    var r_lim = release_len;
    if (len < r_lim) { r_lim = len; }
    var r_denom = release_len;
    if (r_denom < 1) { r_denom = 1; }   # release_len.max(1)
    var j = 0;
    while (j < r_lim) {
        var idx = len - 1 - j;
        var tr = f64_div(f64_from(j), f64_from(r_denom));
        vec_set(samples, idx, f64_mul(vec_get(samples, idx), ease_in_out_smooth(tr)));
        j = j + 1;
    }
    return 0;
}

# ---- synthesize_cat_purr ----------------------------------------------------

# synthesize_cat_purr(self, sample_rate, num_samples, modifiers) -- special
# 25-30 Hz laryngeal-muscle-cycling purr path. purr_f0 = clamp(27/size_scale,
# 20, 35). Amplitude = amplitude_scale * effort_amp; then the purr envelope.
# Returns a vec ptr on success, or a NEGATIVE PRANI_ERR_*: crtract_new may
# reject the sample rate, and since 2.0.5 crtract_synthesize_purr is fallible
# too (it guards purr_f0 and num_samples). Both returns are checked below.
#
# 2.0.5 guards. This is a public entry point in its own right, not only the
# PURR arm of vocalize_with_intent, so it re-checks what that path checks:
#   sample_rate  finite, > 0   the purr envelope and crtract_new both need it.
#   num_samples  >= 0          a count, and 0 is VALID (empty buffer); a negative
#                              one is the f64_to-overflow sentinel, not a length.
#   size_scale   finite, > 0   it DIVIDES 27.0 to get purr_f0, and
#                              f64_clamp(NaN, 20, 35) is NaN -- NaN passes every
#                              clamp, so the rails below do not catch it.
fn crvoice_synthesize_cat_purr(self, sample_rate, num_samples, modifiers) {
    if (prani_is_positive(sample_rate) == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (num_samples < 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    if (prani_is_positive(CreatureVoice_size_scale(self)) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    var tract = crtract_new(CreatureVoice_params(self), sample_rate);
    if (prani_is_err(tract) == 1) { return tract; }
    # purr f0 25-30 Hz, size-scaled; larger cat = slightly lower purr.
    var purr_f0 = f64_clamp(f64_div(f64_from(27), CreatureVoice_size_scale(self)),
      f64_from(20), f64_from(35));
    var samples = crtract_synthesize_purr(tract, num_samples, purr_f0);
    # 2.0.5 made this fallible. The guards above make its arguments valid TODAY,
    # but "the caller already proved it" is precisely the assumption ADR-0001
    # was written about -- vec_len() on a negative code dereferences garbage.
    # Propagate instead of trusting a proof that lives in another function.
    if (prani_is_err(samples) == 1) { return samples; }
    # amplitude scaling from intent x vocal effort
    var effort_amp = f64_add(PR_V_0_3, f64_mul(CreatureVoice_vocal_effort(self), PR_V_1_2));
    var amp = f64_mul(IntentModifiers_amplitude_scale(modifiers), effort_amp);
    var n = vec_len(samples);
    var i = 0;
    while (i < n) {
        vec_set(samples, i, f64_mul(vec_get(samples, i), amp));
        i = i + 1;
    }
    # purr envelope: gentle fade-in/fade-out
    var e_penv = crvoice_apply_vocalization_envelope(samples, PRANI_VOC_PURR, sample_rate);
    if (prani_is_err(e_penv) == 1) { return e_penv; }
    return samples;
}

# ---- vocalize / vocalize_with_intent ----------------------------------------

# vocalize(self, voc, sample_rate, duration) -- synthesize with Idle intent.
# Returns a vec ptr on success or a negative PRANI_ERR_* on failure -- including
# the 2.0.5 input-range rejections, which live in vocalize_with_intent so this
# forwarding entry point inherits exactly one copy of them.
fn crvoice_vocalize(self, voc, sample_rate, duration) {
    return crvoice_vocalize_with_intent(self, voc, PRANI_INTENT_IDLE, sample_rate, duration);
}

# vocalize_with_intent(self, voc, intent, sample_rate, duration) -- the big
# orchestration. Validates the species can produce the vocalization, applies
# intent + vocal-effort modulations, runs the per-block tract synthesis loop,
# then the post-processing effect chain (subharmonics/chaos, fire-breath,
# biphonation, nasal anti-formant, AM, spectral tilt, amplitude, envelope).
# Returns a vec ptr on success or a negative PRANI_ERR_* on failure.
#
# 2.0.5 -- this is where the module's input ranges are enforced (see the RANGES
# block at the top of the file). crvoice_vocalize forwards here, so both public
# synthesis entry points are covered by one copy of the guards.
fn crvoice_vocalize_with_intent(self, voc, intent, sample_rate, duration) {
    var species = CreatureVoice_species(self);
    var params = CreatureVoice_params(self);

    # ---- input-range guards ------------------------------------------------
    # Tags first: the oracle's Vocalization / CallIntent were enums, so an
    # out-of-range value was UNREPRESENTABLE. The port carries them as i64, and
    # the tables below all end in a fallthrough arm -- voc = 99 rendered a FLAT
    # contour and a default envelope and returned it as a success (measured).
    # Rejecting is a DELIBERATE DIVERGENCE forced by the enum -> int erasure.
    if (voc < 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    if (voc >= PRANI_VOC_COUNT) { return PRANI_ERR_INVALID_VOCALIZATION; }
    if (intent < 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    if (intent >= PRANI_INTENT_COUNT) { return PRANI_ERR_INVALID_VOCALIZATION; }
    # SPECIES is the same erasure and was missed in 2.0.5 -- found by 2.0.6's
    # error_handling example. species_params falls through to the FANTASY
    # defaults for any unknown tag (src/species.cyr, "preserves totality since
    # the Rust enum is #[non_exhaustive]"), so crvoice_new(99) returned a voice
    # and this function rendered 2205 samples for it as a success (measured).
    # crvoice_new cannot report it -- it returns a pointer with no error channel
    # -- so the guard belongs here, at the point of use, exactly as ADR-0006
    # describes for the builders.
    var species_tag = CreatureVoice_species(self);
    if (species_tag < 0) { return PRANI_ERR_INVALID_SPECIES; }
    if (species_tag >= PRANI_SP_COUNT) { return PRANI_ERR_INVALID_SPECIES; }
    # sample_rate: finite and > 0 only -- NOT a threshold. svara owns the
    # "too low to build a tract" rule and prani must not restate it (ADR-0001).
    if (prani_is_positive(sample_rate) == 0) { return PRANI_ERR_INVALID_TRACT; }
    # duration: 0 is VALID (the oracle's test_zero_duration_synthesis wants an
    # empty buffer, not an error); negative and non-finite are not.
    if (prani_is_non_negative(duration) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    # POINT-OF-USE guard for the builders (see the RANGES block): with_size /
    # with_f0_offset / with_breathiness / with_jitter / with_shimmer clamp, and
    # a clamp passes NaN straight through. params_in_range catches a smuggled
    # breathiness/jitter/shimmer; the two derived values catch a smuggled
    # size_scale or f0_offset, which is where they reach svara.
    if (crvoice_params_in_range(params) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    var eff_f0 = crvoice_effective_f0(self);
    var eff_tract_scale = crvoice_effective_tract_scale(self);
    if (prani_finite2(eff_f0, eff_tract_scale) == 0) { return PRANI_ERR_INVALID_TRACT; }

    # validate the species can produce this vocalization
    if (species_supports_vocalization(species, voc) == 0) {
        return PRANI_ERR_INVALID_VOCALIZATION;
    }

    var modifiers = prani_intent_modifiers(intent);
    var f0 = f64_mul(eff_f0, IntentModifiers_pitch_scale(modifiers));
    var effective_duration = f64_mul(duration, IntentModifiers_duration_scale(modifiers));
    # num_samples = (effective_duration * sample_rate) as usize
    var num_samples = f64_to(f64_mul(effective_duration, sample_rate));
    # A finite duration can still overflow the product (1e300 s at 44100 Hz), and
    # f64_to of anything outside i64 is i64::MIN. A negative bound does not crash
    # -- the render loop simply never runs and an EMPTY buffer comes back as a
    # success, which is audit finding F11's whole shape. Report it instead.
    if (num_samples < 0) { return PRANI_ERR_INVALID_VOCALIZATION; }

    # vocal effort modulations
    var effort = CreatureVoice_vocal_effort(self);
    var effort_amp = f64_add(PR_V_0_3, f64_mul(effort, PR_V_1_2));
    var effort_tilt_offset = f64_mul(f64_sub(effort, PR_V_0_5), PR_V_6_0);        # -3..+3
    var effort_breathiness_delta = f64_mul(f64_abs(f64_sub(effort, PR_V_0_5)), PR_V_0_3);

    # Ports voice.rs `trace!(... "synthesizing creature vocalization")` → sakshi.
    prani_log_debug("prani: synthesizing creature vocalization");

    # cat purr special path (25-30 Hz laryngeal muscle cycling)
    if (voc == PRANI_VOC_PURR) {
        if (species == PRANI_SP_CAT) {
            return crvoice_synthesize_cat_purr(self, sample_rate, num_samples, modifiers);
        }
    }

    # working copy of params with effort-adjusted breathiness (do NOT mutate the
    # voice's own params -- Rust cloned; here we allocate a fresh copy).
    var effort_params = crvoice_clone_params(params);
    SpeciesParams_set_breathiness(effort_params,
      f64_clamp(f64_add(SpeciesParams_breathiness(effort_params), effort_breathiness_delta), 0, F64_ONE));

    var tract = crtract_new(effort_params, sample_rate);
    if (prani_is_err(tract) == 1) { return tract; }

    # formant transition contour (0 == None)
    var formant_contour = crvoice_formant_transition_contour(voc, species);

    # vocalization-specific pitch contour
    var contour = crvoice_pitch_contour(voc, f0);
    # block_size = (sample_rate * 0.02) as usize -- 20ms blocks.
    # DIVERGENCE (ADR-0001): floored at 1. The oracle
    # (2.0.3:rust-old/src/voice.rs:227-231) computes
    # `(sample_rate * 0.02) as usize`, which is 0 for any sample_rate < 50, and
    # then loops `rendered += block_size.min(num_samples - rendered)` -- an
    # increment of 0, so the loop never terminates. Reproduced: sample_rate=10,
    # duration=1.0 gives num_samples=10, block_size=0, and the call hangs while
    # allocating a SynthesisOptions per iteration.
    var block_size = f64_to(f64_mul(sample_rate, PR_V_0_02));
    if (block_size < 1) { block_size = 1; }
    var samples = vec_new();

    # syringeal source-filter coupling precomputes (species F1..F3 / B1..B3)
    var is_syringeal = 0;
    if (SpeciesParams_apparatus(params) == PRANI_APP_SYRINGEAL) { is_syringeal = 1; }
    var sf0 = SpeciesParams_formant0(params);
    var sf1 = SpeciesParams_formant1(params);
    var sf2 = SpeciesParams_formant2(params);
    var sb0 = SpeciesParams_bandwidth0(params);
    var sb1 = SpeciesParams_bandwidth1(params);
    var sb2 = SpeciesParams_bandwidth2(params);

    var num_samples_max = num_samples;
    if (num_samples_max < 1) { num_samples_max = 1; }   # num_samples.max(1)

    # one reusable SynthesisOptions for the whole block loop (see below)
    var options = crtract_options_default();

    var rendered = 0;
    while (rendered < num_samples) {
        var remaining = num_samples - rendered;
        var block_len = block_size;
        if (remaining < block_len) { block_len = remaining; }   # block_size.min(remaining)
        var t = f64_div(f64_from(rendered), f64_from(num_samples_max));
        var block_f0 = crvoice_pitch_contour_f0_at(contour, t);

        # formant transition if this vocalization has one
        if (formant_contour != 0) {
            var fb = crvoice_formant_transition_at(formant_contour, t);
            var tf = vec_new();
            vec_push(tf, FormantBlend_f0(fb));
            vec_push(tf, FormantBlend_f1(fb));
            vec_push(tf, FormantBlend_f2(fb));
            var tb = vec_new();
            vec_push(tb, FormantBlend_b0(fb));
            vec_push(tb, FormantBlend_b1(fb));
            vec_push(tb, FormantBlend_b2(fb));
            crtract_set_formant_blend(tract, tf, tb, FormantBlend_blend(fb));
        }

        # syringeal source-filter coupling: nudge F1 toward block_f0 (40%).
        if (is_syringeal == 1) {
            var coupled_f1 = f64_add(sf0, f64_mul(f64_sub(block_f0, sf0), PR_V_0_4));
            var ctf = vec_new();
            vec_push(ctf, coupled_f1);
            vec_push(ctf, sf1);
            vec_push(ctf, sf2);
            var ctb = vec_new();
            vec_push(ctb, sb0);
            vec_push(ctb, sb1);
            vec_push(ctb, sb2);
            crtract_set_formant_blend(tract, ctf, ctb, F64_ONE);
        }

        # non-stationary perturbation: jitter/shimmer boost at boundaries + urgency
        var boundary_boost = F64_ONE;
        if (f64_lt(t, PR_V_0_1) == 1) {
            # 1 + (1 - t/0.1) * 0.5
            boundary_boost = f64_add(F64_ONE,
              f64_mul(f64_sub(F64_ONE, f64_div(t, PR_V_0_1)), PR_V_0_5));
        } elif (f64_gt(t, PR_V_0_85) == 1) {
            # 1 + (t - 0.85)/0.15 * 0.5
            boundary_boost = f64_add(F64_ONE,
              f64_mul(f64_div(f64_sub(t, PR_V_0_85), PR_V_0_15), PR_V_0_5));
        }
        var perturbation_scale = f64_add(boundary_boost, IntentModifiers_urgency(modifiers));

        # `options` is allocated ONCE above the loop and re-armed per block.
        # It used to be crtract_options_new(...) per iteration -- one permanently
        # retained SynthesisOptions per 20 ms of audio under a bump allocator
        # that never frees (50/second, 2,500 for a 50-second call). Nothing reads
        # it after crtract_synthesize returns, so reuse is safe.
        SynthesisOptions_set_subharmonic_amp(options, 0);
        SynthesisOptions_set_perturbation_scale(options, perturbation_scale);
        var block = crtract_synthesize(tract, block_f0, block_len, options);
        if (prani_is_err(block) == 1) { return block; }
        prani_vec_extend(samples, block);   # samples.extend_from_slice(&block)
        rendered = rendered + block_len;
    }

    # ---- post-processing effect chain (order matters) -----------------------
    var total = vec_len(samples);

    # 1. subharmonics + deterministic chaos (Lion / Dragon / Crocodilian).
    if (crvoice_species_has_subharmonics(species) == 1) {
        var sub_f0 = f64_mul(f0, PR_V_0_5);
        var chaos_rng = prani_rng_new(species_params_resonance_seed(params) + 0xCA05);
        var i = 0;
        while (i < total) {
            var t_norm = f64_div(f64_from(i), f64_from(num_samples_max));
            var t_sec = f64_div(f64_from(i), sample_rate);
            # subharmonic envelope: peaks 0.3-0.7 of the call
            var sub_env = F64_ONE;
            if (f64_lt(t_norm, PR_V_0_15) == 1) {
                sub_env = f64_div(t_norm, PR_V_0_15);
            } elif (f64_gt(t_norm, PR_V_0_8) == 1) {
                sub_env = f64_div(f64_sub(F64_ONE, t_norm), PR_V_0_2);
            }
            var sub_amp = f64_mul(PR_V_0_4, sub_env);
            var s = f64_add(vec_get(samples, i),
              f64_mul(f64_sin(f64_mul(f64_mul(F64_TAU, sub_f0), t_sec)), sub_amp));
            # deterministic chaos during peak (sub_env > 0.6)
            if (f64_gt(sub_env, PR_V_0_6) == 1) {
                var chaos_intensity = f64_div(f64_sub(sub_env, PR_V_0_6), PR_V_0_4);
                var chaos_noise = f64_mul(f64_mul(prani_rng_next_f32(chaos_rng), PR_V_0_15), chaos_intensity);
                s = f64_add(s, chaos_noise);
            }
            vec_set(samples, i, s);
            i = i + 1;
        }
    }

    # 2. dragon fire-breath: broadband turbulent noise mixed in.
    if (species == PRANI_SP_DRAGON) {
        var fire_rng = prani_rng_new(species_params_resonance_seed(params) + 0xF12E);
        var fire_amp = f64_mul(SpeciesParams_breathiness(params), PR_V_0_4);
        var i2 = 0;
        while (i2 < total) {
            var tf2 = f64_div(f64_from(i2), f64_from(num_samples_max));
            var fire_env = F64_ONE;
            if (f64_lt(tf2, PR_V_0_2) == 1) {
                fire_env = f64_div(tf2, PR_V_0_2);
            } elif (f64_gt(tf2, PR_V_0_8) == 1) {
                fire_env = f64_div(f64_sub(F64_ONE, tf2), PR_V_0_2);
            }
            var noise = prani_rng_next_f32(fire_rng);
            vec_set(samples, i2,
              f64_add(vec_get(samples, i2), f64_mul(f64_mul(noise, fire_amp), fire_env)));
            i2 = i2 + 1;
        }
    }

    # 3. biphonation for canids (Wolf/Dog Howl/Whine): second independent pitch.
    if (crvoice_species_is_canid(species) == 1) {
        if (crvoice_voc_is_howl_or_whine(voc) == 1) {
            var bipho_f0 = f64_mul(f0, PR_V_1_78);   # ~minor seventh
            var bipho_amp = PR_V_0_15;
            var i3 = 0;
            while (i3 < total) {
                var t_sec3 = f64_div(f64_from(i3), sample_rate);
                var t_norm3 = f64_div(f64_from(i3), f64_from(num_samples_max));
                # biphonation appears in the middle: t_norm in [0.3, 0.8]
                var bipho_env = 0;
                if (f64_ge(t_norm3, PR_V_0_3) == 1) {
                    if (f64_le(t_norm3, PR_V_0_8) == 1) {
                        var mid = f64_div(f64_sub(t_norm3, PR_V_0_3), PR_V_0_5);
                        if (f64_lt(mid, PR_V_0_3) == 1) {
                            bipho_env = f64_div(mid, PR_V_0_3);
                        } elif (f64_gt(mid, PR_V_0_7) == 1) {
                            bipho_env = f64_div(f64_sub(F64_ONE, mid), PR_V_0_3);
                        } else {
                            bipho_env = F64_ONE;
                        }
                    }
                }
                vec_set(samples, i3, f64_add(vec_get(samples, i3),
                    f64_mul(f64_mul(f64_sin(f64_mul(f64_mul(F64_TAU, bipho_f0), t_sec3)), bipho_amp), bipho_env)));
                i3 = i3 + 1;
            }
        }
    }

    # 2.0.5: steps 4-8 became fallible. Their returns used to be DISCARDED, so a
    # rejected argument left the buffer silently un-post-processed and returned it
    # as a success -- the "silently wrong audio" this milestone exists to remove.
    # Their arguments are derived from already-validated voice params, so none can
    # fail today; propagate anyway rather than depending on a proof that lives
    # somewhere else (ADR-0001's lesson).
    # 4. nasal anti-formant (spectral notch) during nasal phases (>= 0 sentinel).
    var nasal_phase = crvoice_nasal_phase_fraction(voc, species);
    if (f64_ge(nasal_phase, 0) == 1) {
        var e_nasal = crvoice_apply_nasal_antiformant(samples, sample_rate, nasal_phase);
        if (prani_is_err(e_nasal) == 1) { return e_nasal; }
    }

    # 5. vocalization-specific AM patterns (bird trills).
    var e_am = crvoice_apply_am_pattern(samples, voc, sample_rate);
    if (prani_is_err(e_am) == 1) { return e_am; }

    # 6. spectral tilt: species base + vocalization + vocal effort.
    var vocalization_tilt = crvoice_vocalization_spectral_offset(voc);
    var total_tilt = f64_add(f64_add(SpeciesParams_spectral_tilt(params), vocalization_tilt), effort_tilt_offset);
    var e_tilt = crtract_apply_spectral_tilt(samples, total_tilt, sample_rate);
    if (prani_is_err(e_tilt) == 1) { return e_tilt; }

    # 7. amplitude scaling from intent x vocal effort.
    var amp = f64_mul(IntentModifiers_amplitude_scale(modifiers), effort_amp);
    var ai = 0;
    while (ai < total) {
        vec_set(samples, ai, f64_mul(vec_get(samples, ai), amp));
        ai = ai + 1;
    }

    # 8. amplitude envelope based on vocalization shape.
    var e_env = crvoice_apply_vocalization_envelope(samples, voc, sample_rate);
    if (prani_is_err(e_env) == 1) { return e_env; }

    return samples;
}

# ---- small predicate helpers (matches! arms) --------------------------------

# species produces subharmonics (Lion / Dragon / Crocodilian).
#must_use
fn crvoice_species_has_subharmonics(species) {
    if (species == PRANI_SP_LION) { return 1; }
    if (species == PRANI_SP_DRAGON) { return 1; }
    if (species == PRANI_SP_CROCODILIAN) { return 1; }
    return 0;
}

# canid species (Wolf / Dog).
#must_use
fn crvoice_species_is_canid(species) {
    if (species == PRANI_SP_WOLF) { return 1; }
    if (species == PRANI_SP_DOG) { return 1; }
    return 0;
}

# vocalization is Howl or Whine.
#must_use
fn crvoice_voc_is_howl_or_whine(voc) {
    if (voc == PRANI_VOC_HOWL) { return 1; }
    if (voc == PRANI_VOC_WHINE) { return 1; }
    return 0;
}

# --- preset.cyr ---

# preset.cyr -- named voice presets: specific individuals within a species.
# Ports 2.0.3:rust-old/src/preset.rs. A VoicePreset is a ready-made
# CreatureVoice configuration for a recognizable individual character (e.g. a
# large alpha wolf vs. a small pup). preset_build() turns a preset into a
# CreatureVoice via the crvoice_* builder chain (new -> with_size ->
# with_f0_offset -> with_breathiness), matching the oracle's builder order
# exactly.
#
# Requires (from the build/test unit, in dependency order): stdlib alloc/vec,
# error.cyr, rng.cyr, dsp.cyr, vocalization.cyr, sequence.cyr, species.cyr,
# bridge.cyr, tract.cyr, voice.cyr (svara/naad/hisab dep bundles first). Module
# files carry no `include` lines -- the entry orders them.
#
# NAMING (flat-namespace prefix): struct VoicePreset, every top-level fn is
# `preset_`-prefixed. The 11 Rust `const` presets become zero-arg constructor
# fns (Cyrius has no compile-time struct consts), each allocating and filling a
# fresh VoicePreset with the oracle's verbatim field values.
#
# FLOATS: prani's Rust was f32; this port is f64 (svara/naad/hisab are f64-only,
# widening is forced). Integer literals via f64_from(n) (negatives via
# f64_neg(f64_from(n))); non-integer literals via the module-top IEEE-754 hex
# constants below (decimals in comments), one constant per distinct value.
#
# NAME FIELD: Rust's `name: Cow<'static, str>` is a display string, RESTORED as
# a cstring stored in the `name` field (e.g. "Alpha Wolf"). preset_build ignores
# it (matching the oracle). serde RESTORED — see preset_to_json below.
#
# RANGES (2.0.5): preset_from_json_str is the only entry point in this module
# that can report a failure, and it validates every field of an untrusted
# document — see its comment for the range per field and why that range. The 11
# built-ins are trusted input and sit inside every range; the codec is not
# trusted. preset_make / preset_build hand back a struct with no error channel
# and are deliberately left unguarded (roadmap 2.1.0's constructor contract).

# ================================================================
# Non-integer literal constants (IEEE-754 hex; decimals in comments).
# One constant per distinct preset field value.
# ================================================================
# size values (non-integer)
var PR_P_1_4  = 0x3ff6666666666666;   # 1.4  Alpha Wolf size
var PR_P_0_4  = 0x3fd999999999999a;   # 0.4  Wolf Pup / Kitten size
var PR_P_1_3  = 0x3ff4cccccccccccd;   # 1.3  Male Lion / Raven size
var PR_P_0_8  = 0x3fe999999999999a;   # 0.8  Young Dragon size
var PR_P_1_2  = 0x3ff3333333333333;   # 1.2  Bald Eagle size
var PR_P_1_5  = 0x3ff8000000000000;   # 1.5  American Alligator size

# breathiness values (non-integer)
var PR_P_0_03 = 0x3f9eb851eb851eb8;   # 0.03  Alpha Wolf breathiness
var PR_P_0_12 = 0x3fbeb851eb851eb8;   # 0.12  Wolf Pup / Male Lion breathiness
var PR_P_0_08 = 0x3fb47ae147ae147b;   # 0.08  House Cat breathiness
var PR_P_0_15 = 0x3fc3333333333333;   # 0.15  Kitten / Young Dragon breathiness
var PR_P_0_25 = 0x3fd0000000000000;   # 0.25  Ancient Dragon breathiness
var PR_P_0_1  = 0x3fb999999999999a;   # 0.1   Bald Eagle breathiness; size floor
var PR_P_0_2  = 0x3fc999999999999a;   # 0.2   Raven breathiness
var PR_P_0_18 = 0x3fc70a3d70a3d70a;   # 0.18  American Alligator breathiness

# ================================================================
# VoicePreset -- a named creature voice preset.
#   name        : display name cstring (e.g. "Alpha Wolf")
#   species     : PRANI_SP_* constant
#   size        : size scale
#   f0_offset   : f0 offset from species default (Hz)
#   breathiness : breathiness override
# serde RESTORED via preset_to_json / preset_from_json_str (name + scalars).
# ================================================================
#derive(accessors)
struct VoicePreset {
    name; species; size; f0_offset; breathiness;
}

# Internal builder -- fills every field in declaration order. `name` is the
# display string (a cstring literal), restoring the Rust `name: Cow<str>` field.
#
# DELIBERATELY UNVALIDATED (2.0.5): this returns a VoicePreset with no error
# channel, exactly like the crvoice_with_* builders it feeds, so a guard here
# would have to invent one -- the constructor-contract change is roadmap 2.1.0.
# The two ways a caller's number becomes a preset are ranged instead where an
# error CAN be reported: preset_from_json_str above validates every field of an
# untrusted document, and a NaN handed straight to preset_make survives into
# preset_build (see there).
#must_use
fn preset_make(name, species, size, f0_offset, breathiness) {
    var self = alloc(sizeof(VoicePreset));
    VoicePreset_set_name(self, name);
    VoicePreset_set_species(self, species);
    VoicePreset_set_size(self, size);
    VoicePreset_set_f0_offset(self, f0_offset);
    VoicePreset_set_breathiness(self, breathiness);
    return self;
}

# VoicePreset serde -- restores the Rust `#[derive(Serialize, Deserialize)]`.
# Built manually with str_builder (proven path) and read with bayan's parser
# (the garjan voice_pool pattern). The f64 fields (size/f0_offset/breathiness)
# are emitted as their exact i64 BIT PATTERNS (str_builder_add_int) so they
# roundtrip LOSSLESS — the derive/value-tree float writers are 6-digit lossy.
# `name` is a plain display string with no JSON-special characters, so it is
# emitted between literal quotes. Roundtrip is idempotent (fixed key order).
fn preset_to_json(self, sb) {
    str_builder_add_cstr(sb, "{\"name\":\"");
    str_builder_add_cstr(sb, VoicePreset_name(self));
    str_builder_add_cstr(sb, "\",\"species\":");
    str_builder_add_int(sb, VoicePreset_species(self));
    str_builder_add_cstr(sb, ",\"size\":");
    str_builder_add_int(sb, VoicePreset_size(self));
    str_builder_add_cstr(sb, ",\"f0_offset\":");
    str_builder_add_int(sb, VoicePreset_f0_offset(self));
    str_builder_add_cstr(sb, ",\"breathiness\":");
    str_builder_add_int(sb, VoicePreset_breathiness(self));
    str_builder_add_cstr(sb, "}");
    return 0;
}

# from_json_str(json) -- rebuild a VoicePreset from preset_to_json output.
# `json` is a NUL-terminated cstring; the display `name` is restored as a real
# string and the f64 fields as exact i64 bit patterns.
#
# Returns the VoicePreset ptr, or a NEGATIVE PRANI_ERR_INVALID_SPECIES if the
# document is not a valid preset. ONE code for the whole codec, matching
# ADR-0002's table: a VoicePreset *is* a voice configuration, so every rejection
# says the same thing -- "this is not a species/voice config prani can build".
#
# WHAT IS REJECTED (2.0.5 -- the field-level half ADR-0002 left open):
#   json == 0, or the document does not parse                        (2.0.3)
#   `name` missing or not a JSON string. This was a LIVE SIGSEGV, not a range
#     question: bayan_json_v_obj_get returns 0 for a missing key and
#     bayan_json_v_str returns 0 for a non-string node, and str_data(0) then
#     dereferences address 0 (measured 2026-08-31: `{"species":0,...}` with no
#     "name" key exits 139). An array root reaches it the same way.
#   any of the four scalars missing or not a JSON integer. A missing key and a
#     wrong-typed key are one rejection -- obj_get gives 0 and is_int(0) is 0.
#     The oracle required every field too: no `#[serde(default)]` anywhere on
#     VoicePreset, so serde failed on a missing field. Reading the scalars with
#     bayan_json_v_int alone could not tell an absent field from a present 0,
#     and 0 is a legal bit pattern (+0.0) for f0_offset and breathiness.
#   `species` outside [0, PRANI_SP_COUNT). species_params falls THROUGH to the
#     Fantasy row for an unknown discriminant, so an unnamed species would come
#     back as a plausible creature instead of an error.
#   `size` outside [0.1, 10.0]         -- crvoice_with_size's clamp domain
#   `f0_offset` outside +/-(f0_max - f0_min) FOR THIS SPECIES
#                                      -- crvoice_with_f0_offset's clamp domain
#   `breathiness` outside [0.0, 1.0]   -- crvoice_with_breathiness's clamp domain
#
# Each numeric range is exactly the domain the builder that consumes the field
# PRESERVES, so an accepted document reaches the voice unchanged. Outside it,
# preset_build would silently substitute the clamp bound (ADR-0001: never
# fabricate a plausible answer) -- and a NaN would pass the clamp untouched
# (audit F11) into svara. The 11 built-in presets all sit inside these ranges,
# so prani's own preset_to_json output always roundtrips (asserted per-preset in
# tests/preset.tcyr); only documents prani did not write can be rejected.
fn preset_from_json_str(json) {
    if (json == 0) { return PRANI_ERR_INVALID_SPECIES; }
    var root = bayan_json_v_parse_buf(json, strlen(json));
    if (root == 0) { return PRANI_ERR_INVALID_SPECIES; }
    var name = bayan_json_v_str(bayan_json_v_obj_get(root, "name"));
    if (name == 0) { return PRANI_ERR_INVALID_SPECIES; }
    var n_species = bayan_json_v_obj_get(root, "species");
    var n_size = bayan_json_v_obj_get(root, "size");
    var n_f0 = bayan_json_v_obj_get(root, "f0_offset");
    var n_br = bayan_json_v_obj_get(root, "breathiness");
    if (bayan_json_v_is_int(n_species) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    if (bayan_json_v_is_int(n_size) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    if (bayan_json_v_is_int(n_f0) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    if (bayan_json_v_is_int(n_br) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    var species = bayan_json_v_int(n_species);
    if (species < 0) { return PRANI_ERR_INVALID_SPECIES; }
    if (species >= PRANI_SP_COUNT) { return PRANI_ERR_INVALID_SPECIES; }
    var size = bayan_json_v_int(n_size);
    if (prani_in_range(size, PR_P_0_1, f64_from(10)) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    # f0_offset's bound is species-dependent because with_f0_offset's clamp is.
    var params = species_params(species);
    var f0_span = f64_sub(SpeciesParams_f0_max(params), SpeciesParams_f0_min(params));
    var f0_offset = bayan_json_v_int(n_f0);
    if (prani_in_range(f0_offset, f64_neg(f0_span), f0_span) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    var breathiness = bayan_json_v_int(n_br);
    if (prani_in_range(breathiness, 0, F64_ONE) == 0) { return PRANI_ERR_INVALID_SPECIES; }
    return preset_make(str_data(name), species, size, f0_offset, breathiness);
}

# build(self) -- VoicePreset::build. Creates a CreatureVoice from this preset via
# the crvoice_* builder chain, matching the oracle order:
#   new(species).with_size(size).with_f0_offset(f0_offset).with_breathiness(br)
#
# NOT a validation point (2.0.5). It returns a CreatureVoice and nothing else --
# the same shape as the three builders it chains -- so it has no channel to
# report a bad field on, and giving it one is the 2.1.0 constructor-contract
# work, not this milestone. A preset built by preset_from_json_str cannot carry
# an out-of-range field (that codec rejects them); a preset assembled by hand
# through preset_make can, and a NaN there passes every f64_clamp in the chain
# (audit F11). It is caught at the fallible point of use downstream --
# crvoice_vocalize and the tract constructor, which return PRANI_ERR_* -- which
# covers every path to svara without changing this signature.
#must_use
fn preset_build(self) {
    return crvoice_with_breathiness(
      crvoice_with_f0_offset(
        crvoice_with_size(
          crvoice_new(VoicePreset_species(self)),
          VoicePreset_size(self)),
        VoicePreset_f0_offset(self)),
      VoicePreset_breathiness(self));
}

# ================================================================
# Built-in voice presets (Rust `const`s -> zero-arg constructor fns). Field
# values transcribed VERBATIM from the oracle static table.
# ================================================================

# Large alpha wolf -- deep, resonant howl. (Wolf, 1.4, -80.0, 0.03)
#must_use
fn preset_alpha_wolf() {
    return preset_make("Alpha Wolf", PRANI_SP_WOLF, PR_P_1_4, f64_neg(f64_from(80)), PR_P_0_03);
}

# Wolf pup -- high-pitched, breathy. (Wolf, 0.4, 200.0, 0.12)
#must_use
fn preset_wolf_pup() {
    return preset_make("Wolf Pup", PRANI_SP_WOLF, PR_P_0_4, f64_from(200), PR_P_0_12);
}

# House cat -- typical domestic cat. (Cat, 1.0, 0.0, 0.08)
#must_use
fn preset_house_cat() {
    return preset_make("House Cat", PRANI_SP_CAT, F64_ONE, 0, PR_P_0_08);
}

# Kitten -- small, high-pitched. (Cat, 0.4, 150.0, 0.15)
#must_use
fn preset_kitten() {
    return preset_make("Kitten", PRANI_SP_CAT, PR_P_0_4, f64_from(150), PR_P_0_15);
}

# Male lion -- deep, powerful roar. (Lion, 1.3, -15.0, 0.12)
#must_use
fn preset_male_lion() {
    return preset_make("Male Lion", PRANI_SP_LION, PR_P_1_3, f64_neg(f64_from(15)), PR_P_0_12);
}

# Ancient dragon -- massive, earth-shaking. (Dragon, 4.0, -30.0, 0.25)
#must_use
fn preset_ancient_dragon() {
    return preset_make("Ancient Dragon", PRANI_SP_DRAGON, f64_from(4), f64_neg(f64_from(30)), PR_P_0_25);
}

# Young dragon -- smaller, higher. (Dragon, 0.8, 50.0, 0.15)
#must_use
fn preset_young_dragon() {
    return preset_make("Young Dragon", PRANI_SP_DRAGON, PR_P_0_8, f64_from(50), PR_P_0_15);
}

# Bald eagle -- piercing screech. (Raptor, 1.2, -200.0, 0.1)
#must_use
fn preset_bald_eagle() {
    return preset_make("Bald Eagle", PRANI_SP_RAPTOR, PR_P_1_2, f64_neg(f64_from(200)), PR_P_0_1);
}

# Raven -- deep, rough croak. (Crow, 1.3, -100.0, 0.2)
#must_use
fn preset_raven() {
    return preset_make("Raven", PRANI_SP_CROW, PR_P_1_3, f64_neg(f64_from(100)), PR_P_0_2);
}

# Field cricket -- steady chirping. (Cricket, 1.0, 0.0, 0.0)
#must_use
fn preset_field_cricket() {
    return preset_make("Field Cricket", PRANI_SP_CRICKET, F64_ONE, 0, 0);
}

# American alligator -- deep bellow. (Crocodilian, 1.5, -10.0, 0.18)
#must_use
fn preset_alligator() {
    return preset_make("American Alligator", PRANI_SP_CROCODILIAN, PR_P_1_5, f64_neg(f64_from(10)), PR_P_0_18);
}

# all() -- returns a vec of all 11 built-in presets, in oracle order.
#must_use
fn preset_all() {
    var v = vec_new();
    vec_push(v, preset_alpha_wolf());
    vec_push(v, preset_wolf_pup());
    vec_push(v, preset_house_cat());
    vec_push(v, preset_kitten());
    vec_push(v, preset_male_lion());
    vec_push(v, preset_ancient_dragon());
    vec_push(v, preset_young_dragon());
    vec_push(v, preset_bald_eagle());
    vec_push(v, preset_raven());
    vec_push(v, preset_field_cricket());
    vec_push(v, preset_alligator());
    return v;
}

# --- stream.cyr ---

# stream.cyr -- pull-based streaming synthesis.
# Ports 2.0.3:rust-old/src/stream.rs. A SynthStream wraps a CreatureVoice and
# yields audio blocks on demand, avoiding the full-buffer allocation of
# crvoice_vocalize. Suitable for real-time audio callbacks where the block size
# is determined by the host (Wwise, FMOD, Godot, JACK).
#
# Requires (from the build/test unit, in dependency order): stdlib alloc/vec/
# math, hisab, goonj, naad, svara, error.cyr, rng.cyr, dsp.cyr, vocalization.cyr,
# sequence.cyr, species.cyr, bridge.cyr, tract.cyr, voice.cyr. Module files carry
# no `include` lines -- the entry orders them.
#
# NAMING (flat-namespace prefix): every top-level fn here is `stream_`-prefixed.
# The spectral-offset helper is REUSED from voice.cyr
# (crvoice_vocalization_spectral_offset) -- NOT redefined here (Rust duplicated
# it as a private fn to keep stream.rs self-contained; the flat-namespace port
# shares the single definition).
#
# FLOATS: prani's Rust was f32; this port is f64 (svara/naad/hisab are f64-only,
# widening is forced). Integer literals via f64_from(n); non-integer literals via
# the module-top IEEE-754 hex constants below (decimals in comments).
#
# RESULT convention: stream_new returns a SynthStream heap ptr (large positive)
# on success, or a NEGATIVE PRANI_ERR_* -- INVALID_VOCALIZATION when the species
# cannot produce the requested vocalization, plus the input-range codes below.
#
# INPUT RANGES (2.0.5; audit findings F10/F11). Every range is stated as
# "accepted", and anything outside it is REPORTED, never clamped -- clamping a
# value the caller did not ask for hides the caller's bug (ADR-0001).
#
#   stream_new(voice, ...)      voice must be a live handle (> 0). A negative
#                               argument is an UNCHECKED deserializer code
#                               (crvoice_from_json_str returns -3), which would
#                               otherwise be dereferenced.  -> INVALID_SPECIES
#   stream_new sample_rate      finite and > 0. NO floor of prani's own: svara
#                               owns the real threshold (~1000 Hz) and ADR-0001
#                               forbids restating it, so a 10 Hz stream still
#                               CONSTRUCTS and fails at the first fill under
#                               ADR-0003.                    -> INVALID_TRACT
#   stream_new duration         finite and >= 0 seconds. Zero is VALID -- the
#                               oracle's test_zero_duration_synthesis asserts an
#                               empty buffer, not an error. Negative is rejected
#                               (DIVERGENCE: Rust's `as usize` saturated it to 0
#                               and returned a silent empty stream).
#                                                            -> INVALID_VOCALIZATION
#   stream_new total samples    duration * duration_scale * sample_rate must land
#                               in [0, 2^53]. 2^53 is the largest count an f64
#                               holds exactly; past i64's range f64_to saturates
#                               to i64::MIN (measured), so an unguarded huge or
#                               non-finite product yielded a NEGATIVE
#                               total_samples and a stream that reported
#                               is_finished == 1 with no error. At 44.1 kHz the
#                               bound is ~6470 years of audio.
#                                                            -> INVALID_VOCALIZATION
#   stream_new voice snapshot   f0, effort_amp and spectral_tilt must be finite.
#                               f64_clamp passes NaN through (measured), so
#                               crvoice_with_size(v, NaN) / with_vocal_effort
#                               smuggle a NaN into the voice; the builders return
#                               `self` and have no error channel (roadmap 2.1.0),
#                               so the guard lands here, where the stream
#                               SNAPSHOTS them -- upstream of every svara call
#                               this module makes.            -> INVALID_SPECIES
#   stream_next_block block_size >= 0; no upper bound (it is clamped to the
#                               remaining samples, itself bounded above).
#                                                            -> INVALID_VOCALIZATION
#   stream_fill_buffer          takes no numeric parameter. A null/negative
#                               stream or buffer handle returns 0 written and
#                               does NOT retire the stream: it is a caller
#                               mistake, not a property of the stream (ADR-0003
#                               settles the same question for a zero-length
#                               buffer).
#   stream_pitch_contour_at     returns an f64, NOT a "value or negative code"
#                               (PRANI_ERR_INVALID_TRACT is -1, which is itself a
#                               NaN bit pattern), so it has no error channel. A
#                               NaN t propagates as NaN instead of fabricating an
#                               f0; the stream's own call site is guarded in
#                               stream_fill_buffer.
#
# tract field: lazily initialized. Starts as 0 (== None sentinel); the first
# stream_fill_buffer builds it via crtract_new (Option::get_or_insert_with).
#
# EQUIVALENT-RESULT SIMPLIFICATION (fill_buffer): the Rust code copies the fresh
# synthesized block into buffer[..to_render], THEN applies the spectral-tilt
# lowpass and per-sample amplitude to buffer[..to_render]. Since the tilt filter
# and amplitude scale are pointwise/sequential over exactly the same to_render
# fresh samples (buffer beyond to_render is untouched by both, and the block's
# leading to_render samples are identical to what gets copied), applying tilt+amp
# to the BLOCK vec first and then copying block[0..to_render] into
# buffer[0..to_render] yields bit-identical results. The port does the latter so
# the tilt/amp helpers operate on the whole block vec (crtract_apply_spectral_tilt
# runs over the full vec, but only the first to_render slots are copied out).
#
# PARITY: exact svara-internal bit parity vs the f32 oracle is not attainable
# (f32->f64 diverges through svara's DSP reached via crtract_synthesize). Tests
# assert structural + parity-meaningful properties (total_samples / rejection /
# fill_buffer accounting / is_finished flip / next_block sizes exact;
# finiteness for the svara-dependent output; pitch_contour_at exact where
# closed-form). SynthStream carries no serde — the Rust oracle did not derive
# Serialize on it (transient per-call synth state). Display tests dropped.

# ================================================================
# Non-integer literal constants (IEEE-754 hex; decimals in comments).
# ================================================================
var PR_ST_0_3   = 0x3fd3333333333333;   # 0.3   effort_amp base
var PR_ST_1_2   = 0x3ff3333333333333;   # 1.2   effort_amp multiplier
var PR_ST_0_5   = 0x3fe0000000000000;   # 0.5   effort_tilt center / boundary boost gain
var PR_ST_6_0   = 0x4018000000000000;   # 6.0   effort_tilt multiplier
var PR_ST_0_1   = 0x3fb999999999999a;   # 0.1   attack boundary fraction
var PR_ST_0_85  = 0x3feb333333333333;   # 0.85  release boundary fraction
var PR_ST_0_15  = 0x3fc3333333333333;   # 0.15  release boundary span
# purr f0 clamp: purr_f0 = clamp(27.0 / 1.0, 20.0, 35.0)
var PR_ST_27_0  = 0x403b000000000000;   # 27.0  purr laryngeal cycle f0
var PR_ST_20_0  = 0x4034000000000000;   # 20.0  purr clamp low
var PR_ST_35_0  = 0x4041800000000000;   # 35.0  purr clamp high
# pitch-contour table multipliers (transcribed verbatim from the oracle).
var PR_ST_0_8   = 0x3fe999999999999a;   # 0.8
var PR_ST_1_3   = 0x3ff4cccccccccccd;   # 1.3
var PR_ST_0_6   = 0x3fe3333333333333;   # 0.6
var PR_ST_0_7   = 0x3fe6666666666666;   # 0.7
var PR_ST_0_9   = 0x3feccccccccccccd;   # 0.9
var PR_ST_1_4   = 0x3ff6666666666666;   # 1.4
var PR_ST_1_6   = 0x3ff999999999999a;   # 1.6
var PR_ST_1_5   = 0x3ff8000000000000;   # 1.5
var PR_ST_0_25  = 0x3fd0000000000000;   # 0.25
var PR_ST_1_1   = 0x3ff199999999999a;   # 1.1
var PR_ST_0_75  = 0x3fe8000000000000;   # 0.75
# 2^53 == 9007199254740992: the largest sample count an f64 represents exactly,
# and the ceiling stream_new accepts for duration * duration_scale * sample_rate.
var PR_ST_MAX_SAMPLES = 0x4340000000000000;   # 9007199254740992.0 == 2^53

# ================================================================
# SynthStream -- a pull-based streaming synthesizer. Produces audio block-by-
# block without allocating the full output buffer up front.
#   voice           : CreatureVoice ptr producing this stream
#   vocalization    : PRANI_VOC_* being synthesized
#   intent          : PRANI_INTENT_* behavioral intent
#   sample_rate     : sample rate (Hz)
#   total_samples   : total samples to produce
#   samples_rendered: samples produced so far
#   tract           : CreatureTract ptr, or 0 (== None; lazily built)
#   f0              : pitch-contour base f0 (after intent modifiers)
#   amplitude_scale : intent amplitude multiplier snapshot
#   effort_amp      : vocal-effort amplitude scale
#   spectral_tilt   : combined spectral tilt (species + voc + effort)
#   is_cat_purr     : 1 if this is a cat purr (special path), else 0
# No serde: the Rust `SynthStream` did not derive Serialize (transient state).
# ================================================================
#derive(accessors)
struct SynthStream {
    voice; vocalization; intent; sample_rate; total_samples;
    samples_rendered; tract; f0; amplitude_scale; effort_amp;
    spectral_tilt; is_cat_purr;
}

# new(voice, voc, intent, sample_rate, duration) -- SynthStream::new. Does not
# allocate the full output; audio is produced incrementally via
# stream_fill_buffer / stream_next_block.
#
# Returns a SynthStream ptr on success, or a NEGATIVE PRANI_ERR_* -- see the
# module header's INPUT RANGES table for every rejection and its code.
#must_use
fn stream_new(voice, voc, intent, sample_rate, duration) {
    # A live voice handle is a heap pointer. 0 is null and a NEGATIVE argument is
    # an unchecked crvoice_from_json_str failure code (-3): both would be
    # dereferenced by crvoice_species below, which is F1's crash class.
    if (voice <= 0) { return PRANI_ERR_INVALID_SPECIES; }
    var species = crvoice_species(voice);
    # Same enum-erasure guard as crvoice_vocalize_with_intent: species_params
    # falls through to the FANTASY defaults for an unknown tag, so a voice built
    # with crvoice_new(99) streams happily. Found by 2.0.6's error_handling
    # example; crvoice_new has no error channel, so this is the point of use.
    if (species < 0) { return PRANI_ERR_INVALID_SPECIES; }
    if (species >= PRANI_SP_COUNT) { return PRANI_ERR_INVALID_SPECIES; }
    if (species_supports_vocalization(species, voc) == 0) {
        return PRANI_ERR_INVALID_VOCALIZATION;
    }
    # sample_rate: finite and > 0. Deliberately NO lower bound of prani's own --
    # svara owns the real threshold and ADR-0001 forbids duplicating it, so
    # 10 Hz still constructs here and is rejected at the first fill (ADR-0003).
    if (prani_is_positive(sample_rate) == 0) { return PRANI_ERR_INVALID_TRACT; }
    # duration: finite and >= 0. Zero is VALID (the oracle's
    # test_zero_duration_synthesis asserts an empty buffer, not an error).
    if (prani_is_non_negative(duration) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }

    var modifiers = prani_intent_modifiers(intent);
    var f0 = f64_mul(crvoice_effective_f0(voice), IntentModifiers_pitch_scale(modifiers));
    var effective_duration = f64_mul(duration, IntentModifiers_duration_scale(modifiers));
    # total_samples = (effective_duration * sample_rate) as usize -- but f64_to
    # saturates to i64::MIN for every value outside i64's range, non-finite or
    # merely huge (measured 2026-08-31), so the product is ranged BEFORE the
    # conversion. The intent's duration_scale is inside the check because it is
    # what can push an accepted duration over the edge (Mating doubles it).
    var raw_samples = f64_mul(effective_duration, sample_rate);
    if (prani_in_range(raw_samples, 0, PR_ST_MAX_SAMPLES) == 0) {
        return PRANI_ERR_INVALID_VOCALIZATION;
    }
    var total_samples = f64_to(raw_samples);

    var effort = crvoice_vocal_effort(voice);
    var effort_amp = f64_add(PR_ST_0_3, f64_mul(effort, PR_ST_1_2));
    var effort_tilt_offset = f64_mul(f64_sub(effort, PR_ST_0_5), PR_ST_6_0);
    var vocalization_tilt = crvoice_vocalization_spectral_offset(voc);
    var species_params = species_params(species);
    var spectral_tilt = f64_add(
      f64_add(SpeciesParams_spectral_tilt(species_params), vocalization_tilt),
      effort_tilt_offset);

    # F11, at the point of use: these three are SNAPSHOTS of the voice, and
    # f64_clamp(NaN, lo, hi) is NaN (measured), so every builder that clamps --
    # crvoice_with_size, crvoice_with_vocal_effort, crvoice_with_f0_offset --
    # will hand a NaN straight through. The builders return `self` and cannot
    # report it (roadmap 2.1.0's constructor contract), so it is caught here,
    # before the snapshot is stored and long before it reaches svara as a
    # contour f0, a tilt coefficient or an output gain.
    if (prani_finite3(f0, effort_amp, spectral_tilt) == 0) {
        return PRANI_ERR_INVALID_SPECIES;
    }

    var is_cat_purr = 0;
    if (voc == PRANI_VOC_PURR) {
        if (species == PRANI_SP_CAT) { is_cat_purr = 1; }
    }

    var self = alloc(sizeof(SynthStream));
    SynthStream_set_voice(self, voice);
    SynthStream_set_vocalization(self, voc);
    SynthStream_set_intent(self, intent);
    SynthStream_set_sample_rate(self, sample_rate);
    SynthStream_set_total_samples(self, total_samples);
    SynthStream_set_samples_rendered(self, 0);
    SynthStream_set_tract(self, 0);
    SynthStream_set_f0(self, f0);
    SynthStream_set_amplitude_scale(self, IntentModifiers_amplitude_scale(modifiers));
    SynthStream_set_effort_amp(self, effort_amp);
    SynthStream_set_spectral_tilt(self, spectral_tilt);
    SynthStream_set_is_cat_purr(self, is_cat_purr);
    return self;
}

# is_finished(self) -- 1 when all samples have been produced, else 0.
#must_use
fn stream_is_finished(self) {
    if (SynthStream_samples_rendered(self) >= SynthStream_total_samples(self)) { return 1; }
    return 0;
}

# total_samples(self) -- total samples the stream will produce.
#must_use
fn stream_total_samples(self) {
    return SynthStream_total_samples(self);
}

# samples_rendered(self) -- samples produced so far.
#must_use
fn stream_samples_rendered(self) {
    return SynthStream_samples_rendered(self);
}

# fill_buffer(self, buffer) -- fill the provided vec with audio samples. Returns
# the number of samples actually written (may be < vec_len at end of stream).
#
# `buffer` is a vec handle (mutated in place). See the module header's
# EQUIVALENT-RESULT SIMPLIFICATION note: tilt+amp are applied to the freshly
# synthesized BLOCK vec, then block[0..to_render] is copied into
# buffer[0..to_render] -- bit-identical to Rust's copy-then-process-buffer.
fn stream_fill_buffer(self, buffer) {
    # Handle guards. The function's only failure channel is "0 samples written",
    # so neither can be reported as a code -- but both are dereferences today (a
    # negative argument is an unchecked stream_new / crvoice_vocalize code). Per
    # ADR-0003 these do NOT retire the stream: a bad handle is a caller mistake,
    # not a property of the stream, exactly like the zero-length buffer below.
    if (self <= 0) { return 0; }
    if (buffer <= 0) { return 0; }
    if (stream_is_finished(self) == 1) { return 0; }

    var total = SynthStream_total_samples(self);
    var rendered = SynthStream_samples_rendered(self);
    var remaining = total - rendered;
    var to_render = vec_len(buffer);
    if (remaining < to_render) { to_render = remaining; }   # buffer.len().min(remaining)
    # A zero-length buffer can never advance the stream; returning early keeps a
    # caller's `while (stream_is_finished(s) == 0) { fill(s, buf); }` from
    # spinning on tract setup it will only discard.
    if (to_render <= 0) { return 0; }

    # ensure the tract is initialized (Option::get_or_insert_with)
    var tract = SynthStream_tract(self);
    if (tract == 0) {
        var params = species_params(crvoice_species(SynthStream_voice(self)));
        tract = crtract_new(params, SynthStream_sample_rate(self));
        # crtract_new returns a negative PRANI_ERR_* when svara rejects the
        # sample rate. Do NOT cache an error code as the tract -- a later call
        # would see a non-zero `tract` field and use the code as a pointer.
        # Retire the stream and report 0 written: the failure is a property of
        # the stream's own sample_rate, so it will repeat on every call, and a
        # caller draining `while (stream_is_finished(s) == 0)` has to be able to
        # leave the loop.
        if (prani_is_err(tract) == 1) {
            SynthStream_set_samples_rendered(self, total);
            return 0;
        }
        SynthStream_set_tract(self, tract);
    }

    var block = 0;
    var have_block = 0;
    if (SynthStream_is_cat_purr(self) == 1) {
        # cat purr special path. purr_f0 = clamp(27/1.0, 20, 35) (size baked in).
        var purr_f0 = f64_clamp(PR_ST_27_0, PR_ST_20_0, PR_ST_35_0);
        block = crtract_synthesize_purr(tract, to_render, purr_f0);
        # 2.0.5 made this fallible (it now guards purr_f0 and num_samples), so
        # it takes the same arm as the standard path below rather than being
        # assumed to succeed -- ADR-0003 then reports 0 written and retires.
        if (prani_is_err(block) == 0) { have_block = 1; }
    } else {
        # standard synthesis with pitch contour
        var total_max = total;
        if (total_max < 1) { total_max = 1; }   # total_samples.max(1)
        var t = f64_div(f64_from(rendered), f64_from(total_max));
        var contour = stream_pitch_contour_at(SynthStream_vocalization(self), SynthStream_f0(self), t);
        # POINT OF USE: stream_new proved f0 finite, but the contour MULTIPLIES
        # it (BARK opens at 1.2x, WHINE closes at 1.6x), so an f0 near f64::MAX
        # can still overflow to +inf on the way to svara. Treat it as a synthesis
        # failure and take ADR-0003's arm verbatim -- 0 written, stream retired --
        # rather than handing svara a frequency that is not a number.
        if (prani_is_finite(contour) == 0) {
            SynthStream_set_samples_rendered(self, total);
            return 0;
        }

        var modifiers = prani_intent_modifiers(SynthStream_intent(self));
        var boundary_boost = F64_ONE;
        if (f64_lt(t, PR_ST_0_1) == 1) {
            # 1 + (1 - t/0.1) * 0.5
            boundary_boost = f64_add(F64_ONE,
              f64_mul(f64_sub(F64_ONE, f64_div(t, PR_ST_0_1)), PR_ST_0_5));
        } elif (f64_gt(t, PR_ST_0_85) == 1) {
            # 1 + (t - 0.85)/0.15 * 0.5
            boundary_boost = f64_add(F64_ONE,
              f64_mul(f64_div(f64_sub(t, PR_ST_0_85), PR_ST_0_15), PR_ST_0_5));
        }
        var perturbation_scale = f64_add(boundary_boost, IntentModifiers_urgency(modifiers));

        var options = crtract_options_new(0, perturbation_scale);
        block = crtract_synthesize(tract, contour, to_render, options);
        # Rust used `if let Ok(block)` -- skip the copy on synthesis error.
        if (prani_is_err(block) == 0) { have_block = 1; }
    }

    # A synthesis failure must not be reported as a successful fill. The
    # oracle (2.0.3:rust-old/src/stream.rs:184) wraps only the COPY in
    # `if let Ok(block)`, then unconditionally runs
    # `self.samples_rendered += to_render; to_render` -- so a failed block
    # returns "I wrote N samples" while the caller's buffer still holds
    # whatever it held before, and that stale audio is played. DIVERGENCE
    # (ADR-0003): report 0 written, and retire the stream so a caller draining
    # `while (stream_is_finished(s) == 0)` terminates instead of spinning on a
    # failure that will repeat every call.
    if (have_block == 0) {
        SynthStream_set_samples_rendered(self, total);
        return 0;
    }

    if (have_block == 1) {
        # apply spectral tilt to the block (in place over the full block vec).
        # 2.0.5 made this fallible; a rejected tilt must take ADR-0003's arm
        # rather than silently returning an untilted block as a good fill.
        var e_tilt = crtract_apply_spectral_tilt(block, SynthStream_spectral_tilt(self),
          SynthStream_sample_rate(self));
        if (prani_is_err(e_tilt) == 1) { have_block = 0; }
        # apply amplitude: amp = amplitude_scale * effort_amp.
        var amp = f64_mul(SynthStream_amplitude_scale(self), SynthStream_effort_amp(self));
        var bi = 0;
        while (bi < to_render) {
            var y = f64_mul(vec_get(block, bi), amp);
            vec_set(block, bi, y);
            # copy block[bi] into buffer[bi]
            vec_set(buffer, bi, y);
            bi = bi + 1;
        }
    }

    SynthStream_set_samples_rendered(self, rendered + to_render);
    return to_render;
}

# next_block(self, block_size) -- produce the next block of audio as an owned
# vec. block_size is clamped to the remaining samples; returns an empty vec when
# nothing remains, or a NEGATIVE PRANI_ERR_INVALID_VOCALIZATION on a bad handle
# or a negative block_size (the "vec handle or negative code" convention
# crvoice_vocalize already uses). Check with prani_is_err before vec_len.
fn stream_next_block(self, block_size) {
    # Same handle class as stream_fill_buffer, but this one CAN report it: a
    # negative return is distinguishable from the empty vec that means "done".
    if (self <= 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    # block_size >= 0. A negative one used to fall through `remaining < actual`
    # (remaining is never negative), skip the `actual == 0` early return, push
    # zero samples, and hand fill_buffer an empty vec -- so it returned an EMPTY
    # VEC, indistinguishable from a finished stream. That silent-empty result is
    # exactly what 2.0.5 exists to replace. No upper bound: block_size is
    # clamped to `remaining`, which stream_new already bounded at 2^53.
    if (block_size < 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var total = SynthStream_total_samples(self);
    var rendered = SynthStream_samples_rendered(self);
    # remaining = total.saturating_sub(rendered)
    var remaining = 0;
    if (total > rendered) { remaining = total - rendered; }
    var actual = block_size;
    if (remaining < actual) { actual = remaining; }
    if (actual == 0) { return vec_new(); }
    var buf = vec_new();
    prani_vec_push_zeros(buf, actual);
    stream_fill_buffer(self, buf);
    return buf;
}

# ---- pitch_contour_at (f0-returning helper) ---------------------------------

# pitch_contour_at(voc, base_f0, t) -- the f0 at normalized time t for a
# vocalization. Distinct from voice's struct-returning contour: this is the
# free-function form the stream uses per-block. Static tables (FLAT/HOWL/BARK/
# ROAR/WHINE/SCREECH/TRILL) transcribed verbatim from the oracle. t is clamped to
# [0,1]; the point pairs are walked and the interpolated multiplier applied to
# base_f0.
#must_use
fn stream_pitch_contour_at(voc, base_f0, t) {
    var points = vec_new();
    if (voc == PRANI_VOC_HOWL) {
        # HOWL: (0.0,0.8),(0.3,1.3),(0.7,1.2),(1.0,0.6)
        stream_contour_push(points, 0, PR_ST_0_8);
        stream_contour_push(points, PR_ST_0_3, PR_ST_1_3);
        stream_contour_push(points, PR_ST_0_7, PR_ST_1_2);
        stream_contour_push(points, F64_ONE, PR_ST_0_6);
    } elif (voc == PRANI_VOC_BARK) {
        stream_contour_bark(points);
    } elif (voc == PRANI_VOC_YELP) {
        stream_contour_bark(points);
    } elif (voc == PRANI_VOC_ROAR) {
        stream_contour_roar(points);
    } elif (voc == PRANI_VOC_RUMBLE) {
        stream_contour_roar(points);
    } elif (voc == PRANI_VOC_WHINE) {
        # WHINE: (0.0,1.0),(0.5,1.4),(1.0,1.6)
        stream_contour_push(points, 0, F64_ONE);
        stream_contour_push(points, PR_ST_0_5, PR_ST_1_4);
        stream_contour_push(points, F64_ONE, PR_ST_1_6);
    } elif (voc == PRANI_VOC_SCREECH) {
        # SCREECH: (0.0,1.5),(0.3,1.2),(1.0,0.7)
        stream_contour_push(points, 0, PR_ST_1_5);
        stream_contour_push(points, PR_ST_0_3, PR_ST_1_2);
        stream_contour_push(points, F64_ONE, PR_ST_0_7);
    } elif (voc == PRANI_VOC_TRILL) {
        # TRILL: (0.0,1.0),(0.25,1.1),(0.5,0.9),(0.75,1.1),(1.0,1.0)
        stream_contour_push(points, 0, F64_ONE);
        stream_contour_push(points, PR_ST_0_25, PR_ST_1_1);
        stream_contour_push(points, PR_ST_0_5, PR_ST_0_9);
        stream_contour_push(points, PR_ST_0_75, PR_ST_1_1);
        stream_contour_push(points, F64_ONE, F64_ONE);
    } else {
        # FLAT: (0.0,1.0),(1.0,1.0)
        stream_contour_push(points, 0, F64_ONE);
        stream_contour_push(points, F64_ONE, F64_ONE);
    }

    var n = vec_len(points);           # total slots (2 per point)
    var tc = f64_clamp(t, 0, F64_ONE);
    # A NaN t survives the clamp (measured: f64_clamp(NaN, lo, hi) -> NaN), every
    # comparison in the walk below is then false, and the fallthrough returned
    # base_f0 * <last multiplier> -- 240 Hz for HOWL at base 400. That is a
    # fabricated plausible f0 for an input that means nothing (F11). This
    # function returns an f64, not a "value or negative code" (-1 IS a NaN bit
    # pattern), so there is no code to return: propagate the NaN, which every
    # finiteness check downstream already catches. Only NaN escapes the clamp --
    # +/-inf are bounded to 1/0 and keep the oracle's behaviour untouched.
    if (prani_in_range(tc, 0, F64_ONE) == 0) { return f64_mul(base_f0, tc); }
    if (n == 0) { return base_f0; }
    var num_points = n / 2;
    var i = 0;
    while (i < num_points - 1) {
        var t0 = vec_get(points, i * 2);
        var v0 = vec_get(points, i * 2 + 1);
        var t1 = vec_get(points, (i + 1) * 2);
        var v1 = vec_get(points, (i + 1) * 2 + 1);
        if (f64_ge(tc, t0) == 1) {
            if (f64_le(tc, t1) == 1) {
                var frac = 0;
                if (f64_ge(f64_abs(f64_sub(t1, t0)), PRANI_EPSILON) == 1) {
                    frac = f64_div(f64_sub(tc, t0), f64_sub(t1, t0));
                }
                # base_f0 * (v0 + (v1 - v0) * frac)
                return f64_mul(base_f0, f64_add(v0, f64_mul(f64_sub(v1, v0), frac)));
            }
        }
        i = i + 1;
    }
    # past the last point: base_f0 * last multiplier
    return f64_mul(base_f0, vec_get(points, n - 1));
}

# push a (time, multiplier) point onto a flat contour vec.
fn stream_contour_push(v, t, mult) {
    vec_push(v, t);
    vec_push(v, mult);
}

# BARK/YELP: (0.0,1.2),(0.1,1.0),(1.0,0.8)
fn stream_contour_bark(points) {
    stream_contour_push(points, 0, PR_ST_1_2);
    stream_contour_push(points, PR_ST_0_1, F64_ONE);
    stream_contour_push(points, F64_ONE, PR_ST_0_8);
}

# ROAR/RUMBLE: (0.0,0.9),(0.15,1.2),(0.5,1.0),(1.0,0.7)
fn stream_contour_roar(points) {
    stream_contour_push(points, 0, PR_ST_0_9);
    stream_contour_push(points, PR_ST_0_15, PR_ST_1_2);
    stream_contour_push(points, PR_ST_0_5, F64_ONE);
    stream_contour_push(points, F64_ONE, PR_ST_0_7);
}

# --- ffi.cyr ---

# ffi.cyr -- C buffer-callback API for game-engine middleware.
# Ports 2.0.3:rust-old/src/ffi.rs. Provides the create/configure/stream/fill
# surface a host (Wwise source plugin, FMOD DSP callback, Godot
# AudioStreamGenerator) drives to synthesize creature voices on demand.
#
# Requires (from the build/test unit, in dependency order): stdlib alloc/vec/math,
# hisab, goonj, naad, svara, error.cyr, rng.cyr, dsp.cyr, vocalization.cyr,
# sequence.cyr, species.cyr, bridge.cyr, tract.cyr, voice.cyr, stream.cyr. Module
# files carry no `include` lines -- the entry orders them.
#
# NAMING (flat-namespace prefix): every top-level fn here is `prani_ffi_`-prefixed
# (the audit's naming contract). The Rust surface used the bare `prani_*` names;
# the port disambiguates from the rest of the flat namespace with the `ffi` infix.
#
# ================================================================
# ABI ADAPTATION (deviation from the oracle -- documented per brief)
# ================================================================
# Rust's ffi.rs is `#[no_mangle] extern "C"` with raw pointers and
# Box::into_raw / Box::from_raw. None of that C-ABI machinery translates to
# Cyrius, so the LOGIC is ported with Cyrius conventions:
#
#   * Handles = heap pointers. A `PraniVoice` / `PraniStream` opaque pointer maps
#     directly to the CreatureVoice / SynthStream heap ptr that crvoice_new /
#     stream_new already return. There is no separate Box wrapper.
#   * "null" = 0. Rust returned core::ptr::null_mut() on failure and null-checked
#     with `is_null()` / `as_ref()` / `as_mut()`; here that is `== 0` / `!= 0`.
#   * Audio buffers = stdlib vec handles (not raw `*mut f32` + length). The caller
#     passes a pre-sized vec; stream_fill_buffer bounds by vec_len internally. The
#     `buffer_len` parameter is retained for signature parity with the C surface
#     (callers that pass a length), but the vec's own length is the real bound.
#   * destroy = no-op null-check. Cyrius uses an arena allocator: there is no
#     per-object free, so Rust's `drop(Box::from_raw(handle))` collapses to a
#     null-check-only no-op. The functions are kept so the C lifecycle contract
#     (create/destroy pairing) still type-checks for callers.
#   * stream_start SHARES the voice handle instead of cloning it. Rust did
#     `SynthStream::new(voice.clone(), ...)`; SynthStream only READS the voice
#     (effective_f0 / vocal_effort / species snapshots taken in stream_new), so
#     sharing the pointer is safe and avoids a deep copy. (Deviation.)
#
# INDICES: the Species / Vocalization / CallIntent discriminants ARE their FFI
# indices (0-based, contiguous), so the Rust `match index { .. }` mapping is a
# plain range check. Out of range -> -1 (the None sentinel; valid indices are all
# >= 0). Integers are i64; comparisons return 1/0; f64 args pass through.

# ================================================================
# Index mapping helpers (ports species_from_index / vocalization_from_index /
# intent_from_index). The discriminant equals the index, so each is a range
# check returning the index on success or -1 (None) on out-of-range.
# ================================================================

# species_from_index(index) -- 0..=12 -> that species discriminant, else -1.
# 0=Wolf,1=Dog,2=Cat,3=Lion,4=Songbird,5=Crow,6=Raptor,7=Snake,8=Crocodilian,
# 9=Cricket,10=Bee,11=Dragon,12=Fantasy.
#must_use
fn prani_ffi_species_from_index(index) {
    if (index < 0) { return (0 - 1); }
    if (index > 12) { return (0 - 1); }
    return index;
}

# vocalization_from_index(index) -- 0..=13 -> that vocalization discriminant,
# else -1. 0=Howl,1=Bark,2=Growl,3=Roar,4=Hiss,5=Chirp,6=Trill,7=Whine,8=Rumble,
# 9=Purr,10=Yelp,11=Screech,12=Stridulate,13=Buzz.
#must_use
fn prani_ffi_vocalization_from_index(index) {
    if (index < 0) { return (0 - 1); }
    if (index > 13) { return (0 - 1); }
    return index;
}

# intent_from_index(index) -- 0..=6 -> that intent discriminant, else -1.
# 0=Alarm,1=Territorial,2=Mating,3=Distress,4=Idle,5=Threat,6=Social.
#must_use
fn prani_ffi_intent_from_index(index) {
    if (index < 0) { return (0 - 1); }
    if (index > 6) { return (0 - 1); }
    return index;
}

# ================================================================
# Voice lifecycle (ports prani_voice_create / prani_voice_destroy).
# ================================================================

# voice_create(species_index) -- new CreatureVoice for the species index, or 0
# (null) when the index is out of range. Handle = the CreatureVoice heap ptr.
#must_use
fn prani_ffi_voice_create(species_index) {
    var species = prani_ffi_species_from_index(species_index);
    if (species < 0) { return 0; }
    return crvoice_new(species);
}

# voice_destroy(handle) -- no-op (arena allocator: no per-object free). Kept for
# C lifecycle parity; only null-checks. Ports the Rust drop(Box::from_raw).
fn prani_ffi_voice_destroy(handle) {
    if (handle != 0) {
        # arena allocator -- nothing to free.
    }
    return 0;
}

# ================================================================
# Voice RTPC setters (port prani_voice_set_effort / set_size / apply_lombard).
# Each null-checks the handle (Rust `if let Some(voice) = handle.as_mut()`).
#
# INPUT-RANGE VALIDATION (2.0.5, audit finding F11). These three take an f64
# straight from an untrusted C host and have no error channel -- Rust returned
# `()`, the port returns a constant 0 -- so the only reportable outcome is
# WHETHER THE VOICE CHANGED. Each rejects a non-finite argument the same way it
# already rejects a null handle: by doing nothing at all, leaving every field of
# the voice exactly as the last accepted call left it. That is checkable through
# the getters (crvoice_vocal_effort / CreatureVoice_size_scale), so "rejected"
# is observable without a signature change.
#
# Non-finite, not out-of-range, is the line, and the two halves have different
# reasons:
#   * NaN is a LIVE defect. Measured: f64_clamp(NaN, lo, hi) -> NaN, so NaN
#     walks straight through crvoice_set_vocal_effort's [0,1] clamp,
#     crvoice_with_size's [0.1,10] clamp and bridge_lombard_effort_boost's
#     [0,0.5] clamp and poisons the voice. A NaN size_scale is the worst of the
#     three: crvoice_effective_f0 DIVIDES by it, so every later synthesis on
#     that voice yields NaN samples with nothing anywhere reporting an error.
#   * +/-inf is NOT a clamp hazard -- measured, f64_clamp bounds both -- and it
#     is rejected for a different reason: an infinite RTPC value is a host bug,
#     and clamping it lands on exactly the range endpoint, a result the host
#     cannot tell apart from a deliberate 1.0. Fabricating a plausible answer
#     that hides the caller's bug is the defect class ADR-0001 named.
# A FINITE out-of-range value still clamps, unchanged: that is the oracle's
# documented RTPC saturation (`voice.set_vocal_effort(effort)` clamps), it is
# pinned by tests/ffi.tcyr's "finite 1.5 still clamps to 1.0". Rejecting it
# instead is the builder-contract question in roadmap 2.1.0, not this milestone.
# ================================================================

# voice_set_effort(handle, effort) -- real-time vocal-effort update
# (0.0 whisper .. 0.5 normal .. 1.0 shout). crvoice_set_vocal_effort clamps a
# finite value into [0,1]; a non-finite one is rejected (no-op, voice unchanged).
fn prani_ffi_voice_set_effort(handle, effort) {
    if (handle == 0) { return 0; }
    if (prani_is_finite(effort) == 0) { return 0; }
    crvoice_set_vocal_effort(handle, effort);
    return 0;
}

# voice_set_size(handle, size) -- individual size scale. The oracle rebuilds the
# voice (`*voice = CreatureVoice::new(species).with_size(size)`) because size
# affects several params.
#
# ALLOCATION: this is an RTPC setter -- a host may call it every frame, per
# creature. It used to build a FRESH CreatureVoice (and, through crvoice_new, a
# fresh SpeciesParams) on every call just to copy five fields out of it and drop
# the shell. Cyrius's allocator is a bump arena that never frees, so each call
# permanently retained both. Rebuilding is also unnecessary: `crvoice_new`
# restores species defaults and `crvoice_with_size` then sets size_scale, which
# is exactly resetting the four individual fields in place. The observable
# result is identical -- proven by tests/hardening.tcyr comparing this against a
# genuinely rebuilt voice field for field -- with no allocation at all.
#
# The finite check comes BEFORE crvoice_reset_individual, not after: this
# function's first act is to wipe the voice's four individual fields back to the
# species defaults, so validating late would still have destroyed the caller's
# f0_offset, size_scale and vocal_effort on the way to rejecting the size.
# Rejecting first makes the call a true no-op.
fn prani_ffi_voice_set_size(handle, size) {
    if (handle == 0) { return 0; }
    if (prani_is_finite(size) == 0) { return 0; }
    crvoice_reset_individual(handle);
    # crvoice_with_size is #must_use because it is a chaining builder; here
    # it mutates `handle` in place and hands the same pointer back, so the
    # return is the input and binding it is the whole use.
    var sized = crvoice_with_size(handle, size);
    CreatureVoice_set_size_scale(handle, CreatureVoice_size_scale(sized));
    return 0;
}

# voice_apply_lombard(handle, ambient_spl_db) -- involuntary effort boost in
# ambient noise (Lombard effect). crvoice_apply_lombard_effect clamps to [0,1].
# A finite dB SPL of any magnitude is accepted: bridge_lombard_effort_boost is
# already total over the finite reals (<= 40 dB -> 0 boost, above -> excess *
# 0.005 clamped to [0, 0.5]), so there is no out-of-range dB value to reject and
# no threshold to restate here. Only a non-finite reading is rejected.
fn prani_ffi_voice_apply_lombard(handle, ambient_spl_db) {
    if (handle == 0) { return 0; }
    if (prani_is_finite(ambient_spl_db) == 0) { return 0; }
    crvoice_apply_lombard_effect(handle, ambient_spl_db);
    return 0;
}

# ================================================================
# Stream lifecycle (ports prani_stream_start / stream_fill / stream_is_finished /
# stream_destroy).
# ================================================================

# stream_start(voice_handle, voc_index, intent_index, sample_rate, duration) --
# start a synthesis stream. Returns the SynthStream handle, or 0 (null) on any
# error: null voice, out-of-range voc/intent index, sample_rate/duration outside
# their ranges, or an unsupported vocalization for the species (stream_new ->
# negative error). Ports prani_stream_start (shares the voice ptr instead of
# cloning -- see ABI note). 0 (null) IS this function's error channel already
# ("Returns a null pointer on error (invalid voice, unsupported vocalization,
# etc.)"), so the range rejections need no new convention.
#
# RANGES (2.0.5):
#   sample_rate  (0, +inf)   finite and strictly positive
#   duration     [0, +inf)   finite and non-negative; ZERO IS VALID
#
# sample_rate must be positive because `total_samples = f64_to(effective_duration
# * sample_rate)` is only a sample COUNT when it is. Measured on the unguarded
# code: NaN gives total_samples = i64::MIN and 0.0 gives 0, and in both cases
# `stream_is_finished` (samples_rendered >= total_samples) is true on the first
# call -- the host receives a NON-NULL handle to a stream that is born retired,
# drains nothing, and reports no error anywhere. A silently empty buffer is
# exactly F11's signature, and null is the honest answer.
#
# This is NOT svara's sample-rate floor moved earlier, and ADR-0001's rejection
# of "validate sample_rate in prani" still stands: the floor (~1000 Hz) is
# svara's rule and stays there. A finite positive rate BELOW it -- 999.0 -- still
# gets a handle from this function and is rejected by svara at the first fill,
# which reports 0 written and retires the stream per ADR-0003. tests/ffi.tcyr
# pins that path so this guard cannot quietly swallow it.
#
# duration = 0 is accepted deliberately: the oracle's test_zero_duration_synthesis
# asserts an EMPTY BUFFER, NOT AN ERROR, so a zero-length stream is a legal thing
# to ask for and still returns a handle. A NEGATIVE duration is rejected, and
# that is a DELIBERATE DIVERGENCE -- Rust's `as usize` cast saturates, so the
# oracle folded every negative duration into 0 and handed back a stream. It could
# not represent the state; i64 can, and `f64_to` wraps rather than saturates, so
# the port would build a stream whose total_samples is large and negative and
# whose finished-ness is an accident of a signed compare rather than a real zero.
# A host that asks for -1 seconds has a bug (ADR-0001).
#must_use
fn prani_ffi_stream_start(voice_handle, voc_index, intent_index, sample_rate, duration) {
    if (voice_handle == 0) { return 0; }
    var voc = prani_ffi_vocalization_from_index(voc_index);
    if (voc < 0) { return 0; }
    var intent = prani_ffi_intent_from_index(intent_index);
    if (intent < 0) { return 0; }
    if (prani_is_positive(sample_rate) == 0) { return 0; }
    if (prani_is_non_negative(duration) == 0) { return 0; }
    var stream = stream_new(voice_handle, voc, intent, sample_rate, duration);
    if (prani_is_err(stream) == 1) { return 0; }
    return stream;
}

# stream_fill(stream_handle, buffer, buffer_len) -- fill the caller's vec with the
# next audio samples; returns the count written (0 when finished, on null args, or
# on an out-of-range buffer_len). `buffer` is a vec handle; `buffer_len` is
# retained for C signature parity but the vec's own length is the bound
# (stream_fill_buffer uses vec_len internally). Ports prani_stream_fill.
#
# RANGE (2.0.5): buffer_len >= 0 -- a sample count cannot be negative. The
# oracle's `buffer_len: u32` made that unrepresentable; the port widened it to
# i64, so a host that computes a length by subtraction and underflows can now
# hand one over. The old `buffer_len == 0` test let a negative straight through
# and the fill then ran to the vec's full length: measured, buffer_len = -1 with
# a 2205-element vec wrote and reported 2205 samples, the exact inverse of what
# "I have -1 elements of room" meant. Rejecting with 0 written matches the
# existing zero-length arm, which ADR-0003 already establishes as a caller
# mistake that returns 0 WITHOUT retiring the stream -- the stream itself is fine
# and a corrected call still drains it.
fn prani_ffi_stream_fill(stream_handle, buffer, buffer_len) {
    if (stream_handle == 0) { return 0; }
    if (buffer == 0) { return 0; }
    if (buffer_len <= 0) { return 0; }
    return stream_fill_buffer(stream_handle, buffer);
}

# stream_is_finished(stream_handle) -- 1 if finished (or null handle), else 0.
# Ports prani_stream_is_finished (null -> 1, matching the Rust None arm).
#must_use
fn prani_ffi_stream_is_finished(stream_handle) {
    if (stream_handle == 0) { return 1; }
    return stream_is_finished(stream_handle);
}

# stream_destroy(stream_handle) -- no-op (arena allocator: no per-object free).
# Kept for C lifecycle parity; only null-checks. Ports drop(Box::from_raw).
fn prani_ffi_stream_destroy(stream_handle) {
    if (stream_handle != 0) {
        # arena allocator -- nothing to free.
    }
    return 0;
}

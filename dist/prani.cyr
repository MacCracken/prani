# --- error.cyr ---

# error.cyr -- prani error codes + shared DSP tolerances and base helpers.
# L0 base module: included FIRST by every build/test entry. Modules never
# `include` each other -- the entry file orders them.
#
# Ports 2.0.3:rust-old/src/error.rs (the `PraniError` enum +
# `From<SvaraError>`). Rust carried a String payload per variant; the Cyrius
# port uses integer codes -- fallible functions return PRANI_ERR_NONE (0) on
# success or a negative code on failure; diagnostic text via prani_err_name().
#
# NAMING: every prani top-level symbol is `prani_`/`PRANI_`/`Pr`-prefixed so
# the prani distlib coexists with svara + naad bundles in one flat namespace
# (svara exports svara_*, naad exports validate_*/flush_denormal/ERR_NONE).
#
# FLOATS: a real is the build's float, f64 or f32 (ADR-0010; src/real.cyr). The
# constants below are pairs, one per format. PRANI_EPSILON is f32::EPSILON (2^-23),
# the tolerance the Rust tests used, in the build's format.

# ================================================================
# Error codes (was `enum PraniError`). One per Rust variant, in order.
# ================================================================

# prani:real-source
#ifdef PRANI_F32
var PRANI_ERR_NONE                 = 0;
var PRANI_ERR_INVALID_TRACT        = (0 - 1);   # vocal tract parameter out of range
var PRANI_ERR_INVALID_VOCALIZATION = (0 - 2);   # vocalization parameter invalid
var PRANI_ERR_INVALID_SPECIES      = (0 - 3);   # species configuration invalid
var PRANI_ERR_SYNTHESIS_FAILED     = (0 - 4);   # a synthesis step failed
var PRANI_ERR_SVARA                = (0 - 5);   # underlying svara operation failed
# 2.2.0, ADR-0008: not a Rust variant. The oracle's allocator aborted, so it had no
# way to report this; prani's bump arena returns 0, and every prani constructor
# and entry point reports that here instead of storing through it.
var PRANI_ERR_ALLOC                = (0 - 6);   # an allocation prani made was refused

# ================================================================
# Shared f64 tolerances / sentinels (IEEE-754 bit patterns). Exported for
# consumers (tract clamps, tests). PRANI_EPSILON = f32::EPSILON promoted.
# ================================================================
#ifdef PRANI_F32
var PRANI_EPSILON = 0x34000000;           # f32::EPSILON = 2^-23 ~ 1.192e-7
var PRANI_POS_INF = 0x7F800000;           # +inf
var PRANI_NEG_INF = 0xFF800000;           # -inf
#else
var PRANI_EPSILON = 0x3E80000000000000;   # f32::EPSILON = 2^-23 ~ 1.192e-7
var PRANI_POS_INF = 0x7FF0000000000000;   # +inf
var PRANI_NEG_INF = 0xFFF0000000000000;   # -inf
#endif

# 1 if `code` is an error (negative), 0 otherwise.
#must_use
fn prani_is_err(code) {
    if (code < 0) { return 1; }
    return 0;
}

# Static name for an error code (diagnostics / logging).
#must_use
fn prani_err_name(code) {
    if (code == PRANI_ERR_NONE) { return "none"; }
    if (code == PRANI_ERR_INVALID_TRACT) { return "invalid tract parameter"; }
    if (code == PRANI_ERR_INVALID_VOCALIZATION) { return "invalid vocalization"; }
    if (code == PRANI_ERR_INVALID_SPECIES) { return "invalid species"; }
    if (code == PRANI_ERR_SYNTHESIS_FAILED) { return "synthesis failed"; }
    if (code == PRANI_ERR_SVARA) { return "svara error"; }
    if (code == PRANI_ERR_ALLOC) { return "allocation refused"; }
    return "unknown error";
}

# ================================================================
# Allocation (2.2.0, ADR-0008). EVERY allocation prani makes goes through the
# three helpers below, and each reports a refusal as PRANI_ERR_ALLOC. Before
# 2.2.0 a refused `alloc` returned 0 and prani stored through it (a fault at the
# null page), a refused `vec_new` returned 0 and prani used it as a vec, and a
# refused `vec_push` grow exited the process ("vec: alloc failed"). No host can
# handle any of the three. scripts/check-alloc.sh fails the build if src/ calls
# `alloc`, `vec_new` or `vec_push` anywhere else.
#
# The helpers draw from prani's OWN Allocator, a stdlib vtable (lib/alloc.cyr's
# 40-byte layout) whose alloc slot is prani_alloc_raw. It serves exactly what the
# stdlib's default allocator serves -- the same global bump arena, through
# `alloc` -- so nothing about where memory comes from changes. What it buys is a
# seam: tests/allocrefused.tcyr redefines prani_alloc_raw to refuse chosen
# requests, and so refuses prani's allocations and nobody else's. svara's own
# allocations do not pass through it, and stop where svara's ADR-0009 says (at
# the null page) when refused; the ones svara reports, prani passes on.
# ================================================================
var _prani_alloc_vt: i64[5];
var _prani_alloc_ready = 0;

# prani_alloc_raw(state, size) -- the vtable's alloc slot, and the only place
# prani's memory comes from: the global bump arena. Returns a pointer, or 0 when
# `alloc` refuses. `state` is the vtable's (always 0; the arena is global).
fn prani_alloc_raw(state, size) {
    return alloc(size);
}

# prani_alloc_no_realloc(state, ptr, old_size, new_size) -- the realloc slot.
# Nothing prani calls reallocates through an Allocator; 0 is "refused".
fn prani_alloc_no_realloc(state, ptr, old_size, new_size) {
    return 0;
}

# prani_alloc_no_free(state, ptr) -- the free slot. A bump arena frees nothing.
fn prani_alloc_no_free(state, ptr) {
    return 0;
}

# prani_alloc_no_reset(state) -- the reset slot. prani never resets the arena:
# that would invalidate every pointer the stdlib holds too (lib/alloc.cyr).
fn prani_alloc_no_reset(state) {
    return 0;
}

# prani_allocator() -- prani's Allocator, built once in static storage. As with
# the stdlib's default_alloc(), a race between two first callers writes identical
# bytes to the identical buffer, so the publish is idempotent.
#must_use
fn prani_allocator() {
    if (_prani_alloc_ready == 0) {
        var s = &_prani_alloc_vt;
        store64(s, &prani_alloc_raw);
        store64(s + 8, &prani_alloc_no_realloc);
        store64(s + 16, &prani_alloc_no_free);
        store64(s + 24, &prani_alloc_no_reset);
        store64(s + 32, 0);
        _prani_alloc_ready = 1;
    }
    return &_prani_alloc_vt;
}

# prani_alloc(size) -- `size` bytes from prani's allocator, or PRANI_ERR_ALLOC.
# It calls the vtable's alloc slot directly rather than through alloc_via: the
# indirect call cost emotion_evaluate, which allocates its result on every frame,
# 16 ns (72 -> 88), measured over six alternating rounds. A direct call reaches the
# same prani_alloc_raw, a test's redefinition included.
#must_use
fn prani_alloc(size) {
    var p = prani_alloc_raw(0, size);
    if (p == 0) { return PRANI_ERR_ALLOC; }
    return p;
}

# prani_vec_new() -- an empty vec (capacity 16) from prani's allocator, or
# PRANI_ERR_ALLOC. stdlib vec_new would return 0 and leave the check to a caller
# who could not tell it from a handle.
#must_use
fn prani_vec_new() {
    var v = vec_new_a(prani_allocator());
    if (v == 0) { return PRANI_ERR_ALLOC; }
    return v;
}

# prani_vec_push(v, x) -- append x, growing through prani's allocator.
# PRANI_ERR_NONE, or PRANI_ERR_ALLOC when the grow is refused (stdlib vec_push
# exits the process there). `v` is unchanged on a refusal. A count past
# VEC_CAP_MAX still ends the process inside the stdlib, so every caller that
# builds a buffer ranges its count first (prani_buffer_count_ok / _len_ok).
#must_use
fn prani_vec_push(v, x) {
    if (vec_push_a(prani_allocator(), v, x) < 0) { return PRANI_ERR_ALLOC; }
    return PRANI_ERR_NONE;
}

# Map a svara error code (svara's own SVARA_ERR_* are negative) to
# PRANI_ERR_SVARA. Ports `impl From<svara::error::SvaraError> for PraniError`.
# Any nonzero svara code becomes the wrapping prani code; 0 (none) passes.
#must_use
fn prani_from_svara(svara_code) {
    if (svara_code == 0) { return PRANI_ERR_NONE; }
    return PRANI_ERR_SVARA;
}

# Finite test: 1 iff x is neither +/-inf nor NaN. abs(x) < +inf holds for
# finite x, fails for infinities (inf < inf is false) and NaN (any NaN
# compare is false). Mirrors Rust `f32::is_finite`.
#must_use
fn prani_is_finite(x) {
    return pr_lt(pr_abs(x), PRANI_POS_INF);
}

# ================================================================
# Input-range guards (2.0.5). Why these exist, measured 2026-08-31 and
# re-measured 2026-11-07 on cyrius 6.6.20:
#
#   f64_clamp(NaN, lo, hi) -> NaN          NaN passes every clamp in the tree
#   f64_clamp(+inf, lo, hi) -> hi          infinities ARE bounded by clamp
#   f64_clamp(-inf, lo, hi) -> lo
#   f64_to(NaN)     -> 0                   a legal count
#   f64_to(>= 2^63) -> i64::MAX            +inf included
#   f64_to(< -2^63) -> i64::MIN            -inf included
#
# So the hazard at a clamp site is NaN specifically, not non-finiteness in
# general. A count has two hazards and neither is negative: NaN lands on 0 and
# renders a silently EMPTY buffer (audit finding F11), and an overflow lands on
# i64::MAX and pushes samples until the vec aborts the process. Before cyrius
# 6.6.8 all of them gave i64::MIN, so a floor check caught them by accident. It
# catches neither now: a count is ranged in f64, BEFORE the cast, with
# prani_sample_count_ok or, where the count becomes one buffer,
# prani_buffer_count_ok.
#
# These return 1 for "acceptable" and 0 for "reject", so a call site reads
#   if (prani_is_finite(x) == 0) { return PRANI_ERR_INVALID_TRACT; }
# and the error code stays the caller's choice -- there is no generic
# "bad parameter" code, deliberately: the oracle's five variants already carry
# the range meaning by category (PraniError::InvalidTract is documented as
# "a vocal tract parameter is out of valid range").
# ================================================================

# prani_handle_code(h, code) -- what a function returns for a handle h that is not
# a live object (h <= 0): h itself when it is already an error, so a refusal
# upstream keeps its meaning (PRANI_ERR_ALLOC stays PRANI_ERR_ALLOC), else `code`
# for a null handle. Every public function that takes a handle tests `h <= 0`
# first and returns this (2.2.1, completing ADR-0008's first rule); a function
# that returns nothing returns 0 instead, and does nothing.
#must_use
fn prani_handle_code(h, code) {
    if (h < 0) { return h; }
    return code;
}

# prani_json_int_ok(node, key) -- 1 iff `node` is an object holding `key` as a JSON
# integer, 0 for an absent key, a non-integer (a float, a string, true), a node that
# is not an object, or a null node. bayan's accessors are null-safe and read every
# one of those as 0, so a decoder that read without asking fabricated a 0: a Wolf,
# an effort of 0.0, an empty phrase (audit A2/C4/C5, 2.2.1). prani writes every f64
# as an integer bit pattern, so its own documents always pass.
#must_use
fn prani_json_int_ok(node, key) {
    if (node == 0) { return 0; }
    if (bayan_json_v_is_obj(node) == 0) { return 0; }
    if (bayan_json_v_is_int(bayan_json_v_obj_get_by_cstr(node, key)) == 0) { return 0; }
    return 1;
}

# 1 iff x is NaN: the one value that fails x <= x. The hazard at a CLAMP site
# (2.2.0's builders): f64_clamp bounds an infinity to a legal endpoint, which
# 2.0.5 decided to accept, but passes NaN through every clamp unchanged.
#must_use
fn prani_is_nan(x) {
    if (pr_le(x, x)) { return 0; }
    return 1;
}

# 1 iff both are finite.
#must_use
fn prani_finite2(a, b) {
    if (prani_is_finite(a) == 0) { return 0; }
    return prani_is_finite(b);
}

# 1 iff all three are finite.
#must_use
fn prani_finite3(a, b, c) {
    if (prani_is_finite(a) == 0) { return 0; }
    return prani_finite2(b, c);
}

# 1 iff x is finite and lo <= x <= hi. Rejects NaN (every comparison against
# NaN is false, so the two f64_ge/f64_le tests both fail).
#must_use
fn prani_in_range(x, lo, hi) {
    if (prani_is_finite(x) == 0) { return 0; }
    if (pr_ge(x, lo) == 0) { return 0; }
    return pr_le(x, hi);
}

# 1 iff x is finite and strictly greater than 0. The common case for a
# duration, a sample rate, a distance or a scale factor used as a divisor.
#must_use
fn prani_is_positive(x) {
    if (prani_is_finite(x) == 0) { return 0; }
    return pr_gt(x, 0);
}

# 1 iff x is finite and >= 0 (a duration of exactly 0 is legal -- the oracle's
# test_zero_duration_synthesis asserts an empty buffer, not an error).
#must_use
fn prani_is_non_negative(x) {
    if (prani_is_finite(x) == 0) { return 0; }
    return pr_ge(x, 0);
}

# 2^53 == 9007199254740992: the largest sample count an f64 represents exactly.
# At 44.1 kHz that is ~6470 years of audio.
#ifdef PRANI_F32
var PRANI_MAX_SAMPLE_COUNT = 0x5A000000;
#else
var PRANI_MAX_SAMPLE_COUNT = 0x4340000000000000;
#endif

# 1 iff `raw`, a sample count still in f64, may be cast with f64_to: finite and
# within [0, PRANI_MAX_SAMPLE_COUNT]. Call it BEFORE the cast -- after it, NaN is
# a legal 0 and an overflow is i64::MAX (see the block above). This is a limit
# on what a count can MEAN, not on what fits in memory; sequence.cyr's
# prani_seq_samples_ok is the allocation ceiling for its multi-call entry points.
#must_use
fn prani_sample_count_ok(raw) {
    return prani_in_range(raw, 0, PRANI_MAX_SAMPLE_COUNT);
}

# 1 iff `raw`, a sample count still in f64, can be ONE buffer: finite and within
# [0, VEC_CAP_MAX]. Any path that hands back a whole buffer uses this rather than
# prani_sample_count_ok, because growing a vec past VEC_CAP_MAX is "vec: capacity
# overflow" and a process exit no caller can catch, so the refusal has to come
# before the first push. A stream needs only the wider check: it renders block by
# block, so its total is not a buffer.
#
# The limit is lib/vec.cyr's own constant, not a copy of it, so this refuses
# exactly what could never have succeeded. It is not a memory estimate: a buffer
# at the limit costs ~4 GiB of bump arena. An allocation refused below it is
# reported as PRANI_ERR_ALLOC since 2.2.0 (ADR-0008); past it, the stdlib still
# ends the process, which is why this check comes first.
#must_use
fn prani_buffer_count_ok(raw) {
    return prani_in_range(raw, 0, pr_from(VEC_CAP_MAX));
}

# prani_buffer_count_ok for a count that is already an integer.
#must_use
fn prani_buffer_len_ok(n) {
    if (n < 0) { return 0; }
    if (n > VEC_CAP_MAX) { return 0; }
    return 1;
}

# prani:real-source-end
#endif

# --- error.cyr ---

# error.cyr -- prani error codes + shared DSP tolerances and base helpers.
# L0 base module: included FIRST by every build/test entry. Modules never
# `include` each other -- the entry file orders them.
#
# Ports 2.0.3:rust-old/src/error.rs (the `PraniError` enum +
# `From<SvaraError>`). Rust carried a String payload per variant; the Cyrius
# port uses integer codes -- fallible functions return PRANI_ERR_NONE (0) on
# success or a negative code on failure; diagnostic text via prani_err_name().
#
# NAMING: every prani top-level symbol is `prani_`/`PRANI_`/`Pr`-prefixed so
# the prani distlib coexists with svara + naad bundles in one flat namespace
# (svara exports svara_*, naad exports validate_*/flush_denormal/ERR_NONE).
#
# FLOATS: a real is the build's float, f64 or f32 (ADR-0010; src/real.cyr). The
# constants below are pairs, one per format. PRANI_EPSILON is f32::EPSILON (2^-23),
# the tolerance the Rust tests used, in the build's format.

# ================================================================
# Error codes (was `enum PraniError`). One per Rust variant, in order.
# ================================================================

#
# GENERATED by scripts/gen-f64.sh from src/error.cyr -- do not edit; edit the source and
# re-run the script. This is the f64 build of that module (ADR-0010).
#ifndef PRANI_F32
var PRANI_ERR_NONE                 = 0;
var PRANI_ERR_INVALID_TRACT        = (0 - 1);   # vocal tract parameter out of range
var PRANI_ERR_INVALID_VOCALIZATION = (0 - 2);   # vocalization parameter invalid
var PRANI_ERR_INVALID_SPECIES      = (0 - 3);   # species configuration invalid
var PRANI_ERR_SYNTHESIS_FAILED     = (0 - 4);   # a synthesis step failed
var PRANI_ERR_SVARA                = (0 - 5);   # underlying svara operation failed
# 2.2.0, ADR-0008: not a Rust variant. The oracle's allocator aborted, so it had no
# way to report this; prani's bump arena returns 0, and every prani constructor
# and entry point reports that here instead of storing through it.
var PRANI_ERR_ALLOC                = (0 - 6);   # an allocation prani made was refused

# ================================================================
# Shared f64 tolerances / sentinels (IEEE-754 bit patterns). Exported for
# consumers (tract clamps, tests). PRANI_EPSILON = f32::EPSILON promoted.
# ================================================================
var PRANI_EPSILON = 0x3E80000000000000;   # f32::EPSILON = 2^-23 ~ 1.192e-7
var PRANI_POS_INF = 0x7FF0000000000000;   # +inf
var PRANI_NEG_INF = 0xFFF0000000000000;   # -inf

# 1 if `code` is an error (negative), 0 otherwise.
#must_use
fn prani_is_err(code) {
    if (code < 0) { return 1; }
    return 0;
}

# Static name for an error code (diagnostics / logging).
#must_use
fn prani_err_name(code) {
    if (code == PRANI_ERR_NONE) { return "none"; }
    if (code == PRANI_ERR_INVALID_TRACT) { return "invalid tract parameter"; }
    if (code == PRANI_ERR_INVALID_VOCALIZATION) { return "invalid vocalization"; }
    if (code == PRANI_ERR_INVALID_SPECIES) { return "invalid species"; }
    if (code == PRANI_ERR_SYNTHESIS_FAILED) { return "synthesis failed"; }
    if (code == PRANI_ERR_SVARA) { return "svara error"; }
    if (code == PRANI_ERR_ALLOC) { return "allocation refused"; }
    return "unknown error";
}

# ================================================================
# Allocation (2.2.0, ADR-0008). EVERY allocation prani makes goes through the
# three helpers below, and each reports a refusal as PRANI_ERR_ALLOC. Before
# 2.2.0 a refused `alloc` returned 0 and prani stored through it (a fault at the
# null page), a refused `vec_new` returned 0 and prani used it as a vec, and a
# refused `vec_push` grow exited the process ("vec: alloc failed"). No host can
# handle any of the three. scripts/check-alloc.sh fails the build if src/ calls
# `alloc`, `vec_new` or `vec_push` anywhere else.
#
# The helpers draw from prani's OWN Allocator, a stdlib vtable (lib/alloc.cyr's
# 40-byte layout) whose alloc slot is prani_alloc_raw. It serves exactly what the
# stdlib's default allocator serves -- the same global bump arena, through
# `alloc` -- so nothing about where memory comes from changes. What it buys is a
# seam: tests/allocrefused.tcyr redefines prani_alloc_raw to refuse chosen
# requests, and so refuses prani's allocations and nobody else's. svara's own
# allocations do not pass through it, and stop where svara's ADR-0009 says (at
# the null page) when refused; the ones svara reports, prani passes on.
# ================================================================
var _prani_alloc_vt: i64[5];
var _prani_alloc_ready = 0;

# prani_alloc_raw(state, size) -- the vtable's alloc slot, and the only place
# prani's memory comes from: the global bump arena. Returns a pointer, or 0 when
# `alloc` refuses. `state` is the vtable's (always 0; the arena is global).
fn prani_alloc_raw(state, size) {
    return alloc(size);
}

# prani_alloc_no_realloc(state, ptr, old_size, new_size) -- the realloc slot.
# Nothing prani calls reallocates through an Allocator; 0 is "refused".
fn prani_alloc_no_realloc(state, ptr, old_size, new_size) {
    return 0;
}

# prani_alloc_no_free(state, ptr) -- the free slot. A bump arena frees nothing.
fn prani_alloc_no_free(state, ptr) {
    return 0;
}

# prani_alloc_no_reset(state) -- the reset slot. prani never resets the arena:
# that would invalidate every pointer the stdlib holds too (lib/alloc.cyr).
fn prani_alloc_no_reset(state) {
    return 0;
}

# prani_allocator() -- prani's Allocator, built once in static storage. As with
# the stdlib's default_alloc(), a race between two first callers writes identical
# bytes to the identical buffer, so the publish is idempotent.
#must_use
fn prani_allocator() {
    if (_prani_alloc_ready == 0) {
        var s = &_prani_alloc_vt;
        store64(s, &prani_alloc_raw);
        store64(s + 8, &prani_alloc_no_realloc);
        store64(s + 16, &prani_alloc_no_free);
        store64(s + 24, &prani_alloc_no_reset);
        store64(s + 32, 0);
        _prani_alloc_ready = 1;
    }
    return &_prani_alloc_vt;
}

# prani_alloc(size) -- `size` bytes from prani's allocator, or PRANI_ERR_ALLOC.
# It calls the vtable's alloc slot directly rather than through alloc_via: the
# indirect call cost emotion_evaluate, which allocates its result on every frame,
# 16 ns (72 -> 88), measured over six alternating rounds. A direct call reaches the
# same prani_alloc_raw, a test's redefinition included.
#must_use
fn prani_alloc(size) {
    var p = prani_alloc_raw(0, size);
    if (p == 0) { return PRANI_ERR_ALLOC; }
    return p;
}

# prani_vec_new() -- an empty vec (capacity 16) from prani's allocator, or
# PRANI_ERR_ALLOC. stdlib vec_new would return 0 and leave the check to a caller
# who could not tell it from a handle.
#must_use
fn prani_vec_new() {
    var v = vec_new_a(prani_allocator());
    if (v == 0) { return PRANI_ERR_ALLOC; }
    return v;
}

# prani_vec_push(v, x) -- append x, growing through prani's allocator.
# PRANI_ERR_NONE, or PRANI_ERR_ALLOC when the grow is refused (stdlib vec_push
# exits the process there). `v` is unchanged on a refusal. A count past
# VEC_CAP_MAX still ends the process inside the stdlib, so every caller that
# builds a buffer ranges its count first (prani_buffer_count_ok / _len_ok).
#must_use
fn prani_vec_push(v, x) {
    if (vec_push_a(prani_allocator(), v, x) < 0) { return PRANI_ERR_ALLOC; }
    return PRANI_ERR_NONE;
}

# Map a svara error code (svara's own SVARA_ERR_* are negative) to
# PRANI_ERR_SVARA. Ports `impl From<svara::error::SvaraError> for PraniError`.
# Any nonzero svara code becomes the wrapping prani code; 0 (none) passes.
#must_use
fn prani_from_svara(svara_code) {
    if (svara_code == 0) { return PRANI_ERR_NONE; }
    return PRANI_ERR_SVARA;
}

# Finite test: 1 iff x is neither +/-inf nor NaN. abs(x) < +inf holds for
# finite x, fails for infinities (inf < inf is false) and NaN (any NaN
# compare is false). Mirrors Rust `f32::is_finite`.
#must_use
fn prani_is_finite(x) {
    return f64_lt(f64_abs(x), PRANI_POS_INF);
}

# ================================================================
# Input-range guards (2.0.5). Why these exist, measured 2026-08-31 and
# re-measured 2026-11-07 on cyrius 6.6.20:
#
#   f64_clamp(NaN, lo, hi) -> NaN          NaN passes every clamp in the tree
#   f64_clamp(+inf, lo, hi) -> hi          infinities ARE bounded by clamp
#   f64_clamp(-inf, lo, hi) -> lo
#   f64_to(NaN)     -> 0                   a legal count
#   f64_to(>= 2^63) -> i64::MAX            +inf included
#   f64_to(< -2^63) -> i64::MIN            -inf included
#
# So the hazard at a clamp site is NaN specifically, not non-finiteness in
# general. A count has two hazards and neither is negative: NaN lands on 0 and
# renders a silently EMPTY buffer (audit finding F11), and an overflow lands on
# i64::MAX and pushes samples until the vec aborts the process. Before cyrius
# 6.6.8 all of them gave i64::MIN, so a floor check caught them by accident. It
# catches neither now: a count is ranged in f64, BEFORE the cast, with
# prani_sample_count_ok or, where the count becomes one buffer,
# prani_buffer_count_ok.
#
# These return 1 for "acceptable" and 0 for "reject", so a call site reads
#   if (prani_is_finite(x) == 0) { return PRANI_ERR_INVALID_TRACT; }
# and the error code stays the caller's choice -- there is no generic
# "bad parameter" code, deliberately: the oracle's five variants already carry
# the range meaning by category (PraniError::InvalidTract is documented as
# "a vocal tract parameter is out of valid range").
# ================================================================

# prani_handle_code(h, code) -- what a function returns for a handle h that is not
# a live object (h <= 0): h itself when it is already an error, so a refusal
# upstream keeps its meaning (PRANI_ERR_ALLOC stays PRANI_ERR_ALLOC), else `code`
# for a null handle. Every public function that takes a handle tests `h <= 0`
# first and returns this (2.2.1, completing ADR-0008's first rule); a function
# that returns nothing returns 0 instead, and does nothing.
#must_use
fn prani_handle_code(h, code) {
    if (h < 0) { return h; }
    return code;
}

# prani_json_int_ok(node, key) -- 1 iff `node` is an object holding `key` as a JSON
# integer, 0 for an absent key, a non-integer (a float, a string, true), a node that
# is not an object, or a null node. bayan's accessors are null-safe and read every
# one of those as 0, so a decoder that read without asking fabricated a 0: a Wolf,
# an effort of 0.0, an empty phrase (audit A2/C4/C5, 2.2.1). prani writes every f64
# as an integer bit pattern, so its own documents always pass.
#must_use
fn prani_json_int_ok(node, key) {
    if (node == 0) { return 0; }
    if (bayan_json_v_is_obj(node) == 0) { return 0; }
    if (bayan_json_v_is_int(bayan_json_v_obj_get_by_cstr(node, key)) == 0) { return 0; }
    return 1;
}

# 1 iff x is NaN: the one value that fails x <= x. The hazard at a CLAMP site
# (2.2.0's builders): f64_clamp bounds an infinity to a legal endpoint, which
# 2.0.5 decided to accept, but passes NaN through every clamp unchanged.
#must_use
fn prani_is_nan(x) {
    if (f64_le(x, x)) { return 0; }
    return 1;
}

# 1 iff both are finite.
#must_use
fn prani_finite2(a, b) {
    if (prani_is_finite(a) == 0) { return 0; }
    return prani_is_finite(b);
}

# 1 iff all three are finite.
#must_use
fn prani_finite3(a, b, c) {
    if (prani_is_finite(a) == 0) { return 0; }
    return prani_finite2(b, c);
}

# 1 iff x is finite and lo <= x <= hi. Rejects NaN (every comparison against
# NaN is false, so the two f64_ge/f64_le tests both fail).
#must_use
fn prani_in_range(x, lo, hi) {
    if (prani_is_finite(x) == 0) { return 0; }
    if (f64_ge(x, lo) == 0) { return 0; }
    return f64_le(x, hi);
}

# 1 iff x is finite and strictly greater than 0. The common case for a
# duration, a sample rate, a distance or a scale factor used as a divisor.
#must_use
fn prani_is_positive(x) {
    if (prani_is_finite(x) == 0) { return 0; }
    return f64_gt(x, 0);
}

# 1 iff x is finite and >= 0 (a duration of exactly 0 is legal -- the oracle's
# test_zero_duration_synthesis asserts an empty buffer, not an error).
#must_use
fn prani_is_non_negative(x) {
    if (prani_is_finite(x) == 0) { return 0; }
    return f64_ge(x, 0);
}

# 2^53 == 9007199254740992: the largest sample count an f64 represents exactly.
# At 44.1 kHz that is ~6470 years of audio.
var PRANI_MAX_SAMPLE_COUNT = 0x4340000000000000;

# 1 iff `raw`, a sample count still in f64, may be cast with f64_to: finite and
# within [0, PRANI_MAX_SAMPLE_COUNT]. Call it BEFORE the cast -- after it, NaN is
# a legal 0 and an overflow is i64::MAX (see the block above). This is a limit
# on what a count can MEAN, not on what fits in memory; sequence.cyr's
# prani_seq_samples_ok is the allocation ceiling for its multi-call entry points.
#must_use
fn prani_sample_count_ok(raw) {
    return prani_in_range(raw, 0, PRANI_MAX_SAMPLE_COUNT);
}

# 1 iff `raw`, a sample count still in f64, can be ONE buffer: finite and within
# [0, VEC_CAP_MAX]. Any path that hands back a whole buffer uses this rather than
# prani_sample_count_ok, because growing a vec past VEC_CAP_MAX is "vec: capacity
# overflow" and a process exit no caller can catch, so the refusal has to come
# before the first push. A stream needs only the wider check: it renders block by
# block, so its total is not a buffer.
#
# The limit is lib/vec.cyr's own constant, not a copy of it, so this refuses
# exactly what could never have succeeded. It is not a memory estimate: a buffer
# at the limit costs ~4 GiB of bump arena. An allocation refused below it is
# reported as PRANI_ERR_ALLOC since 2.2.0 (ADR-0008); past it, the stdlib still
# ends the process, which is why this check comes first.
#must_use
fn prani_buffer_count_ok(raw) {
    return prani_in_range(raw, 0, f64_from(VEC_CAP_MAX));
}

# prani_buffer_count_ok for a count that is already an integer.
#must_use
fn prani_buffer_len_ok(n) {
    if (n < 0) { return 0; }
    if (n > VEC_CAP_MAX) { return 0; }
    return 1;
}

#endif

# --- logging.cyr ---

# logging.cyr -- structured logging, wired through sakshi.
#
# The Rust crate emitted diagnostics via `tracing` (warn!/error!/trace!, gated
# behind the `logging` feature). The Cyrius port wires them for real via sakshi
# (same pattern garjan/src/logging.cyr and goonj/src/logging.cyr use). Logging is
# always compiled in; verbosity is controlled at runtime with sakshi_set_level.
# These thin wrappers take a NUL-terminated cstring and forward (ptr, len) to
# sakshi. They are called for their side effect (not #must_use); each returns 0.
#
# Requires sakshi (the stdlib leaf declared in cyrius.cyml [deps].stdlib, a
# [deps.sakshi] package through 2.1.1) + strlen (stdlib). The module file has no
# `include` lines.
#
# Mapping from the Rust oracle's tracing calls:
#   dsp.rs   tracing::error!("naad backend error")            -> prani_log_error
#   tract.rs tracing::warn!("species formants out of range")  -> prani_log_warn
#   voice.rs trace!("synthesizing creature vocalization")     -> prani_log_debug

# The five level wrappers. Each takes a NUL-terminated cstring, forwards
# (ptr, len) to the matching sakshi sink, and returns 0 -- they are called for
# their side effect, so none is #must_use. Verbosity is a RUNTIME choice
# (sakshi_set_level); nothing here is compiled out, which is why the message
# must stay a literal rather than something built per call on a hot path.
# A null `msg` logs nothing (2.2.1): through 2.2.0 these forwarded it to strlen,
# which faulted on it.
# fatal -- an unrecoverable condition; prani itself never calls this.
fn prani_log_fatal(msg) { if (msg == 0) { return 0; } sakshi_fatal(msg, strlen(msg)); return 0; }
# error -- a synthesis step failed and an error code is being returned.
fn prani_log_error(msg) { if (msg == 0) { return 0; } sakshi_error(msg, strlen(msg)); return 0; }
# warn -- degraded but continuing (ports tract.rs's out-of-range formants).
fn prani_log_warn(msg)  { if (msg == 0) { return 0; } sakshi_warn(msg, strlen(msg));  return 0; }
# info -- lifecycle notes; prani itself never calls this.
fn prani_log_info(msg)  { if (msg == 0) { return 0; } sakshi_info(msg, strlen(msg));  return 0; }
# debug -- per-call synthesis trace (ports voice.rs's tracing::trace!).
fn prani_log_debug(msg) { if (msg == 0) { return 0; } sakshi_debug(msg, strlen(msg)); return 0; }

# --- rng.cyr ---

# rng.cyr -- deterministic PCG32 PRNG for stochastic creature synthesis.
# Ports 2.0.3:rust-old/src/rng.rs (Rng struct + PCG32). Seedable for
# reproducible jitter/shimmer/breathiness across tract turbulence and
# call-pattern timing. There is no seedable float RNG in the Cyrius stdlib,
# so this is hand-ported (same PCG32 svara uses; prani's rng.rs and svara's
# rng.rs are identical).
#
# u64 semantics on i64: wrapping_mul/wrapping_add == plain `*`/`+` (i64 wraps
# two's-complement, bit-identical to u64). `>>` is LOGICAL (zero-fill) == u64
# shift. u32 truncation == `& 0xFFFFFFFF`.
#
# PARITY: next_f32's doc comment claims [-1.0, 1.0] but the Rust CODE yields
# [0.0, 1.0) -- `(next_u32() >> 1) as i32` is always non-negative. The code
# (the oracle) is ported, not the comment. Callers wanting bipolar noise do
# `2*next_f32() - 1` themselves. f32->f64 promotion: Rust used
# `1.0 / i32::MAX as f32` which rounds i32::MAX to 2^31, so the scale is
# exactly 2^-31.
#
# serde: Rng was Serialize/Deserialize (state persistence). RESTORED via
# #derive(Serialize) — PrRng_to_json / _from_json_str; the restored generator
# resumes the exact stream (tested in tests/rng.tcyr).

# prani:real-source
#ifdef PRANI_F32

var PRANI_RNG_DEFAULT_SEED = 42;                    # default deterministic seed

var PRANI_PCG_MULT   = 6_364_136_223_846_793_005;   # PCG32 LCG multiplier
var PRANI_U32_MASK   = 0xFFFFFFFF;                   # low 32 bits
#ifdef PRANI_F32
var PRANI_INV_I32MAX = 0x30000000;                  # 2^-31 = 1.0 / (i32::MAX as f32)
var PRANI_INV_2P24   = 0x33800000;                  # 2^-24: the f32 build's draw scale
#else
var PRANI_INV_I32MAX = 0x3E00000000000000;          # 2^-31 = 1.0 / (i32::MAX as f32)
#endif

# Fields TYPED (i64 u64-slots) for #derive(Serialize) — auto-generates
# PrRng_to_json / PrRng_from_json_str, porting the Rust `#[derive(Serialize,
# Deserialize)]` on Rng (state persistence for reproducible streams).
#derive(accessors)
#derive(Serialize)
struct PrRng {
    state: i64;
    inc: i64;
}

# next_u32 -- PCG32 output function. Defined before its callers (single-pass).
# NOT #must_use: it advances internal state, and prani_rng_new intentionally
# discards two warm-up draws during seeding.
fn prani_rng_next_u32(self) {
    var old_state = PrRng_state(self);
    # state = old * MULT + inc  (u64 wrapping via i64 wrap)
    PrRng_set_state(self, old_state * PRANI_PCG_MULT + PrRng_inc(self));
    # xor_shifted = (((old >> 18) ^ old) >> 27) as u32
    var xor_shifted = (((old_state >> 18) ^ old_state) >> 27) & PRANI_U32_MASK;
    # rot = (old >> 59) as u32   (top 5 bits -> 0..31)
    var rot = (old_state >> 59) & 31;
    # rotate-right by rot: (x >> rot) | (x << ((-rot) & 31)), masked to u32
    var neg = (0 - rot) & 31;
    return ((xor_shifted >> rot) | (xor_shifted << neg)) & PRANI_U32_MASK;
}

# new(seed) -- PCG32 seeding (prani's exact sequence). Calls next_u32 twice.
#must_use
fn prani_rng_new(seed) {
    var self = prani_alloc(sizeof(PrRng));
    if (self < 0) { return self; }   # PRANI_ERR_ALLOC (2.2.0)
    PrRng_set_state(self, 0);
    PrRng_set_inc(self, (seed << 1) | 1);
    prani_rng_next_u32(self);
    PrRng_set_state(self, PrRng_state(self) + seed);   # wrapping_add(seed)
    prani_rng_next_u32(self);
    return self;
}

# next_f32 -- value in [0.0, 1.0). bits = (next_u32() >> 1) in [0, 2^31-1],
# scaled by 2^-31. Matches the Rust code (not its [-1,1] doc comment).
#
# The f32 build keeps the 24 high bits of those 31 (ADR-0010). Rounding all 31 to
# f32's 24-bit significand, as the Rust did, sends the top 64 values of the range,
# 2^31 - 64 .. 2^31 - 1, to 2^31, and the draw to exactly 1.0: outside [0, 1), once
# in 2^25 draws, which a 44.1 kHz noise source reaches in about 13 minutes.
# Truncated, every draw is exact in f32 and the largest is 1 - 2^-24, within one
# f32 ulp of the f64 build's draw from the same state.
#must_use
fn prani_rng_next_f32(self) {
    var bits = prani_rng_next_u32(self) >> 1;
    #ifdef PRANI_F32
    return pr_mul(pr_from(bits >> 7), PRANI_INV_2P24);
    #else
    return pr_mul(pr_from(bits), PRANI_INV_I32MAX);
    #endif
}

# prani:real-source-end
#endif

# --- rng.cyr ---

# rng.cyr -- deterministic PCG32 PRNG for stochastic creature synthesis.
# Ports 2.0.3:rust-old/src/rng.rs (Rng struct + PCG32). Seedable for
# reproducible jitter/shimmer/breathiness across tract turbulence and
# call-pattern timing. There is no seedable float RNG in the Cyrius stdlib,
# so this is hand-ported (same PCG32 svara uses; prani's rng.rs and svara's
# rng.rs are identical).
#
# u64 semantics on i64: wrapping_mul/wrapping_add == plain `*`/`+` (i64 wraps
# two's-complement, bit-identical to u64). `>>` is LOGICAL (zero-fill) == u64
# shift. u32 truncation == `& 0xFFFFFFFF`.
#
# PARITY: next_f32's doc comment claims [-1.0, 1.0] but the Rust CODE yields
# [0.0, 1.0) -- `(next_u32() >> 1) as i32` is always non-negative. The code
# (the oracle) is ported, not the comment. Callers wanting bipolar noise do
# `2*next_f32() - 1` themselves. f32->f64 promotion: Rust used
# `1.0 / i32::MAX as f32` which rounds i32::MAX to 2^31, so the scale is
# exactly 2^-31.
#
# serde: Rng was Serialize/Deserialize (state persistence). RESTORED via
# #derive(Serialize) — PrRng_to_json / _from_json_str; the restored generator
# resumes the exact stream (tested in tests/rng.tcyr).

#
# GENERATED by scripts/gen-f64.sh from src/rng.cyr -- do not edit; edit the source and
# re-run the script. This is the f64 build of that module (ADR-0010).
#ifndef PRANI_F32

var PRANI_RNG_DEFAULT_SEED = 42;                    # default deterministic seed

var PRANI_PCG_MULT   = 6_364_136_223_846_793_005;   # PCG32 LCG multiplier
var PRANI_U32_MASK   = 0xFFFFFFFF;                   # low 32 bits
var PRANI_INV_I32MAX = 0x3E00000000000000;          # 2^-31 = 1.0 / (i32::MAX as f32)

# Fields TYPED (i64 u64-slots) for #derive(Serialize) — auto-generates
# PrRng_to_json / PrRng_from_json_str, porting the Rust `#[derive(Serialize,
# Deserialize)]` on Rng (state persistence for reproducible streams).
#derive(accessors)
#derive(Serialize)
struct PrRng {
    state: i64;
    inc: i64;
}

# next_u32 -- PCG32 output function. Defined before its callers (single-pass).
# NOT #must_use: it advances internal state, and prani_rng_new intentionally
# discards two warm-up draws during seeding.
fn prani_rng_next_u32(self) {
    var old_state = PrRng_state(self);
    # state = old * MULT + inc  (u64 wrapping via i64 wrap)
    PrRng_set_state(self, old_state * PRANI_PCG_MULT + PrRng_inc(self));
    # xor_shifted = (((old >> 18) ^ old) >> 27) as u32
    var xor_shifted = (((old_state >> 18) ^ old_state) >> 27) & PRANI_U32_MASK;
    # rot = (old >> 59) as u32   (top 5 bits -> 0..31)
    var rot = (old_state >> 59) & 31;
    # rotate-right by rot: (x >> rot) | (x << ((-rot) & 31)), masked to u32
    var neg = (0 - rot) & 31;
    return ((xor_shifted >> rot) | (xor_shifted << neg)) & PRANI_U32_MASK;
}

# new(seed) -- PCG32 seeding (prani's exact sequence). Calls next_u32 twice.
#must_use
fn prani_rng_new(seed) {
    var self = prani_alloc(sizeof(PrRng));
    if (self < 0) { return self; }   # PRANI_ERR_ALLOC (2.2.0)
    PrRng_set_state(self, 0);
    PrRng_set_inc(self, (seed << 1) | 1);
    prani_rng_next_u32(self);
    PrRng_set_state(self, PrRng_state(self) + seed);   # wrapping_add(seed)
    prani_rng_next_u32(self);
    return self;
}

# next_f32 -- value in [0.0, 1.0). bits = (next_u32() >> 1) in [0, 2^31-1],
# scaled by 2^-31. Matches the Rust code (not its [-1,1] doc comment).
#
# The f32 build keeps the 24 high bits of those 31 (ADR-0010). Rounding all 31 to
# f32's 24-bit significand, as the Rust did, sends the top 64 values of the range,
# 2^31 - 64 .. 2^31 - 1, to 2^31, and the draw to exactly 1.0: outside [0, 1), once
# in 2^25 draws, which a 44.1 kHz noise source reaches in about 13 minutes.
# Truncated, every draw is exact in f32 and the largest is 1 - 2^-24, within one
# f32 ulp of the f64 build's draw from the same state.
#must_use
fn prani_rng_next_f32(self) {
    var bits = prani_rng_next_u32(self) >> 1;
    return f64_mul(f64_from(bits), PRANI_INV_I32MAX);
}

#endif

# --- dsp.cyr ---

# dsp.cyr -- shared DSP primitives for creature vocal synthesis.
# Ports 2.0.3:rust-old/src/dsp.rs: a single-pole DC blocker (applied to all
# synthesis output) + naad error mapping. Was `pub(crate)`.
#
# Requires (from the build/test unit): error.cyr (PRANI_ERR_*, prani_is_finite)
# + logging.cyr (prani_log_error) + stdlib alloc/vec. The module file itself has
# no `include` lines.
#
# serde: DcBlocker was Serialize/Deserialize in Rust; RESTORED via
# #derive(Serialize) (f64 fields typed i64 so their exact bit patterns
# serialize losslessly). Roundtrip tested in tests/dsp.tcyr.
#
# ================================================================
# INPUT RANGES (2.0.5). dsp is a CRATE-PRIVATE module -- the oracle's
# `pub(crate) struct DcBlocker` -- so nothing here is a public entry point and
# no argument here is ever host-supplied. The ranges are still written down,
# with the guard decision for each:
#
#   dcblocker_process(b, x)        x: any f64, INCLUDING non-finite. NOT guarded
#                                  -- see the note on the function (hot path,
#                                  and x is prani's own synthesis output).
#   dcblocker_process_buffer(b, s) same. Not guarded; detects the latch instead.
#   prani_vec_extend(dst, src)     no numeric range -- copies opaque f64 bit
#                                  patterns without interpreting them.
#   prani_vec_push_zeros(v, n)     n: [0, VEC_CAP_MAX], and len + n no more
#                                  than that. 0 is VALID (nothing to append);
#                                  the rest is rejected -- guarded.
#   prani_map_naad_error(code)     any i64 -- it is a foreign code, not a range.
# ================================================================

# 0.995 pole radius: R in H(z) = (1 - z^-1) / (1 - R z^-1). Standard DC-block
# corner (~35 Hz @ 44.1 kHz). Non-integer literal -> module-top hex constant.
# prani:real-source
#ifdef PRANI_F32
#ifdef PRANI_F32

var PRANI_DCBLOCK_R = 0x3F7EB852;           # 0.995
#else
var PRANI_DCBLOCK_R = 0x3fefd70a3d70a3d7;   # 0.995
#endif

# ================================================================
# DcBlocker -- single-pole DC blocker. Removes DC offset that accumulates
# from asymmetric excitation (purr, stridulation, subharmonics).
#   x_prev : previous input sample
#   y_prev : previous output sample
#   r      : pole radius (~0.995)
# ================================================================
# Fields TYPED as i64 for #derive(Serialize): each holds an f64 BIT PATTERN, and
# serializing it as an int emits the exact 64-bit value (lossless). Typing as
# f64 would use the derive's 6-decimal float writer, which loses ~1 ULP on many
# values. Auto-generates DcBlocker_to_json / _from_json_str — ports the Rust
# `#[derive(Serialize, Deserialize)]` on DcBlocker.
#ifdef PRANI_F32
#derive(accessors)
struct DcBlocker {
    x_prev: i64;
    y_prev: i64;
    r: i64;
}

# Pr64DcBlocker -- DcBlocker as its JSON document holds it, every real an f64 bit pattern, in both
# builds (ADR-0010). Its derived encoder and decoders do the work of DcBlocker's below, so
# the f32 build reads and writes exactly the f64 build's documents.
#derive(accessors)
#derive(Serialize)
struct Pr64DcBlocker {
    x_prev: i64;
    y_prev: i64;
    r: i64;
}

# DcBlocker_to_json(self, sb) -- the f64 build's document for this DcBlocker: each real widened,
# which is exact (ADR-0010).
fn DcBlocker_to_json(self, sb) {
    var w[24];
    Pr64DcBlocker_set_x_prev(&w, pr_to64(DcBlocker_x_prev(self)));
    Pr64DcBlocker_set_y_prev(&w, pr_to64(DcBlocker_y_prev(self)));
    Pr64DcBlocker_set_r(&w, pr_to64(DcBlocker_r(self)));
    return Pr64DcBlocker_to_json(&w, sb);
}

# pr64_dc_blocker_narrow(w) -- a new DcBlocker from the document form w, each real rounded once to
# f32; w passed through when it is not a struct.
fn pr64_dc_blocker_narrow(w) {
    if (w <= 0) { return w; }
    var self = prani_alloc(sizeof(DcBlocker));
    if (self < 0) { return self; }   # PRANI_ERR_ALLOC (ADR-0008)
    DcBlocker_set_x_prev(self, pr_of64(Pr64DcBlocker_x_prev(w)));
    DcBlocker_set_y_prev(self, pr_of64(Pr64DcBlocker_y_prev(w)));
    DcBlocker_set_r(self, pr_of64(Pr64DcBlocker_r(w)));
    return self;
}

# DcBlocker_from_json_str(json) -- DcBlocker from any build's document: the f64 build's derived
# decoder, then each real rounded once to f32 (ADR-0010).
fn DcBlocker_from_json_str(json) {
    return pr64_dc_blocker_narrow(Pr64DcBlocker_from_json_str(json));
}

# DcBlocker_from_json(pairs) -- the pairs form, likewise.
fn DcBlocker_from_json(pairs) {
    return pr64_dc_blocker_narrow(Pr64DcBlocker_from_json(pairs));
}
#else
#derive(accessors)
#derive(Serialize)
struct DcBlocker {
    x_prev: i64;
    y_prev: i64;
    r: i64;
}
#endif

# new() -- zeroed state, standard pole radius.
#must_use
fn dcblocker_new() {
    var b = prani_alloc(sizeof(DcBlocker));
    if (b < 0) { return b; }   # PRANI_ERR_ALLOC (2.2.0)
    DcBlocker_set_x_prev(b, 0);
    DcBlocker_set_y_prev(b, 0);
    DcBlocker_set_r(b, PRANI_DCBLOCK_R);
    return b;
}

# process(x) -- one sample. y = x - x_prev + r*y_prev; then shift state.
#
# DELIBERATELY UNGUARDED (2.0.5). This is a RECURSIVE filter, so one non-finite
# input latches non-finite state permanently: a NaN x gives a NaN y, and y_prev
# stays NaN for every later sample even after the input recovers. A +inf x is no
# better -- y0 = +inf, then y1 = 1 - inf + r*inf = NaN (measured, pinned in
# tests/dsp.tcyr). The blocker lives inside CreatureTract and is reused across
# every synthesize call, so the poisoning outlives the buffer that caused it and
# only crtract_reset/dcblocker_reset clears it.
#
# A per-sample finite test is still the wrong fix, for two reasons:
#   1. COST -- this is the module's hot path, benchmarked at 19 ns/sample
#      (docs/benchmarks.md). prani_is_finite is an f64_abs + f64_lt, so the
#      guard would be a large fraction of the work it protects, on every sample
#      of every synthesis.
#   2. PLACE -- x is never host data. It is prani's own tract output, so a
#      non-finite x means a host number (sample_rate, f0, velocity) already got
#      through an entry point upstream. THAT is where the range guard belongs;
#      catching it here would report the symptom at the wrong layer, and this
#      function has no error channel to report it through anyway (returning a
#      negative code is impossible -- every f64 bit pattern is a legal sample).
# What this module does instead is detect the latch once, in process_buffer.
fn dcblocker_process(b, x) {
    # y = x - x_prev + r * y_prev
    var y = pr_add(pr_sub(x, DcBlocker_x_prev(b)), pr_mul(DcBlocker_r(b), DcBlocker_y_prev(b)));
    DcBlocker_set_x_prev(b, x);
    DcBlocker_set_y_prev(b, y);
    return y;
}

# process_buffer(samples) -- filter a vec of f64 samples in place.
#
# LATCH DETECTOR (2.0.5), not a range guard. The signature is unchanged and so
# is the return: this function never had an error channel, and inventing one
# here would be the signature change 2.0.5 forbids -- the callers that DO have
# one (crtract_synthesize*, which take the host's sample_rate and f0) carry the
# range guards. What is added is O(1) per BUFFER, not per sample: read the
# filter state before and after the loop and report the finite -> non-finite
# transition. That is the only place the latch is visible at all, since y_prev
# is private to the blocker and a poisoned filter is otherwise silent forever.
#
# Gating on `was_finite` means one line per latch EVENT rather than one per
# block for the rest of the process's life. The state is deliberately NOT
# repaired -- ADR-0001's rule is report, do not fabricate; the filter really is
# poisoned and dcblocker_reset is the named cure.
fn dcblocker_process_buffer(b, samples) {
    if (b <= 0) { return prani_handle_code(b, PRANI_ERR_INVALID_VOCALIZATION); }   # ADR-0008
    if (samples <= 0) { return prani_handle_code(samples, PRANI_ERR_INVALID_VOCALIZATION); }   # ADR-0008
    var was_finite = prani_is_finite(DcBlocker_y_prev(b));
    var n = vec_len(samples);
    var i = 0;
    while (i < n) {
        vec_set(samples, i, dcblocker_process(b, vec_get(samples, i)));
        i = i + 1;
    }
    if (was_finite == 1) {
        if (prani_is_finite(DcBlocker_y_prev(b)) == 0) {
            prani_log_error("prani: dc blocker state went non-finite -- filter latched until reset");
        }
    }
}

# reset() -- clear the filter memory (pole radius preserved).
fn dcblocker_reset(b) {
    DcBlocker_set_x_prev(b, 0);
    DcBlocker_set_y_prev(b, 0);
}

# ================================================================
# Shared vec loop shapes. Both existed verbatim at three call sites each before
# being extracted here, which is the bar CLAUDE.md sets ("wait for the third
# instance"). Neither changes behaviour -- they are the same loops, named.
# ================================================================

# prani_vec_extend(dst, src) -- append every element of `src` to `dst`.
# Was open-coded in sequence_call_bout_synthesize, sequence_call_phrase_synthesize
# and crvoice_vocalize_with_intent's block accumulation.
#
# UNGUARDED (2.0.5), and there is nothing here to guard: this copies opaque f64
# bit patterns and never interprets one as a number, so no element has a range.
# Scanning `src` for non-finite values would add an O(n) pass to the block
# accumulation path to reject a value that the entry point should have refused
# before any of it was synthesized -- the wrong layer, at a cost proportional to
# the audio. (The one hazard that IS real here, `src` being a negative error
# code rather than a vec, is F1's class, not an input range: all three call
# sites check prani_is_err before extending.)
fn prani_vec_extend(dst, src) {
    if (dst <= 0) { return prani_handle_code(dst, PRANI_ERR_INVALID_VOCALIZATION); }   # ADR-0008
    if (src <= 0) { return prani_handle_code(src, PRANI_ERR_INVALID_VOCALIZATION); }   # ADR-0008
    var n = vec_len(src);
    var i = 0;
    while (i < n) {
        if (prani_vec_push(dst, vec_get(src, i)) < 0) { return PRANI_ERR_ALLOC; }
        i = i + 1;
    }
    return 0;
}

# prani_vec_scale(v, k) -- multiply every sample of v by k, in place. 2.2.1
# (audit A10): this loop was written out four times, in the cat purr, vocalize's
# amplitude step, the chorus normalisation and the stream's block. Returns 0, or
# passes a dead handle on.
fn prani_vec_scale(v, k) {
    if (v <= 0) { return prani_handle_code(v, PRANI_ERR_INVALID_VOCALIZATION); }   # ADR-0008
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        vec_set(v, i, pr_mul(vec_get(v, i), k));
        i = i + 1;
    }
    return 0;
}

# prani_vec_push_zeros(v, n) -- append `n` zero samples (inter-call silence, or a
# zeroed mix/render buffer). Range: n in [0, VEC_CAP_MAX], with len + n within the
# same limit; returns 0, or PRANI_ERR_INVALID_VOCALIZATION with `v` untouched.
# Was open-coded in the bout gap, the phrase gap, the chorus mix init and
# stream_next_block.
#
# 2.0.5 SPLITS the old "non-positive appends nothing" rule in two, because the
# two halves mean opposite things:
#
#   n == 0  is VALID and stays valid. Every call site legitimately reaches it --
#           a zero gap between calls, a zero-duration chorus (the oracle's
#           test_zero_duration_synthesis asserts an EMPTY BUFFER, not an error),
#           an exhausted stream block. Nothing to append is an answer, not a
#           failure, so this still appends nothing and still returns 0.
#   n < 0   is IMPOSSIBLE as a request and is now REPORTED. A negative count
#           cannot be asked for; it can only be arithmetic that already failed:
#           `base + max_off * 2` in synthesize_chorus wraps past i64::MAX to a
#           negative (F10, reproduced in tests/dsp.tcyr at timing_spread 1e14),
#           and f64_to saturates anything below -2^63 to i64::MIN. Appending
#           nothing in that case is F11's exact complaint -- "a silent empty
#           result where an error would be better."
#   n past one vec's limit is REPORTED too, because the push it would reach is a
#   process exit: "vec: capacity overflow", and no return value to check.
#   Not catchable here, because the count no longer carries it: f64_to(NaN) is 0
#   and an overflow is i64::MAX. Call sites range the f64 BEFORE the cast
#   (prani_sample_count_ok, prani_seq_samples_ok).
#
# The buffer is untouched either way, so no valid input changes behaviour and no
# caller's output changes for ANY input: only the returned code moves, from 0 to
# a negative, on counts that were already broken. Every call site checks it.
fn prani_vec_push_zeros(v, n) {
    if (v <= 0) { return prani_handle_code(v, PRANI_ERR_INVALID_VOCALIZATION); }   # ADR-0008
    if (prani_buffer_len_ok(n) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    # Both terms are within VEC_CAP_MAX here, so this sum cannot wrap.
    if (prani_buffer_len_ok(vec_len(v) + n) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var i = 0;
    while (i < n) {
        if (prani_vec_push(v, 0) < 0) { return PRANI_ERR_ALLOC; }
        i = i + 1;
    }
    return 0;
}

# map_naad_error -- ports map_naad_error (naad-backend gated). Rust emitted a
# `tracing::error!(... "naad backend error")` and returned
# PraniError::SynthesisFailed; the Cyrius port wires the diagnostic to sakshi
# (prani_log_error) and returns PRANI_ERR_SYNTHESIS_FAILED.
#must_use
fn prani_map_naad_error(naad_code) {
    prani_log_error("prani: naad backend synthesis init failed");
    return PRANI_ERR_SYNTHESIS_FAILED;
}

# prani:real-source-end
#endif


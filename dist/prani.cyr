}

# Cat purr render into a fresh vec; a vec or a negative error.
#must_use
fn crtract_synthesize_purr(self, num_samples, purr_f0) {
    var out = prani_vec_new();
    if (out < 0) { return out; }   # PRANI_ERR_ALLOC (2.2.0)
    return crtract_synthesize_purr_into(self, num_samples, purr_f0, out);
}

# synthesize_purr(num_samples, purr_f0) -- 25-30 Hz laryngeal muscle cycling.
# Asymmetric waveform (0.4 open duty): a sharp squared half-sine pulse burst on
# the open phase excites the tract resonances; near-silence + faint noise on the
# closed phase. Returns a vec ptr on success or a negative PRANI_ERR_* on failure.
#
# 2.0.5 CONTRACT CHANGE: this used to be documented as "never fails -- no glottal
# source involved", and it has no glottal source still. What it does have is the
# phase accumulator, which is tract state that OUTLIVES the call: `phase +=
# purr_f0/sample_rate` with a non-finite purr_f0 latches `phase` non-finite for
# the tract's whole life, and every later purr then takes the closed-phase arm
# because `NaN < 0.4` is false. The output of the poisoned call is still finite
# (measured), so nothing downstream reports it -- the tract just quietly stops
# purring. That is the silent-corruption shape 2.0.5 exists to replace with a
# code, and it cannot be caught anywhere but here.
#must_use
fn crtract_synthesize_purr_into(self, num_samples, purr_f0, out) {
    if (self <= 0) { return prani_handle_code(self, PRANI_ERR_INVALID_TRACT); }   # ADR-0008
    if (out <= 0) { return prani_handle_code(out, PRANI_ERR_INVALID_VOCALIZATION); }   # ADR-0008
    if (prani_is_finite(purr_f0) == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (prani_buffer_len_ok(num_samples) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var sr = CreatureTract_sample_rate(self);
    # 2.2.1 (audit B6): the phase wraps once per sample, so the increment must sit
    # in [0, 1). A negative purr_f0 drove the phase down without bound, and one at
    # or past the sample rate up past 1, where it latched; either way the tract's
    # own JSON was then refused. The cat purr asks for 20-35 Hz.
    if (pr_lt(purr_f0, 0)) { return PRANI_ERR_INVALID_TRACT; }
    if (pr_ge(purr_f0, sr)) { return PRANI_ERR_INVALID_TRACT; }
    var tract = CreatureTract_tract(self);
    var rng = CreatureTract_rng(self);
    var phase_inc = pr_div(purr_f0, sr);
    var output = out;
    vec_truncate(output, 0);
    var i = 0;
    while (i < num_samples) {
        var phase_frac = CreatureTract_phase(self);
        var excitation = 0;
        if (pr_lt(phase_frac, PR_TR_0_4)) {
            # open phase: sharp glottal-like pulse burst (squared half-sine)
            var t = pr_div(phase_frac, PR_TR_0_4);
            var pulse = pr_sin(pr_mul(PR_PI, t));
            excitation = pr_mul(pulse, pulse);   # squared for a sharper pulse
        } else {
            # closed phase: near silence with slight noise
            excitation = pr_mul(prani_rng_next_f32(rng), PR_TR_0_02);
        }
        var ph = pr_add(CreatureTract_phase(self), phase_inc);
        if (pr_ge(ph, PR_ONE)) { ph = pr_sub(ph, PR_ONE); }
        CreatureTract_set_phase(self, ph);
        # sharp pulse excites the vocal tract -> resonant harmonics
        var ty = pr_of64(svara_tract_process_sample(tract, pr_to64(excitation)));
        if (prani_vec_push(output, ty) < 0) { return PRANI_ERR_ALLOC; }
        i = i + 1;
    }
    dcblocker_process_buffer(CreatureTract_dc_blocker(self), output);
    return output;
}

# set_formant_blend(target, target_bw, blend) -- CreatureTract::set_formant_blend.
# Blends species-default formants toward `target` by `blend` (clamped [0,1]);
# `target` / `target_bw` are 3-slot vecs (F1-F3 / B1-B3). At blend=0 uses the
# species defaults, at blend=1 uses `target`. Returns PRANI_ERR_NONE or a
# negative svara error mapped through prani.
fn crtract_set_formant_blend(self, target, target_bw, blend) {
    if (self <= 0) { return prani_handle_code(self, PRANI_ERR_INVALID_TRACT); }   # ADR-0008
    if (target <= 0) { return prani_handle_code(target, PRANI_ERR_INVALID_VOCALIZATION); }   # ADR-0008
    if (target_bw <= 0) { return prani_handle_code(target_bw, PRANI_ERR_INVALID_VOCALIZATION); }   # ADR-0008
    var params = CreatureTract_params(self);
    var bl = pr_clamp(blend, 0, PR_ONE);

    var f0 = SpeciesParams_formant0(params);
    var f1 = SpeciesParams_formant1(params);
    var f2 = SpeciesParams_formant2(params);
    var b0 = SpeciesParams_bandwidth0(params);
    var b1 = SpeciesParams_bandwidth1(params);
    var b2 = SpeciesParams_bandwidth2(params);

    # blended = base + (target - base) * blend
    var bf0 = pr_add(f0, pr_mul(pr_sub(vec_get(target, 0), f0), bl));
    var bf1 = pr_add(f1, pr_mul(pr_sub(vec_get(target, 1), f1), bl));
    var bf2 = pr_add(f2, pr_mul(pr_sub(vec_get(target, 2), f2), bl));
    var bb0 = pr_add(b0, pr_mul(pr_sub(vec_get(target_bw, 0), b0), bl));
    var bb1 = pr_add(b1, pr_mul(pr_sub(vec_get(target_bw, 1), b1), bl));
    var bb2 = pr_add(b2, pr_mul(pr_sub(vec_get(target_bw, 2), b2), bl));

    # 2.2.0: the target is a stack SvVowelTarget (ten f64s, 80 bytes; the size is
    # pinned in tests/tract.tcyr) filled by svara_vowel_target_set. Through 2.1.2
    # this was svara_vowel_target_with_bandwidths, which allocated a target svara
    # never checks on EVERY call -- once per 20 ms block for each vocalization
    # with a formant transition and for every syringeal block -- and the bump arena
    # kept each one. svara_tract_set_formants_from_target copies the values out,
    # so nothing holds the pointer past this call, and the two forms share one
    # implementation in svara, so the formants are the same bits.
    var vt[80];
    var ny = pr_mul(CreatureTract_sample_rate(self), PR_HALF);
    var bf3e = crtract_in_band(pr_mul(bf2, PR_TR_1_3), bf2, ny);   # audit B2 (ADR-0009)
    var bf4e = crtract_in_band(pr_mul(bf2, PR_TR_1_5), bf3e, ny);
    var vowel = svara_vowel_target_set(&vt,
      pr_to64(bf0), pr_to64(bf1), pr_to64(bf2), pr_to64(bf3e), pr_to64(bf4e),
      pr_to64(bb0), pr_to64(bb1), pr_to64(bb2), pr_to64(pr_mul(bb2, PR_TR_1_2)), pr_to64(pr_mul(bb2, PR_TR_1_4)));
    # Rust used `.map_err(Into::into)` -- propagate svara error through prani.
    return prani_from_svara(svara_tract_set_formants_from_target(CreatureTract_tract(self), vowel));
}

# apply_spectral_tilt(samples, tilt_db, sample_rate) -- static; first-order
# lowpass applied in place to a vec. tilt_db is dB/octave: negative = darker
# (lowpass), 0 = neutral. y[n] = (1-a)*x[n] + a*y[n-1]. The coefficient is
# derived from tilt_db directly (sample_rate unused, kept for signature parity).
# Returns PRANI_ERR_NONE, or PRANI_ERR_INVALID_TRACT for a non-finite tilt_db.
#
# 2.0.5: all three non-finite tilts were silent, and each was silent in a
# different way (measured). NaN: `|NaN| < 0.1` is false and `a < 0.01` is false,
# so a = NaN multiplied the WHOLE buffer into NaN and returned success. +inf:
# a = clamp(-inf/12) = 0, a no-op. -inf: a = clamp(+inf/12) = 0.85, the maximum
# lowpass this filter can apply -- a real, plausible-sounding filter fabricated
# out of a caller's arithmetic accident. All three now report.
fn crtract_apply_spectral_tilt(samples, tilt_db, sample_rate) {
    var cell[8];
    store64(&cell, 0);
    return crtract_apply_spectral_tilt_from(samples, tilt_db, sample_rate, &cell);
}

# apply_spectral_tilt_from(samples, tilt_db, sample_rate, state) -- the same
# lowpass, starting from and leaving its last output in the 8-byte cell `state`, so
# a signal filtered in pieces is filtered as one. 2.2.1 (ADR-0009, audit B3): the
# stream filters one block at a time, and restarting from 0 each block dipped the
# start of every block of a tilted species. A cell holding 0 is the one-shot filter.
fn crtract_apply_spectral_tilt_from(samples, tilt_db, sample_rate, state) {
    if (samples <= 0) { return prani_handle_code(samples, PRANI_ERR_INVALID_VOCALIZATION); }   # ADR-0008
    if (prani_is_finite(tilt_db) == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (pr_lt(pr_abs(tilt_db), PR_TR_0_1)) { return 0; }
    # dB/octave -> coefficient: a = clamp(-tilt_db/12, 0, 0.85)
    var a = pr_clamp(pr_div(pr_neg(tilt_db), PR_TR_12_0), 0, PR_TR_0_85);
    if (pr_lt(a, PR_TR_0_01)) { return 0; }
    var one_minus_a = pr_sub(PR_ONE, a);
    var prev = load64(state);
    var n = vec_len(samples);
    var i = 0;
    while (i < n) {
        # *s = (1-a)*x + a*prev; prev = *s
        var y = pr_add(pr_mul(one_minus_a, vec_get(samples, i)), pr_mul(a, prev));
        vec_set(samples, i, y);
        prev = y;
        i = i + 1;
    }
    store64(state, prev);
    return 0;
}

# reset -- CreatureTract::reset. Clears the svara tract state, phase, and the
# DC blocker memory.
fn crtract_reset(self) {
    if (self <= 0) { return 0; }   # ADR-0008
    svara_tract_reset(CreatureTract_tract(self));
    CreatureTract_set_phase(self, 0);
    CreatureTract_set_clock(self, 0);
    dcblocker_reset(CreatureTract_dc_blocker(self));
}

# prani:real-source-end
#endif

# --- tract.cyr ---

# tract.cyr -- creature-specific vocal tract models.
# Ports 2.0.3:rust-old/src/tract.rs. Wraps svara's VocalTract / GlottalSource /
# FormantFilter (+ naad BiquadFilter under naad-backend, the shipped default)
# with species-specific formant targets and vocal-apparatus-driven excitation.
#
# Synthesis strategy depends on the vocal apparatus:
#   Laryngeal / Syringeal : glottal source through the formant-shaping tract
#   NoiseOnly             : filtered broadband noise (naad bandpass) -- snakes
#   Stridulatory          : discrete/continuous AM tone -- insects
#   Vibratile             : continuous wing-beat modulation -- bees/flies
#
# Requires (from the build/test unit, in dependency order): stdlib alloc/vec/
# math, hisab, goonj, naad (filter_biquad_new/process_sample, NAAD_FILTER_BANDPASS),
# svara (svara_tract_*/svara_glottal_*/svara_vowel_target_with_bandwidths,
# svara_is_err), error.cyr, rng.cyr, dsp.cyr, species.cyr. Module files carry
# no `include` lines -- the entry orders them.
#
# FLOATS: a real is the build's float, f64 or f32 (ADR-0010). svara and naad are f64
# in both builds, so every call into them widens with pr_to64 and every result is
# narrowed with pr_of64. Integer literals via pr_from(n); non-integers via the
# module-top constant pairs below (decimals in comments).
#
# PARITY NOTE (naad-backend default): NoiseOnly pre-builds a naad bandpass filter
# (default features), and synthesize_noise uses it; the svara FormantFilter
# fallback is dropped (documented deviation). The bandpass can be absent: naad
# refuses its centre at or past Nyquist (snake F1 2500 Hz at 5000 Hz or below),
# and synthesize_noise then reports PRANI_ERR_SYNTHESIS_FAILED. Exact svara-
# internal bit parity vs the f32 oracle is not attainable (f32->f64 diverges
# through svara's own DSP); tests assert structural parity + finiteness +
# determinism instead. See tests/tract.tcyr parity_notes.
#
# INPUT RANGES: every fallible entry point here range-checks its numeric input
# (roadmap 2.0.5, audit F11). The table, the measurements behind it, and what is
# deliberately left unguarded are in the INPUT RANGES block below the constants.

# ================================================================
# Non-integer literal constants (IEEE-754 hex; decimals in comments).
# ================================================================
#
# GENERATED by scripts/gen-f64.sh from src/tract.cyr -- do not edit; edit the source and
# re-run the script. This is the f64 build of that module (ADR-0010).
#ifndef PRANI_F32
var PR_TR_1_3   = 0x3ff4cccccccccccd;   # 1.3   F4 estimate multiplier
var PR_TR_1_5   = 0x3ff8000000000000;   # 1.5   F5 estimate multiplier
var PR_TR_1_2   = 0x3ff3333333333333;   # 1.2   B4 estimate multiplier
var PR_TR_1_4   = 0x3ff6666666666666;   # 1.4   B5 estimate multiplier
var PR_TR_0_05  = 0x3fa999999999999a;   # 0.05  jitter clamp ceiling
var PR_TR_0_1   = 0x3fb999999999999a;   # 0.1   shimmer clamp ceiling / tilt abs threshold
var PR_TR_0_5   = 0x3fe0000000000000;   # 0.5   sub_f0 mult / tone mix / mod_rate / env thresholds
var PR_TR_1_498 = 0x3ff7f7ced916872b;   # 1.498 syringeal second-source ratio (~perfect fifth)
var PR_TR_0_6   = 0x3fe3333333333333;   # 0.6   tone2 amplitude
var PR_TR_0_25  = 0x3fd0000000000000;   # 0.25  stridulatory/vibratile signal scale
var PR_TR_0_3   = 0x3fd3333333333333;   # 0.3   second-harmonic amplitude
var PR_TR_2_5   = 0x4004000000000000;   # 2.5   cricket chirp rate (Hz)
var PR_TR_30_0  = 0x403e000000000000;   # 30.0  cricket syllable rate (Hz)
var PR_TR_0_4   = 0x3fd999999999999a;   # 0.4   purr open-phase duty
var PR_TR_0_02  = 0x3f947ae147ae147b;   # 0.02  purr closed-phase noise scale
var PR_TR_0_85  = 0x3feb333333333333;   # 0.85  spectral-tilt coefficient clamp ceiling
var PR_TR_0_01  = 0x3f847ae147ae147b;   # 0.01  spectral-tilt coefficient floor
var PR_TR_12_0  = 0x4028000000000000;   # 12.0  dB/octave -> coefficient divisor

# ================================================================
# INPUT RANGES (2.0.5, audit F11). Every fallible entry point in this module
# rejects input outside the range below with a negative PRANI_ERR_* instead of
# synthesizing from it. The helpers live in error.cyr; the error code is chosen
# by CATEGORY, from the oracle's own five variants -- there is no generic "bad
# parameter" code.
#
#   parameter                                  range      code
#   -------------------------------------------------------------------------
#   f0        (laryngeal/syringeal/            finite     PRANI_ERR_INVALID_TRACT
#              stridulatory/vibratile)
#   purr_f0   (synthesize_purr)                finite     PRANI_ERR_INVALID_TRACT
#   tilt_db   (apply_spectral_tilt)            finite     PRANI_ERR_INVALID_TRACT
#   num_samples (every synthesis path)  [0, VEC_CAP_MAX]  PRANI_ERR_INVALID_VOCALIZATION
#   subharmonic_amp / perturbation_scale       finite     PRANI_ERR_INVALID_VOCALIZATION
#   from_json_str "phase"                      [0, 1]     PRANI_ERR_INVALID_TRACT
#   from_json_str "dcb_x_prev" / "dcb_y_prev"  finite     PRANI_ERR_INVALID_TRACT
#   from_json_str "dcb_r"                      [0, 1)     PRANI_ERR_INVALID_TRACT
#
# Why FINITE and not a magnitude band for f0 / purr_f0 / tilt_db: every finite
# value is already bounded where it is used. f0 is clamped into the species band
# on the glottal paths and drives a sine elsewhere; tilt_db's coefficient is
# clamped to [0, 0.85]; purr_f0 only sets a phase increment. A band would be a
# number invented here, and ADR-0001 rejected inventing one (it declined to
# restate svara's sample-rate threshold for the same reason). What a finite
# value cannot do is any of the following, all MEASURED 2026-08-31 on the
# pre-guard tree and pinned as assertions in tests/tract.tcyr:
#
#   crtract_synthesize(bee,      +inf, 32) -> SUCCESS, buffer all NaN  (sin(inf))
#   crtract_synthesize(bee,       NaN, 32) -> SUCCESS, buffer all NaN
#   crtract_synthesize(cricket,  +inf, 32) -> SUCCESS, buffer all NaN
#   crtract_synthesize(songbird,  NaN, 32) -> SUCCESS, buffer all NaN  (clamp
#                                             passes NaN; NaN <= 2000 is false,
#                                             so the dual-source arm runs raw)
#   crtract_synthesize(wolf, 220, -5)      -> SUCCESS, EMPTY buffer
#   crtract_synthesize_purr(cat, 32, NaN)  -> finite output, tract phase LATCHED
#                                             non-finite for the tract's life
#   crtract_apply_spectral_tilt(buf, NaN)  -> whole buffer NaN
#   options(NaN, _)                        -> silently takes the NO-subharmonic
#                                             arm (f64_gt(NaN, 0) is false)
#
# The last one is the shape this milestone is really about: not a crash, but a
# plausible-looking answer fabricated from a value the caller never meant.
#
# NOT guarded here, deliberately:
#   * crtract_new's sample_rate -- svara owns that rule and reports it (ADR-0001).
#   * crtract_set_formant_blend's blend / target / target_bw -- MEASURED: svara
#     already rejects a NaN blend, a NaN target formant, an infinite target
#     bandwidth (since svara 3.6.3) and a finite one whose coefficients overflow
#     (since svara 3.6.5, its ADR-0010). Each returns an error through
#     prani_from_svara, and the tract is left synthesizing finite audio.
#     A guard here would restate a dependency's rule, which is the thing ADR-0001
#     says goes stale silently.
#   * apply_spectral_tilt's sample_rate -- the function never reads it (the
#     coefficient comes from tilt_db alone; the parameter exists for oracle
#     signature parity). Rejecting a value a function does not read reports a
#     failure that cannot happen.
#   * options on the stridulatory path -- never read there either (the oracle
#     writes `let _ = options`). Same rule.
#   * from_json_str "rng_state" -- every 64-bit pattern is a reachable PCG32 state.
#     "rng_inc" is not free: it is odd by construction, and since 2.2.1 an even one
#     is refused (audit B5).
# ================================================================

# ================================================================
# SynthesisOptions -- per-block synthesis modifiers passed voice -> tract.
#   subharmonic_amp   : subharmonic amplitude (0.0 = none), injected pre-tract
#   perturbation_scale: jitter/shimmer intensity multiplier (0.0-2.0)
# Default = both 0.0 (see crtract_options_default).
# ================================================================
#derive(accessors)
struct SynthesisOptions { subharmonic_amp; perturbation_scale; }

# options_default -- SynthesisOptions::default() (both fields 0.0).
#must_use
fn crtract_options_default() {
    var o = prani_alloc(sizeof(SynthesisOptions));
    if (o < 0) { return o; }   # PRANI_ERR_ALLOC (2.2.0)
    SynthesisOptions_set_subharmonic_amp(o, 0);
    SynthesisOptions_set_perturbation_scale(o, 0);
    return o;
}

# options_new -- explicit constructor for tests / callers.
#must_use
fn crtract_options_new(subharmonic_amp, perturbation_scale) {
    var o = prani_alloc(sizeof(SynthesisOptions));
    if (o < 0) { return o; }   # PRANI_ERR_ALLOC (2.2.0)
    SynthesisOptions_set_subharmonic_amp(o, subharmonic_amp);
    SynthesisOptions_set_perturbation_scale(o, perturbation_scale);
    return o;
}

# ================================================================
# CreatureTract -- a creature's vocal tract, configured for one species.
#   tract        : inner svara VocalTract ptr
#   params       : SpeciesParams ptr (species vocal parameters)
#   rng          : PrRng ptr (noise-based synthesis)
#   sample_rate  : sample rate (Hz)
#   phase        : running phase accumulator (sample-accurate across blocks)
#   dc_blocker   : DcBlocker ptr (applied to all synthesis output)
#   noise_filter : naad BiquadFilter ptr for noise shaping, or 0 (== None)
# serde RESTORED via crtract_to_json / crtract_from_json_str (below): the
# reconstructable state roundtrips; the opaque svara tract is rebuilt from params.
# ================================================================
#derive(accessors)
struct CreatureTract {
    tract; params; rng; sample_rate; phase; dc_blocker; noise_filter;
    clock;
}

# crtract_in_band(est, below, nyquist) -- one of the two formants prani estimates
# above the species' three (1.3x and 1.5x F3), kept inside the band. svara refuses a
# five-formant target if any formant is not below Nyquist, and it used to refuse
# the species' REAL F1-F3 with it: a dog, cat, crow or raptor at 8 kHz, a songbird or
# raptor at 22.05 kHz, rendered through svara's default vowel (audit B2, 2.2.1,
# ADR-0009). An estimate at or past Nyquist is placed halfway between the formant
# below it and Nyquist, so F3 < F4 < F5 < Nyquist holds and nothing is invented but
# the midpoint. An estimate already in band is returned as it is, so every render
# whose estimates were in band (every species at 44.1 kHz) is unchanged.
#must_use
fn crtract_in_band(est, below, nyquist) {
    if (f64_lt(est, nyquist)) { return est; }
    return f64_mul(f64_add(below, nyquist), PR_HALF);
}

# new(params, sample_rate) -- CreatureTract::new. Configures the svara tract
# with species-specific formants (F4/F5 estimated at 1.3x/1.5x F3), pre-builds
# a naad bandpass for NoiseOnly species, seeds the rng from the species'
# resonance seed. Rust only WARNS if set_formants_from_target errors, then
# continues -- so that return is ignored here too.
#
# Returns a CreatureTract ptr on success, or a NEGATIVE PRANI_ERR_* on failure.
#
# The error return is a DIVERGENCE FROM THE ORACLE, and a necessary one
# (ADR-0001). `2.0.3:rust-old/src/tract.rs:CreatureTract::new` returns `Self`,
# because the svara it was written against had an INFALLIBLE `VocalTract::new`.
# svara 3.x hardened that constructor to return a checkable negative code
# instead of panicking (svara's own ADR: "`svara_tract_new` errors where Rust
# panics"), and it rejected every sample_rate <= 1000 Hz as well as negative and
# non-finite ones. (That floor moved to >1200 Hz in svara 3.5.4, which repaired
# two defects prani found -- see F12 in tests/hardening.tcyr. The <=1000 figure
# is the measurement ADR-0001 was written against, kept for that reason.)
# The port kept the oracle's shape and used the return AS A
# POINTER regardless -- so `svara_tract_set_formants_from_target(-1, target)`
# dereferenced -1 and the process took SIGSEGV. Checking it is mandatory, and
# the check cannot be hidden inside this function because there is no valid
# tract to return.
#must_use
fn crtract_new(params, sample_rate) {
    # 2.2.0: `params` usually comes from species_params, which can now report a
    # refused allocation; an error passes through rather than being read, and a
    # null is refused (2.2.1).
    if (params <= 0) { return prani_handle_code(params, PRANI_ERR_INVALID_SPECIES); }
    var tract = svara_tract_new((sample_rate));
    if (svara_is_err(tract) == 1) {
        prani_log_error("prani: svara vocal tract rejected the sample rate");
        return prani_from_svara(tract);
    }

    var f0 = SpeciesParams_formant0(params);
    var f1 = SpeciesParams_formant1(params);
    var f2 = SpeciesParams_formant2(params);
    var b0 = SpeciesParams_bandwidth0(params);
    var b1 = SpeciesParams_bandwidth1(params);
    var b2 = SpeciesParams_bandwidth2(params);

    # F4/F5 estimated at 1.3x/1.5x F3; B4/B5 at 1.2x/1.4x B3. 2.2.0: the target is
    # on the stack (80 bytes, see crtract_set_formant_blend), not one
    # svara allocates and never checks: the setter copies its values out.
    var vt[80];
    var ny = f64_mul(sample_rate, PR_HALF);
    var f3e = crtract_in_band(f64_mul(f2, PR_TR_1_3), f2, ny);   # audit B2 (ADR-0009)
    var f4e = crtract_in_band(f64_mul(f2, PR_TR_1_5), f3e, ny);
    var target = svara_vowel_target_set(&vt,
      (f0), (f1), (f2), (f3e), (f4e),
      (b0), (b1), (b2), (f64_mul(b2, PR_TR_1_2)), (f64_mul(b2, PR_TR_1_4)));
    # Rust: `if let Err(e) = ... { warn!(...) }` then continue. Ports the
    # tracing::warn! to sakshi (prani_log_warn), preserving warn-then-continue.
    var _fmt_rc = svara_tract_set_formants_from_target(tract, target);
    if (prani_is_err(_fmt_rc) == 1) {
        prani_log_warn("prani: species formants out of range, using defaults");
    }

    # naad-backend: pre-build a bandpass for NoiseOnly (snakes). Error -> None(0).
    var noise_filter = 0;
    if (SpeciesParams_apparatus(params) == PRANI_APP_NOISE_ONLY) {
        var nf = filter_biquad_new(NAAD_FILTER_BANDPASS, (sample_rate), (f0), f64_from(2));
        # 2.2.0: since naad 2.3.4 a refused allocation inside the constructor comes
        # back as NAAD_ERR_ALLOCATION (naad ADR-0010). That is not the oracle's
        # "this species cannot have a filter" (which surfaces, as before, when the
        # noise path is rendered); it is memory, so it is reported here.
        if (nf == NAAD_ERR_ALLOCATION) { return PRANI_ERR_ALLOC; }
        if (prani_is_err(nf) == 0) { noise_filter = nf; }
    }

    var self = prani_alloc(sizeof(CreatureTract));
    if (self < 0) { return self; }   # PRANI_ERR_ALLOC (2.2.0)
    var rng = prani_rng_new(species_params_resonance_seed(params));
    if (prani_is_err(rng) == 1) { return rng; }
    var dcb = dcblocker_new();
    if (prani_is_err(dcb) == 1) { return dcb; }
    CreatureTract_set_tract(self, tract);
    CreatureTract_set_params(self, params);
    CreatureTract_set_rng(self, rng);
    CreatureTract_set_sample_rate(self, sample_rate);
    CreatureTract_set_phase(self, 0);
    CreatureTract_set_dc_blocker(self, dcb);
    CreatureTract_set_noise_filter(self, noise_filter);
    CreatureTract_set_clock(self, 0);
    return self;
}

# CreatureTract serde -- restores the Rust `#[derive(Serialize, Deserialize)]`.
# The inner svara VocalTract + naad BiquadFilter are opaque (no Cyrius serialize
# surface), so only the RECONSTRUCTABLE state is serialized: sample_rate, phase,
# the rng (state/inc), the dc_blocker (x_prev/y_prev/r), and the SpeciesParams
# (nested). On deserialize, crtract_new(params, sample_rate) rebuilds the svara
# tract + naad filter + a fresh rng/dc_blocker, then the serialized rng/phase/
# dc_blocker state is restored over them. f64 scalars serialize as exact i64 bit
# patterns (lossless).
#
# DEVIATION (documented, not hidden): the Rust derive serialized the svara
# tract's live filter history; the port rebuilds it from params instead (svara
# is f64-opaque here). The species-determined response is bit-identical after
# rebuild; only in-flight filter memory (which decays within a few samples) is
# reset. Same tradeoff garjan makes rebuilding naad from config.
fn crtract_to_json(self, sb) {
    if (self <= 0) { return prani_handle_code(self, PRANI_ERR_INVALID_TRACT); }   # ADR-0008
    if (sb <= 0) { return prani_handle_code(sb, PRANI_ERR_INVALID_TRACT); }   # ADR-0008
    var rng = CreatureTract_rng(self);
    var dc = CreatureTract_dc_blocker(self);
    str_builder_add_cstr(sb, "{\"sample_rate\":");
    str_builder_add_int(sb, (CreatureTract_sample_rate(self)));
    str_builder_add_cstr(sb, ",\"phase\":");
    str_builder_add_int(sb, (CreatureTract_phase(self)));
    str_builder_add_cstr(sb, ",\"rng_state\":");
    str_builder_add_int(sb, PrRng_state(rng));
    str_builder_add_cstr(sb, ",\"rng_inc\":");
    str_builder_add_int(sb, PrRng_inc(rng));
    str_builder_add_cstr(sb, ",\"dcb_x_prev\":");
    str_builder_add_int(sb, (DcBlocker_x_prev(dc)));
    str_builder_add_cstr(sb, ",\"dcb_y_prev\":");
    str_builder_add_int(sb, (DcBlocker_y_prev(dc)));
    str_builder_add_cstr(sb, ",\"dcb_r\":");
    str_builder_add_int(sb, (DcBlocker_r(dc)));
    # 2.2.1 (ADR-0009): the clock is prani state, so it roundtrips (ADR-0005). It is
    # a sample count, written as a plain integer, not as f64 bits.
    str_builder_add_cstr(sb, ",\"clock\":");
    str_builder_add_int(sb, CreatureTract_clock(self));
    str_builder_add_cstr(sb, ",\"params\":");
    SpeciesParams_to_json(CreatureTract_params(self), sb);
    str_builder_add_cstr(sb, "}");
    return 0;
}

# from_json_str(json) -- rebuild a CreatureTract from crtract_to_json output.
# `json` is a NUL-terminated cstring. The opaque svara tract and naad filter are
# reconstructed from the serialized SpeciesParams (see the DEVIATION note above),
# then the saved rng / phase / dc_blocker state is restored over the rebuild.
# Returns the CreatureTract ptr, or a NEGATIVE PRANI_ERR_INVALID_TRACT if `json`
# is 0, does not parse, carries an out-of-range field, or names a sample rate
# svara rejects.
#
# 2.0.5 (ADR-0002 deferred field ranges to roadmap 2.0.5, docs/development/
# roadmap.md): every scalar below arrives as a RAW f64
# BIT PATTERN named by the document -- `bayan_json_v_int` hands back whatever
# 64-bit integer was written, and the fields are f64s reinterpreted -- so a
# hostile document can spell NaN or inf directly and no amount of parse checking
# will notice. The ranges:
#
#   phase       [0, 1]   the accumulator's own invariant: it is compared against
#                        0.4 and wrapped at 1.0. A NaN phase makes both compares
#                        false forever (permanent closed phase, never wraps);
#                        an out-of-band phase counts down at 1.0 per sample.
#                        The wrap subtracts 1.0 at most once per sample, so a
#                        purr driven at purr_f0 >= sample_rate could leave phase
#                        above 1 and its own json would be refused on read.
#                        Since 2.2.1 crtract_synthesize_purr refuses such a
#                        purr_f0 (audit B6), so no tract can reach that state.
#   clock       >= 0     the tract's sample clock (2.2.1, ADR-0009), a plain
#                        integer. OPTIONAL: a document written before 2.2.1 has
#                        none, and 0 is exactly the time base such a tract had,
#                        since it restarted at every call. Present, it must be
#                        an integer and not negative.
#   dcb_x_prev  finite   filter memory. Any finite sample is legal -- these are
#   dcb_y_prev  finite   post-amplitude audio values, so no magnitude band
#                        belongs here -- but a non-finite one poisons every
#                        sample the blocker will ever emit (dsp.cyr reports the
#                        latch; it cannot undo it).
#   dcb_r       [0, 1)   the pole radius, and this one is a STABILITY bound, not
#                        a taste one: y = x - x_prev + r*y_prev diverges for
#                        |r| >= 1. dcblocker_new writes 0.995 and nothing else
#                        ever writes it, so prani's own output always passes.
#
# The checks run BEFORE crtract_new, so a rejected document costs no tract.
# sample_rate is deliberately NOT checked here: svara owns that threshold and
# crtract_new reports its rejection (ADR-0001 -- restating a dependency's
# constant is how it goes stale). rng_state is not checked: every 64-bit pattern is
# a reachable PCG32 state. rng_inc must be odd (2.2.1, audit B5), and every field
# must be present and an integer.
fn crtract_from_json_str(json) {
    if (json == 0) { return PRANI_ERR_INVALID_TRACT; }
    var root = bayan_json_v_parse_buf(json, strlen(json));
    if (root == 0) { return PRANI_ERR_INVALID_TRACT; }
    # 2.2.1 (audit B5): every field present and an integer. An absent rng pair read
    # as state 0 / inc 0, a fixed point of PCG32, so the noise paths rendered exact
    # silence as success.
    if (prani_json_int_ok(root, "sample_rate") == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (prani_json_int_ok(root, "phase") == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (prani_json_int_ok(root, "rng_state") == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (prani_json_int_ok(root, "rng_inc") == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (prani_json_int_ok(root, "dcb_x_prev") == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (prani_json_int_ok(root, "dcb_y_prev") == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (prani_json_int_ok(root, "dcb_r") == 0) { return PRANI_ERR_INVALID_TRACT; }
    # PCG32's increment is odd by construction (prani_rng_new sets the low bit); an
    # even one is not a state prani_rng_new can make, and 0 with state 0 never moves.
    if ((bayan_json_v_int(bayan_json_v_obj_get_by_cstr(root, "rng_inc")) & 1) == 0) { return PRANI_ERR_INVALID_TRACT; }

    var phase = (bayan_json_v_int(bayan_json_v_obj_get_by_cstr(root, "phase")));
    var dcb_x = (bayan_json_v_int(bayan_json_v_obj_get_by_cstr(root, "dcb_x_prev")));
    var dcb_y = (bayan_json_v_int(bayan_json_v_obj_get_by_cstr(root, "dcb_y_prev")));
    var dcb_r = (bayan_json_v_int(bayan_json_v_obj_get_by_cstr(root, "dcb_r")));
    if (prani_in_range(phase, 0, PR_ONE) == 0) { return PRANI_ERR_INVALID_TRACT; }
    var clock = 0;
    var n_clock = bayan_json_v_obj_get_by_cstr(root, "clock");
    if (n_clock != 0) {
        if (bayan_json_v_is_int(n_clock) == 0) { return PRANI_ERR_INVALID_TRACT; }
        clock = bayan_json_v_int(n_clock);
        if (clock < 0) { return PRANI_ERR_INVALID_TRACT; }
    }
    if (prani_finite2(dcb_x, dcb_y) == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (prani_is_non_negative(dcb_r) == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (f64_lt(dcb_r, PR_ONE) == 0) { return PRANI_ERR_INVALID_TRACT; }

    var params = species_params_from_node(bayan_json_v_obj_get_by_cstr(root, "params"));
    # species.cyr ranges the nested params object itself (2.0.5); propagate its
    # code rather than restating it, exactly as the crtract_new check below does.
    if (prani_is_err(params) == 1) { return params; }
    var sample_rate = (bayan_json_v_int(bayan_json_v_obj_get_by_cstr(root, "sample_rate")));
    # rebuild the svara tract + naad filter + fresh rng/dc_blocker from params
    var self = crtract_new(params, sample_rate);
    if (prani_is_err(self) == 1) { return self; }
    # then restore the serialized rng / phase / clock / dc_blocker state over the rebuild
    CreatureTract_set_phase(self, phase);
    CreatureTract_set_clock(self, clock);
    var rng = CreatureTract_rng(self);
    PrRng_set_state(rng, bayan_json_v_int(bayan_json_v_obj_get_by_cstr(root, "rng_state")));
    PrRng_set_inc(rng, bayan_json_v_int(bayan_json_v_obj_get_by_cstr(root, "rng_inc")));
    var dc = CreatureTract_dc_blocker(self);
    DcBlocker_set_x_prev(dc, dcb_x);
    DcBlocker_set_y_prev(dc, dcb_y);
    DcBlocker_set_r(dc, dcb_r);
    return self;
}

# ---- private synthesis paths ------------------------------------------------

# ================================================================
# THE EXCITATION LEVEL (2.1.2, ADR-0007). prani's gain stage was set against the oracle's
# glottal source: a Rosenberg pulse that peaks at 1.0, mixed with aspiration noise
# as `pulse*(1-b) + noise*b*0.3*gate` (svara 1.0.0, 2.0.3:rust-old's dep). Every
# level downstream of it -- effort and intent amplitude, the subharmonic and
# biphonation sines added in voice.cyr, the breathiness of each species -- is a
# level relative to that unit-peak pulse.
#
# svara 3.11.0 (its ADR-0014) corrected the pulse to Rosenberg's full B, with a
# closing phase, and scaled it by SV_G_ROSENBERG_GAIN (7.13, +17.06 dB) so that a
# human /a/ keeps its loudness. The noise is not scaled. svara is right about the
# shape, and its gain is right for svara: it was solved where a human voice's
# energy sits, at harmonics 5-20 of f0. A creature tract is not there. Wolf F1 is
# 420 Hz at an f0 of 400, so its output sits in the lowest harmonics, which carry
# the full gain: through 2.1.1's gain stage, wolf came out 14 dB louder (median
# across its vocalizations, up to 17), a wolf howl+bark phrase peaked at 2.24
# where it peaked at 0.40, and every species was 17 dB less breathy than its
# params say.
#
# So prani takes svara's corrected SHAPE into the oracle's gain stage, in two
# steps.
#
# 1. The oracle's excitation. Divide the pulse's peak back out and restore the
#    oracle's pulse-to-noise balance. svara's mix is linear in its breathiness b',
#    with the pulse at peak g:
#        s = g*p*(1-b') + n*b'*0.3*gate
#    Choosing  b' = g*b / (1 - b + g*b)  and scaling by  (1 - b + g*b) / g  gives
#        p*(1-b) + n*b*0.3*gate
#    which is the oracle's excitation with p the unit-peak corrected pulse,
#    exactly. At b = 0 the scale is 1/g; at b = 1, b' = 1 and the scale is 1.
#    tests/tract.tcyr's excitation group pins both facts this rests on (the peak
#    is g, and the mix is linear in b), so a svara change to either fails there.
#
# 2. The oracle's loudness. A unit-peak full-B pulse is darker than the oracle's,
#    which dropped from 1 to 0 at once, so step 1 alone leaves prani quieter: 7.4
#    dB at the median, and fantasy falls under the oracle's own audibility bar
#    (tests/voice.tcyr, "max |s| > 0.001"). That is the bar svara hit, and prani
#    answers it the way svara did, with one gain solved against the old level:
#    PR_TR_EXC_GAIN below, +7.37 dB. Method: every species x vocalization the
#    species supports, through crvoice_vocalize at 44.1 kHz for 0.1 s, keeping the
#    56 renders whose glottal part carries more than half the RMS (the rest are
#    dominated by voice.cyr's subharmonic and biphonation sines, or never use the
#    source). The gain is the one at which the median of their RMS changes against
#    prani 2.1.1 is 0 dB. Around it they spread from -6.9 to +7.1 dB, and that
#    spread is the timbre svara corrected, which no single gain can or should undo.
#    The loudest render anywhere in that sweep peaks at 0.786; 2.1.1's peaked at
#    0.810.
var PR_TR_EXC_GAIN = 0x4002b14249472616;   # 2.336552212222851  (+7.37 dB), step 2 above

# crtract_pulse_peak(glottal) -- the peak of the voiced pulse svara will emit:
# SV_G_ROSENBERG_GAIN for the Rosenberg model, which is the only one prani builds
# (svara_glottal_new's default; prani never calls set_model). Read from svara, not
# copied, so a recalibration there flows through and a rename fails the build.
# 1.0 for any other model, whose pulse svara leaves at unit peak.
fn crtract_pulse_peak(glottal) {
    if (svara_glottal_model(glottal) == SVARA_GLOTTAL_ROSENBERG) { return (SV_G_ROSENBERG_GAIN); }
    return PR_ONE;
}

# crtract_svara_breathiness(b, g) -- the breathiness to hand svara so that its
# noise-to-pulse balance at pulse peak g is the oracle's at breathiness b:
# g*b / (1 - b + g*b). b is a species breathiness in [0, 1] (clamped upstream),
# and g >= 1, so the denominator is >= 1 and the result stays in [0, 1].
fn crtract_svara_breathiness(b, g) {
    var gb = f64_mul(g, b);
    return f64_div(gb, f64_add(f64_sub(PR_ONE, b), gb));
}

# crtract_excitation_scale(b, g) -- the factor that takes svara's sample, built
# with crtract_svara_breathiness(b, g), into prani's gain stage:
# (1 - b + g*b) / g for the oracle's excitation (step 1), times PR_TR_EXC_GAIN
# for the oracle's loudness (step 2).
fn crtract_excitation_scale(b, g) {
    return f64_mul(f64_div(f64_add(f64_sub(PR_ONE, b), f64_mul(g, b)), g), PR_TR_EXC_GAIN);
}

# crtract_glottal_new(clamped_f0, sr, params, pert) -- the glottal source both
# voiced paths share: svara's source at the species' breathiness, jitter and
# shimmer (jitter/shimmer scaled by the block's perturbation, clamped to
# 0.05/0.1 as the oracle does), with the breathiness converted for the
# excitation level above. Returns the source, or svara's negative error code.
# The caller multiplies every sample by crtract_excitation_scale(b, g).
fn crtract_glottal_new(clamped_f0, sr, params, pert) {
    var glottal = svara_glottal_new((clamped_f0), (sr));
    if (svara_is_err(glottal) == 1) { return glottal; }
    var b = f64_clamp(SpeciesParams_breathiness(params), 0, PR_ONE);
    svara_glottal_set_breathiness(glottal, (crtract_svara_breathiness(b, crtract_pulse_peak(glottal))));
    var ps = f64_max(pert, 0);
    svara_glottal_set_jitter(glottal, (f64_min(f64_mul(SpeciesParams_jitter(params), ps), PR_TR_0_05)));
    svara_glottal_set_shimmer(glottal, (f64_min(f64_mul(SpeciesParams_shimmer(params), ps), PR_TR_0_1)));
    return glottal;
}

# synthesize_laryngeal -- glottal source through the vocal tract (mammals).
# Returns a vec (heap ptr) on success or a negative PRANI_ERR_* on failure.
#
# 2.0.5 guards: f0 finite, num_samples in range, both option fields finite (see the
# INPUT RANGES block). A non-finite f0 was already reported on THIS path -- the
# clamp passes NaN through and svara_glottal_new refuses it (measured: an error,
# not a NaN buffer) -- so the guard changes only which code comes back
# (PRANI_ERR_INVALID_TRACT, prani's own parameter, rather than PRANI_ERR_SVARA)
# and makes the contract the same on all five apparatus paths, four of which had
# no such backstop.
fn crtract_synthesize_laryngeal_into(self, f0, num_samples, options, out) {
    if (self <= 0) { return prani_handle_code(self, PRANI_ERR_INVALID_TRACT); }   # ADR-0008
    if (options <= 0) { return prani_handle_code(options, PRANI_ERR_INVALID_VOCALIZATION); }   # ADR-0008
    if (out <= 0) { return prani_handle_code(out, PRANI_ERR_INVALID_VOCALIZATION); }   # ADR-0008
    if (prani_is_finite(f0) == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (prani_buffer_len_ok(num_samples) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var sub_amp = SynthesisOptions_subharmonic_amp(options);
    var pert = SynthesisOptions_perturbation_scale(options);
    if (prani_finite2(sub_amp, pert) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }

    var params = CreatureTract_params(self);
    var sr = CreatureTract_sample_rate(self);
    var tract = CreatureTract_tract(self);

    # clamp f0 to [max(f0_min,20), min(f0_max,2000)]
    var lo = f64_max(SpeciesParams_f0_min(params), f64_from(20));
    var hi = f64_min(SpeciesParams_f0_max(params), f64_from(2000));
    # 2.2.1 (audit B11): a species whose f0_max is below the 20 Hz floor has no f0
    # to clamp to. f64_clamp(f0, lo, hi) answered lo, a pitch outside the species'
    # own range; the oracle's f32::clamp panicked.
    if (f64_gt(lo, hi)) { return PRANI_ERR_INVALID_SPECIES; }
    var clamped_f0 = f64_clamp(f0, lo, hi);

    # non-stationary perturbation: jitter/shimmer scaled by block intensity, and
    # the excitation at the oracle's level (see THE EXCITATION LEVEL above).
    var glottal = crtract_glottal_new(clamped_f0, sr, params, pert);
    if (svara_is_err(glottal) == 1) { return prani_from_svara(glottal); }
    var k = crtract_excitation_scale(
      f64_clamp(SpeciesParams_breathiness(params), 0, PR_ONE), crtract_pulse_peak(glottal));

    var output = out;
    vec_truncate(output, 0);
    if (f64_gt(sub_amp, 0)) {
        # inject subharmonics into excitation before tract filtering, so the
        # formant resonances shape the subharmonic energy.
        var sub_f0 = f64_mul(clamped_f0, PR_TR_0_5);
        var phase_inc = f64_div(sub_f0, sr);
        var i = 0;
        while (i < num_samples) {
            var glottal_sample = f64_mul((svara_glottal_next_sample(glottal)), k);
            var sub = f64_mul(f64_sin(f64_mul(PR_TAU, CreatureTract_phase(self))), sub_amp);
            var ph = f64_add(CreatureTract_phase(self), phase_inc);
            if (f64_ge(ph, PR_ONE)) { ph = f64_sub(ph, PR_ONE); }
            CreatureTract_set_phase(self, ph);
            var y = (svara_tract_process_sample(tract, (f64_add(glottal_sample, sub))));
            if (prani_vec_push(output, y) < 0) { return PRANI_ERR_ALLOC; }
            i = i + 1;
        }
    } else {
        # no-subharmonic path: inline svara_tract_synthesize's loop, pushing
        # into the vec directly (avoids the raw-buffer/vec mismatch before DC).
        var i = 0;
        while (i < num_samples) {
            var gs = f64_mul((svara_glottal_next_sample(glottal)), k);
            var y = (svara_tract_process_sample(tract, (gs)));
            if (prani_vec_push(output, y) < 0) { return PRANI_ERR_ALLOC; }
            i = i + 1;
        }
    }
    dcblocker_process_buffer(CreatureTract_dc_blocker(self), output);
    return output;
}

# synthesize_syringeal -- dual-source capable, high-frequency range (birds).
#
# 2.0.5 guards: f0 finite, num_samples in range, both option fields finite. The
# option fields are checked at the function's contract level even though the
# dual-source (f0 > 2000) arm discards them, as the oracle does: which arm runs
# depends on the clamped f0, so "the function reads them" is the honest bar.
# A NaN f0 is the sharpest case on this path -- it survives the clamp, and
# `NaN <= 2000` is false, so it fell through to the raw-oscillator arm and
# returned an all-NaN buffer as SUCCESS (measured).
fn crtract_synthesize_syringeal_into(self, f0, num_samples, options, out) {
    if (self <= 0) { return prani_handle_code(self, PRANI_ERR_INVALID_TRACT); }   # ADR-0008
    if (options <= 0) { return prani_handle_code(options, PRANI_ERR_INVALID_VOCALIZATION); }   # ADR-0008
    if (out <= 0) { return prani_handle_code(out, PRANI_ERR_INVALID_VOCALIZATION); }   # ADR-0008
    if (prani_is_finite(f0) == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (prani_buffer_len_ok(num_samples) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var sub_amp = SynthesisOptions_subharmonic_amp(options);
    var pert = SynthesisOptions_perturbation_scale(options);
    if (prani_finite2(sub_amp, pert) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }

    var params = CreatureTract_params(self);
    var sr = CreatureTract_sample_rate(self);
    var tract = CreatureTract_tract(self);

    # clamp f0 to [max(f0_min,20), f0_max]
    var lo = f64_max(SpeciesParams_f0_min(params), f64_from(20));
    if (f64_gt(lo, SpeciesParams_f0_max(params))) { return PRANI_ERR_INVALID_SPECIES; }   # audit B11
    var clamped_f0 = f64_clamp(f0, lo, SpeciesParams_f0_max(params));

    var output = out;
    vec_truncate(output, 0);
    if (f64_le(clamped_f0, f64_from(2000))) {
        var glottal = crtract_glottal_new(clamped_f0, sr, params, pert);
        if (svara_is_err(glottal) == 1) { return prani_from_svara(glottal); }
        var k = crtract_excitation_scale(
          f64_clamp(SpeciesParams_breathiness(params), 0, PR_ONE), crtract_pulse_peak(glottal));
        var i = 0;
        while (i < num_samples) {
            var gs = f64_mul((svara_glottal_next_sample(glottal)), k);
            var y = (svara_tract_process_sample(tract, (gs)));
            if (prani_vec_push(output, y) < 0) { return PRANI_ERR_ALLOC; }
            i = i + 1;
        }
    } else {
        # high-frequency syringeal with dual-source capability: the syrinx has
        # two independent sound sources (left/right bronchus) at different pitches.
        var f0_2 = f64_mul(clamped_f0, PR_TR_1_498);   # ~perfect fifth above
        var breathiness = SpeciesParams_breathiness(params);
        var rng = CreatureTract_rng(self);
        var t0 = CreatureTract_clock(self);   # 2.2.1 (ADR-0009): continuous across calls
        var i = 0;
        while (i < num_samples) {
            var t = f64_div(f64_from(t0 + i), sr);
            var tone1 = f64_sin(f64_mul(f64_mul(PR_TAU, clamped_f0), t));
            var tone2 = f64_mul(f64_sin(f64_mul(f64_mul(PR_TAU, f0_2), t)), PR_TR_0_6);
            var noise = f64_mul(prani_rng_next_f32(rng), breathiness);
            # excitation = (tone1+tone2)*0.5*(1-breathiness) + noise
            var excitation = f64_add(
              f64_mul(f64_mul(f64_add(tone1, tone2), PR_TR_0_5), f64_sub(PR_ONE, breathiness)),
              noise);
            var ty = (svara_tract_process_sample(tract, (excitation)));
            if (prani_vec_push(output, ty) < 0) { return PRANI_ERR_ALLOC; }
            i = i + 1;
        }
    }
    CreatureTract_set_clock(self, CreatureTract_clock(self) + num_samples);
    dcblocker_process_buffer(CreatureTract_dc_blocker(self), output);
    return output;
}

# synthesize_noise -- filtered broadband noise (snakes). naad-backend path:
# the pre-built bandpass shapes white noise. The svara FormantFilter fallback
# is dropped (naad-backend default).
#
# The filter is NOT unconditionally present, despite what this comment used to
# claim: crtract_new builds it only for PRANI_APP_NOISE_ONLY and only keeps it
# `if (prani_is_err(nf) == 0)`, leaving the field 0 when filter_biquad_new
# rejects the species f0 for the sample rate. Passing that 0 to
# filter_biquad_process_sample is a null dereference, so the invariant the
# comment asserted is checked instead of assumed.
fn crtract_synthesize_noise_into(self, num_samples, out) {
    if (self <= 0) { return prani_handle_code(self, PRANI_ERR_INVALID_TRACT); }   # ADR-0008
    if (out <= 0) { return prani_handle_code(out, PRANI_ERR_INVALID_VOCALIZATION); }   # ADR-0008
    # 2.0.5: num_samples in range. No f0 and no options reach this path, so there is
    # nothing else here with a range. The input check comes BEFORE the filter
    # check so a caller learns about its own bad argument first.
    if (prani_buffer_len_ok(num_samples) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var filter = CreatureTract_noise_filter(self);
    if (filter == 0) {
        prani_log_error("prani: noise-only synthesis has no bandpass filter");
        return PRANI_ERR_SYNTHESIS_FAILED;
    }
    var output = out;
    vec_truncate(output, 0);
    var rng = CreatureTract_rng(self);
    var i = 0;
    while (i < num_samples) {
        var noise = f64_mul(prani_rng_next_f32(rng), PR_TR_0_5);
        var fy = (filter_biquad_process_sample(filter, (noise)));
        if (prani_vec_push(output, fy) < 0) { return PRANI_ERR_ALLOC; }
        i = i + 1;
    }
    dcblocker_process_buffer(CreatureTract_dc_blocker(self), output);
    return output;
}

# crtract_osc_ok(f0, end_clock, sr) -- 1 iff the raw oscillators' largest phase,
# TAU * 2 * f0 * (end_clock / sr), is finite. 2.0.5 ranged f0 as "finite", which
# is not enough here: past about 1.4e307 the product overflows to inf, and inf * 0
# at t = 0 is NaN, so a bee rendered 256 NaN samples as success (audit B7, 2.2.1).
#must_use
fn crtract_osc_ok(f0, end_clock, sr) {
    var w = f64_mul(PR_TAU, f64_mul(f64_abs(f0), PR_TWO));
    if (prani_is_finite(w) == 0) { return 0; }
    return prani_is_finite(f64_mul(w, f64_div(f64_from(end_clock), sr)));
}

# synthesize_stridulatory -- amplitude-modulated tone for insects.
# High-carrier (cricket, f0 > 1000): discrete pulse-train chirps.
# Low-carrier (bee, f0 <= 1000): continuous wing-beat modulation.
fn crtract_synthesize_stridulatory_into(self, f0, num_samples, options, out) {
    if (self <= 0) { return prani_handle_code(self, PRANI_ERR_INVALID_TRACT); }   # ADR-0008
    if (options <= 0) { return prani_handle_code(options, PRANI_ERR_INVALID_VOCALIZATION); }   # ADR-0008
    if (out <= 0) { return prani_handle_code(out, PRANI_ERR_INVALID_VOCALIZATION); }   # ADR-0008
    # 2.0.5: f0 finite, num_samples in range. `options` is NOT checked -- this path
    # never reads it (the oracle writes `let _ = options;`), and a function must
    # not reject a value it does not use. f0 here is raw: it multiplies TAU*t
    # inside sin(), and sin(+-inf) is NaN, so a non-finite f0 turned the whole
    # buffer to NaN and returned it as SUCCESS (measured).
    if (prani_is_finite(f0) == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (prani_buffer_len_ok(num_samples) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var sr = CreatureTract_sample_rate(self);
    # 2.2.1 (ADR-0009): time runs on the tract's clock, so a render in blocks is the
    # same as one in a single call. It used to restart at 0 every call, and every
    # caller renders in blocks (20 ms in vocalize, the host's buffer in a stream)
    # shorter than one chirp, so a cricket never reached its inter-chirp silence.
    var t0 = CreatureTract_clock(self);
    if (crtract_osc_ok(f0, t0 + num_samples, sr) == 0) { return PRANI_ERR_INVALID_TRACT; }   # audit B7
    var output = out;
    vec_truncate(output, 0);

    if (f64_gt(f0, f64_from(1000))) {
        # cricket-style discrete pulse-train chirps.
        var syllable_rate = PR_TR_30_0;   # wing strokes per second within a chirp
        var chirp_rate = PR_TR_2_5;       # chirps per second
        var pulses_per_chirp = 4;         # typical field cricket (u32)
        var chirp_period = f64_div(sr, chirp_rate);
        var syllable_period = f64_div(sr, syllable_rate);
        var chirp_active = f64_mul(syllable_period, f64_from(pulses_per_chirp));

        var i = 0;
        while (i < num_samples) {
            var t = f64_div(f64_from(t0 + i), sr);
            # pos_in_chirp = (clock as f32) % chirp_period
            var pos_in_chirp = crtract_fmod(f64_from(t0 + i), chirp_period);

            var carrier = f64_sin(f64_mul(f64_mul(PR_TAU, f0), t));
            var h2 = f64_mul(f64_sin(f64_mul(f64_mul(f64_mul(PR_TAU, f0), PR_TWO), t)), PR_TR_0_3);
            var signal = f64_mul(f64_add(carrier, h2), PR_TR_0_25);

            if (f64_lt(pos_in_chirp, chirp_active)) {
                # within active chirp: pulse envelope per syllable
                var pos_in_syllable = crtract_fmod(pos_in_chirp, syllable_period);
                var syllable_frac = f64_div(pos_in_syllable, syllable_period);
                # sharp onset, quick decay per pulse (wing-stroke shape)
                var pulse_env = 0;
                if (f64_lt(syllable_frac, PR_TR_0_1)) {
                    pulse_env = f64_div(syllable_frac, PR_TR_0_1);
                } elif (f64_lt(syllable_frac, PR_TR_0_5)) {
                    pulse_env = PR_ONE;
                } else {
                    # 1.0 - (syllable_frac - 0.5) / 0.5
                    pulse_env = f64_sub(PR_ONE, f64_div(f64_sub(syllable_frac, PR_TR_0_5), PR_TR_0_5));
                }
                if (prani_vec_push(output, f64_mul(signal, pulse_env)) < 0) { return PRANI_ERR_ALLOC; }
            } else {
                # inter-chirp silence
                if (prani_vec_push(output, 0) < 0) { return PRANI_ERR_ALLOC; }
            }
            i = i + 1;
        }
    } else {
        # bee-style continuous wing-beat modulation
        var mod_rate = f64_mul(f0, PR_TR_0_5);
        var i = 0;
        while (i < num_samples) {
            var t = f64_div(f64_from(t0 + i), sr);
            var carrier = f64_sin(f64_mul(f64_mul(PR_TAU, f0), t));
            var h2 = f64_mul(f64_sin(f64_mul(f64_mul(f64_mul(PR_TAU, f0), PR_TWO), t)), PR_TR_0_3);
            # modulator = 0.5 + 0.5*sin(TAU*mod_rate*t)
            var modulator = f64_add(PR_TR_0_5,
              f64_mul(PR_TR_0_5, f64_sin(f64_mul(f64_mul(PR_TAU, mod_rate), t))));
            var y = f64_mul(f64_mul(f64_add(carrier, h2), modulator), PR_TR_0_25);
            if (prani_vec_push(output, y) < 0) { return PRANI_ERR_ALLOC; }
            i = i + 1;
        }
    }
    CreatureTract_set_clock(self, t0 + num_samples);
    dcblocker_process_buffer(CreatureTract_dc_blocker(self), output);
    return output;
}

# synthesize_vibratile -- continuous wing-beat modulation (bees, flies).
# Thoracic flight-muscle vibration through wings; steady buzz, AM at half the
# wing frequency.
fn crtract_synthesize_vibratile_into(self, f0, num_samples, out) {
    if (self <= 0) { return prani_handle_code(self, PRANI_ERR_INVALID_TRACT); }   # ADR-0008
    if (out <= 0) { return prani_handle_code(out, PRANI_ERR_INVALID_VOCALIZATION); }   # ADR-0008
    # 2.0.5: f0 finite, num_samples in range. Same raw-oscillator hazard as the
    # stridulatory path.
    if (prani_is_finite(f0) == 0) { return PRANI_ERR_INVALID_TRACT; }
    if (prani_buffer_len_ok(num_samples) == 0) { return PRANI_ERR_INVALID_VOCALIZATION; }
    var sr = CreatureTract_sample_rate(self);
    var t0 = CreatureTract_clock(self);   # 2.2.1 (ADR-0009), as in stridulatory
    if (crtract_osc_ok(f0, t0 + num_samples, sr) == 0) { return PRANI_ERR_INVALID_TRACT; }   # audit B7
    var mod_rate = f64_mul(f0, PR_TR_0_5);
    var output = out;
    vec_truncate(output, 0);
    var i = 0;
    while (i < num_samples) {
        var t = f64_div(f64_from(t0 + i), sr);
        var carrier = f64_sin(f64_mul(f64_mul(PR_TAU, f0), t));
        var h2 = f64_mul(f64_sin(f64_mul(f64_mul(f64_mul(PR_TAU, f0), PR_TWO), t)), PR_TR_0_3);
        var modulator = f64_add(PR_TR_0_5,
          f64_mul(PR_TR_0_5, f64_sin(f64_mul(f64_mul(PR_TAU, mod_rate), t))));
        var y = f64_mul(f64_mul(f64_add(carrier, h2), modulator), PR_TR_0_25);
        if (prani_vec_push(output, y) < 0) { return PRANI_ERR_ALLOC; }
        i = i + 1;
    }
    CreatureTract_set_clock(self, t0 + num_samples);
    dcblocker_process_buffer(CreatureTract_dc_blocker(self), output);
    return output;
}

# fmod helper -- floating remainder a - trunc(a/b)*b (matches Rust f32 `%`
# for the non-negative operands used here: i-index positions and periods).
#must_use
fn crtract_fmod(a, b) {
    var q = f64_trunc(f64_div(a, b));
    return f64_sub(a, f64_mul(q, b));
}

# ---- public API -------------------------------------------------------------

# synthesize(f0, num_samples, options) -- CreatureTract::synthesize. Dispatches
# on the species' vocal apparatus. Returns a vec (heap ptr) on success or a
# negative PRANI_ERR_* on failure.
#
# 2.0.5: the input guards live in the five paths below, not here, because that
# is where each parameter is READ. Dispatch alone cannot say whether `f0` or
# `options` matters -- the NoiseOnly path takes neither -- and a guard here
# would reject, say, a NaN `f0` for a snake, whose synthesis never looks at it.
# Every path guards `num_samples`, so this entry point rejects a count that
# cannot be one vec for every apparatus.
fn crtract_synthesize_into(self, f0, num_samples, options, out) {
    if (self <= 0) { return prani_handle_code(self, PRANI_ERR_INVALID_TRACT); }   # ADR-0008
    if (options <= 0) { return prani_handle_code(options, PRANI_ERR_INVALID_VOCALIZATION); }   # ADR-0008
    if (out <= 0) { return prani_handle_code(out, PRANI_ERR_INVALID_VOCALIZATION); }   # ADR-0008
    var apparatus = SpeciesParams_apparatus(CreatureTract_params(self));
    if (apparatus == PRANI_APP_LARYNGEAL) {
        return crtract_synthesize_laryngeal_into(self, f0, num_samples, options, out);
    }
    if (apparatus == PRANI_APP_SYRINGEAL) {
        return crtract_synthesize_syringeal_into(self, f0, num_samples, options, out);
    }
    if (apparatus == PRANI_APP_NOISE_ONLY) {
        return crtract_synthesize_noise_into(self, num_samples, out);
    }
    if (apparatus == PRANI_APP_STRIDULATORY) {
        return crtract_synthesize_stridulatory_into(self, f0, num_samples, options, out);
    }
    # PRANI_APP_VIBRATILE
    return crtract_synthesize_vibratile_into(self, f0, num_samples, out);
}

# ---- allocating wrappers -----------------------------------------------------
# 2.0.9. Each synthesis entry point now has an `_into` form that writes into
# caller-owned storage and an allocating wrapper that keeps the original
# signature. Same split as species_params / species_params_into (2.0.3 F7).
#
# WHY: the block vec these return was **8,088 of the 8,800 bytes**
# `stream_fill_buffer` retained per call -- 24 B of header plus six geometric
# grows to reach 512 slots. On a bump arena that never frees, that is ~757 KB/s
# for the life of the process on a path advertised for audio callbacks. A caller
# that hoists ONE vec and reuses it pays the grows once: after the first call its
# capacity already covers the block, so `vec_truncate` + pushes allocate nothing.
#
# The wrappers are NOT deprecated -- a caller that wants a fresh buffer per call
# should use them. They exist so that a caller in a callback has the choice.

# Renders num_samples for this tract's apparatus into a fresh vec; a vec or a negative error.
#must_use
fn crtract_synthesize(self, f0, num_samples, options) {
    var out = prani_vec_new();
    if (out < 0) { return out; }   # PRANI_ERR_ALLOC (2.2.0)
    return crtract_synthesize_into(self, f0, num_samples, options, out);
}

